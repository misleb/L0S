# The demo: a shell on the serial line, and a desktop in QEMU's window
# with two terminals on it, each with a shell.
#
# The serial line's shell is pid 1, so that its exit stops the system; its
# terminal is console, which uart serves. virtio-gpu drives the display
# and serves display; virtio-input drives the keyboard and the tablet,
# once each, and serves keyboard and pointer. wm, the compositor, owns the
# screen through display and keeps windows on it for its clients; the
# two vts are terminals in two of them, named vt1 and vt2 in the order
# they start, each starting its own shell, sh vt1 and sh vt2, and closing
# when it exits. rtc clock serves clock, the time, which the compositor's
# top bar shows. virtio-blk drives the disk, build/disk.img, and serves
# disk, which the disk program reads and writes sectors through, and fs
# mounts the disk's volumes at /Volumes/data and /Volumes/scratch, so
# that every program's files can be kept there. The commands in /bin, the
# services in /sbin, and the apps in /Applications, Terminal, System
# Monitor, Widgets and Disks, each a bundle NAME.app, wait to be run.
start /bin/sh
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/wm
start /Applications/Terminal.app/vt
start /Applications/Terminal.app/vt
start /sbin/rtc clock
start /sbin/virtio-blk
start /sbin/fs

# Drivers: these may map devices and take their interrupts.
dev /sbin/uart
dev /sbin/rtc
dev /sbin/virtio-gpu
dev /sbin/virtio-input
dev /sbin/virtio-blk

# Arguments when the shell's run gives none.
args /bin/ping 3
args /bin/nap 500
