# The demo, in two stages. This, the initramfs's inittab, starts boot as
# pid 1, then the drivers and the file server; boot starts the rest,
# /etc/system: from the system volume, if the board was booted with
# root=UUID and fs mounts the volume of that partition, holding L0S,
# which boot makes /; or else the initramfs's own /etc/system.
#
# uart drives the serial line and serves console; virtio-gpu drives the
# display and serves display. rtc clock serves
# clock, the time, which the compositor's top bar shows. virtio-blk
# drives the disk, build/disk.img, and serves disk, which the disk
# program reads and writes sectors through, and fs mounts the disk's
# volumes at /Volumes/data and /Volumes/scratch, so that every program's
# files can be kept there. virtio-net drives the network card, on QEMU's
# user network, and serves nic; inet, the IPv4 stack, listens to it and
# serves inet for net and tftp, at the address, netmask and gateway a
# DHCP server gives it (inet dhcp; QEMU's user network gives 10.0.2.15/24
# behind 10.0.2.2). virtio-rng drives the entropy device and serves
# random, the bytes fs makes UUIDs of and inet keys TCP's first sequence
# numbers with. pcie sets up the PCIe bus, where QEMU's sdhci-pci and
# qemu-xhci are. sdhci drives the SD card in the first, build/sd.img,
# blank until Disks formats it, as disk1: virtio-blk's disk, registered
# first, is disk0, and fs serves the volumes of both. xhci drives the
# second and serves usb, and one usb-hid serves keyboard and pointer
# from its USB keyboard and mouse, booted with QEMU_INPUT=usb
# (tools/qemu-boot.sh), as make demo does. The commands in /bin, the
# services in /sbin, and the apps in /Applications, Terminal, System
# Monitor, Widgets and Disks, each a bundle NAME.app, wait to be run.
start /sbin/boot
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/rtc clock
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet dhcp
start /sbin/virtio-rng
start /sbin/pcie virt
start /sbin/sdhci pci
start /sbin/xhci pci
start /sbin/usb-hid

# Drivers: these may map devices and take their interrupts.
dev /sbin/uart
dev /sbin/rtc
dev /sbin/virtio-gpu
dev /sbin/virtio-blk
dev /sbin/virtio-net
dev /sbin/virtio-rng
dev /sbin/pcie
dev /sbin/sdhci
dev /sbin/xhci

# Arguments when the shell's run gives none, wherever / is.
args /bin/ping 3
args /bin/nap 500
