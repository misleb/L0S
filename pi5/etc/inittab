# The Raspberry Pi 5's boot, in two stages as the demo's: this starts
# boot as pid 1, then what mounts the system volume, the first stage:
# uart, the console; xhci rp1, RP1's two USB controllers, which the
# firmware leaves set up (config.txt's pciex4_reset=0, which l0 card
# writes), for a system volume on USB to come; sdhci pi5, the microSD
# card in the slot, if there is one, as a disk; and one fs ram, which
# serves a volume in memory, /Volumes/tmp, registered as tmpfs, and
# mounts the card's volumes, a FAT32 boot partition among them,
# registered as fs. With no card it serves tmp alone. boot starts the
# rest, /etc/system: the system volume's once it is /, the other drivers
# among them, which the dev lines below let drive their devices though
# the initramfs does not hold them; or the initramfs's own.
#
# So the release's initramfs (make pi5-stage1) holds only these and a
# rescue shell, and the netboot's (make pi5-card) everything, for a board
# with no card: there boot starts the initramfs's /etc/system, the same
# drivers.
#
# eeprom, run at the shell, asks the firmware the same way for the
# bootloader's configuration, and writes the update that changes it.
#
# The demo's other drivers have nothing to drive here: virtio-*, pcie
# virt and sdhci pci.
start /sbin/boot
start /sbin/uart
start /sbin/xhci rp1
start /sbin/sdhci pi5
start /sbin/fs ram

# Drivers: these may map devices and take their interrupts, from the
# initramfs, or, started by boot, from the system volume.
dev /sbin/uart
dev /sbin/rtc
dev /sbin/eeprom
dev /sbin/xhci
dev /sbin/hvs
dev /sbin/hdmi-audio
dev /sbin/gem
dev /sbin/sdhci

# Arguments when the shell's run gives none, wherever / is.
args /bin/ping 3
args /bin/nap 500
