; irq_virt_test.l0 -- the interrupts PCIe devices need on QEMU's virt
; board, which its host does not give yet: run with l0 test --target
; virt. Each test passes once the host gives the interrupt, and fails
; today with -3, no such interrupt (6.14).

; INTA to INTD, the PCIe host bridge's four INTx lines: SPIs 3 to 6, the
; GIC's 35 to 38, level-sensitive. pcie's virt_intx says which a device
; raises, by its slot and pin.
(def test_intx_a () int (check_int "INTA" (interrupt_enable 35) 0))
(def test_intx_b () int (check_int "INTB" (interrupt_enable 36) 0))
(def test_intx_c () int (check_int "INTC" (interrupt_enable 37) 0))
(def test_intx_d () int (check_int "INTD" (interrupt_enable 38) 0))

; The first and last of the GICv2m frame's 64 MSI SPIs, the GIC's 80 to
; 143, edge-triggered: a device's MSI writes its number to the frame's
; MSI_SETSPI_NS, 0x08020040.
(def test_msi_first () int (check_int "MSI 80" (interrupt_enable 80) 0))
(def test_msi_last () int (check_int "MSI 143" (interrupt_enable 143) 0))
