; usb_virt_test.l0 -- the regions a USB stack needs on QEMU's virt board,
; which its host does not give yet: run with l0 test --target virt. Each
; test passes once the host gives the region, and fails today with -3.

; The first megabyte of the PCIe ECAM, bus 0's configuration space, at
; QEMU's high ECAM, 0x4010000000.
(def test_ecam_bus_0 () int
  (check_true "a region" (ge (region_open 275146342400 1048576) 0)))

; The first page of the 32-bit PCIe MMIO window, 0x10000000, where a
; device's BARs are put.
(def test_mmio_window () int
  (check_true "a region" (ge (region_open 268435456 4096) 0)))

; The 16 KB of a qemu-xhci's BAR 0 at the end of the window, 0x3EFEC000:
; the window is 0x2EFF0000 bytes.
(def test_mmio_window_end () int
  (check_true "a region" (ge (region_open 1056882688 16384) 0)))
