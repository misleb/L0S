; want.l0 -- what L0S's display driver for the Raspberry Pi 5, hvs, opens
; as it starts: the HVS, the IOMMU in front of it, and the cache that
; IOMMU shares. l0 check accepts it; on a Pi 5 today each open_device
; gives DeviceFailed, since spec section 10.3 lists none of the three as
; a region. With the request in this directory, it says the HVS's layout
; and HDMI0's mode.

; Where each is in the CPU's map, and its bytes (bcm2712.dtsi,
; bcm2712-ds.dtsi).
(def hvs_base () int 70805618688)        ; 0x107C580000
(def hvs_bytes () int 106496)            ; 0x1A000
(def iommu4_base () int 68719497728)     ; 0x1000005200
(def iommuc_base () int 68719500032)     ; 0x1000005B00
(def iommu_bytes () int 128)

; Whether base, len is a region: 1 if it is, else 0.
(def opened ((base int) (len int)) int
  (match (open_device base len)
    ((DeviceFailed fault why) 0)
    ((DeviceOpened d) (let c (close_device d) 1))))

; How many of the three open: 3 once the request lands.
(def regions () int
  (add (opened (hvs_base) (hvs_bytes))
       (add (opened (iommu4_base) (iommu_bytes)) (opened (iommuc_base) (iommu_bytes)))))

; The HVS's version register, SCALER6_VERSION, 0x53 for C0, 0x54 for D0;
; and HDMI0's channel's CTRL0 on C0, at 0x30, its mode; or -1 each with no
; region.
(def version () int (word_at 0))
(def channel0_c0 () int (word_at 48))

(def word_at ((off int)) int
  (match (open_device (hvs_base) (hvs_bytes))
    ((DeviceFailed fault why) -1)
    ((DeviceOpened d) (let w (device_read32 d off) (let c (close_device d) w)))))

(def main () int
  (let a (write_line (append "regions: " (digits (regions))))
    (let b (write_line (append "version: " (digits (version))))
      (let c (write_line (append "channel 0: " (digits (channel0_c0))))
        0))))
