; want.l0 -- what L0S's SD card driver, sdhci, would open on the
; Raspberry Pi 5 as it starts: the BCM2712's own SD host controller,
; sdio1, the brcmstb SDHCI behind the microSD slot, its standard SDHCI
; registers and the brcmstb cfg block after them. l0 check accepts it;
; on a Pi 5 today the open_device gives DeviceFailed, since spec section
; 10.3 lists no SD controller as a region. With the request in this
; directory, it says the controller's version, capabilities and
; present state, and the cfg block's first word.

; Where it is in the CPU's map, and its bytes: bcm2712.dtsi's sdio1,
; mmc@1000fff000, reg-names host (0x260 bytes) and cfg (0x200 bytes at
; 0x400), as one run.
(def sdio1_base () int 68736249856)  ; 0x1000FFF000
(def sdio1_bytes () int 1536)        ; 0x600
(def cfg_off () int 1024)            ; 0x400

; SDHCI's registers read here (SD Host Controller Simplified
; Specification 4.20, section 2.2).
(def reg_present () int 36)          ; 0x24, Present State
(def reg_caps () int 64)             ; 0x40, Capabilities, low word
(def reg_version () int 254)         ; 0xFE, Host Controller Version

; The controller's words, or why there are none.
(def sdio1_words () (list int)
  (match (open_device (sdio1_base) (sdio1_bytes))
    ((DeviceFailed fault why) (append "no region at 0x1000FFF000: " why))
    ((DeviceOpened d)
      (let v (device_read16 d (reg_version))
        (let c (device_read32 d (reg_caps))
          (let p (device_read32 d (reg_present))
            (let g (device_read32 d (cfg_off))
              (let x (close_device d)
                (append "version 0x" (append (hex_digits v 0)
                  (append ", caps 0x" (append (hex_digits c 0)
                    (append ", present 0x" (append (hex_digits p 0)
                      (append ", cfg 0x" (hex_digits g 0))))))))))))))))

; Says what sdio1 holds, or why it could not.
(def main () int
  (let w (write_line (append "sdio1: " (sdio1_words))) 0))
