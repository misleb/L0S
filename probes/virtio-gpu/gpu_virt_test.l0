; Tests that need the board's frames: run with l0 test --target virt.

(def test_frame_address_is_a_page () int
  (let a (frame_address (frame_new))
    (add (check_true "not negative" (ge a 0))
         (check_int "page aligned" (mod a 4096) 0))))

(def test_frames_have_different_addresses () int
  (let a (frame_address (frame_new))
    (let b (frame_address (frame_new))
      (check_true "different" (not (eq a b))))))

(def test_frame_address_of_no_frame () int (frame_address 12345))
(def expect_frame_address_of_no_frame () (list int) "not a frame")
