;;; A probe of how far L0 gets driving QEMU's virtio-gpu on the virt board:
;;; find the device, negotiate, set up its control queue, and ask it for its
;;; display modes, a command the device answers by writing into memory, by
;;; DMA, at the frames' addresses that frame_address gives.

; The low n bytes of v, least significant first, as virtio lays them out.
(def le_bytes ((v int) (n int)) (list int)
  (if (eq n 0)
      (nil int)
      (cons (bit_and v 255) (le_bytes (bit_shr v 8) (sub n 1)))))

(def le16 ((v int)) (list int) (le_bytes v 2))
(def le32 ((v int)) (list int) (le_bytes v 4))
(def le64 ((v int)) (list int) (le_bytes v 8))

; The n bytes of b from i, least significant first, as an int.
(def le_at ((b bytes) (i int) (n int)) int
  (if (eq n 0)
      0
      (bit_or (bytes_get b i) (bit_shl (le_at b (add i 1) (sub n 1)) 8))))

; Register offset off of virtio-mmio transport t, in the one device range
; over all 32 transports, 0x200 bytes each.
(def reg ((t int) (off int)) int
  (add (mul t 512) off))

; A split virtqueue descriptor: addr, len, flags, next.
(def descriptor ((addr int) (len int) (flags int) (next int)) (list int)
  (append (le64 addr) (append (le32 len) (append (le16 flags) (le16 next)))))

; virtio_gpu_ctrl_hdr for VIRTIO_GPU_CMD_GET_DISPLAY_INFO, 0x0100.
(def display_info_request () (list int)
  (append (le32 256) (append (le32 0) (append (le64 0) (append (le32 0) (le32 0))))))

; The available ring with one entry, descriptor 0: flags, idx 1, ring[0].
(def avail_one () (list int)
  (append (le16 0) (append (le16 1) (le16 0))))

; What virtio_gpu_resp_display_info holds: a 24-byte header, then 16 modes
; of 24 bytes each, a rectangle then enabled then flags.
(def response_len () int 408)

(data Mode (Mode int int int))                        ; width, height, enabled

(def mode_at ((b bytes) (n int)) Mode
  (let o (add 24 (mul n 24))
    (Mode (le_at b (add o 8) 4) (le_at b (add o 12) 4) (le_at b (add o 16) 4))))

(def describe_response ((b bytes)) (list int)
  (match (mode_at b 0)
    ((Mode w h e)
     (append "response type 0x" (append (hex_digits (le_at b 0 4) 4)
       (append ", scanout 0 " (append (digits w) (append "x" (append (digits h)
         (append ", enabled " (digits e)))))))))))

; ---------------------------------------------------------------- the board

(def say ((s (list int))) int (write_line s))

(def report_region ((what (list int)) (r int)) int
  (say (append "region_open over " (append what (append ": " (digits r))))))

(def find_gpu ((d IoDevice) (t int)) int
  (if (eq t 32)
      -1
      (if (eq (device_read32 d (reg t 8)) 16)         ; DeviceID 16, a GPU
          t
          (find_gpu d (add t 1)))))

(def run_probe () int
  (let a (report_region "RAM at 0x40000000" (region_open 1073741824 4096))
    (let b (report_region "the frame pool at 0x98000000" (region_open 2550136832 4096))
      (match (open_device 167772160 16384)            ; 0x0A000000, 32 transports
        ((DeviceFailed fault why) (let w (say (append "virtio-mmio: " why)) 1))
        ((DeviceOpened d) (probe_transport d (find_gpu d 0)))))))

(def probe_transport ((d IoDevice) (t int)) int
  (if (lt t 0)
      (let w (say "no virtio-gpu on any transport") 2)
      (let v (device_read32 d (reg t 4))
        (let w (say (append "virtio-gpu on transport " (append (digits t)
                 (append ", version " (digits v)))))
          (if (eq v 2)
              (negotiate d t)
              (let x (say "a legacy transport: boot with -global virtio-mmio.force-legacy=false") 3))))))

; Status bits: 1 ACKNOWLEDGE, 2 DRIVER, 8 FEATURES_OK, 4 DRIVER_OK.
(def negotiate ((d IoDevice) (t int)) int
  (let r0 (device_write32 d (reg t 112) 0)            ; reset
    (let r1 (device_write32 d (reg t 112) 3)
      (let s0 (device_write32 d (reg t 36) 0)         ; no GPU feature bits
        (let f0 (device_write32 d (reg t 32) 0)
          (let s1 (device_write32 d (reg t 36) 1)     ; VIRTIO_F_VERSION_1, bit 32
            (let f1 (device_write32 d (reg t 32) 1)
              (let r2 (device_write32 d (reg t 112) 11)
                (features_checked d t)))))))))

(def features_checked ((d IoDevice) (t int)) int
  (if (eq (bit_and (device_read32 d (reg t 112)) 8) 0)
      (let w (say "the device refused the features") 4)
      (let w (say (append "features accepted; scanouts " (digits (device_read32 d (reg t 264)))))
        (let q (device_write32 d (reg t 48) 0)        ; QueueSel 0, the control queue
          (let m (device_read32 d (reg t 52))
            (let w2 (say (append "control queue holds at most " (digits m)))
              (with_memory d t (space_new))))))))

; Three frames, mapped into a space no thread runs in, only so that
; space_write and space_read can reach them: the ring, the command, and the
; response.
(def with_memory ((d IoDevice) (t int) (s int)) int
  (let q (frame_new)
    (let c (frame_new)
      (let r (frame_new)
        (let m0 (space_map s 3221225472 q 1)          ; 0xC0000000
          (let m1 (space_map s 3221229568 c 1)
            (let m2 (space_map s 3221233664 r 1)
              (let w (say (append "ring frame at 0x" (hex_digits (frame_address q) 8)))
                (fill_ring d t s (frame_address q) (frame_address c) (frame_address r))))))))))

(def write_at ((s int) (va int) (xs (list int))) int
  (let b (bytes_from_list xs)
    (space_write s va b 0 (bytes_len b))))

; Descriptors at 0, the available ring at 256, the used ring at 512.
(def fill_ring ((d IoDevice) (t int) (s int) (qa int) (ca int) (ra int)) int
  (let w0 (write_at s 3221229568 (display_info_request))
    (let w1 (write_at s 3221225472 (append (descriptor ca 24 1 1)          ; NEXT
                                           (descriptor ra (response_len) 2 0))) ; WRITE
      (let w2 (write_at s 3221225728 (avail_one))
        (start_queue d t s qa)))))

(def start_queue ((d IoDevice) (t int) (s int) (qa int)) int
  (let n (device_write32 d (reg t 56) 16)             ; QueueNum
    (let a (device_write32 d (reg t 128) qa)          ; QueueDesc
      (let b (device_write32 d (reg t 132) 0)
        (let c (device_write32 d (reg t 144) (add qa 256)) ; QueueDriver
          (let e (device_write32 d (reg t 148) 0)
            (let f (device_write32 d (reg t 160) (add qa 512)) ; QueueDevice
              (let g (device_write32 d (reg t 164) 0)
                (notify d t s)))))))))

(def notify ((d IoDevice) (t int) (s int)) int
  (let r (device_write32 d (reg t 68) 1)              ; QueueReady
    (let o (device_write32 d (reg t 112) 15)          ; | DRIVER_OK
      (let b (barrier)
        (let k (device_write32 d (reg t 80) 0)        ; QueueNotify, queue 0
          (if (wait_used s (add (clock_ns) 1000000000))
              (let w (say (describe_response (space_read s 3221233664 (response_len)))) 0)
              (let w (say "no answer from the device in a second") 5)))))))

; The used ring's idx, at 512 plus 2, reaching 1.
(def wait_used ((s int) (deadline int)) bool
  (let b (barrier)
    (if (eq (le_at (space_read s 3221225986 2) 0 2) 1)
        true
        (if (gt (clock_ns) deadline) false (wait_used s deadline)))))
