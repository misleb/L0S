(def test_le32 () int
  (check_str "bytes" (le32 4353) (cons 1 (cons 17 (cons 0 (cons 0 (nil int)))))))

(def test_le_at_reads_le_bytes () int
  (check_int "round trip" (le_at (bytes_from_list (le64 2550140928)) 0 8) 2550140928))

(def test_descriptor_is_16_bytes () int
  (check_int "length" (length (descriptor 1 2 3 4)) 16))

(def test_descriptor_fields () int
  (let b (bytes_from_list (descriptor 2550140928 408 2 7))
    (add (check_int "addr" (le_at b 0 8) 2550140928)
         (add (check_int "len" (le_at b 8 4) 408)
              (add (check_int "flags" (le_at b 12 2) 2)
                   (check_int "next" (le_at b 14 2) 7))))))

(def test_request_is_a_24_byte_header () int
  (let b (bytes_from_list (display_info_request))
    (add (check_int "length" (bytes_len b) 24)
         (check_int "type" (le_at b 0 4) 256))))

(def test_avail_one () int
  (let b (bytes_from_list (avail_one))
    (add (check_int "idx" (le_at b 2 2) 1)
         (check_int "ring 0" (le_at b 4 2) 0))))

(def test_reg () int
  (check_int "transport 31 status" (reg 31 112) 15984))

; A response as QEMU's device gives it: OK_DISPLAY_INFO, scanout 0 at 0,0,
; 1280 by 800, enabled.
(def sample_header () (list int)
  (append (le32 4353) (append (le32 0) (append (le64 0) (le64 0)))))

(def sample_mode () (list int)
  (append (le64 0) (append (le32 1280) (append (le32 800) (le64 1)))))

(def sample_response () bytes
  (bytes_from_list (append (sample_header) (sample_mode))))

(def test_describe_response () int
  (check_str "described" (describe_response (sample_response))
             "response type 0x1101, scanout 0 1280x800, enabled 1"))
