; cactdump.l0 -- a check of format/cact.l0 on Whistle's own container:
; its tensors counted, its audio manifest read, and a few rows of its CQ
; matrices, 2 and 4 bits, dequantized, each as its first 4 floats and
; its sum, to set beside a decoder in Python written from export.py's
; description (cactref.py).

; A float to 6 places.
(def f6 ((x float)) (list int)
  (let n (float_to_int (float_mul x 1000000.0))
    (if (lt n 0) (append "-" (digits (sub 0 n))) (digits n))))

; The sum of a's floats.
(def total ((a (array float)) (k int) (s float)) float
  (if (ge k (array_len a)) s (total a (add k 1) (float_add s (array_get a k)))))

; Row r of tensor k as a line: k r, its first 4, its sum.
(def row_line ((c Cact) (b bytes) (k int) (r int)) (list int)
  (let a (cq_row c b (cact_tensor c k) r)
    (unwords (cons (digits k) (cons (digits r)
      (cons (f6 (array_get a 0)) (cons (f6 (array_get a 1)) (cons (f6 (array_get a 2)) (cons (f6 (array_get a 3))
        (cons (f6 (total a 0 0.0)) (nil (list int))))))))))))

; The manifest's 13 floats.
(def manifest ((c Cact) (b bytes) (k int) (i int) (acc (list (list int)))) (list int)
  (if (ge i 13) (unwords (rev acc)) (manifest c b k (add i 1) (cons (digits (float_to_int (cact_number b (cact_tensor c k) i))) acc))))

; Given IDs after the file, their text, as the tokenizer decodes them;
; else the dump.
(def dump_or_decode ((as (list (list int)))) int
  (if (le (length as) 1)
      (dump (head as))
      (match (read_whole (head as))
        ((Err why) (let w (write_line why) 1))
        ((Ok b)
          (match (cact_of b)
            ((Err why) (let w (write_line why) 1))
            ((Ok c)
              (match (cact_pieces c b)
                ((Err why) (let w (write_line why) 1))
                ((Ok p)
                  (match (word_numbers (tail as))
                    ((None) (let w (write_line "IDs are numbers") 1))
                    ((Some ids) (let w (write_line (pieces_decode p b ids)) 0)))))))))))

(def dump ((path (list int))) int
  (match (read_whole path)
    ((Err why) (let w (write_line why) 1))
    ((Ok b)
      (match (cact_of b)
        ((Err why) (let w (write_line why) 1))
        ((Ok c)
          (let (a (write_line (append "tensors " (digits (cact_count c))))
                m (write_line (append "manifest " (manifest c b 237 0 (nil (list int)))))
                r1 (write_line (row_line c b 2 0))
                r2 (write_line (row_line c b 2 383))
                r3 (write_line (row_line c b 0 1000))
                r4 (write_line (row_line c b 0 8198)))
            0))))))
