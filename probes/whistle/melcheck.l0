; melcheck.l0 -- Whistle's front end in L0 (speech/mel.l0) against the
; reference's on a clip oracle.py made: the largest distance between
; their features, and between L0's mel filters and those whistle.cact
; holds, its FP32 mel tensor of 257 by 80.
;
;   melcheck WEIGHTS DIR      DIR/clip16.wav against DIR/features.txt

(def largest ((a (array float)) (b (array float)) (k int) (m float)) float
  (if (ge k (min (array_len a) (array_len b))) m
      (let d (float_sub (array_get a k) (array_get b k))
        (largest a b (add k 1) (float_max m (if (float_lt d 0.0) (float_neg d) d))))))

; The first FP32 tensor of c of 257 rows, the mel filters, as floats.
(def file_mel ((c Cact) (b bytes) (k int)) (array float)
  (if (ge k (cact_count c)) (array_new 0 0.0)
      (let t (cact_tensor c k)
        (if (and (eq (.dtype t) (cact_fp32)) (eq (nth_or (.shape t) 0 0) 257))
            (file_floats b t 0 (array_new (mul 257 80) 0.0))
            (file_mel c b (add k 1))))))
(def file_floats ((b bytes) (t CactTensor) (k int) (a (array float))) (array float)
  (if (ge k (array_len a)) a (file_floats b t (add k 1) (array_set a k (cact_number b t k)))))

; A float as micro-units, to show a distance.
(def micro ((x float)) (list int) (digits (float_to_int (float_mul x 1000000.0))))

(def check ((as (list (list int)))) int
  (match (read_whole (head as))
    ((Err why) (let w (write_line why) 1))
    ((Ok b)
      (match (cact_of b)
        ((Err why) (let w (write_line why) 1))
        ((Ok c)
          (let (dir (nth as 1)
                xs (chirp_of (append dir "/clip16.wav"))
                want (decimals (tail (fixture_of (append dir "/features.txt"))))
                got (mel_features xs (array_len xs) (mel_matrix))
                fm (file_mel c b 0)
                a (write_line (append "frames " (append (digits (div (array_len got) 80)) (append " of " (digits (div (array_len want) 80))))))
                f (write_line (append "features apart at most, millionths: " (micro (largest got want 0 0.0))))
                m (write_line (append "mel filters apart at most, millionths: " (micro (largest (mel_matrix) fm 0 0.0)))))
            0))))))
