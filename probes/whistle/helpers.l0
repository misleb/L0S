; helpers.l0 -- melcheck's readers, as speech/mel_test.l0 has them: a
; decimal of oracle.py's text, a file of them, and a WAV file's 16-bit
; samples as floats.

; A decimal of the fixture, as -1.7466 or 0.000000: its sign, its
; digits before and after the point.
(def decimal ((s (list int))) float
  (if (is_empty s) 0.0
      (eq (head s) 45) (float_neg (decimal (tail s)))
      (let (whole (up_to 46 s)
            frac (drop s (add (length whole) 1)))
        (float_add (float_from_int (int_prefix whole 0))
                   (float_div (float_from_int (int_prefix frac 0)) (float_from_int (pow10 (length frac))))))))

; 10 to the n.
(def pow10 ((n int)) int (if (le n 0) 1 (mul 10 (pow10 (sub n 1)))))

; Each word of each line of s as a decimal, in order, as an array.
(def decimals ((ls (list (list int)))) (array float)
  (let ws (concat_words ls (nil (list int)))
    (decimals_into ws 0 (array_new (length ws) 0.0))))
(def concat_words ((ls (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty ls) (rev acc) (concat_words (tail ls) (rev_onto (split_spaces (head ls)) acc))))
(def decimals_into ((ws (list (list int))) (k int) (a (array float))) (array float)
  (if (is_empty ws) a (decimals_into (tail ws) (add k 1) (array_set a k (decimal (head ws))))))

(def chirp_of ((path (list int))) (array float)
  (match (read_whole path)
    ((Err why) (array_new 0 0.0))
    ((Ok b)
      (match (parse_wav b)
        ((WavBad why) (array_new 0 0.0))
        ((Wav rate chans s e) (samples_of b s (div (sub e s) 2) 0 (array_new (div (sub e s) 2) 0.0)))))))

; n 16-bit samples of b from s, as floats over 32768, from k.
(def samples_of ((b bytes) (s int) (n int) (k int) (a (array float))) (array float)
  (if (ge k n) a
      (let v (le_u16_at b (add s (mul 2 k)))
        (samples_of b s n (add k 1) (array_set a k (float_div (float_from_int (if (ge v 32768) (sub v 65536) v)) 32768.0))))))

(def fixture_of ((path (list int))) (list (list int))
  (match (read_whole path) ((Err why) (nil (list int))) ((Ok b) (lines (bytes_to_list b)))))
