; enccheck.l0 -- Whistle's encoder in L0 (speech/encoder.l0) against the
; reference's, rebuild.py's from the same whistle.cact, on a clip
; oracle.py made: after each block k, the least cosine of a row with
; the reference's encoderK.txt, and the largest distance.
;
;   enccheck WEIGHTS DIR [K]   DIR/clip16.wav, blocks 1 to K (8)
;
; and writes the last block's rows to DIR/l0-encoder.txt, a row a line
; of millionths, for the reference's decoder to read.

; The cosine of a's and b's rows of n, row r, from entry k, with the
; sums so far.
(def row_cos ((a (array float)) (b (array float)) (n int) (r int) (k int) (ab float) (aa float) (bb float)) float
  (if (ge k n)
      (float_div ab (float_sqrt (float_mul aa bb)))
      (let (x (array_get a (add (mul r n) k)) y (array_get b (add (mul r n) k)))
        (row_cos a b n r (add k 1) (float_add ab (float_mul x y)) (float_add aa (float_mul x x)) (float_add bb (float_mul y y))))))

; The least cosine of rows r up to t.
(def least_cos ((a (array float)) (b (array float)) (n int) (r int) (t int) (m float)) float
  (if (ge r t) m (least_cos a b n (add r 1) t (float_min m (row_cos a b n r 0 0.0 0.0 0.0)))))

(def largest ((a (array float)) (b (array float)) (k int) (m float)) float
  (if (ge k (min (array_len a) (array_len b))) m
      (let d (float_sub (array_get a k) (array_get b k))
        (largest a b (add k 1) (float_max m (if (float_lt d 0.0) (float_neg d) d))))))

; A float as millionths, to show it.
(def micro ((x float)) (list int) (digits (float_to_int (float_mul x 1000000.0))))

; The row of rows r up to t whose cosine is least, after w of cosine m.
(def worst_row ((a (array float)) (b (array float)) (n int) (r int) (t int) (w int) (m float)) int
  (if (ge r t) w
      (let c (row_cos a b n r 0 0.0 0.0 0.0)
        (if (float_lt c m) (worst_row a b n (add r 1) t r c) (worst_row a b n (add r 1) t w m)))))

; Blocks k up to n: each one's comparison, a line.
(def blocks ((e Encoder) (r Rows) (dir (list int)) (k int) (n int)) int
  (if (gt k n)
      0
      (let (got (encoder_run e r k)
            want (decimals (tail (fixture_of (append dir (append "/encoder" (append (digits k) ".txt"))))))
            l (write_line (append "block " (append (digits k) (append ": least cosine, millionths: " (append (micro (least_cos (.x got) want 512 0 (.n got) 2.0)) (append ", apart at most: " (append (micro (largest (.x got) want 0 0.0)) (append ", worst row " (digits (worst_row (.x got) want 512 0 (.n got) 0 2.0)))))))))))
        (blocks e r dir (add k 1) n))))

; The rows of x, n wide, as lines of millionths, from entry k.
(def rows_text ((x (array float)) (n int) (k int) (acc (list int))) (list int)
  (if (ge k (array_len x))
      (rev acc)
      (let (v (digits_signed (float_to_int (float_mul (array_get x k) 1000000.0)))
            sep (if (eq (mod (add k 1) n) 0) 10 32))
        (rows_text x n (add k 1) (cons sep (rev_onto v acc))))))
(def digits_signed ((v int)) (list int) (if (lt v 0) (cons 45 (digits (sub 0 v))) (digits v)))

(def check ((as (list (list int)))) int
  (match (read_whole (head as))
    ((Err why) (let w (write_line why) 1))
    ((Ok b)
      (match (whistle_of b)
        ((Err why) (let w (write_line why) 1))
        ((Ok wh)
          (let (dir (nth as 1)
                n (if (gt (length as) 2) (int_prefix (nth as 2) 0) 8)
                xs (chirp_of (append dir "/clip16.wav"))
                f (mel_features xs (array_len xs) (mel_matrix))
                r (stem_run (stem_of wh) f (div (array_len f) 80))
                e (encoder_of wh)
                ok (blocks e r dir 1 n)
                last (encoder_run e r n)
                w (write_whole (append dir "/l0-encoder.txt") (bytes_from_list (rows_text (.x last) 512 0 (nil int)))))
            ok))))))
(def main () int (check (args)))
