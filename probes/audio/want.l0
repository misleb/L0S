; want.l0 -- what L0S's HDMI audio driver for the Raspberry Pi 5,
; hdmi-audio, would open as it starts: channel 6 of the BCM2712's 40-bit
; DMA controller, dma40, beside the HD block that holds HDMI0's audio
; FIFO, the MAI. l0 check accepts it; on a Pi 5 today the channel's
; open_device gives DeviceFailed, since spec section 10.3 lists no DMA
; controller as a region. With the request in this directory, it says
; the channel's state and version, and the MAI's control word.

; Where each is in the CPU's map, and its bytes (bcm2712-ds.dtsi's
; dma40, channel 6 of channels 6 to 11 at 0x100 each; bcm2712.dtsi's
; hdmi0 reg-name hd).
(def dma40_ch6_base () int 68719543808)  ; 0x1000010600
(def dma40_ch_bytes () int 256)          ; 0x100
(def hd_base () int 70807322624)         ; 0x107C720000
(def hd_bytes () int 256)                ; 0x100

; Whether base, len is a region: 1 if it is, else 0.
(def opened ((base int) (len int)) int
  (match (open_device base len)
    ((DeviceFailed fault why) 0)
    ((DeviceOpened d) (let c (close_device d) 1))))

; The 32-bit word at off of the region base, len, or -1 with no region.
(def word_at ((base int) (len int) (off int)) int
  (match (open_device base len)
    ((DeviceFailed fault why) -1)
    ((DeviceOpened d) (let w (device_read32 d off) (let c (close_device d) w)))))

; The channel's CS, 0 while it is idle, and its DEBUG, whose bits 31 to
; 28 are the engine's version and 27 to 24 its ID (bcm2835-dma.c's
; BCM2711_DMA40_DEBUG_*).
(def channel_cs () int (word_at (dma40_ch6_base) (dma40_ch_bytes) 0))
(def channel_debug () int (word_at (dma40_ch6_base) (dma40_ch_bytes) 12))

; HDMI0's MAI_CTL, in the HD block. The HD block is a region already,
; but is read only once the firmware's M2MC clock is on, as hvs makes
; sure of first, so this sketch leaves it out unless asked.
(def mai_ctl () int (word_at (hd_base) (hd_bytes) 16))

; 1 once the request lands; then the channel's words.
(def main () int
  (let a (write_line (append "dma40 channel 6: " (digits (opened (dma40_ch6_base) (dma40_ch_bytes)))))
    (let b (write_line (append "CS: " (digits (channel_cs))))
      (let c (write_line (append "DEBUG: " (digits (channel_debug))))
        0))))
