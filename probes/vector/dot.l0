; dot.l0 -- the loop a model's inference is made of, in L0 as it is: a
; matrix of int8 weights, n by n, as bytes, times a vector of int8
; activations, each row's sum in an int, timed.

; The byte at i of b as a signed int8.
(def s8 ((b bytes) (i int)) int
  (let v (bytes_get b i) (if (ge v 128) (sub v 256) v)))

; Row r of w, n wide, times x: the sum of products, from j on.
(def row_dot ((w bytes) (x bytes) (r int) (n int) (j int) (acc int)) int
  (if (ge j n)
      acc
      (row_dot w x r n (add j 1) (add acc (mul (s8 w (add (mul r n) j)) (s8 x j))))))

; Each row's sum from r on, folded into one checksum so nothing is
; left out.
(def matvec ((w bytes) (x bytes) (n int) (r int) (sum int)) int
  (if (ge r n) sum (matvec w x n (add r 1) (bit_xor sum (row_dot w x r n 0 0)))))

; Bytes of n, each from a simple generator.
(def filled ((n int) (seed int) (acc (list int))) (list int)
  (if (le n 0) acc (filled (sub n 1) (mod (add (mul seed 1103515245) 12345) 2147483648) (cons (mod (div seed 65536) 256) acc))))

; The product run reps times; the checksum and ns per multiply-add.
(def run ((n int) (reps int)) int
  (let (w (bytes_from_list (filled (mul n n) 1 (nil int)))
        x (bytes_from_list (filled n 7 (nil int)))
        t0 (clock_ns)
        s (reps_of w x n reps 0)
        t1 (clock_ns)
        ops (mul reps (mul n n)))
    (let p (write_line (append "checksum " (append (digits s) (append ", " (append (digits (div (mul (sub t1 t0) 1000) ops)) " ps per multiply-add")))))
      0)))

; The product reps times.
(def reps_of ((w bytes) (x bytes) (n int) (reps int) (s int)) int
  (if (le reps 0) s (reps_of w x n (sub reps 1) (add s (matvec w x n 0 0)))))
