; want.l0 -- what L0S would write if L0 could slice and join bytes: the
; spawn call's header joined to a program image, and a received
; message's payload split off as bytes of its own, neither through a
; list. It checks with common/abi.l0 and common/text.l0, now that L0
; has both builtins (spec 6.6).

; What spawn_image takes: path's length and path, the arguments' length
; and the arguments encoded, then the image, joined as bytes.
(def spawn_image_bytes ((path (list int)) (enc (list int)) (image bytes)) bytes
  (let hdr (bytes_from_list (append (u32_le (length path)) (append path (append (u32_le (length enc)) enc))))
    (bytes_concat (cons hdr (cons image (nil bytes))))))

; The payload of a message's bytes b, past the sender's pid, as bytes:
; what a server keeps or passes on without reading it as text.
(def msg_payload ((b bytes)) bytes
  (bytes_slice b 4 (bytes_len b)))

; A write's request to the file server: its text in front of the bytes
; a process wrote, which the kernel copied out of its space as bytes.
(def write_request ((reply int) (h int) (written bytes)) bytes
  (bytes_concat (cons (bytes_from_list (append (u32_le reply) (append "write " (append (digits h) " "))))
                      (cons written (nil bytes)))))
