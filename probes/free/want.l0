; want.l0 -- what L0S's kernel would do when a process ends, if L0 could
; free a space and a frame: give back the space, and each frame no other
; process maps. l0 check rejects it today: neither builtin exists.

(def release ((s int) (fs (list int))) int
  (let r (space_free s)
    (free_all fs)))

(def free_all ((fs (list int))) int
  (if (is_empty fs) 0 (let r (frame_free (head fs)) (free_all (tail fs)))))
