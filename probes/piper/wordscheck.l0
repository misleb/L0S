; wordscheck.l0 -- phonemes.l0's words against espeak-ng's (roadmap 0062):
; each word of a list words.py wrote said by CMUdict and by the rules
; alone, and how many of each are espeak-ng's, then each miss of the
; dictionary's as the word, ours and espeak-ng's.
;
;   l0 run common/abi.l0 common/text.l0 user/lib/sys/cli.l0 \
;     user/lib/format/json.l0 user/lib/speech/voice.l0 \
;     user/lib/speech/phonemes.l0 probes/piper/wordscheck.l0 \
;     -- CMUDICT WORDS [MISSES]

; The counts: words, the dictionary's agreeing, the rules', and the
; misses of the dictionary's kept to be shown, reversed.
(data Tally (Tally (n int) (dict int) (rules int) (misses (list (list int)))))

; t with the line "WORD\tIPA" counted.
(def tally_line ((p Phonemizer) (t Tally) (line (list int))) Tally
  (let (w (up_to 9 line)
        ref (drop line (add (length w) 1))
        d (phon_word p w)
        r (phon_ipa (phon_lts p w))
        t1 (.n t (add (.n t) 1))
        t2 (if (list_eq d ref) (.dict t1 (add (.dict t1) 1)) (.misses t1 (cons (unwords (cons w (cons d (cons ref (nil (list int)))))) (.misses t1)))))
    (if (list_eq r ref) (.rules t2 (add (.rules t2) 1)) t2)))

; The tally of the lines ls.
(def tally_lines ((p Phonemizer) (t Tally) (ls (list (list int)))) Tally
  (if (is_empty ls) t (tally_lines p (if (is_empty (head ls)) t (tally_line p t (head ls))) (tail ls))))

; The check: counts, then up to k misses.
(def check ((dict (list int)) (words (list int)) (k int)) int
  (match (read_whole dict)
    ((Err why) (complain_as "wordscheck" why))
    ((Ok d) (match (read_whole words)
              ((Err why) (complain_as "wordscheck" why))
              ((Ok ws) (let (t (tally_lines (phon_new d) (Tally 0 0 0 (nil (list int))) (lines (bytes_to_list ws)))
                             out (cons (unwords (cons "words" (cons (digits (.n t)) (cons "dictionary" (cons (digits (.dict t)) (cons "rules" (cons (digits (.rules t)) (nil (list int)))))))))
                                       (take (rev (.misses t)) k)))
                         (let w (write_str (join_with "\n" out)) (let x (write_str "\n") 0))))))))

(def main () int
  (check (arg 0) (arg 1) (if (gt (arg_count) 2) (match (word_number (arg 2)) ((None) 0) ((Some k) k)) 0)))
