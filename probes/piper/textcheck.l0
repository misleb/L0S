; textcheck.l0 -- phonemes.l0's sentences against Piper's own (roadmap
; 0062): for each of oracle.py's directories, its text said by L0S, a
; line each sentence, beside the phonemes and IDs Piper's espeak-ng
; gave, and whether they are the same.
;
;   l0 run common/abi.l0 common/text.l0 user/lib/sys/cli.l0 \
;     user/lib/format/json.l0 user/lib/speech/voice.l0 \
;     user/lib/speech/phonemes.l0 probes/piper/textcheck.l0 \
;     -- CMUDICT VOICE.onnx.json DIR...

; The IDs as words.
(def id_words ((ids (list int))) (list int)
  (unwords (map_digits ids)))
(def map_digits ((ns (list int))) (list (list int))
  (if (is_empty ns) (nil (list int)) (cons (digits (head ns)) (map_digits (tail ns)))))

; The lines of the report for one sentence: ours, Piper's, and same or
; differ, for its phonemes and its IDs.
(def sentence_lines ((c VoiceConfig) (ours (list int)) (theirs (list int)) (their_ids (list int))) (list (list int))
  (let ids (id_words (phon_ids c ours))
    (cons (append "  L0S:   " ours)
          (cons (append "  Piper: " theirs)
                (cons (append "  phonemes " (append (if (list_eq ours theirs) "same" "differ") (append ", IDs " (if (list_eq ids their_ids) "same" "differ"))))
                      (nil (list int)))))))

; The report of each sentence of ours against theirs.
(def sentences_lines ((c VoiceConfig) (ours (list (list int))) (theirs (list (list int))) (ids (list (list int)))) (list (list int))
  (if (or (is_empty ours) (or (is_empty theirs) (is_empty ids)))
      (nil (list int))
      (append (sentence_lines c (head ours) (head theirs) (head ids)) (sentences_lines c (tail ours) (tail theirs) (tail ids)))))

; The file at path as its lines, none if it cannot be read.
(def file_lines ((path (list int))) (list (list int))
  (match (read_whole path) ((Err why) (nil (list int))) ((Ok b) (lines (bytes_to_list b)))))

; The report for each directory of ds.
(def dirs_lines ((p Phonemizer) (c VoiceConfig) (ds (list (list int)))) (list (list int))
  (if (is_empty ds)
      (nil (list int))
      (let (d (head ds)
            text (head (file_lines (append d "/text.txt"))))
        (cons (append d (append ": " text))
              (append (sentences_lines c (phon_sentences p text) (file_lines (append d "/phonemes.txt")) (file_lines (append d "/ids.txt")))
                      (dirs_lines p c (tail ds)))))))

; The directories named after the first two arguments.
(def dir_args ((k int) (acc (list (list int)))) (list (list int))
  (if (ge k (arg_count)) (rev acc) (dir_args (add k 1) (cons (arg k) acc))))

(def check () int
  (match (read_whole (arg 0))
    ((Err why) (complain_as "textcheck" why))
    ((Ok d) (match (read_whole (arg 1))
              ((Err why) (complain_as "textcheck" why))
              ((Ok cb) (match (voice_config_of cb)
                         ((Err why) (complain_as "textcheck" why))
                         ((Ok c) (let w (write_str (join_with "\n" (dirs_lines (phon_new d) c (dir_args 2 (nil (list int))))))
                                   (let x (write_str "\n") 0)))))))))

(def main () int (check))
