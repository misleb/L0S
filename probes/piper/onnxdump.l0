; onnxdump.l0 -- a check of format/onnx.l0 on a Piper voice itself: every
; initializer, by name in sorted order, as its type, shape, the bits of
; its first and last numbers and its count, a line each, the same lines
; dump.py prints with the onnx package, so a diff is the check.
;
;   l0 run common/abi.l0 common/text.l0 user/lib/sys/cli.l0 \
;     user/lib/format/onnx.l0 probes/piper/onnxdump.l0 -- VOICE.onnx

; Tensor t of o as a line: name, type, dimensions, first and last
; numbers' bits in hexadecimal, count.
(def tensor_line ((o Onnx) (t OnnxTensor)) (list int)
  (let n (onnx_numel t)
    (unwords (cons (.name t) (cons (digits (.dtype t))
      (cons (join_with "x" (map_digits (.shape t) (nil (list int))))
        (cons (word_bits o t 0) (cons (word_bits o t (sub n 1)) (cons (digits n) (nil (list int)))))))))))

; The 32 bits of float k of t, as 8 hex digits.
(def word_bits ((o Onnx) (t OnnxTensor) (k int)) (list int)
  (hex_digits (le_u32 (.b o) (add (.at t) (mul 4 k))) 8))

; ns in decimal, a list of words.
(def map_digits ((ns (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty ns) (rev acc) (map_digits (tail ns) (cons (digits (head ns)) acc))))

; The lines of the initializers named in names, which have no "#".
(def lines_of ((o Onnx) (names (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty names)
      (rev acc)
      (match (onnx_find o (head names))
        ((None) (lines_of o (tail names) acc))
        ((Some t) (lines_of o (tail names) (if (any_eq 35 (head names)) acc (cons (tensor_line o t) acc)))))))

; The dump of the voice at path.
(def dump ((path (list int))) int
  (match (read_whole path)
    ((Err why) (complain_as "onnxdump" why))
    ((Ok b) (match (onnx_of b)
              ((Err why) (complain_as "onnxdump" why))
              ((Ok o) (let w (write_str (join_with "\n" (cons (append "count " (digits (onnx_count o)))
                                                              (lines_of o (sort (map_keys (.ts o))) (nil (list int))))))
                        (let x (write_str "\n") 0)))))))

(def main () int (dump (arg 0)))
