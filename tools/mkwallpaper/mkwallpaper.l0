; mkwallpaper.l0 -- draws an SVG document, L0S's wallpaper
; (branding/wallpaper-dark.svg), W by H pixels, opaque, as a QOI image
; (qoi.l0), at build time: the initramfs's /etc/wallpaper.qoi at 1920 by
; 1080 and /etc/wallpaper2x.qoi at 3840 by 2160, which the display
; drivers show as their first frame and wm as its wallpaper.
;
;   mkwallpaper branding/wallpaper-dark.svg 1920 1080 build/wallpaper.qoi
;
; The document is fitted whole and centered (svg.l0); whatever it leaves
; clear, or partly so, is drawn over black.

; Says why on standard error: status 1.
(def mkwallpaper_complain ((why (list int))) int (complain_as "mkwallpaper" why))

; The program: argv is the SVG, the width, the height, and the file to
; write.
(def mkwallpaper ((argv (list (list int)))) int
  (if (not (eq (length argv) 4))
      (mkwallpaper_complain "usage: mkwallpaper SVG WIDTH HEIGHT OUT.qoi")
      (match (mkwallpaper_size (nth argv 1) (nth argv 2))
        ((Err why) (mkwallpaper_complain why))
        ((Ok wh)
          (match (read_whole (head argv))
            ((Err why) (mkwallpaper_complain (append (head argv) (append ": " why))))
            ((Ok b)
              (match (mkwallpaper_qoi b (head wh) (nth wh 1))
                ((Err why) (mkwallpaper_complain (append (head argv) (append ": " why))))
                ((Ok q)
                  (let e (write_whole (nth argv 3) q)
                    (if (is_empty e) 0 (mkwallpaper_complain (append (nth argv 3) (append ": " e)))))))))))))

; A width and a height, each 1 to 16384, from their words; or why not.
(def mkwallpaper_size ((w (list int)) (h (list int))) (Result (list int) (list int))
  (match (word_number w)
    ((None) ((Err (list int) (list int)) (append "no width: " w)))
    ((Some x)
      (match (word_number h)
        ((None) ((Err (list int) (list int)) (append "no height: " h)))
        ((Some y)
          (if (if (lt x 1) true (if (lt y 1) true (if (gt x 16384) true (gt y 16384))))
              ((Err (list int) (list int)) "a size from 1 to 16384 each way")
              ((Ok (list int) (list int)) (cons x (cons y (nil int))))))))))

; An SVG document's bytes drawn w by h, opaque, as QOI; or why not.
(def mkwallpaper_qoi ((b bytes) (w int) (h int)) (Result bytes (list int))
  (match (svg_read b)
    ((Err why) ((Err bytes (list int)) why))
    ((Ok root)
      (match (svg_argb_wh root w h)
        ((Err why) ((Err bytes (list int)) why))
        ((Ok words) ((Ok bytes (list int)) (qoi_encode (mkwallpaper_opaque words 0) w h)))))))

; ARGB words, from i on, each made 0xRRGGBB over black by its alpha, in
; place.
(def mkwallpaper_opaque ((px (array int)) (i int)) (array int)
  (if (ge i (array_len px))
      px
      (let c (mkwallpaper_over_black (array_get px i))
        (mkwallpaper_opaque (array_set px i c) (add i 1)))))

; One ARGB word, not premultiplied, over black: each channel by alpha,
; rounded.
(def mkwallpaper_over_black ((w int)) int
  (let a (bit_and (bit_shr w 24) 255)
    (if (eq a 255)
        (bit_and w 16777215)
        (rgb (mkwallpaper_scaled (rgb_red w) a) (mkwallpaper_scaled (rgb_green w) a) (mkwallpaper_scaled (rgb_blue w) a)))))

; c by a / 255, rounded.
(def mkwallpaper_scaled ((c int) (a int)) int (div (add (mul c a) 127) 255))
