; mkwallpaper_test.l0 -- tests of drawing a wallpaper: its size read,
; what it leaves clear made opaque over black, and the QOI it writes.

; A document 2 wide and 1 high: red on the left, clear on the right.
(def half_red () bytes
  (bytes_from_list "<svg viewBox=\"0 0 2 1\"><rect width=\"1\" height=\"1\" fill=\"#ff0000\"/></svg>"))

; Drawn 4 by 2 and read back: two red pixels then two black, each row.
(def test_drawn () int
  (match (mkwallpaper_qoi (half_red) 4 2)
    ((Err why) (fail_because "drawn" why))
    ((Ok q)
      (match (qoi_rgb q)
        ((Err why) (fail_because "drawn" why))
        ((Ok b) (check_str "row 0" (hex_digits (pixel_at b 0 4 1 0) 6) "ff0000"))))))

; Its header: 4 by 2.
(def test_size_written () int
  (match (mkwallpaper_qoi (half_red) 4 2)
    ((Err why) (fail_because "size" why))
    ((Ok q)
      (match (qoi_header q)
        ((Qoi w h off) (check_int "width by height" (add (mul w 10) h) 42))
        ((QoiBad why) (fail_because "size" why))))))

; Half alpha over black: 255 · 128 / 255 is 128, and none clear is 0.
(def test_over_black () int
  (add (check_str "half red" (hex_digits (mkwallpaper_over_black 2164195328) 6) "800000")
       (add (check_str "clear" (hex_digits (mkwallpaper_over_black 16777215) 6) "000000")
            (check_str "opaque" (hex_digits (mkwallpaper_over_black 4281697508) 6) "3584e4"))))

(def test_size_read () int
  (add (check_str "both" (match (mkwallpaper_size "1920" "1080") ((Ok wh) (unwords (cons (digits (head wh)) (cons (digits (nth wh 1)) (nil (list int)))))) ((Err why) why)) "1920 1080")
       (add (check_str "no width" (match (mkwallpaper_size "wide" "1") ((Ok wh) "read") ((Err why) why)) "no width: wide")
            (check_str "none" (match (mkwallpaper_size "0" "1") ((Ok wh) "read") ((Err why) why)) "a size from 1 to 16384 each way"))))

; What the SVG library refuses is said.
(def test_refused () int
  (check_str "text" (match (mkwallpaper_qoi (bytes_from_list "<svg viewBox=\"0 0 1 1\"><text>hi</text></svg>") 1 1) ((Ok q) "drawn") ((Err why) why))
             "cannot draw <text>"))

; With no arguments, it says how it is used: status 1.
(def test_usage () int
  (check_int "status" (mkwallpaper (nil (list int))) 1))
