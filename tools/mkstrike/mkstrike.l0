; mkstrike.l0 -- makes a strike (format/strike.l0) at the build: a
; TrueType font at a line height, rasterized by gfx/glyphs.l0, the code
; the font service, user/sbin/font, rasterizes any other height with on
; the board. The Makefile makes the desktop's, Source Code Pro's regular
; and bold at 16, 32 and 64, into /etc/fonts, which font keeps as it
; starts, so no boot spends the time rasterizing them.
;
;   mkstrike FONT.ttf H OUT

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "mkstrike" why))

; The strike the arguments ask for, written where they say.
(def mkstrike ((argv (list (list int)))) int
  (if (not (eq (length argv) 3))
      (complain "usage: mkstrike FONT.ttf H OUT")
      (match (word_number (nth argv 1))
        ((None) (complain (append "not a height: " (nth argv 1))))
        ((Some h)
          (match (mkstrike_made (nth argv 0) h)
            ((Err why) (complain why))
            ((Ok b)
              (let e (write_whole (nth argv 2) b)
                (if (is_empty e) 0 (complain e)))))))))

; The font at path at line height h, as a strike; or why not.
(def mkstrike_made ((path (list int)) (h int)) (Result bytes (list int))
  (if (if (lt h 8) true (gt h 128))
      ((Err bytes (list int)) "a line height is 8 to 128")
      (match (read_whole path)
        ((Err why) ((Err bytes (list int)) (append path (append ": " why))))
        ((Ok b)
          (match (ttf_read b)
            ((Err why) ((Err bytes (list int)) (append path (append ": " why))))
            ((Ok f) ((Ok bytes (list int)) (strike_make f h))))))))
