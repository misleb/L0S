; mkstrike_test.l0 -- tests of mkstrike: the strike it makes of a font
; in fonts/, and what it refuses. Run from the top of the project.

(def test_made () int
  (match (mkstrike_made "fonts/SourceCodePro-Bold.ttf" 16)
    ((Err why) (fail_because "made" why))
    ((Ok b) (add (check_true "a strike" (strike_ok b)) (check_int "its height" (strike_height b) 16)))))

(def test_no_font () int
  (match (mkstrike_made "fonts/none.ttf" 16)
    ((Ok b) (fail_because "made" "a strike of no font"))
    ((Err why) (check_true "why" (starts_with why "fonts/none.ttf: ")))))

(def test_height () int
  (match (mkstrike_made "fonts/SourceCodePro-Bold.ttf" 200)
    ((Ok b) (fail_because "made" "a strike 200 tall"))
    ((Err why) (check_str "why" why "a line height is 8 to 128"))))
