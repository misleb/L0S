; mkfont_test.l0 -- tests of mkfont: cursors.paths read into blocks, the
; pointer's pixels, and the face it writes, read back. Run from the top
; of the project.

(def block_text ((b MkBlock)) (list int)
  (match b
    ((MkCursor name ls) (append "cursor" (append (if (is_empty name) "" (append "." name)) (append ":" (digits (length ls))))))))

(def blocks_text ((bs (list MkBlock)) (acc (list (list int)))) (list int)
  (if (is_empty bs) (unwords (rev acc)) (blocks_text (tail bs) (cons (block_text (head bs)) acc))))

(def test_blocks () int
  (check_str "the pointers"
    (blocks_text (mkfont_blocks (lines "; a comment\nwhite rect 9 9 1 1\ncursor\nwhite rect 0 0 1 1\n\ncursor ew-resize\nwhite rect 0 0 1 1\nblack rect 0 0 1 1\n") (nil MkBlock))
                 (nil (list int)))
    "cursor:1 cursor.ew-resize:2"))

(def test_colored () int
  (check_strs "black lines"
    (mkfont_colored (cons "white rect 0 0 1 1" (cons "black circle 1 1 1" (nil (list int)))) "black " (nil (list int)))
    (cons "circle 1 1 1" (nil (list int)))))

; Black over white: opaque black; white alone: opaque white; neither:
; clear; half white: half alpha, still white.
(def test_pixel () int
  (add (check_str "black" (hex_digits (mkfont_pixel 15 15) 8) "ff000000")
       (add (check_str "white" (hex_digits (mkfont_pixel 15 0) 8) "ffffffff")
            (add (check_str "clear" (hex_digits (mkfont_pixel 0 0) 8) "00000000")
                 (check_str "half white" (hex_digits (mkfont_pixel 8 0) 8) "88ffffff")))))

; The face it makes of fonts/cursors.paths is the pointers' only, each
; 64 by 64, the arrow among them; no glyphs.
(def test_tables () int
  (match (mkfont_tables "fonts/cursors.paths")
    ((Err why) (fail_because "tables" why))
    ((Ok ts)
      (let m (ui_face_tables (ui_face_file ts))
        (add (check_true "the arrow" (map_has m (ui_cursor_table "")))
             (check_bool "no glyphs" (map_has m "glyph.regular.16") false))))))
