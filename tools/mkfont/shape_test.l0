; shape_test.l0 -- tests of the pointers' shape language: numbers, paths,
; the figures, and their coverage.

(def num_or ((w (list int))) int (match (shape_num w) ((Some v) v) ((None) -99999)))

(def test_numbers () int
  (add (check_int "4" (num_or "4") 1024)
       (add (check_int "4.5" (num_or "4.5") 1152)
            (add (check_int "-0.25" (num_or "-0.25") -64)
                 (check_int "1.125" (num_or "1.125") 288)))))

(def test_bad_numbers () int
  (add (check_int "x" (num_or "x") -99999)
       (add (check_int "1.2345" (num_or "1.2345") -99999)
            (check_int "1." (num_or "1.") -99999))))

; On a 16-pixel grid at 16 pixels a unit is a pixel, 256.
(def unit () ShapeScale (ShapeScale 16 16))

(def path_len ((s (list int))) int
  (match (shape_path (split_spaces s) (unit)) ((Ok segs) (length segs)) ((Err why) -1)))

(def test_path () int
  (add (check_int "move, two lines, close" (path_len "M 0 0 L 4 0 l 0 4 Z") 5)
       (check_int "H and V" (path_len "M 1 1 H 5 V 5") 3)))

(def test_path_refused () int
  (add (check_int "no command" (path_len "M 0 0 X 1") -1)
       (check_int "cut short" (path_len "M 0 0 L 1") -1)))

; Relative points are from where the path is: l 0 4 after L 4 0 ends at
; 4, 4.
(def test_relative () int
  (match (shape_path (split_spaces "M 0 0 L 4 0 l 0 4") (unit))
    ((Ok segs) (check_true "at 4, 4" (eq (head (rev segs)) (RastLine 1024 1024))))
    ((Err why) (fail_because "path" why))))

(def cover_of ((lines (list (list int))) (n int)) (array int)
  (match (shape_cover lines (ShapeScale n 16) n n) ((Ok c) c) ((Err why) (array_new 0 0))))

(def level_at ((c (array int)) (n int) (x int) (y int)) int
  (if (lt (array_len c) (mul n n)) -1 (array_get c (add (mul y n) x))))

(def test_rect () int
  (let c (cover_of (cons "rect 2 2 4 4" (nil (list int))) 16)
    (add (check_int "inside" (level_at c 16 3 3) 15)
         (check_int "outside" (level_at c 16 7 7) 0))))

; A ring's middle is its hole.
(def test_ring () int
  (let c (cover_of (cons "ring 8 8 5 2" (nil (list int))) 16)
    (add (check_int "the hole" (level_at c 16 8 8) 0)
         (check_int "on the line" (level_at c 16 13 8) 15))))

(def test_circle () int
  (let c (cover_of (cons "circle 8 8 4" (nil (list int))) 16)
    (add (check_int "the middle" (level_at c 16 8 8) 15)
         (check_int "the corner" (level_at c 16 0 0) 0))))

; A stroke covers its line and not far from it.
(def test_stroke () int
  (let c (cover_of (cons "stroke 2 M 2 8 L 14 8" (nil (list int))) 16)
    (add (check_int "on it" (level_at c 16 8 7) 15)
         (check_int "away" (level_at c 16 8 3) 0))))

; A stroke's joins wind the way its lines do, so where they overlap is
; covered, not a hole: the corner of a chevron, and its ends.
(def test_stroke_joins () int
  (let c (cover_of (cons "stroke 2 M 3 4 L 8 9 L 13 4" (nil (list int))) 16)
    (add (check_int "the corner" (level_at c 16 8 8) 15)
         (check_int "an end" (level_at c 16 3 4) 15))))

; Shapes over one another do not cancel, however they wind.
(def test_shapes_unite () int
  (let c (cover_of (cons "rect 0 0 8 8" (cons "fill M 0 0 V 8 H 8 V 0 Z" (nil (list int)))) 16)
    (check_int "still covered" (level_at c 16 3 3) 15)))

; A frame is its border: its middle is empty.
(def test_frame () int
  (let c (cover_of (cons "frame 1 1 14 14 2 1" (nil (list int))) 16)
    (add (check_int "the middle" (level_at c 16 8 8) 0)
         (check_int "the border" (level_at c 16 1 8) 15))))

; At 32 pixels the grid of 16 is twice as fine.
(def test_scaled () int
  (let c (cover_of (cons "rect 2 2 4 4" (nil (list int))) 32)
    (add (check_int "inside" (level_at c 32 11 11) 15)
         (check_int "outside" (level_at c 32 12 12) 0))))

; A disc is the same left and right, and top and bottom.
(def test_disc_symmetric () int
  (let c (cover_of (cons "circle 8 8 5" (nil (list int))) 16)
    (add (check_int "left right" (level_at c 16 4 8) (level_at c 16 11 8))
         (check_int "up down" (level_at c 16 8 4) (level_at c 16 8 11)))))

(def test_bad_shape () int
  (match (shape_cover (cons "blob 1 2" (nil (list int))) (unit) 16 16)
    ((Ok c) (fail_because "shape" "drew a blob"))
    ((Err why) (check_str "why" why "no shape blob: blob 1 2"))))
