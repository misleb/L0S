; raster.l0 -- outlines to coverage, in integers only, since L0 has no
; floating point: how much of each pixel a shape covers, 0 to 15.
;
; A shape is contours of segments, lines and quadratic and cubic Bézier
; curves, in 1/256 of a pixel, y down. The curves are cut into lines, few
; enough that none strays more than an eighth of a pixel from its curve.
; Each pixel row is sampled 16 times, at the middle of each sixteenth;
; along each sample the edges that cross it are found, and the stretches
; inside the shape by the nonzero rule are added to the row exactly, in
; 1/256 pixel. A pixel wholly inside gets 16 · 256 = 4096, and its level
; is that scaled to 0 to 15. Shapes are drawn one at a time, and put
; together by keeping each pixel's most, so that strokes and fills of one
; icon never cancel.
;
; Points are render.l0's Point.

; ------------------------------------------------------------------ shapes

; A segment of a contour: a move to a point, which starts one; a line, a
; quadratic or a cubic curve from where the one before ended, its control
; points then its end; or the contour closed, back to where it began.
(data RastSeg
  (RastMove int int)
  (RastLine int int)
  (RastQuad int int int int)
  (RastCubic int int int int int int)
  (RastClose))

; One pixel, in 1/256 of a pixel.
(def rast_one () int 256)

; ------------------------------------------------------------- flattening

; The contours of segs, each as the points of the lines that make it, the
; curves cut into lines.
(def rast_polygons ((segs (list RastSeg))) (list (list Point))
  (rast_flat segs 3 0 0 (nil Point) (nil (list Point))))

; The same as lines to stroke: every contour of two points or more, as
; they run, whether closed or not.
(def rast_polylines ((segs (list RastSeg))) (list (list Point))
  (rast_flat segs 2 0 0 (nil Point) (nil (list Point))))

; Through segs, at x, y, the contour so far reversed in cur, the contours
; done reversed in acc, each kept if it has at least keep points.
(def rast_flat ((segs (list RastSeg)) (keep int) (x int) (y int) (cur (list Point)) (acc (list (list Point)))) (list (list Point))
  (if (is_empty segs)
      (rev (rast_done cur keep acc))
      (match (head segs)
        ((RastMove nx ny) (rast_flat (tail segs) keep nx ny (cons (Point nx ny) (nil Point)) (rast_done cur keep acc)))
        ((RastLine nx ny) (rast_flat (tail segs) keep nx ny (cons (Point nx ny) (rast_started cur x y)) acc))
        ((RastQuad cx cy nx ny)
          (rast_flat (tail segs) keep nx ny (rast_quad_onto x y cx cy nx ny (rast_quad_steps x y cx cy nx ny) 1 (rast_started cur x y)) acc))
        ((RastCubic ax ay bx by nx ny)
          (rast_flat (tail segs) keep nx ny
                     (rast_cubic_onto x y ax ay bx by nx ny (rast_cubic_steps x y ax ay bx by nx ny) 1 (rast_started cur x y)) acc))
        ((RastClose) (rast_flat (tail segs) keep x y (nil Point) (rast_done cur keep acc))))))

; A contour with at least its first point: x, y, where a segment with no
; move before it starts.
(def rast_started ((cur (list Point)) (x int) (y int)) (list Point)
  (if (is_empty cur) (cons (Point x y) (nil Point)) cur))

; A contour finished: kept if it has keep points or more.
(def rast_done ((cur (list Point)) (keep int) (acc (list (list Point)))) (list (list Point))
  (if (lt (length cur) keep) acc (cons (rev cur) acc)))

(def rast_abs ((v int)) int (if (lt v 0) (neg v) v))

; How far a curve bends: the larger of a second difference's two parts.
(def rast_bend ((x0 int) (y0 int) (x1 int) (y1 int) (x2 int) (y2 int)) int
  (max (rast_abs (add (sub x0 (mul 2 x1)) x2)) (rast_abs (add (sub y0 (mul 2 y1)) y2))))

; How many lines a quadratic curve is cut into: n of them stray at most
; bend / 8n² from it, which is at most an eighth of a pixel, 32, once
; n² ≥ bend / 256.
(def rast_quad_steps ((x0 int) (y0 int) (cx int) (cy int) (x1 int) (y1 int)) int
  (add 1 (isqrt (div (rast_bend x0 y0 cx cy x1 y1) 256))))

; The same for a cubic one: n lines stray at most 3 bend / 4n².
(def rast_cubic_steps ((x0 int) (y0 int) (ax int) (ay int) (bx int) (by int) (x1 int) (y1 int)) int
  (add 1 (isqrt (div (mul 3 (max (rast_bend x0 y0 ax ay bx by) (rast_bend ax ay bx by x1 y1))) 128))))

; Points i to n of n along a quadratic curve, consed onto acc.
(def rast_quad_onto ((x0 int) (y0 int) (cx int) (cy int) (x1 int) (y1 int) (n int) (i int) (acc (list Point))) (list Point)
  (if (gt i n)
      acc
      (rast_quad_onto x0 y0 cx cy x1 y1 n (add i 1)
        (cons (Point (rast_quad_at x0 cx x1 n i) (rast_quad_at y0 cy y1 n i)) acc))))

; A quadratic curve at t = i / n, along one axis.
(def rast_quad_at ((p0 int) (c int) (p1 int) (n int) (i int)) int
  (let j (sub n i)
    (div (add (mul p0 (mul j j)) (add (mul (mul 2 c) (mul i j)) (mul p1 (mul i i)))) (mul n n))))

(def rast_cubic_onto ((x0 int) (y0 int) (ax int) (ay int) (bx int) (by int) (x1 int) (y1 int) (n int) (i int) (acc (list Point))) (list Point)
  (if (gt i n)
      acc
      (rast_cubic_onto x0 y0 ax ay bx by x1 y1 n (add i 1)
        (cons (Point (rast_cubic_at x0 ax bx x1 n i) (rast_cubic_at y0 ay by y1 n i)) acc))))

(def rast_cubic_at ((p0 int) (a int) (b int) (p1 int) (n int) (i int)) int
  (let j (sub n i)
    (div (add (add (mul p0 (mul j (mul j j))) (mul (mul 3 a) (mul i (mul j j))))
              (add (mul (mul 3 b) (mul (mul i i) j)) (mul p1 (mul i (mul i i)))))
         (mul n (mul n n)))))

; ------------------------------------------------------------------ edges

; An edge of a polygon, from its upper end to its lower, and +1 if it
; went down, -1 if up: horizontal ones are left out, since no sample
; along a row crosses them.
(data RastEdge (RastEdge int int int int int))

; The edges of every polygon.
(def rast_edges ((ps (list (list Point)))) (list RastEdge)
  (rast_edges_onto ps (nil RastEdge)))

(def rast_edges_onto ((ps (list (list Point))) (acc (list RastEdge))) (list RastEdge)
  (if (is_empty ps)
      acc
      (rast_edges_onto (tail ps) (rast_ring (head ps) (head (head ps)) acc))))

; A polygon's edges, each point to the next, the last back to first.
(def rast_ring ((pts (list Point)) (first Point) (acc (list RastEdge))) (list RastEdge)
  (if (is_empty pts)
      acc
      (let next (if (is_empty (tail pts)) first (head (tail pts)))
        (rast_ring (tail pts) first (rast_edge (head pts) next acc)))))

(def rast_edge ((a Point) (b Point) (acc (list RastEdge))) (list RastEdge)
  (match a
    ((Point x0 y0)
      (match b
        ((Point x1 y1)
          (if (eq y0 y1)
              acc
              (if (lt y0 y1)
                  (cons (RastEdge x0 y0 x1 y1 1) acc)
                  (cons (RastEdge x1 y1 x0 y0 -1) acc))))))))

; --------------------------------------------------------------- coverage

; How much of each pixel of a w by h grid the polygons cover, by the
; nonzero rule: w · h levels, row after row, each 0 to 15.
(def rast_cover ((ps (list (list Point))) (w int) (h int)) (array int)
  (rast_rows (rast_edges ps) w h 0 (array_new (mul w h) 0)))

(def rast_rows ((es (list RastEdge)) (w int) (h int) (y int) (out (array int))) (array int)
  (if (ge y h)
      out
      (let row (rast_samples (rast_in_row es y (nil RastEdge)) w (add (mul y (rast_one)) 8) 16 (array_new w 0))
        (rast_rows es w h (add y 1) (rast_levels row (mul y w) 0 w out)))))

; The edges with some part in pixel row y.
(def rast_in_row ((es (list RastEdge)) (y int) (acc (list RastEdge))) (list RastEdge)
  (if (is_empty es)
      acc
      (match (head es)
        ((RastEdge x0 y0 x1 y1 d)
          (rast_in_row (tail es) y
            (if (if (lt y0 (mul (add y 1) (rast_one))) (gt y1 (mul y (rast_one))) false) (cons (head es) acc) acc))))))

; n samples of a row, from ys down 16 at a time, added to row.
(def rast_samples ((es (list RastEdge)) (w int) (ys int) (n int) (row (array int))) (array int)
  (if (eq n 0)
      row
      (rast_samples es w (add ys 16) (sub n 1)
                    (rast_spans (sort (rast_crossings es ys (nil RastCross))) 0 0 w row))))

; Where an edge crosses a sample, and which way it goes.
(data RastCross (RastCross int int))

(def rast_crossings ((es (list RastEdge)) (ys int) (acc (list RastCross))) (list RastCross)
  (if (is_empty es)
      acc
      (match (head es)
        ((RastEdge x0 y0 x1 y1 d)
          (rast_crossings (tail es) ys
            (if (if (le y0 ys) (lt ys y1) false)
                (cons (RastCross (add x0 (div (mul (sub ys y0) (sub x1 x0)) (sub y1 y0))) d) acc)
                acc))))))

; Along a sample, the crossings in order: where the winding count is not
; 0, from the crossing before to this one, is inside.
(def rast_spans ((cs (list RastCross)) (wind int) (from int) (w int) (row (array int))) (array int)
  (if (is_empty cs)
      row
      (match (head cs)
        ((RastCross x d)
          (rast_spans (tail cs) (add wind d) x w
                      (if (eq wind 0) row (rast_add_span row from x w)))))))

; xa up to xb, in 1/256 pixel, added to the pixels it covers, as much of
; each as it does.
(def rast_add_span ((row (array int)) (xa int) (xb int) (w int)) (array int)
  (let a (max xa 0)
    (let b (min xb (mul w (rast_one)))
      (if (le b a) row (rast_add_px row a b (div a (rast_one)))))))

(def rast_add_px ((row (array int)) (a int) (b int) (px int)) (array int)
  (let lo (max a (mul px (rast_one)))
    (let hi (min b (mul (add px 1) (rast_one)))
      (if (le hi lo)
          row
          (rast_add_px (array_set row px (add (array_get row px) (sub hi lo))) a b (add px 1))))))

; A row's sums, at most 4096 a pixel, as levels, into out from at.
(def rast_levels ((row (array int)) (at int) (x int) (w int) (out (array int))) (array int)
  (if (ge x w)
      out
      (rast_levels row at (add x 1) w (array_set out (add at x) (rast_level (array_get row x))))))

(def rast_level ((sum int)) int (min 15 (div (add (mul sum 15) 2048) 4096)))

; Two coverages of one size put together: each pixel the more covered.
(def rast_union ((a (array int)) (b (array int))) (array int)
  (rast_union_from a b 0))

(def rast_union_from ((a (array int)) (b (array int)) (i int)) (array int)
  (if (ge i (array_len a))
      a
      (let v (max (array_get a i) (array_get b i))
        (rast_union_from (array_set a i v) b (add i 1)))))

; -------------------------------------------------------------- packing

; Coverage w wide as words, 16 levels to a word, the leftmost pixel in the
; highest four bits: each row as many words as its 16s, the last padded
; with 0.
(def rast_words_per_row ((w int)) int (div (add w 15) 16))

(def rast_pack ((cov (array int)) (w int) (h int)) (array int)
  (let wpr (rast_words_per_row w)
    (rast_pack_at cov w wpr 0 (mul h wpr) (array_new (mul h wpr) 0))))

(def rast_pack_at ((cov (array int)) (w int) (wpr int) (i int) (n int) (out (array int))) (array int)
  (if (ge i n)
      out
      (rast_pack_at cov w wpr (add i 1) n
                    (array_set out i (rast_word cov w (div i wpr) (mul 16 (mod i wpr)) 0 0)))))

; The 16 levels from column x0 of row y as a word, k of them done.
(def rast_word ((cov (array int)) (w int) (y int) (x0 int) (k int) (acc int)) int
  (if (eq k 16)
      acc
      (let x (add x0 k)
        (rast_word cov w y x0 (add k 1)
                   (bit_or (bit_shl acc 4) (if (lt x w) (array_get cov (add (mul y w) x)) 0))))))
