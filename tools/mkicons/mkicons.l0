; mkicons.l0 -- makes the toolkit's symbolic icons from GNOME's SVGs
; (icons/*/symbolic/NAME-symbolic.svg): each drawn with smooth edges
; (svg.l0) at every size the toolkit paints one, 16, 32, 48, 64, 96 and
; 128, its coverage in a table icon.NAME.N of a face file (face.l0),
; which the system has as /etc/icons.
;
;   mkicons OUT ICON-symbolic.svg ...
;   mkicons --sheet OUT.ppm ICON-symbolic.svg ...
;
; The second draws every icon at every size, a row each, dark on light,
; into one PPM to look at. A symbolic icon is one color, drawn in the
; color of the text beside it, so only how much of each pixel it covers
; is kept, its colors and its opacities' effect on them let go.

; Says why on standard error: status 1.
(def mkicons_complain((why (list int))) int (complain_as "mkicons" why))

; The sizes an icon is drawn at: 16 · k · s, for its scales k 1 to 4
; and the desktop's s 1 and 2.
(def mkicons_sizes () (list int) (cons 16 (cons 32 (cons 48 (cons 64 (cons 96 (cons 128 (nil int))))))))

; How it is run, said: status 1.
(def mkicons_usage() int
  (mkicons_complain "usage: mkicons OUT ICON-symbolic.svg ... | mkicons --sheet OUT.ppm ICON-symbolic.svg ..."))

; The program: the face file OUT of the icons named, or the sheet.
(def mkicons ((argv (list (list int)))) int
  (if (lt (length argv) 2)
      (mkicons_usage)
      (eq (head argv) "--sheet")
      (if (lt (length argv) 3) (mkicons_usage) (mkicons_sheet (nth argv 1) (tail (tail argv))))
      (match (mkicons_tables (tail argv) (nil UiNamedCov))
        ((Err why) (mkicons_complain why))
        ((Ok ts) (mkicons_wrote (head argv) (ui_face_file ts))))))

; b written to path: status 0, or 1 and why.
(def mkicons_wrote ((path (list int)) (b bytes)) int
  (let e (write_whole path b)
    (if (is_empty e) 0 (mkicons_complain (append path (append ": " e))))))

; An icon's name from its file's: its last part, less -symbolic.svg.
(def mkicons_name ((path (list int))) (Option (list int))
  (let base (rev (mkicons_base (rev path) (nil int)))
    (if (and (ends_with base "-symbolic.svg") (gt (length base) 13))
        (Some (take base (sub (length base) 13)))
        ((None (list int))))))

; A reversed path's last part, up to its last /, reversed again.
(def mkicons_base ((r (list int)) (acc (list int))) (list int)
  (if (or (is_empty r) (eq (head r) 47)) (rev acc) (mkicons_base (tail r) (cons (head r) acc))))

; A file's document, or why not, with its path.
(def mkicons_doc ((path (list int))) (Result XmlEl (list int))
  (match (read_whole path)
    ((Err why) ((Err XmlEl (list int)) (append path (append ": " why))))
    ((Ok b)
      (match (svg_read b)
        ((Err why) ((Err XmlEl (list int)) (append path (append ": " why))))
        ((Ok e) ((Ok XmlEl (list int)) e))))))

; Every icon's tables, in order, onto acc reversed.
(def mkicons_tables ((paths (list (list int))) (acc (list UiNamedCov))) (Result (list UiNamedCov) (list int))
  (if (is_empty paths)
      ((Ok (list UiNamedCov) (list int)) (rev acc))
      (match (mkicons_name (head paths))
        ((None) ((Err (list UiNamedCov) (list int)) (append (head paths) ": not NAME-symbolic.svg")))
        ((Some name)
          (match (mkicons_doc (head paths))
            ((Err why) ((Err (list UiNamedCov) (list int)) why))
            ((Ok root)
              (match (mkicons_icon name root (mkicons_sizes) acc)
                ((Err why) ((Err (list UiNamedCov) (list int)) (append (head paths) (append ": " why))))
                ((Ok acc2) (mkicons_tables (tail paths) acc2)))))))))

; One icon's tables at each size, onto acc.
(def mkicons_icon ((name (list int)) (root XmlEl) (sizes (list int)) (acc (list UiNamedCov))) (Result (list UiNamedCov) (list int))
  (if (is_empty sizes)
      ((Ok (list UiNamedCov) (list int)) acc)
      (let n (head sizes)
        (match (svg_cover root n)
          ((Err why) ((Err (list UiNamedCov) (list int)) why))
          ((Ok cov) (mkicons_icon name root (tail sizes) (cons (UiNamedCov (ui_icon_table name n) (UiCov n n (rast_pack cov n n))) acc)))))))

; ---------------------------------------------------------------- sheet

; The sheet's gap between icons and around them, its ground and ink.
(def mkicons_gap () int 8)
(def mkicons_bg () int (ui_window_bg (UiLight)))
(def mkicons_fg () int (ui_fg (UiLight)))

; The sheet's width: every size and a gap after each, and one before.
(def mkicons_sheet_w () int (add (mkicons_gap) (mkicons_row_w (mkicons_sizes))))

; Each size and a gap after it, added up.
(def mkicons_row_w((ss (list int))) int
  (if (is_empty ss) 0 (add (add (head ss) (mkicons_gap)) (mkicons_row_w (tail ss)))))

; A row's height: the largest icon and a gap.
(def mkicons_row_h() int (add 128 (mkicons_gap)))

; The sheet of the icons at paths, written to out as a PPM.
(def mkicons_sheet((out (list int)) (paths (list (list int)))) int
  (let (w (mkicons_sheet_w)
        h (add (mkicons_gap) (mul (length paths) (mkicons_row_h))))
    (match (mkicons_rows paths 0 w (array_new (mul w h) (mkicons_bg)))
      ((Err why) (mkicons_complain why))
      ((Ok px) (mkicons_wrote out (bytes_from_list (rev (mkicons_rgb px 0 (rev (ppm_header w h))))))))))

; Each icon's row, from row r, into the sheet's pixels.
(def mkicons_rows ((paths (list (list int))) (r int) (w int) (px (array int))) (Result (array int) (list int))
  (if (is_empty paths)
      ((Ok (array int) (list int)) px)
      (match (mkicons_doc (head paths))
        ((Err why) ((Err (array int) (list int)) why))
        ((Ok root)
          (match (mkicons_row root (mkicons_sizes) (mkicons_gap) (add (mkicons_gap) (mul r (mkicons_row_h))) w px)
            ((Err why) ((Err (array int) (list int)) (append (head paths) (append ": " why))))
            ((Ok px2) (mkicons_rows (tail paths) (add r 1) w px2)))))))

; An icon at each size, left to right from x, at row y.
(def mkicons_row ((root XmlEl) (sizes (list int)) (x int) (y int) (w int) (px (array int))) (Result (array int) (list int))
  (if (is_empty sizes)
      ((Ok (array int) (list int)) px)
      (let n (head sizes)
        (match (svg_cover root n)
          ((Err why) ((Err (array int) (list int)) why))
          ((Ok cov) (mkicons_row root (tail sizes) (add (add x n) (mkicons_gap)) y w (mkicons_blit cov n 0 x y w px)))))))

; Coverage n by n, pixel i on, inked into the sheet at x, y.
(def mkicons_blit ((cov (array int)) (n int) (i int) (x int) (y int) (w int) (px (array int))) (array int)
  (if (ge i (mul n n))
      px
      (let (at (add (mul (add y (div i n)) w) (add x (mod i n)))
            c (ui_mix (mkicons_fg) (mkicons_bg) (div (mul (array_get cov i) 100) 15)))
        (mkicons_blit cov n (add i 1) x y w (array_set px at c)))))

; The sheet's pixels from i, red, green and blue, onto the bytes acc.
(def mkicons_rgb((px (array int)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len px)) acc (mkicons_rgb px (add i 1) (ppm_push_rgb (array_get px i) acc))))
