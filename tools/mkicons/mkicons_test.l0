; mkicons_test.l0 -- tests of mkicons: icons' names from their files,
; their tables at every size, and what it refuses.

(def test_name () int
  (add (check_true "from a path" (eq (mkicons_name "icons/adwaita/symbolic/go-next-symbolic.svg") (Some "go-next")))
       (add (check_true "alone" (eq (mkicons_name "pan-up-symbolic.svg") (Some "pan-up")))
            (check_true "not symbolic" (eq (mkicons_name "icons/console/apps/org.gnome.Console.svg") ((None (list int))))))))

; A square filling its document: a table at each size, named for it,
; each row as many words as its 16s.
(def square () XmlEl
  (match (svg_read (bytes_from_list "<svg viewBox=\"0 0 16 16\"><rect width=\"16\" height=\"16\"/></svg>"))
    ((Ok e) e)
    ((Err why) (XmlEl why (nil XmlAttr) (nil XmlEl)))))

(def table_names ((ts (list UiNamedCov))) (list int)
  (if (is_empty ts) "" (match (head ts) ((UiNamedCov n c) (append n (append " " (table_names (tail ts))))))))

(def test_sizes () int
  (match (mkicons_icon "box" (square) (mkicons_sizes) (nil UiNamedCov))
    ((Err why) (fail_because "tables" why))
    ((Ok ts) (check_str "every size" (table_names (rev ts)) "icon.box.16 icon.box.32 icon.box.48 icon.box.64 icon.box.96 icon.box.128 "))))

; At 16, one word a row, every level 15: all ones in hex.
(def test_full_words () int
  (match (mkicons_icon "box" (square) (cons 16 (nil int)) (nil UiNamedCov))
    ((Err why) (fail_because "table" why))
    ((Ok ts)
      (match (head ts)
        ((UiNamedCov n c)
          (match c ((UiCov w h words) (check_str "row 0" (hex_digits (array_get words 0) 16) "ffffffffffffffff"))))))))

; Every vendored icon is drawn without complaint.
(def test_vendored () int
  (match (mkicons_tables (cons "icons/adwaita/symbolic/view-refresh-symbolic.svg" (cons "icons/gnome-system-monitor/symbolic/utilities-system-monitor-symbolic.svg" (nil (list int)))) (nil UiNamedCov))
    ((Err why) (fail_because "tables" why))
    ((Ok ts) (check_int "six each" (length ts) 12))))

(def test_refused () int
  (match (mkicons_tables (cons "icons/console/apps/org.gnome.Console.svg" (nil (list int))) (nil UiNamedCov))
    ((Err why) (check_str "why" why "icons/console/apps/org.gnome.Console.svg: not NAME-symbolic.svg"))
    ((Ok ts) (fail_because "tables" "made some"))))
