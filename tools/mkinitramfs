#!/usr/bin/env bash
# mkinitramfs OUT ETC [IMAGE ...] -- builds the initramfs OUT: a cpio
# archive in the newc format, as Linux's is, of a directory holding
#
#   bin/NAME    each IMAGE, a program built with l0 build --target proc,
#               named after its file without .img, mode 0755
#   etc/...     everything in the directory ETC, mode 0644, which must
#               hold the inittab the kernel boots by, etc/inittab
#
# The directory is staged at OUT.root, and archived by bsdtar, in order
# of path, so the same inputs give the same entries in the same order.
set -eu
out=$1
etc=$2
shift 2
if [ ! -f "$etc/inittab" ]; then
  echo "mkinitramfs: $etc/inittab: no such file; the kernel boots by it" >&2
  exit 1
fi
root="$out.root"
rm -rf "$root"
mkdir -p "$root/bin" "$root/etc"
for image in "$@"; do
  name=$(basename "$image" .img)
  cp "$image" "$root/bin/$name"
  chmod 755 "$root/bin/$name"
done
cp -R "$etc/." "$root/etc/"
find "$root/etc" -type f -exec chmod 644 {} +
# find lists every directory and file; -n stops bsdtar adding a
# directory's files again when it is given the directory.
(cd "$root" && find . | LC_ALL=C sort | bsdtar -n --format newc -cf - -T -) > "$out"
