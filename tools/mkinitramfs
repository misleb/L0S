#!/usr/bin/env bash
# mkinitramfs OUT ETC ROOT [IMAGE ...] -- builds the initramfs OUT: a
# cpio archive in the newc format, as Linux's is, of a directory holding
#
#   ...         everything in the directory ROOT, as make root stages it,
#               its modes kept: bin/NAME, the commands; sbin/NAME, the
#               drivers and services; and Applications/NAME.app/, each
#               app's bundle, its program, manifest and icon
#   bin/NAME    each IMAGE, a program built with l0 build --target proc,
#               named after its file without .img, mode 0755, as
#               tests/e2e.sh adds the raw images of its cases
#   etc/...     everything in the directory ETC, mode 0644, which must
#               hold the inittab the kernel boots by, etc/inittab
#
# The directory is staged at OUT.root, and archived by bsdtar, in order
# of path, so the same inputs give the same entries in the same order.
# INITRAMFS_MAX, which the Makefile sets from the kernel's heap, is the
# most bytes the archive may have, since the kernel keeps all of it in
# its heap; an archive past it is refused, and OUT removed.
set -eu
if [ $# -lt 3 ]; then
  echo "usage: mkinitramfs OUT ETC ROOT [IMAGE ...]" >&2
  exit 1
fi
out=$1
etc=$2
tree=$3
shift 3
if [ ! -f "$etc/inittab" ]; then
  echo "mkinitramfs: $etc/inittab: no such file; the kernel boots by it" >&2
  exit 1
fi
if [ ! -d "$tree" ]; then
  echo "mkinitramfs: $tree: no such directory; make root stages it" >&2
  exit 1
fi
root="$out.root"
rm -rf "$root"
mkdir -p "$root"
cp -Rp "$tree/." "$root/"
mkdir -p "$root/bin" "$root/etc"
for image in "$@"; do
  name=$(basename "$image" .img)
  cp "$image" "$root/bin/$name"
  chmod 755 "$root/bin/$name"
done
cp -R "$etc/." "$root/etc/"
find "$root/etc" -type f -exec chmod 644 {} +
# find lists every directory and file; -n stops bsdtar adding a
# directory's files again when it is given the directory.
(cd "$root" && find . | LC_ALL=C sort | bsdtar -n --format newc -cf - -T -) > "$out"
size=$(wc -c < "$out" | tr -d ' ')
if [ -n "${INITRAMFS_MAX:-}" ] && [ "$size" -gt "$INITRAMFS_MAX" ]; then
  rm -f "$out"
  echo "mkinitramfs: $out: $size bytes, past the $INITRAMFS_MAX the kernel's heap holds; raise KERNEL_HEAP_MB" >&2
  exit 1
fi
