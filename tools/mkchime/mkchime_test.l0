; mkchime_test.l0 -- tests of the chime's synthesis: its series for e,
; its notes' starts and rise, its fade, and the WAV file it writes.

; e to the -1 and to -10, within 1e-12 of their values.
(def test_exp () int
  (add (check_bool "-1" (chime_near (chime_exp -1.0) 0.3678794411714423 0.000000000001) true)
       (check_bool "-10" (chime_near (chime_exp -10.0) 0.00004539992976248485 0.000000000001) true)))

; Whether a is within d of b.
(def chime_near ((a float) (b float) (d float)) bool
  (let x (float_sub a b)
    (float_le (if (float_lt x 0.0) (float_neg x) x) d)))

; The chord is rolled: before B3 starts, at frame 1440, the chord is G3
; alone; from then on it is not.
(def test_rolled () int
  (let g (chime_note_at (head (chime_notes)) 1000)
    (add (check_bool "G3 alone" (eq (chime_value 1000) g) true)
         (check_bool "B3 joins" (eq (chime_value 1500) (chime_note_at (head (chime_notes)) 1500)) false))))

; A note starts silent and is risen fully after 192 frames, 4 ms.
(def test_attack () int
  (add (check_bool "silent" (eq (chime_attack 0) 0.0) true)
       (add (check_bool "half" (eq (chime_attack 96) 0.5) true)
            (check_bool "full" (eq (chime_attack 192) 1.0) true))))

; The fade holds until the last 19200 frames, is half way 9600 from the
; end, and is nothing at it.
(def test_fade () int
  (add (check_bool "held" (eq (chime_fade 100800) 1.0) true)
       (add (check_bool "half" (eq (chime_fade 110400) 0.5) true)
            (check_bool "end" (eq (chime_fade 120000) 0.0) true))))

; The file: 16-bit mono at 48 kHz, 120000 frames, 2.5 s, from byte 44.
(def test_wav () int
  (match (parse_wav (chime_wav))
    ((Wav rate chans s e)
      (add (check_int "rate" rate 48000)
           (add (check_int "channels" chans 1)
                (check_int "bytes" (sub e s) 240000))))
    ((WavBad why) (fail_because "wav" why))))
