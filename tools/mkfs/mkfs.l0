; mkfs.l0 -- writes a disk image with L0S's file system on it
; (user/lib/l0fs.l0): a GPT (user/lib/gpt.l0), then each volume given,
; empty, zeros everywhere else.
;
;   mkfs OUT SECTORS MS LABEL:START:COUNT...
;
; Each volume is a partition of L0FS's type from sector START, COUNT
; sectors, named LABEL, as its volume is; at most 128, inside the disk's
; usable sectors, 34 to SECTORS - 34, and none overlapping. The
; disk and each partition get a UUID of version 7 (user/lib/uuid.l0) of
; MS, the Unix time in milliseconds, which the caller gives, since a host
; program has no other: tools/mkdisk runs it for the demo's disk and the
; tests', with date's. A host program, linking common/abi.l0, uuid.l0,
; crc32.l0, gpt.l0 and l0fs.l0.

(def usage () (list int)
  "usage: mkfs OUT SECTORS MS LABEL:START:COUNT...\n")

(def complain ((why (list int))) int
  (let w (write_err (append "mkfs: " (append why "\n"))) 1))

; ---------------------------------------------------------------- the plan

; A volume to make: its label, first sector and sectors.
(data MkVol (MkVol (list int) int int))

; What the arguments ask for: the disk's sectors and its volumes; or why
; they ask nothing.
(data MkPlan (MkPlan int (list MkVol)) (MkBad (list int)))

; The plan of the arguments after OUT.
(def plan_of ((sectors (list int)) (vols (list (list int)))) MkPlan
  (if (not (is_number sectors))
      (MkBad "the disk's sectors are a number")
      (plan_vols (int_prefix sectors 0) vols (nil MkVol))))

(def plan_vols ((n int) (ws (list (list int))) (acc (list MkVol))) MkPlan
  (if (is_empty ws)
      (plan_checked n (rev acc))
      (match (vol_arg (head ws))
        ((Some v) (plan_vols n (tail ws) (cons v acc)))
        ((None) (MkBad (append "not LABEL:START:COUNT: " (head ws)))))))

; LABEL:START:COUNT, with numbers where they go.
(def vol_arg ((w (list int))) (Option MkVol)
  (let parts (split_colons w (nil int) (nil (list int)))
    (if (not (eq (length parts) 3))
        ((None MkVol))
        (let start (head (tail parts))
          (let count (head (tail (tail parts)))
            (if (if (is_number start) (is_number count) false)
                (Some (MkVol (head parts) (int_prefix start 0) (int_prefix count 0)))
                ((None MkVol))))))))

; The fields of w between colons.
(def split_colons ((w (list int)) (cur (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty w)
      (rev (cons (rev cur) acc))
      (if (eq (head w) 58)
          (split_colons (tail w) (nil int) (cons (rev cur) acc))
          (split_colons (tail w) (cons (head w) cur) acc))))

; Whether w is a decimal number: digits, at least one.
(def is_number ((w (list int))) bool
  (if (is_empty w) false (is_empty (skip_digits w))))

; The plan, if every volume fits: one to the GPT's 128, each with a good
; label used once and room for data, inside the disk's usable sectors,
; none on another.
(def plan_checked ((n int) (vols (list MkVol))) MkPlan
  (if (is_empty vols)
      (MkBad "no volume")
      (if (gt (length vols) (gpt_entry_count))
          (MkBad "at most 128 volumes")
          (let why (vols_why n vols (nil MkVol))
            (if (is_empty why) (MkPlan n vols) (MkBad why))))))

; Why the first of vols cannot be made, given those before, or empty.
(def vols_why ((n int) (vols (list MkVol)) (before (list MkVol))) (list int)
  (if (is_empty vols)
      ""
      (let why (vol_why n (head vols) before)
        (if (is_empty why) (vols_why n (tail vols) (cons (head vols) before)) why))))

(def vol_why ((n int) (v MkVol) (before (list MkVol))) (list int)
  (match v
    ((MkVol label start count)
      (if (not (vol_label_ok label))
          (append "a label is 1 to 15 letters, digits, - and _: " label)
          (if (label_used label before)
              (append "a label used twice: " label)
              (if (if (lt start (gpt_first_usable)) true (gt (add start count) (add (gpt_last_usable n) 1)))
                  (append label (append " is not inside the disk's usable sectors, 34 to " (digits (gpt_last_usable n))))
                  (if (not (vol_layout_ok (vol_layout count)))
                      (append label " is too small for a volume")
                      (if (overlaps start count before)
                          (append label " overlaps another volume")
                          ""))))))))

(def label_used ((label (list int)) (vols (list MkVol))) bool
  (if (is_empty vols)
      false
      (match (head vols) ((MkVol l s c) (if (eq l label) true (label_used label (tail vols)))))))

(def overlaps ((start int) (count int) (vols (list MkVol))) bool
  (if (is_empty vols)
      false
      (match (head vols)
        ((MkVol l s c)
          (if (if (lt start (add s c)) (lt s (add start count)) false) true (overlaps start count (tail vols)))))))

; -------------------------------------------------------------- the image

; Bytes to write at an offset of the image.
(data Piece (Piece int (list int)))

; What an n-sector image holds besides zeros: the GPT, which disk heads,
; and each volume's metadata, by offset.
(def pieces ((n int) (disk Uuid) (ids (list Uuid)) (vols (list MkVol))) (list Piece)
  (sort (append (gpt_bytes (gpt_pieces n (GptDisk disk (parts_of vols ids)))) (metas vols))))

; The GPT's pieces, at their offsets.
(def gpt_bytes ((ps (list GptPiece))) (list Piece)
  (if (is_empty ps)
      (nil Piece)
      (match (head ps) ((GptPiece sector b) (cons (Piece (mul sector (vol_sector_size)) b) (gpt_bytes (tail ps)))))))

; Each volume as a partition, with the UUID of its place in ids, and its
; label for its name.
(def parts_of ((vols (list MkVol)) (ids (list Uuid))) (list GptPart)
  (if (if (is_empty vols) true (is_empty ids))
      (nil GptPart)
      (match (head vols)
        ((MkVol l s c) (cons (GptPart (gpt_l0fs_type) (head ids) s c l) (parts_of (tail vols) (tail ids)))))))

; n UUIDs of version 7 of time ms, their noise from seed, seed + 1 and on.
(def uuids ((ms int) (seed int) (n int)) (list Uuid)
  (if (le n 0) (nil Uuid) (cons (uuid_v7 ms (uuid_noise seed 10)) (uuids ms (add seed 1) (sub n 1)))))

(def metas ((vols (list MkVol))) (list Piece)
  (if (is_empty vols)
      (nil Piece)
      (match (head vols)
        ((MkVol l s c) (cons (Piece (mul s (vol_sector_size)) (vol_meta (vol_new l (vol_layout c)))) (metas (tail vols)))))))

; A cluster of zeros, written as many times as the gaps need.
(def zero_block () bytes (bytes_from_list (vol_zeros 4096)))

; The image of size bytes written to f: each piece at its offset, zeros
; between and after, from at.
(def write_image ((f IoFile) (ps (list Piece)) (at int) (size int) (zs bytes)) int
  (if (is_empty ps)
      (write_zeros f (sub size at) zs)
      (match (head ps)
        ((Piece off b)
          (let z (write_zeros f (sub off at) zs)
            (let w (file_write_bytes f (bytes_from_list b) 0 (length b))
              (write_image f (tail ps) (add off (length b)) size zs)))))))

; n zeros written to f.
(def write_zeros ((f IoFile) (n int) (zs bytes)) int
  (if (le n 0)
      0
      (let k (min n (bytes_len zs))
        (let w (file_write_bytes f zs 0 k)
          (write_zeros f (sub n k) zs)))))

; ----------------------------------------------------------------- running

; The tool: the image argv asks for, written; 0, or 1 and why not.
(def mkfs ((argv (list (list int)))) int
  (if (lt (length argv) 4)
      (complain (drop_last (usage)))
      (let ms (head (tail (tail argv)))
        (if (not (is_number ms))
            (complain "the time is a number of milliseconds")
            (match (plan_of (head (tail argv)) (tail (tail (tail argv))))
              ((MkBad why) (complain why))
              ((MkPlan n vols) (made (head argv) n (int_prefix ms 0) vols)))))))

; The image written to out: its UUIDs' noise seeded from the clock.
(def made ((out (list int)) (n int) (ms int) (vols (list MkVol))) int
  (let ids (uuids ms (clock_ns) (add 1 (length vols)))
    (match (open_out out)
      ((IoFailed fault why) (complain (append out (append ": " why))))
      ((IoOpened f) (written out f (pieces n (head ids) (tail ids) vols) n)))))

; The pieces of an n-sector image written to f, and f closed.
(def written ((out (list int)) (f IoFile) (ps (list Piece)) (n int)) int
  (let w (write_image f ps 0 (mul n (vol_sector_size)) (zero_block))
    (match (file_close f)
      ((Done) 0)
      ((NotDone fault why) (complain (append out (append ": " why)))))))

; s without its last character.
(def drop_last ((s (list int))) (list int)
  (rev (tail (rev s))))
