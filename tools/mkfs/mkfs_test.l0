; mkfs_test.l0 -- tests of the plan mkfs makes and the image it writes.

(def two () (list (list int)) (cons "data:8:1528" (cons "scratch:1536:512" (nil (list int)))))

; Why the plan of sectors and vols is bad, or empty if it is good.
(def why_of ((sectors (list int)) (vols (list (list int)))) (list int)
  (match (plan_of sectors vols) ((MkPlan n vs) "") ((MkBad why) why)))

(def test_plan () int
  (match (plan_of "2048" (two))
    ((MkPlan n vols)
      (add (check_int "sectors" n 2048)
           (check_true "volumes" (eq vols (cons (MkVol "data" 8 1528) (cons (MkVol "scratch" 1536 512) (nil MkVol)))))))
    ((MkBad why) (fail_because "plan" why))))

(def test_plan_refusals () int
  (add (check_str "sectors" (why_of "lots" (two)) "the disk's sectors are a number")
       (add (check_str "form" (why_of "2048" (cons "data:8" (nil (list int)))) "not LABEL:START:COUNT: data:8")
            (check_str "none" (why_of "2048" (nil (list int))) "no volume"))))

(def test_plan_places () int
  (add (check_str "sector 0" (why_of "2048" (cons "a:0:100" (nil (list int)))) "a is not inside the disk, past sector 0")
       (add (check_str "past the end" (why_of "2048" (cons "a:2000:100" (nil (list int)))) "a is not inside the disk, past sector 0")
            (check_str "overlap" (why_of "2048" (cons "a:8:100" (cons "b:100:100" (nil (list int))))) "b overlaps another volume"))))

(def test_plan_labels () int
  (add (check_str "bad" (why_of "2048" (cons "a.b:8:100" (nil (list int)))) "a label is 1 to 15 letters, digits, - and _: a.b")
       (add (check_str "twice" (why_of "2048" (cons "a:8:100" (cons "a:200:100" (nil (list int))))) "a label used twice: a")
            (check_str "small" (why_of "2048" (cons "a:8:15" (nil (list int)))) "a is too small for a volume"))))

; The MBR first, then data's metadata at sector 8, scratch's at 1536.
(def test_pieces () int
  (let ps (pieces (cons (MkVol "scratch" 1536 512) (cons (MkVol "data" 8 1528) (nil MkVol))))
    (check_str "offsets" (offsets ps) "0 4096 786432 ")))

(def offsets ((ps (list Piece))) (list int)
  (if (is_empty ps) "" (match (head ps) ((Piece off b) (append (digits off) (append " " (offsets (tail ps))))))))

; A small image, written to a buffer: its size, and the bytes of each
; piece where they go.
(def test_image () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "buffer" why))
    ((IoOpened f)
      (let w (write_image f (pieces (cons (MkVol "v" 8 16) (nil MkVol))) 0 16384 (zero_block))
        (let b (bytes_from_list (buffer_contents f))
          (let c (file_close f)
            (add (check_int "32 sectors" (bytes_len b) 16384)
                 (add (check_int "the MBR's type" (bytes_get b 450) 76)
                      (check_str "the superblock" (bytes_range b 4096 4100) "L0FS")))))))))

(def test_usage () int
  (check_int "too few" (mkfs (cons "out" (nil (list int)))) 1))
