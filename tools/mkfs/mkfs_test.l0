; mkfs_test.l0 -- tests of the plan mkfs makes and the image it writes.

(def two () (list (list int)) (cons "data:40:1496" (cons "scratch:1536:479" (nil (list int)))))

; Why the plan of sectors and vols is bad, or empty if it is good.
(def why_of ((sectors (list int)) (vols (list (list int)))) (list int)
  (match (plan_of sectors vols) ((MkPlan n vs) "") ((MkBad why) why)))

(def test_plan () int
  (match (plan_of "2048" (two))
    ((MkPlan n vols)
      (add (check_int "sectors" n 2048)
           (check_true "volumes" (eq vols (cons (MkVol "data" 40 1496) (cons (MkVol "scratch" 1536 479) (nil MkVol)))))))
    ((MkBad why) (fail_because "plan" why))))

(def test_plan_refusals () int
  (add (check_str "sectors" (why_of "lots" (two)) "the disk's sectors are a number")
       (add (check_str "form" (why_of "2048" (cons "data:8" (nil (list int)))) "not LABEL:START:COUNT: data:8")
            (check_str "none" (why_of "2048" (nil (list int))) "no volume"))))

; The table's first 34 sectors and its backup's last 33 are no volume's.
(def test_plan_places () int
  (add (check_str "on the table" (why_of "2048" (cons "a:33:100" (nil (list int)))) "a is not inside the disk's usable sectors, 34 to 2014")
       (add (check_str "on the backup" (why_of "2048" (cons "a:1916:100" (nil (list int)))) "a is not inside the disk's usable sectors, 34 to 2014")
            (add (check_str "up to the last usable" (why_of "2048" (cons "a:1915:100" (nil (list int)))) "")
                 (check_str "overlap" (why_of "2048" (cons "a:40:100" (cons "b:100:100" (nil (list int))))) "b overlaps another volume")))))

(def test_plan_labels () int
  (add (check_str "bad" (why_of "2048" (cons "a.b:40:100" (nil (list int)))) "a label is 1 to 15 letters, digits, - and _: a.b")
       (add (check_str "twice" (why_of "2048" (cons "a:40:100" (cons "a:200:100" (nil (list int))))) "a label used twice: a")
            (check_str "small" (why_of "2048" (cons "a:40:15" (nil (list int)))) "a is too small for a volume"))))

(def ids () (list Uuid) (uuids 1760000000000 7 3))

(def demo_pieces () (list Piece)
  (pieces 2048 (head (ids)) (tail (ids)) (cons (MkVol "scratch" 1536 479) (cons (MkVol "data" 40 1496) (nil MkVol)))))

; The protective MBR, the header, its entries; data's metadata at 40,
; scratch's at 1536; the backup's entries at 2015, its header at 2047.
(def test_pieces () int
  (check_str "offsets" (offsets (demo_pieces)) "0 512 1024 20480 786432 1031680 1048064 "))

(def offsets ((ps (list Piece))) (list int)
  (if (is_empty ps) "" (match (head ps) ((Piece off b) (append (digits off) (append " " (offsets (tail ps))))))))

(def test_uuids () int
  (add (check_int "three" (length (ids)) 3)
       (add (check_bool "each its own" (eq (head (ids)) (head (tail (ids)))) false)
            (check_int "of version 7" (uuid_version (head (ids))) 7))))

; A small image, written to a buffer: its size, the table read back from
; where it is, and the volume's superblock where it goes.
(def test_image () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "buffer" why))
    ((IoOpened f)
      (let w (write_image f (pieces 128 (head (ids)) (tail (ids)) (cons (MkVol "v" 40 54) (nil MkVol))) 0 65536 (zero_block))
        (let b (bytes_from_list (buffer_contents f))
          (let c (file_close f)
            (add (check_int "128 sectors" (bytes_len b) 65536)
                 (add (check_str "the table's" (table_text b) "v 40+54")
                      (check_str "the superblock" (bytes_range b 20480 20484) "L0FS")))))))))

; The partitions the image's GPT lists, as text.
(def table_text ((b bytes)) (list int)
  (match (gpt_disk_of (gpt_header_of (bytes_from_list (bytes_range b 512 1024))) (bytes_from_list (bytes_range b 1024 17408)))
    ((GptBad why) why)
    ((GptGot d)
      (match d
        ((GptDisk u ps)
          (if (is_empty ps)
              "none"
              (match (head ps) ((GptPart t id s c name) (append name (append " " (append (digits s) (append "+" (digits c)))))))))))))

(def test_usage () int
  (add (check_int "too few" (mkfs (cons "out" (nil (list int)))) 1)
       (check_int "no time" (mkfs (cons "out" (cons "2048" (cons "now" (cons "a:40:100" (nil (list int))))))) 1)))
