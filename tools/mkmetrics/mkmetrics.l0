; mkmetrics.l0 -- writes the toolkit's metrics, user/lib/ui/metrics.l0,
; from the faces' TrueType fonts at the build: each face's units per em
; and the advance of each of codes 32 to 126, in font units, as defs, so
; that the toolkit measures text with no face and no file, purely, as
; ui_layout must. Each def is a tree of comparisons, a range of codes
; whose advances are all one a single number, so Source Code Pro's is
; 600 alone. The file is checked in; make check fails if it differs from
; what this would write now, and make metrics writes it again.
;
;   mkmetrics FACE=FONT.ttf... OUT
;
; FACE is the font service's name for the face (code, code-bold, sans,
; sans-bold), its defs' names with _ for -: ui_m_FACE_upm and
; ui_m_FACE_adv.

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "mkmetrics" why))

; The metrics of the faces the arguments name, written where the last
; says.
(def mkmetrics ((argv (list (list int)))) int
  (if (lt (length argv) 2)
      (complain "usage: mkmetrics FACE=FONT.ttf... OUT")
      (match (mm_faces (take argv (sub (length argv) 1)) (nil MmFace))
        ((Err why) (complain why))
        ((Ok fs)
          (let e (write_whole (nth argv (sub (length argv) 1)) (bytes_from_list (mm_file fs)))
            (if (is_empty e) 0 (complain e)))))))

; A face's name and its font.
(data MmFace (MmFace (list int) Ttf))

; Each FACE=FONT argument's face, its font read, in order; or why one
; cannot be.
(def mm_faces ((args (list (list int))) (acc (list MmFace))) (Result (list MmFace) (list int))
  (if (is_empty args)
      ((Ok (list MmFace) (list int)) (rev acc))
      (let a (head args)
        (let name (up_to 61 a)
          (let path (drop_n a (add (length name) 1))
            (if (if (is_empty name) true (eq (length name) (length a)))
                ((Err (list MmFace) (list int)) (append "not FACE=FONT.ttf: " a))
                (match (read_whole path)
                  ((Err why) ((Err (list MmFace) (list int)) (append path (append ": " why))))
                  ((Ok b)
                    (match (ttf_read b)
                      ((Err why) ((Err (list MmFace) (list int)) (append path (append ": " why))))
                      ((Ok f) (mm_faces (tail args) (cons (MmFace name f) acc))))))))))))

; ------------------------------------------------------------------ the file

; The file of faces fs: its header, then each face's defs.
(def mm_file ((fs (list MmFace))) (list int)
  (rev (mm_faces_onto fs (push (mm_header) (nil int)))))

; The file's first lines.
(def mm_header () (list int)
  (append "; metrics.l0 -- the faces' metrics, which the toolkit measures and places\n"
  (append "; text by (paint.l0's ui_text_w): each face's units per em and the\n"
  (append "; advance of each of codes 32 to 126, in font units. Written by\n"
  (append "; tools/mkmetrics from the fonts in fonts/; make metrics writes it\n"
          "; again, and make check fails if it differs. Not edited by hand.\n")))))

; Each face's defs onto acc, reversed.
(def mm_faces_onto ((fs (list MmFace)) (acc (list int))) (list int)
  (if (is_empty fs)
      acc
      (match (head fs)
        ((MmFace name f) (mm_faces_onto (tail fs) (mm_face_onto name f acc))))))

; One face's defs onto acc, reversed: its units per em, and its advances.
(def mm_face_onto ((name (list int)) (f Ttf) (acc (list int))) (list int)
  (let id (mm_ident name)
    (let a (push (append "\n; " (append name "'s units per em.\n")) acc)
      (let b (push (append "(def ui_m_" (append id (append "_upm () int " (append (digits (ttf_upm f)) ")\n")))) a)
        (let c (push (append "\n; " (append name "'s advance of code c, 32 to 126, in font units.\n")) b)
          (let d (push (append "(def ui_m_" (append id "_adv ((c int)) int")) c)
            (push ")\n" (mm_tree (mm_advances f 32 (nil int)) 32 126 1 d))))))))

; A face's name as a def's: _ for each -.
(def mm_ident ((name (list int))) (list int)
  (if (is_empty name) name (cons (if (eq (head name) 45) 95 (head name)) (mm_ident (tail name)))))

; The advances of codes from code to 126, in font units, as an array
; indexed by code - 32.
(def mm_advances ((f Ttf) (code int) (acc (list int))) (array int)
  (if (gt code 126)
      (array_from (rev acc) 0)
      (mm_advances f (add code 1) (cons (ttf_advance f (ttf_glyph_index f code)) acc))))

; Whether codes lo to hi all have one advance.
(def mm_same ((adv (array int)) (lo int) (hi int)) bool
  (if (ge lo hi)
      true
      (if (eq (array_get adv (sub lo 32)) (array_get adv (sub hi 32))) (mm_same adv lo (sub hi 1)) false)))

; The advance of codes lo to hi as an expression of c, onto acc,
; reversed, depth deep: a number, if they share one, else a comparison
; at the middle and each half beneath it, on lines of their own.
(def mm_tree ((adv (array int)) (lo int) (hi int) (depth int) (acc (list int))) (list int)
  (if (mm_same adv lo hi)
      (push (append " " (digits (array_get adv (sub lo 32)))) acc)
      (let mid (div (add (add lo hi) 1) 2)
        (let a (push (append "\n" (append (mm_indent depth) (append "(if (lt c " (append (digits mid) ")")))) acc)
          (push ")" (mm_tree adv mid hi (add depth 1) (mm_tree adv lo (sub mid 1) (add depth 1) a)))))))

; Two spaces a level.
(def mm_indent ((depth int)) (list int)
  (if (le depth 0) "" (append "  " (mm_indent (sub depth 1)))))
