; mkmetrics_test.l0 -- tests of mkmetrics: the defs it writes of the fonts
; in fonts/, and what it refuses. Run from the top of the project.

; The faces of fonts/ at the names the toolkit uses.
(def mm_test_faces () (list MmFace)
  (match (mm_faces (cons "code=fonts/SourceCodePro-Regular.ttf" (cons "sans-bold=fonts/SourceSans3-Bold.ttf" (nil (list int)))) (nil MmFace))
    ((Ok fs) fs)
    ((Err why) (nil MmFace))))

; Source Code Pro's advances are all 600, so its def is that number alone.
(def test_mono_one_number () int
  (check_true "600 alone" (contains (mm_file (mm_test_faces)) "(def ui_m_code_adv ((c int)) int 600)")))

; Source Sans 3 Bold's widest is @'s, 902 units.
(def test_widest () int
  (check_true "902" (contains (mm_file (mm_test_faces)) "(def ui_m_sans_bold_widest () int 902)")))

; Source Code Pro kerns nothing: its kern is 0 alone.
(def test_mono_no_kern () int
  (check_true "0" (contains (mm_file (mm_test_faces)) "(def ui_m_code_kern ((l int) (r int)) int 0)")))

; Source Sans 3 Bold kerns T then o by -76 units: To's key, 84 · 128 +
; 111, is one of its tree's leaves.
(def test_sans_kern () int
  (add (check_true "asks the tree" (contains (mm_file (mm_test_faces)) "(def ui_m_sans_bold_kern ((l int) (r int)) int (ui_m_sans_bold_kern_at (add (mul l 128) r)))"))
       (check_true "To" (contains (mm_file (mm_test_faces)) "(if (eq k 10863) -76 0)"))))

; Keys 5 and 9 adjusted by -1 and 2: split at 9, each a leaf.
(def test_ktree () int
  (check_str "tree" (rev (mm_ktree (array_from (cons 5 (cons 9 (nil int))) 0) (array_from (cons -1 (cons 2 (nil int))) 0) 0 1 0 (nil int)))
             "\n(if (lt k 9) (if (eq k 5) -1 0) (if (eq k 9) 2 0))"))

(def test_upm () int
  (check_true "1000" (contains (mm_file (mm_test_faces)) "(def ui_m_code_upm () int 1000)")))

; A face's name with - is a def's with _.
(def test_ident () int
  (check_str "sans_bold" (mm_ident "sans-bold") "sans_bold"))

; Source Sans 3's advances differ, so its def compares.
(def test_sans_tree () int
  (check_true "a tree" (contains (mm_file (mm_test_faces)) "(def ui_m_sans_bold_adv ((c int)) int\n  (if (lt c 79)")))

; Codes 32 to 34 with advances 5, 5 and 7: split at 33, the middle
; rounded up, 32 alone is 5, and 33 to 34 split again at 34.
(def test_tree_small () int
  (check_str "tree" (rev (mm_tree (array_from (cons 5 (cons 5 (cons 7 (nil int)))) 0) 32 34 0 (nil int)))
             "\n(if (lt c 33) 5\n  (if (lt c 34) 5 7))"))

(def test_bad_arg () int
  (match (mm_faces (cons "fonts/SourceCodePro-Regular.ttf" (nil (list int))) (nil MmFace))
    ((Ok fs) (fail_because "faces" "an argument with no face"))
    ((Err why) (check_str "why" why "not FACE=FONT.ttf: fonts/SourceCodePro-Regular.ttf"))))

(def test_no_font () int
  (match (mm_faces (cons "code=fonts/none.ttf" (nil (list int))) (nil MmFace))
    ((Ok fs) (fail_because "faces" "a face of no font"))
    ((Err why) (check_true "why" (starts_with why "fonts/none.ttf: ")))))
