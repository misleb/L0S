#!/usr/bin/perl
# slowtype FILE [PAUSE] -- writes FILE's bytes to standard output as a
# person types them: pausing PAUSE seconds, a quarter by default, after
# each newline and each Ctrl-C, so that what one line starts is running
# before the next key comes. A test that types Ctrl-C at a job needs
# that: given all its keys at once, the console would see the Ctrl-C
# while the line that starts the job was still unread, and drop both.
use strict;
my ($file, $pause) = @ARGV;
$pause = 0.25 unless defined $pause;
open(my $in, '<:raw', $file) or die "slowtype: $file: $!\n";
binmode STDOUT;
$| = 1;
local $/ = \1;
while (defined(my $b = <$in>)) {
    print $b;
    select(undef, undef, undef, $pause) if $b eq "\n" || $b eq "\x03";
}
