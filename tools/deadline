#!/usr/bin/perl
# deadline SECONDS COMMAND [ARG ...] -- runs COMMAND, and kills it if it is
# still running after SECONDS, exiting 124 as GNU timeout does. macOS has
# no timeout(1). COMMAND keeps this process's standard input and output.
use strict;
my $secs = shift @ARGV;
my $pid = fork();
die "deadline: fork: $!\n" unless defined $pid;
if ($pid == 0) { exec @ARGV or die "deadline: $ARGV[0]: $!\n"; }
my $waited = 0;
while ($waited < $secs * 10) {
    my $done = waitpid($pid, 1);    # WNOHANG
    if ($done == $pid) { exit($? & 127 ? 128 + ($? & 127) : $? >> 8); }
    select(undef, undef, undef, 0.1);
    $waited++;
}
kill 'KILL', $pid;
waitpid($pid, 0);
print STDERR "deadline: killed after $secs s: @ARGV\n";
exit 124;
