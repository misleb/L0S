#!/usr/bin/env bash
# mkrelease OUT ROOT ETC AGENT [BOOT] -- stages a release of L0S for one
# board in the directory OUT, which the API proxy serves (roadmap 0027,
# tools/api-proxy/release.py), made anew:
#
#   system/          everything in ROOT, as make root stages it, its
#                    modes kept, then everything in APPS, if set, as
#                    make release-apps stages the apps the initramfs
#                    leaves out, and ETC as system/etc, mode 0644
#   boot/            every file directly in BOOT, if given: the Pi 5's
#                    boot partition, as make pi5-card writes it
#   agent/           CLAUDE.md and CONSTITUTION.md from AGENT, the
#                    agent's home as the installer seeds it
#   speech/          WHISTLE_MODEL, if set, as whistle.cact
#   eeprom/          PIEEPROM, if set, as pieeprom.bin
#
# The proxy makes the manifest from these files as it serves them.
set -eu
if [ $# -lt 4 ] || [ $# -gt 5 ]; then
  echo "usage: mkrelease OUT ROOT ETC AGENT [BOOT]" >&2
  exit 1
fi
out=$1 tree=$2 etc=$3 agent=$4 boot=${5:-}
for d in "$tree" "$etc" "$agent" ${boot:+"$boot"}; do
  [ -d "$d" ] || { echo "mkrelease: $d: no such directory" >&2; exit 1; }
done
rm -rf "$out"
mkdir -p "$out/system" "$out/agent"
cp -Rp "$tree/." "$out/system/"
if [ -n "${APPS:-}" ]; then
  [ -d "$APPS" ] || { echo "mkrelease: APPS=$APPS: no such directory" >&2; exit 1; }
  cp -Rp "$APPS/." "$out/system/"
fi
rm -rf "$out/system/boot"
mkdir -p "$out/system/etc"
cp -R "$etc/." "$out/system/etc/"
find "$out/system/etc" -type f -exec chmod 644 {} +
for f in CLAUDE.md CONSTITUTION.md; do
  install -m 644 "$agent/$f" "$out/agent/$f"
done
if [ -n "$boot" ]; then
  mkdir -p "$out/boot"
  find "$boot" -maxdepth 1 -type f -exec install -m 644 {} "$out/boot/" \;
fi
if [ -n "${WHISTLE_MODEL:-}" ]; then
  [ -f "$WHISTLE_MODEL" ] || { echo "mkrelease: WHISTLE_MODEL=$WHISTLE_MODEL: no such file" >&2; exit 1; }
  mkdir -p "$out/speech" && install -m 644 "$WHISTLE_MODEL" "$out/speech/whistle.cact"
fi
if [ -n "${PIEEPROM:-}" ]; then
  [ -f "$PIEEPROM" ] || { echo "mkrelease: PIEEPROM=$PIEEPROM: no such file" >&2; exit 1; }
  mkdir -p "$out/eeprom" && install -m 644 "$PIEEPROM" "$out/eeprom/pieeprom.bin"
fi
echo "mkrelease: $out: $(find "$out" -type f | wc -l | tr -d ' ') files"
