#!/usr/bin/env bash
# qemu-gl -- says which virtio-gpu this machine's QEMU can give the board:
# gl, if it has virtio-gpu-gl-device and the host has a render node to
# draw with, so the board's driver can compose on the host's GPU through
# virgl; else 2d, the plain device. GPU=2d or GPU=gl in the environment
# is taken as said. QEMU is L0_QEMU, qemu-system-aarch64 if not set.
set -u
if [ -n "${GPU:-}" ]; then echo "$GPU"; exit 0; fi
qemu=${L0_QEMU:-qemu-system-aarch64}
if [ "$(uname -s)" = Linux ] \
   && ls /dev/dri/renderD* > /dev/null 2>&1 \
   && "$qemu" -device help 2>&1 | grep -q 'virtio-gpu-gl-device'; then
  echo gl
else
  echo 2d
fi
