; mkicon_test.l0 -- drawing icons from their sources, and their PPMs.

(def drawn ((text (list int))) Canvas
  (match (mkicon_draw_text text)
    ((Ok f) f)
    ((Err why) (canvas_new 1 1 0))))

(def why_not ((text (list int))) (list int)
  (match (mkicon_draw_text text)
    ((Ok f) "drawn")
    ((Err why) why)))

(def pixel ((f Canvas) (x int) (y int)) (list int)
  (hex_digits (canvas_pixel f x y) 6))

(def test_mkicon_ground () int
  (add (check_int "48 by 48" (mul (canvas_w (mkicon_new 1)) (canvas_h (mkicon_new 1))) 2304)
       (check_str "the launcher's ground, with nothing drawn" (pixel (drawn "# nothing\n\n") 47 47) "242424")))

; A fill of red_3, e01b24, then a round of radius 10 in blue_4, 1c71d8,
; over all of it: its corner pixel 0, 0 is the ground, and its middle
; blue. Row 0's pixel 6 is partly covered by the corner, and is blue at
; (ui_corner_pct 10 0 6) percent over the ground, 242424.
(def test_mkicon_round () int
  (let px (drawn "round 0 0 48 48 10 blue_4\n")
    (add (check_str "a cut corner" (pixel px 0 0) "242424")
         (add (check_str "the middle" (pixel px 24 24) "1c71d8")
              (check_str "an edge pixel, mixed" (pixel px 6 0) (hex_digits (ui_mix (ui_hex "1c71d8") (ui_hex "242424") (ui_corner_pct 10 0 6)) 6))))))

; A face whose view-app-grid at 32 covers its top left 8 by 8 wholly,
; each of those rows' first word eight 15s.
(def grid_face () UiFace
  (UiFace 1 (array_new 0 0) (map_put ((MapEmpty (list int) UiCov)) (ui_icon_table "view-app-grid" 32)
                                     (UiCov 32 32 (grid_words 0 (array_new 64 0))))))

(def grid_words ((y int) (out (array int))) (array int)
  (if (ge y 8) out (grid_words (add y 1) (array_set out (mul y 2) (bit_shl 4294967295 32)))))

; The icon at its scale 2 from 8, 8: lit from 8 to 15 each way.
(def test_mkicon_icon () int
  (let px (match (mkicon_draw_at "icon 8 8 view-app-grid 2 white\n" (grid_face)) ((Ok f) f) ((Err why) (canvas_new 1 1 0)))
    (add (check_str "lit" (pixel px 15 9) "ffffff")
         (add (check_str "past the square" (pixel px 16 8) "242424")
              (check_str "above it" (pixel px 8 7) "242424")))))

(def test_mkicon_basic () int
  (let px (drawn "fill 0 0 4 4 red\nline 0 10 47 10 green\ndisc 30 30 3 blue\n")
    (add (check_str "a fill" (pixel px 3 3) "ff0000")
         (add (check_str "a line" (pixel px 47 10) "00ff00")
              (check_str "a disc" (pixel px 33 30) "0000ff")))))

(def test_mkicon_refused () int
  (add (check_str "a glyph needs a font" (why_not "# a\nfill 0 0 1 1 red\nchar 0 0 65 white\n") "line 3: char cannot be drawn in an icon")
       (add (check_str "a button too" (why_not "button 0 0 flat Go") "line 1: button cannot be drawn in an icon")
            (check_str "a bad command" (why_not "blah") "line 1: no command blah"))))

(def test_mkicon_ppm () int
  (let ppm (mkicon_ppm (drawn "fill 0 0 1 1 1c71d8\n"))
    (add (check_int "header and 3 bytes a pixel" (length ppm) (add 13 (mul 3 2304)))
         (check_strs "the header, then the first pixel's red, green, blue"
           (cons (take_n ppm 13) (cons (digits_of (take_n (drop_n ppm 13) 3)) (nil (list int))))
           (cons "P6\n48 48 255\n" (cons "28 113 216" (nil (list int))))))))

(def take_n ((s (list int)) (n int)) (list int)
  (if (if (le n 0) true (is_empty s)) (nil int) (cons (head s) (take_n (tail s) (sub n 1)))))

(def digits_of ((s (list int))) (list int)
  (if (is_empty s) "" (if (is_empty (tail s)) (digits (head s)) (append (digits (head s)) (cons 32 (digits_of (tail s)))))))

; Under an operating system there is no source.
(def test_mkicon_usage () int
  (add (check_int "no source" (mkicon (nil (list int))) 1)
       (check_int "a source not there" (mkicon (cons "/no/such/icon.draw" (nil (list int)))) 1)))

; ---------------------------------------------------------------- scale 2

; At scale 2, with no face's tables, the icon is 96 by 96, every command
; twice the size: a fill of 4 by 4 covers 8 by 8, and a line is 2 thick.
(def drawn_2x ((src (list int))) Canvas
  (match (mkicon_draw_at src (UiFace 2 (array_new 0 0) ((MapEmpty (list int) UiCov))))
    ((Ok f) f)
    ((Err why) (canvas_new 1 1 0))))

(def test_mkicon_2x_size () int
  (let px (drawn_2x "# nothing\n")
    (check_int "96 by 96" (mul (canvas_w px) (canvas_h px)) 9216)))

(def test_mkicon_2x_commands () int
  (let px (drawn_2x "fill 0 0 4 4 red\nline 0 10 47 10 green\n")
    (add (check_str "a fill" (pixel px 7 7) "ff0000")
         (add (check_str "past it" (pixel px 8 8) "242424")
              (check_str "the line, 2 thick" (pixel px 95 21) "00ff00")))))

; An icons file that cannot be read is refused, by its path.
(def test_mkicon_face_arg () int
  (match (mkicon_face (cons "no/such/icons" (nil (list int))))
    ((Ok f) (fail_because "face" "read"))
    ((Err why) (check_true "names it" (starts_with why "no/such/icons: ")))))
