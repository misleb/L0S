; mkicon.l0 -- draws an app's icon: reads a source of the desktop's
; drawing commands, a line each, as run draw takes them, and writes the
; icon they draw, 48 by 48, as a binary PPM, on the launcher's ground.
;
;   mkicon user/apps/vt/Terminal.app/icon.draw > icon.ppm
;
; A # line is a comment. It draws on a canvas over an array (render.l0's
; canvas_new) with the drawing wm does on the desktop, render.l0's and
; the toolkit's, but has no font and no screen: so only line, circle,
; disc, rect, fill and clear, and the toolkit's round and icon. No layer
; blends, so a round's corners are mixed with what is under them, the
; ground first: the icon is right only on the launcher's ui_launcher_bg.

; The icon's side, and its canvas at the start: the launcher's ground.
(def mkicon_size () int (ui_app_icon))

(def mkicon_new () Canvas (canvas_new (mkicon_size) (mkicon_size) (ui_launcher_bg)))

; ---------------------------------------------------------------- reading

; The icon a source's text draws, or why not, with the line.
(def mkicon_draw_text ((text (list int))) (Result Canvas (list int))
  (mkicon_lines text 1 (mkicon_new)))

(def mkicon_lines ((text (list int)) (n int) (f Canvas)) (Result Canvas (list int))
  (if (is_empty text)
      (mkicon_ok f)
      (match (mkicon_line (split_spaces (take_line text)) f)
        ((Ok next) (mkicon_lines (drop_line text) (add n 1) next))
        ((Err why) ((Err Canvas (list int)) (append "line " (append (digits n) (append ": " why))))))))

; One line drawn: nothing for a blank line or a comment.
(def mkicon_line ((words (list (list int))) (f Canvas)) (Result Canvas (list int))
  (if (is_empty words)
      (mkicon_ok f)
      (if (starts_with (head words) "#")
          (mkicon_ok f)
          (match (ui_parse_draw words)
            ((Err why) ((Err Canvas (list int)) why))
            ((Ok d) (mkicon_draw f d))))))

; A toolkit command drawn as wm draws it on the desktop, with no font.
(def mkicon_draw ((f Canvas) (d UiDraw)) (Result Canvas (list int))
  (match d
    ((UiDrawBasic cmd) (mkicon_basic f cmd))
    ((UiDrawRound x y w h r c) (mkicon_ok (ui_draw_exec f (array_new 0 0) d)))
    ((UiDrawButton x y k label) (mkicon_cannot "button"))
    ((UiDrawIcon x y name sc c) (mkicon_ok (ui_draw_exec f (array_new 0 0) d)))))

; A command refused, as one an icon cannot hold; and the canvas drawn.
(def mkicon_cannot ((op (list int))) (Result Canvas (list int))
  ((Err Canvas (list int)) (append op " cannot be drawn in an icon")))

(def mkicon_ok ((f Canvas)) (Result Canvas (list int)) ((Ok Canvas (list int)) f))

; ---------------------------------------------------------------- drawing

; render.l0's commands, drawn as wm draws them on the desktop; those that
; need a font or the screen are refused.
(def mkicon_basic ((f Canvas) (cmd Command)) (Result Canvas (list int))
  (match cmd
    ((CmdLine x0 y0 x1 y1 c) (mkicon_ok (plot_all f (line_points x0 y0 x1 y1) c)))
    ((CmdCircle cx cy r c) (mkicon_ok (plot_all f (circle_points cx cy r) c)))
    ((CmdDisc cx cy r c) (mkicon_ok (disc f cx cy r c (neg r))))
    ((CmdRect x y w h c) (mkicon_ok (outline f x y w h c)))
    ((CmdFill x y w h c) (mkicon_ok (fill_rect f x y w h c)))
    ((CmdClear c) (mkicon_ok (fill_rect f 0 0 (mkicon_size) (mkicon_size) c)))
    ((CmdChar x y code c) (mkicon_cannot "char"))
    ((CmdText x y c bg s) (mkicon_cannot "text"))
    ((CmdScroll n c) (mkicon_cannot "scroll"))
    ((CmdRestore x y w h) (mkicon_cannot "restore"))
    ((CmdSplash p) (mkicon_cannot "splash"))
    ((CmdSize) (mkicon_cannot "size"))
    ((CmdFont) (mkicon_cannot "font"))))

; ---------------------------------------------------------------- writing

; The icon as a binary PPM: its header, then each pixel's red, green and
; blue, row by row.
(def mkicon_ppm ((f Canvas)) (list int)
  (rev (mkicon_rgb f 0 (rev (ppm_header (canvas_w f) (canvas_h f))))))

(def mkicon_rgb ((f Canvas) (i int) (acc (list int))) (list int)
  (let w (canvas_w f)
    (if (ge i (mul w (canvas_h f)))
        acc
        (mkicon_rgb f (add i 1) (ppm_push_rgb (canvas_pixel f (mod i w) (div i w)) acc)))))

; Says why on standard error: status 1.
(def mkicon_complain ((why (list int))) int (complain_as "mkicon" why))

; The program: the icon of the source argv names, on standard output.
(def mkicon ((argv (list (list int)))) int
  (if (not (eq (length argv) 1))
      (mkicon_complain "usage: mkicon SOURCE > icon.ppm")
      (match (read_whole (head argv))
        ((Err why) (mkicon_complain (append (head argv) (append ": " why))))
        ((Ok b) (mkicon_written (head argv) (mkicon_draw_text (bytes_to_list b)))))))

; The icon drawn from src written, or why it could not be drawn.
(def mkicon_written ((src (list int)) (r (Result Canvas (list int)))) int
  (match r
    ((Err why) (mkicon_complain (append src (append " " why))))
    ((Ok f)
      (let out (bytes_from_list (mkicon_ppm f))
        (let w (file_write_bytes (IoFile 1) out 0 (bytes_len out))
          (match (file_flush (IoFile 1))
            ((NotDone fault why) (mkicon_complain why))
            ((Done) 0)))))))
