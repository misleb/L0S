; mkicon.l0 -- draws an app's icon, 48 by 48, as a binary PPM, on the
; launcher's ground: from its icon.svg, its GNOME icon, with the SVG
; library (svg.l0); or from an icon.draw, a source of the desktop's
; drawing commands, a line each, as run draw takes them. With --image,
; an icon.svg's images with their alpha, for Files' icon.face:
;
;   mkicon --image user/apps/vt/Terminal.app/icon.svg icon.face
;
;   mkicon user/apps/widgets/Widgets.app/icon.draw build/icons.face > icon.ppm
;   mkicon user/apps/widgets/Widgets.app/icon.draw build/icons.face build/face > icon2x.ppm
;
; Its symbolic icons come from the icons file mkicons wrote (face.l0's
; /etc/icons). The second draws it at scale 2, 96 by 96, as the launcher
; shows it on a large screen: the same commands, each twice the size,
; its icons at their size, smooth, not doubled.
;
; A # line is a comment. It draws on a canvas over an array (render.l0's
; canvas_new) with the drawing wm does on the desktop, render.l0's and
; the toolkit's, but has no font and no screen: so only line, circle,
; disc, rect, fill and clear, and the toolkit's round and icon. No layer
; blends, so a round's corners are mixed with what is under them, the
; ground first: the icon is right only on the launcher's ui_launcher_bg.

; The icon's side, in the desktop's pixels, and its canvas at the start,
; at the face's scale: the launcher's ground.
(def mkicon_size () int (ui_app_icon))

(def mkicon_new ((s int)) Canvas (canvas_new (mul s (mkicon_size)) (mul s (mkicon_size)) (ui_launcher_bg)))

; ---------------------------------------------------------------- reading

; The icon a source's text draws, or why not, with the line: at scale 1,
; or at the face's.
(def mkicon_draw_text ((text (list int))) (Result Canvas (list int))
  (mkicon_draw_at text (ui_face_none)))

(def mkicon_draw_at ((text (list int)) (face UiFace)) (Result Canvas (list int))
  (mkicon_lines text 1 face (mkicon_new (ui_face_scale face))))

(def mkicon_lines ((text (list int)) (n int) (face UiFace) (f Canvas)) (Result Canvas (list int))
  (if (is_empty text)
      (mkicon_ok f)
      (match (mkicon_line (split_spaces (take_line text)) face f)
        ((Ok next) (mkicon_lines (drop_line text) (add n 1) face next))
        ((Err why) ((Err Canvas (list int)) (append "line " (append (digits n) (append ": " why))))))))

; One line drawn: nothing for a blank line or a comment.
(def mkicon_line ((words (list (list int))) (face UiFace) (f Canvas)) (Result Canvas (list int))
  (if (is_empty words)
      (mkicon_ok f)
      (if (starts_with (head words) "#")
          (mkicon_ok f)
          (match (ui_parse_draw words)
            ((Err why) ((Err Canvas (list int)) why))
            ((Ok d) (mkicon_draw face f d))))))

; A toolkit command drawn as wm draws it on the desktop, with no font.
(def mkicon_draw ((face UiFace) (f Canvas) (d UiDraw)) (Result Canvas (list int))
  (match d
    ((UiDrawBasic cmd) (mkicon_basic f cmd (ui_face_scale face)))
    ((UiDrawRound x y w h r c) (mkicon_ok (ui_draw_exec f face d)))
    ((UiDrawButton x y k label) (mkicon_cannot "button"))
    ((UiDrawIcon x y name sc c) (mkicon_ok (ui_draw_exec f face d)))))

; A command refused, as one an icon cannot hold; and the canvas drawn.
(def mkicon_cannot ((op (list int))) (Result Canvas (list int))
  ((Err Canvas (list int)) (append op " cannot be drawn in an icon")))

(def mkicon_ok ((f Canvas)) (Result Canvas (list int)) ((Ok Canvas (list int)) f))

; ---------------------------------------------------------------- drawing

; render.l0's commands, drawn as wm draws them on the desktop, at scale
; s; those that need a font or the screen are refused.
(def mkicon_basic ((f Canvas) (cmd Command) (s int)) (Result Canvas (list int))
  (match cmd
    ((CmdLine x0 y0 x1 y1 c) (mkicon_ok (ui_draw_line f x0 y0 x1 y1 c s)))
    ((CmdCircle cx cy r c) (mkicon_ok (ui_draw_circle f cx cy r c s)))
    ((CmdDisc cx cy r c) (mkicon_ok (ui_draw_disc f cx cy r c s)))
    ((CmdRect x y w h c) (mkicon_ok (ui_draw_outline f x y w h c s)))
    ((CmdFill x y w h c) (mkicon_ok (ui_draw_fill f (Rect x y w h) c s)))
    ((CmdClear c) (mkicon_ok (ui_draw_fill f (Rect 0 0 (mkicon_size) (mkicon_size)) c s)))
    ((CmdChar x y code c) (mkicon_cannot "char"))
    ((CmdText x y c bg t) (mkicon_cannot "text"))
    ((CmdScroll n c) (mkicon_cannot "scroll"))
    ((CmdRestore x y w h) (mkicon_cannot "restore"))
    ((CmdSplash p) (mkicon_cannot "splash"))
    ((CmdSize) (mkicon_cannot "size"))
    ((CmdFont) (mkicon_cannot "font"))))

; ---------------------------------------------------------------- writing

; The icon as a binary PPM: its header, then each pixel's red, green and
; blue, row by row.
(def mkicon_ppm ((f Canvas)) (list int)
  (rev (mkicon_rgb f 0 (rev (ppm_header (canvas_w f) (canvas_h f))))))

(def mkicon_rgb ((f Canvas) (i int) (acc (list int))) (list int)
  (let w (canvas_w f)
    (if (ge i (mul w (canvas_h f)))
        acc
        (mkicon_rgb f (add i 1) (ppm_push_rgb (canvas_pixel f (mod i w) (div i w)) acc)))))

; Says why on standard error: status 1.
(def mkicon_complain ((why (list int))) int (complain_as "mkicon" why))

; The program: the icon of the source argv names, its symbolic icons
; from the icons file after it, on standard output; at scale 2 if a
; face file is named after that.
(def mkicon ((argv (list (list int)))) int
  (if (if (eq (length argv) 3) (eq (head argv) "--image") false)
      (mkicon_image (nth argv 1) (nth argv 2))
      (if (if (lt (length argv) 2) true (gt (length argv) 3))
          (mkicon_complain "usage: mkicon SOURCE ICONS [FACE] > icon.ppm | mkicon --image ICON.svg OUT")
          (match (mkicon_face (tail argv))
            ((Err why) (mkicon_complain why))
            ((Ok face)
              (match (read_whole (head argv))
                ((Err why) (mkicon_complain (append (head argv) (append ": " why))))
                ((Ok b)
                  (mkicon_written (head argv)
                    (if (ends_with (head argv) ".svg")
                        (mkicon_svg b (ui_face_scale face))
                        (mkicon_draw_at (bytes_to_list b) face))))))))))

; ------------------------------------------------------------------ SVG

; An icon.svg drawn at scale s on the launcher's ground, or why not.
(def mkicon_svg ((b bytes) (s int)) (Result Canvas (list int))
  (let n (mul s (mkicon_size))
    (match (svg_read b)
      ((Err why) ((Err Canvas (list int)) why))
      ((Ok root)
        (match (svg_argb root n)
          ((Err why) ((Err Canvas (list int)) why))
          ((Ok words) (mkicon_ok (mkicon_over (mkicon_new s) words n 0))))))))

; ARGB words n by n, pixel i on, over the canvas: each mixed with what
; is there by its alpha.
(def mkicon_over ((f Canvas) (words (array int)) (n int) (i int)) Canvas
  (if (ge i (mul n n))
      f
      (let w (array_get words i)
        (let a (bit_and (bit_shr w 24) 255)
          (let x (mod i n)
            (let y (div i n)
              (mkicon_over (if (eq a 0) f (put f x y (ui_mix (bit_and w 16777215) (canvas_pixel f x y) (div (add (mul a 100) 127) 255))))
                           words n (add i 1))))))))

; The sizes an app's image is drawn at for Files: a list's 16 and a
; tile's 48, at scales 1 and 2.
(def mkicon_image_sizes () (list int) (cons 16 (cons 32 (cons 48 (cons 96 (nil int))))))

; An icon.svg's images, ARGB at each size, written to out as a face
; file (face.l0's image.N tables), which Files paints on any ground.
(def mkicon_image ((src (list int)) (out (list int))) int
  (match (read_whole src)
    ((Err why) (mkicon_complain (append src (append ": " why))))
    ((Ok b)
      (match (svg_read b)
        ((Err why) (mkicon_complain (append src (append ": " why))))
        ((Ok root)
          (match (mkicon_images root (mkicon_image_sizes) (nil UiNamedCov))
            ((Err why) (mkicon_complain (append src (append ": " why))))
            ((Ok ts)
              (let e (write_whole out (ui_face_file ts))
                (if (is_empty e) 0 (mkicon_complain (append out (append ": " e))))))))))))

; The document at each of sizes, onto acc, in order.
(def mkicon_images ((root XmlEl) (sizes (list int)) (acc (list UiNamedCov))) (Result (list UiNamedCov) (list int))
  (if (is_empty sizes)
      ((Ok (list UiNamedCov) (list int)) (rev acc))
      (let n (head sizes)
        (match (svg_argb root n)
          ((Err why) ((Err (list UiNamedCov) (list int)) why))
          ((Ok words) (mkicon_images root (tail sizes) (cons (UiNamedCov (ui_image_table n) (UiCov n n words)) acc)))))))

; The face to draw with, no font in it: the icons file's icons at scale
; 1; with a face file after it, at scale 2, with its tables too.
(def mkicon_face ((rest (list (list int)))) (Result UiFace (list int))
  (let s (if (is_empty (tail rest)) 1 2)
    (match (mkicon_tables (head rest) (ui_icon_sizes s) ((MapEmpty (list int) UiCov)))
      ((Err why) ((Err UiFace (list int)) why))
      ((Ok icons)
        (if (eq s 1)
            ((Ok UiFace (list int)) (UiFace 1 icons))
            (match (mkicon_tables (head (tail rest)) (nil int) icons)
              ((Err why) ((Err UiFace (list int)) why))
              ((Ok ts) ((Ok UiFace (list int)) (UiFace 2 ts)))))))))

; The tables of the face file at path put into m, icons' at the sizes
; given; or why not.
(def mkicon_tables ((path (list int)) (sizes (list int)) (m (Map (list int) UiCov))) (Result (Map (list int) UiCov) (list int))
  (match (read_whole path)
    ((Err why) ((Err (Map (list int) UiCov) (list int)) (append path (append ": " why))))
    ((Ok b) ((Ok (Map (list int) UiCov) (list int)) (ui_face_kept b sizes m)))))

; The icon drawn from src written, or why it could not be drawn.
(def mkicon_written ((src (list int)) (r (Result Canvas (list int)))) int
  (match r
    ((Err why) (mkicon_complain (append src (append " " why))))
    ((Ok f)
      (let out (bytes_from_list (mkicon_ppm f))
        (let w (file_write_bytes (IoFile 1) out 0 (bytes_len out))
          (match (file_flush (IoFile 1))
            ((NotDone fault why) (mkicon_complain why))
            ((Done) 0)))))))
