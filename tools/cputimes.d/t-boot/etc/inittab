# tools/cputimes: install --boot (typed), three times, each writing the
# initramfs as one file of 14 MB onto BOOT, a FAT32 volume, timed on one
# CPU and on several. As the e2e case install_boot, with only its first
# command.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
