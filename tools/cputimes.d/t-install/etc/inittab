# tools/cputimes: install onto an empty volume (typed), the copy of every
# file of the initramfs onto System, timed on one CPU and on several. As
# the e2e case install, without its other commands.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
