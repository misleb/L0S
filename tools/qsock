#!/usr/bin/env python3
# qsock SOCKET -- sends standard input to the Unix socket SOCKET, one of
# QEMU's monitor or QMP, then says it has no more and writes what QEMU
# answers to standard output until QEMU closes the connection. QEMU
# carries out each command before it reads the end of what was sent, so
# when this returns every command is done: a screendump is written whole.
# The screen tests send each monitor command and input event with it.
# nc -U -w 1 did the same but waited out its second on every call, as
# QEMU keeps the connection open, and nc -N, which does not, is not on
# every machine. Exits 1 if it cannot connect, or QEMU is too slow to
# answer, after 10 s.
import socket
import sys

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10)
try:
    s.connect(sys.argv[1])
    s.sendall(sys.stdin.buffer.read())
    s.shutdown(socket.SHUT_WR)
    while True:
        b = s.recv(65536)
        if not b:
            break
        sys.stdout.buffer.write(b)
except OSError as e:
    print(f"qsock: {sys.argv[1]}: {e}", file=sys.stderr)
    sys.exit(1)
