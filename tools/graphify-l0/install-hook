#!/bin/sh
# install-hook -- add the graph's rebuild to .git/hooks/post-commit.
#
# Its block, between the two markers, starts graph-rebuild in the
# background after each commit, so a commit returns at once; it skips a
# rebase or merge in progress, and GRAPH_SKIP_HOOK=1 skips it. Run again
# to replace the block; anything else in the hook is kept. --remove takes
# it out.
set -e
hooks=$(git rev-parse --git-path hooks)
hook=$hooks/post-commit
begin='# graphify-l0 begin'
end='# graphify-l0 end'
mkdir -p "$hooks"
[ -f "$hook" ] || printf '#!/bin/sh\n' > "$hook"
tmp=$hook.tmp
awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$hook" > "$tmp"
if [ "$1" != "--remove" ]; then
    cat >> "$tmp" << EOF
$begin
# The knowledge graph, rebuilt after each commit (make graph-hook).
(
    [ "\${GRAPH_SKIP_HOOK:-0}" = 1 ] && exit 0
    d=\$(git rev-parse --git-dir)
    [ -d "\$d/rebase-merge" ] || [ -d "\$d/rebase-apply" ] || [ -f "\$d/MERGE_HEAD" ] && exit 0
    nohup tools/graphify-l0/graph-rebuild > /dev/null 2>&1 &
)
$end
EOF
fi
mv "$tmp" "$hook"
chmod +x "$hook"
echo "install-hook: $hook ${1:+(removed)}"
