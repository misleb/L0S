#!/bin/sh
# graph-rebuild -- make graph, one at a time, in the background's log.
#
# What the post-commit hook runs. A rebuild already running is told to go
# again when it ends, rather than racing it on graph.json, so the graph
# always ends at the last commit. The output is graphify-out/rebuild.log.
cd "$(git rev-parse --show-toplevel)" || exit 1
[ -f graphify-out/graph.json ] || exit 0
lock=graphify-out/.rebuild.lock
again=graphify-out/.rebuild.again
if ! mkdir "$lock" 2> /dev/null; then
    touch "$again"
    exit 0
fi
trap 'rmdir "$lock"' EXIT
{
    date
    while :; do
        rm -f "$again"
        make -s graph
        [ -f "$again" ] || break
    done
} > graphify-out/rebuild.log 2>&1
