; mkeeprom_test.l0 -- tests of mkeeprom.l0: what it refuses before
; writing anything. The update it writes is boot_order_written's, which
; bootloader_test.l0 tests on an image.

; Too few words, or too many: the usage, and 1.
(def test_usage () int
  (add (check_int "none" (mkeeprom (nil (list int))) 1)
       (check_int "five" (mkeeprom (split_spaces "a b 1 0xf21 x")) 1)))

; A time that is not a number, or an order that is not BOOT_ORDER's: 1.
(def test_refused () int
  (add (check_int "time" (mkeeprom (split_spaces "a b soon")) 1)
       (check_int "order" (mkeeprom (split_spaces "a b 1793657992 sd,net")) 1)))

; An image that is not there: 1.
(def test_no_image () int
  (check_int "missing" (mkeeprom (split_spaces "build/mkeeprom_test_none build 1793657992")) 1))

; BOOT_ORDER's values: 0x and one to eight hex digits.
(def test_order_ok () int
  (add (check_bool "0xf21" (mkeeprom_order_ok "0xf21") true)
       (add (check_bool "0xF41" (mkeeprom_order_ok "0xF41") true)
            (add (check_bool "no 0x" (mkeeprom_order_ok "f21") false)
                 (add (check_bool "empty" (mkeeprom_order_ok "0x") false)
                      (check_bool "not hex" (mkeeprom_order_ok "0xg1") false))))))
