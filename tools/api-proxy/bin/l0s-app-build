#!/usr/bin/env bash
# l0s-app-build -- an app the board's agent asked for (roadmap 0045),
# built for the board in its own folder by the builder's session:
#
#   l0s-app-build NAME [VAR...]
#
# checks and builds every .l0 in this folder (main.l0 last, no *_test.l0,
# no preview.l0, which is l0s-app-preview's)
# with the libraries a window app of L0S links, the Makefile's app-libs,
# and those of each Makefile variable VAR (CLOCK, AGENTLIB...), into
# ./NAME, a program for the board (l0 build --target proc).
#
# The libraries' files are L0S_TREE's, the app's worktree of L0S, whose
# libraries its session may have changed in place; the L0S this script
# is in if L0S_TREE is not set. Which files they are is this L0S's
# Makefile's. l0's own messages say what is wrong; the status is l0's.
set -u
if [ $# -lt 1 ] || ! [[ $1 =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
  echo "usage: l0s-app-build NAME [VAR...], NAME lowercase letters, digits and -" >&2
  exit 2
fi
name=$1; shift
root=$(cd "$(dirname "$0")/../../.." && pwd)
tree=${L0S_TREE:-$root}
for v in "$@"; do
  [[ $v =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "l0s-app-build: $v is not a Makefile variable's name" >&2; exit 2; }
done
libs=()
while read -r f; do libs+=("$tree/$f"); done < <(make -s -C "$root" app-libs APP_LIBS="$*" | tr ' ' '\n' | awk 'NF && !seen[$0]++')
srcs=()
for f in *.l0; do
  case $f in main.l0|preview.l0|*_test.l0) ;; *) [ -f "$f" ] && srcs+=("$f") ;; esac
done
[ -f main.l0 ] || { echo "l0s-app-build: no main.l0 here" >&2; exit 1; }
l0 check "${libs[@]}" ${srcs[@]+"${srcs[@]}"} main.l0 || exit $?
exec l0 build --target proc "${libs[@]}" ${srcs[@]+"${srcs[@]}"} main.l0 -o "$name"
