#!/usr/bin/env bash
# l0s-app-preview -- an app's scenes painted on this host, as the board
# would paint them, before it is built for the board (roadmap 0065):
#
#   l0s-app-preview NAME [VAR...]
#
# builds this folder's preview.l0, a main calling ui_preview with the
# app's scenes, with every other .l0 here (not main.l0, no *_test.l0)
# and the libraries l0s-app-build links, those of each Makefile variable
# VAR, and UI_PREVIEW, for this host, into preview/preview; and runs it,
# which writes preview/SCENE.png for each scene and says each path. Text
# and icons are drawn with the strikes and icons of L0S_BUILD, this L0S's
# build/ unless set, which make proxy makes.
#
# The libraries' files are L0S_TREE's, as l0s-app-build's are. l0's own
# messages say what is wrong; the status is l0's or the preview's.
#
# The preview is the session's own program, run on this host, and an L0
# program can open and write any file its user can; the session itself
# may write only in its folder. So it runs under bubblewrap: every file
# read-only but preview/, no network, and refused if bwrap is not there.
set -u
if [ $# -lt 1 ] || ! [[ $1 =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
  echo "usage: l0s-app-preview NAME [VAR...], NAME lowercase letters, digits and -" >&2
  exit 2
fi
shift
root=$(cd "$(dirname "$0")/../../.." && pwd)
tree=${L0S_TREE:-$root}
build=${L0S_BUILD:-$root/build}
for v in "$@"; do
  [[ $v =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "l0s-app-preview: $v is not a Makefile variable's name" >&2; exit 2; }
done
[ -f preview.l0 ] || { echo "l0s-app-preview: no preview.l0 here: write one, a main calling ui_preview with the app's scenes" >&2; exit 1; }
[ -f "$build/strikes/sans-16.strike" ] && [ -f "$build/icons.face" ] ||
  echo "l0s-app-preview: no strikes or icons in $build (make proxy makes them): the scenes will have no text or icons" >&2
libs=()
while read -r f; do libs+=("$tree/$f"); done < <(make -s -C "$root" app-libs APP_LIBS="$* UI_PREVIEW" | tr ' ' '\n' | awk 'NF && !seen[$0]++')
srcs=()
for f in *.l0; do
  case $f in main.l0|preview.l0|*_test.l0) ;; *) [ -f "$f" ] && srcs+=("$f") ;; esac
done
command -v bwrap > /dev/null || { echo "l0s-app-preview: no bwrap on this host, to run the preview confined in" >&2; exit 1; }
mkdir -p preview
l0 build "${libs[@]}" ${srcs[@]+"${srcs[@]}"} preview.l0 -o preview/preview || exit $?
here=$(pwd -P)
exec bwrap --ro-bind / / --dev /dev --proc /proc --bind "$here/preview" "$here/preview" \
  --unshare-all --die-with-parent --new-session --chdir "$here" preview/preview preview "$build"
