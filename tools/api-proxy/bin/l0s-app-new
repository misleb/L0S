#!/usr/bin/env bash
# l0s-app-new -- for the builder's sessions (roadmap 0065): L0S's
# tools/l0s-app-new, an app of one window in the shape the l0s-ui
# skill's apps.md teaches, written into this folder:
#
#   l0s-app-new NAME TITLE
#
# NAME.l0, NAME_test.l0, main.l0 and preview.l0, to be filled in, then
# previewed with l0s-app-preview NAME and built with l0s-app-build NAME.
set -u
[ $# -eq 2 ] || { echo "usage: l0s-app-new NAME TITLE" >&2; exit 2; }
root=$(cd "$(dirname "$0")/../../.." && pwd)
exec "$root/tools/l0s-app-new" "$1" "$2" .
