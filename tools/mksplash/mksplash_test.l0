(def test_header () int
  (check_str "P6" (ppm_header) "P6\n640 360 255\n"))

(def test_row_length () int
  (add (check_int "first row" (length (row (font) 0)) 1920)
       (check_int "a title row" (length (row (font) 150)) 1920)))

(def test_corner_is_ground () int
  (check_int "0,0" (pixel (font) 0 0) (ground)))

(def test_font_size () int
  (check_int "13 glyphs of 7 rows" (array_len (font)) 91))

(def test_glyphs () int
  (add (check_bool "L's top left" (glyph_lit (font) 76 0 0) true)
       (add (check_bool "L's top right" (glyph_lit (font) 76 4 0) false)
            (add (check_bool "L's foot" (glyph_lit (font) 76 4 6) true)
                 (check_bool "not in the font" (glyph_lit (font) 90 0 0) false)))))

(def test_title_centered () int
  (add (check_int "width" (text_width (title)) 272)
       (check_int "left" (text_left (title)) 184)))

; The L's stem: its first column, scaled 16, from row 84.
(def test_title_pixels () int
  (add (check_true "on the L" (on_text (font) (title) 190 100))
       (add (check_bool "between the L and the S" (on_text (font) (title) 270 100) false)
            (check_int "colored" (pixel (font) 190 84) (title_color 84)))))

(def test_rule () int
  (add (check_int "on the rule" (pixel (font) 320 221) (amber_dim))
       (check_int "past its end" (pixel (font) 600 221) (ground))))

(def test_whole_image_size () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "buffer" why))
    ((IoOpened b)
      (let w (write_splash b)
        (add (check_int "written" w 0)
             (check_int "header and pixels" (length (buffer_contents b)) (add 15 (mul (mul 640 360) 3))))))))
