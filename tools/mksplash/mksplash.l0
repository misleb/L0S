; mksplash.l0 -- draws L0S's splash screen, a binary PPM: "L0S" in large
; block letters with a rule beneath, and a tagline, on a solid ground, so
; that the gpu driver, filling the rest of the screen with the image's
; corner, makes it seamless at any size.
;
;   l0 run tools/mksplash/mksplash.l0 tools/mksplash/main.l0 > splash.ppm
;   l0 run ... -- 2 > splash2x.ppm      the same at scale 2, 1280 by 720

(def splash_w () int 640)
(def splash_h () int 360)

; Colors, as 0xRRGGBB.
(def ground () int 793638)          ; 0x0C1C26
(def amber () int 15779920)         ; 0xF0C850
(def amber_dim () int 9199160)      ; 0x8C5E38
(def slate () int 9874130)          ; 0x96AAD2

; ------------------------------------------------------------------- font

; 5 by 7 glyphs, each row 5 bits, the leftmost the most significant: the
; letters of font_chars, 7 rows each, in order.
(def font_chars () (list int) "LS0ANMICROKE ")

; One glyph's rows, written as decimal numbers in a string.
(def glyph ((rows (list int))) (list int)
  (numbers (split_spaces rows)))

(def numbers ((ws (list (list int)))) (list int)
  (if (is_empty ws) (nil int) (cons (int_prefix (head ws) 0) (numbers (tail ws)))))

(def font_rows () (list int)
  (append (glyph "16 16 16 16 16 16 31")         ; L
  (append (glyph "15 16 16 14 1 1 30")           ; S
  (append (glyph "14 17 19 21 25 17 14")         ; 0
  (append (glyph "14 17 17 31 17 17 17")         ; A
  (append (glyph "17 25 21 19 17 17 17")         ; N
  (append (glyph "17 27 21 21 17 17 17")         ; M
          (font_rows_rest))))))))

(def font_rows_rest () (list int)
  (append (glyph "14 4 4 4 4 4 14")              ; I
  (append (glyph "14 17 16 16 16 17 14")         ; C
  (append (glyph "30 17 17 30 20 18 17")         ; R
  (append (glyph "14 17 17 17 17 17 14")         ; O
  (append (glyph "17 18 20 24 20 18 17")         ; K
  (append (glyph "31 16 16 30 16 16 31")         ; E
          (glyph "0 0 0 0 0 0 0"))))))))         ; space

(def font () (array int) (array_from (font_rows) 0))

; Whether column gx, row gy of character ch's glyph is lit; a character
; the font lacks is blank.
(def glyph_lit ((f (array int)) (ch int) (gx int) (gy int)) bool
  (let i (index_of ch (font_chars))
    (if (lt i 0)
        false
        (eq (bit_and (bit_shr (array_get f (add (mul i 7) gy)) (sub 4 gx)) 1) 1))))

; ------------------------------------------------------------------- text

; A line of text: its characters, each glyph pixel scale pixels square,
; spacing pixels between characters, and the row it starts at. It is
; centered across the image.
(data Text (Text (array int) int int int))

(def advance ((scale int) (spacing int)) int (add (mul 5 scale) spacing))

(def text_width ((t Text)) int
  (match t ((Text s scale spacing top) (sub (mul (array_len s) (advance scale spacing)) spacing))))

(def text_left ((t Text)) int (div (sub (splash_w) (text_width t)) 2))

(def title () Text (Text (array_from "L0S" 0) 16 16 84))
(def tagline () Text (Text (array_from "AN L0 MICROKERNEL" 0) 3 3 252))

; Whether pixel x, y lies on a lit glyph pixel of t.
(def on_text ((f (array int)) (t Text) (x int) (y int)) bool
  (match t
    ((Text s scale spacing top)
      (let lx (sub x (text_left t))
        (let ly (sub y top)
          (if (if (lt lx 0) true (if (lt ly 0) true (ge ly (mul 7 scale))))
              false
              (on_glyph f s scale (advance scale spacing) lx ly)))))))

(def on_glyph ((f (array int)) (s (array int)) (scale int) (adv int) (lx int) (ly int)) bool
  (let ci (div lx adv)
    (let within (mod lx adv)
      (if (if (ge ci (array_len s)) true (ge within (mul 5 scale)))
          false
          (glyph_lit f (array_get s ci) (div within scale) (div ly scale))))))

; The rule under the title: as wide as it, 4 pixels tall.
(def on_rule ((x int) (y int)) bool
  (let left (text_left (title))
    (if (if (lt y 220) true (ge y 224))
        false
        (if (lt x left) false (lt x (add left (text_width (title))))))))

; ----------------------------------------------------------------- pixels

; The title's amber dims toward its foot, from row 84 to row 196.
(def title_color ((y int)) int
  (let k (div (mul (sub y 84) 64) 112)
    (rgb (sub 240 k) (sub 200 (div k 2)) (sub 80 (div k 4)))))

(def pixel ((f (array int)) (x int) (y int)) int
  (if (on_text f (title) x y)
      (title_color y)
      (if (on_rule x y)
          (amber_dim)
          (if (on_text f (tagline) x y) (slate) (ground)))))

; Row y's bytes, r, g, b for each pixel.
(def row ((f (array int)) (y int)) (list int) (row_at f y 1))

; Row y of the image at scale s, s times as wide and high: each of its
; pixels s by s of the screen's, as the desktop at scale 2 shows it. The
; letters are blocks, so they are as sharp at 2 as at 1.
(def row_at ((f (array int)) (y int) (s int)) (list int)
  (rev (push_row f (div y s) s 0 (nil int))))

(def push_row ((f (array int)) (y int) (s int) (x int) (acc (list int))) (list int)
  (if (eq x (mul s (splash_w)))
      acc
      (push_row f y s (add x 1) (ppm_push_rgb (pixel f (div x s) y) acc))))

; ------------------------------------------------------------------ output

; Writes the image to out a row at a time: 0, or the first negative code
; a write gave.
(def write_splash ((out IoFile)) int (write_splash_at out 1))

(def write_splash_at ((out IoFile) (s int)) int
  (let hd (ppm_header (mul s (splash_w)) (mul s (splash_h)))
    (let h (file_write_bytes out (bytes_from_list hd) 0 (length hd))
      (if (lt h 0) h (write_rows out (font) s 0)))))

(def write_rows ((out IoFile) (f (array int)) (s int) (y int)) int
  (if (eq y (mul s (splash_h)))
      0
      (let b (bytes_from_list (row_at f y s))
        (let w (file_write_bytes out b 0 (bytes_len b))
          (if (lt w 0) w (write_rows out f s (add y 1)))))))

; The scale argv asks for: 2 if it is "2", else 1.
(def splash_scale ((argv (list (list int)))) int
  (if (if (is_empty argv) false (eq (head argv) "2")) 2 1))

; The program: the image on standard output, at the scale its argument
; gives, 1 or 2, and its exit status.
(def mksplash ((argv (list (list int)))) int
  (let w (write_splash_at (IoFile 1) (splash_scale argv))
    (match (file_flush (IoFile 1))
      ((NotDone fault why) (let e (write_err (append "mksplash: " (append why "\n"))) 1))
      ((Done) (if (lt w 0) 1 0)))))
