#!/usr/bin/env bash
# l0s-app-new -- a new app of one window, written in the shape the l0s-ui
# skill's apps.md teaches and To Do has (roadmap 0065), to be filled in
# from a description:
#
#   l0s-app-new NAME TITLE [DIR] [--bundle APP]
#
# writes into DIR (. unless given; made if it is not there):
#
#   NAME.l0         its state, view, update and step, run by ui_run: a
#                   counter, a label and a button, to replace
#   NAME_test.l0    tests of its update and view, and that it fails with
#                   no compositor
#   main.l0         only main, calling NAME
#   preview.l0      its scenes, for make preview APP=NAME or
#                   l0s-app-preview NAME
#
# and with --bundle APP, the bundle APP.app/: its manifest, named TITLE,
# and an icon.draw, as an app in user/apps has. NAME is a program's name,
# lowercase letters, digits and -, a letter first; its functions are
# named with _ for -, and its state's type is NAME capitalized. Refuses
# to write over any file that is there. What it writes checks, builds
# and previews as written.
set -u
usage() { echo "usage: l0s-app-new NAME TITLE [DIR] [--bundle APP]" >&2; exit 2; }
[ $# -ge 2 ] || usage
name=$1; title=$2; shift 2
dir=.; bundle=""
while [ $# -gt 0 ]; do
  case $1 in
    --bundle) [ $# -ge 2 ] || usage; bundle=$2; shift 2 ;;
    *) dir=$1; shift ;;
  esac
done
[[ $name =~ ^[a-z][a-z0-9-]{0,31}$ ]] || { echo "l0s-app-new: $name is not a program's name: lowercase letters, digits and -, a letter first" >&2; exit 2; }
if [ -z "$title" ] || [[ $title == *\"* ]] || [[ $title == *\\* ]] || printf '%s' "$title" | LC_ALL=C grep -q '[^ -~]'; then
  echo "l0s-app-new: a title is printable ASCII with no \" or \\" >&2; exit 2
fi
[ -z "$bundle" ] || [[ $bundle =~ ^[A-Z][A-Za-z0-9]*$ ]] || { echo "l0s-app-new: a bundle's name is one word, a capital first" >&2; exit 2; }
fn=${name//-/_}
ty=${fn^}
mkdir -p "$dir" || exit 1
files=("$dir/$name.l0" "$dir/${name}_test.l0" "$dir/main.l0" "$dir/preview.l0")
[ -z "$bundle" ] || files+=("$dir/$bundle.app/manifest" "$dir/$bundle.app/icon.draw")
for f in "${files[@]}"; do
  [ -e "$f" ] && { echo "l0s-app-new: $f is there already; nothing written" >&2; exit 1; }
done

cat > "$dir/$name.l0" <<EOF
; $name.l0 -- $title: say here, in a few lines, what it shows and what a
; person does with it.
;
;   $name          its window, until it is closed

; ----------------------------------------------------------------- state

; Everything the window shows, kept here, as the Elm architecture keeps
; it: replace count with what the app keeps, a field each.
(data $ty ($ty (count int)))

; The app as it opens.
(def ${fn}_new () $ty ($ty 0))

; ------------------------------------------------------------------ view

; The window, made afresh from the state each time: a page, its title
; and a line under it, then the count, large, and a button under it,
; both in the middle, as a button alone in a column is.
(def ${fn}_view ((s $ty)) UiWidget
  (ui_page "$title" "Each click adds one"
           (cons (UiLabel (digits (.count s)) (UiLarge) (UiCenter))
                 (cons (UiButton "app.add" "list-add" "Add One" (UiBtnSuggested) true) (nil UiWidget)))))

; ---------------------------------------------------------------- update

; The app after action, set off with ev: one test of the action's name a
; line, then the app as it was.
(def ${fn}_update ((s $ty) (action (list int)) (ev UiEvent)) $ty
  (if (eq action "app.add") (.count s (add (.count s) 1))
      s))

; ------------------------------------------------------------------ loop

; A step of the window: the app updated, the window as it was. Here is
; where the window is asked of, with the state: ui_win_alarm for a timer,
; ui_win_focusing for an entry, ui_win_ask for a server.
(def ${fn}_step ((s $ty) (action (list int)) (ev UiEvent) (w UiWin)) (UiStepped $ty)
  (UiStepped w (${fn}_update s action ev)))

; Its window, until it is closed.
(def ${fn} () int
  (ui_run "$name" "$title" 480 360 (${fn}_new) ${fn}_view ${fn}_step))
EOF

cat > "$dir/${name}_test.l0" <<EOF
(def none () UiEvent (UiOther 0 ""))

; A click on Add counts one.
(def test_add () int
  (check_int "one" (.count (${fn}_update (${fn}_new) "app.add" (none))) 1))

; The window shows the count, and Add is a target.
(def test_view () int
  (let ns (ui_laid (${fn}_view (${fn}_new)) 480 360)
    (add (check_bool "the count" (ui_has_text ns "0") true)
         (check_bool "Add" (ui_has_target ns "app.add") true))))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (${fn}) 1))
EOF

cat > "$dir/main.l0" <<EOF
(def main () int (${fn}))
EOF

cat > "$dir/preview.l0" <<EOF
; preview.l0 -- $title's scenes, each the view of a state, painted on
; the host as the board paints them: as it opens, and after a click.
(def main () int
  (ui_preview (cons (UiShot "main" 480 360 (${fn}_view (${fn}_new)))
                    (cons (UiShot "added" 480 360 (${fn}_view (${fn}_update (${fn}_new) "app.add" (UiOther 0 ""))))
                          (nil UiShot)))))
EOF

if [ -n "$bundle" ]; then
  mkdir -p "$dir/$bundle.app"
  cat > "$dir/$bundle.app/manifest" <<EOF
# $title.
name $title
exec $name
icon icon.ppm
summary $title
EOF
  cat > "$dir/$bundle.app/icon.draw" <<EOF
# $title's icon, which tools/mkicon draws: a square, and an icon on it.
round 0 0 48 48 10 blue_3
icon 8 8 view-app-grid 2 white
EOF
fi
printf '%s\n' "${files[@]}"
