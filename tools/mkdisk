#!/usr/bin/env bash
# mkdisk OUT -- makes OUT a disk image for QEMU's virtio-blk: 1 MB, 2048
# sectors of 512 bytes, with L0S's file system on it (user/lib/l0fs.l0),
# as tools/mkfs writes it:
#
#   sector 0          an MBR listing two partitions of type 0x4C
#   sectors 1-7       nothing, zeros
#   sectors 8-1535    the volume data, empty, mounted as /Volumes/data
#   sectors 1536-2047 the volume scratch, empty, /Volumes/scratch
#
# It builds build/mkfs first if that is missing or older than its
# sources. The demo's disk is build/disk.img, made once, so what is
# written to it stays; each e2e case with a disk file gets a fresh one.
set -eu
out=$1
top=$(cd "$(dirname "$0")/.." && pwd)
make -s -C "$top" build/mkfs
"$top/build/mkfs" "$out" 2048 data:8:1528 scratch:1536:512
