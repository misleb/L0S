#!/usr/bin/env bash
# mkdisk OUT -- makes OUT a disk image for QEMU's virtio-blk: 1 MB, 2048
# sectors of 512 bytes, all zeros but for sector 0, which begins
#
#   L0S disk
#
# and a newline, so a test can tell it has read the disk. The demo's disk
# is build/disk.img, made once, so what is written to it stays; each e2e
# case with a disk file gets a fresh one.
set -eu
out=$1
dd if=/dev/zero of="$out" bs=1024 count=1024 2> /dev/null
printf 'L0S disk\n' | dd of="$out" conv=notrunc 2> /dev/null
