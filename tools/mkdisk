#!/usr/bin/env bash
# mkdisk OUT [SECTORS SPEC...] -- makes OUT a disk image for QEMU's
# virtio-blk, with L0S's file system on it (user/lib/format/l0fs.l0), as
# tools/mkfs writes it. With no more arguments it is 1 MB, 2048 sectors
# of 512 bytes:
#
#   sector 0          a protective MBR
#   sectors 1-33      the GPT (user/lib/format/gpt.l0): its header and entries,
#                     two partitions of L0FS's type, each with its UUID
#   sectors 34-39     nothing, zeros
#   sectors 40-1535   the volume data, empty, mounted as /Volumes/data
#   sectors 1536-2014 the volume scratch, empty, /Volumes/scratch
#   sectors 2015-2047 the GPT's backup
#
# Otherwise it is SECTORS sectors with the volumes SPEC, each
# LABEL:START:COUNT[:ARCHIVE[:UUID]] as mkfs takes them: an ARCHIVE, a
# cpio such as build/initramfs.cpio, fills its volume, and a UUID is its
# partition's. It says each volume's label and UUID, a line each.
#
# The UUIDs are of version 7, of the time now, which date gives, in
# milliseconds. It builds build/mkfs first if that is missing or older
# than its sources. The demo's disk is build/disk.img, made once, so what
# is written to it stays; each e2e case with a disk file gets a fresh one.
set -eu
out=$1
shift
top=$(cd "$(dirname "$0")/.." && pwd)
make -s -C "$top" build/mkfs
if [ $# -eq 0 ]; then
  # The default layout's UUIDs are nobody's business: say nothing, as
  # before, since the MCP server's stdout is its protocol.
  "$top/build/mkfs" "$out" 2048 "$(date +%s)000" data:40:1496 scratch:1536:479 > /dev/null
else
  sectors=$1
  shift
  "$top/build/mkfs" "$out" "$sectors" "$(date +%s)000" "$@"
fi
