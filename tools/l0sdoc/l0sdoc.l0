; l0sdoc.l0 -- L0S's own library documentation, looked up as l0 doc looks
; up L0's standard library: every documented name, one name in full, one
; file in full, or a search of names and documentation.
;
;   l0sdoc QUERY FILE...      what make -s doc [Q=QUERY] runs
;
; L0 cannot list a directory, so the files come as arguments. A query of
; "" lists every file's summary and every documented name; a def, a data
; type, or a constructor (which finds its type) shows that entry in full;
; a file's stem, such as l0s or widget, shows the file; anything else is
; searched for, ignoring case, in names and documentation.

; One top-level form: its file, its name, a data type's constructors, its
; signature, the comment block it is documented by (its own, or its
; group's), the comment on its first line, the line its group starts on,
; whether it is a data type, and its lines as written.
(data Entry (Entry (list int) (list int) (list (list int)) (list int) (list (list int)) (list int) int bool (list (list int))))

(def e_path ((e Entry)) (list int) (match e ((Entry p n cs sig blk tr g dt ls) p)))
(def e_name ((e Entry)) (list int) (match e ((Entry p n cs sig blk tr g dt ls) n)))
(def e_ctors ((e Entry)) (list (list int)) (match e ((Entry p n cs sig blk tr g dt ls) cs)))
(def e_sig ((e Entry)) (list int) (match e ((Entry p n cs sig blk tr g dt ls) sig)))
(def e_block ((e Entry)) (list (list int)) (match e ((Entry p n cs sig blk tr g dt ls) blk)))
(def e_trail ((e Entry)) (list int) (match e ((Entry p n cs sig blk tr g dt ls) tr)))
(def e_group ((e Entry)) int (match e ((Entry p n cs sig blk tr g dt ls) g)))
(def e_data ((e Entry)) bool (match e ((Entry p n cs sig blk tr g dt ls) dt)))
(def e_lines ((e Entry)) (list (list int)) (match e ((Entry p n cs sig blk tr g dt ls) ls)))

; A library: its path, its header without the comment markers, and its
; entries in order.
(data Lib (Lib (list int) (list (list int)) (list Entry)))

(def lib_path ((l Lib)) (list int) (match l ((Lib p h es) p)))
(def lib_header ((l Lib)) (list (list int)) (match l ((Lib p h es) h)))
(def lib_entries ((l Lib)) (list Entry) (match l ((Lib p h es) es)))

; ------------------------------------------------------------------- text


(def is_blank ((s (list int))) bool
  (is_empty (skip_spaces s)))

(def trim_right ((s (list int))) (list int)
  (rev (skip_spaces (rev s))))

(def trim ((s (list int))) (list int)
  (trim_right (skip_spaces s)))

(def lower ((s (list int))) (list int)
  (lower_onto s (nil int)))

(def lower_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (let c (head s)
        (lower_onto (tail s) (cons (if (is_upper c) (add c 32) c) acc)))))

; The lines before the first empty one.
(def paragraph ((ls (list (list int)))) (list (list int))
  (paragraph_onto ls (nil (list int))))

(def paragraph_onto ((ls (list (list int))) (acc (list (list int)))) (list (list int))
  (if (if (is_empty ls) true (is_empty (head ls)))
      (rev acc)
      (paragraph_onto (tail ls) (cons (head ls) acc))))

; s up to and including the first full stop that ends a sentence, one
; followed by a space or by nothing.
(def first_sentence ((s (list int))) (list int)
  (sentence_onto s (nil int)))

(def sentence_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (if (eq (head s) 46) (if (is_empty (tail s)) true (eq (head (tail s)) 32)) false)
          (rev (cons 46 acc))
          (sentence_onto (tail s) (cons (head s) acc)))))

; s from after s0 ends, or all of s if it does not contain s0.
(def after ((s (list int)) (s0 (list int))) (list int)
  (if (is_empty s) (nil int) (if (starts_with s s0) (drop_n s (length s0)) (after (tail s) s0))))

; ------------------------------------------------------------------ lines

(def bytes_lines ((b bytes)) (list (list int))
  (lines_from b 0 (nil int) (nil (list int))))

(def lines_from ((b bytes) (i int) (cur (list int)) (acc (list (list int)))) (list (list int))
  (if (ge i (bytes_len b))
      (rev (if (is_empty cur) acc (cons (rev cur) acc)))
      (let c (bytes_get b i)
        (if (eq c 10)
            (lines_from b (add i 1) (nil int) (cons (rev cur) acc))
            (lines_from b (add i 1) (cons c cur) acc)))))

; A line cut at its comment: the code before the first ; outside a string,
; and what follows the ;, or nothing if there is no comment.
(data Cut (Cut (list int) (list int)))

(def cut ((s (list int))) Cut
  (cut_onto s false false (nil int)))

(def cut_onto ((s (list int)) (in_str bool) (esc bool) (acc (list int))) Cut
  (if (is_empty s)
      (Cut (rev acc) (nil int))
      (let c (head s)
        (if in_str
            (cut_onto (tail s) (if esc true (not (eq c 34))) (if esc false (eq c 92)) (cons c acc))
            (if (eq c 59)
                (Cut (rev acc) (cons c (tail s)))
                (cut_onto (tail s) (eq c 34) false (cons c acc)))))))

(def code_of ((s (list int))) (list int)
  (match (cut s) ((Cut code comment) (trim code))))

; The comment on a line, without its markers, or nothing.
(def trail_of ((s (list int))) (list int)
  (match (cut s) ((Cut code comment) (unmark comment))))

; A comment line's text: without its ;s and one space after them.
(def unmark ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 59)
          (unmark (tail s))
          (trim_right (if (eq (head s) 32) (tail s) s)))))

(def is_comment ((s (list int))) bool
  (if (is_empty s) false (eq (head s) 59)))

(def is_divider ((s (list int))) bool
  (starts_with (skip_spaces (unmark s)) "---"))

(def is_indented ((s (list int))) bool
  (if (is_blank s) false (eq (head s) 32)))

(def is_form ((s (list int))) bool
  (if (starts_with s "(def ") true (starts_with s "(data ")))

; A comment block's documentation: its lines' text, without dividers.
(def block_doc ((ls (list (list int)))) (list (list int))
  (block_doc_onto ls (nil (list int))))

(def block_doc_onto ((ls (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty ls)
      (rev acc)
      (block_doc_onto (tail ls) (if (is_divider (head ls)) acc (cons (unmark (head ls)) acc)))))

; The file's header: the comment lines it starts with.
(def header_of ((ls (list (list int))) (acc (list (list int)))) (list (list int))
  (if (if (is_empty ls) true (not (is_comment (head ls))))
      (rev acc)
      (header_of (tail ls) (cons (unmark (head ls)) acc))))

; ------------------------------------------------------------ signatures

; The length of the element s starts with: a name, or a parenthesised
; group, or -1 if the group is not closed within s.
(def elem_len ((s (list int))) int
  (if (is_empty s)
      -1
      (if (eq (head s) 40)
          (group_len (tail s) 1 1)
          (if (eq (head s) 41) -1 (atom_len s 0)))))

(def group_len ((s (list int)) (depth int) (n int)) int
  (if (eq depth 0)
      n
      (if (is_empty s)
          -1
          (let c (head s)
            (group_len (tail s) (if (eq c 40) (add depth 1) (if (eq c 41) (sub depth 1) depth)) (add n 1))))))

(def atom_len ((s (list int)) (n int)) int
  (if (is_empty s)
      n
      (let c (head s)
        (if (if (is_space c) true (if (eq c 40) true (eq c 41)))
            n
            (atom_len (tail s) (add n 1))))))

(def spaces_len ((s (list int)) (n int)) int
  (if (is_empty s) n (if (is_space (head s)) (spaces_len (tail s) (add n 1)) n)))

; How many characters of s the next k elements take, spaces before each
; included, or -1 if they do not all end within s.
(def elems_len ((s (list int)) (k int) (n int)) int
  (if (eq k 0)
      n
      (let sp (spaces_len s 0)
        (let rest (drop_n s sp)
          (let e (elem_len rest)
            (if (lt e 1) -1 (elems_len (drop_n rest e) (sub k 1) (add n (add sp e)))))))))

(def take_atom ((s (list int))) (list int)
  (take s (atom_len s 0)))

; The name a form declares, kw characters in: "(def" is 4, "(data" 5.
(def form_name ((code (list int)) (kw int)) (list int)
  (let s (skip_spaces (drop_n code kw))
    (if (is_empty s)
        s
        (if (eq (head s) 40) (take_atom (skip_spaces (tail s))) (take_atom s)))))

; A def's name, parameters, and return type: from its first line, or the
; lines they wrap onto when nothing follows the return type on the last,
; and otherwise the first line alone.
(def def_sig ((codes (list (list int)))) (list int)
  (sig_try (head codes) (tail codes) (head codes) 1))

(def sig_try ((text (list int)) (more (list (list int))) (first (list int)) (k int)) (list int)
  (let past (drop_n text 4)
    (let n (elems_len past 3 0)
      (if (lt n 0)
          (if (is_empty more)
              (skip_spaces (drop_n first 4))
              (sig_try (append text (cons 32 (head more))) (tail more) first (add k 1)))
          (if (if (eq k 1) true (is_blank (drop_n past n)))
              (skip_spaces (take past n))
              (skip_spaces (drop_n first 4)))))))

; A data type's constructors, from its form on one line.
(def data_ctors ((flat (list int))) (list (list int))
  (let s (skip_spaces (drop_n flat 5))
    (let n (elem_len s)
      (if (lt n 0) (nil (list int)) (ctors_from (drop_n s n) (nil (list int)))))))

(def ctors_from ((s (list int)) (acc (list (list int)))) (list (list int))
  (let t (skip_spaces s)
    (if (if (is_empty t) true (not (eq (head t) 40)))
        (rev acc)
        (let n (elem_len t)
          (if (lt n 0)
              (rev acc)
              (ctors_from (drop_n t n) (cons (take_atom (skip_spaces (tail t))) acc)))))))

(def codes_of ((ls (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty ls) (rev acc) (codes_of (tail ls) (cons (code_of (head ls)) acc))))

; An entry from a form's lines, the block documenting it, and its group.
(def make_entry ((path (list int)) (ls (list (list int))) (blk (list (list int))) (g int)) Entry
  (let codes (codes_of ls (nil (list int)))
    (let tr (trail_of (head ls))
      (if (starts_with (head ls) "(data")
          (let flat (unwords codes)
            (let whole (elem_len flat)
              (let sig (if (lt whole 0) (head codes) (take flat whole))
                (Entry path (form_name flat 5) (data_ctors sig) sig blk tr g true ls))))
          (Entry path (form_name (head codes) 4) (nil (list int)) (def_sig codes) blk tr g false ls)))))

; ---------------------------------------------------------------- parsing

; A form being read: its lines so far, reversed, its block, and its group.
(data Pending (Pending (list (list int)) (list (list int)) int) (NoPending))

(def flush_pending ((path (list int)) (p Pending) (acc (list Entry))) (list Entry)
  (match p
    ((Pending ls blk g) (cons (make_entry path (rev ls) blk g) acc))
    ((NoPending) acc)))

(def pending_add ((p Pending) (l (list int))) Pending
  (match p
    ((Pending ls blk g) (Pending (cons l ls) blk g))
    ((NoPending) p)))

(def parse_lib ((path (list int)) (b bytes)) Lib
  (let ls (bytes_lines b)
    (Lib path (header_of ls (nil (list int)))
         (scan path ls 1 0 (nil (list int)) 0 (nil (list int)) 0 (NoPending) (nil Entry)))))

; Line n of the file is the head of ls. prev says what the line before it
; was: 0 blank, 1 a comment, 2 part of a form, 3 anything else. blk is
; the comment block above, reversed, from line bstart; gblk is the block
; documenting the current group of forms, whose first form is on line g.
(def scan ((path (list int)) (ls (list (list int))) (n int) (prev int)
           (blk (list (list int))) (bstart int) (gblk (list (list int))) (g int)
           (pend Pending) (acc (list Entry))) (list Entry)
  (if (is_empty ls)
      (rev (flush_pending path pend acc))
      (if (if (eq prev 2) (is_indented (head ls)) false)
          (scan path (tail ls) (add n 1) 2 blk bstart gblk g (pending_add pend (head ls)) acc)
          (scan_line path (head ls) (tail ls) n prev blk bstart gblk g (flush_pending path pend acc)))))

(def scan_line ((path (list int)) (l (list int)) (ls (list (list int))) (n int) (prev int)
                (blk (list (list int))) (bstart int) (gblk (list (list int))) (g int)
                (acc (list Entry))) (list Entry)
  (if (is_blank l)
      (scan path ls (add n 1) 0 blk bstart gblk g (NoPending) acc)
      (if (is_comment l)
          (if (eq prev 1)
              (scan path ls (add n 1) 1 (cons l blk) bstart gblk g (NoPending) acc)
              (scan path ls (add n 1) 1 (cons l (nil (list int))) n gblk g (NoPending) acc))
          (if (is_form l)
              (scan_form path l ls n prev blk bstart gblk g acc)
              (scan path ls (add n 1) 3 blk bstart gblk g (NoPending) acc)))))

; A form after a block starts a group the block documents; one right after
; another form joins that form's group; any other starts an undocumented
; group. The file's header documents nothing.
(def scan_form ((path (list int)) (l (list int)) (ls (list (list int))) (n int) (prev int)
                (blk (list (list int))) (bstart int) (gblk (list (list int))) (g int)
                (acc (list Entry))) (list Entry)
  (let doc (block_doc (rev blk))
    (if (if (eq prev 1) (if (gt bstart 1) (not (is_empty doc)) false) false)
        (scan path ls (add n 1) 2 blk bstart doc n (Pending (cons l (nil (list int))) doc n) acc)
        (if (eq prev 2)
            (scan path ls (add n 1) 2 blk bstart gblk g (Pending (cons l (nil (list int))) gblk g) acc)
            (scan path ls (add n 1) 2 blk bstart (nil (list int)) n
                  (Pending (cons l (nil (list int))) (nil (list int)) n) acc)))))

; ----------------------------------------------------------------- output

(def stem ((path (list int))) (list int)
  (let base (rev (up_to 47 (rev path)))
    (if (ends_with base ".l0") (take base (sub (length base) 3)) base)))

(def emit ((s (list int)) (acc (list int))) (list int)
  (cons 10 (push s acc)))

(def emit_doc ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s) (cons 10 acc) (emit s (push "  " acc))))

(def emit_docs ((ls (list (list int))) (acc (list int))) (list int)
  (if (is_empty ls) acc (emit_docs (tail ls) (emit_doc (head ls) acc))))

(def emit_form ((ls (list (list int))) (acc (list int))) (list int)
  (if (is_empty ls) acc (emit_form (tail ls) (emit (trim_right (head ls)) (push "  " acc)))))

; One entry in full: path and signature, its block if show_block, the
; comment on its first line, and a data type's form as written.
(def emit_entry ((e Entry) (show_block bool) (acc (list int))) (list int)
  (let a (emit (e_sig e) (push ": " (push (e_path e) acc)))
    (let b (if show_block (emit_docs (e_block e) a) a)
      (let c (if (is_empty (e_trail e)) b (emit_doc (e_trail e) b))
        (if (if (e_data e) (gt (length (e_lines e)) 1) false) (emit_form (e_lines e) c) c)))))

(def is_documented ((e Entry)) bool
  (if (is_empty (e_block e)) (not (is_empty (e_trail e))) true))

; The first sentence of an entry's documentation: the comment on its first
; line if it has one, else its block's.
(def summary ((e Entry)) (list int)
  (if (is_empty (e_trail e)) (first_sentence (unwords (paragraph (e_block e)))) (e_trail e)))

(def lib_summary ((l Lib)) (list int)
  (let text (unwords (paragraph (lib_header l)))
    (first_sentence (if (contains text " -- ") (after text " -- ") text))))

; An entry on one line: path, name, and summary, if it has one.
(def emit_line ((e Entry) (acc (list int))) (list int)
  (let a (push (e_name e) (push ": " (push (e_path e) acc)))
    (let s (summary e)
      (if (is_empty s) (cons 10 a) (emit s (push " \xe2\x80\x94 " a))))))

; ---------------------------------------------------------------- queries

(def doc_query ((q (list int)) (libs (list Lib))) (list int)
  (if (is_empty q)
      (rev (list_libs libs false (nil int)))
      (let named (named q libs (nil Entry))
        (if (not (is_empty named))
            (rev (emit_entries named true (nil int)))
            (match (lib_by_stem q libs)
              ((Some l) (rev (emit_lib l (nil int))))
              ((None) (rev (search q libs))))))))

; Every file's summary, then a line for each documented name.
(def list_libs ((libs (list Lib)) (sep bool) (acc (list int))) (list int)
  (if (is_empty libs)
      acc
      (let l (head libs)
        (let a (emit (lib_summary l) (push ": " (push (lib_path l) (push "== " (if sep (cons 10 acc) acc)))))
          (list_libs (tail libs) true (emit_documented (lib_entries l) a))))))

(def emit_documented ((es (list Entry)) (acc (list int))) (list int)
  (if (is_empty es)
      acc
      (emit_documented (tail es) (if (is_documented (head es)) (emit_line (head es) acc) acc))))

; Every entry, in every file, that declares q: as a def, a data type, or
; one of a data type's constructors.
(def named ((q (list int)) (libs (list Lib)) (acc (list Entry))) (list Entry)
  (if (is_empty libs) (rev acc) (named q (tail libs) (named_in q (lib_entries (head libs)) acc))))

(def named_in ((q (list int)) (es (list Entry)) (acc (list Entry))) (list Entry)
  (if (is_empty es)
      acc
      (let e (head es)
        (named_in q (tail es) (if (if (eq (e_name e) q) true (any_eq q (e_ctors e))) (cons e acc) acc)))))

(def emit_entries ((es (list Entry)) (first bool) (acc (list int))) (list int)
  (if (is_empty es)
      acc
      (emit_entries (tail es) false (emit_entry (head es) true (if first acc (cons 10 acc))))))

(def lib_by_stem ((q (list int)) (libs (list Lib))) (Option Lib)
  (if (is_empty libs)
      ((None Lib))
      (if (eq (stem (lib_path (head libs))) q) (Some (head libs)) (lib_by_stem q (tail libs)))))

; A file in full: its header, then every entry, a group of forms sharing a
; block together, with the block once.
(def emit_lib ((l Lib) (acc (list int))) (list int)
  (let a (emit_docs (lib_header l) (emit (lib_path l) (push "== " acc)))
    (emit_group_entries (lib_entries l) 0 (cons 10 a))))

(def emit_group_entries ((es (list Entry)) (g int) (acc (list int))) (list int)
  (if (is_empty es)
      acc
      (let e (head es)
        (if (eq (e_group e) g)
            (emit_group_entries (tail es) g (emit_entry e false acc))
            (emit_group_entries (tail es) (e_group e)
                                (emit_entry e true (if (eq g 0) acc (cons 10 acc))))))))

; Every documented entry whose name or documentation mentions q, ignoring
; case.
(def search ((q (list int)) (libs (list Lib))) (list int)
  (let found (mentions (lower q) libs (nil int))
    (if (is_empty found)
        (emit (append "Nothing is named or mentions " (append q ".")) (nil int))
        (append found (emit (append "Nothing is named " (append q "; these mention it:")) (nil int))))))

(def mentions ((q (list int)) (libs (list Lib)) (acc (list int))) (list int)
  (if (is_empty libs) acc (mentions q (tail libs) (mentions_in q (lib_entries (head libs)) acc))))

(def mentions_in ((q (list int)) (es (list Entry)) (acc (list int))) (list int)
  (if (is_empty es)
      acc
      (let e (head es)
        (mentions_in q (tail es) (if (mentions_q q e) (emit_line e (push "  " acc)) acc)))))

(def mentions_q ((q (list int)) (e Entry)) bool
  (if (contains (lower (e_name e)) q)
      true
      (if (contains (lower (unwords (e_block e))) q) true (contains (lower (e_trail e)) q))))

; ---------------------------------------------------------------- reading

(def read_lib ((path (list int)) (f IoFile)) (Result Lib (list int))
  (match (file_read_all f)
    ((IoBytes b) (let c (file_close f) ((Ok Lib (list int)) (parse_lib path b))))
    ((IoReadFailed code) (let c (file_close f) ((Err Lib (list int)) (io_error code))))))

(def load_lib ((path (list int))) (Result Lib (list int))
  (match (open_in path)
    ((IoFailed fault why) ((Err Lib (list int)) why))
    ((IoOpened f) (read_lib path f))))

(def load_libs ((paths (list (list int))) (acc (list Lib))) (Result (list Lib) (list int))
  (if (is_empty paths)
      ((Ok (list Lib) (list int)) (rev acc))
      (match (load_lib (head paths))
        ((Ok l) (load_libs (tail paths) (cons l acc)))
        ((Err why) ((Err (list Lib) (list int)) (append (head paths) (append ": " why)))))))

; The query, then the files: what to write, or why not.
(def l0sdoc ((as (list (list int)))) (Result (list int) (list int))
  (if (is_empty as)
      ((Err (list int) (list int)) "usage: l0sdoc QUERY FILE...")
      (match (load_libs (tail as) (nil Lib))
        ((Ok libs) ((Ok (list int) (list int)) (doc_query (head as) libs)))
        ((Err why) ((Err (list int) (list int)) why)))))
