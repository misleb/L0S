; A library as read from src, through the same read_lib the tool uses.
(def lib_of ((path (list int)) (src (list int))) Lib
  (match (open_in_bytes src)
    ((IoFailed fault why) (Lib path (nil (list int)) (nil Entry)))
    ((IoOpened f)
      (match (read_lib path f)
        ((Ok l) l)
        ((Err why) (Lib path (nil (list int)) (nil Entry)))))))

; A header, a divider, a block, a block a blank line cuts off, a group
; sharing its block, comments on first lines, a generic def, two wrapped
; signatures, a ; in a string, a divider right above a form, and two data
; types, the last line with no newline.
(def src_a () (list int)
  (append (src_a1) (append (src_a2) (append (src_a3) (src_a4)))))

(def src_a1 () (list int)
  "; a.l0 -- the first library. It has two sentences.\n; More header.\n\n; ------------------------------------------------------------ section\n\n; Adds one to n. Really.\n(def inc ((n int)) int (add n 1))\n\n; Not this.\n\n(def bare ((n int)) int n)\n\n")

(def src_a2 () (list int)
  "; The colors, as 0xRRGGBB.\n(def red () int 16711680)\n(def green () int 65280)          ; 0x00FF00\n(def blue () int 255)\n\n(def first_k () int 1)            ; one\n(def second_k () int 2)\n\n; Generic.\n(def (pick T) ((a T) (b T)) T\n  a)\n\n")

(def src_a3 () (list int)
  "; Wrapped.\n(def wide ((a int) (b int)\n           (c int)) int\n  (add a (add b c)))\n\n; Wrapped, with its body after.\n(def odd ((a int)\n          (b int)) int (add a b))\n; A semicolon in a string.\n(def semi () (list int) \";\")      ; the semicolon\n; ---- divider directly above\n(def after_div () int 0)\n\n")

(def src_a4 () (list int)
  "; A shape.\n(data Shape\n  (Circle int)                    ; radius\n  (Rect int int))                 ; w, h\n\n; A box of anything.\n(data (Box T) (Box T))")

; A header right above a form, which it does not document.
(def src_b () (list int)
  "; b.l0 -- the second library.\n(def inc ((n int)) int (add n 2))\n")

(def src_c () (list int)
  "; c.l0 -- colors.\n\n; The colors.\n(def red () int 1)\n(def green () int 2)    ; green\n\n(def other () int 3)\n")

(def lib_a () Lib (lib_of "lib/a.l0" (src_a)))
(def libs_a () (list Lib) (cons (lib_a) (nil Lib)))
(def libs_ab () (list Lib) (cons (lib_a) (cons (lib_of "lib/b.l0" (src_b)) (nil Lib))))

(def q_a ((q (list int))) (list int) (doc_query q (libs_a)))

(def names ((es (list Entry)) (acc (list (list int)))) (list (list int))
  (if (is_empty es) (rev acc) (names (tail es) (cons (.name (head es)) acc))))

; ---------------------------------------------------------------- parsing

(def test_every_form_is_an_entry () int
  (check_strs "names" (names (.entries (lib_a)) (nil (list int)))
              (split_spaces "inc bare red green blue first_k second_k pick wide odd semi after_div Shape Box")))

(def test_header () int
  (add (check_strs "header" (.header (lib_a))
                   (cons "a.l0 -- the first library. It has two sentences." (cons "More header." (nil (list int)))))
       (check_str "summary" (lib_summary (lib_a)) "the first library.")))

(def test_block_above () int
  (check_str "inc" (q_a "inc") "lib/a.l0: inc ((n int)) int\n  Adds one to n. Really.\n"))

(def test_blank_line_cuts_block () int
  (check_str "bare" (q_a "bare") "lib/a.l0: bare ((n int)) int\n"))

(def test_divider_documents_nothing () int
  (check_str "after_div" (q_a "after_div") "lib/a.l0: after_div () int\n"))

(def test_header_documents_nothing () int
  (check_str "b's inc" (doc_query "inc" (cons (lib_of "lib/b.l0" (src_b)) (nil Lib)))
             "lib/b.l0: inc ((n int)) int\n"))

(def test_group_shares_block () int
  (check_str "blue" (q_a "blue") "lib/a.l0: blue () int\n  The colors, as 0xRRGGBB.\n"))

(def test_group_member_with_own_comment () int
  (check_str "green" (q_a "green") "lib/a.l0: green () int\n  The colors, as 0xRRGGBB.\n  0x00FF00\n"))

; first_k has no block, so its comment is its own and second_k shares nothing.
(def test_first_line_comment () int
  (add (check_str "first_k" (q_a "first_k") "lib/a.l0: first_k () int\n  one\n")
       (check_str "second_k" (q_a "second_k") "lib/a.l0: second_k () int\n")))

(def test_comment_after_form_starts_block () int
  (check_str "semi" (q_a "semi") "lib/a.l0: semi () (list int)\n  A semicolon in a string.\n  the semicolon\n"))

; ------------------------------------------------------------ signatures

(def test_generic_signature () int
  (check_str "pick" (q_a "pick") "lib/a.l0: (pick T) ((a T) (b T)) T\n  Generic.\n"))

(def test_wrapped_signature_joined () int
  (check_str "wide" (q_a "wide") "lib/a.l0: wide ((a int) (b int) (c int)) int\n  Wrapped.\n"))

(def test_wrapped_signature_with_body () int
  (check_str "odd" (q_a "odd") "lib/a.l0: odd ((a int)\n  Wrapped, with its body after.\n"))

(def test_cut_ignores_strings () int
  (add (check_str "code" (code_of "(def s () (list int) \";\\\"\")  ; c") "(def s () (list int) \";\\\"\")")
       (check_str "comment" (trail_of "(def s () (list int) \";\\\"\")  ; c") "c")))

; ------------------------------------------------------------ data types

(def test_data_in_full () int
  (check_str "Shape" (q_a "Shape")
             "lib/a.l0: (data Shape (Circle int) (Rect int int))\n  A shape.\n  (data Shape\n    (Circle int)                    ; radius\n    (Rect int int))                 ; w, h\n"))

(def test_constructor_finds_type () int
  (check_str "Rect" (q_a "Rect") (q_a "Shape")))

; Box is the type and its constructor, and shown once.
(def test_generic_data () int
  (add (check_str "Box" (q_a "Box") "lib/a.l0: (data (Box T) (Box T))\n  A box of anything.\n")
       (check_strs "ctors" (.ctors (head (named "Shape" (libs_a) (nil Entry)))) (split_spaces "Circle Rect"))))

; A data type whose fields are named, one of them a list.
(def libs_fields () (list Lib)
  (cons (lib_of "lib/f.l0" "; f.l0 -- fields.\n; A process.\n(data Proc (Proc (pid int) (ctx (list int))))\n") (nil Lib)))

; A field's name finds its type; list, which opens a ( there too, does not.
(def test_named_field_finds_type () int
  (add (check_strs "pid" (names (named "pid" (libs_fields) (nil Entry)) (nil (list int))) (split_spaces "Proc"))
       (check_strs "list" (names (named "list" (libs_fields) (nil Entry)) (nil (list int))) (nil (list int)))))

; ---------------------------------------------------------------- queries

(def test_list_everything () int
  (check_str "all" (doc_query "" (libs_ab))
             (append "== lib/a.l0: the first library.\nlib/a.l0: inc \xe2\x80\x94 Adds one to n.\nlib/a.l0: red \xe2\x80\x94 The colors, as 0xRRGGBB.\nlib/a.l0: green \xe2\x80\x94 0x00FF00\nlib/a.l0: blue \xe2\x80\x94 The colors, as 0xRRGGBB.\nlib/a.l0: first_k \xe2\x80\x94 one\n"
             (append "lib/a.l0: pick \xe2\x80\x94 Generic.\nlib/a.l0: wide \xe2\x80\x94 Wrapped.\nlib/a.l0: odd \xe2\x80\x94 Wrapped, with its body after.\nlib/a.l0: semi \xe2\x80\x94 the semicolon\nlib/a.l0: Shape \xe2\x80\x94 A shape.\nlib/a.l0: Box \xe2\x80\x94 A box of anything.\n"
                     "\n== lib/b.l0: the second library.\n"))))

(def test_name_in_several_files () int
  (check_str "inc" (doc_query "inc" (libs_ab))
             "lib/a.l0: inc ((n int)) int\n  Adds one to n. Really.\n\nlib/b.l0: inc ((n int)) int\n"))

(def test_file_by_stem () int
  (check_str "b" (doc_query "b" (libs_ab)) "== lib/b.l0\n  b.l0 -- the second library.\n\nlib/b.l0: inc ((n int)) int\n"))

; A group together, its block once.
(def test_file_groups () int
  (check_str "c" (doc_query "c" (cons (lib_of "lib/c.l0" (src_c)) (nil Lib)))
             "== lib/c.l0\n  c.l0 -- colors.\n\nlib/c.l0: red () int\n  The colors.\nlib/c.l0: green () int\n  green\n\nlib/c.l0: other () int\n"))

(def test_search_ignores_case () int
  (check_str "COLORS" (q_a "COLORS")
             "Nothing is named COLORS; these mention it:\n  lib/a.l0: red \xe2\x80\x94 The colors, as 0xRRGGBB.\n  lib/a.l0: green \xe2\x80\x94 0x00FF00\n  lib/a.l0: blue \xe2\x80\x94 The colors, as 0xRRGGBB.\n"))

(def test_search_names () int
  (add (check_str "wid" (q_a "wid") "Nothing is named wid; these mention it:\n  lib/a.l0: wide \xe2\x80\x94 Wrapped.\n")
       (check_str "bar" (q_a "bar") "Nothing is named bar; these mention it:\n  lib/a.l0: bare\n")))

(def test_search_finds_nothing () int
  (check_str "zebra" (q_a "zebra") "Nothing is named or mentions zebra.\n"))

; Two files with one stem, as the compositor and its protocol have.
(def libs_wm () (list Lib)
  (cons (lib_of "user/lib/proto/wm.l0" "; wm.l0 -- the protocol.\n")
        (cons (lib_of "user/sbin/wm/wm.l0" "; wm.l0 -- the compositor.\n") (nil Lib))))

(def test_stem_of_several_files () int
  (check_str "wm" (doc_query "wm" (libs_wm))
             "Several files are wm; name one by more of its path, its directory and stem:\n  user/lib/proto/wm.l0: the protocol.\n  user/sbin/wm/wm.l0: the compositor.\n"))

(def test_file_by_end_of_path () int
  (add (check_str "proto/wm" (doc_query "proto/wm" (libs_wm)) "== user/lib/proto/wm.l0\n  wm.l0 -- the protocol.\n\n")
       (check_str "sbin/wm/wm.l0" (doc_query "sbin/wm/wm.l0" (libs_wm)) "== user/sbin/wm/wm.l0\n  wm.l0 -- the compositor.\n\n")))

; The compositor as a program, with the def named after it and one more.
(def prog_wm () (list Lib)
  (cons (lib_of "user/sbin/wm/wm.l0"
                "; wm.l0 -- the compositor.\n\n; Runs it.\n(def wm () int 0)\n\n; Where a window opens.\n(def cascade () int 1)\n")
        (nil Lib)))

(def proto_wm () (list Lib)
  (cons (lib_of "user/lib/proto/wm.l0" "; wm.l0 -- the protocol.\n\n; Asks.\n(def wm_ask () int 2)\n") (nil Lib)))

; A library's file comes before a program's def of the same name.
(def test_library_file_before_program_name () int
  (check_str "wm" (doc_query_in "wm" (proto_wm) (prog_wm))
             "== user/lib/proto/wm.l0\n  wm.l0 -- the protocol.\n\nuser/lib/proto/wm.l0: wm_ask () int\n  Asks.\n"))

(def test_program_file_and_name () int
  (add (check_str "file" (doc_query_in "sbin/wm/wm" (proto_wm) (prog_wm))
                  "== user/sbin/wm/wm.l0\n  wm.l0 -- the compositor.\n\nuser/sbin/wm/wm.l0: wm () int\n  Runs it.\n\nuser/sbin/wm/wm.l0: cascade () int\n  Where a window opens.\n")
       (check_str "name" (doc_query_in "cascade" (proto_wm) (prog_wm))
                  "user/sbin/wm/wm.l0: cascade () int\n  Where a window opens.\n")))

; A search finds the libraries' first, then the programs'; a listing is
; of the libraries alone.
(def test_search_and_list_programs () int
  (add (check_str "search" (doc_query_in "ASK" (proto_wm) (prog_wm))
                  "Nothing is named ASK; these mention it:\n  user/lib/proto/wm.l0: wm_ask \xe2\x80\x94 Asks.\n")
       (check_str "list" (doc_query_in "" (proto_wm) (prog_wm))
                  "== user/lib/proto/wm.l0: the protocol.\nuser/lib/proto/wm.l0: wm_ask \xe2\x80\x94 Asks.\n")))

(def test_files_split_at_sep () int
  (let ps (split_spaces "a.l0 b.l0 -- c.l0")
    (add (check_strs "libraries" (before_sep ps (nil (list int))) (split_spaces "a.l0 b.l0"))
         (add (check_strs "programs" (after_sep ps) (split_spaces "c.l0"))
              (check_strs "none" (after_sep (split_spaces "a.l0")) (nil (list int)))))))

; The end of a path names a file only at a /: m is not wm.
(def test_end_of_path_at_slash () int
  (check_str "m" (doc_query "m" (libs_wm)) "Nothing is named or mentions m.\n"))

; ---------------------------------------------------------------- checking

; bare follows a blank line, second_k a form with no block, after_div a
; divider, and b's inc its header.
(def test_gaps () int
  (check_str "gaps" (rev (emit_gaps (gaps (libs_ab) (nil Entry)) (nil int)))
             "lib/a.l0 bare\nlib/a.l0 second_k\nlib/a.l0 after_div\nlib/b.l0 inc\n"))

; bare is on line 11: the header's two, a blank, the divider, a blank,
; inc's three, a blank, and the cut-off block's two.
(def test_entry_line () int
  (check_str "bare" (digits (.line (head (named "bare" (libs_a) (nil Entry))))) "11"))

; The list, with a comment, a blank line, and a line indented.
(def list_all () (list (list int))
  (cons "; the gaps" (cons "" (cons "lib/a.l0 bare" (cons "  lib/a.l0 second_k" (cons "lib/a.l0 after_div" (cons "lib/b.l0 inc" (nil (list int)))))))))

(def test_check_every_gap_listed () int
  (match (check_libs "gaps.txt" (list_all) (libs_ab))
    ((Ok out) (check_str "out" out ""))
    ((Err why) (fail_because "check" why))))

(def test_check_new_gap () int
  (match (check_libs "gaps.txt" (take (list_all) 5) (libs_ab))
    ((Ok out) (fail_because "check" "passed b's inc, which the list does not name"))
    ((Err why) (check_str "why" why "make doc reads the ; block above each form; document these:\nlib/b.l0:2: inc is not documented"))))

(def test_check_stale_gap () int
  (match (check_libs "gaps.txt" (cons "lib/a.l0 inc" (list_all)) (libs_ab))
    ((Ok out) (fail_because "check" "passed a's inc, which is documented"))
    ((Err why) (check_str "why" why "make doc reads the ; block above each form; document these:\nlib/a.l0 inc: documented now, or gone; take it off gaps.txt, as make doc-prune does"))))

; Pruning keeps the comment, the blank line and the indented line as they
; were, and takes off only a's inc, which is documented.
(def test_prune () int
  (check_str "pruned"
             (rev (pruned (cons "lib/a.l0 inc" (list_all))
                          (key_set (gap_keys (gaps (libs_ab) (nil Entry)) (nil (list int))) ((MapEmpty (list int) bool)))
                          (nil int)))
             "; the gaps\n\nlib/a.l0 bare\n  lib/a.l0 second_k\nlib/a.l0 after_div\nlib/b.l0 inc\n"))

; A header must name its own file.
(def test_check_header () int
  (match (check_libs "gaps.txt" (nil (list int)) (cons (lib_of "lib/h.l0" "; other.l0 -- not this one.\n") (nil Lib)))
    ((Ok out) (fail_because "check" "passed a header naming another file"))
    ((Err why) (check_str "why" why "make doc reads the ; block above each form; document these:\nlib/h.l0:1: no header, ; h.l0 -- summary"))))

; ---------------------------------------------------------------- reading

(def test_stem () int
  (add (check_str "path" (stem "user/lib/ui/widget.l0") "widget")
       (check_str "bare" (stem "l0s.l0") "l0s")))

(def test_missing_file () int
  (match (l0sdoc (cons "x" (cons "tools/l0sdoc/no_such_file.l0" (nil (list int)))))
    ((Ok out) (fail_because "missing" "read a file that is not there"))
    ((Err why) (check_str "why" why "tools/l0sdoc/no_such_file.l0: no such file"))))

(def test_usage () int
  (match (l0sdoc (nil (list int)))
    ((Ok out) (fail_because "usage" "ran with no query"))
    ((Err why) (check_str "why" why (usage)))))

(def test_check_needs_a_list () int
  (match (l0sdoc (cons "--check" (nil (list int))))
    ((Ok out) (fail_because "usage" "checked with no list"))
    ((Err why) (check_str "why" why (usage)))))

(def test_missing_list () int
  (match (l0sdoc (cons "--check" (cons "tools/l0sdoc/no_such_list.txt" (nil (list int)))))
    ((Ok out) (fail_because "missing" "read a list that is not there"))
    ((Err why) (check_str "why" why "tools/l0sdoc/no_such_list.txt: no such file"))))
