# What tests/launcher-install.sh boots: the demo's first stage, boot,
# the display and input drivers, and the disk's driver and file server,
# for a system volume made from this very initramfs. boot makes it /, and
# starts its /etc/system: a serial shell and the compositor.
start /sbin/boot
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
dev /sbin/virtio-blk
