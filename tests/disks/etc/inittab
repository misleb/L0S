# What tests/disks.sh, tests/partitions.sh and tests/files.sh boot: the
# demo's drivers, its compositor and its serial shell, without the vt
# windows; the clock, whose time a new partition's UUID begins with; and
# the disk's driver and file server, for Disks and Files to show.
start /bin/sh
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/wm
start /sbin/rtc clock
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/rtc
dev /sbin/virtio-gpu
dev /sbin/virtio-input
dev /sbin/virtio-blk
