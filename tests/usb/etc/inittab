# The screen tests' desktop with USB's keyboard and mouse in place of
# virtio's: pcie sets the bus up, xhci the controller and its devices,
# and a usb-hid of each kind serves keyboard and pointer, as virtio-input
# does. Boot it with QEMU_INPUT=usb (tools/qemu-boot.sh), as
# tests/usb.sh does; make usb-initramfs makes it.
start /bin/sh
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid keyboard
start /sbin/usb-hid mouse
start /sbin/wm
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/pcie
dev /sbin/xhci
