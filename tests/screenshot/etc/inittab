# What tests/screenshot.sh boots: the demo's display, clock, disk and
# USB, the keyboard, the tablet and QEMU's usb-audio speaker on a
# qemu-xhci, and boot, which starts /etc/system: the shell, the
# compositor and the audio server, with no window, no network and no
# agent.
start /sbin/boot
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/rtc clock
start /sbin/virtio-blk
start /sbin/fs
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid
dev /sbin/uart
dev /sbin/rtc
dev /sbin/virtio-gpu
dev /sbin/virtio-blk
dev /sbin/pcie
dev /sbin/xhci
