# What tests/installer.sh boots: the demo's drivers, its compositor and
# its serial shell, without the vt windows; the disk's driver and file
# server, for the volumes the Installer writes; and the network, to the
# proxy tools/api-proxy/e2e_serve.py runs on the host, serving
# tests/e2e/install_net's release, which agent/config names at
# 10.0.2.2 on the port the test gives it.
start /bin/sh
start /sbin/uart
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/font
start /sbin/wm
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
dev /sbin/virtio-blk
dev /sbin/virtio-net
