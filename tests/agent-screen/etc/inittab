# tests/agent.sh's board: the desktop, as tests/screen's, with no vt
# windows, and the agent's: the disk's data volume for agentd's home,
# virtio-net and inet for the network. On the host, agent.sh runs
# tools/api-proxy/e2e_serve.py on tests/agent-screen: the stand-in for
# the Messages API, answering from its script.json, and the proxy in
# front of it, which builds apps by fake_claude.py, painting the case's
# preview.png as the scene main first.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/font
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet
start /sbin/agentd
start /sbin/wm
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
dev /sbin/virtio-blk
dev /sbin/virtio-net
