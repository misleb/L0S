# Booting with root= of a UUID no partition has (typed): boot waits for
# fs to mount it, in vain, says so, and starts the initramfs's own
# /etc/system, the shell, on the initramfs, which is / still, and keeps
# refusing what changes it.
start /sbin/boot
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
