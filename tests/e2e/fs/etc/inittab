# The file system on a fresh disk (typed): fs mounts its two volumes,
# and the shell's commands write a file, read it back, with cat and with
# a program, add to it, copy, move and remove it, are refused a write to
# the initramfs, and empty a volume; df and ls show what is there.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
