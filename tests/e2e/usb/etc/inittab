# USB on QEMU's virt board (usb: a qemu-xhci with a usb-kbd and a
# usb-mouse): pcie puts the xHCI's BAR in the MMIO window, xhci brings
# it up and both devices with it, and one usb-hid claims both; lsusb,
# typed, lists them, and ps shows usb-hid waiting on its three ports.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid
dev /sbin/uart
dev /sbin/pcie
dev /sbin/xhci
