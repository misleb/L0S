# USB on QEMU's virt board (usb: a qemu-xhci with a usb-kbd and a
# usb-mouse): pcie puts the xHCI's BAR in the MMIO window, xhci brings
# it up and both devices with it, and a usb-hid of each kind claims its
# own; lsusb, typed, lists them.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid keyboard
start /sbin/usb-hid mouse
dev /sbin/uart
dev /sbin/pcie
dev /sbin/xhci
