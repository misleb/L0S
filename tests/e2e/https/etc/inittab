# HTTPS (typed): http over TLS 1.3 to a small server on the host
# (server.py, on a free port, @PORT@), reached through QEMU's user
# network at 10.0.2.2. Its certificate is checked to the case's one root,
# its own test CA in /etc/ssl/roots.pem, for the address, by the date
# rtc clock gives; virtio-rng gives the keys' randomness. http fetches a
# page, the same with its head, 300 lines over several records, a page
# that is not there, a POST of JSON read back as JSON, and a port nothing
# listens to, which refuses.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
start /sbin/virtio-rng
start /sbin/rtc clock
dev /sbin/uart
dev /sbin/virtio-net
dev /sbin/virtio-rng
dev /sbin/rtc
