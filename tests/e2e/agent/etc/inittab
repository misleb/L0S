# The agent at the console (typed): virtio-blk and fs give the disk's
# data volume, /Volumes/data, which holds agentd's home; virtio-net and
# inet the network; agentd starts after them. On the host, e2e.sh runs
# tools/api-proxy/e2e_serve.py (serve): the stand-in for the Messages
# API, answering from script.json and checking each request as
# checks.json says (each tool_use answered by its tool_result, in order;
# the cache breakpoints; the home's CLAUDE.md in the system prompt),
# and the proxy in front of it on @PORT@, which agent/config names at
# 10.0.2.2. run agent says one line, to which the script answers with
# tools in three rounds, make_dir and write_file, list_dir and run
# hello, sh and read_file, and then a text; then /exit, and the shell
# shows the file the agent wrote and its home, with CLAUDE.md made from
# agent/CLAUDE.md, the default rules.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet
start /sbin/agentd
dev /sbin/uart
dev /sbin/virtio-blk
dev /sbin/virtio-net
