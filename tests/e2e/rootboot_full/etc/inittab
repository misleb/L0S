# Booting from a system volume full of other files (typed): System,
# filled from this initramfs and the 3,000 files filler adds, 300
# directories of 10 in /etc/filler, booted with root=. The shell's
# commands look for programs in /bin, /sbin and /Applications only, so
# each takes as long as on a volume without them: a walk of the whole
# volume for each would not finish them in the case's two minutes.
start /sbin/boot
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
