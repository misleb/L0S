# The disk driver on a read-only disk: QEMU's drive is readonly=on, the
# device offers VIRTIO_BLK_F_RO, and the driver refuses a write itself,
# saying why, rather than have the device fail it. disk, pid 1, exits 1,
# and the system with it.
start /bin/disk write 1 hello
start /sbin/virtio-blk
dev /sbin/virtio-blk
