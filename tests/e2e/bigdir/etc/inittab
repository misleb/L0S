# A directory too big to list in one message (typed): 80 directories of
# long names in a RAM volume, whose listing is about 4,240 bytes, so fs
# answers list a page at a time and fs_list asks until it has them all.
# ls shows every one, in order.
start /bin/sh
start /sbin/uart noecho
start /sbin/fs ram
dev /sbin/uart
