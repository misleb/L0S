# Directories on a volume (typed): the shell makes them, nested, writes,
# lists, moves and removes in them, is refused what cannot be, and runs a
# program copied onto a volume from it, its copy marked a program.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
