# The font service (font), asked by fonts, typed at the shell: its faces,
# and the twelve strikes the build made, which it keeps as it starts and
# counts as none it built; then Source Sans 3 at 24 asked twice, by two
# processes, built once and shared with both, a strike kept shared, and a
# face it has not.
start /bin/sh
start /sbin/uart noecho
start /sbin/font
dev /sbin/uart
