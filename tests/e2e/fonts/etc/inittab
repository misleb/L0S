# The font service (font), asked by fonts, typed at the shell: its faces
# from /etc/fonts and the four strikes it makes before it registers;
# then Source Sans 3 at 32 asked twice, by two processes, built once and
# shared with both, a strike made already shared, and a face it has not.
start /bin/sh
start /sbin/uart noecho
start /sbin/font
dev /sbin/uart
