# The SD card's driver (sd: a blank 64 MB card in a sdhci-pci on PCIe):
# pcie sets the bus up, and sdhci brings the card up and serves it as
# disk0, there being no other disk. Typed: the disks listed, a sector
# written and read back, past the end refused, and the last sector read.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
start /sbin/sdhci pci
dev /sbin/uart
dev /sbin/pcie
dev /sbin/sdhci
