# install onto an empty volume (typed): every directory and file of the
# initramfs copied onto System, of a disk of 16 MB whose layout gives its
# partition a UUID, which install says, for root=; and a program run from
# its copy there.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
