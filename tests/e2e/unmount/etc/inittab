# Unmounting a volume (typed): fs mounts the fresh disk's two volumes,
# a file is written on scratch, and unmount takes scratch away: fs stops
# serving it and the kernel unmounts it, so df and ls show data alone,
# and the file is in no volume. scratch cannot be unmounted again, nor
# what is not a volume.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
