# install --boot (typed): BOOT, a FAT32 volume tools/mkfs made, made a
# Raspberry Pi 5's boot partition from stand-ins for the Pi's /boot, in
# /etc/boot here, since QEMU's initramfs has none: its files copied, and
# input.bin, an initramfs of the system running, written beside them,
# with a note that the card needs the Pi's device trees. Then refused
# with no boot files, and onto no volume.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
