# The disk driver on a fresh disk (typed): disk shows its size and its
# first sector, the GPT's protective MBR, as mkdisk made it, writes a
# sector and reads it back, reads the last a partition may use, empty,
# and is refused one past the disk's end. The last 33 sectors, the GPT's
# backup, hold its UUIDs, which differ every run, so are not shown.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
dev /sbin/uart
dev /sbin/virtio-blk
