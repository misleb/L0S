# fetch_url, agentd's own way to the internet (typed): as the agent
# case, the stand-in for the API and the proxy in front of it on the
# host (serve), agentd's home on the disk's data volume, and virtio-rng
# and rtc clock for TLS's keys and date. The script answers run agent's
# one line with fetch_url twice: a GET of a page the proxy does not
# serve, over plain HTTP, whose 404 and JSON body come back as the
# tool's answer; and an https:// URL on the same port, where the proxy
# answers the ClientHello as plain HTTP, so the handshake fails and the
# tool says why. Then a text, and /exit.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet
start /sbin/virtio-rng
start /sbin/rtc clock
start /sbin/agentd
dev /sbin/uart
dev /sbin/virtio-blk
dev /sbin/virtio-net
dev /sbin/virtio-rng
dev /sbin/rtc
