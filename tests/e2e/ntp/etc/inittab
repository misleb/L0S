# The time from the network (typed): virtio-net drives the card, on
# QEMU's user network, inet is the stack at QEMU's defaults, and rtc
# clock serves the PL031's time. A stand-in SNTP server on the host
# (server.py, which e2e.sh starts on a free port, @PORT@ here) is reached
# through the gateway, 10.0.2.2, and always answers 2030-01-01 12:00 UTC:
# ntp asks it, has rtc clock take it, and says so on standard error,
# which the case's stderr holds. The shell waits 3 seconds for that,
# then exits.
start /bin/sh
start /sbin/uart noecho
start /sbin/rtc clock
start /sbin/virtio-net
start /sbin/inet
start /sbin/ntp 10.0.2.2:@PORT@
dev /sbin/uart
dev /sbin/rtc
dev /sbin/virtio-net
