# The PCIe bus's server on QEMU's virt board (usb: with a qemu-xhci on
# it): ps, typed, shows it waiting on its port, so it read the ECAM,
# found the host bridge and the xHCI, 1b36:0008 and 1b36:000d, put the
# xHCI's BAR in the MMIO window, and registered as pci.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
dev /sbin/uart
dev /sbin/pcie
