# USB audio on QEMU's virt board (usb, usbaudio: a qemu-xhci with a
# usb-kbd, a usb-mouse and a usb-audio, a speaker): xhci brings all
# three up, usb-hid claims the keyboard and the mouse, and usb-audio
# reads the speaker's audio function and serves mic. rec list, typed,
# lists its one stream, out; rec silence sends it half a second of
# silence, its isochronous packets, one a millisecond, counted; and rec
# of a file says there is no microphone.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid
start /sbin/usb-audio
dev /sbin/uart
dev /sbin/pcie
dev /sbin/xhci
