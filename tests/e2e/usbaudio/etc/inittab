# USB audio on QEMU's virt board (usb, usbaudio: a qemu-xhci with a
# usb-kbd, a usb-mouse and a usb-audio, a speaker): xhci brings all
# three up, usb-hid claims the keyboard and the mouse, audio serves,
# and usb-audio reads the speaker's audio function and attaches it to
# audio as usb-46f4:0002-speaker, the first output, on which the server
# plays the chime (chime: build/chime.wav as /etc/chime.wav), said in
# the log (stderr). sound, typed, lists the speaker, the default
# output; play plays a 16 kHz chirp through the server, brought up to
# 48 kHz and fed to the speaker's isochronous endpoint from a ring; and
# rec of a file says there is no input.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid
start /sbin/audio
start /sbin/usb-audio
dev /sbin/uart
dev /sbin/pcie
dev /sbin/xhci
