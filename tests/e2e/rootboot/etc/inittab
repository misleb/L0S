# Booting from a system volume (typed): the disk's System, filled from
# this very initramfs, and booted with root= and its partition's UUID.
# boot, pid 1, waits for fs to mount it, makes it /, and starts its
# /etc/system, the shell; what the shell writes outside /Volumes is then
# on System, and its programs are run from there.
start /sbin/boot
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
