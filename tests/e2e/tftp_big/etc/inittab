# A file of many blocks over TFTP to a volume (typed): tftp fetches
# 70400 bytes, 138 blocks, from QEMU's TFTP server at the gateway, and
# writes them to the RAM volume as they come, 64 KB and then the rest;
# df shows the file there, its size in clusters. Fetched again of a
# file the server does not have, it says so and leaves no file behind.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
start /sbin/fs ram
dev /sbin/uart
dev /sbin/virtio-net
