# HTTP over TCP (typed): virtio-net drives the card, on QEMU's user
# network, and inet is the stack at QEMU's defaults. A small server on the
# host (server.py, which e2e.sh starts on a free port, @PORT@ in the typed
# lines) is reached through the gateway, 10.0.2.2. http fetches a page,
# the same one with its header, one of 300 lines that is more than a
# window holds, a page that is not there (the body is written, and the
# status said), and a port nothing listens to, which refuses; net then
# shows no connection is left.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
dev /sbin/uart
dev /sbin/virtio-net
