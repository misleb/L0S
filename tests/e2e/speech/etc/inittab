# The speech service, heard into the agent (roadmap 0061): as the agent
# case, virtio-blk and fs give the disk's data volume, which holds
# agentd's home, and virtio-net and inet the network to the host's
# stand-in model (serve, e2e_serve.py, answering from script.json and
# checking as checks.json says); then speech, Whistle read from
# /etc/whistle.cact, which e2e.sh adds to the case's etc since the case
# has a whistle file. The shell (typed) has speech hear /etc/clip.wav,
# 4 s of the Yeti Nano's speech recorded through QEMU, as a phrase: its
# text said to agentd as say speech, whose first request must hold it
# after its source line; then, once the turn is done, shows the
# conversation agentd kept.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet
start /sbin/agentd
start /sbin/speech -m /etc/whistle.cact
dev /sbin/uart
dev /sbin/virtio-blk
dev /sbin/virtio-net
