# The network by DHCP (typed): virtio-net drives the card, on a QEMU user
# network that is not 10.0.2.0/24 but 192.168.7.0/24, whose DHCP server
# offers 192.168.7.50, with 192.168.7.2 as its router, so that what inet
# is at can only have come from the server. inet dhcp broadcasts its
# DISCOVER, requests the offer, and registers once the ACK has given it
# its address; net shows the interface, pings the router, which ARP finds
# first, and shows what ARP found.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet dhcp
dev /sbin/uart
dev /sbin/virtio-net
