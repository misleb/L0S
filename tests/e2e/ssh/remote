#!/bin/sh
# The ssh case's forced command (sshd_config): the command the client
# asked for, run by /bin/sh in the case's scratch directory, or, with
# none, an interactive /bin/sh with a plain prompt and nothing of the
# user's environment but what it needs.
cd "$(dirname "$0")/../../../build/e2e/ssh.remote" || exit 1
if [ -n "$SSH_ORIGINAL_COMMAND" ]; then
  exec /bin/sh -c "$SSH_ORIGINAL_COMMAND"
fi
exec env -i PATH=/usr/bin:/bin HOME="$PWD" PS1='$ ' TERM="$TERM" /bin/sh -i
