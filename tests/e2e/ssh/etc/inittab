# SSH (typed): ssh and scp to the host's own sshd (serve, sshd_config),
# run as the user on a free port, @PORT@, reached through QEMU's user
# network at 10.0.2.2. The host's key is in /etc/ssh/known_hosts, and
# the user's Ed25519 key, the one the server knows, in
# /etc/ssh/id_ed25519; virtio-rng gives the keys' randomness. ssh runs a
# command; one that writes to standard error and exits 3; a shell on a
# pty, a line typed to it and its exit; then scp copies a file up from
# the initramfs, which ssh shows, and one down to the disk's volume,
# which cat shows; and ssh to a port nothing listens to is refused.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
start /sbin/virtio-rng
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-net
dev /sbin/virtio-rng
dev /sbin/virtio-blk
