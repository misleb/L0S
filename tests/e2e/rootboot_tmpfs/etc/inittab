# Booting from the RAM file system (typed): fs ram serves tmp, boot has
# install copy this initramfs onto it with root=tmpfs, makes it /, and
# starts its /etc/system, the shell: / can be written, and its programs
# are run from the copy, though no disk is on the board.
start /sbin/boot
start /sbin/uart noecho
start /sbin/fs ram
dev /sbin/uart
