# A TCP server (typed): virtio-net drives the card, on QEMU's user
# network, with a forward from a port of the host's loopback (@PORT@, which
# e2e.sh chooses) to port 7000 of the board, and inet is the stack. net
# echo listens to 7000, takes the connection peer.py makes from the host,
# which sends 12000 bytes and then closes its end, sends everything back,
# and says how much; peer.py checks that it came back whole. net then shows
# no connection is left.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
dev /sbin/uart
dev /sbin/virtio-net
