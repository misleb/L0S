# The network (typed): virtio-net drives the card, on QEMU's user
# network, and inet is the stack, at QEMU's defaults, 10.0.2.15/24 behind
# 10.0.2.2. net shows the interface, pings the gateway, which ARP finds
# first, and shows what ARP found; tftp fetches a file of one block and
# one of four full blocks, then an empty one, from QEMU's TFTP server at
# the gateway, and is told of a file it does not have; net pings inet's
# own address, which goes no further than inet.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
dev /sbin/uart
dev /sbin/virtio-net
