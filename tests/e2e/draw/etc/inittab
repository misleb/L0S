# Drawing from the shell (typed): the display driver and the compositor
# stay running, and draw sends the compositor commands for the desktop,
# good and bad.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/font
start /sbin/wm
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
