# Drawing from the shell (typed): the display driver and the compositor
# stay running, and draw sends the compositor commands for the desktop,
# good and bad.
start /bin/sh
start /bin/uart noecho
start /bin/virtio-gpu
start /bin/virtio-input keyboard
start /bin/virtio-input tablet
start /bin/wm
dev /bin/uart
dev /bin/virtio-gpu
dev /bin/virtio-input
