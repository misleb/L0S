# A driver started from the system volume (typed), as the Pi 5's
# release starts all but its first stage: booted with root=, boot makes
# the disk's System / and starts its /etc/system, the shell and
# virtio-rng, from the volume's files. The dev line lets virtio-rng
# drive the entropy device though boot started it from a volume, so
# random, run at the shell, gets its bytes; the filter makes them a ~.
start /sbin/boot
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
dev /sbin/virtio-rng
