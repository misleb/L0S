L0S shell, on an L0 microkernel. Type help for the commands.
l0s> l0s>   bootfs/
l0s>   Applications/
  bin/
  etc/
  sbin/
l0s> # A card as Raspberry Pi's Imager partitions one (typed): an MBR, not a
# GPT, and bootfs on it, FAT32 of type 0C, filled from the initramfs by
# tools/mkfs. fs serves it as any volume; its files are read, config.txt
# written and read back; and a partition is refused, L0S making none in
# an MBR.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
