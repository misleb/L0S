# The display driver serving display, the input drivers, the compositor
# on them, and one terminal in a window, with the shell it starts
# (typed): windows lists the window and the pointer.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/wm
start /Applications/Terminal.app/vt
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
