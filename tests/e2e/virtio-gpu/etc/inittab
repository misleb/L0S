# The display driver serving display, the input drivers, the compositor
# on them, and one terminal in a window, with the shell it starts
# (typed): windows lists the window and the pointer.
start /bin/sh
start /bin/uart noecho
start /bin/virtio-gpu
start /bin/virtio-input keyboard
start /bin/virtio-input tablet
start /bin/wm
start /bin/vt
dev /bin/uart
dev /bin/virtio-gpu
dev /bin/virtio-input
