# Names (typed): virtio-net drives the card, on QEMU's user network, and
# inet is the stack at QEMU's defaults, whose name server is 10.0.2.3,
# as net dns says. A small name server on the host (server.py, which
# e2e.sh starts on a free port, @PORT@ in the typed lines) is reached
# through the gateway, 10.0.2.2: net resolve asks it for a name with an
# address, one that is an alias of it, one with no address, and one it
# does not know; and an address needs no asking at all.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-net
start /sbin/inet
dev /sbin/uart
dev /sbin/virtio-net
