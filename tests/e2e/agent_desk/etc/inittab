# The agent's tools of the desktop and the clock (typed): the display
# driver, the input drivers, the font service and the compositor, the
# disk and the network as in the agent case, rtc as the clock, and
# agentd. run agent says one line, to which the script (script.json)
# answers with tools in three rounds: time and volumes; open_app Files,
# then windows, and draw_desktop of an SVG; place_window, raise_window
# and close_window of Files's window, 0, and clear_desktop; then a
# text. checks.json checks each result. Then run draw size asks the
# compositor, still serving, its size.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/font
start /sbin/wm
start /sbin/virtio-blk
start /sbin/fs
start /sbin/virtio-net
start /sbin/inet
start /sbin/rtc clock
start /sbin/agentd
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
dev /sbin/virtio-blk
dev /sbin/virtio-net
dev /sbin/rtc
