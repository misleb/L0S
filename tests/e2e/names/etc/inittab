# What each process serves (typed): ps and names agree that wm serves
# compositor and uart console; echo, run from the shell, serves echo,
# and once it is killed its name is gone.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/font
start /sbin/wm
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
