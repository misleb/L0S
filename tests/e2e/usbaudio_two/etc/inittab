# Two USB speakers on QEMU's virt board (usb, usbaudio, usbaudio2: a
# qemu-xhci with a usb-kbd, a usb-mouse and two usb-audio): usb-audio
# attaches the first speaker, the default output, and the server starts
# the chime on it (chime) at once, its lead being 0, asking usb-audio
# to start it while usb-audio asks to attach the second. usb-audio
# answers the server's start while it waits for its attach to be
# answered, so the chime plays and the second speaker is attached as
# usb-46f4:0002-speaker-2 (stderr), which sound, typed, lists beside the
# first. Waiting only for its answer, as usb-audio did, both waited for
# ever and sound with them, as on the Pi 5 with a Yeti Nano, a
# microphone and a speaker of one device.
start /bin/sh
start /sbin/uart noecho
start /sbin/pcie virt
start /sbin/xhci pci
start /sbin/usb-hid
start /sbin/audio
start /sbin/usb-audio
dev /sbin/uart
dev /sbin/pcie
dev /sbin/xhci
