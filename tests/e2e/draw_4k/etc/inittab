# Drawing from the shell (typed) on a 4K screen, which the desktop draws at
# scale 2: draw size says the desktop's pixels, 1920 by 1080, half the
# screen's each way, and a shape is given in them too.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-gpu
start /sbin/virtio-input keyboard
start /sbin/virtio-input tablet
start /sbin/wm
dev /sbin/uart
dev /sbin/virtio-gpu
dev /sbin/virtio-input
