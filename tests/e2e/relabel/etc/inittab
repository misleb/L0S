# Relabelling a volume (typed): fs mounts the fresh disk's two volumes,
# a file is written on scratch, and relabel makes scratch notes: fs
# writes its superblock and its partition's name, and the kernel mounts
# it at /Volumes/notes and no longer at /Volumes/scratch, so ls and df
# show data and notes, and the file is read from notes. A label served
# already is refused, as is one that is no label.
start /bin/sh
start /sbin/uart noecho
start /sbin/virtio-blk
start /sbin/fs
dev /sbin/uart
dev /sbin/virtio-blk
