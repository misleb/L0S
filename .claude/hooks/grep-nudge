#!/bin/sh
# grep-nudge -- a PreToolUse hook on Bash: when a command searches the
# tree (grep -r, rg, git grep), remind the agent of make doc and the
# knowledge graph, which answer "where is X" and "who calls X" in one
# call. It never blocks: the command runs either way.
cmd=$(jq -r '.tool_input.command // empty')
printf '%s\n' "$cmd" | grep -Eq '(^|[;&|(`]|\$\()[[:space:]]*(grep[[:space:]]+(-[A-Za-z]*[rR]|--recursive|--dereference-recursive)|rg[[:space:]]|git[[:space:]]+grep[[:space:]])' || exit 0
jq -n '{hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext:
  "This searches the tree. In L0S, `make -s doc Q=WORD` searches every form'"'"'s comment and names each def and type about WORD with its file and purpose, and `graphify explain \"NAME()\"` / `graphify affected \"NAME()\"` give callers, callees and what a change reaches, each edge with file:line (AGENTS.md, \"Learning the code\"). Use those to find code; grep is for exact strings, numbers and messages."}}'
