; icons.paths -- the toolkit's symbolic icons and the pointer as shapes,
; which tools/mkfont rasterizes for scale 2 (user/lib/ui/face.l0): the
; same icons as user/lib/ui/icons.l0's 16 by 16 art, drawn with smooth
; edges. Its language is tools/mkfont/shape.l0's. An icon is "icon NAME"
; then its shapes, on a grid of 16 whatever its size; the pointer is
; "cursor" then its shapes, each white or black, in the pointer's pixels
; at scale 1, its hot spot at 0, 0, the black drawn over the white; and
; another pointer is "cursor NAME", the same, its hot spot in its middle,
; where paint.l0's ui_cursor_hot_x and ui_cursor_hot_y say.

icon window-close
stroke 1.75 M 4.5 4.5 L 11.5 11.5
stroke 1.75 M 11.5 4.5 L 4.5 11.5

icon pan-down
stroke 2 M 3.5 6 L 8 10.5 L 12.5 6

icon pan-up
stroke 2 M 3.5 10 L 8 5.5 L 12.5 10

; A circle's arrow: round from the right, under, and up to the top,
; where its head points on.
icon view-refresh
arc 8 8.5 5 1.5 -10 270
fill M 8 1 L 11.5 3.5 L 8 6 Z

icon open-menu
rrect 3 4 10 2 1
rrect 3 7 10 2 1
rrect 3 10 10 2 1

icon system-search
ring 6.5 6.5 3.75 1.5
stroke 2 M 9.5 9.5 L 13.5 13.5

; A drive: its case, the line where its bay begins, and its light.
icon drive-harddisk
frame 1 3 14 10 2 1
rect 2 8 12 1
rect 11 10 2 1

; A terminal: its prompt, and the cursor after it.
icon utilities-terminal
stroke 1.5 M 2.5 4.5 L 5.75 7.75 L 2.5 11
rect 7 10.25 7 1.5

; A system monitor: a pulse, up and down across a level line.
icon utilities-system-monitor
stroke 1.25 M 0.5 7.5 H 2 L 4 3.5 L 7 11.5 L 9.5 7.5 H 15.5

; A grid of apps: three rows of three squares.
icon view-app-grid
rrect 0 0 4 4 0.75
rrect 6 0 4 4 0.75
rrect 12 0 4 4 0.75
rrect 0 6 4 4 0.75
rrect 6 6 4 4 0.75
rrect 12 6 4 4 0.75
rrect 0 12 4 4 0.75
rrect 6 12 4 4 0.75
rrect 12 12 4 4 0.75

; A folder: its tab, and the case under it, a line along the case's top.
icon folder
frame 1 3 14 11 1.5 1
fill M 1 4 L 1 2.75 Q 1 2 1.75 2 L 5.5 2 L 7 3.5 L 7 4 Z
rect 1 5 14 1

; A document: a page, its corner folded, and lines of text.
icon text-x-generic
frame 3 1 10 14 1 1
fill M 9 1 L 13 5 L 9 5 Z
rect 5 6 4 1
rect 5 8 6 1
rect 5 10 6 1
rect 5 12 5 1

; A program: a window, its title band, a prompt and a cursor.
icon application-x-executable
frame 2 2 12 10 1 1
rect 2 2 12 2
stroke 1 M 5.5 5.5 L 7.5 7.5 L 5.5 9.5
rect 9 9 4 1

; Back and forward: chevrons.
icon go-previous
stroke 2 M 10 4 L 6 8 L 10 12

icon go-next
stroke 2 M 6 4 L 10 8 L 6 12

; A list: three lines, each a dot and a bar.
icon view-list
rrect 1 3 2 2 0.5
rect 4 3 10 2
rrect 1 7 2 2 0.5
rect 4 7 10 2
rrect 1 11 2 2 0.5
rect 4 11 10 2

; A grid of four squares.
icon view-grid
rrect 1 1 6 6 1
rrect 9 1 6 6 1
rrect 1 9 6 6 1
rrect 9 9 6 6 1

; A computer: its screen, and the stand under it.
icon computer
frame 1 2 14 9 1.5 1
rect 6 11 4 1
rrect 4 12 8 1 0.5

; Adwaita's pointer: a black arrow edged white.
cursor
white fill M 0 0 L 11.5 11.5 L 7 11.5 L 9.8 16.6 L 7.4 17.6 L 4.7 12.3 L 0 15.8 Z
black fill M 1 2.4 L 9.1 10.5 L 5.4 10.5 L 8.4 16.1 L 7.9 16.3 L 4.9 10.7 L 1 13.6 Z

; The resize pointers: a black arrow with a head at both ends, edged
; white, across, up and down, and on the diagonals, each about its hot
; spot, in the middle of paint.l0's 1x art of it.
cursor ew-resize
white fill M 2.09 6.5 L 8 0.59 L 8 5 L 15 5 L 15 0.59 L 20.91 6.5 L 15 12.41 L 15 8 L 8 8 L 8 12.41 Z
black fill M 3.5 6.5 L 7 3 L 7 6 L 16 6 L 16 3 L 19.5 6.5 L 16 10 L 16 7 L 7 7 L 7 10 Z

cursor ns-resize
white fill M 6.5 2.09 L 12.41 8 L 8 8 L 8 15 L 12.41 15 L 6.5 20.91 L 0.59 15 L 5 15 L 5 8 L 0.59 8 Z
black fill M 6.5 3.5 L 10 7 L 7 7 L 7 16 L 10 16 L 6.5 19.5 L 3 16 L 6 16 L 6 7 L 3 7 Z

cursor nwse-resize
white fill M 2.84 2.84 L 11.21 2.84 L 8.09 5.96 L 13.04 10.91 L 16.16 7.79 L 16.16 16.16 L 7.79 16.16 L 10.91 13.04 L 5.96 8.09 L 2.84 11.21 Z
black fill M 3.84 3.84 L 8.79 3.84 L 6.67 5.96 L 13.04 12.33 L 15.16 10.21 L 15.16 15.16 L 10.21 15.16 L 12.33 13.04 L 5.96 6.67 L 3.84 8.79 Z

cursor nesw-resize
white fill M 2.84 16.16 L 2.84 7.79 L 5.96 10.91 L 10.91 5.96 L 7.79 2.84 L 16.16 2.84 L 16.16 11.21 L 13.04 8.09 L 8.09 13.04 L 11.21 16.16 Z
black fill M 3.84 15.16 L 3.84 10.21 L 5.96 12.33 L 12.33 5.96 L 10.21 3.84 L 15.16 3.84 L 15.16 8.79 L 13.04 6.67 L 6.67 13.04 L 8.79 15.16 Z
