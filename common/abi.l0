; abi.l0 -- what the kernel and its processes agree on: the numbers of the
; kernel's own calls, the words they return, where things are in a
; process's address space, and how a message is laid out. Linked into the
; kernel and into every user program.

; --------------------------------------------------------- the kernel's calls

; Calls 1 to 13 are the process ABI of spec section 10.3, which every L0
; program built with --target proc makes; the kernel answers all but 11,
; clock, which only a riscv64 process asks. The kernel's own start at 256.
(def sys_read () int 1)
(def sys_write () int 2)
(def sys_exit () int 3)
(def sys_open () int 4)
(def sys_close () int 5)
(def sys_rename () int 6)
(def sys_remove () int 7)
(def sys_arg_count () int 8)
(def sys_arg () int 9)
(def sys_region () int 10)
(def sys_release () int 12)         ; heap pages the runtime has freed: base, len -> 0
(def sys_unregion () int 13)        ; a region closed: what region gave, len -> 0

(def call_yield () int 256)          ; () -> 0
(def call_pid () int 257)            ; () -> the caller's pid
(def call_port_new () int 258)       ; () -> a port the caller owns
(def call_send () int 259)           ; send: port, bytes -> 0 or an error
(def call_receive () int 260)        ; receive: port, max -> [sender][payload], waiting
(def call_try_receive () int 261)    ; receive: port, max -> the same, or nothing at once
(def call_register () int 262)       ; send: port, name -> 0 or an error
(def call_lookup () int 263)         ; send: 0, name -> a port or an error
(def call_spawn () int 264)          ; module index -> a pid or an error
(def call_wait () int 265)           ; pid -> its exit status, waiting
(def call_sleep_until () int 266)    ; t in clock_ns -> 0, waiting until then
(def call_irq_bind () int 267)       ; irq, port -> 0 or an error
(def call_irq_ack () int 268)        ; irq -> 0 or an error
(def call_module_name () int 269)    ; receive: module index, max -> its name, or nothing
(def call_kill () int 270)           ; pid -> 0 or an error; any but a dev program
(def call_watch () int 271)          ; pid, port -> 0 or an error; port told when pid exits
(def call_spawn_args () int 272)     ; send: module index, encode_args -> a pid or an error
(def call_proc_info () int 273)      ; receive: pid, max -> its proc_record, or nothing
(def call_dma_alloc () int 274)      ; n pages -> the address of n zeroed pages a device can reach
(def call_dma_address () int 275)    ; va -> where a device reaches the DMA page holding va
(def call_tty_set () int 276)        ; port -> 0 or an error; the caller's terminal, and its children's
(def call_tty_get () int 277)        ; () -> the caller's terminal's port, 0 for the kernel's own
(def call_shm_alloc () int 278)      ; n pages -> the address of n zeroed pages, to share; any process may
(def call_shm_share () int 279)      ; va, n, pid -> where pid sees the caller's n pages from va, the same memory
(def call_proc_slot () int 280)      ; slot -> the pid it holds or last held, 0 for none yet
(def call_shm_unmap () int 281)      ; va, n -> 0; the caller's n shared or DMA pages from va given up
(def call_shm_revoke () int 282)     ; va, n, pid -> how many of pid's mappings of the caller's n pages from va were taken back
(def call_fs_mount () int 283)       ; send: port, [UUID ]LABEL -> 0 or an error; the caller's volume at /Volumes/LABEL
(def call_mount_at () int 284)       ; receive: i, max -> mount i's port, a u32, where it is, and NUL UUID if it has one; or nothing
(def call_boot_args () int 285)      ; receive: 0, max -> the board's boot arguments, as encode_args writes them
(def call_root_switch () int 286)    ; send: 0, label -> 0 or an error; that volume /, once, and the initramfs freed
(def call_spawn_image () int 287)    ; send: 0, spawn_image_bytes -> a pid or an error; a program from its bytes
(def call_mem_info () int 288)       ; receive: 0, max -> the mem_record of the pages processes are given
(def call_fs_unmount () int 289)     ; send: port, LABEL -> 0 or an error; the caller's volume at /Volumes/LABEL unmounted
(def call_chdir () int 290)          ; send: 0, path -> 0 or an error; the path, from the current directory, the new one
(def call_getcwd () int 291)         ; receive: 0, max -> the current directory, an absolute path
(def call_dma_addresses () int 292)  ; receive: va, max -> where a device reaches each DMA page from va's on, a u64 each, as many as max holds, up to the first that is not DMA
(def call_dma_sync () int 293)       ; va, n, dir -> how many of n DMA pages from va's on made to agree between the caches and memory, up to the first that is not DMA: dir 1 cleans, for a device to read, 2 invalidates, for the CPU to read, 3 both

; The most pages one dma_alloc gives: 64 MB, enough for a 3840 by 2160
; screen of 4-byte pixels, 8100 pages, in one buffer.
(def dma_limit () int 16384)

; ------------------------------------------------------------ processes

; What proc_info says a process is doing: the first word of its record.
(def state_running () int 1)         ; it made the call: only one runs at a time
(def state_ready () int 2)
(def state_receiving () int 3)       ; detail: the port
(def state_waiting () int 4)         ; detail: the pid it waits for
(def state_sleeping () int 5)
(def state_exited () int 6)          ; detail: the status; parent and module unknown, 0 and -1
(def state_writing () int 7)         ; detail: its terminal's port, full
(def state_reading () int 8)         ; detail: the port its terminal's line comes back on
(def state_filing () int 9)          ; detail: the port of the file server answering its call

; A process's record, as proc_info gives it: state, parent, module index,
; a detail as the state says, and the pages of memory it has, its own
; (its image, heap and stack, as far as it has touched them) and those
; at its device pages (shared and DMA memory, which other processes may
; map too), each a u32. An exited process has none.
(def proc_record ((state int) (parent int) (module int) (detail int) (own int) (shared int)) (list int)
  (append (u32_le state) (append (u32_le parent) (append (u32_le module)
    (append (u32_le detail) (append (u32_le own) (u32_le shared)))))))

; The bytes in a proc_record: its six u32s.
(def proc_record_len () int 24)

; The memory processes are given, as mem_info says it: the pages of the
; pool every page of a process comes from, those given and those left,
; and how many of them are given, each counted once however many
; processes map it; each a u32.
(def mem_record ((total int) (used int)) (list int)
  (append (u32_le total) (u32_le used)))

; The bytes in a mem_record: its two u32s.
(def mem_record_len () int 8)

; ------------------------------------------------------------------ errors

; What the kernel's own calls return when they fail. They are the kernel's
; to define (spec section 6.15), so they are not section 6.3's codes.
(def err_no_port () int -1)          ; no such port, name, pid, or module; or not yours
(def err_taken () int -2)            ; a name or interrupt already bound; or no message yet
(def err_full () int -3)             ; the port's queue is full
(def err_too_big () int -4)          ; the message is over max_message, or over max
(def err_fault () int -5)            ; a buffer the caller may not use; or out of resources
(def err_denied () int -6)           ; the module may not drive devices

; ------------------------------------------------------------------ limits

(def max_message () int 4096)        ; payload bytes in one message
(def header_len () int 4)            ; the sender's pid, before the payload
(def queue_limit () int 32)          ; messages waiting on one port
(def max_procs () int 255)           ; slots of the process table, each reused, with a new pid each time
(def slice_ns () int 10000000)       ; 10 ms of running before preemption
(def killed_status () int 130)       ; the status of a process killed, as by SIGINT
(def watch_limit () int 32)          ; ports watching one process
(def open_limit () int 16)           ; files one process has open at once
(def path_limit () int 1024)         ; bytes in a path open, rename, or remove is given
(def io_chunk () int 65536)          ; bytes one read or write moves at most
(def label_max () int 15)            ; bytes in a volume's label

; Whether s may label a volume, mounted at /Volumes/s: 1 to label_max
; letters, digits, - and _.
(def label_ok ((s (list int))) bool
  (if (if (is_empty s) true (gt (length s) (label_max))) false (label_chars s)))

; Whether every byte of s is one label_ok allows, whatever its length.
(def label_chars ((s (list int))) bool
  (if (is_empty s)
      true
      (let c (head s)
        (if (if (is_lower c) true (if (is_upper c) true (if (is_digit c) true (any_eq c "-_"))))
            (label_chars (tail s))
            false))))

; -------------------------------------------------------- the address space

; As spec section 10.3 lays out a process.
(def page_size () int 4096)

; The pages n bytes take, the last perhaps in part.
(def pages_for ((n int)) int (div (add n (sub (page_size) 1)) (page_size)))

(def user_base () int 3221225472)    ; 0xC0000000: the image's segments, then the heap
(def heap_limit () int 3623878656)   ; 0xD8000000: heap below, stack above
(def stack_top () int 3892314112)    ; 0xE8000000: the initial sp
(def user_limit () int 4294967296)   ; 0x100000000: the end of the user range

; ---------------------------------------------------------------- encoding

; The low 32 bits of n, least significant byte first.
(def u32_le ((n int)) (list int)
  (cons (bit_and n 255)
        (cons (bit_and (bit_shr n 8) 255)
              (cons (bit_and (bit_shr n 16) 255)
                    (cons (bit_and (bit_shr n 24) 255) (nil int))))))

; The u32 at byte i of b, least significant byte first. The caller has
; checked that four bytes are there.
(def le_u32 ((b bytes) (i int)) int
  (bit_or (bytes_get b i)
          (bit_or (bit_shl (bytes_get b (add i 1)) 8)
                  (bit_or (bit_shl (bytes_get b (add i 2)) 16)
                          (bit_shl (bytes_get b (add i 3)) 24)))))

; The low n bytes of v, least significant first.
(def le_bytes ((v int) (n int)) (list int)
  (if (eq n 0)
      (nil int)
      (cons (bit_and v 255) (le_bytes (bit_shr v 8) (sub n 1)))))

; v as 2 and as 8 bytes, least significant first.
(def le16 ((v int)) (list int) (le_bytes v 2))
(def le64 ((v int)) (list int) (le_bytes v 8))

; The u16 and the u64 at byte i of b, least significant byte first. The
; caller has checked that the bytes are there.
(def le_u16_at ((b bytes) (i int)) int
  (bit_or (bytes_get b i) (bit_shl (bytes_get b (add i 1)) 8)))
(def le_u64_at ((b bytes) (i int)) int
  (bit_or (le_u32 b i) (bit_shl (le_u32 b (add i 4)) 32)))

; The bytes of b from i up to j, as a list.
(def bytes_range ((b bytes) (i int) (j int)) (list int)
  (bytes_range_onto b i j (nil int)))

; bytes_range's loop, from the end: puts the bytes from i up to j in
; front of acc.
(def bytes_range_onto ((b bytes) (i int) (j int) (acc (list int))) (list int)
  (if (le j i)
      acc
      (bytes_range_onto b i (sub j 1) (cons (bytes_get b (sub j 1)) acc))))

; The kernel's notice that pid exited with status, as the payload of a
; message from pid 0 to each port watching it.
(def exit_notice ((pid int) (status int)) (list int)
  (append "exit" (append (u32_le pid) (u32_le status))))

; The kernel's word for an exit status that wait answers: its low 32
; bits, never negative, so it is never err_no_port; s32 reads it back.
(def wait_word ((status int)) int (bit_and status 4294967295))

; The low 32 bits of n as a signed number, as u32_le keeps a status.
(def s32 ((n int)) int
  (let low (bit_and n 4294967295)
    (if (ge low 2147483648) (sub low 4294967296) low)))

; The kernel's notice that interrupt n happened, as the payload of a
; message from pid 0.
(def irq_notice ((n int)) (list int)
  (append "irq" (u32_le n)))

; Whether b has n bytes from i.
(def has ((b bytes) (i int) (n int)) bool
  (le (add i n) (bytes_len b)))

; ------------------------------------------------------------ arguments

; Arguments as spawn_args passes them: argc, then each argument's length
; and bytes, every number a u32.
(def encode_args ((args (list (list int)))) (list int)
  (rev (push_args args (push (u32_le (length args)) (nil int)))))

; encode_args's loop: pushes each argument's length and bytes onto the
; reversed acc.
(def push_args ((args (list (list int))) (acc (list int))) (list int)
  (if (is_empty args)
      acc
      (let a (push (u32_le (length (head args))) acc)
        (push_args (tail args) (push (head args) a)))))

; The arguments b holds, all of it, as encode_args writes them; or none,
; if b is anything else.
(def decode_args ((b bytes)) (Option (list (list int)))
  (if (not (has b 0 4))
      ((None (list (list int))))
      (match (parse_args b (le_u32 b 0) 4 (nil (list int)))
        ((ArgsOk args end) (if (eq end (bytes_len b)) (Some args) ((None (list (list int))))))
        ((ArgsBad why) ((None (list (list int))))))))

; What parse_args finds: the arguments and the byte after the last, or
; why they could not be read.
(data ArgsParse (ArgsOk (list (list int)) int) (ArgsBad (list int)))

; The n arguments in b from i, and where they end.
(def parse_args ((b bytes) (n int) (i int) (acc (list (list int)))) ArgsParse
  (if (eq n 0)
      (ArgsOk (rev acc) i)
      (if (not (has b i 4))
          (ArgsBad "arguments cut short")
          (let len (le_u32 b i)
            (if (not (has b (add i 4) len))
                (ArgsBad "arguments cut short")
                (parse_args b (sub n 1) (add i (add 4 len))
                            (cons (bytes_range b (add i 4) (add i (add 4 len))) acc)))))))

; ------------------------------------------------------------------ arrays

; The elements of xs as an array, of any type; fill is never seen, but
; says what an element is when xs is empty.
(def (array_from T) ((xs (list T)) (fill T)) (array T)
  (array_fill (array_new (length xs) fill) xs 0))

; array_from's loop: sets a's elements from i on to those of xs.
(def (array_fill T) ((a (array T)) (xs (list T)) (i int)) (array T)
  (if (is_empty xs)
      a
      (array_fill (array_set a i (head xs)) (tail xs) (add i 1))))

; The elements of a, in order, as a list: array_from undone.
(def (array_to_list T) ((a (array T))) (list T)
  (array_to_list_from a (sub (array_len a) 1) (nil T)))

; array_to_list's loop, from the end: puts a's elements up to i in front
; of acc.
(def (array_to_list_from T) ((a (array T)) (i int) (acc (list T))) (list T)
  (if (lt i 0) acc (array_to_list_from a (sub i 1) (cons (array_get a i) acc))))
