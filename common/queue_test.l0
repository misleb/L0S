(def drain ((q (Queue int)) (acc (list int))) (list int)
  (match (queue_pop q)
    ((Popped x rest) (drain rest (cons x acc)))
    ((PopEmpty) (rev acc))))

(def test_fifo () int
  (let q (queue_push (queue_push (queue_push (queue_empty 0) 1) 2) 3)
    (check_str "order" (drain q (nil int)) (cons 1 (cons 2 (cons 3 (nil int)))))))

(def test_interleaved () int
  (match (queue_pop (queue_push (queue_push (queue_empty 0) 1) 2))
    ((Popped x rest)
      (add (check_int "first" x 1)
           (check_str "then" (drain (queue_push rest 3) (nil int)) (cons 2 (cons 3 (nil int))))))
    ((PopEmpty) (fail_because "pop" "empty"))))

(def test_empty () int
  (add (check_bool "new" (queue_is_empty (queue_empty 0)) true)
       (check_int "size" (queue_size (queue_push (queue_empty 0) 9)) 1)))

(def test_remove () int
  (let q (queue_push (queue_push (queue_push (queue_empty 0) 1) 2) 1)
    (check_str "without 1" (drain (queue_remove q 1) (nil int)) (cons 2 (nil int)))))
