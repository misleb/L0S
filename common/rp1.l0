; rp1.l0 -- RP1's window on the Raspberry Pi 5, made to answer. RP1, the
; chip with the USB, Ethernet and GPIO, is behind the PCIe controller at
; 0x1000120000, and the firmware leaves that controller set for another
; address, so the window at 0x1F00000000 reads 0xDEADDEAD throughout,
; without a fault (spec 10.3). rp1_up sets the root port's bus numbers
; and memory window, RP1's BAR1 and the outbound window, as a board run
; did to read RP1's chip ID, and turns on memory and bus mastering on
; both, for RP1's DMA, and sets BAR0 and BAR2 and enables MSI-X so that
; its interrupts, vectors routed with rp1_msi_route, come as interrupts
; 160 + v. It writes those only when the chip ID and the MSI-X table do
; not already answer, so every driver of RP1 calls it first, in any
; order; and it sets, every time, the inbound window by which RP1's DMA
; reaches memory, which bootloaders leave differently (roadmap 0064).
;
; A network boot leaves RP1's Ethernet receiving into the firmware's
; buffers, in memory L0 gives as frames, and pciex4_reset=0 keeps it so:
; every frame on the wire is then written over whatever is there. The
; kernel calls rp1_quiet first thing, before it takes any memory, to stop
; it. Linked by the kernel and by the Makefile's RP1.

; The window onto RP1's peripherals, and RP1's chip ID at its start.
(def rp1_window () int 133143986176)     ; 0x1F00000000
(def rp1_chip_id () int 536877351)       ; 0x20001927

; The PCIe controller RP1 is behind, and its bytes (spec 10.3).
(def rp1_pcie () int 68720656384)        ; 0x1000120000
(def rp1_pcie_bytes () int 37648)        ; 0x9310

; The controller's configuration index, and its data window: a device's
; register reg is at data plus reg once the index names the device, as
; bus << 20 | device << 15 | function << 12. RP1 is bus 1, device 0.
(def pcie_cfg_index () int 36864)        ; 0x9000
(def pcie_cfg_data () int 32768)         ; 0x8000
(def rp1_bdf () int 1048576)             ; 0x100000

; A register's offset in the controller and the word written there.
(data Rp1Write (Rp1Write int int))

; What makes the window answer, in order: the root port's bus numbers 0,
; 1, 1 (0x18); its memory window 0 up to 0x3FFFFF (0x20); RP1's BAR1 0
; (its 0x14, through the index); and the outbound window PCI 0 from CPU
; 0x1F00000000 (0x400C, 0x4080, 0x4084).
(def rp1_writes () (list Rp1Write)
  (cons (Rp1Write 24 65792)
  (cons (Rp1Write 32 4194304)
  (cons (Rp1Write (pcie_cfg_index) (rp1_bdf))
  (cons (Rp1Write (add (pcie_cfg_data) 20) 0)
  (cons (Rp1Write (add (pcie_cfg_data) 24) 4194304)
  (cons (Rp1Write (add (pcie_cfg_data) 16) 4259840)
  (cons (Rp1Write 16396 0)
  (cons (Rp1Write 16512 31)
  (cons (Rp1Write 16516 31)
  (nil Rp1Write)))))))))))

; The controller's second inbound window, by which RP1's DMA reaches the
; board's memory, as 2026-05-26's bootloader leaves it: RC_BAR2 (0x4034,
; 0x4038) PCI 0 for 64 GB, size code 0x15, and its UBUS remap (0x40B4,
; 0x40B8) enabled and unmoved. 2026-10-30's leaves it 8 MB at 0x3B000000
; (0x3B000008, remap 0x3B000001), its own buffers', so that RP1's DMA
; reaches nothing else: xhci finds no device, gem no frame (roadmap
; 0064, run 3). Both map an address to itself.
(def rp1_inbound_writes () (list Rp1Write)
  (cons (Rp1Write 16436 21)
  (cons (Rp1Write 16440 0)
  (cons (Rp1Write 16564 1)
  (cons (Rp1Write 16568 0)
  (nil Rp1Write))))))

; RP1's MSI-X capability's first word, in its configuration space, whose
; bit 31 enables MSI-X: a read, with the bit set, written back.
(def rp1_msix_cap () int 176)            ; 0xB0
(def rp1_msix_on () int 2147483648)      ; bit 31

; A capability word with MSI-X enabled.
(def rp1_msix_word ((v int)) int (bit_or v (rp1_msix_on)))

; Where RP1's MSI-X table is in its window, and the bytes of the window
; that reach it and its BARs (spec 10.3): table entry v is 16 bytes at
; 16 v.
(def rp1_msix_table () int 4259840)      ; 0x410000
(def rp1_window_bytes () int 4276224)    ; 0x414000

; The word at vector v's MSIX_CFG, set alias, in RP1's window: 0x108808 +
; 4 v; the clear alias is 0x400 above.
(def rp1_msix_cfg ((v int)) int (add 1083400 (mul 4 v)))

; The interrupt RP1's vector v raises, 160 + v, since the MSI writes n = v.
(def rp1_irq ((v int)) int (add 160 v))

; A table entry's four words for vector v: the doorbell's address,
; 0xFF_FFFFF000, low and high, the number, and 0 to unmask it.
(def rp1_msix_entry ((v int)) (list int)
  (cons 4294963200 (cons 255 (cons v (cons 0 (nil int))))))

; The MSIX_CFG word that enables v: ENABLE, bit 0, and IACK_EN, bit 3,
; for a level-triggered source.
(def rp1_msix_enable ((level bool)) int (if level 9 1))

; The MSIX_CFG word that acknowledges a level interrupt, IACK, bit 2.
(def rp1_msix_ack () int 4)

; Vector v routed through w, RP1's window opened with rp1_window_bytes:
; its table entry written, then enabled, level-triggered or edge. 0.
(def rp1_msi_route ((w IoRegion) (v int) (level bool)) int
  (let e (rp1_msi_put w (add (rp1_msix_table) (mul 16 v)) (rp1_msix_entry v))
    (region_set32 w (rp1_msix_cfg v) (rp1_msix_enable level))))

; Each of ws written to w from byte off, a word each: 0.
(def rp1_msi_put ((w IoRegion) (off int) (ws (list int))) int
  (if (is_empty ws)
      0
      (let x (region_set32 w off (head ws)) (rp1_msi_put w (add off 4) (tail ws)))))

; v's level interrupt acknowledged, so RP1 sends the next: 0.
(def rp1_msi_ack ((w IoRegion) (v int)) int
  (region_set32 w (rp1_msix_cfg v) (rp1_msix_ack)))

; Whether the table, in w's first words, answers, rather than reading the
; 0xDEADDEAD an unset window does.
(def rp1_table_answers ((w IoRegion)) bool
  (not (eq (region_get32 w (rp1_msix_table)) 3735936685)))

; Whether RP1 answers, or why not.
(data Rp1 (Rp1Up) (Rp1Down (list int)))

; RP1's window made to answer, if it does not already, and the
; controller's inbound window for RP1's DMA set whatever the bootloader
; left (rp1_inbound_writes): Rp1Up once its chip ID reads right, else
; why not.
(def rp1_up () Rp1
  (match (open_region (rp1_window) (rp1_window_bytes))
    ((IoRegionFailed fault why) (Rp1Down (append "no RP1 window on the board: " why)))
    ((IoRegionOpened w)
      (let (i (rp1_inbound_set)
            up (if (rp1_set w) (Rp1Up) (rp1_set_up w))
            c (close_region w))
        up))))

; The controller's inbound window for RP1's DMA written: 0, or -1 if the
; controller's region will not open.
(def rp1_inbound_set () int
  (match (open_region (rp1_pcie) (rp1_pcie_bytes))
    ((IoRegionFailed fault why) -1)
    ((IoRegionOpened r)
      (let (a (rp1_write_all r (rp1_inbound_writes)) c (close_region r)) 0))))

; Whether the window is set up already, as far as MSI-X: the chip ID
; reads, and so does the table.
(def rp1_set ((w IoRegion)) bool
  (and (eq (region_get32 w 0) (rp1_chip_id)) (rp1_table_answers w)))

; The controller set up, and RP1's chip ID read again through w.
(def rp1_set_up ((w IoRegion)) Rp1
  (match (open_region (rp1_pcie) (rp1_pcie_bytes))
    ((IoRegionFailed fault why) (Rp1Down (append "no PCIe controller for RP1: " why)))
    ((IoRegionOpened r)
      (let (a (rp1_write_all r (rp1_writes))
            b (rp1_master r 4)
            i (region_set32 r (pcie_cfg_index) (rp1_bdf))
            d (rp1_master r (add (pcie_cfg_data) 4))
            m (rp1_msix_enabled r)
            c (close_region r)
            id (region_get32 w 0))
        (if (eq id (rp1_chip_id))
            (Rp1Up)
            (Rp1Down (rp1_dead_text id)))))))

; MSI-X enabled in RP1's capability, through the index already naming RP1:
; 0.
(def rp1_msix_enabled ((r IoRegion)) int
  (let off (add (pcie_cfg_data) (rp1_msix_cap))
    (region_set32 r off (rp1_msix_word (region_get32 r off)))))

; Each of ws written to r, in order: 0.
(def rp1_write_all ((r IoRegion) (ws (list Rp1Write))) int
  (if (is_empty ws)
      0
      (match (head ws)
        ((Rp1Write off v) (let x (region_set32 r off v) (rp1_write_all r (tail ws)))))))

; The command register at off turned to answer memory and master the
; bus, bits 1 and 2, its status half written as 0, which clears nothing.
(def rp1_master ((r IoRegion) (off int)) int
  (region_set32 r off (rp1_command (region_get32 r off))))

; A command and status word's command with memory and bus mastering on.
(def rp1_command ((v int)) int (bit_or (bit_and v 65535) 6))

; RP1's Ethernet MAC, a Cadence GEM, through the window (rp1.dtsi's
; ethernet@100000), and its network control register's word with
; receiving and sending off and the management port on.
(def rp1_gem_base () int 133145034752)   ; 0x1F00100000
(def rp1_gem_idle () int 16)             ; NCR's MPE

; RP1's Ethernet stopped from writing to memory, if the board has RP1:
; its network control register as it was found, or -1 if there is no RP1
; or its window will not answer.
(def rp1_quiet () int
  (match (rp1_up)
    ((Rp1Down why) -1)
    ((Rp1Up)
      (match (open_region (rp1_gem_base) 4096)
        ((IoRegionFailed fault why) -1)
        ((IoRegionOpened g)
          (let (ncr (region_get32 g 0)
                w (region_set32 g 0 (rp1_gem_idle))
                c (close_region g))
            ncr))))))

; What the kernel says of RP1's Ethernet, its control register found ncr:
; whether it was receiving, bit 2, or sending, bit 3, until stopped.
(def rp1_quiet_text ((ncr int)) (list int)
  (append "l0s: RP1's Ethernet found " (append
    (if (eq (bit_and ncr 12) 0) "idle" "receiving or sending, and stopped")
    (append " (NCR 0x" (append (hex_digits ncr 0) ")")))))

; Why RP1 is down when its chip ID read id after the set up.
(def rp1_dead_text ((id int)) (list int)
  (append "RP1's window reads 0x" (append (hex_digits id 8) ", not its chip ID, after the PCIe controller was set up")))

; ------------------------------------------------------------- the probe

; The MIP RP1's MSIs reach, mip0 in the board's device tree
; (bcm2712-rpi-5-b.dtb): the controller's inbound window takes a write
; to PCI 0xFF_FFFFF000 to it, and it raises SPI 128 + n, interrupt 160 +
; n, for 64 vectors. Its registers are 0xC0 bytes.
(def rp1_mip () int 68720721920)         ; 0x1000130000
(def rp1_mip_bytes () int 192)           ; 0xC0

; What the probe reads, as rows of 8 words: the controller's MISC block
; from 0x4000 to 0x413F, its MSI_BAR, its inbound windows (RC_BAR1 to 3
; and 4 on), their UBUS remaps and its outbound window among them; its
; own MSI interrupt's at 0x4500; and the MIP's whole.
(data Rp1Rows (Rp1Rows (name (list int)) (base int) (bytes int) (from int) (rows int)))
(def rp1_probe_rows () (list Rp1Rows)
  (cons (Rp1Rows "pcie" (rp1_pcie) (rp1_pcie_bytes) 16384 10)
  (cons (Rp1Rows "pcie" (rp1_pcie) (rp1_pcie_bytes) 17664 1)
  (cons (Rp1Rows "mip" (rp1_mip) (rp1_mip_bytes) 0 6)
  (nil Rp1Rows)))))

; A row's line: what it is, the offset of its first word, and the words,
; each in 8 hex digits.
(def rp1_row_text ((name (list int)) (off int) (ws (list int))) (list int)
  (append "l0s: rp1 probe: " (append name (append " 0x" (append (hex_digits off 4) (append ": " (join_with " " (rp1_hex_words ws))))))))

; Each of ws in 8 hex digits.
(def rp1_hex_words ((ws (list int))) (list (list int))
  (if (is_empty ws) (nil (list int)) (cons (hex_digits (head ws) 8) (rp1_hex_words (tail ws)))))

; What the firmware left in the PCIe controller RP1 is behind and in the
; MIP, as lines of rp1_row_text, read and nothing written (roadmap
; 0064); a line saying why for a region that will not open.
(def rp1_probe () (list (list int))
  (rp1_probe_all (rp1_probe_rows) (nil (list int))))

; Each of rs's lines, after the reversed acc.
(def rp1_probe_all ((rs (list Rp1Rows)) (acc (list (list int)))) (list (list int))
  (if (is_empty rs)
      (rev acc)
      (let r (head rs)
        (match (open_region (.base r) (.bytes r))
          ((IoRegionFailed fault why)
            (rp1_probe_all (tail rs) (cons (append "l0s: rp1 probe: no " (append (.name r) (append " region: " why))) acc)))
          ((IoRegionOpened g)
            (let (ls (rp1_rows_read g (.name r) (.from r) (.rows r) acc) c (close_region g))
              (rp1_probe_all (tail rs) ls)))))))

; n rows of g from off, each its line, onto acc.
(def rp1_rows_read ((g IoRegion) (name (list int)) (off int) (n int) (acc (list (list int)))) (list (list int))
  (if (le n 0)
      acc
      (rp1_rows_read g name (add off 32) (sub n 1) (cons (rp1_row_text name off (rp1_row_words g off 8)) acc))))

; n words of g from off.
(def rp1_row_words ((g IoRegion) (off int) (n int)) (list int)
  (if (le n 0) (nil int) (cons (region_get32 g off) (rp1_row_words g (add off 4) (sub n 1)))))
