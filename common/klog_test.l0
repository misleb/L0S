; klog_test.l0 -- tests of klog.l0: records as bytes and back, and dmesg's lines.

(def sample ((seq int) (text (list int))) LogRecord
  (LogRecord seq 1500000 7 (log_info) text))

(def test_levels () int
  (add (check_true "error" (log_level_ok (log_error)))
       (add (check_true "debug" (log_level_ok (log_debug)))
            (check_true "four" (not (log_level_ok 4))))))

(def test_level_names () int
  (add (check_str "error" (log_level_name (log_error)) "error")
       (check_str "none" (log_level_name 9) "?")))

(def test_clean () int
  (add (check_str "trailing" (log_clean "up\n") "up")
       (add (check_str "inside" (log_clean "a\nb\r\n") "a b")
            (check_str "none" (log_clean "\n\n") ""))))

(def test_record_len () int
  (check_int "len" (log_record_len (sample 0 "abc")) 24))

(def test_round_trip () int
  (let (b (bytes_from_list (append (log_record_bytes (sample 4 "uart: up"))
                                   (log_record_bytes (LogRecord 5 9 0 (log_error) "l0s: bad"))))
        rs (log_records_of b))
    (add (check_str "first" (log_line (head rs)) "[    0.001500] uart: up")
         (check_int "count" (length rs) 2))))

(def test_fields () int
  (match (head (log_records_of (bytes_from_list (log_record_bytes (LogRecord 258 99 513 3 "x")))))
    ((LogRecord seq ns pid level text)
      (add (check_int "seq" seq 258)
           (add (check_int "ns" ns 99)
                (add (check_int "pid" pid 513)
                     (check_int "level" level 3)))))))

(def test_truncated () int
  (let whole (log_record_bytes (sample 0 "hello"))
    (add (check_int "cut text" (length (log_records_of (bytes_from_list (take whole 23)))) 0)
         (check_int "cut header" (length (log_records_of (bytes_from_list (take whole 10)))) 0))))

(def test_empty () int
  (check_int "none" (length (log_records_of (bytes_from_list (nil int)))) 0))

(def test_stamp () int
  (add (check_str "zero" (log_stamp 0) "[    0.000000]")
       (add (check_str "one and a half" (log_stamp 1500000000) "[    1.500000]")
            (check_str "long" (log_stamp 12345000042000) "[12345.000042]"))))

(def test_lines () int
  (check_str "two"
    (log_lines (cons (sample 0 "a") (cons (sample 1 "b") (nil LogRecord))))
    "[    0.001500] a\n[    0.001500] b\n"))

(def test_dropped_note () int
  (check_str "dropped"
    (log_lines (cons (sample 3 "a") (nil LogRecord)))
    "(3 earlier messages dropped)\n[    0.001500] a\n"))

(def test_no_lines () int
  (check_str "nothing" (log_lines (nil LogRecord)) ""))
