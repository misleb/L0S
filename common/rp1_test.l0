; rp1_test.l0 -- tests of rp1.l0's pure parts.

; Under an operating system there is no RP1 window.
(def test_rp1_up_none () int
  (match (rp1_up)
    ((Rp1Up) (fail_because "down" "up"))
    ((Rp1Down why) (pass "down"))))

; The writes as text, offset=value in hex.
(def rp1_writes_text ((ws (list Rp1Write))) (list int)
  (join_with " " (rp1_write_texts ws (nil (list int)))))

; Each of ws as offset=value, after the reversed acc.
(def rp1_write_texts ((ws (list Rp1Write)) (acc (list (list int)))) (list (list int))
  (if (is_empty ws)
      (rev acc)
      (match (head ws)
        ((Rp1Write off v)
          (rp1_write_texts (tail ws) (cons (append (hex_digits off 0) (append "=" (hex_digits v 0))) acc))))))

; The board run's: bus numbers, memory window, BAR1 through the index,
; then the outbound window.
(def test_rp1_writes () int
  (check_str "in order" (rp1_writes_text (rp1_writes))
    "18=10100 20=300000 9000=100000 8014=0 400c=0 4080=1f 4084=1f"))

; Memory and bus mastering on, the status half dropped.
(def test_rp1_command () int
  (add (check_int "from 0" (rp1_command 0) 6)
       (check_int "status dropped" (rp1_command 2148532226) 6)))

(def test_rp1_dead_text () int
  (check_str "dead" (rp1_dead_text 3735936685)
    "RP1's window reads 0xdeaddead, not its chip ID, after the PCIe controller was set up"))

; Under an operating system there is no RP1 to quiet.
(def test_rp1_quiet_none () int
  (check_int "none" (rp1_quiet) -1))

; MPE and RE, 0x14, as a network boot leaves it; MPE alone, 0x10.
(def test_rp1_quiet_text () int
  (add (check_str "receiving" (rp1_quiet_text 20) "l0s: RP1's Ethernet found receiving or sending, and stopped (NCR 0x14)")
       (check_str "idle" (rp1_quiet_text 16) "l0s: RP1's Ethernet found idle (NCR 0x10)")))
