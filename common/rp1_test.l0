; rp1_test.l0 -- tests of rp1.l0's pure parts.

; Under an operating system there is no RP1 window.
(def test_rp1_up_none () int
  (match (rp1_up)
    ((Rp1Up) (fail_because "down" "up"))
    ((Rp1Down why) (pass "down"))))

; The writes as text, offset=value in hex.
(def rp1_writes_text ((ws (list Rp1Write))) (list int)
  (join_with " " (rp1_write_texts ws (nil (list int)))))

; Each of ws as offset=value, after the reversed acc.
(def rp1_write_texts ((ws (list Rp1Write)) (acc (list (list int)))) (list (list int))
  (if (is_empty ws)
      (rev acc)
      (match (head ws)
        ((Rp1Write off v)
          (rp1_write_texts (tail ws) (cons (append (hex_digits off 0) (append "=" (hex_digits v 0))) acc))))))

; The board run's: bus numbers, the memory window up to 0x4FFFFF, BAR1, BAR2
; (0x8018) and BAR0 (0x8010) through the index, then the outbound window.
(def test_rp1_writes () int
  (check_str "in order" (rp1_writes_text (rp1_writes))
    "18=10100 20=400000 9000=100000 8014=0 8018=400000 8010=410000 400c=0 4080=1f 4084=1f"))

; Vector v's table entry, its MSIX_CFG and its interrupt: spec 10.3's
; 0x1F00410000 + 16 v, 0x1F00108808 + 4 v, 160 + v.
(def test_rp1_msi_numbers () int
  (add (check_int "table" (add (rp1_msix_table) 96) 4259936)
  (add (check_int "cfg" (rp1_msix_cfg 6) 1083424)
       (check_int "irq" (rp1_irq 31) 191))))

; The doorbell 0xFFFFF000 and 0xFF, the number, 0; enable 1, or 9 for a
; level; ack 4; MSI-X's enable bit 31.
(def test_rp1_msi_words () int
  (add (check_str "entry" (rp1_writes_text (rp1_entry_writes 6)) "0=fffff000 4=ff 8=6 c=0")
  (add (check_int "edge" (rp1_msix_enable false) 1)
  (add (check_int "level" (rp1_msix_enable true) 9)
  (add (check_int "ack" (rp1_msix_ack) 4)
       (check_int "msix" (rp1_msix_word 3) 2147483651))))))

; The entry's words as writes at 0, 4, 8, c, to render.
(def rp1_entry_writes ((v int)) (list Rp1Write)
  (rp1_entry_at 0 (rp1_msix_entry v)))

; Each of ws as a write at off, then 4 more.
(def rp1_entry_at ((off int) (ws (list int))) (list Rp1Write)
  (if (is_empty ws) (nil Rp1Write) (cons (Rp1Write off (head ws)) (rp1_entry_at (add off 4) (tail ws)))))

; Memory and bus mastering on, the status half dropped.
(def test_rp1_command () int
  (add (check_int "from 0" (rp1_command 0) 6)
       (check_int "status dropped" (rp1_command 2148532226) 6)))

(def test_rp1_dead_text () int
  (check_str "dead" (rp1_dead_text 3735936685)
    "RP1's window reads 0xdeaddead, not its chip ID, after the PCIe controller was set up"))

; Under an operating system there is no RP1 to quiet.
(def test_rp1_quiet_none () int
  (check_int "none" (rp1_quiet) -1))

; MPE and RE, 0x14, as a network boot leaves it; MPE alone, 0x10.
(def test_rp1_quiet_text () int
  (add (check_str "receiving" (rp1_quiet_text 20) "l0s: RP1's Ethernet found receiving or sending, and stopped (NCR 0x14)")
       (check_str "idle" (rp1_quiet_text 16) "l0s: RP1's Ethernet found idle (NCR 0x10)")))

; A row of the controller's from 0x4040: offset in 4 digits, each word in
; 8, the MSI_BAR words at 0x4044 to 0x404C as the firmware might leave
; them.
(def test_rp1_row_text () int
  (check_str "row" (rp1_row_text "pcie" 16448 (cons 0 (cons 4294963201 (cons 255 (cons 4294967232 (nil int))))))
    "l0s: rp1 probe: pcie 0x4040: 00000000 fffff001 000000ff ffffffc0"))

; The controller's MISC block in 10 rows from 0x4000 and its MSI's 1 from
; 0x4500; the MIP's 0xC0 bytes in 6.
(def test_rp1_probe_rows () int
  (add (check_int "rows" (length (rp1_probe_rows)) 3)
  (add (check_int "msi" (.from (nth (rp1_probe_rows) 1)) 17664)
       (check_int "mip" (mul 32 (.rows (nth (rp1_probe_rows) 2))) (rp1_mip_bytes)))))

; Under an operating system there is no region to probe: a line for each.
(def test_rp1_probe_none () int
  (check_int "lines" (length (rp1_probe)) 3))

; RC_BAR2 at 0x4034 and 0x4038, PCI 0 for 64 GB (0x15, 2^36), and its UBUS
; remap at 0x40B4 and 0x40B8, enabled at 0: 2026-05-26's, as run 2 read.
(def test_rp1_inbound_writes () int
  (check_str "in order" (rp1_writes_text (rp1_inbound_writes)) "4034=15 4038=0 40b4=1 40b8=0"))

; Under an operating system there is no controller to set.
(def test_rp1_inbound_set_none () int
  (check_int "none" (rp1_inbound_set) -1))
