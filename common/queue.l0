; queue.l0 -- a first-in first-out queue of any type: the front, in order,
; and the back, reversed, so both ends cost constant time on average.

(data (Queue T) (Queue (list T) (list T)))

; What popping a queue gives: the first element and the rest, or nothing.
(data (Popped T) (Popped T (Queue T)) (PopEmpty))

(def (queue_empty T) ((x T)) (Queue T)
  (Queue (nil T) (nil T)))

(def (queue_push T) ((q (Queue T)) (x T)) (Queue T)
  (match q
    ((Queue front back) (Queue front (cons x back)))))

(def (queue_pop T) ((q (Queue T))) (Popped T)
  (match q
    ((Queue front back)
      (if (is_empty front)
          (if (is_empty back)
              ((PopEmpty T))
              (queue_pop_front (rev back)))
          (Popped (head front) (Queue (tail front) back))))))

(def (queue_pop_front T) ((front (list T))) (Popped T)
  (Popped (head front) (Queue (tail front) (nil T))))

(def (queue_size T) ((q (Queue T))) int
  (match q
    ((Queue front back) (add (length front) (length back)))))

(def (queue_is_empty T) ((q (Queue T))) bool
  (match q
    ((Queue front back) (if (is_empty front) (is_empty back) false))))

; The queue without every element equal to x.
(def (queue_remove T) ((q (Queue T)) (x T)) (Queue T)
  (match q
    ((Queue front back)
      (Queue (without x (append front (rev back)) (nil T)) (nil T)))))

(def (without T) ((x T) (xs (list T)) (acc (list T))) (list T)
  (if (is_empty xs)
      (rev acc)
      (without x (tail xs) (if (eq (head xs) x) acc (cons (head xs) acc)))))
