; text_test.l0 -- tests of text.l0.

(def test_nth () int
  (add (check_str "second" (nth (split_spaces "a b c") 1) "b")
       (check_int "first" (nth "xyz" 0) 120)))

(def test_nth_or () int
  (add (check_int "inside" (nth_or "xyz" 2 0) 122)
       (check_int "past the end" (nth_or "xyz" 3 0) 0)))

(def test_take () int
  (add (check_str "some" (take "abcdef" 3) "abc")
       (add (check_str "more than there are" (take "ab" 5) "ab")
            (check_str "none" (take "ab" -1) ""))))

(def test_drop () int
  (add (check_strs "words" (drop (split_spaces "a b c") 2) (split_spaces "c"))
       (add (check_str "more than there are" (drop "ab" 5) "")
            (check_str "none" (drop "ab" 0) "ab"))))

(def test_last () int
  (add (check_int "last" (last "abc") 99)
       (check_str "without it" (drop_last "abc") "ab")))

(def test_repeat () int
  (add (check_str "spaces" (spaces 3) "   ")
       (add (check_int "zeros" (length (zeros 4)) 4)
            (check_str "none" (repeat -2 120) ""))))

(def test_concat () int
  (add (check_str "three" (concat (split_spaces "ab c de")) "abcde")
       (check_str "none" (concat (nil (list int))) "")))

(def test_join_with () int
  (add (check_str "dots" (join_with "." (split_spaces "a b c")) "a.b.c")
       (add (check_str "one" (join_with ", " (split_spaces "a")) "a")
            (check_str "none" (join_with "." (nil (list int))) ""))))

(def test_unwords () int
  (check_str "undoes split_spaces" (unwords (split_spaces "ls  -l /bin")) "ls -l /bin"))

(def test_numbers_words () int
  (check_str "spaced" (unwords (numbers_words (cons 1 (cons -20 (cons 300 (nil int)))))) "1 -20 300"))

(def test_split_on () int
  (add (check_strs "an empty piece kept" (split_on 58 "a::b") (cons "a" (cons "" (cons "b" (nil (list int))))))
       (add (check_int "a last empty piece" (length (split_on 58 "a:")) 2)
            (check_strs "nothing" (split_on 58 "") (cons "" (nil (list int)))))))

(def test_lines () int
  (add (check_strs "a final newline" (lines "a\nb\n") (split_spaces "a b"))
       (add (check_strs "no final newline" (lines "a\n\nb") (cons "a" (cons "" (cons "b" (nil (list int))))))
            (check_int "nothing" (length (lines "")) 0))))

(def test_up_to () int
  (add (check_str "at a slash" (up_to 47 "data/notes") "data")
       (check_str "none" (up_to 47 "data") "data")))

(def test_strip_cr () int
  (add (check_str "a return" (strip_cr "ab\r") "ab")
       (add (check_str "none" (strip_cr "ab") "ab")
            (check_str "empty" (strip_cr "") ""))))

(def test_ends_with () int
  (add (check_true "yes" (ends_with "widget.l0" ".l0"))
       (check_bool "no" (ends_with "l0" ".l0") false)))

(def test_contains () int
  (add (check_true "inside" (contains "QEMU Virtio Keyboard" "Keyboard"))
       (add (check_bool "no" (contains "Tablet" "Keyboard") false)
            (check_true "empty" (contains "" "")))))

(def test_is_printable () int
  (add (check_true "space" (is_printable 32))
       (add (check_true "tilde" (is_printable 126))
            (check_bool "delete" (is_printable 127) false))))

(def test_pad () int
  (add (check_str "left" (pad_left "42" 5) "   42")
       (add (check_str "right" (pad_right "42" 4) "42  ")
            (check_str "zeros" (pad_left_with 48 "7" 2) "07"))))

(def test_pad_wide () int
  (add (check_str "left, already wide" (pad_left "12345" 3) "12345")
       (check_str "right, already wide" (pad_right "12345" 3) "12345")))

(def test_is_number () int
  (add (check_true "digits" (is_number "0123"))
       (add (check_bool "empty" (is_number "") false)
            (check_bool "sign" (is_number "-1") false))))

(def test_word_number () int
  (match (word_number "-42")
    ((Some n) (check_int "negative" n -42))
    ((None) (fail_because "negative" "not read"))))

(def test_word_number_large () int
  (match (word_number "3221225472")
    ((Some n) (check_int "past 32 bits" n 3221225472))
    ((None) (fail_because "past 32 bits" "not read"))))

(def test_word_number_bad () int
  (add (check_true "a lone sign" (eq (word_number "-") ((None int))))
       (add (check_true "a letter" (eq (word_number "4x") ((None int))))
            (check_true "empty" (eq (word_number "") ((None int)))))))

(def test_word_numbers () int
  (match (word_numbers (split_spaces "1 -2 30"))
    ((Some ns) (check_str "all" (unwords (numbers_words ns)) "1 -2 30"))
    ((None) (fail_because "all" "not read"))))

(def test_word_numbers_bad () int
  (check_true "one bad" (eq (word_numbers (split_spaces "1 x 3")) ((None (list int))))))

(def test_ceil_div () int
  (add (check_int "exact" (ceil_div 8192 4096) 2)
       (add (check_int "over" (ceil_div 8193 4096) 3)
            (check_int "zero" (ceil_div 0 4096) 0))))

(def test_format_size () int
  (add (check_str "bytes" (format_size 512) "512 bytes")
       (add (check_str "free space" (format_size 3584) "3.6 kB")
            (add (check_str "data" (format_size 782336) "782.3 kB")
                 (check_str "the disk" (format_size 1048576) "1.0 MB")))))

; The virt boards' 384 MB of frames, and 99.95 MB rounded up.
(def test_format_size_large () int
  (add (check_str "the pool" (format_size 402653184) "402.7 MB")
       (add (check_str "rounded" (format_size 99950000) "100.0 MB")
            (check_str "gigabytes" (format_size 2147483648) "2.1 GB"))))
