(def test_u32_le () int
  (add (check_str "small" (u32_le 258) (cons 2 (cons 1 (cons 0 (cons 0 (nil int))))))
       (check_str "keeps 32 bits" (u32_le -1) (cons 255 (cons 255 (cons 255 (cons 255 (nil int))))))))

(def test_le_u32_round_trip () int
  (add (check_int "zero" (le_u32 (bytes_from_list (u32_le 0)) 0) 0)
       (check_int "large" (le_u32 (bytes_from_list (u32_le 4000000000)) 0) 4000000000)))

(def test_le_u32_at_offset () int
  (check_int "offset" (le_u32 (bytes_from_list (append "xy" (u32_le 70000))) 2) 70000))

(def test_bytes_range () int
  (add (check_str "middle" (bytes_range (bytes_from_list "abcdef") 1 4) "bcd")
       (check_str "empty" (bytes_range (bytes_from_list "abc") 2 2) "")))

(def test_irq_notice () int
  (check_str "irq 34" (irq_notice 34) (append "irq" (cons 34 (cons 0 (cons 0 (cons 0 (nil int))))))))

(def test_layout () int
  (add (check_int "image is 4 MB" (sub (image_limit) (user_base)) 4194304)
       (check_int "stack is 256 MB" (sub (stack_top) (heap_limit)) 268435456)))

(def test_exit_notice () int
  (let b (bytes_from_list (exit_notice 3 -5))
    (add (check_int "length" (bytes_len b) 12)
         (add (check_int "pid" (le_u32 b 4) 3)
              (check_int "status" (s32 (le_u32 b 8)) -5)))))

(def test_s32 () int
  (add (check_int "positive" (s32 130) 130)
       (check_int "negative" (s32 4294967295) -1)))

(def decoded_args ((b (list int))) (list (list int))
  (match (decode_args (bytes_from_list b))
    ((Some args) args)
    ((None) (cons "refused" (nil (list int))))))

(def test_args_round_trip () int
  (add (check_strs "two" (decoded_args (encode_args (split_spaces "a bc"))) (split_spaces "a bc"))
       (check_strs "none" (decoded_args (encode_args (nil (list int)))) (nil (list int)))))

(def test_args_refused () int
  (add (check_strs "too short" (decoded_args "ab") (cons "refused" (nil (list int))))
       (add (check_strs "cut short" (decoded_args (append (u32_le 2) (append (u32_le 1) "a"))) (cons "refused" (nil (list int))))
            (check_strs "bytes left over" (decoded_args (append (encode_args (split_spaces "a")) "x")) (cons "refused" (nil (list int)))))))

(def test_array_from () int
  (let a (array_from "xyz" 0)
    (add (check_int "len" (array_len a) 3)
         (check_int "last" (array_get a 2) 122))))
