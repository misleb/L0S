; text.l0 -- lists and strings, as the standard library does not have
; them: joining and splitting words and lines, taking and dropping,
; padding, numbers as words, and the like. Pure, needing only the
; standard library, so linked into the kernel, every program and the host
; tools. Every name here is taken in all of them.

; ---------------------------------------------------------------- lists

; Element i of xs, from 0; xs has it.
(def (nth T) ((xs (list T)) (i int)) T
  (if (eq i 0) (head xs) (nth (tail xs) (sub i 1))))

; Element i of xs, from 0, or fallback past its end.
(def (nth_or T) ((xs (list T)) (i int) (fallback T)) T
  (if (is_empty xs) fallback (eq i 0) (head xs) (nth_or (tail xs) (sub i 1) fallback)))

; The first n of xs, or all of it if it is shorter.
(def (take T) ((xs (list T)) (n int)) (list T)
  (take_onto xs n (nil T)))

; take's loop: moves up to n more of xs onto the reversed acc, and
; turns it round at the end.
(def (take_onto T) ((xs (list T)) (n int) (acc (list T))) (list T)
  (if (or (le n 0) (is_empty xs)) (rev acc) (take_onto (tail xs) (sub n 1) (cons (head xs) acc))))

; xs without its first n, or empty if it is shorter: drop_n, of any type.
(def (drop T) ((xs (list T)) (n int)) (list T)
  (if (or (le n 0) (is_empty xs)) xs (drop (tail xs) (sub n 1))))

; The last of xs, which is not empty.
(def (last T) ((xs (list T))) T
  (head (rev xs)))

; xs without its last, which it has.
(def (drop_last T) ((xs (list T))) (list T)
  (rev (tail (rev xs))))

; n of x.
(def (repeat T) ((n int) (x T)) (list T)
  (repeat_onto n x (nil T)))

; repeat's loop: n more of x in front of acc.
(def (repeat_onto T) ((n int) (x T) (acc (list T))) (list T)
  (if (le n 0) acc (repeat_onto (sub n 1) x (cons x acc))))

; n zero bytes.
(def zeros ((n int)) (list int) (repeat n 0))

; n spaces.
(def spaces ((n int)) (list int) (repeat n 32))

; Every list of xss, one after another.
(def concat ((xss (list (list int)))) (list int)
  (concat_onto xss (nil int)))

; concat's loop: pushes each list of xss onto the reversed acc, and
; turns it round at the end.
(def concat_onto ((xss (list (list int))) (acc (list int))) (list int)
  (if (is_empty xss) (rev acc) (concat_onto (tail xss) (push (head xss) acc))))

; ---------------------------------------------------------------- words

; The words, sep between each two.
(def join_with ((sep (list int)) (ws (list (list int)))) (list int)
  (if (is_empty ws) (nil int) (rev (join_onto sep (tail ws) (push (head ws) (nil int))))))

; join_with's loop: pushes sep and then each word of ws onto the
; reversed acc, which the caller turns round.
(def join_onto ((sep (list int)) (ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws) acc (join_onto sep (tail ws) (push (head ws) (push sep acc)))))

; The words, a space between each two: split_spaces undone.
(def unwords ((ws (list (list int)))) (list int)
  (join_with " " ws))

; Each number, in decimal, as a word.
(def numbers_words ((ns (list int))) (list (list int))
  (if (is_empty ns) (nil (list int)) (cons (digits (head ns)) (numbers_words (tail ns)))))

; The pieces of s between each c, in order, empty ones kept: "a::b" split
; at : is "a", "", "b", and "" is one empty piece.
(def split_on ((c int) (s (list int))) (list (list int))
  (split_onto c s (nil int) (nil (list int))))

; split_on's loop: cur is the piece so far, reversed, and acc the pieces
; before it; each c ends a piece, and the end of s the last.
(def split_onto ((c int) (s (list int)) (cur (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (rev (cons (rev cur) acc))
      (eq (head s) c)
      (split_onto c (tail s) (nil int) (cons (rev cur) acc))
      (split_onto c (tail s) (cons (head s) cur) acc)))

; The lines of s, without their newlines; a last line needs none, and
; text ending in a newline has no empty line after it.
(def lines ((s (list int))) (list (list int))
  (lines_onto s (nil int) (nil (list int))))

; lines's loop: cur is the line so far, reversed, and acc the lines
; before it; each newline ends a line, and the end of s one not empty.
(def lines_onto ((s (list int)) (cur (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (rev (if (is_empty cur) acc (cons (rev cur) acc)))
      (eq (head s) 10)
      (lines_onto (tail s) (nil int) (cons (rev cur) acc))
      (lines_onto (tail s) (cons (head s) cur) acc)))

; s up to its first c, without it, or all of s if it has none.
(def up_to ((c int) (s (list int))) (list int)
  (up_to_onto c s (nil int)))

; up_to's loop: moves s onto the reversed acc until c or its end.
(def up_to_onto ((c int) (s (list int)) (acc (list int))) (list int)
  (if (or (is_empty s) (eq (head s) c)) (rev acc) (up_to_onto c (tail s) (cons (head s) acc))))

; s without a carriage return at its end.
(def strip_cr ((s (list int))) (list int)
  (if (is_empty s) s (eq (last s) 13) (drop_last s) s))

; Whether s ends with suffix.
(def ends_with ((s (list int)) (suffix (list int))) bool
  (starts_with (rev s) (rev suffix)))

; Whether s holds q anywhere.
(def contains ((s (list int)) (q (list int))) bool
  (if (starts_with s q) true (is_empty s) false (contains (tail s) q)))

; Whether c is a character that prints: ASCII's 32 to 126.
(def is_printable ((c int)) bool (and (ge c 32) (le c 126)))

; ---------------------------------------------------------------- padding

; s with c before it, to w characters; s itself if it has as many.
(def pad_left_with ((c int) (s (list int)) (w int)) (list int)
  (rev_onto (repeat (sub w (length s)) c) s))

; s with spaces before it, to w characters.
(def pad_left ((s (list int)) (w int)) (list int) (pad_left_with 32 s w))

; s with spaces after it, to w characters.
(def pad_right ((s (list int)) (w int)) (list int)
  (append s (spaces (sub w (length s)))))

; ---------------------------------------------------------------- numbers

; Whether w is a decimal number: digits, at least one.
(def is_number ((w (list int))) bool
  (and (not (is_empty w)) (is_empty (skip_digits w))))

; The number w is in decimal, with a - before it if negative, of any
; size; or none, if w is anything else.
(def word_number ((w (list int))) (Option int)
  (if (and (not (is_empty w)) (eq (head w) 45))
      (if (is_number (tail w)) (Some (neg (int_prefix (tail w) 0))) ((None int)))
      (is_number w) (Some (int_prefix w 0))
      ((None int))))

; The numbers the words are, as word_number reads each; or none, if any
; is not one.
(def word_numbers ((ws (list (list int)))) (Option (list int))
  (word_numbers_onto ws (nil int)))

; word_numbers's loop: acc holds, reversed, the numbers of the words
; before ws; the first word that is no number makes it none.
(def word_numbers_onto ((ws (list (list int))) (acc (list int))) (Option (list int))
  (if (is_empty ws)
      (Some (rev acc))
      (match (word_number (head ws))
        ((Some n) (word_numbers_onto (tail ws) (cons n acc)))
        ((None) ((None (list int)))))))

; n divided by d, rounded up; d is positive.
(def ceil_div ((n int) (d int)) int
  (div (add n (sub d 1)) d))

; A size as GNOME says it, g_format_size's way: bytes below 1000, and
; above, to a tenth, in kB, MB or GB, of 1000 each.
(def format_size ((bytes int)) (list int)
  (if (lt bytes 1000)
      (append (digits bytes) " bytes")
      (lt bytes 1000000) (format_tenths bytes 1000 " kB")
      (lt bytes 1000000000) (format_tenths bytes 1000000 " MB")
      (format_tenths bytes 1000000000 " GB")))

; bytes in units, to the nearest tenth, and the unit's name.
(def format_tenths ((bytes int) (unit int) (name (list int))) (list int)
  (let t (div (add (mul bytes 10) (div unit 2)) unit)
    (append (digits (div t 10)) (append "." (append (digits (mod t 10)) name)))))
