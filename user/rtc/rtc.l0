; rtc.l0 -- a driver in user space for the board's PL031 real-time clock.
; Its module must be flagged dev.
;
;   rtc         maps the clock, sets its alarm a second ahead, and waits
;               for the kernel to pass on the alarm's interrupt as a
;               message
;   rtc clock   maps the clock and serves clock (user/lib/clock.l0): the
;               time, to whoever asks, and at the start of every minute
;               to each process listening. It looks for both every
;               quarter of a second, and leaves the interrupt alone, so
;               rtc can still take it

(def rtc_base () int 151060480)     ; 0x09010000
(def rtc_irq () int 34)

; The PL031's registers, as offsets.
(def reg_data () int 0)             ; seconds
(def reg_match () int 4)            ; the alarm, in seconds
(def reg_mask () int 16)            ; 1: the alarm interrupts
(def reg_clear () int 28)           ; 1: the alarm's interrupt ends

(def alarm_lines ((t0 int) (t1 int)) (list int)
  (if (gt t1 t0)
      "rtc: alarm rang\nrtc: clock advanced\n"
      "rtc: alarm rang\nrtc: clock did not advance\n"))

(def complain ((why (list int))) int
  (let w (write_err (append "rtc: " (append why "\n"))) 1))

(def rtc () int
  (match (open_device (rtc_base) 4096)
    ((DeviceFailed fault why) (complain (append "no clock: " why)))
    ((DeviceOpened d)
      (let port (port_new)
        (let b (irq_bind (rtc_irq) port)
          (if (not (eq b 0))
              (complain (append "cannot bind interrupt 34: " (digits b)))
              (alarm d port)))))))

(def alarm ((d IoDevice) (port int)) int
  (let t0 (device_read32 d (reg_data))
    (let c (device_write32 d (reg_clear) 1)
      (let m (device_write32 d (reg_match) (add t0 1))
        (let k (device_write32 d (reg_mask) 1)
          (let w (write_line "rtc: alarm set")
            (rang d port t0 (port_receive port))))))))

(def rang ((d IoDevice) (port int) (t0 int) (msg Message)) int
  (if (not (is_irq_notice msg (rtc_irq)))
      (complain "expected the alarm's interrupt")
      (let t1 (device_read32 d (reg_data))
        (let k (device_write32 d (reg_mask) 0)
          (let c (device_write32 d (reg_clear) 1)
            (let a (irq_ack (rtc_irq))
              (let w (write_str (alarm_lines t0 t1))
                (if (eq a 0) 0 (complain "irq_ack refused")))))))))

; --------------------------------------------------------------- serving

(def rtc_main ((as (list (list int)))) int
  (if (is_empty as)
      (rtc)
      (if (if (eq (head as) "clock") (is_empty (tail as)) false)
          (rtc_clock)
          (complain "usage: rtc [clock]"))))

(def poll_ns () int 250000000)

(def rtc_clock () int
  (match (open_device (rtc_base) 4096)
    ((DeviceFailed fault why) (complain (append "no clock: " why)))
    ((DeviceOpened d)
      (let port (port_new)
        (if (not (eq (name_register port "clock") 0))
            (complain "cannot register as clock")
            (clock_serve d port (next_minute (device_read32 d (reg_data))) (nil int)))))))

; Every request waiting answered, then the listeners told the time if a
; minute has begun, then a nap: due is when the next minute begins, and
; ls the ports listening.
(def clock_serve ((d IoDevice) (port int) (due int) (ls (list int))) int
  (match (port_try_receive port)
    ((Message from payload) (clock_serve d port due (clock_asked (device_read32 d (reg_data)) payload ls)))
    ((RecvFailed)
      (let t (device_read32 d (reg_data))
        (if (lt t due)
            (let z (sleep_ns (poll_ns)) (clock_serve d port due ls))
            (let z (sleep_ns (poll_ns)) (clock_serve d port (next_minute t) (told ls (time_notice t) (nil int)))))))))

; A request at t, answered: listen adds its reply port to ls.
(def clock_asked ((t int) (payload (list int)) (ls (list int))) (list int)
  (let reply (request_reply payload)
    (let body (request_body payload)
      (let s (port_send reply (if (clock_request body) (time_notice t) "error: no such request"))
        (if (if (eq body "listen") (eq s 0) false) (cons reply ls) ls)))))

(def clock_request ((body (list int))) bool
  (any_eq body (split_spaces "listen time")))

; Each port of ls sent notice; those that took it, kept, onto acc.
(def told ((ls (list int)) (notice (list int)) (acc (list int))) (list int)
  (if (is_empty ls)
      acc
      (told (tail ls) notice (if (eq (port_send (head ls) notice) 0) (cons (head ls) acc) acc))))
