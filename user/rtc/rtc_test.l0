(def test_lines () int
  (add (check_str "advanced" (alarm_lines 5 6) "rtc: alarm rang\nrtc: clock advanced\n")
       (check_str "stuck" (alarm_lines 5 5) "rtc: alarm rang\nrtc: clock did not advance\n")))

; Under an operating system there is no clock to drive.
(def test_no_device () int
  (check_int "fails" (rtc) 1))

(def test_clock_no_device () int
  (check_int "fails" (rtc_main (split_spaces "clock")) 1))

(def test_usage () int
  (check_int "an unknown mode" (rtc_main (split_spaces "alarm")) 1))

(def test_clock_requests () int
  (add (check_bool "listen" (clock_request "listen") true)
       (add (check_bool "time" (clock_request "time") true)
            (check_bool "not another" (clock_request "date") false))))

(def kept_text ((s Sending)) (list int)
  (join_ints (still_told s 5 (cons 6 (nil int)))))

(def join_ints ((ns (list int))) (list int)
  (if (is_empty ns) "" (append (digits (head ns)) (append " " (join_ints (tail ns))))))

; A listener that took the notice, or is only slow, is kept; one that is
; gone is dropped.
(def test_still_told () int
  (add (check_str "sent" (kept_text (Sent)) "5 6 ")
       (add (check_str "full" (kept_text (SendFull)) "5 6 ")
            (check_str "gone" (kept_text (SendNoPort)) "6 "))))

; Under an operating system every send reads as a full queue, so each
; listener is kept.
(def test_told_no_kernel () int
  (check_int "both kept" (length (told (cons 5 (cons 6 (nil int))) (time_notice 60) (nil int))) 2))
