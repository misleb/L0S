; virtio-input.l0 -- a driver in user space for QEMU's virtio input devices:
; finds one among the board's virtio-mmio transports by its name, keeps
; its event queue filled with buffers in DMA pages, takes its interrupt as
; a message, and tells each process listening of what it reports. Its
; module must be flagged dev. Started once for each device:
;
;   virtio-input keyboard   the Keyboard: each key event, as a KeyEvent
;                           (l0s.l0) with the character it types on a US
;                           keyboard; serves keyboard, for keyboard_listen
;   virtio-input tablet     the Tablet: the pointer's place and buttons, as
;                           a PointerEvent, once each report is complete;
;                           serves pointer, for pointer_listen
;
; Both reach the device when QEMU's window has the focus; the terminal
; stays the console's.

(def input_device () int 18)        ; DeviceID of virtio-input: keyboards, mice, tablets

; ----------------------------------------------------------------- keymap

; Linux's key codes, as virtio-input gives them.
(def key_esc () int 1)
(def key_backspace () int 14)
(def key_tab () int 15)
(def key_enter () int 28)
(def key_lshift () int 42)
(def key_rshift () int 54)
(def key_lctrl () int 29)
(def key_rctrl () int 97)
(def key_space () int 57)
(def key_capslock () int 58)

; The keys of a row of the keyboard, from code first, as typed alone and
; with shift.
(data Row (Row int (list int) (list int)))

(def rows () (list Row)
  (cons (Row 2 "1234567890-=" "!@#$%^&*()_+")
  (cons (Row 16 "qwertyuiop[]" "QWERTYUIOP{}")
  (cons (Row 30 "asdfghjkl;'`" "ASDFGHJKL:\"~")
  (cons (Row 43 "\\zxcvbnm,./" "|ZXCVBNM<>?")
  (cons (Row 55 "*" "*")
  (cons (Row 57 " " " ") (nil Row))))))))

; The character of key code on a row, typed alone or shifted; or 0.
(def row_char ((rs (list Row)) (code int) (shifted bool)) int
  (if (is_empty rs)
      0
      (match (head rs)
        ((Row first plain shift)
          (let i (sub code first)
            (if (if (ge i 0) (lt i (length plain)) false)
                (nth_char (if shifted shift plain) i)
                (row_char (tail rs) code shifted)))))))

(def nth_char ((s (list int)) (i int)) int
  (if (eq i 0) (head s) (nth_char (tail s) (sub i 1))))

(def is_lower ((c int)) bool (if (ge c 97) (le c 122) false))

; The character key code types with shift held or not and caps lock on or
; not: caps lock shifts only letters, and shift undoes it. Enter,
; Backspace, Tab, and Esc type their control characters; any other key
; without a character, 0.
(def key_char ((code int) (shift bool) (caps bool)) int
  (if (eq code (key_enter)) 10
  (if (eq code (key_backspace)) 8
  (if (eq code (key_tab)) 9
  (if (eq code (key_esc)) 27
  (let plain (row_char (rows) code false)
    (if (is_lower plain)
        (row_char (rows) code (not (eq shift caps)))
        (row_char (rows) code shift))))))))

; ------------------------------------------------------------- modifiers

; Which modifiers are on, as bits: left shift, right shift, caps lock,
; left and right control.
(def mod_lshift () int 1)
(def mod_rshift () int 2)
(def mod_caps () int 4)
(def mod_lctrl () int 8)
(def mod_rctrl () int 16)

(def has_mod ((mods int) (m int)) bool (not (eq (bit_and mods m) 0)))

(def with_mod ((mods int) (m int) (on bool)) int
  (if on (bit_or mods m) (bit_and mods (bit_xor m -1))))

; mods after key code goes to value: 1 pressed, 0 released, 2 repeated.
; Caps lock turns over when pressed, not when held or released.
(def mods_after ((mods int) (code int) (value int)) int
  (if (eq code (key_lshift)) (with_mod mods (mod_lshift) (not (eq value 0)))
  (if (eq code (key_rshift)) (with_mod mods (mod_rshift) (not (eq value 0)))
  (if (eq code (key_lctrl)) (with_mod mods (mod_lctrl) (not (eq value 0)))
  (if (eq code (key_rctrl)) (with_mod mods (mod_rctrl) (not (eq value 0)))
  (if (if (eq code (key_capslock)) (eq value 1) false)
      (with_mod mods (mod_caps) (not (has_mod mods (mod_caps))))
      mods))))))

(def shifted ((mods int)) bool
  (if (has_mod mods (mod_lshift)) true (has_mod mods (mod_rshift))))

(def controlled ((mods int)) bool
  (if (has_mod mods (mod_lctrl)) true (has_mod mods (mod_rctrl))))

; The character a key event types, with mods as they were before it: 0
; for a release. With control held, a letter types its control
; character, Ctrl-C 3, Ctrl-D 4, Ctrl-U 21, and any other key nothing.
(def event_char ((mods int) (code int) (value int)) int
  (if (eq value 0)
      0
      (if (controlled mods)
          (let plain (key_char code false false)
            (if (is_lower plain) (bit_and plain 31) 0))
          (key_char code (shifted mods) (has_mod mods (mod_caps))))))

; ------------------------------------------------------------------ events

; struct virtio_input_event: le16 type, le16 code, le32 value.
(data InputEvent (InputEvent int int int))

(def ev_key () int 1)

(def event_at ((q IoDevice) (off int)) InputEvent
  (InputEvent (device_read16 q off) (device_read16 q (add off 2)) (device_read32 q (add off 4))))

; ------------------------------------------------------------------ finding

; Whether s holds needle anywhere.
(def holds ((s (list int)) (needle (list int))) bool
  (if (starts_with s needle) true (if (is_empty s) false (holds (tail s) needle))))

; The name transport t's input device gives (virtio 1.2, section 5.8.4):
; select 1, VIRTIO_INPUT_CFG_ID_NAME, then size bytes from offset 8.
(def input_name ((d IoDevice) (t int)) (list int)
  (let s (device_write8 d (treg t (reg_config)) 1)
    (let ss (device_write8 d (treg t (add (reg_config) 1)) 0)
      (let n (min (device_read8 d (treg t (add (reg_config) 2))) 128)
        (config_bytes d (treg t (add (reg_config) 8)) n (nil int))))))

(def config_bytes ((d IoDevice) (off int) (n int) (acc (list int))) (list int)
  (if (le n 0)
      (rev acc)
      (config_bytes d (add off 1) (sub n 1) (cons (device_read8 d off) acc))))

(def is_keyboard_name ((name (list int))) bool (holds name "Keyboard"))

; The first transport from t with an input device whose name holds what,
; such as Keyboard or Tablet, or -1.
(def find_input ((d IoDevice) (what (list int)) (t int)) int
  (let i (find_device d (input_device) t)
    (if (lt i 0)
        -1
        (if (holds (input_name d i) what) i (find_input d what (add i 1))))))

; ------------------------------------------------------------------ roles

; What a driver started as virtio-input ROLE drives: keyboard, the
; default, the device named Keyboard, served as keyboard; or tablet, the
; one named Tablet, served as pointer.
(data Role (Role (list int) (list int) Kind))

; What the driver keeps of what it has been told: the modifiers held, for
; a keyboard; where the pointer is and the buttons down, for a tablet.
(data Kind (Keys int) (Tablet int int int))

(def role_of ((argv (list (list int)))) Role
  (if (any_eq "tablet" argv)
      (Role "Tablet" "pointer" (Tablet 0 0 0))
      (Role "Keyboard" "keyboard" (Keys 0))))

(def ev_syn () int 0)
(def ev_abs () int 3)
(def btn_left () int 272)

; A tablet's state after an event: an axis moved, a button pressed or
; released; and whether the event completes a report, at EV_SYN, so a
; PointerEvent is due.
(data Pointed (Pointed Kind bool))

(def pointed ((k Kind) (type int) (code int) (value int)) Pointed
  (match k
    ((Keys mods) (Pointed k false))
    ((Tablet x y buttons)
      (if (eq type (ev_syn)) (Pointed k true)
      (if (eq type (ev_abs))
          (Pointed (if (eq code 0) (Tablet value y buttons) (if (eq code 1) (Tablet x value buttons) k)) false)
      (if (if (eq type (ev_key)) (if (ge code (btn_left)) (lt code (add (btn_left) 3)) false) false)
          (Pointed (Tablet x y (with_mod buttons (bit_shl 1 (sub code (btn_left))) (not (eq value 0)))) false)
          (Pointed k false)))))))

; ---------------------------------------------------------------- the queue

; The event queue in one DMA page: descriptors at 0, the available ring
; at 256, the used ring at 512, and a buffer of 8 bytes for each entry
; from 1024.
(def ring_size () int 16)
(def avail_off () int 256)
(def used_off () int 512)
(def buffers_off () int 1024)

(def buffer_off ((i int)) int (add (buffers_off) (mul i 8)))

; Descriptors i on, each one buffer the device writes an event into.
(def buffer_descriptors ((addr int) (i int) (acc (list int))) (list int)
  (if (eq i (ring_size))
      (rev acc)
      (buffer_descriptors addr (add i 1) (push (descriptor (add addr (buffer_off i)) 8 (desc_write) 0) acc))))

; The available ring holding every buffer, in order: flags, idx, ring.
(def avail_all () (list int)
  (append (le16 0) (append (le16 (ring_size)) (rev (avail_entries 0 (nil int))))))

(def avail_entries ((i int) (acc (list int))) (list int)
  (if (eq i (ring_size)) acc (avail_entries (add i 1) (push (le16 i) acc))))

; ---------------------------------------------------------------- driving

(def complain ((why (list int))) int
  (let w (write_err (append "virtio-input: " (append why "\n"))) 1))

(def virtio_input () int
  (let r (role_of (args))
    (match r
      ((Role what name kind)
        (match (open_device (virtio_base) (virtio_span))
          ((DeviceFailed fault why) (complain (append "no virtio-mmio transports: " why)))
          ((DeviceOpened d) (found d (find_input d what 0) r)))))))

; No such device is no failure: the board was started without one.
(def found ((d IoDevice) (t int) (r Role)) int
  (match r
    ((Role what name kind)
      (if (lt t 0)
          (let w (write_err (append "virtio-input: no virtio " (append what "\n"))) 0)
          (if (not (is_modern d t))
              (complain (append what "'s transport is legacy, not version 2"))
              (if (not (negotiate d t))
                  (complain (append what " refused its features"))
                  (if (lt (queue_max d t 0) (ring_size))
                      (complain "the event queue is too small")
                      (with_queue d t (dma_alloc 1) r))))))))

(def with_queue ((d IoDevice) (t int) (va int) (r Role)) int
  (if (lt va 0)
      (complain (append "no memory for the queue: " (digits va)))
      (match (dma_open va 1)
        ((DeviceFailed fault why) (complain (append "cannot reach the queue: " why)))
        ((DeviceOpened q) (fill_queue d t q (dma_address va) r)))))

; Gives the device every buffer, then serves the role's name.
(def fill_queue ((d IoDevice) (t int) (q IoDevice) (addr int) (r Role)) int
  (match r
    ((Role what name kind)
      (let ds (put_bytes q 0 (buffer_descriptors addr 0 (nil int)))
        (let av (put_bytes q (avail_off) (avail_all))
          (let s (start_queue d t 0 (ring_size) addr (add addr (avail_off)) (add addr (used_off)))
            (let o (driver_ok d t)
              (let b (barrier)
                (let n (notify d t 0)
                  (listening (Kbd d t q (ring_size) 0 kind (nil int)) name))))))))))

; The driver: the transports' registers and the device's transport, the
; queue's page, the next index to make available and the next used one
; to read, as the rings count them, what it keeps of the events, and the
; ports listening.
(data Kbd (Kbd IoDevice int IoDevice int int Kind (list int)))

(def listening ((k Kbd) (name (list int))) int
  (match k
    ((Kbd d t q avail used kind ls)
      (let port (port_new)
        (if (not (eq (name_register port name) 0))
            (complain (append "cannot register as " name))
            (let b (irq_bind (transport_irq t) port)
              (if (not (eq b 0))
                  (complain (append "cannot bind interrupt " (append (digits (transport_irq t)) (append ": " (digits b)))))
                  (serve k port))))))))

(def serve ((k Kbd) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from payload)
      (if (is_irq_notice (Message from payload) (kbd_irq k))
          (serve (interrupted k) port)
          (serve (requested k payload) port)))))

(def kbd_irq ((k Kbd)) int (match k ((Kbd d t q avail used kind ls) (transport_irq t))))

; Answers a request: listen adds its reply port to those told of events.
(def requested ((k Kbd) (payload (list int))) Kbd
  (let reply (request_reply payload)
    (if (eq (request_body payload) "listen")
        (let s (port_send reply "ok") (with_listener k reply))
        (let s (port_send reply (append "error: no request " (request_body payload))) k))))

(def with_listener ((k Kbd) (port int)) Kbd
  (match k ((Kbd d t q avail used kind ls) (Kbd d t q avail used kind (cons port ls)))))

; The device has used buffers: ends its interrupt, reads each event, gives
; the buffers back, and ends the interrupt with the kernel.
(def interrupted ((k Kbd)) Kbd
  (match k
    ((Kbd d t q avail used kind ls)
      (let st (device_read32 d (treg t (reg_interrupt_status)))
        (let a (device_write32 d (treg t (reg_interrupt_ack)) st)
          (let b (barrier)
            (refilled (drain k (device_read16 q (add (used_off) 2))))))))))

(def refilled ((k Kbd)) Kbd
  (match k
    ((Kbd d t q avail used kind ls)
      (let b (barrier)
        (let i (device_write16 q (add (avail_off) 2) (bit_and avail 65535))
          (let b2 (barrier)
            (let n (notify d t 0)
              (let a (irq_ack (transport_irq t)) k))))))))

; Each used entry from the next to read up to the device's index.
(def drain ((k Kbd) (device_idx int)) Kbd
  (match k
    ((Kbd d t q avail used kind ls)
      (if (eq (bit_and used 65535) device_idx)
          k
          (let id (device_read32 q (add (used_off) (add 4 (mul 8 (mod used (ring_size))))))
            (let k2 (handled (Kbd d t q avail (add used 1) kind ls) (event_at q (buffer_off (mod id (ring_size)))))
              (drain (given_back k2 (mod id (ring_size))) device_idx)))))))

; Buffer id on the available ring again.
(def given_back ((k Kbd) (id int)) Kbd
  (match k
    ((Kbd d t q avail used kind ls)
      (let w (device_write16 q (add (avail_off) (add 4 (mul 2 (mod avail (ring_size))))) id)
        (Kbd d t q (add avail 1) used kind ls)))))

; An event, for a keyboard a key told to every listener with the
; modifiers after it, and for a tablet kept until EV_SYN completes the
; report, then told; anything else is passed over.
(def handled ((k Kbd) (ev InputEvent)) Kbd
  (match ev
    ((InputEvent type code value)
      (match k
        ((Kbd d t q avail used kind ls)
          (match kind
            ((Keys mods)
              (if (not (eq type (ev_key)))
                  k
                  (Kbd d t q avail used (Keys (mods_after mods code value))
                       (tell ls (key_notice (KeyEvent code value (event_char mods code value))) (nil int)))))
            ((Tablet x y buttons)
              (match (pointed kind type code value)
                ((Pointed kind2 report)
                  (Kbd d t q avail used kind2 (if report (tell ls (pointer_of kind2) (nil int)) ls)))))))))))

(def pointer_of ((k Kind)) (list int)
  (match k
    ((Keys mods) (pointer_notice (PointerEvent 0 0 0)))
    ((Tablet x y buttons) (pointer_notice (PointerEvent x y buttons)))))

; Sends payload to each port, keeping those still there: a full queue
; loses the event, but a port that has gone goes from the list.
(def tell ((ls (list int)) (payload (list int)) (kept (list int))) (list int)
  (if (is_empty ls)
      (rev kept)
      (let s (port_send (head ls) payload)
        (tell (tail ls) payload (if (eq s (err_no_port)) kept (cons (head ls) kept))))))
