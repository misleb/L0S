; nap.l0 -- sleeps for the milliseconds of its argument, 20 if none, and
; says whether it slept that long.

(def nap_ms ((argv (list (list int)))) int
  (if (is_empty argv) 20 (int_prefix (head argv) 0)))

(def nap_report ((ms int) (elapsed_ns int)) (list int)
  (if (ge elapsed_ns (mul ms 1000000))
      (append "nap: slept at least " (append (digits ms) " ms\n"))
      (append "nap: woke early, after " (append (digits elapsed_ns) " ns\n"))))

(def nap () int
  (let ms (nap_ms (args))
    (let t0 (clock_ns)
      (let s (sleep_ns (mul ms 1000000))
        (let t1 (clock_ns)
          (let w (write_str (nap_report ms (sub t1 t0)))
            (if (ge (sub t1 t0) (mul ms 1000000)) 0 1)))))))
