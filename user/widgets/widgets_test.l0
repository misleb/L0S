(def none () UiEvent (UiOther 0 ""))

(def status_of ((g Gallery)) (list int) (match g ((Gallery gs s) s)))
(def grid_of ((g Gallery)) UiGridState (match g ((Gallery gs s) gs)))

(def test_select_row () int
  (let g (gallery_update (gallery_new) "procs.select.6" (none))
    (add (check_str "selected" (ui_gs_selected (grid_of g)) "6")
         (check_str "said" (status_of g) "Process 6 selected"))))

(def test_end_process () int
  (check_str "says what it would end"
    (status_of (gallery_update (gallery_update (gallery_new) "procs.select.6" (none)) "app.end" (none)))
    "Would end process 6"))

(def test_refresh () int
  (check_str "counted" (status_of (gallery_update (gallery_new) "app.refresh" (none))) "Refreshed: 14 processes"))

(def test_sort () int
  (match (grid_of (gallery_update (gallery_new) "procs.sort.4" (none)))
    ((UiGridState col desc sel first) (add (check_int "by CPU" col 4) (check_bool "ascending" desc false)))))

(def test_arrow_key () int
  (check_str "down from none, the first by pid"
    (ui_gs_selected (grid_of (gallery_update (gallery_new) "" (UiKey (KeyEvent (ui_key_down) 1 0)))))
    "1"))

; Nothing selected, End Process has no target: Refresh and the titles
; and the rows do.
(def has_target ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (if (eq (ui_node_action (head ns)) a) true (has_target (tail ns) a))))

(def laid ((g Gallery)) (list UiNode) (ui_layout_window (gallery_view g) 640 400 (ui_state_new (UiLight))))

(def test_end_insensitive () int
  (add (check_bool "not without a selection" (has_target (laid (gallery_new)) "app.end") false)
       (check_bool "with one" (has_target (laid (gallery_update (gallery_new) "procs.select.3" (none))) "app.end") true)))

(def test_rows_shown () int
  (add (check_bool "the first" (has_target (laid (gallery_new)) "procs.select.1") true)
       (check_bool "not the last, below the fold" (has_target (laid (gallery_new)) "procs.select.14") false)))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (widgets) 1))
