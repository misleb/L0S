; voice.l0 -- a Piper voice's config (roadmap 0062), the JSON file beside
; its ONNX model, read by json.l0: the rate its samples are made at, the
; three inference scales (the noise of its prior, the length of each
; phoneme, the noise of its durations), and its phoneme map, each
; phoneme, a UTF-8 string of one codepoint, to its ID. A voice of more
; than one speaker is refused, as speak has no use for one yet. Linked
; with JSON as VOICE in the Makefile.

; A voice's config: its rate in Hz, its scales, and its phonemes' IDs.
(data VoiceConfig (VoiceConfig (rate int) (noise float) (length float) (noise_w float) (ids (Map (list int) int))))

; The config in the bytes b, or why it is none.
(def voice_config_of ((b bytes)) (Result VoiceConfig (list int))
  (match (json_whole b 0 (bytes_len b))
    ((Err why) ((Err VoiceConfig (list int)) (append "the config is not JSON: " why)))
    ((Ok j) (voice_config_in j))))

; The config the JSON j holds, or why not.
(def voice_config_in ((j Json)) (Result VoiceConfig (list int))
  (let (rate (voice_int (voice_path j "audio" "sample_rate") 0)
        speakers (voice_int (json_get j "num_speakers") 1)
        noise (voice_float (voice_path j "inference" "noise_scale") 0.667)
        len (voice_float (voice_path j "inference" "length_scale") 1.0)
        w (voice_float (voice_path j "inference" "noise_w") 0.8)
        ids (voice_ids (voice_fields (json_get j "phoneme_id_map")) ((MapEmpty (list int) int))))
    (if (le rate 0) ((Err VoiceConfig (list int)) "the config has no sample rate")
        (not (eq speakers 1)) ((Err VoiceConfig (list int)) (append "a voice of " (append (digits speakers) " speakers, which this does not read")))
        (not (and (map_has ids "_") (and (map_has ids "^") (map_has ids "$")))) ((Err VoiceConfig (list int)) "the config's phoneme map has no _, ^ and $")
        ((Ok VoiceConfig (list int)) (VoiceConfig rate noise len w ids)))))

; Field b of field a of j, if both are there.
(def voice_path ((j Json) (a (list int)) (b (list int))) (Option Json)
  (match (json_get j a)
    ((None) ((None Json)))
    ((Some o) (json_get o b))))

; An int field's value, or d.
(def voice_int ((v (Option Json)) (d int)) int
  (match v
    ((None) d)
    ((Some x) (match (json_int x) ((None) d) ((Some n) n)))))

; A number field's value as a float, or d.
(def voice_float ((v (Option Json)) (d float)) float
  (match v
    ((None) d)
    ((Some x) (match (json_float x) ((None) d) ((Some f) f)))))

; An object field's fields, none if it is missing.
(def voice_fields ((v (Option Json))) (list JField)
  (match v ((None) (nil JField)) ((Some o) (json_fields o))))

; m with each of fs, a phoneme and a list of its one ID, put in.
(def voice_ids ((fs (list JField)) (m (Map (list int) int))) (Map (list int) int)
  (if (is_empty fs)
      m
      (match (head fs)
        ((JField k v) (match (json_at v 0)
                        ((None) (voice_ids (tail fs) m))
                        ((Some x) (match (json_int x)
                                    ((None) (voice_ids (tail fs) m))
                                    ((Some id) (voice_ids (tail fs) (map_put m (bytes_to_list k) id))))))))))

; The ID of the phoneme p, a UTF-8 string; -1 if the voice has none.
(def voice_id ((c VoiceConfig) (p (list int))) int
  (match (map_get (.ids c) p) ((None) -1) ((Some id) id)))
