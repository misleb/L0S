; whistle_test.l0 -- Whistle's model and its stem, without the model:
; a container that is not Whistle refused, the stride-2 convolution's
; taps and padding, and the last stage's order, channel first.
; probes/whistle/stemcheck checks the stem on whistle.cact itself.

; An array of the floats xs.
(def floats ((xs (list float))) (array float) (floats_into xs 0 (array_new (length xs) 0.0)))
(def floats_into ((xs (list float)) (k int) (a (array float))) (array float)
  (if (is_empty xs) a (floats_into (tail xs) (add k 1) (array_set a k (head xs)))))

; Bytes that are no container are refused.
(def test_not_whistle () int
  (match (whistle_of (bytes_from_list "not a model"))
    ((Err why) 0)
    ((Ok w) (check_bool "refused" false true))))

; A stride-2 output of n inputs, padded by one each side.
(def test_half_up () int
  (add (check_int "80" (half_up 80) 40)
       (add (check_int "17" (half_up 17) 9)
            (check_int "1" (half_up 1) 1))))

; A 2 by 2 input of one channel, 1 to 4, to 2 channels whose taps are
; all 1 and all 2: the one output the four's sum, 10, and twice it, the
; padding adding nothing.
(def test_down () int
  (let y (stem_down (floats (cons 1.0 (cons 2.0 (cons 3.0 (cons 4.0 (nil float)))))) 2 2 1 (stem_ks) 2)
    (add (check_int "outputs" (array_len y) 2)
         (add (check_bool "first channel" (eq (array_get y 0) 10.0) true)
              (check_bool "second channel" (eq (array_get y 1) 20.0) true)))))

; Depthwise, each channel its own: 1 to 4 under 1s, 10 to 40 under 2s.
(def test_down_depthwise () int
  (let dy (stem_down (floats (cons 1.0 (cons 10.0 (cons 2.0 (cons 20.0 (cons 3.0 (cons 30.0 (cons 4.0 (cons 40.0 (nil float)))))))))) 2 2 2 (stem_ks) 2)
    (add (check_bool "first" (eq (array_get dy 0) 10.0) true)
         (check_bool "second" (eq (array_get dy 1) 200.0) true))))

; A kernel of 9 taps of 2 channels: 1 for the first, 2 for the second.
(def stem_ks () (array float) (stem_ks_from 0 (array_new 18 0.0)))
(def stem_ks_from ((k int) (a (array float))) (array float)
  (if (ge k 18) a (stem_ks_from (add k 1) (array_set a k (if (eq (mod k 2) 0) 1.0 2.0)))))

; One row of 2 columns of 3 channels, (column, channel), made (channel,
; column).
(def test_flat () int
  (let (x (floats (cons 0.0 (cons 1.0 (cons 2.0 (cons 10.0 (cons 11.0 (cons 12.0 (nil float))))))))
        y (stem_flat x 1 2 3 0 (array_new 6 0.0)))
    (check_bool "channel first" (and (eq (array_get y 1) 10.0) (and (eq (array_get y 2) 1.0) (eq (array_get y 5) 12.0))) true)))
