; transcribe_test.l0 -- what Whistle hears of a WAV file, without the
; model: 16 kHz mono taken as samples, anything else refused, saying
; why. probes/whistle/deccheck and listen on the board hear speech.

; A WAV file of n frames of chans channels at rate, all silence but the
; first sample, -16384.
(def wav_of ((rate int) (chans int) (n int)) bytes
  (let bytes (mul n (mul 2 chans))
    (bytes_from_list (append (wav_header rate chans bytes) (cons 0 (cons 192 (repeat_zeros (sub bytes 2) (nil int))))))))
(def repeat_zeros ((n int) (acc (list int))) (list int)
  (if (le n 0) acc (repeat_zeros (sub n 1) (cons 0 acc))))

; Why a file is refused, or "ok", how many samples, and the first.
(def speech_text ((b bytes)) (list int)
  (match (wav_speech b)
    ((Err why) why)
    ((Ok xs) (append "ok " (append (digits (array_len xs)) (if (eq (array_get xs 0) -0.5) " -0.5" " ?"))))))

; 16 kHz mono of 0.2 s is 3200 samples, -16384 of 32768 being -0.5.
(def test_wav_ok () int
  (check_str "ok" (speech_text (wav_of 16000 1 3200)) "ok 3200 -0.5"))

; 48 kHz and stereo are refused, each saying why.
(def test_wav_format () int
  (add (check_str "rate" (speech_text (wav_of 48000 1 4800)) "WAV file at 48000 Hz; Whistle hears 16000")
       (check_str "stereo" (speech_text (wav_of 16000 2 3200)) "WAV file of 2 channels; Whistle hears one")))

; Under 0.1 s is refused; 30 s and a sample more is taken, to be heard
; in windows.
(def test_wav_length () int
  (add (check_str "short" (speech_text (wav_of 16000 1 1599)) "WAV file under 0.1 s")
       (check_str "over 30 s" (speech_text (wav_of 16000 1 480001)) "ok 480001 -0.5")))

; Over 5 minutes is refused: a header and 4800001 samples of silence,
; made of a block of 64 KB of zeros joined to itself, not a list.
(def test_wav_longest () int
  (let (n 4800001
        z (bytes_from_list (repeat 65536 0))
        body (bytes_concat (cons (bytes_concat (repeat 146 z)) (cons (bytes_from_list (repeat (sub (mul 2 n) (mul 146 65536)) 0)) (nil bytes))))
        b (bytes_concat (cons (bytes_from_list (wav_header 16000 1 (mul 2 n))) (cons body (nil bytes)))))
    (check_str "refused" (speech_text b) "WAV file over 5 minutes")))

; ---------------------------------------------------------------- windows

; The windows, as "S-E" each.
(def windows_text ((ws (list Span))) (list int)
  (join_with " " (windows_words ws (nil (list int)))))
(def windows_words ((ws (list Span)) (acc (list (list int)))) (list (list int))
  (if (is_empty ws) (rev acc) (windows_words (tail ws) (cons (append (digits (.s (head ws))) (append "-" (digits (.e (head ws))))) acc))))

; n samples of 0.5, silent from a up to b.
(def loud_but ((n int) (a int) (b int)) (array float) (silenced (array_new n 0.5) a b))
(def silenced ((xs (array float)) (k int) (b int)) (array float)
  (if (ge k b) xs (silenced (array_set xs k 0.0) (add k 1) b)))

; 30 s or less is one window, the whole.
(def test_one_window () int
  (check_str "whole" (windows_text (transcribe_windows (loud_but 480000 0 0))) "0-480000"))

; 40 s with 100 ms of silence 26.3 s in, the 14th frame of the last 5 s
; of the first 30 (from 400000, 1600 a frame): cut at its middle,
; 421600, and the rest, 13.65 s, one window.
(def test_cut_at_quiet () int
  (check_str "cut" (windows_text (transcribe_windows (loud_but 640000 420800 422400))) "0-421600 421600-640000"))

; All equally loud, the first frame of the last 5 s is the quietest:
; cut at 400800; then 400800 on, 239200 samples, the rest.
(def test_cut_when_even () int
  (check_str "first" (windows_text (transcribe_windows (loud_but 640000 0 0))) "0-400800 400800-640000"))

; A piece left under 0.1 s is not heard: 480001 samples, quiet in the
; last frame of the first 30 s, cut at 479200, leaves 801.
(def test_short_tail () int
  (check_str "dropped" (windows_text (transcribe_windows (loud_but 480001 478400 480000))) "0-479200"))

; A span's samples copied out: 3 of 5, from the second.
(def test_span () int
  (let a (span_of (array_from (cons 1.0 (cons 2.0 (cons 3.0 (cons 4.0 (cons 5.0 (nil float)))))) 0.0) (Span 1 4))
    (add (check_int "three" (array_len a) 3)
         (check_bool "2 to 4" (and (eq (array_get a 0) 2.0) (eq (array_get a 2) 4.0)) true))))

; Bytes that are no WAV file say so as parse_wav does.
(def test_not_wav () int
  (check_bool "refused" (is_empty (speech_text (bytes_from_list "not a wav file"))) false))
