; transcribe_test.l0 -- what Whistle hears of a WAV file, without the
; model: 16 kHz mono taken as samples, anything else refused, saying
; why. probes/whistle/deccheck and listen on the board hear speech.

; A WAV file of n frames of chans channels at rate, all silence but the
; first sample, -16384.
(def wav_of ((rate int) (chans int) (n int)) bytes
  (let bytes (mul n (mul 2 chans))
    (bytes_from_list (append (wav_header rate chans bytes) (cons 0 (cons 192 (repeat_zeros (sub bytes 2) (nil int))))))))
(def repeat_zeros ((n int) (acc (list int))) (list int)
  (if (le n 0) acc (repeat_zeros (sub n 1) (cons 0 acc))))

; Why a file is refused, or "ok", how many samples, and the first.
(def speech_text ((b bytes)) (list int)
  (match (wav_speech b)
    ((Err why) why)
    ((Ok xs) (append "ok " (append (digits (array_len xs)) (if (eq (array_get xs 0) -0.5) " -0.5" " ?"))))))

; 16 kHz mono of 0.2 s is 3200 samples, -16384 of 32768 being -0.5.
(def test_wav_ok () int
  (check_str "ok" (speech_text (wav_of 16000 1 3200)) "ok 3200 -0.5"))

; 48 kHz and stereo are refused, each saying why.
(def test_wav_format () int
  (add (check_str "rate" (speech_text (wav_of 48000 1 4800)) "WAV file at 48000 Hz; Whistle hears 16000")
       (check_str "stereo" (speech_text (wav_of 16000 2 3200)) "WAV file of 2 channels; Whistle hears one")))

; Under 0.1 s, and over 30 s, are refused.
(def test_wav_length () int
  (add (check_str "short" (speech_text (wav_of 16000 1 1599)) "WAV file under 0.1 s")
       (check_str "long" (speech_text (wav_of 16000 1 480001)) "WAV file over 30 s; longer is not yet heard")))

; Bytes that are no WAV file say so as parse_wav does.
(def test_not_wav () int
  (check_bool "refused" (is_empty (speech_text (bytes_from_list "not a wav file"))) false))
