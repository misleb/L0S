; phonemes_test.l0 -- tests of phonemes.l0, on a dictionary of a few
; lines in CMUdict's form, its words sorted as CMUdict's are. The
; phonemes expected are espeak-ng's en-us for the same words
; (testdata/espeak-words.txt and probes/piper/oracle.py's sentences).

; A small CMUdict.
(def t_dict () bytes
  (bytes_from_list (join_with "\n" (split_on 124 "abort AH0 B AO1 R T|airfare EH1 R F EH2 R|board B AO1 R D|forty F AO1 R T IY0|hello HH AH0 L OW1|hello(2) HH EH0 L OW1|speaking S P IY1 K IH0 NG|world W ER1 L D # a comment"))))

; The phonemizer over it.
(def t_p () Phonemizer (phon_new (t_dict)))

(def test_dict_finds_first_pronunciation () int
  (match (phon_dict_find (t_dict) "hello")
    ((None) (fail_because "hello" "not found"))
    ((Some ts) (check_str "hello" (unwords ts) "HH AH0 L OW1"))))

(def test_dict_drops_comment () int
  (match (phon_dict_find (t_dict) "world")
    ((None) (fail_because "world" "not found"))
    ((Some ts) (check_str "world" (unwords ts) "W ER1 L D"))))

(def test_dict_misses () int
  (add (check_bool "between" (match (phon_dict_find (t_dict) "cat") ((None) true) ((Some ts) false)) true)
       (check_bool "after" (match (phon_dict_find (t_dict) "zebra") ((None) true) ((Some ts) false)) true)))

; espeak-ng: ɐbˈɔːɹt, the first unstressed AH a word's ɐ.
(def test_ipa_initial_schwa () int
  (check_str "abort" (phon_word (t_p) "abort") "ɐbˈɔːɹt"))

; espeak-ng: ˈɛɹfɛɹ, the secondary right after the primary unmarked.
(def test_ipa_secondary_dropped () int
  (check_str "airfare" (phon_word (t_p) "airfare") "ˈɛɹfɛɹ"))

; espeak-ng: fˈɔːɹɾi, a T after R and before an unstressed vowel a flap.
(def test_ipa_flap_after_r () int
  (check_str "forty" (phon_word (t_p) "forty") "fˈɔːɹɾi"))

; espeak-ng: ˈæbɹəɡˌeɪɾᵻd, a flap, ᵻ in -ed after T, ɹ for R.
(def test_ipa_ed_ending () int
  (check_str "abrogated" (phon_ipa (split_spaces "AE1 B R AH0 G EY2 T IH0 D")) "ˈæbɹəɡˌeɪɾᵻd"))

; espeak-ng: ɐdvˈaɪzɚɹi, an ɹ after ER0 before a vowel.
(def test_ipa_er_before_vowel () int
  (check_str "advisory" (phon_ipa (split_spaces "AH0 D V AY1 Z ER0 IY0")) "ɐdvˈaɪzɚɹi"))

; Words not in the dictionary, by the rules; espeak-ng: kwˈɪk, ʃˈɪp.
(def test_rules_words () int
  (add (check_str "quick" (phon_word (t_p) "quick") "kwˈɪk")
       (check_str "ship" (phon_word (t_p) "ship") "ʃˈɪp")))

(def test_rules_arpabet () int
  (check_str "phone" (unwords (phon_lts (t_p) "phone")) "F OW1 N"))

(def test_cardinal () int
  (add (check_str "1234" (unwords (phon_cardinal 1234)) "one thousand two hundred thirty four")
       (check_str "90" (unwords (phon_cardinal 90)) "ninety")))

(def test_year () int
  (add (check_str "1999" (unwords (phon_year 1999)) "nineteen ninety nine")
       (check_str "1905" (unwords (phon_year 1905)) "nineteen oh five")))

; The words of the text's tokens, marks as themselves.
(def t_words ((t (list int))) (list int)
  (unwords (t_token_words (phon_tokens t))))
(def t_token_words ((ts (list PhonToken))) (list (list int))
  (if (is_empty ts) (nil (list int))
      (cons (match (head ts) ((PhonWord w) w) ((PhonMark c) (cons c (nil int)))) (t_token_words (tail ts)))))

(def test_tokens_numbers () int
  (add (check_str "comma" (t_words "1,234 dogs") "one thousand two hundred thirty four dogs")
       (check_str "ordinal" (t_words "the 21st") "the twenty first")))

(def test_tokens_money_and_percent () int
  (add (check_str "money" (t_words "$3.50") "three dollars and fifty cents")
       (check_str "percent" (t_words "50%") "fifty percent")))

(def test_tokens_time_and_decimal () int
  (add (check_str "time" (t_words "3:05") "three oh five")
       (check_str "decimal" (t_words "2.75") "two point seven five")))

(def test_tokens_abbreviation () int
  (check_str "dr" (t_words "Dr. Smith said so.") "doctor smith said so ."))

(def test_tokens_marks () int
  (check_str "marks" (t_words "Wait... what?! Yes") "wait . what ? ! yes"))

(def test_sentence_as_piper () int
  (check_strs "hello" (phon_sentences (t_p) "Hello, world!") (cons "həlˈoʊ, wˈɜːld!" (nil (list int)))))

(def test_sentences_split () int
  (check_strs "two" (phon_sentences (t_p) "Hello. The board speaking!")
              (cons "həlˈoʊ." (cons "ðə bˈɔːɹd spˈiːkɪŋ!" (nil (list int))))))

; espeak-ng: ɪɾ ɪz, it's t a flap before a word starting with a vowel.
(def test_sentence_flap_across_words () int
  (check_strs "it is" (phon_sentences (t_p) "It is.") (cons "ɪɾ ɪz." (nil (list int)))))

; A config of the IDs Piper's voices have.
(def t_config () VoiceConfig
  (VoiceConfig 22050 0.667 1.0 0.8 (phon_pairs_ids (split_spaces "_=0 ^=1 $=2 32=3 ,=8 h=20 l=24 ə=59 ˈ=120 o=27 ʊ=100") ((MapEmpty (list int) int)))))
(def phon_pairs_ids ((ws (list (list int))) (m (Map (list int) int))) (Map (list int) int)
  (if (is_empty ws)
      m
      (let (k (up_to 61 (head ws))
            v (match (word_number (drop (head ws) (add (length k) 1))) ((None) 0) ((Some n) n)))
        (phon_pairs_ids (tail ws) (map_put m (if (list_eq k "32") " " k) v)))))

; Piper's IDs of həlˈoʊ: ^ _, then each codepoint and _, then $.
(def test_ids () int
  (check_str "ids" (unwords (t_digits (phon_ids (t_config) "həlˈoʊ"))) "1 0 20 0 59 0 24 0 120 0 27 0 100 0 2"))
(def t_digits ((ns (list int))) (list (list int))
  (if (is_empty ns) (nil (list int)) (cons (digits (head ns)) (t_digits (tail ns)))))

(def test_ids_skip_unknown () int
  (check_str "ids" (unwords (t_digits (phon_ids (t_config) "hx"))) "1 0 20 0 2"))
