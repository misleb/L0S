; voice_test.l0 -- tests of voice.l0, on configs written here.

; A config as Piper writes one, cut down to what is read.
(def t_config () (list int)
  "{\"audio\":{\"sample_rate\":22050},\"inference\":{\"noise_scale\":0.667,\"length_scale\":1,\"noise_w\":0.333},\"num_speakers\":1,\"phoneme_id_map\":{\"_\":[0],\"^\":[1],\"$\":[2],\" \":[3],\"ə\":[59]}}")

(def test_config_read () int
  (match (voice_config_of (bytes_from_list (t_config)))
    ((Err why) (fail_because "read" why))
    ((Ok c) (add (check_int "rate" (.rate c) 22050)
                 (add (check_int "schwa" (voice_id c "ə") 59)
                      (check_int "none" (voice_id c "q") -1))))))

(def test_config_scales () int
  (match (voice_config_of (bytes_from_list (t_config)))
    ((Err why) (fail_because "read" why))
    ((Ok c) (add (check_int "noise w" (float_to_int (float_mul (.noise_w c) 1000.0)) 333)
                 (check_int "length" (float_to_int (.length c)) 1)))))

(def test_config_refuses_speakers () int
  (match (voice_config_of (bytes_from_list "{\"audio\":{\"sample_rate\":22050},\"num_speakers\":4,\"phoneme_id_map\":{}}"))
    ((Err why) (check_str "why" why "a voice of 4 speakers, which this does not read"))
    ((Ok c) (fail_because "read" "a voice of 4 speakers read"))))

(def test_config_refuses_no_rate () int
  (match (voice_config_of (bytes_from_list "{\"phoneme_id_map\":{}}"))
    ((Err why) (check_str "why" why "the config has no sample rate"))
    ((Ok c) (fail_because "read" "no rate read"))))

(def test_config_refuses_no_pad () int
  (match (voice_config_of (bytes_from_list "{\"audio\":{\"sample_rate\":16000},\"phoneme_id_map\":{\"a\":[14]}}"))
    ((Err why) (check_str "why" why "the config's phoneme map has no _, ^ and $"))
    ((Ok c) (fail_because "read" "no pad read"))))
