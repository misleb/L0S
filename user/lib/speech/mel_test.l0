; mel_test.l0 -- Whistle's front end against cactus-needle's own, on
; testdata/chirp.wav, half a second of a chirp from 200 Hz to 4 kHz with
; a little noise (probes/whistle/fixture.py made it and what the
; reference makes of it); and the logarithm, the exponential and the
; FFT it takes.

; A decimal of the fixture, as -1.7466 or 0.000000: its sign, its
; digits before and after the point.
(def decimal ((s (list int))) float
  (if (is_empty s) 0.0
      (eq (head s) 45) (float_neg (decimal (tail s)))
      (let (whole (up_to 46 s)
            frac (drop s (add (length whole) 1)))
        (float_add (float_from_int (int_prefix whole 0))
                   (float_div (float_from_int (int_prefix frac 0)) (float_from_int (pow10 (length frac))))))))

; 10 to the n.
(def pow10 ((n int)) int (if (le n 0) 1 (mul 10 (pow10 (sub n 1)))))

; Each word of each line of s as a decimal, in order, as an array.
(def decimals ((ls (list (list int)))) (array float)
  (let ws (concat_words ls (nil (list int)))
    (decimals_into ws 0 (array_new (length ws) 0.0))))
(def concat_words ((ls (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty ls) (rev acc) (concat_words (tail ls) (rev_onto (split_spaces (head ls)) acc))))
(def decimals_into ((ws (list (list int))) (k int) (a (array float))) (array float)
  (if (is_empty ws) a (decimals_into (tail ws) (add k 1) (array_set a k (decimal (head ws))))))

; The largest distance between a's and b's entries from k on, every
; step-th of b's against a's at that place.
(def most_apart ((a (array float)) (b (array float)) (step int) (k int) (m float)) float
  (if (ge k (array_len b)) m
      (let d (float_sub (array_get a (mul k step)) (array_get b k))
        (most_apart a b step (add k 1) (float_max m (if (float_lt d 0.0) (float_neg d) d))))))

; The chirp's samples, -1 to 1: its 16-bit ones over 32768.
(def chirp () (array float)
  (match (read_whole "user/lib/speech/testdata/chirp.wav")
    ((Err why) (array_new 0 0.0))
    ((Ok b)
      (match (parse_wav b)
        ((WavBad why) (array_new 0 0.0))
        ((Wav rate chans s e) (samples_of b s (div (sub e s) 2) 0 (array_new (div (sub e s) 2) 0.0)))))))

; n 16-bit samples of b from s, as floats over 32768, from k.
(def samples_of ((b bytes) (s int) (n int) (k int) (a (array float))) (array float)
  (if (ge k n) a
      (let v (le_u16_at b (add s (mul 2 k)))
        (samples_of b s n (add k 1) (array_set a k (float_div (float_from_int (if (ge v 32768) (sub v 65536) v)) 32768.0))))))

; A fixture's lines, its first, the count, left out.
(def fixture ((name (list int))) (list (list int))
  (match (read_whole (append "user/lib/speech/testdata/" name))
    ((Err why) (nil (list int)))
    ((Ok b) (lines (bytes_to_list b)))))

; The mel filters, every 37th entry, as the reference makes them, to
; within a millionth.
(def test_mel_matrix () int
  (let (want (decimals (fixture "mel.sample"))
        got (mel_matrix))
    (add (check_int "entries" (array_len want) 556)
         (check_bool "within a millionth" (float_lt (most_apart got want 37 0 0.0) 0.000001) true))))

; The chirp's 50 frames of 80, every one within a thousandth of the
; reference's, which works in 32 bits to this one's 64.
(def test_features () int
  (let (xs (chirp)
        f (fixture "chirp.features")
        want (decimals (tail f))
        got (mel_features xs (array_len xs) (mel_matrix)))
    (add (check_int "samples" (array_len xs) 8000)
         (add (check_int "frames" (div (array_len got) 80) 50)
              (add (check_int "values" (array_len want) 4000)
                   (check_bool "within a thousandth" (float_lt (most_apart got want 1 0 0.0) 0.001) true))))))

; ln and e: ln 1 is 0, ln e is 1, ln 1000, and e to its log back.
(def test_ln_exp () int
  (add (check_bool "ln 1" (eq (float_ln 1.0) 0.0) true)
       (add (check_bool "ln e" (float_lt (float_abs (float_sub (float_ln 2.718281828459045) 1.0)) 0.000000000000001) true)
            (add (check_bool "ln 1000" (float_lt (float_abs (float_sub (float_ln 1000.0) 6.907755278982137)) 0.000000000001) true)
                 (check_bool "exp ln" (float_lt (float_abs (float_sub (float_exp (float_ln 6.4)) 6.4)) 0.000000000001) true)))))

(def float_abs ((x float)) float (if (float_lt x 0.0) (float_neg x) x))

; The FFT of 1, 0, 0, ... is 1 everywhere; of a cosine of 1 cycle in 8,
; 4 at bins 1 and 7, 0 elsewhere.
(def test_fft () int
  (let (imp (fft (array_set (array_new 8 0.0) 0 1.0) (array_new 8 0.0) 8)
        cos8 (fft (cosine 8 0 (array_new 8 0.0)) (array_new 8 0.0) 8))
    (add (check_bool "impulse" (and (eq (array_get (.re imp) 3) 1.0) (eq (array_get (.im imp) 5) 0.0)) true)
         (add (check_bool "bin 1" (float_lt (float_abs (float_sub (array_get (.re cos8) 1) 4.0)) 0.000000001) true)
              (check_bool "bin 2" (float_lt (float_abs (array_get (.re cos8) 2)) 0.000000001) true)))))

; cos (2 pi k / n) from k on.
(def cosine ((n int) (k int) (a (array float))) (array float)
  (if (ge k n) a (cosine n (add k 1) (array_set a k (float_cos (float_div (float_mul 6.283185307179586 (float_from_int k)) (float_from_int n)))))))
