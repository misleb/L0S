; A window of a compositor whose pid is 9, its buttons as given, its
; nodes two buttons side by side.
(def nodes () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    100 34 (ui_state_new (UiLight))))

(def win_of ((st UiState) (held int)) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoDevice 0) 100 34 0) 4 (ui_face_1x (array_new 0 0)) st (nodes) held 0 (UiMem 0 1 100 34 (UiNoSwap))))

(def plain () UiWin (win_of (ui_state_new (UiLight)) 0))

(def event_text ((ev UiEvent)) (list int)
  (match ev
    ((UiKey k) "key")
    ((UiPress x y b) (append "press " (append (digits x) (append "," (digits y)))))
    ((UiRelease x y b) "release")
    ((UiMotion x y b) "motion")
    ((UiLeave) "leave")
    ((UiFocus f) (if f "front" "backdrop"))
    ((UiScroll x y dx dy) (append "scroll " (append (digits x) (append "," (append (digits y) (append " " (digits dy)))))))
    ((UiResize rw rh) (append "resize " (append (digits rw) (append "x" (digits rh)))))
    ((UiExit p s) (append "exit " (digits p)))
    ((UiOther f p) (append "other " (digits f)))))

(def test_ui_event_resize () int
  (add (check_str "a size asked" (event_text (ui_event_of (plain) (Message 9 (size_notice 300 200)))) "resize 300x200")
       (check_str "from anyone else, nothing" (event_text (ui_event_of (plain) (Message 8 (size_notice 300 200)))) "other 8")))

(def test_ui_resize_same_size () int
  (check_str "the size it has: nothing to do" (routed_action (ui_route (plain) (UiResize 100 34))) ""))

(def test_ui_event_pointer () int
  (add (check_str "a press" (event_text (ui_event_of (plain) (Message 9 (pointer_notice (PointerEvent 5 6 1))))) "press 5,6")
       (add (check_str "a move" (event_text (ui_event_of (plain) (Message 9 (pointer_notice (PointerEvent 5 6 0))))) "motion")
            (check_str "a release" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 1) (Message 9 (pointer_notice (PointerEvent 5 6 0))))) "release"))))

; The right button, 2, and the middle, 4, do nothing: only the left is a
; press, and the left let go while the right is held is a release.
(def test_ui_event_left_only () int
  (add (check_str "the right" (event_text (ui_event_of (plain) (Message 9 (pointer_notice (PointerEvent 5 6 2))))) "motion")
       (add (check_str "the middle" (event_text (ui_event_of (plain) (Message 9 (pointer_notice (PointerEvent 5 6 4))))) "motion")
            (check_str "left let go" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 1) (Message 9 (pointer_notice (PointerEvent 5 6 2))))) "release"))))

(def test_ui_event_notices () int
  (add (check_str "left" (event_text (ui_event_of (plain) (Message 9 (leave_notice)))) "leave")
       (add (check_str "focus" (event_text (ui_event_of (plain) (Message 9 (focus_notice false)))) "backdrop")
            (check_str "a key" (event_text (ui_event_of (plain) (Message 9 (key_notice (KeyEvent 30 1 97))))) "key"))))

(def test_ui_event_wheel () int
  (add (check_str "the wheel" (event_text (ui_event_of (plain) (Message 9 (wheel_notice (WheelEvent 5 6 0 3))))) "scroll 5,6 3")
       (check_str "not the compositor's" (event_text (ui_event_of (plain) (Message 5 (wheel_notice (WheelEvent 5 6 0 3))))) "other 5")))

(def test_ui_event_others () int
  (add (check_str "an exit" (event_text (ui_event_of (plain) (Message 0 (exit_notice 12 0)))) "exit 12")
       (check_str "not the compositor" (event_text (ui_event_of (plain) (Message 5 (pointer_notice (PointerEvent 5 6 1))))) "other 5")))

(def routed_action ((r UiRouted)) (list int) (match r ((UiRouted w a) a)))
(def routed_win ((r UiRouted)) UiWin (match r ((UiRouted w a) w)))

; A press and a release on a: its action; a press on a let go on b: none.
(def test_ui_click () int
  (let pressed (routed_win (ui_route (plain) (UiPress 10 10 1)))
    (add (check_str "pressed, shown" (ui_st_pressed (ui_win_state pressed)) "a")
         (add (check_str "released on it" (routed_action (ui_route pressed (UiRelease 10 10 0))) "a")
              (check_str "released on another" (routed_action (ui_route pressed (UiRelease 45 10 0))) "")))))

(def test_ui_hover () int
  (add (check_str "over b" (ui_st_hover (ui_win_state (routed_win (ui_route (plain) (UiMotion 45 10 0))))) "b")
       (check_str "gone" (ui_st_hover (ui_win_state (routed_win (ui_route (win_of (ui_st_hovering (ui_state_new (UiLight)) "b") 0) (UiLeave))))) "")))

(def test_ui_keyboard () int
  (let tabbed (routed_win (ui_route (plain) (UiKey (KeyEvent (ui_key_tab) 1 9))))
    (add (check_str "Tab, to the first" (ui_st_focus (ui_win_state tabbed)) "a")
         (add (check_str "Enter sets it off" (routed_action (ui_route tabbed (UiKey (KeyEvent (ui_key_enter) 1 10)))) "a")
              (check_str "not on release" (routed_action (ui_route tabbed (UiKey (KeyEvent (ui_key_enter) 0 0)))) "")))))

(def test_ui_backdrop () int
  (check_bool "in the backdrop" (ui_st_backdrop (ui_win_state (routed_win (ui_route (plain) (UiFocus false))))) true))

(def rects_text ((rs (list Rect))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (append (digits h) (append " " (rects_text (tail rs))))))))))))))

(def hovered_b () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    100 34 (ui_st_hovering (ui_state_new (UiLight)) "b")))

(def test_ui_changed () int
  (add (check_str "nothing" (rects_text (ui_changed (nodes) (nodes) (Rect 0 0 100 34))) "")
       (add (check_str "only b" (rects_text (ui_changed (nodes) (hovered_b) (Rect 0 0 100 34))) "40,0 34x34 ")
            (check_str "everything, the first time" (rects_text (ui_changed (nil UiNode) (nodes) (Rect 0 0 100 34))) "0,0 100x34 "))))

; Two buttons at the start of a row, laid out w wide: wider, the ground
; grows and the buttons stay.
(def two_at ((w int)) (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    w 34 (ui_state_new (UiLight))))

; 100 wide grown to 140: only the strip the ground grew by, from 100,
; 40 wide; the buttons, whose ops are all as they were, not at all.
(def test_ui_changed_grown () int
  (check_str "the strip alone" (rects_text (ui_changed (two_at 100) (two_at 140) (Rect 0 0 140 34))) "100,0 40x34 "))

; An x moved 20 right in a cell 10 wide: damage where its character was
; and is, 8 wide, what the text paints, not its cell; nothing if it stays.
(def test_ui_changed_moved () int
  (let a (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "x" (UiStart) 0 false 1) (nil UiPaint)) "" false) (nil UiNode))
    (let b (cons (UiNode (Rect 20 0 10 10) (cons (UiPText (Rect 20 0 10 10) "x" (UiStart) 0 false 1) (nil UiPaint)) "" false) (nil UiNode))
      (add (check_str "moved: where its character was and is" (rects_text (ui_changed a b (Rect 0 0 40 10))) "0,0 8x10 20,0 8x10 ")
           (check_str "as it was" (rects_text (ui_changed a a (Rect 0 0 40 10))) "")))))

; ------------------------------------------------------------- scrolling

; The grid of grid_win scrolled from row 0 to 3, three rows of 30: its
; area, from 32 under the header, 300 high, moved 90 up.
(def test_ui_scroll_moved () int
  (match (ui_scroll_moved (ui_win_nodes (grid_win 3)) (ui_win_nodes (grid_win 0)))
    ((UiScrollMove r dy) (add (check_str "the area" (rects_text (cons r (nil Rect))) "0,32 400x300 ")
                              (check_int "moved up" dy 90)))
    ((UiNoScrollMove) (fail_because "a scroll" "none"))))

(def test_ui_scroll_not_moved () int
  (add (check_bool "the same rows" (eq (ui_scroll_moved (ui_win_nodes (grid_win 3)) (ui_win_nodes (grid_win 3))) (UiNoScrollMove)) true)
       (check_bool "a page or more" (eq (ui_scroll_moved (ui_win_nodes (grid_win 10)) (ui_win_nodes (grid_win 0))) (UiNoScrollMove)) true)))

; Once the area's pixels have moved 90 up, what is painted again: the
; strip of three rows at its foot, 242 to 332, and the scrollbar's slider,
; 6 wide from 391, where it is, 79 to 225, and where it was, moved up
; with the rest and cut to the area, the rest of 32 to 225, apart, as no
; pixel is painted twice; not the seven rows that moved.
(def test_ui_scrolled_changed () int
  (check_str "the strip and the slider"
    (rects_text (ui_scrolled_changed (ui_win_nodes (grid_win 0)) (ui_win_nodes (grid_win 3)) (Rect 0 0 400 332) (Rect 0 32 400 300) 90))
    "0,242 400x90 391,79 6x146 391,32 6x47 "))

; Damage made disjoint, the largest first: a thin column and a wide strip
; across it stay a strip and the column less it, not the whole area
; holding both; a text in its row is no more than the row.
(def test_ui_merged () int
  (add (check_str "a column across a strip"
         (rects_text (ui_merged (cons (Rect 390 0 6 300) (cons (Rect 0 200 400 100) (nil Rect))) (Rect 0 0 400 300)))
         "0,200 400x100 390,0 6x200 ")
       (check_str "a text in its row"
         (rects_text (ui_merged (cons (Rect 10 205 50 16) (cons (Rect 0 200 400 30) (nil Rect))) (Rect 0 0 400 300)))
         "0,200 400x30 ")))

; A window 400 by 332 that is a grid of twenty rows, ten shown under its
; 32-row header, from first: the most first is 10. Its scrollbar's strip
; is x 388 to 400 and y 32 to 332; its slider is half of the 300, 150
; long, so it travels 150, 15 a row, and from the first row is at 32.
(def g_cols () (list UiColumn) (cons (UiColumn "PID" 0 (UiEnd) true) (nil UiColumn)))

(def g_rows ((i int) (acc (list UiRow))) (list UiRow)
  (if (eq i 0) acc (g_rows (sub i 1) (cons (UiRow (digits i) (cons (UiCellNum i "") (nil UiCell))) acc))))

(def grid_win ((first int)) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoDevice 0) 400 332 0) 4 (ui_face_1x (array_new 0 0)) (ui_state_new (UiLight))
         (ui_layout_window (UiGrid (UiGridView "g" (g_cols) (g_rows 20 (nil UiRow)) (UiGridState 0 false "" first)))
                           400 332 (ui_state_new (UiLight)))
         0 0 (UiMem 0 1 400 332 (UiNoSwap))))

; A step down is three rows; up from the first, nothing to do.
(def test_ui_wheel_scrolls () int
  (add (check_str "down" (routed_action (ui_route (grid_win 0) (UiScroll 100 100 0 1))) "g.scrollto.3")
       (add (check_str "up, at the top" (routed_action (ui_route (grid_win 0) (UiScroll 100 100 0 -1))) "")
            (check_str "on the scrollbar too" (routed_action (ui_route (grid_win 4) (UiScroll 395 100 0 -1))) "g.scrollto.1"))))

(def test_ui_wheel_elsewhere () int
  (check_str "the header does not scroll" (routed_action (ui_route (grid_win 0) (UiScroll 100 10 0 1))) ""))

; Pressed at 50 on the slider, 18 below its top: taken there, not moved.
; Dragged to 125, its top goes to 107, 75 down the strip, five rows.
(def test_ui_slider_drag () int
  (let pressed (ui_route (grid_win 0) (UiPress 395 50 1))
    (add (check_str "taken, not moved" (routed_action pressed) "")
         (add (check_int "held 18 below its top" (ui_win_grab (routed_win pressed)) 18)
              (check_str "dragged five rows" (routed_action (ui_route (routed_win pressed) (UiMotion 395 125 1))) "g.scrollto.5")))))

; Pressed at 300, below the slider: brought there by its middle, 75, so
; its top at 225, past the end of its travel: the last row, 10.
(def test_ui_strip_press () int
  (let pressed (ui_route (grid_win 0) (UiPress 395 300 1))
    (add (check_str "brought there" (routed_action pressed) "g.scrollto.10")
         (check_int "held by its middle" (ui_win_grab (routed_win pressed)) 75))))

(def test_ui_motion_unpressed () int
  (check_str "no drag without a press" (routed_action (ui_route (grid_win 0) (UiMotion 395 125 0))) ""))

(def test_ui_win_scroller () int
  (check_bool "where the grid is" (eq (ui_win_scroller (grid_win 4) "g") (UiScroller 4 10 10)) true))

; ---------------------------------------------------------------- entries

; A window 300 by 34: an entry called e, 200 wide from 0, its text from
; 9; then a button, b, 6 after it.
(def entry_nodes () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiEntry "e" (ui_entry_new "ab") "" 200)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    300 34 (ui_state_new (UiLight))))

(def entry_win ((focus (list int))) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoDevice 0) 300 34 0) 4 (ui_face_1x (array_new 0 0))
         (ui_st_focusing (ui_state_new (UiLight)) focus) (entry_nodes) 0 0 (UiMem 0 1 300 34 (UiNoSwap))))

(def key ((code int) (ch int)) UiEvent (UiKey (KeyEvent code 1 ch)))

; Pressed at 22, past the middle of its second character, 17 to 25: the
; focus on it, the cursor before character 2, and nothing left pressed.
(def test_entry_press () int
  (let r (ui_route (entry_win "") (UiPress 22 10 1))
    (add (check_str "the cursor placed" (routed_action r) "e.place.2")
         (add (check_str "focused" (ui_st_focus (ui_win_state (routed_win r))) "e.entry")
              (check_str "not pressed" (ui_st_pressed (ui_win_state (routed_win r))) "")))))

(def test_entry_release () int
  (let pressed (routed_win (ui_route (entry_win "") (UiPress 22 10 1)))
    (check_str "sets nothing off" (routed_action (ui_route pressed (UiRelease 22 10 0))) "")))

; With the focus on it, keys edit it, Space among them, and Enter
; activates it.
(def test_entry_keys () int
  (add (check_str "a letter" (routed_action (ui_route (entry_win "e.entry") (key 30 97))) "e.edit")
       (add (check_str "Space" (routed_action (ui_route (entry_win "e.entry") (key (ui_key_space) 32))) "e.edit")
            (check_str "Enter" (routed_action (ui_route (entry_win "e.entry") (key (ui_key_enter) 10))) "e.activate"))))

(def test_entry_tab () int
  (check_str "Tab still moves on" (ui_st_focus (ui_win_state (routed_win (ui_route (entry_win "e.entry") (key (ui_key_tab) 9))))) "b"))

; The focus on an entry no longer laid out, as when its dialog has gone:
; it takes no keys, and Enter sets off what the focus is on, as ever.
(def test_entry_gone () int
  (add (check_str "a letter" (routed_action (ui_route (entry_win "f.entry") (key 30 97))) "")
       (check_str "Enter" (routed_action (ui_route (entry_win "f.entry") (key (ui_key_enter) 10))) "f.entry")))

(def et_of ((t UiEntryText)) (list int)
  (append (ui_entry_text t) (append "|" (digits (ui_entry_cursor t)))))

(def test_entry_update () int
  (add (check_str "typed" (et_of (ui_entry_update "e" (ui_entry_new "ab") "e.edit" (key 46 99))) "abc|3")
       (add (check_str "placed" (et_of (ui_entry_update "e" (ui_entry_new "ab") "e.place.1" (UiPress 0 0 1))) "ab|1")
            (check_str "another's" (et_of (ui_entry_update "e" (ui_entry_new "ab") "f.edit" (key 46 99))) "ab|2"))))

(def test_win_focusing () int
  (check_str "put on it" (ui_st_focus (ui_win_state (ui_win_focusing (plain) "e.entry"))) "e.entry"))
