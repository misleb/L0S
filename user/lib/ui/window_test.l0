; A window of a compositor whose pid is 9, its buttons as given, its
; nodes two buttons side by side.
(def nodes () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    100 34 (ui_state_new (UiLight))))

(def win_of ((st UiState) (held int)) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoRegion 0) 100 34 0) 4 (ui_face_none) st (nodes) held 0 (ui_click_none) (UiMem 0 1 100 34 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new) ""))

(def plain () UiWin (win_of (ui_state_new (UiLight)) 0))

; ------------------------------------------------------------ pacing

; The window waiting for a frame and a release since 1000, as it is once
; it has given wm a buffer.
(def waiting () UiWin
  (match (plain)
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (UiWin c id cv port font st ns b g k (UiMem 0 1 100 34 (UiNoSwap) (UiDb 7 (UiNoBack) true true 1000)) csd cl lp sh))))

; It waits while either is awaited, but no longer than ui_pace_ns.
(def test_win_waits () int
  (add (check_bool "both" (ui_win_waits (waiting) 2000) true)
       (add (check_bool "release still" (ui_win_waits (ui_win_paced_by (waiting) true false) 2000) true)
            (add (check_bool "neither" (ui_win_waits (ui_win_paced_by (waiting) true true) 2000) false)
                 (check_bool "too long" (ui_win_waits (waiting) 200001000) false)))))

; A frame notice and a release of the window come as events that ui_route
; takes: the window then waits for neither.
(def test_frame_release_routed () int
  (let (f (ui_event_of (plain) (wm_says (shown_notice 5)))
        r (ui_event_of (plain) (wm_says (release_notice 0))))
    (match (ui_route (waiting) f)
      ((UiRouted w2 a)
        (match (ui_route w2 r)
          ((UiRouted w3 a2)
            (add (check_bool "frame told" (ui_win_waits w2 2000) true)
                 (check_bool "both told" (ui_win_waits w3 2000) false))))))))

; A plain window waits for nothing.
(def test_plain_waits_not () int
  (check_bool "nothing" (ui_win_waits (plain) 2000) false))

; What a buffer not shown lacks, copied over within the part shown: but
; what is painted anyway; all of it when a scroll moves rows about.
(def test_copy_boxes () int
  (let (stale (cons (Rect 0 0 100 50) (nil Rect))
        paint (cons (Rect 0 0 100 20) (nil Rect)))
    (add (check_str "but the painted" (rects_text (ui_copy_boxes stale paint (UiNoScrollMove) (Rect 0 0 80 40))) "0,20 80x20 ")
         (check_str "all, scrolling" (rects_text (ui_copy_boxes stale paint (UiScrollMove (Rect 0 0 10 10) 2) (Rect 0 0 80 40))) "0,0 80x40 "))))

; Pixels copied over between canvases: a box of the source's 1, 1, 2 by
; 1, into a ground of 0, at scale 1.
(def test_copied_over () int
  (let (src (canvas_new 4 3 9)
        dst (ui_copied_over (canvas_new 4 3 0) src (cons (Rect 1 1 2 1) (nil Rect)) 1))
    (add (check_int "copied" (canvas_pixel dst 2 1) 9)
         (add (check_int "left" (canvas_pixel dst 0 1) 0)
              (check_int "below" (canvas_pixel dst 1 2) 0)))))

; At scale 2 a box of the desktop's pixels is twice the canvas's each way.
(def test_copied_over_scaled () int
  (let dst (ui_copied_over (canvas_new 4 4 0) (canvas_new 4 4 9) (cons (Rect 0 0 1 1) (nil Rect)) 2)
    (add (check_int "in" (canvas_pixel dst 1 1) 9) (check_int "out" (canvas_pixel dst 2 2) 0))))

; Under an operating system there is no memory for a buffer not shown.
(def test_back_for_none () int
  (check_bool "none" (match (ui_back_for (UiNoBack) 100 34 1) ((UiNoBack) true) ((UiBack va n cv t s) false)) true))

; A resize plans what changed and the strip it grew by; nothing changed
; and no resize plans nothing.
(def test_plan () int
  (add (check_str "grew" (match (ui_plan (nodes) (nodes) (Rect 0 0 120 34) (UiInPlace 100 34)) ((UiPlan p t m) (rects_text t))) "100,0 20x34 ")
       (check_str "same" (match (ui_plan (nodes) (nodes) (Rect 0 0 100 34) (UiNoSwap)) ((UiPlan p t m) (rects_text t))) "")))

; What the compositor, pid 9, sends about window 3, the window's id:
; notice, as a window notice.
(def wm_says ((notice (list int))) Message (message_new 9 (win_notice 3 notice)))

; The close button's notice is UiCloseAsked, which sets off win.close and
; keeps the window as asked to close.
(def test_ui_close_asked () int
  (let ev (ui_event_of (plain) (wm_says (close_notice)))
    (match (ui_route (plain) ev)
      ((UiRouted w a)
        (add (check_str "the event" (event_text ev) "close")
             (add (check_str "the action" a "win.close")
                  (check_bool "asked" (.close_asked w) true)))))))

; Nothing else asks it, and a program that keeps the window says so.
(def test_ui_close_kept () int
  (add (check_bool "a key does not" (.close_asked (.win (ui_route (plain) (UiKey (KeyEvent 30 1 97 0))))) false)
       (check_bool "kept" (.close_asked (ui_win_close_kept (.win (ui_route (plain) (UiCloseAsked))))) false)))

; A click on a client's own close button asks it too, as the notice does:
; the press and release over win.close's node.
(def test_ui_close_button_asks () int
  (let w (match (plain) ((UiWin c id cv port font st ns held g k m csd cl lp sh)
           (UiWin c id cv port font st (ui_layout_window (UiCsdBar (nil UiWidget) (UiSpace 0 0) (nil UiWidget) true) 100 46 st) held g k m true cl lp sh)))
    (match (ui_close_point (.nodes w))
      ((None) (fail_because "close" "no close button"))
      ((Some r)
        (let pressed (.win (ui_route w (UiPress (add (.x r) 4) (add (.y r) 4) 1)))
          (match (ui_route (ui_win_with pressed (.state pressed) 1) (UiRelease (add (.x r) 4) (add (.y r) 4) 0))
            ((UiRouted w2 a) (add (check_str "win.close" a "win.close") (check_bool "asked" (.close_asked w2) true)))))))))

; The rectangle of the node whose action is win.close, if one is.
(def ui_close_point ((ns (list UiNode))) (Option Rect)
  (match (ui_node_with ns (ui_close_action)) ((None) ((None Rect))) ((Some n) (Some (.rect n)))))

; A window notice about another window, 4, is not this window's.
(def test_ui_event_other_window () int
  (add (check_str "window 4's key" (event_text (ui_event_of (plain) (message_new 9 (win_notice 4 (key_notice (KeyEvent 30 1 97 0)))))) "other 9")
       (check_str "a bare key" (event_text (ui_event_of (plain) (message_new 9 (key_notice (KeyEvent 30 1 97 0))))) "other 9")))

(def event_text ((ev UiEvent)) (list int)
  (match ev
    ((UiKey k) "key")
    ((UiPress x y b) (append "press " (append (digits x) (append "," (digits y)))))
    ((UiRelease x y b) "release")
    ((UiMotion x y b) "motion")
    ((UiContext x y b) (append "context " (append (digits x) (append "," (digits y)))))
    ((UiLeave) "leave")
    ((UiFocus f) (if f "front" "backdrop"))
    ((UiScroll x y dx dy) (append "scroll " (append (digits x) (append "," (append (digits y) (append " " (digits dy)))))))
    ((UiResize rw rh) (append "resize " (append (digits rw) (append "x" (digits rh)))))
    ((UiCloseAsked) "close")
    ((UiExit p s) (append "exit " (digits p)))
    ((UiOpen r args) (append "open " (append (digits r) (append " " (unwords args)))))
    ((UiReply t m) (append "reply " (digits t)))
    ((UiIdle) "idle")
    ((UiPort p m) (append "port " (digits p)))
    ((UiOther f p) (append "other " (digits f)))))

; The app launched again, an open to reply port 7, comes to a window of
; one as it does to a UiApp, from the compositor or anyone: an open, its
; arguments read.
(def test_ui_event_open () int
  (match (app_open_request 7 (cons "/Volumes" (nil (list int))))
    ((Err why) (fail_because "made" why))
    ((Ok b)
      (add (check_str "from the compositor" (event_text (ui_event_of (plain) (message_new 9 (bytes_to_list b)))) "open 7 /Volumes")
           (check_str "from another" (event_text (ui_event_of (plain) (message_new 8 (bytes_to_list b)))) "open 7 /Volumes")))))

; A window of one sets off app.open for an open, which it has answered
; shown 0 already, and changes nothing.
(def test_ui_route_open () int
  (check_str "the action" (.action (ui_route (plain) (UiOpen 7 (nil (list int))))) "app.open"))

(def test_ui_event_resize () int
  (add (check_str "a size asked" (event_text (ui_event_of (plain) (wm_says (size_notice 300 200)))) "resize 300x200")
       (check_str "from anyone else, nothing" (event_text (ui_event_of (plain) (message_new 8 (size_notice 300 200)))) "other 8")))

(def test_ui_resize_same_size () int
  (check_str "the size it has: nothing to do" (.action (ui_route (plain) (UiResize 100 34))) ""))

(def test_ui_event_pointer () int
  (add (check_str "a press" (event_text (ui_event_of (plain) (wm_says (pointer_notice (PointerEvent 5 6 1))))) "press 5,6")
       (add (check_str "a move" (event_text (ui_event_of (plain) (wm_says (pointer_notice (PointerEvent 5 6 0))))) "motion")
            (check_str "a release" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 1) (wm_says (pointer_notice (PointerEvent 5 6 0))))) "release"))))

; The right button, 2, alone asks for a context menu; the middle, 4, does
; nothing: only the left is a press, and the left let go while the right
; is held is a release.
(def test_ui_event_left_only () int
  (add (check_str "the right" (event_text (ui_event_of (plain) (wm_says (pointer_notice (PointerEvent 5 6 2))))) "context 5,6")
       (add (check_str "the middle" (event_text (ui_event_of (plain) (wm_says (pointer_notice (PointerEvent 5 6 4))))) "motion")
            (check_str "left let go" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 1) (wm_says (pointer_notice (PointerEvent 5 6 2))))) "release"))))

; The right held on is no second context menu, nor is it pressed with the
; left down.
(def test_ui_event_right_held () int
  (add (check_str "still held" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 2) (wm_says (pointer_notice (PointerEvent 5 6 2))))) "motion")
       (check_str "with the left" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 1) (wm_says (pointer_notice (PointerEvent 5 6 3))))) "motion")))

; A right press over button b, at 60, 10, sets off context.60.10.b; over
; nothing, the window's ground, context.X.Y. alone; and it presses
; nothing.
(def test_ui_context_routed () int
  (let r (ui_route (plain) (UiContext 60 10 2))
    (add (check_str "over b" (.action r) "context.60.10.b")
         (add (check_str "nothing pressed" (.pressed (.state (.win r))) "")
              (check_str "over nothing" (.action (ui_route (plain) (UiContext 99 33 2))) "context.99.33.")))))

(def context_text ((a (list int))) (list int)
  (match (ui_context_of a)
    ((None) "none")
    ((Some c) (match c ((UiContextAt x y t) (append (digits x) (append "," (append (digits y) (append " " t)))))))))

; Read back: where, and over what, dots and all.
(def test_ui_context_of () int
  (add (check_str "a row" (context_text (ui_context_action 5 7 "files.select.a.txt")) "5,7 files.select.a.txt")
       (add (check_str "nothing under it" (context_text "context.5.7.") "5,7 ")
            (add (check_str "no place" (context_text "context.5") "none")
                 (check_str "another action" (context_text "app.refresh") "none")))))

; A second click on the same thing within 400 ms is a double, a third is
; not; one on something else, or later, is not.
(def test_ui_click_after () int
  (let (one (ui_click_after (ui_click_none) "a" 1000)
        two (ui_click_after one "a" (add 1000 (sub (ui_double_ns) 1))))
    (add (check_bool "the first" (.double one) false)
         (add (check_bool "the second, soon" (.double two) true)
              (add (check_bool "a third" (.double (ui_click_after two "a" (add 1000 (ui_double_ns)))) false)
                   (add (check_bool "late" (.double (ui_click_after one "a" (add 1000 (ui_double_ns)))) false)
                        (check_bool "on another" (.double (ui_click_after one "b" 1001)) false)))))))

; Two clicks of b routed at once are a double; a click is not.
(def test_ui_win_double () int
  (let (w1 (.win (ui_route (.win (ui_route (plain) (UiPress 60 10 1))) (UiRelease 60 10 0)))
        w2 (.win (ui_route (.win (ui_route w1 (UiPress 60 10 1))) (UiRelease 60 10 0))))
    (add (check_bool "one" (ui_win_double w1) false)
         (check_bool "two" (ui_win_double w2) true))))

; A release with nothing pressed keeps a press on a header bar's ground
; as the last click, so a second press there 100 ns on is a double; one
; after any other click is no click.
(def test_ui_win_released () int
  (let (moved (ui_win_released (ui_win_clicked (plain) (ui_move_action) 1000) "" "" 1050)
        other (ui_win_released (ui_win_clicked (plain) "a" 1000) "" "" 1050))
    (add (check_bool "kept" (ui_win_double (ui_win_clicked moved (ui_move_action) 1100)) true)
         (check_bool "not kept" (ui_win_double (ui_win_clicked other "a" 1100)) false))))

(def test_ui_event_notices () int
  (add (check_str "left" (event_text (ui_event_of (plain) (wm_says (leave_notice)))) "leave")
       (add (check_str "focus" (event_text (ui_event_of (plain) (wm_says (focus_notice false)))) "backdrop")
            (check_str "a key" (event_text (ui_event_of (plain) (wm_says (key_notice (KeyEvent 30 1 97 0))))) "key"))))

(def test_ui_event_wheel () int
  (add (check_str "the wheel" (event_text (ui_event_of (plain) (wm_says (wheel_notice (WheelEvent 5 6 0 3))))) "scroll 5,6 3")
       (check_str "not the compositor's" (event_text (ui_event_of (plain) (message_new 5 (wheel_notice (WheelEvent 5 6 0 3))))) "other 5")))

(def test_ui_event_others () int
  (add (check_str "an exit" (event_text (ui_event_of (plain) (message_new 0 (exit_notice 12 0)))) "exit 12")
       (check_str "not the compositor" (event_text (ui_event_of (plain) (message_new 5 (pointer_notice (PointerEvent 5 6 1))))) "other 5")))

; A window that draws its own header bar, 100 by 34, with nothing in it.
(def csd_win () UiWin
  (match (plain)
    ((UiWin c id cv port font st ns held g k m csd cl lp sh)
      (UiWin c id cv port font st (ui_layout_window (UiCsdBar (nil UiWidget) (UiSpace 0 0) (nil UiWidget) false) 100 46 st) held g k m true cl lp sh))))

; In a window 100 by 50, 3 deep inside its edges: the left alone (1)
; halfway down, the bottom alone (8) halfway across; within 20 of the
; top left, its left and top (1 + 4); and nothing 3 in.
(def test_ui_csd_edges () int
  (add (check_int "the left" (ui_csd_edges 100 50 2 25) 1)
       (add (check_int "the bottom" (ui_csd_edges 100 50 50 47) 8)
            (add (check_int "the top left" (ui_csd_edges 100 50 15 0) 5)
                 (check_int "inside" (ui_csd_edges 100 50 3 25) 0)))))

; Within 20 of the bottom right, its right and bottom (2 + 8), on either
; side of the corner.
(def test_ui_csd_edges_corner () int
  (add (check_int "on the right" (ui_csd_edges 100 50 99 31) 10)
       (check_int "on the bottom" (ui_csd_edges 100 50 81 49) 10)))

; A left press inside a window's edge asks the compositor to resize it,
; which here fails: nothing set off or pressed. A window that does not
; draw its own decorations has no such edge, and its button is pressed.
(def test_ui_press_edges () int
  (let r (ui_route (csd_win) (UiPress 1 20 1))
    (add (check_str "nothing set off" (.action r) "")
         (add (check_str "nothing pressed" (.pressed (.state (.win r))) "")
              (check_str "not a csd window's" (.pressed (.state (.win (ui_route (plain) (UiPress 1 10 1))))) "a")))))

; A press on its ground asks the compositor to move the window, which
; here, with no compositor, fails; either way it sets off nothing, and
; leaves nothing pressed, so its release sets off nothing either.
(def test_ui_press_moves () int
  (let r (ui_route (csd_win) (UiPress 50 20 1))
    (add (check_str "nothing set off" (.action r) "")
         (add (check_str "nothing pressed" (.pressed (.state (.win r))) "")
              (check_str "nor by its release" (.action (ui_route (.win r) (UiRelease 50 20 0))) "")))))

; A press and a release on a: its action; a press on a let go on b: none.
(def test_ui_click () int
  (let pressed (.win (ui_route (plain) (UiPress 10 10 1)))
    (add (check_str "pressed, shown" (.pressed (.state pressed)) "a")
         (add (check_str "released on it" (.action (ui_route pressed (UiRelease 10 10 0))) "a")
              (check_str "released on another" (.action (ui_route pressed (UiRelease 45 10 0))) "")))))

(def test_ui_hover () int
  (add (check_str "over b" (.hover (.state (.win (ui_route (plain) (UiMotion 45 10 0))))) "b")
       (check_str "gone" (.hover (.state (.win (ui_route (win_of (.hover (ui_state_new (UiLight)) "b") 0) (UiLeave))))) "")))

(def test_ui_keyboard () int
  (let tabbed (.win (ui_route (plain) (UiKey (KeyEvent (ui_key_tab) 1 9 0))))
    (add (check_str "Tab, to the first" (.focus (.state tabbed)) "a")
         (add (check_str "Enter sets it off" (.action (ui_route tabbed (UiKey (KeyEvent (ui_key_enter) 1 10 0)))) "a")
              (check_str "not on release" (.action (ui_route tabbed (UiKey (KeyEvent (ui_key_enter) 0 0 0)))) "")))))

; A key's modifiers, Ctrl and Shift 3; anything else none.
(def test_ui_key_mods () int
  (add (check_int "ctrl-shift-t" (ui_key_mods (UiKey (KeyEvent 20 1 20 3))) 3)
       (check_int "a press" (ui_key_mods (UiPress 1 1 1)) 0)))

; Shift-Tab, Tab with Shift held (1): from nothing to the last, b, and
; then back to a; Tab with Ctrl held (2) still goes on.
(def test_ui_shift_tab () int
  (let back (.win (ui_route (plain) (UiKey (KeyEvent (ui_key_tab) 1 9 1))))
    (add (check_str "to the last" (.focus (.state back)) "b")
         (add (check_str "and back" (.focus (.state (.win (ui_route back (UiKey (KeyEvent (ui_key_tab) 1 9 1)))))) "a")
              (check_str "ctrl-tab goes on" (.focus (.state (.win (ui_route back (UiKey (KeyEvent (ui_key_tab) 1 0 2)))))) "a")))))

(def test_ui_backdrop () int
  (check_bool "in the backdrop" (.backdrop (.state (.win (ui_route (plain) (UiFocus false))))) true))

(def rects_text ((rs (list Rect))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (append (digits h) (append " " (rects_text (tail rs))))))))))))))

(def hovered_b () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    100 34 (.hover (ui_state_new (UiLight)) "b")))

(def test_ui_changed () int
  (add (check_str "nothing" (rects_text (ui_changed (nodes) (nodes) (Rect 0 0 100 34))) "")
       (add (check_str "only b" (rects_text (ui_changed (nodes) (hovered_b) (Rect 0 0 100 34))) "40,0 34x34 ")
            (check_str "everything, the first time" (rects_text (ui_changed (nil UiNode) (nodes) (Rect 0 0 100 34))) "0,0 100x34 "))))

; Two buttons at the start of a row, laid out w wide: wider, the ground
; grows and the buttons stay.
(def two_at ((w int)) (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    w 34 (ui_state_new (UiLight))))

; 100 wide grown to 140: only the strip the ground grew by, from 100,
; 40 wide; the buttons, whose ops are all as they were, not at all.
(def test_ui_changed_grown () int
  (check_str "the strip alone" (rects_text (ui_changed (two_at 100) (two_at 140) (Rect 0 0 140 34))) "100,0 40x34 "))

; An x moved 20 right in a cell 10 wide: damage where its character was
; and is, 8 wide, what the text paints, not its cell; nothing if it stays.
(def test_ui_changed_moved () int
  (let (a (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "x" (UiStart) 0 (UiMono) false 1) (nil UiPaint)) "" false) (nil UiNode))
        b (cons (UiNode (Rect 20 0 10 10) (cons (UiPText (Rect 20 0 10 10) "x" (UiStart) 0 (UiMono) false 1) (nil UiPaint)) "" false) (nil UiNode)))
    (add (check_str "moved: where its character was and is" (rects_text (ui_changed a b (Rect 0 0 40 10))) "0,0 8x10 20,0 8x10 ")
         (check_str "as it was" (rects_text (ui_changed a a (Rect 0 0 40 10))) ""))))

; The same text in another face is damage, where either paints: x is 8
; wide in Source Code Pro, 6 in Source Sans 3 (446 units, 5.95), so
; the damage is the 8 that holds both.
(def test_ui_changed_face () int
  (let (a (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "x" (UiStart) 0 (UiMono) false 1) (nil UiPaint)) "" false) (nil UiNode))
        b (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "x" (UiStart) 0 (UiSans) false 1) (nil UiPaint)) "" false) (nil UiNode)))
    (check_str "both" (rects_text (ui_changed a b (Rect 0 0 40 10))) "0,0 8x10 ")))

; Nodes of text in faces at heights of a program's own: sans at 40
; twice, code at 24, and the interface's text.
(def at_nodes () (list UiNode)
  (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "a" (UiStart) 0 (UiFontAt "sans" 40) false 1)
                                       (cons (UiPText (Rect 0 0 10 10) "b" (UiStart) 0 (UiFontAt "sans" 40) false 1) (nil UiPaint))) "" false)
        (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "c" (UiStart) 0 (UiFontAt "code" 24) false 1)
                                             (cons (UiPText (Rect 0 0 10 10) "d" (UiStart) 0 (UiSans) false 1) (nil UiPaint))) "" false)
              (nil UiNode))))

; The strikes they want, each once, the interface's none, as the face
; loads those itself; at scale 2 twice as tall; none the face has.
(def test_strikes_wanted () int
  (add (check_str "at 1" (join_with "," (ui_strikes_wanted (ui_face_none) (at_nodes) (nil (list int)))) "glyph.code.24,glyph.sans.40")
       (add (check_str "at 2" (join_with "," (ui_strikes_wanted (UiFace 2 ((MapEmpty (list int) UiCov)) (ui_strikes_none)) (at_nodes) (nil (list int))))
                       "glyph.code.48,glyph.sans.80")
            (check_str "had" (join_with "," (ui_strikes_wanted (UiFace 1 ((MapEmpty (list int) UiCov)) (map_put (ui_strikes_none) "glyph.sans.40" (UiStrikeBytes (bytes_from_list ""))))
                                                               (at_nodes) (nil (list int))))
                       "glyph.code.24"))))

; With no font to ask, as under an operating system, or no port for its
; answers, each strike wanted is kept as none, so that it is not asked
; for again.
(def test_strikes_none_kept () int
  (add (match (ui_face_asking (ui_face_none) (cons "glyph.sans.40" (nil (list int))) 7)
         ((UiFace s ts ks) (check_bool "no font" (eq (map_get ks "glyph.sans.40") (Some (UiStrikeBytes (bytes_from_list "")))) true)))
       (match (ui_face_asking (ui_face_none) (cons "glyph.sans.40" (nil (list int))) 0)
         ((UiFace s ts ks) (check_bool "no port" (map_has ks "glyph.sans.40") true)))))

; A face that asked for two strikes: an answer that names no strike is
; taken as the oldest's; one font refused kept as none.
(def asked_face () UiFace
  (UiFace 1 ((MapEmpty (list int) UiCov)) (map_put (map_put (ui_strikes_none) "glyph.sans.40" (UiStrikeAsked 20)) "glyph.code.24" (UiStrikeAsked 10))))

(def test_face_answered () int
  (match (ui_face_answered (asked_face) "error: no such face")
    ((UiAnswered f name)
      (add (check_str "the oldest" name "glyph.code.24")
           (add (check_bool "kept as none" (eq (ui_face_strike f "glyph.code.24") (Some (UiStrikeBytes (bytes_from_list "")))) true)
                (check_str "then the next" (ui_face_oldest_ask f) "glyph.sans.40"))))))

; font answers as strikes are ready, naming each: a refusal of sans 40,
; asked second, is taken as sans 40's, code 24 still waited for.
(def test_face_answered_by_name () int
  (match (ui_face_answered (asked_face) (font_strike_error "sans 40" "no memory for a strike"))
    ((UiAnswered f name)
      (add (check_str "the one named" name "glyph.sans.40")
           (check_str "still waited for" (ui_face_oldest_ask f) "glyph.code.24")))))

; A face reading code 16 through the region over the arena at 8192: a
; strike font gives in the same arena is read through that region, at
; its own offset, and opens none more.
(def arena_face () UiFace
  (UiFace 1 ((MapEmpty (list int) UiCov)) (map_put (map_put (ui_strikes_none) "glyph.code.16" (UiStrikeIn (IoRegion 5) 8192 0)) "glyph.code.24" (UiStrikeAsked 10))))

(def test_face_answered_same_arena () int
  (match (ui_face_answered (arena_face) (font_strike_reply 8192 128 12288 3 "code 24"))
    ((UiAnswered f name)
      (add (check_bool "the same region" (eq (ui_face_strike f "glyph.code.24") (Some (UiStrikeIn (IoRegion 5) 8192 12288))) true)
           (match f ((UiFace s ts ks) (check_int "one region" (ui_strike_regions (map_values ks) (nil int)) 1)))))))

; Strikes in two arenas are two regions; held as bytes or asked, none.
(def test_strike_regions () int
  (let ks (cons (UiStrikeIn (IoRegion 5) 8192 0) (cons (UiStrikeIn (IoRegion 5) 8192 12288)
            (cons (UiStrikeIn (IoRegion 6) 1056768 0) (cons (UiStrikeAsked 3) (cons (UiStrikeBytes (bytes_from_list "")) (nil UiStrike))))))
    (check_int "two arenas" (ui_strike_regions ks (nil int)) 2)))

; A strike asked is drawn as none: not whole, its words 0.
(def test_strike_asked_not_drawn () int
  (add (check_bool "not whole" (ui_strike_whole (UiStrikeAsked 1)) false)
       (check_int "no words" (ui_strike_u32 (UiStrikeAsked 1) 0) 0)))

; Once a strike comes, a window's text from it is no longer counted as
; painted, and its keyed parts are laid out again: the label of
; at_nodes in sans at 40 left out, the rest kept.
(def test_restruck () int
  (let ns (ui_nodes_restruck (cons (UiNode (Rect 0 0 10 10) (cons (UiPText (Rect 0 0 10 10) "a" (UiStart) 0 (UiFontAt "sans" 40) false 1) (cons (UiPFill (Rect 0 0 1 1) 0) (nil UiPaint))) "ui.kept.1.0.0.10.10.5.k" false) (nil UiNode)) "glyph.sans.40" 1 (nil UiNode))
    (match (head ns)
      ((UiNode r ops a f) (add (check_int "the fill alone" (length ops) 1) (check_str "no mark" a ""))))))

; ------------------------------------------------------------- scrolling

; The grid of grid_win scrolled from row 0 to 3, three rows of 30: its
; area, from 32 under the header, 300 high, moved 90 up.
(def test_ui_scroll_moved () int
  (match (ui_scroll_moved (.nodes (grid_win 3)) (.nodes (grid_win 0)))
    ((UiScrollMove r dy) (add (check_str "the area" (rects_text (cons r (nil Rect))) "0,32 400x300 ")
                              (check_int "moved up" dy 90)))
    ((UiNoScrollMove) (fail_because "a scroll" "none"))))

(def test_ui_scroll_not_moved () int
  (add (check_bool "the same rows" (eq (ui_scroll_moved (.nodes (grid_win 3)) (.nodes (grid_win 3))) (UiNoScrollMove)) true)
       (check_bool "a page or more" (eq (ui_scroll_moved (.nodes (grid_win 10)) (.nodes (grid_win 0))) (UiNoScrollMove)) true)))

; Once the area's pixels have moved 90 up, what is painted again: the
; strip of three rows at its foot, 242 to 332, and the scrollbar's slider,
; 6 wide from 391, where it is, 79 to 225, and where it was, moved up
; with the rest and cut to the area, the rest of 32 to 225, apart, as no
; pixel is painted twice; not the seven rows that moved.
(def test_ui_scrolled_changed () int
  (check_str "the strip and the slider"
    (rects_text (ui_scrolled_changed (.nodes (grid_win 0)) (.nodes (grid_win 3)) (Rect 0 0 400 332) (Rect 0 32 400 300) 90))
    "0,242 400x90 391,79 6x146 391,32 6x47 "))

; Damage made disjoint, the largest first: a thin column and a wide strip
; across it stay a strip and the column less it, not the whole area
; holding both; a text in its row is no more than the row.
(def test_ui_merged () int
  (add (check_str "a column across a strip"
         (rects_text (ui_merged (cons (Rect 390 0 6 300) (cons (Rect 0 200 400 100) (nil Rect))) (Rect 0 0 400 300)))
         "0,200 400x100 390,0 6x200 ")
       (check_str "a text in its row"
         (rects_text (ui_merged (cons (Rect 10 205 50 16) (cons (Rect 0 200 400 30) (nil Rect))) (Rect 0 0 400 300)))
         "0,200 400x30 ")))

; A window 400 by 332 that is a grid of twenty rows, ten shown under its
; 32-row header, from first: the most first is 10. Its scrollbar's strip
; is x 388 to 400 and y 32 to 332; its slider is half of the 300, 150
; long, so it travels 150, 15 a row, and from the first row is at 32.
(def g_cols () (list UiColumn) (cons (UiColumn "PID" 0 (UiEnd) true) (nil UiColumn)))

(def g_rows ((i int) (acc (list UiRow))) (list UiRow)
  (if (eq i 0) acc (g_rows (sub i 1) (cons (UiRow (digits i) (cons (UiCellNum i "") (nil UiCell))) acc))))

(def grid_win ((first int)) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoRegion 0) 400 332 0) 4 (ui_face_none) (ui_state_new (UiLight))
         (ui_layout_window (UiGrid (UiGridView "g" (g_cols) (g_rows 20 (nil UiRow)) (UiGridState 0 false "" first 0)))
                           400 332 (ui_state_new (UiLight)))
         0 0 (ui_click_none) (UiMem 0 1 400 332 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new) ""))

; A step down is three rows; up from the first, nothing to do.
(def test_ui_wheel_scrolls () int
  (add (check_str "down" (.action (ui_route (grid_win 0) (UiScroll 100 100 0 1))) "g.scrollto.3")
       (add (check_str "up, at the top" (.action (ui_route (grid_win 0) (UiScroll 100 100 0 -1))) "")
            (check_str "on the scrollbar too" (.action (ui_route (grid_win 4) (UiScroll 395 100 0 -1))) "g.scrollto.1"))))

(def test_ui_wheel_elsewhere () int
  (check_str "the header does not scroll" (.action (ui_route (grid_win 0) (UiScroll 100 10 0 1))) ""))

; Pressed at 50 on the slider, 18 below its top: taken there, not moved.
; Dragged to 125, its top goes to 107, 75 down the strip, five rows.
(def test_ui_slider_drag () int
  (let pressed (ui_route (grid_win 0) (UiPress 395 50 1))
    (add (check_str "taken, not moved" (.action pressed) "")
         (add (check_int "held 18 below its top" (.grab (.win pressed)) 18)
              (check_str "dragged five rows" (.action (ui_route (.win pressed) (UiMotion 395 125 1))) "g.scrollto.5")))))

; Pressed at 300, below the slider: brought there by its middle, 75, so
; its top at 225, past the end of its travel: the last row, 10.
(def test_ui_strip_press () int
  (let pressed (ui_route (grid_win 0) (UiPress 395 300 1))
    (add (check_str "brought there" (.action pressed) "g.scrollto.10")
         (check_int "held by its middle" (.grab (.win pressed)) 75))))

(def test_ui_motion_unpressed () int
  (check_str "no drag without a press" (.action (ui_route (grid_win 0) (UiMotion 395 125 0))) ""))

; A window 400 by 332 that is a grid of twenty rows, its columns 300 and
; 500 wide, 800 in all, so 400 can be scrolled off to the left. Its
; scrollbar across is the strip y 320 to 332, x 0 to 388, short of the
; scrollbar down's 12; its slider is 388 * 400 / 800, 194, long, so it
; travels 194, and from the left is at 0.
(def w_cols () (list UiColumn) (cons (UiColumn "PID" 300 (UiEnd) true) (cons (UiColumn "Name" 500 (UiStart) true) (nil UiColumn))))

(def wide_win ((left int)) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoRegion 0) 400 332 0) 4 (ui_face_none) (ui_state_new (UiLight))
         (ui_layout_window (UiGrid (UiGridView "w" (w_cols) (g_rows 20 (nil UiRow)) (UiGridState 0 false "" 0 left)))
                           400 332 (ui_state_new (UiLight)))
         0 0 (ui_click_none) (UiMem 0 1 400 332 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new) ""))

; A step across is 48 pixels; left from the start, nothing to do.
(def test_ui_wheel_across () int
  (add (check_str "right" (.action (ui_route (wide_win 0) (UiScroll 100 100 1 0))) "w.acrossto.48")
       (add (check_str "left, at the start" (.action (ui_route (wide_win 0) (UiScroll 100 100 -1 0))) "")
            (check_str "left, not past the start" (.action (ui_route (wide_win 30) (UiScroll 100 100 -1 0))) "w.acrossto.0"))))

; The header scrolls across too, as the strip does; a turn down as well
; as across scrolls down.
(def test_ui_wheel_across_where () int
  (add (check_str "over the header" (.action (ui_route (wide_win 0) (UiScroll 100 10 1 0))) "w.acrossto.48")
       (add (check_str "over the strip" (.action (ui_route (wide_win 400) (UiScroll 100 326 -2 0))) "w.acrossto.304")
            (check_str "down first" (.action (ui_route (wide_win 0) (UiScroll 100 100 1 1))) "w.scrollto.3"))))

; A grid no wider than it shows does not scroll across.
(def test_ui_wheel_across_narrow () int
  (check_str "nothing to scroll" (.action (ui_route (grid_win 0) (UiScroll 100 100 1 0))) ""))

; Pressed at 50 on the slider, 50 right of its left: taken there, not
; moved. Dragged to 147, its left goes to 97, half its travel: 200.
(def test_ui_across_slider_drag () int
  (let pressed (ui_route (wide_win 0) (UiPress 50 326 1))
    (add (check_str "taken, not moved" (.action pressed) "")
         (add (check_int "held 50 right of its left" (.grab (.win pressed)) 50)
              (check_str "dragged half way" (.action (ui_route (.win pressed) (UiMotion 147 326 1))) "w.acrossto.200")))))

; Pressed at 300, right of the slider: brought there by its middle, 97,
; so its left at 203, past the end of its travel: all 400.
(def test_ui_across_strip_press () int
  (let pressed (ui_route (wide_win 0) (UiPress 300 326 1))
    (add (check_str "brought there" (.action pressed) "w.acrossto.400")
         (check_int "held by its middle" (.grab (.win pressed)) 97))))

(def test_ui_win_scroller () int
  (check_bool "where the grid is" (eq (ui_win_scroller (grid_win 4) "g") (UiScroller 4 10 10)) true))

; ---------------------------------------------------------------- entries

; A window 300 by 34: an entry called e, 200 wide from 0, its text from
; 9; then a button, b, 6 after it.
(def entry_nodes () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiEntry "e" (ui_entry_new "ab") "" 200)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    300 34 (ui_state_new (UiLight))))

(def entry_win ((focus (list int))) UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoRegion 0) 300 34 0) 4 (ui_face_none)
         (.focus (ui_state_new (UiLight)) focus) (entry_nodes) 0 0 (ui_click_none) (UiMem 0 1 300 34 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new) ""))

(def key ((code int) (ch int)) UiEvent (UiKey (KeyEvent code 1 ch 0)))

; Pressed at 22, past the middle of its second character, 17 to 25: the
; focus on it, the cursor before character 2, and nothing left pressed.
(def test_entry_press () int
  (let r (ui_route (entry_win "") (UiPress 22 10 1))
    (add (check_str "the cursor placed" (.action r) "e.place.2")
         (add (check_str "focused" (.focus (.state (.win r))) "e.entry")
              (check_str "not pressed" (.pressed (.state (.win r))) "")))))

(def test_entry_release () int
  (let pressed (.win (ui_route (entry_win "") (UiPress 22 10 1)))
    (check_str "sets nothing off" (.action (ui_route pressed (UiRelease 22 10 0))) "")))

; With the focus on it, keys edit it, Space among them, and Enter
; activates it.
(def test_entry_keys () int
  (add (check_str "a letter" (.action (ui_route (entry_win "e.entry") (key 30 97))) "e.edit")
       (add (check_str "Space" (.action (ui_route (entry_win "e.entry") (key (ui_key_space) 32))) "e.edit")
            (check_str "Enter" (.action (ui_route (entry_win "e.entry") (key (ui_key_enter) 10))) "e.activate"))))

(def test_entry_tab () int
  (check_str "Tab still moves on" (.focus (.state (.win (ui_route (entry_win "e.entry") (key (ui_key_tab) 9))))) "b"))

; The focus on an entry no longer laid out, as when its dialog has gone:
; it takes no keys, and Enter sets off what the focus is on, as ever.
(def test_entry_gone () int
  (add (check_str "a letter" (.action (ui_route (entry_win "f.entry") (key 30 97))) "")
       (check_str "Enter" (.action (ui_route (entry_win "f.entry") (key (ui_key_enter) 10))) "f.entry")))

(def et_of ((t UiEntryText)) (list int)
  (append (.text t) (append "|" (digits (.cursor t)))))

(def test_entry_update () int
  (add (check_str "typed" (et_of (ui_entry_update "e" (ui_entry_new "ab") "e.edit" (key 46 99))) "abc|3")
       (add (check_str "placed" (et_of (ui_entry_update "e" (ui_entry_new "ab") "e.place.1" (UiPress 0 0 1))) "ab|1")
            (check_str "another's" (et_of (ui_entry_update "e" (ui_entry_new "ab") "f.edit" (key 46 99))) "ab|2"))))

(def test_win_focusing () int
  (check_str "put on it" (.focus (.state (ui_win_focusing (plain) "e.entry"))) "e.entry"))

; A header bar over a drawing area, in 640 by 430: the area is the 384
; rows under the bar's 46, the program's to paint.
(def drawn_view () UiWidget
  (UiBox (UiV) 0 (cons (UiCsdBar (nil UiWidget) (UiLabel "t" (UiHeading) (UiCenter)) (nil UiWidget) true)
                     (cons (UiExpand (UiDrawingArea "term" 640 384)) (nil UiWidget)))))

(def test_ui_drawn () int
  (let ns (ui_layout_window (drawn_view) 640 430 (ui_state_new (UiDark)))
    (add (check_str "its area" (rects_text (ui_drawn ns)) "0,46 640x384 ")
         (check_str "found by name" (match (ui_drawing_rect ns "term") ((Some r) (rects_text (cons r (nil Rect)))) ((None) "none")) "0,46 640x384 "))))

; What the toolkit would paint across the whole window leaves the area
; out: only the header bar is painted and told.
(def test_ui_undrawn () int
  (let ns (ui_layout_window (drawn_view) 640 430 (ui_state_new (UiDark)))
    (check_str "the header bar" (rects_text (ui_undrawn ns (cons (Rect 0 0 640 430) (nil Rect)))) "0,0 640x46 ")))

; A press in the area sets off its action, as any target's.
(def test_ui_drawing_hit () int
  (check_str "term.drawing" (ui_hit (ui_layout_window (drawn_view) 640 430 (ui_state_new (UiDark))) 100 200) "term.drawing"))

; ---------------------------------------------------------- the pointer

; Over the entry, from 0 to 200 across, the I-beam; over the button
; after it, the arrow; and in a window not decorated by its client even
; at its edge, which is wm's border's, what is under the pointer.
(def test_ui_pointer_entry () int
  (add (check_str "the entry" (ui_pointer_at (entry_win "") 20 17) "text")
       (add (check_str "the button" (ui_pointer_at (entry_win "") 250 17) "")
            (check_str "its edge, wm's" (ui_pointer_at (entry_win "") 1 17) "text"))))

; Inside the edges of a window 100 by 34 that draws its own: 1 in from
; the left, 17 down, within 20 of the top, its left and top; 33 down,
; halfway across, the bottom alone; 99 across, 17 down, its right and
; top. Inside them, its header bar, the arrow.
(def test_ui_pointer_csd () int
  (add (check_str "top left" (ui_pointer_at (csd_win) 1 17) "nwse-resize")
       (add (check_str "the bottom" (ui_pointer_at (csd_win) 50 33) "ns-resize")
            (add (check_str "top right" (ui_pointer_at (csd_win) 99 17) "nesw-resize")
                 (check_str "inside" (ui_pointer_at (csd_win) 50 17) "")))))

; Each side and corner's pointer, as wm's resize_cursor gives for its
; border: left 1, right 2, top 4, bottom 8.
(def test_ui_edges_pointer () int
  (add (check_str "right" (ui_edges_pointer 2) "ew-resize")
       (add (check_str "top" (ui_edges_pointer 4) "ns-resize")
            (add (check_str "bottom right" (ui_edges_pointer 10) "nwse-resize")
                 (add (check_str "bottom left" (ui_edges_pointer 9) "nesw-resize")
                      (check_str "none" (ui_edges_pointer 0) ""))))))

; A motion over the entry asks for the I-beam and keeps it as asked;
; one back over the button, the arrow.
(def test_ui_motion_pointer () int
  (let w (.win (ui_route (entry_win "") (UiMotion 20 17 0)))
    (add (check_str "asked" (.pointer w) "text")
         (check_str "back" (.pointer (.win (ui_route w (UiMotion 250 17 0)))) ""))))
