; A window of a compositor whose pid is 9, its buttons as given, its
; nodes two buttons side by side.
(def nodes () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    100 34 (ui_state_new (UiLight))))

(def win_of ((st UiState) (held int)) UiWin
  (UiWin (Compositor 1 2 9) 3 (Canvas (IoDevice 0) 100 34 0) 4 (array_new 0 0) st (nodes) held 0))

(def plain () UiWin (win_of (ui_state_new (UiLight)) 0))

(def event_text ((ev UiEvent)) (list int)
  (match ev
    ((UiKey k) "key")
    ((UiPress x y b) (append "press " (append (digits x) (append "," (digits y)))))
    ((UiRelease x y b) "release")
    ((UiMotion x y b) "motion")
    ((UiLeave) "leave")
    ((UiFocus f) (if f "front" "backdrop"))
    ((UiScroll x y dx dy) (append "scroll " (append (digits x) (append "," (append (digits y) (append " " (digits dy)))))))
    ((UiExit p s) (append "exit " (digits p)))
    ((UiOther f p) (append "other " (digits f)))))

(def test_ui_event_pointer () int
  (add (check_str "a press" (event_text (ui_event_of (plain) (Message 9 (pointer_notice (PointerEvent 5 6 1))))) "press 5,6")
       (add (check_str "a move" (event_text (ui_event_of (plain) (Message 9 (pointer_notice (PointerEvent 5 6 0))))) "motion")
            (check_str "a release" (event_text (ui_event_of (win_of (ui_state_new (UiLight)) 1) (Message 9 (pointer_notice (PointerEvent 5 6 0))))) "release"))))

(def test_ui_event_notices () int
  (add (check_str "left" (event_text (ui_event_of (plain) (Message 9 (leave_notice)))) "leave")
       (add (check_str "focus" (event_text (ui_event_of (plain) (Message 9 (focus_notice false)))) "backdrop")
            (check_str "a key" (event_text (ui_event_of (plain) (Message 9 (key_notice (KeyEvent 30 1 97))))) "key"))))

(def test_ui_event_wheel () int
  (add (check_str "the wheel" (event_text (ui_event_of (plain) (Message 9 (wheel_notice (WheelEvent 5 6 0 3))))) "scroll 5,6 3")
       (check_str "not the compositor's" (event_text (ui_event_of (plain) (Message 5 (wheel_notice (WheelEvent 5 6 0 3))))) "other 5")))

(def test_ui_event_others () int
  (add (check_str "an exit" (event_text (ui_event_of (plain) (Message 0 (exit_notice 12 0)))) "exit 12")
       (check_str "not the compositor" (event_text (ui_event_of (plain) (Message 5 (pointer_notice (PointerEvent 5 6 1))))) "other 5")))

(def routed_action ((r UiRouted)) (list int) (match r ((UiRouted w a) a)))
(def routed_win ((r UiRouted)) UiWin (match r ((UiRouted w a) w)))

; A press and a release on a: its action; a press on a let go on b: none.
(def test_ui_click () int
  (let pressed (routed_win (ui_route (plain) (UiPress 10 10 1)))
    (add (check_str "pressed, shown" (ui_st_pressed (ui_win_state pressed)) "a")
         (add (check_str "released on it" (routed_action (ui_route pressed (UiRelease 10 10 0))) "a")
              (check_str "released on another" (routed_action (ui_route pressed (UiRelease 45 10 0))) "")))))

(def test_ui_hover () int
  (add (check_str "over b" (ui_st_hover (ui_win_state (routed_win (ui_route (plain) (UiMotion 45 10 0))))) "b")
       (check_str "gone" (ui_st_hover (ui_win_state (routed_win (ui_route (win_of (ui_st_hovering (ui_state_new (UiLight)) "b") 0) (UiLeave))))) "")))

(def test_ui_keyboard () int
  (let tabbed (routed_win (ui_route (plain) (UiKey (KeyEvent (ui_key_tab) 1 9))))
    (add (check_str "Tab, to the first" (ui_st_focus (ui_win_state tabbed)) "a")
         (add (check_str "Enter sets it off" (routed_action (ui_route tabbed (UiKey (KeyEvent (ui_key_enter) 1 10)))) "a")
              (check_str "not on release" (routed_action (ui_route tabbed (UiKey (KeyEvent (ui_key_enter) 0 0)))) "")))))

(def test_ui_backdrop () int
  (check_bool "in the backdrop" (ui_st_backdrop (ui_win_state (routed_win (ui_route (plain) (UiFocus false))))) true))

(def rects_text ((rs (list UiRect))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((UiRect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (append (digits h) (append " " (rects_text (tail rs))))))))))))))

(def hovered_b () (list UiNode)
  (ui_layout_window (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                   (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                    100 34 (ui_st_hovering (ui_state_new (UiLight)) "b")))

(def test_ui_changed () int
  (add (check_str "nothing" (rects_text (ui_changed (nodes) (nodes) (UiRect 0 0 100 34))) "")
       (add (check_str "only b" (rects_text (ui_changed (nodes) (hovered_b) (UiRect 0 0 100 34))) "40,0 34x34 ")
            (check_str "everything, the first time" (rects_text (ui_changed (nil UiNode) (nodes) (UiRect 0 0 100 34))) "0,0 100x34 "))))

(def test_ui_merged () int
  (add (check_str "overlapping, one" (rects_text (ui_merged (cons (UiRect 0 0 10 10) (cons (UiRect 5 5 10 10) (nil UiRect))) (nil UiRect))) "0,0 15x15 ")
       (check_str "apart, two" (rects_text (ui_merged (cons (UiRect 0 0 10 10) (cons (UiRect 50 5 10 10) (nil UiRect))) (nil UiRect))) "0,0 10x10 50,5 10x10 ")))

; ------------------------------------------------------------- scrolling

; A window 400 by 332 that is a grid of twenty rows, ten shown under its
; 32-row header, from first: the most first is 10. Its scrollbar's strip
; is x 388 to 400 and y 32 to 332; its slider is half of the 300, 150
; long, so it travels 150, 15 a row, and from the first row is at 32.
(def g_cols () (list UiColumn) (cons (UiColumn "PID" 0 (UiEnd) true) (nil UiColumn)))

(def g_rows ((i int) (acc (list UiRow))) (list UiRow)
  (if (eq i 0) acc (g_rows (sub i 1) (cons (UiRow (digits i) (cons (UiCellNum i "") (nil UiCell))) acc))))

(def grid_win ((first int)) UiWin
  (UiWin (Compositor 1 2 9) 3 (Canvas (IoDevice 0) 400 332 0) 4 (array_new 0 0) (ui_state_new (UiLight))
         (ui_layout_window (UiGrid (UiGridView "g" (g_cols) (g_rows 20 (nil UiRow)) (UiGridState 0 false "" first)))
                           400 332 (ui_state_new (UiLight)))
         0 0))

; A step down is three rows; up from the first, nothing to do.
(def test_ui_wheel_scrolls () int
  (add (check_str "down" (routed_action (ui_route (grid_win 0) (UiScroll 100 100 0 1))) "g.scrollto.3")
       (add (check_str "up, at the top" (routed_action (ui_route (grid_win 0) (UiScroll 100 100 0 -1))) "")
            (check_str "on the scrollbar too" (routed_action (ui_route (grid_win 4) (UiScroll 395 100 0 -1))) "g.scrollto.1"))))

(def test_ui_wheel_elsewhere () int
  (check_str "the header does not scroll" (routed_action (ui_route (grid_win 0) (UiScroll 100 10 0 1))) ""))

; Pressed at 50 on the slider, 18 below its top: taken there, not moved.
; Dragged to 125, its top goes to 107, 75 down the strip, five rows.
(def test_ui_slider_drag () int
  (let pressed (ui_route (grid_win 0) (UiPress 395 50 1))
    (add (check_str "taken, not moved" (routed_action pressed) "")
         (add (check_int "held 18 below its top" (ui_win_grab (routed_win pressed)) 18)
              (check_str "dragged five rows" (routed_action (ui_route (routed_win pressed) (UiMotion 395 125 1))) "g.scrollto.5")))))

; Pressed at 300, below the slider: brought there by its middle, 75, so
; its top at 225, past the end of its travel: the last row, 10.
(def test_ui_strip_press () int
  (let pressed (ui_route (grid_win 0) (UiPress 395 300 1))
    (add (check_str "brought there" (routed_action pressed) "g.scrollto.10")
         (check_int "held by its middle" (ui_win_grab (routed_win pressed)) 75))))

(def test_ui_motion_unpressed () int
  (check_str "no drag without a press" (routed_action (ui_route (grid_win 0) (UiMotion 395 125 0))) ""))

(def test_ui_win_scroller () int
  (check_bool "where the grid is" (eq (ui_win_scroller (grid_win 4) "g") (UiScroller 4 10 10)) true))
