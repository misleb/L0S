; paint.l0 -- what the toolkit draws, and drawing it into a canvas
; (render.l0): rectangles, the ops a widget is painted with, and the
; buffers windows are drawn in.
;
; Painting is in two halves. Layout (widget.l0) says what to paint, as a
; list of UiPaint ops, which tests can look at; ui_paint then does them
; on a canvas, each cut to a clip rectangle, so that a change repaints
; only where it changed. No layer blends, so a rounded corner's edge is
; mixed by hand with what is under it: a color the op is given, or, if it
; is given -1, the pixel already there.

; -------------------------------------------------------------- rectangles

; x, y, width, height.
(data UiRect (UiRect int int int int))

(def ui_rx ((r UiRect)) int (match r ((UiRect x y w h) x)))
(def ui_ry ((r UiRect)) int (match r ((UiRect x y w h) y)))
(def ui_rw ((r UiRect)) int (match r ((UiRect x y w h) w)))
(def ui_rh ((r UiRect)) int (match r ((UiRect x y w h) h)))

(def ui_rect_empty ((r UiRect)) bool (if (le (ui_rw r) 0) true (le (ui_rh r) 0)))

; Where a and b overlap: empty, 0 by 0, if they do not.
(def ui_rect_clip ((a UiRect) (b UiRect)) UiRect
  (let x0 (max (ui_rx a) (ui_rx b))
    (let y0 (max (ui_ry a) (ui_ry b))
      (let x1 (min (add (ui_rx a) (ui_rw a)) (add (ui_rx b) (ui_rw b)))
        (let y1 (min (add (ui_ry a) (ui_rh a)) (add (ui_ry b) (ui_rh b)))
          (if (if (le x1 x0) true (le y1 y0)) (UiRect x0 y0 0 0) (UiRect x0 y0 (sub x1 x0) (sub y1 y0))))))))

(def ui_rect_overlaps ((a UiRect) (b UiRect)) bool (not (ui_rect_empty (ui_rect_clip a b))))

; The least rectangle holding both; an empty one holds nothing.
(def ui_rect_union ((a UiRect) (b UiRect)) UiRect
  (if (ui_rect_empty a)
      b
      (if (ui_rect_empty b)
          a
          (let x0 (min (ui_rx a) (ui_rx b))
            (let y0 (min (ui_ry a) (ui_ry b))
              (UiRect x0 y0 (sub (max (add (ui_rx a) (ui_rw a)) (add (ui_rx b) (ui_rw b))) x0)
                            (sub (max (add (ui_ry a) (ui_rh a)) (add (ui_ry b) (ui_rh b))) y0)))))))

(def ui_rect_has ((r UiRect) (x int) (y int)) bool
  (if (if (ge x (ui_rx r)) (lt x (add (ui_rx r) (ui_rw r))) false)
      (if (ge y (ui_ry r)) (lt y (add (ui_ry r) (ui_rh r))) false)
      false))

; r shrunk by d on every side.
(def ui_rect_inset ((r UiRect) (d int)) UiRect
  (match r ((UiRect x y w h) (UiRect (add x d) (add y d) (max 0 (sub w (mul 2 d))) (max 0 (sub h (mul 2 d)))))))

; ----------------------------------------------------------------- the ops

; Where text or a child goes along a line: its start, its middle, its end.
(data UiAlign (UiStart) (UiCenter) (UiEnd))

(data UiPaint
  (UiPFill UiRect int)                                 ; rect, color
  (UiPRound UiRect int int int)                        ; rect, radius, color, color under the corners or -1
  (UiPText UiRect (list int) UiAlign int bool int)     ; rect, text, align, color, bold, scale
  (UiPIcon int int (list int) int int))                ; x, y, icon name, color, scale

; ------------------------------------------------------------------- text

; How wide text is, in the font's cells, bold a pixel wider.
(def ui_text_w ((s (list int)) (bold bool) (scale int)) int
  (if (is_empty s) 0 (add (mul (mul (length s) (ui_char_w)) scale) (if bold 1 0))))

; As much of s as fits in w pixels: all of it, or its start and "...".
(def ui_ellipsized ((s (list int)) (w int) (scale int)) (list int)
  (let cw (mul (ui_char_w) scale)
    (if (le (mul (length s) cw) w)
        s
        (let n (div w cw)
          (if (le n 3) (ui_first_n "..." n) (append (ui_first_n s (sub n 3)) "..."))))))

(def ui_first_n ((s (list int)) (n int)) (list int)
  (if (if (le n 0) true (is_empty s)) (nil int) (cons (head s) (ui_first_n (tail s) (sub n 1)))))

; Where something w wide starts along a span from x, n wide.
(def ui_aligned ((x int) (n int) (w int) (a UiAlign)) int
  (match a
    ((UiStart) x)
    ((UiCenter) (add x (div (sub n w) 2)))
    ((UiEnd) (add x (sub n w)))))

; --------------------------------------------------------------- corners

; How far into a rounded rectangle's row its edge is, in sixteenths of a
; pixel: dy rows from its top or bottom, of a corner of radius r. The
; circle is measured at the row's middle, so a radius of 12 cuts 12 rows.
(def ui_corner_inset16 ((r int) (dy int)) int
  (if (ge dy r)
      0
      (let big (mul 16 r)
        (let v (sub big (add (mul 16 dy) 8))
          (sub big (isqrt (sub (mul big big) (mul v v))))))))

; How many whole pixels of row dy of a corner of radius r the display's
; shaped layers cut (display.l0's shape), as the driver counts them: a
; pixel is cut when its centre is outside the circle. So the compositor
; knows which pixels of a window are not its own.
(def ui_corner_cut ((r int) (dy int)) int
  (if (if (lt dy 0) true (ge dy r))
      0
      (let d (sub (sub (mul 2 r) (mul 2 dy)) 1)
        (div (sub (mul 2 r) (isqrt (sub (mul 4 (mul r r)) (mul d d)))) 2))))

; The radius a rectangle w by h can have: at most half its shorter side.
(def ui_fit_radius ((r int) (w int) (h int)) int
  (max 0 (min r (min (div w 2) (div h 2)))))

; The inset, in sixteenths, of row dy of a rectangle h tall with corners
; of radius r: rows near the top and the bottom are cut.
(def ui_row_inset16 ((r int) (h int) (dy int)) int
  (if (lt dy r)
      (ui_corner_inset16 r dy)
      (if (ge dy (sub h r)) (ui_corner_inset16 r (sub (sub h 1) dy)) 0)))

; ---------------------------------------------------------------- painting

; Does ops on canvas c, each cut to clip, and to the canvas.
(def ui_paint ((c Canvas) (font (array int)) (clip UiRect) (ops (list UiPaint))) int
  (let k (ui_rect_clip clip (UiRect 0 0 (canvas_w c) (canvas_h c)))
    (if (ui_rect_empty k) 0 (ui_paint_ops c font k ops))))

(def ui_paint_ops ((c Canvas) (font (array int)) (k UiRect) (ops (list UiPaint))) int
  (if (is_empty ops)
      0
      (let p (ui_paint_op c font k (head ops))
        (ui_paint_ops c font k (tail ops)))))

(def ui_paint_op ((c Canvas) (font (array int)) (k UiRect) (op UiPaint)) int
  (match op
    ((UiPFill r color) (ui_fill c k r color))
    ((UiPRound r radius color under) (ui_round c k r (ui_fit_radius radius (ui_rw r) (ui_rh r)) color under))
    ((UiPText r s a color bold scale) (ui_text c font k r s a color bold scale))
    ((UiPIcon x y name color scale) (ui_icon c k x y (ui_icon_rows name) color scale 0))))

; r filled, as much of it as is in k.
(def ui_fill ((c Canvas) (k UiRect) (r UiRect) (color int)) int
  (let a (ui_rect_clip k r)
    (if (ui_rect_empty a) 0 (match a ((UiRect x y w h) (fill_rect c x y w h color))))))

; Columns x0 up to x1 of row y, those in k.
(def ui_span ((c Canvas) (k UiRect) (y int) (x0 int) (x1 int) (color int)) int
  (if (if (lt y (ui_ry k)) true (ge y (add (ui_ry k) (ui_rh k))))
      0
      (let lo (max x0 (ui_rx k))
        (let hi (min x1 (add (ui_rx k) (ui_rw k)))
          (if (le hi lo) 0 (span c y lo (sub hi 1) color))))))

; The pixel at x, y, if it is in k.
(def ui_put ((c Canvas) (k UiRect) (x int) (y int) (color int)) int
  (if (ui_rect_has k x y) (put c x y color) 0))

; The pixel at x, y of the canvas, which must be on it.
(def ui_pixel ((c Canvas) (x int) (y int)) int
  (match c ((Canvas fb w h top) (bit_and (device_read32 fb (mul (add (row_start c y) x) 4)) 16777215))))

; color at pct percent over what is under it: under, or if under is -1,
; the pixel there now.
(def ui_blend ((c Canvas) (k UiRect) (x int) (y int) (color int) (pct int) (under int)) int
  (if (not (ui_rect_has k x y))
      0
      (put c x y (ui_mix color (if (lt under 0) (ui_pixel c x y) under) pct))))

; A rectangle with rounded corners, row by row: each row's edge pixels
; mixed by how much of them the corner covers.
(def ui_round ((c Canvas) (k UiRect) (r UiRect) (radius int) (color int) (under int)) int
  (if (eq radius 0)
      (ui_fill c k r color)
      (ui_round_rows c k r radius color under (max 0 (sub (ui_ry k) (ui_ry r)))
                     (min (ui_rh r) (sub (add (ui_ry k) (ui_rh k)) (ui_ry r))))))

(def ui_round_rows ((c Canvas) (k UiRect) (r UiRect) (radius int) (color int) (under int) (dy int) (end int)) int
  (if (ge dy end)
      0
      (let d (ui_round_row c k r radius color under dy)
        (ui_round_rows c k r radius color under (add dy 1) end))))

(def ui_round_row ((c Canvas) (k UiRect) (r UiRect) (radius int) (color int) (under int) (dy int)) int
  (match r
    ((UiRect x y w h)
      (let in16 (ui_row_inset16 radius h dy)
        (let full (div in16 16)
          (let part (mod in16 16)
            (let edge (if (gt part 0) 1 0)
              (let s (ui_span c k (add y dy) (add x (add full edge)) (sub (add x w) (add full edge)) color)
                (if (eq edge 0)
                    0
                    (let pct (div (mul (sub 16 part) 100) 16)
                      (let l (ui_blend c k (add x full) (add y dy) color pct under)
                        (ui_blend c k (sub (add x w) (add full 1)) (add y dy) color pct under))))))))))))

; Text in r, along it as a says, in its middle up and down: cut short
; with "..." if it is too wide. Bold is struck twice, a pixel apart.
(def ui_text ((c Canvas) (font (array int)) (k UiRect) (r UiRect) (s (list int)) (a UiAlign) (color int) (bold bool) (scale int)) int
  (if (eq (array_len font) 0)
      0
      (let shown (ui_ellipsized s (sub (ui_rw r) (if bold 1 0)) scale)
        (let x (ui_aligned (ui_rx r) (ui_rw r) (ui_text_w shown bold scale) a)
          (let y (add (ui_ry r) (div (sub (ui_rh r) (mul (ui_char_h) scale)) 2))
            (let t (ui_chars c font k x y shown color scale)
              (if bold (ui_chars c font k (add x 1) y shown color scale) 0)))))))

(def ui_chars ((c Canvas) (font (array int)) (k UiRect) (x int) (y int) (s (list int)) (color int) (scale int)) int
  (if (is_empty s)
      0
      (let g (ui_glyph c font k x y (drawable (head s)) color scale 0)
        (ui_chars c font k (add x (mul (ui_char_w) scale)) y (tail s) color scale))))

(def ui_glyph ((c Canvas) (font (array int)) (k UiRect) (x int) (y int) (code int) (color int) (scale int) (r int)) int
  (if (eq r (ui_char_h))
      0
      (let b (ui_bits c k x (add y (mul r scale)) (glyph_row font code r) 8 color scale 0)
        (ui_glyph c font k x y code color scale (add r 1)))))

; The lit bits of a row n wide, the leftmost the highest, from x, y.
(def ui_bits ((c Canvas) (k UiRect) (x int) (y int) (bits int) (n int) (color int) (scale int) (col int)) int
  (if (eq col n)
      0
      (let p (if (eq (bit_and (bit_shr bits (sub (sub n 1) col)) 1) 1)
                 (ui_dot c k (add x (mul col scale)) y color scale)
                 0)
        (ui_bits c k x y bits n color scale (add col 1)))))

; A pixel of text or an icon: scale by scale pixels.
(def ui_dot ((c Canvas) (k UiRect) (x int) (y int) (color int) (scale int)) int
  (if (eq scale 1) (ui_put c k x y color) (ui_fill c k (UiRect x y scale scale) color)))

(def ui_icon ((c Canvas) (k UiRect) (x int) (y int) (rows (list int)) (color int) (scale int) (r int)) int
  (if (is_empty rows)
      0
      (let b (ui_bits c k x (add y (mul r scale)) (head rows) (ui_icon_size) color scale 0)
        (ui_icon c k x y (tail rows) color scale (add r 1)))))

; ----------------------------------------------------------------- buffers

; A buffer of w by h pixels, shared memory of this process's, to give to
; the compositor or the display: its address, its pages, and its canvas;
; or why not.
(data UiBuf (UiBuf int int Canvas) (UiNoBuf (list int)))

(def ui_buffer ((w int) (h int)) UiBuf
  (let n (buffer_pages w h)
    (match (shm_alloc n)
      ((ShmNoRoom) (UiNoBuf "no memory for a buffer"))
      ((ShmTooMany) (UiNoBuf (append "a buffer of too many pages: " (digits n))))
      ((ShmPages va)
        (match (dma_open va n)
          ((DeviceFailed fault why) (UiNoBuf why))
          ((DeviceOpened r) (UiBuf va n (Canvas r w h 0))))))))

; ------------------------------------------------------------------ cursor

; Adwaita's pointer: a black arrow edged white, its hot spot its tip, at
; the top left.
(def ui_arrow_art () (list (list int))
  (split_spaces (append "W WW WBW WBBW WBBBW WBBBBW WBBBBBW WBBBBBBW WBBBBBBBW WBBBBBBBBW "
                        "WBBBBBWWWWW WBBWBBW WBW.WBBW WW..WBBW W....WBBW .....WBBW ......WW")))

(def ui_opaque () int 4278190080)       ; ff000000, alpha

; The arrow drawn into c, a cursor's 64 by 64 buffer of b, g, r, alpha:
; what it does not cover stays as it was, clear.
(def ui_paint_arrow ((c Canvas)) int (ui_arrow_rows c (ui_arrow_art) 0))

(def ui_arrow_rows ((c Canvas) (rows (list (list int))) (y int)) int
  (if (is_empty rows)
      0
      (let r (ui_arrow_row c (head rows) 0 y)
        (ui_arrow_rows c (tail rows) (add y 1)))))

(def ui_arrow_row ((c Canvas) (row (list int)) (x int) (y int)) int
  (if (is_empty row)
      0
      (let p (if (eq (head row) 87) (put c x y (bit_or (ui_opaque) (ui_white)))      ; W
                 (if (eq (head row) 66) (put c x y (ui_opaque)) 0))                     ; B
        (ui_arrow_row c (tail row) (add x 1) y))))
