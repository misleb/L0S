; paint.l0 -- what the toolkit draws, and drawing it into a canvas
; (render.l0): the ops a widget is painted with, and the buffers windows
; are drawn in. Where things go is rect.l0's Rect.
;
; Painting is in two halves. Layout (widget.l0) says what to paint, as a
; list of UiPaint ops, which tests can look at; ui_paint then does them
; on a canvas, each cut to a clip rectangle, so that a change repaints
; only where it changed. No layer blends, so a rounded corner's edge is
; mixed by hand with what is under it: a color the op is given, or, if it
; is given -1, the pixel already there. Like render.l0's drawing, each
; painting function returns the canvas painted on.
;
; Ops and clips are in the desktop's pixels, and the canvas in the
; screen's: at the face's scale 2 (face.l0) each op is painted twice as
; large, its corners rounded at twice the radius, and its text and icons
; drawn from the face's coverage, mixed with what is under them, so they
; are smooth, not doubled.

; ----------------------------------------------------------------- the ops

; Where text or a child goes along a line: its start, its middle, its end.
(data UiAlign (UiStart) (UiCenter) (UiEnd))

(data UiPaint
  (UiPFill Rect int)                                 ; rect, color
  (UiPRound Rect int int int)                        ; rect, radius, color, color under the corners or -1
  (UiPText Rect (list int) UiAlign int bool int)     ; rect, text, align, color, bold, scale
  (UiPIcon int int (list int) int int))                ; x, y, icon name, color, scale

; Each of rs filled with color c.
(def ui_fills ((rs (list Rect)) (c int)) (list UiPaint)
  (if (is_empty rs) (nil UiPaint) (cons (UiPFill (head rs) c) (ui_fills (tail rs) c))))

; ------------------------------------------------------------------- text

; How wide text is, in the font's cells, bold a pixel wider.
(def ui_text_w ((s (list int)) (bold bool) (scale int)) int
  (if (is_empty s) 0 (add (mul (mul (length s) (ui_char_w)) scale) (if bold 1 0))))

; As much of s as fits in w pixels: all of it, or its start and "...".
(def ui_ellipsized ((s (list int)) (w int) (scale int)) (list int)
  (let cw (mul (ui_char_w) scale)
    (if (le (mul (length s) cw) w)
        s
        (let n (div w cw)
          (if (le n 3) (take "..." n) (append (take s (sub n 3)) "..."))))))

; Where something w wide starts along a span from x, n wide.
(def ui_aligned ((x int) (n int) (w int) (a UiAlign)) int
  (match a
    ((UiStart) x)
    ((UiCenter) (add x (div (sub n w) 2)))
    ((UiEnd) (add x (sub n w)))))

; --------------------------------------------------------------- corners

; How far into a rounded rectangle's row its edge is, in sixteenths of a
; pixel: dy rows from its top or bottom, of a corner of radius r. The
; circle is measured at the row's middle, so a radius of 12 cuts 12 rows.
(def ui_corner_inset16 ((r int) (dy int)) int
  (if (ge dy r)
      0
      (let big (mul 16 r)
        (let v (sub big (add (mul 16 dy) 8))
          (sub big (isqrt (sub (mul big big) (mul v v))))))))

; The radius a rectangle w by h can have: at most half its shorter side.
(def ui_fit_radius ((r int) (w int) (h int)) int
  (max 0 (min r (min (div w 2) (div h 2)))))

; The inset, in sixteenths, of row dy of a rectangle h tall with corners
; of radius r: rows near the top and the bottom are cut.
(def ui_row_inset16 ((r int) (h int) (dy int)) int
  (if (lt dy r)
      (ui_corner_inset16 r dy)
      (if (ge dy (sub h r)) (ui_corner_inset16 r (sub (sub h 1) dy)) 0)))

; ---------------------------------------------------------------- painting

; Does ops on canvas c, each cut to clip, and to the canvas, at the
; face's scale.
(def ui_paint ((c Canvas) (face UiFace) (clip Rect) (ops (list UiPaint))) Canvas
  (let k (rect_clip (rect_scaled clip (ui_face_scale face)) (Rect 0 0 (canvas_w c) (canvas_h c)))
    (if (rect_empty k) c (ui_paint_ops c face k ops))))

(def ui_paint_ops ((c Canvas) (face UiFace) (k Rect) (ops (list UiPaint))) Canvas
  (if (is_empty ops)
      c
      (ui_paint_ops (ui_paint_op c face k (head ops)) face k (tail ops))))

(def ui_paint_op ((c Canvas) (face UiFace) (k Rect) (op UiPaint)) Canvas
  (let s (ui_face_scale face)
    (match op
      ((UiPFill r color) (ui_fill c k (rect_scaled r s) color))
      ((UiPRound r radius color under)
        (ui_round c k (rect_scaled r s) (mul s (ui_fit_radius radius (rect_w r) (rect_h r))) color under))
      ((UiPText r t a color bold scale) (ui_text_at c face k r t a color bold scale))
      ((UiPIcon x y name color scale) (ui_icon_at c face k x y name color scale)))))

; r filled, as much of it as is in k.
(def ui_fill ((c Canvas) (k Rect) (r Rect) (color int)) Canvas
  (let a (rect_clip k r)
    (if (rect_empty a) c (match a ((Rect x y w h) (fill_rect c x y w h color))))))

; Columns x0 up to x1 of row y, those in k.
(def ui_span ((c Canvas) (k Rect) (y int) (x0 int) (x1 int) (color int)) Canvas
  (if (if (lt y (rect_y k)) true (ge y (rect_y1 k)))
      c
      (let lo (max x0 (rect_x k))
        (let hi (min x1 (rect_x1 k))
          (if (le hi lo) c (span c y lo (sub hi 1) color))))))

; The pixel at x, y, if it is in k.
(def ui_put ((c Canvas) (k Rect) (x int) (y int) (color int)) Canvas
  (if (rect_has k x y) (put c x y color) c))

; color at pct percent over what is under it: under, or if under is -1,
; the pixel there now.
(def ui_blend ((c Canvas) (k Rect) (x int) (y int) (color int) (pct int) (under int)) Canvas
  (if (not (rect_has k x y))
      c
      (let u (if (lt under 0) (canvas_pixel c x y) under)
        (put c x y (ui_mix color u pct)))))

; A rectangle with rounded corners, row by row: each row's edge pixels
; mixed by how much of them the corner covers.
(def ui_round ((c Canvas) (k Rect) (r Rect) (radius int) (color int) (under int)) Canvas
  (if (eq radius 0)
      (ui_fill c k r color)
      (ui_round_rows c k r radius color under (max 0 (sub (rect_y k) (rect_y r)))
                     (min (rect_h r) (sub (rect_y1 k) (rect_y r))))))

(def ui_round_rows ((c Canvas) (k Rect) (r Rect) (radius int) (color int) (under int) (dy int) (end int)) Canvas
  (if (ge dy end)
      c
      (ui_round_rows (ui_round_row c k r radius color under dy) k r radius color under (add dy 1) end)))

(def ui_round_row ((c Canvas) (k Rect) (r Rect) (radius int) (color int) (under int) (dy int)) Canvas
  (match r
    ((Rect x y w h)
      (let in16 (ui_row_inset16 radius h dy)
        (let full (div in16 16)
          (let part (mod in16 16)
            (let edge (if (gt part 0) 1 0)
              (let s (ui_span c k (add y dy) (add x (add full edge)) (sub (add x w) (add full edge)) color)
                (if (eq edge 0)
                    s
                    (let pct (div (mul (sub 16 part) 100) 16)
                      (let l (ui_blend s k (add x full) (add y dy) color pct under)
                        (ui_blend l k (sub (add x w) (add full 1)) (add y dy) color pct under))))))))))))

; Text in r at the face's scale: at 1 the bitmap font's; at 2 the face's
; glyphs, the same cells twice the size, or, if it has none, the bitmap's
; doubled.
(def ui_text_at ((c Canvas) (face UiFace) (k Rect) (r Rect) (t (list int)) (a UiAlign) (color int) (bold bool) (scale int)) Canvas
  (let s (ui_face_scale face)
    (if (eq s 1)
        (ui_text c (ui_face_font face) k r t a color bold scale)
        (match (ui_face_table face (ui_glyph_table bold (mul (mul (ui_char_h) scale) s)))
          ((Some g) (ui_text_smooth c g k r t a color bold scale s))
          ((None) (ui_text c (ui_face_font face) k (rect_scaled r s) t a color bold (mul scale s)))))))

; Text placed as ui_text places it, in the desktop's pixels, then drawn
; from glyphs g at scale s, bold from the bold face's glyphs.
(def ui_text_smooth ((c Canvas) (g UiCov) (k Rect) (r Rect) (t (list int)) (a UiAlign) (color int) (bold bool) (scale int) (s int)) Canvas
  (let shown (ui_ellipsized t (sub (rect_w r) (if bold 1 0)) scale)
    (let x (ui_aligned (rect_x r) (rect_w r) (ui_text_w shown bold scale) a)
      (let y (add (rect_y r) (div (sub (rect_h r) (mul (ui_char_h) scale)) 2))
        (ui_cov_chars c g k (mul x s) (mul y s) shown color (mul (mul (ui_char_w) scale) s))))))

(def ui_cov_chars ((c Canvas) (g UiCov) (k Rect) (x int) (y int) (t (list int)) (color int) (cw int)) Canvas
  (if (is_empty t)
      c
      (match g
        ((UiCov w h words)
          (ui_cov_chars (ui_cov_blit c k g x y (mul (sub (drawable (head t)) (first_glyph)) h) h color) g k (add x cw) y (tail t) color cw)))))

; Rows row0 on, n of them, of a table of coverage, its top left at x, y:
; each pixel the color, mixed with what is under it by how much is
; covered; what is not covered at all left as it is.
(def ui_cov_blit ((c Canvas) (k Rect) (cov UiCov) (x int) (y int) (row0 int) (n int) (color int)) Canvas
  (ui_cov_rows c k cov x y row0 0 n color))

(def ui_cov_rows ((c Canvas) (k Rect) (cov UiCov) (x int) (y int) (row0 int) (r int) (n int) (color int)) Canvas
  (if (ge r n)
      c
      (if (if (lt (add y r) (rect_y k)) true (ge (add y r) (rect_y1 k)))
          (ui_cov_rows c k cov x y row0 (add r 1) n color)
          (ui_cov_rows (ui_cov_words c k cov x (add y r) (add row0 r) 0 color) k cov x y row0 (add r 1) n color))))

(def ui_cov_words ((c Canvas) (k Rect) (cov UiCov) (x int) (y int) (row int) (j int) (color int)) Canvas
  (match cov
    ((UiCov w h words)
      (let wpr (ui_cov_wpr w)
        (if (ge j wpr)
            c
            (let word (array_get words (add (mul row wpr) j))
              (ui_cov_words (if (eq word 0) c (ui_cov_word c k word (add x (mul j 16)) y (min 16 (sub w (mul j 16))) 0 color))
                            k cov x y row (add j 1) color)))))))

; The n levels of a word from column x, the first its highest four bits.
(def ui_cov_word ((c Canvas) (k Rect) (word int) (x int) (y int) (n int) (i int) (color int)) Canvas
  (if (ge i n)
      c
      (let l (bit_and (bit_shr word (mul 4 (sub 15 i))) 15)
        (ui_cov_word (ui_cov_put c k (add x i) y l color) k word x y n (add i 1) color))))

(def ui_cov_put ((c Canvas) (k Rect) (x int) (y int) (l int) (color int)) Canvas
  (if (eq l 0)
      c
      (if (eq l 15)
          (ui_put c k x y color)
          (ui_blend c k x y color (div (add (mul l 100) 7) 15) -1))))

; Text in r, along it as a says, in its middle up and down: cut short
; with "..." if it is too wide. Bold is struck twice, a pixel apart.
(def ui_text ((c Canvas) (font (array int)) (k Rect) (r Rect) (s (list int)) (a UiAlign) (color int) (bold bool) (scale int)) Canvas
  (if (eq (array_len font) 0)
      c
      (let shown (ui_ellipsized s (sub (rect_w r) (if bold 1 0)) scale)
        (let x (ui_aligned (rect_x r) (rect_w r) (ui_text_w shown bold scale) a)
          (let y (add (rect_y r) (div (sub (rect_h r) (mul (ui_char_h) scale)) 2))
            (let t (ui_chars c font k x y shown color scale)
              (if bold (ui_chars t font k (add x 1) y shown color scale) t)))))))

(def ui_chars ((c Canvas) (font (array int)) (k Rect) (x int) (y int) (s (list int)) (color int) (scale int)) Canvas
  (if (is_empty s)
      c
      (ui_chars (ui_glyph c font k x y (drawable (head s)) color scale 0) font k (add x (mul (ui_char_w) scale)) y (tail s) color scale)))

(def ui_glyph ((c Canvas) (font (array int)) (k Rect) (x int) (y int) (code int) (color int) (scale int) (r int)) Canvas
  (if (eq r (ui_char_h))
      c
      (ui_glyph (ui_bits c k x (add y (mul r scale)) (glyph_row font code r) 8 color scale 0) font k x y code color scale (add r 1))))

; The lit bits of a row n wide, the leftmost the highest, from x, y.
(def ui_bits ((c Canvas) (k Rect) (x int) (y int) (bits int) (n int) (color int) (scale int) (col int)) Canvas
  (if (eq col n)
      c
      (ui_bits (if (eq (bit_and (bit_shr bits (sub (sub n 1) col)) 1) 1)
                   (ui_dot c k (add x (mul col scale)) y color scale)
                   c)
               k x y bits n color scale (add col 1))))

; A pixel of text or an icon: scale by scale pixels.
(def ui_dot ((c Canvas) (k Rect) (x int) (y int) (color int) (scale int)) Canvas
  (if (eq scale 1) (ui_put c k x y color) (ui_fill c k (Rect x y scale scale) color)))

; Icon name at x, y of the desktop's pixels, at the face's scale: at 2,
; the face's icon of its size, or, if it has none, the bitmap doubled.
(def ui_icon_at ((c Canvas) (face UiFace) (k Rect) (x int) (y int) (name (list int)) (color int) (scale int)) Canvas
  (let s (ui_face_scale face)
    (let n (mul (mul (ui_icon_size) scale) s)
      (match (if (eq s 1) ((None UiCov)) (ui_face_table face (ui_icon_table name n)))
        ((Some cov) (ui_cov_blit c k cov (mul x s) (mul y s) 0 n color))
        ((None) (ui_icon c k (mul x s) (mul y s) (ui_icon_rows name) color (mul scale s) 0))))))

(def ui_icon ((c Canvas) (k Rect) (x int) (y int) (rows (list int)) (color int) (scale int) (r int)) Canvas
  (if (is_empty rows)
      c
      (ui_icon (ui_bits c k x (add y (mul r scale)) (head rows) (ui_icon_size) color scale 0) k x y (tail rows) color scale (add r 1))))

; ----------------------------------------------------------------- buffers

; A buffer of w by h pixels, shared memory of this process's, to give to
; the compositor or the display: its address, its pages, and its canvas;
; or why not.
(data UiBuf (UiBuf int int Canvas) (UiNoBuf (list int)))

(def ui_buffer ((w int) (h int)) UiBuf
  (let n (buffer_pages w h)
    (match (shm_region n "a buffer")
      ((NoShmRegion why) (UiNoBuf why))
      ((ShmRegion va r) (UiBuf va n (Canvas r w h 0))))))

; A buffer w by h of the desktop's pixels at scale s: s times as wide and
; high in the screen's.
(def ui_buffer_at ((w int) (h int) (s int)) UiBuf (ui_buffer (mul w s) (mul h s)))

; A canvas's width and height in the desktop's pixels: its own over the
; face's scale.
(def ui_logical_w ((cv Canvas) (face UiFace)) int (div (canvas_w cv) (ui_face_scale face)))
(def ui_logical_h ((cv Canvas) (face UiFace)) int (div (canvas_h cv) (ui_face_scale face)))

; ------------------------------------------------------------------ cursor

; Adwaita's pointer: a black arrow edged white, its hot spot its tip, at
; the top left.
(def ui_arrow_art () (list (list int))
  (split_spaces (append "W WW WBW WBBW WBBBW WBBBBW WBBBBBW WBBBBBBW WBBBBBBBW WBBBBBBBBW "
                        "WBBBBBWWWWW WBBWBBW WBW.WBBW WW..WBBW W....WBBW .....WBBW ......WW")))

(def ui_opaque () int 4278190080)       ; ff000000, alpha

; The arrow drawn into c, a cursor's 64 by 64 buffer of b, g, r, alpha:
; what it does not cover stays as it was, clear.
(def ui_paint_arrow ((c Canvas)) Canvas (ui_arrow_rows c (ui_arrow_art) 0))

; The arrow at the face's scale: at 2, the face's pointer, twice the size
; and its edges smooth, each pixel's alpha what it covers; else the 1x
; arrow.
(def ui_paint_cursor ((c Canvas) (face UiFace)) Canvas
  (match (if (lt (ui_face_scale face) 2) ((None UiCov)) (ui_face_table face "cursor"))
    ((None) (ui_paint_arrow c))
    ((Some cov) (match cov ((UiCov w h words) (ui_cursor_px c words (min w (canvas_w c)) (min h (canvas_h c)) w 0))))))

(def ui_cursor_px ((c Canvas) (words (array int)) (w int) (h int) (stride int) (i int)) Canvas
  (if (ge i (mul w h))
      c
      (let x (mod i w)
        (let y (div i w)
          (ui_cursor_px (put c x y (array_get words (add (mul y stride) x))) words w h stride (add i 1))))))

(def ui_arrow_rows ((c Canvas) (rows (list (list int))) (y int)) Canvas
  (if (is_empty rows)
      c
      (ui_arrow_rows (ui_arrow_row c (head rows) 0 y) (tail rows) (add y 1))))

(def ui_arrow_row ((c Canvas) (row (list int)) (x int) (y int)) Canvas
  (if (is_empty row)
      c
      (ui_arrow_row (if (eq (head row) 87) (put c x y (bit_or (ui_opaque) (ui_white)))      ; W
                        (if (eq (head row) 66) (put c x y (ui_opaque)) c))                     ; B
                    (tail row) (add x 1) y)))
