; uiloop_test.l0 -- tests of the toolkit's loop: the slow step's line,
; and when it is said.

; A step of 37.25 ms: 0.1 routing, 2 in the app's update and view, 20.3
; laying out, none waiting, 10 painting, 4.85 presenting.
(def slow () UiStages (UiStages 100000 2000000 20300000 0 10000000 4850000))

(def test_slow_line () int
  (check_str "each stage" (ui_slow_line (slow))
    "slow step: 37.3 ms: route 0.1, update and view 2.0, layout 20.3, wait 0.0, paint 10.0, present 4.9"))

(def test_ms_text () int
  (add (check_str "a tenth" (ui_ms_text 100000) "0.1")
       (add (check_str "rounded" (ui_ms_text 16049999) "16.0")
            (check_str "none" (ui_ms_text 0) "0.0"))))

; A step over 16 ms is said if none was since the last under it; one
; under is never said.
(def test_slow_due () int
  (add (check_bool "slow, first" (ui_slow_due 17000000 false) true)
       (add (check_bool "slow again" (ui_slow_due 17000000 true) false)
            (check_bool "a frame" (ui_slow_due 16000000 false) false))))

; The stages of a present at 10 ms, after a route from 1 ms to 2: the
; route 1, the update and view 8, then each of the present's.
(def stages_text ((s UiStages)) (list int)
  (match s ((UiStages r u l w p e) (unwords (cons (digits r) (cons (digits u) (cons (digits l) (cons (digits w) (cons (digits p) (cons (digits e) (nil (list int))))))))))))

(def test_stages_of () int
  (add (check_str "routed" (stages_text (ui_stages_of (UiTimes 1 2 0 false) 10 13 14 20 21)) "1 8 3 1 6 1")
       (check_str "no route" (stages_text (ui_stages_of (ui_times_new) 10 13 14 20 21)) "0 0 3 1 6 1")))

; A route is timed, its start and end kept in the window's times, the
; start first.
(def test_route_timed () int
  (match (ui_route (loop_win) (UiLeave))
    ((UiRouted w a)
      (match (ui_win_times_of w)
        ((UiTimes s r p said) (add (check_true "started" (gt s 0)) (check_true "ended after" (ge r s))))))))

; A window of a compositor whose pid is 9, laid out with nothing.
(def loop_win () UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoDevice 0) 100 34 0) 4 (ui_face_none) (ui_state_new (UiLight))
         (nil UiNode) 0 0 (ui_click_none) (UiMem 0 1 100 34 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new)))

; ---------------------------------------------------------------- replies

; What a loop hands out, as text.
(def got_text ((t UiTaken)) (list int)
  (match t
    ((UiTaken l g)
      (match g
        ((UiGotMsg m) "msg") ((UiGotStrike p) (append "strike " p)) ((UiGotReply tag m) (append "reply " (digits tag)))
        ((UiGotIdle) "idle") ((UiGotRedraw id) (append "redraw " (digits id))) ((UiGotLost) "lost")))))

; An ask that cannot be sent, as under an operating system, is answered
; at once, a reply that failed, with its tag, before anything waits.
(def test_ask_unsent () int
  (check_str "answered" (got_text (ui_loop_take (ui_loop_ask (ui_loop_ports 5 6) 42 9 "list /") 4 9 ((MapEmpty int int)))) "reply 42"))

; A window to be told a strike came is handed out first.
(def test_redraw_first () int
  (check_str "window 3" (got_text (ui_loop_take (ui_loop_redrawing (ui_loop_new) (cons 3 (nil int))) 4 9 ((MapEmpty int int)))) "redraw 3"))

; With idle work and nothing waiting, its turn, not a wait.
(def test_idle_turn () int
  (check_str "idle" (got_text (ui_loop_take (ui_loop_idling (ui_loop_new) true) 4 9 ((MapEmpty int int)))) "idle"))

; With nothing at all, as under an operating system, the port is gone.
(def test_nothing_lost () int
  (check_str "lost" (got_text (ui_loop_take (ui_loop_new) 4 9 ((MapEmpty int int)))) "lost"))

; ------------------------------------------------------------- kept parts

; A label keyed "page" beside a button, laid out 200 by 40, the button
; hovered or not.
(def kept_view () UiWidget
  (UiBox (UiH) 0 (cons (UiButton "app.back" "" "Back" (UiBtnRegular) true) (cons (UiExpand (UiKeyed "page" (UiLabel "words" (UiBody) (UiStart)))) (nil UiWidget)))))
(def kept_laid ((hover (list int))) (list UiNode) (ui_layout_window (kept_view) 200 40 (ui_st_hovering (ui_state_new (UiLight)) hover)))

; Laid out with and without the pointer over Back, the page is the same,
; so its nodes are left out of the diff on both sides: only the button's
; and the ground's are compared, and what changed is the button.
(def test_parts_same () int
  (let a (kept_laid "")
    (let b (kept_laid "app.back")
      (let same (ui_parts_same a b)
        (add (check_int "one part" (length same) 1)
             (add (check_int "its mark and label out" (sub (length b) (length (ui_parts_out b same))) 2)
                  (check_int "damage, the button" (length (ui_changed (ui_parts_out a same) (ui_parts_out b same) (Rect 0 0 200 40))) 1)))))))

; ------------------------------------------------------- putting together

; Notices from the compositor, pid 9, of window id: the pointer at x, y
; with buttons b, the wheel's dy steps at x, y, a key, a size; and a
; message from pid 30.
(def mv ((id int) (x int) (y int) (b int)) Message (message_new 9 (win_notice id (pointer_notice (PointerEvent x y b)))))
(def whl ((id int) (x int) (dy int)) Message (message_new 9 (win_notice id (wheel_notice (WheelEvent x 5 0 dy)))))
(def ky ((id int)) Message (message_new 9 (win_notice id (key_notice (KeyEvent 30 1 97 0)))))
(def sz ((id int) (w int)) Message (message_new 9 (win_notice id (size_notice w 100))))
(def other () Message (message_new 30 "hello"))

; A message as text, as ui_together leaves it.
(def msg_text_of ((m Message)) (list int)
  (match (win_notice_of m)
    ((NoWinNotice) "other")
    ((WinNotice id at)
      (match (pointer_event_at m at)
        ((Some p) (match p ((PointerEvent x y b) (append "ptr" (append (digits id) (append "@" (append (digits x) (append "b" (digits b)))))))))
        ((None)
          (match (wheel_event_at m at)
            ((Some e) (match e ((WheelEvent x y dx dy) (append "whl" (append (digits id) (append "@" (append (digits x) (append "d" (digits dy)))))))))
            ((None)
              (match (size_notice_at m at)
                ((Some s) (append "siz" (append (digits id) (append "w" (digits (head s))))))
                ((None) (append "key" (digits id)))))))))))

(def msgs_text ((ms (list Message))) (list int)
  (if (is_empty ms) "" (append (msg_text_of (head ms)) (if (is_empty (tail ms)) "" (append " " (msgs_text (tail ms)))))))

; Windows 3 and 5, no button held.
(def held0 () (Map int int) (map_put (map_put ((MapEmpty int int)) 3 0) 5 0))

(def together ((ms (list Message))) (list int) (msgs_text (ui_together ms 9 (held0))))

(def l1 ((a Message)) (list Message) (cons a (nil Message)))
(def l2 ((a Message) (b Message)) (list Message) (cons a (l1 b)))
(def l3 ((a Message) (b Message) (c Message)) (list Message) (cons a (l2 b c)))
(def l4 ((a Message) (b Message) (c Message) (d Message)) (list Message) (cons a (l3 b c d)))

; Moves that follow one another: only the last.
(def test_moves () int
  (check_str "the last" (together (l3 (mv 3 1 1 0) (mv 3 2 1 0) (mv 3 3 1 0))) "ptr3@3b0"))

; A press and a release stop a run: the move before the press, the
; press, the last move while held, the release, the move after.
(def test_press_release () int
  (check_str "each kept"
    (together (cons (mv 3 1 1 0) (cons (mv 3 2 1 1) (cons (mv 3 3 1 1) (cons (mv 3 4 1 1) (cons (mv 3 5 1 0) (l1 (mv 3 6 1 0))))))))
    "ptr3@1b0 ptr3@2b1 ptr3@4b1 ptr3@5b0 ptr3@6b0"))

; The first notice of a window whose buttons the toolkit knows held is a
; release, kept, though a move with the same buttons follows.
(def test_held_known () int
  (check_str "a release"
    (msgs_text (ui_together (l2 (mv 3 1 1 0) (mv 3 2 1 0)) 9 (map_put ((MapEmpty int int)) 3 1)))
    "ptr3@1b0 ptr3@2b0"))

; A window not known: its first pointer notice is kept.
(def test_held_unknown () int
  (check_str "kept" (msgs_text (ui_together (l2 (mv 7 1 1 0) (mv 7 2 1 0)) 9 ((MapEmpty int int)))) "ptr7@1b0 ptr7@2b0"))

; The wheel's turns in a run, between moves as the tablet sends them:
; one, at the last's place, their steps summed, and the last move.
(def test_wheel_summed () int
  (check_str "summed" (together (l4 (whl 3 1 1) (mv 3 1 1 0) (whl 3 2 2) (mv 3 2 1 0))) "whl3@2d3 ptr3@2b0"))

; Up and down cancel, and a key stops the run: the turn before it kept.
(def test_wheel_key () int
  (add (check_str "cancelled" (together (l2 (whl 3 1 -2) (whl 3 1 2))) "whl3@1d0")
       (check_str "a key between" (together (l3 (whl 3 1 1) (ky 3) (whl 3 1 1))) "whl3@1d1 key3 whl3@1d1")))

; A key between moves keeps both: no key is dropped, none moved.
(def test_key_between () int
  (check_str "all three" (together (l3 (mv 3 1 1 0) (ky 3) (mv 3 2 1 0))) "ptr3@1b0 key3 ptr3@2b0"))

; Two windows' moves, one after the other's: each window's last, as
; another window's notice does not stop a run.
(def test_two_windows () int
  (check_str "each its last" (together (l4 (mv 3 1 1 0) (mv 5 1 1 0) (mv 3 2 1 0) (mv 5 2 1 0))) "ptr3@2b0 ptr5@2b0"))

; Sizes asked: the last of a window's.
(def test_sizes () int
  (check_str "the last" (together (l3 (sz 3 100) (sz 5 50) (sz 3 200))) "siz5w50 siz3w200"))

; Anything not the compositor's is kept, and stops nothing.
(def test_others () int
  (check_str "kept" (together (l3 (mv 3 1 1 0) (other) (mv 3 2 1 0))) "other ptr3@2b0"))

; A property: a hundred seeded queues of moves, presses, wheels and keys
; of two windows put together lose no key, press or release, and keep
; them in order, as the queue with every move and wheel left out.
(def rand_msg ((s int)) Message
  (let id (if (eq (rand_below s 2) 0) 3 5)
    (let k (rand_below (rand_next s) 6)
      (if (lt k 2) (mv id (rand_below s 50) 1 0)
        (if (eq k 2) (mv id 7 1 1)
          (if (eq k 3) (whl id 1 1)
            (ky id)))))))

(def rand_queue ((s int) (n int) (acc (list Message))) (list Message)
  (if (le n 0) acc (rand_queue (rand_next (rand_next s)) (sub n 1) (cons (rand_msg s) acc))))

; Of ms, only the keys, and the pointer notices whose buttons are not
; their window's before, in order: what must survive.
(def barriers ((ms (list Message)) (bs (Map int int)) (acc (list (list int)))) (list (list int))
  (if (is_empty ms)
      (rev acc)
      (let m (head ms)
        (match (win_notice_of m)
          ((NoWinNotice) (barriers (tail ms) bs acc))
          ((WinNotice id at)
            (match (pointer_event_at m at)
              ((Some p) (match p ((PointerEvent x y b)
                (if (eq (map_get bs id) (Some b)) (barriers (tail ms) bs acc) (barriers (tail ms) (map_put bs id b) (cons (msg_text_of m) acc))))))
              ((None) (if (is_empty (ui_opt_list (wheel_event_at m at))) (barriers (tail ms) bs (cons (msg_text_of m) acc)) (barriers (tail ms) bs acc)))))))))

(def together_agree ((s int) (i int) (bad int)) int
  (if (ge i 100)
      bad
      (let q (rand_queue s (add 1 (rand_below s 30)) (nil Message))
        (let ok (eq (barriers (ui_together q 9 (held0)) (held0) (nil (list int))) (barriers q (held0) (nil (list int))))
          (together_agree (rand_next (rand_next (rand_next s))) (add i 1) (if ok bad (add bad 1)))))))

(def test_together_keeps_order () int
  (check_int "none differ" (together_agree 11 0 0) 0))

; After a slow step the next slow one is not said, and after one under a
; frame it is again; the route is forgotten either way. Under an
; operating system the line said goes nowhere.
(def test_times_stepped () int
  (match (ui_times_stepped (UiTimes 1 2 3 false) (slow))
    ((UiTimes s r p said)
      (add (check_bool "said" said true)
           (add (check_int "no route" s 0)
                (match (ui_times_stepped (UiTimes 0 0 0 true) (UiStages 0 0 1000000 0 0 0))
                  ((UiTimes s2 r2 p2 said2) (check_bool "under a frame" said2 false))))))))
