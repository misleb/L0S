; metrics.l0 -- the faces' metrics, which the toolkit measures and places
; text by (paint.l0's ui_text_w): each face's units per em, the advance
; of each of codes 32 to 126 and its pairs' kerning, in font units. Written by
; tools/mkmetrics from the fonts in fonts/; make metrics writes it
; again, and make check fails if it differs. Not edited by hand.

; code's units per em.
(def ui_m_code_upm () int 1000)

; code's advance of code c, 32 to 126, in font units.
(def ui_m_code_adv ((c int)) int 600)

; code's widest advance of those codes.
(def ui_m_code_widest () int 600)

; code's kerning of code l then code r, in font units: GPOS's pair
; adjustment, 0 for a pair it does not adjust.
(def ui_m_code_kern ((l int) (r int)) int 0)

; code-bold's units per em.
