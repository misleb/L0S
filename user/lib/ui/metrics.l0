; metrics.l0 -- the faces' metrics, which the toolkit measures and places
; text by (paint.l0's ui_text_w): each face's units per em and the
; advance of each of codes 32 to 126, in font units. Written by
; tools/mkmetrics from the fonts in fonts/; make metrics writes it
; again, and make check fails if it differs. Not edited by hand.

; code's units per em.
(def ui_m_code_upm () int 1000)

; code's advance of code c, 32 to 126, in font units.
(def ui_m_code_adv ((c int)) int 600)

; code-bold's units per em.
(def ui_m_code_bold_upm () int 1000)

; code-bold's advance of code c, 32 to 126, in font units.
(def ui_m_code_bold_adv ((c int)) int 600)

; sans's units per em.
