(def mrect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; The actions of the nodes that have one, and where each is.
(def menu_targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (menu_targets (tail ns)) (append a (append "@" (append (mrect r) (append " " (menu_targets (tail ns)))))))))))

(def menu_light () UiState (ui_state_new (UiLight)))

; New Folder..., a line, and Refresh, which cannot be chosen.
(def items () (list UiMenuItem)
  (cons (UiItem "app.new" "New Folder..." true) (cons (UiItemSep) (cons (UiItem "app.refresh" "Refresh" false) (nil UiMenuItem)))))

(def menu_at ((a UiAnchor)) UiWidget
  (UiPopover (UiButton "app.menu" "open-menu" "" (UiBtnFlat) true) (UiMenu "menu" a (items))))

; At least 160 wide, as New Folder..., 96 and 18 either side, is less;
; 6 above and below, two rows of 30 and the line's 13: 85.
(def test_ui_menu_size () int
  (match (ui_menu_size (items)) ((UiSize w h) (add (check_int "wide" w 160) (check_int "high" h 85)))))

; Over a window 400 by 300 whose button, 34 square, is in its middle at
; 183, 133: the card under it, 4 below, centered on it, at 120, 171;
; over everything beneath, the node that dismisses it; then the card's
; own ground, and its one item that can be chosen, 6 in. The line and
; Refresh are no targets.
(def test_ui_menu_below () int
  (check_str "the button, the catcher, the card, its item"
    (menu_targets (ui_layout_window (menu_at (UiBelow "app.menu")) 400 300 (menu_light)))
    "app.menu@183,133 34x34 menu.dismiss@0,0 400x300 menu.card@120,171 160x85 app.new@126,177 148x30 "))

; Asked for at 380, 290, it is kept 6 inside the window: at 234, 209.
(def test_ui_menu_clamped () int
  (check_bool "inside"
    (ends_with (menu_targets (ui_layout_window (menu_at (UiAt 380 290)) 400 300 (menu_light))) "menu.card@234,209 160x85 app.new@240,215 148x30 ")
    true))

; A press outside the card is the dismiss, even over the button beneath;
; on its item, the item.
(def test_ui_menu_hits () int
  (let ns (ui_layout_window (menu_at (UiBelow "app.menu")) 400 300 (menu_light))
    (add (check_str "outside" (ui_hit ns 10 10) "menu.dismiss")
         (add (check_str "over the button" (ui_hit ns 190 140) "menu.dismiss")
              (add (check_str "on the item" (ui_hit ns 130 190) "app.new")
                   (check_str "on Refresh" (ui_hit ns 130 230) "menu.card"))))))

; With no node of its anchor's action, it is in the window's middle.
(def test_ui_menu_no_anchor () int
  (check_bool "in the middle"
    (ends_with (menu_targets (ui_layout_window (menu_at (UiBelow "app.none")) 400 300 (menu_light))) "menu.card@120,107 160x85 app.new@126,113 148x30 ")
    true))
