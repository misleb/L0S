; Every icon 16 rows of 16.
(def all_square ((names (list (list int)))) int
  (if (is_empty names)
      0
      (add (check_int (head names) (length (ui_icon_art (head names))) 16)
           (add (rows_of_16 (head names) (ui_icon_art (head names)))
                (all_square (tail names))))))

(def rows_of_16 ((name (list int)) (rows (list (list int)))) int
  (if (is_empty rows)
      0
      (add (if (eq (length (head rows)) 16) 0 (fail_because name (append "a row is not 16: " (head rows))))
           (rows_of_16 name (tail rows)))))

(def test_ui_icons_square () int (all_square (ui_icon_names)))

(def test_ui_icon_none () int
  (check_int "no such icon" (length (ui_icon_rows "no-such-icon")) 0))

; window-close's first lit row: columns 4, 5, 10, and 11.
(def test_ui_icon_bits () int
  (check_int "row 4 of the close icon" (nth_int (ui_icon_rows "window-close") 4)
             (add (add 2048 1024) (add 32 16))))

(def nth_int ((xs (list int)) (i int)) int (if (eq i 0) (head xs) (nth_int (tail xs) (sub i 1))))

(def test_ui_pan_up_mirrors () int
  (check_bool "pan-up is pan-down upside down"
    (eq (ui_icon_rows "pan-up") (rev (ui_icon_rows "pan-down"))) true))
