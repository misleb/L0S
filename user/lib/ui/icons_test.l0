; icons_test.l0 -- every icon the toolkit names has its SVG under
; icons/, which tools/mkicons draws it from.

; Where an icon's SVG is: Adwaita's, or else System Monitor's.
(def svg_of ((name (list int))) (list int)
  (if (eq name "utilities-system-monitor")
      "icons/gnome-system-monitor/symbolic/utilities-system-monitor-symbolic.svg"
      (append "icons/adwaita/symbolic/" (append name "-symbolic.svg"))))

(def all_there ((names (list (list int)))) int
  (if (is_empty names)
      0
      (add (match (read_whole (svg_of (head names)))
             ((Ok b) (check_true (head names) (gt (bytes_len b) 0)))
             ((Err why) (fail_because (head names) why)))
           (all_there (tail names)))))

(def test_ui_icons_have_svgs () int (all_there (ui_icon_names)))

(def test_ui_icon_size () int (check_int "16" (ui_icon_size) 16))

; Every full-color icon has its SVG under icons/adwaita/scalable.
(def images_there ((names (list (list int)))) int
  (if (is_empty names)
      0
      (add (match (read_whole (append "icons/adwaita/scalable/" (append (head names) ".svg")))
             ((Ok b) (check_true (head names) (gt (bytes_len b) 0)))
             ((Err why) (fail_because (head names) why)))
           (images_there (tail names)))))

(def test_ui_images_have_svgs () int (images_there (ui_image_names)))
