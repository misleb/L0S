; A switch or check box turns over on its own toggle, and only on it.
(def test_toggled () int
  (add (check_bool "its toggle" (ui_toggled "wifi" false "wifi.toggle") true)
       (add (check_bool "again" (ui_toggled "wifi" true "wifi.toggle") false)
            (check_bool "another's" (ui_toggled "wifi" false "dark.toggle") false))))

; A slider's value after its set, kept in its range, and after a step, a
; twentieth of 0 to 100, 5.
(def test_scale_value () int
  (add (check_int "set" (ui_scale_value "vol" 50 0 100 "vol.set.20") 20)
       (add (check_int "kept in range" (ui_scale_value "vol" 50 0 100 "vol.set.140") 100)
            (add (check_int "a step on" (ui_scale_value "vol" 50 0 100 "vol.step.1") 55)
                 (add (check_int "a step back at the start" (ui_scale_value "vol" 2 0 100 "vol.step.-1") 0)
                      (check_int "another's" (ui_scale_value "vol" 50 0 100 "tip.set.20") 50))))))

; A range of 10 steps by 1, not by none.
(def test_scale_step () int
  (add (check_int "0 to 10" (ui_scale_step 0 10) 1) (check_int "0 to 1000" (ui_scale_step 0 1000) 50)))

; A node's action names the slider and its range, however many dots its
; name has; anything else is no slider's.
(def test_scale_of () int
  (add (check_str "dotted" (match (ui_scale_of "page.tip.scale.10.30") ((UiScaleAt n lo hi) (append n (append " " (digits hi)))) ((UiNoScale) "none"))
                  "page.tip 30")
       (add (check_bool "a button's" (ui_is_scale "app.refresh") false)
            (check_bool "not numbers" (ui_is_scale "a.scale.x.y") false))))

; The value at the x where a value is drawn is that value, all along.
(def test_scale_round_trip () int
  (let t (Rect 10 0 180 6)
    (check_int "none differ" (round_trip_misses t 0 0) 0)))

; How many of v to 100 come back other than themselves, after n.
(def round_trip_misses ((t Rect) (v int) (n int)) int
  (if (gt v 100)
      n
      (round_trip_misses t (add v 1) (if (eq (ui_scale_value_at t 0 100 (ui_scale_x t 0 100 v)) v) n (add n 1)))))

; The ops of the node whose action is a, laid out at 200 by 40.
(def ops_of ((w UiWidget) (a (list int))) (list UiPaint)
  (ops_in (ui_laid w 200 40) a))
(def ops_in ((ns (list UiNode)) (a (list int))) (list UiPaint)
  (if (is_empty ns) (nil UiPaint) (eq (.action (head ns)) a) (.ops (head ns)) (ops_in (tail ns) a)))

; Where each round op is, as X.Y.W.R.COLOR, space between.
(def rounds ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPRound r rad c u) (append (digits (.x r)) (append "." (append (digits (.w r)) (append "." (append (hex_digits c 6) " "))))))
                ((UiPFill r c) "") ((UiPText r s a c f b sc) "") ((UiPIcon x y n c sc) (append "icon." (append n " "))) ((UiPImage x y n d cov) ""))
              (rounds (tail ops)))))

; A switch, 48 by 26 at the start of 200: its pill the trough's color
; while off, the text's at 15% on the light window, its knob 3 in from
; its start; while on, the accent, the knob 3 in from its end, at 48 - 3
; - 20 = 25.
(def test_switch_knob () int
  (add (check_str "off" (rounds (ops_of (UiSwitch "wifi" false) "wifi.toggle"))
                  (append "0.48." (append (hex_digits (ui_trough_bg (UiLight) (ui_window_bg (UiLight))) 6) " 3.20.ffffff ")))
       (check_str "on" (rounds (ops_of (UiSwitch "wifi" true) "wifi.toggle"))
                  (append "0.48." (append (hex_digits (ui_accent_bg) 6) " 25.20.ffffff ")))))

; A check box on has its check, Adwaita's object-select, and its label
; is drawn beside it.
(def test_check () int
  (let ns (ui_laid (UiCheck "milk" true "Buy milk") 200 40)
    (add (check_bool "the check" (contains (rounds (ops_in ns "milk.toggle")) "icon.object-select") true)
         (add (check_bool "the label" (ui_has_text ns "Buy milk") true)
              (check_bool "off: no check" (contains (rounds (ops_of (UiCheck "milk" false "Buy milk") "milk.toggle")) "icon") false)))))

; A check box's natural size: its square, 6 and its label.
(def test_check_size () int
  (check_int "wide" (.sw (ui_check_size_of "ab")) (add 22 (ui_text_w "ab" (ui_text_font) false 1))))

; A slider at a quarter: its trough from 10, 180 wide, filled in the
; accent to 55, and its knob's middle there.
(def test_scale_node () int
  (check_str "trough, fill, knob" (rounds (ops_of (UiScale "vol" 25 0 100 200) "vol.scale.0.100"))
             (append "10.180." (append (hex_digits (ui_trough_bg (UiLight) (ui_window_bg (UiLight))) 6)
                                       (append " 10.45." (append (hex_digits (ui_accent_bg) 6) " 45.20.ffffff "))))))

; A slider focused, its knob at either end: its ring, 2 round the knob,
; is inside its node, so painting does not cut it.
(def test_scale_ring_inside () int
  (let st (.focus (ui_state_new (UiLight)) "vol.scale.0.100")
    (add (check_str "at the start" (ui_ops_past (ui_layout_window (UiScale "vol" 0 0 100 200) 200 40 st)) "")
         (check_str "at the end" (ui_ops_past (ui_layout_window (UiScale "vol" 100 0 100 200) 200 40 st)) ""))))

; A spinner is eight dots, the lit one in the text's color.
(def test_spinner () int
  (let ops (.ops (head (tail (ui_laid (UiSpinner 2 32) 40 40))))
    (add (check_int "eight" (length ops) 8)
         (check_bool "one lit" (contains (rounds ops) (hex_digits (ui_fg (UiLight)) 6)) true))))

; It turns round eight.
(def test_spinner_next () int
  (add (check_int "on" (ui_spinner_next 3) 4) (check_int "round" (ui_spinner_next 7) 0)))
