; icons.l0 -- Adwaita's symbolic icons, the few the toolkit draws: 16 by
; 16, one color, drawn in the color of the text beside them. Each is kept
; as it looks, 16 rows of 16 of # and ., so that it can be read and
; changed here, and is turned into a row's 16 bits, the leftmost the
; highest, as it is drawn. Named as GNOME's icon theme names them.

; An icon's width and height, in pixels.
(def ui_icon_size () int 16)

; Every icon there is.
(def ui_icon_names () (list (list int))
  (split_spaces (append "window-close pan-down pan-up view-refresh open-menu system-search drive-harddisk "
                (append "utilities-terminal utilities-system-monitor view-app-grid "
                        "folder text-x-generic application-x-executable go-previous go-next view-list view-grid computer"))))

; An icon's rows as drawn, or none for a name there is no icon of.
(def ui_icon_art ((name (list int))) (list (list int))
  (if (eq name "window-close") (ui_icon_close)
  (if (eq name "pan-down") (ui_icon_pan_down)
  (if (eq name "pan-up") (rev (ui_icon_pan_down))
  (if (eq name "view-refresh") (ui_icon_refresh)
  (if (eq name "open-menu") (ui_icon_menu)
  (if (eq name "system-search") (ui_icon_search)
  (if (eq name "drive-harddisk") (ui_icon_drive)
  (ui_icon_art_files name)))))))))

; The icons of files and of finding them: a folder, a document, a
; program, back and forward, a list and a grid, and the computer.
(def ui_icon_art_files ((name (list int))) (list (list int))
  (if (eq name "folder") (ui_icon_folder)
  (if (eq name "text-x-generic") (ui_icon_document)
  (if (eq name "application-x-executable") (ui_icon_program)
  (if (eq name "go-previous") (ui_icon_back)
  (if (eq name "go-next") (ui_mirrored (ui_icon_back))
  (if (eq name "view-list") (ui_icon_list)
  (if (eq name "view-grid") (ui_icon_grid)
  (if (eq name "computer") (ui_icon_computer)
  (ui_icon_art_apps name))))))))))

; The icons apps are drawn with, in the launcher.
(def ui_icon_art_apps ((name (list int))) (list (list int))
  (if (eq name "utilities-terminal") (ui_icon_terminal)
  (if (eq name "utilities-system-monitor") (ui_icon_monitor)
  (if (eq name "view-app-grid") (ui_icon_app_grid)
  (nil (list int))))))

; An icon's rows as bits, the leftmost pixel bit 15; none for no icon.
(def ui_icon_rows ((name (list int))) (list int)
  (ui_art_bits (ui_icon_art name) (nil int)))

; Each of rows as ui_row_bits makes it, in order, onto acc reversed.
(def ui_art_bits ((rows (list (list int))) (acc (list int))) (list int)
  (if (is_empty rows)
      (rev acc)
      (ui_art_bits (tail rows) (cons (ui_row_bits (head rows) 0) acc))))

; A row of # and . as bits, a 1 for each #, the first the highest, after
; the bits acc.
(def ui_row_bits ((row (list int)) (acc int)) int
  (if (is_empty row)
      acc
      (ui_row_bits (tail row) (bit_or (bit_shl acc 1) (if (eq (head row) 35) 1 0)))))

; n blank rows of 16 . each, before the rows acc.
(def ui_blank_rows ((n int) (acc (list (list int)))) (list (list int))
  (if (le n 0) acc (ui_blank_rows (sub n 1) (cons "................" acc))))

; Rows in the middle of an icon: n blank above them, and as many below
; as make 16.
(def ui_art ((above int) (rows (list (list int)))) (list (list int))
  (ui_blank_rows above (append rows (ui_blank_rows (sub (sub 16 above) (length rows)) (nil (list int))))))

; A close button's cross, window-close.
(def ui_icon_close () (list (list int))
  (ui_art 4 (split_spaces (append "....##....##.... .....##..##..... ......####...... "
                          (append ".......##....... ......####...... .....##..##..... "
                                  "....##....##....")))))

; A chevron pointing down, pan-down; pan-up is it upside down.
(def ui_icon_pan_down () (list (list int))
  (ui_art 6 (split_spaces (append "...##......##... ....##....##.... .....##..##..... "
                                  "......####...... .......##......."))))

; A circle, open at its top right, with an arrowhead there, view-refresh.
(def ui_icon_refresh () (list (list int))
  (ui_art 2 (split_spaces (append "......####.#.... ....##....###... ...#.....####... "
                          (append "..##............ ..#............. ..#..........#.. "
                          (append "..#..........#.. ..##........##.. ...#........#... "
                                  "....##....##.... ......####......"))))))

; Three bars, open-menu.
(def ui_icon_menu () (list (list int))
  (ui_art 4 (split_spaces (append "...##########... ...##########... ................ "
                          (append "...##########... ...##########... ................ "
                                  "...##########... ...##########...")))))

; A drive: its case, the line where its bay begins, and its light.
(def ui_icon_drive () (list (list int))
  (ui_art 3 (split_spaces (append "..############.. .#............#. .#............#. "
                          (append ".#............#. .#............#. .##############. "
                                  ".#............#. .#........##..#. .#............#. ..############..")))))

; A terminal: its prompt, and the cursor after it.
(def ui_icon_terminal () (list (list int))
  (ui_art 4 (split_spaces (append "..##............ ...##........... ....##.......... "
                          (append ".....##......... ....##.......... ...##........... "
                                  "..##...#######..")))))

; A system monitor: a pulse, up and down across a level line.
(def ui_icon_monitor () (list (list int))
  (ui_art 3 (split_spaces (append "....#........... ...#.#.......... ...#.#.......... "
                          (append "..#...#......... ##....#....##### ......#...#..... "
                                  ".......#.#...... .......#.#...... ........#.......")))))

; A grid of apps: three rows of three squares.
(def ui_icon_app_grid () (list (list int))
  (let squares "####..####..#### ####..####..#### ####..####..#### ####..####..#### "
    (let gap "................ ................ "
      (split_spaces (append squares (append gap (append squares (append gap squares))))))))

; Each row of an icon the other way round, right to left.
(def ui_mirrored ((rows (list (list int)))) (list (list int))
  (if (is_empty rows) rows (cons (rev (head rows)) (ui_mirrored (tail rows)))))

; n copies of row, before the rows acc.
(def ui_rows_of ((n int) (row (list int)) (acc (list (list int)))) (list (list int))
  (if (le n 0) acc (ui_rows_of (sub n 1) row (cons row acc))))

; A folder, as Adwaita's folder: its tab, and the case under it.
(def ui_icon_folder () (list (list int))
  (ui_art 2 (append (split_spaces ".#####.......... .#...##########. .#............#. .##############.")
                    (ui_rows_of 7 ".#............#." (split_spaces ".##############.")))))

; A document, text-x-generic: a page, its corner folded, lines of text.
(def ui_icon_document () (list (list int))
  (let blank "...#........#..."
    (ui_art 1 (split_spaces (append "...#######...... ...#.....##..... ...#.....#.#.... ...#.....####... "
                            (append blank (append " ...#.####...#... " (append blank (append " ...#.######.#... "
                            (append blank (append " ...#.######.#... " (append blank (append " ...#.#####..#... "
                            (append blank " ...##########..."))))))))))))))

; A program, application-x-executable: a window, a prompt and a cursor.
(def ui_icon_program () (list (list int))
  (ui_art 2 (split_spaces (append "..############.. ..############.. ..#..........#.. ..#..#.......#.. "
                          (append "..#...#......#.. ..#....#.....#.. ..#...#......#.. ..#..#..####.#.. "
                                  "..#..........#.. ..############..")))))

; A chevron pointing back, go-previous; go-next is it mirrored.
(def ui_icon_back () (list (list int))
  (ui_art 4 (split_spaces (append ".........##..... ........##...... .......##....... ......##........ "
                                  "......##........ .......##....... ........##...... .........##....."))))

; Lines of a list, view-list: three, each a dot and a bar.
(def ui_icon_list () (list (list int))
  (let line ".##.##########.."
    (ui_art 3 (ui_rows_of 2 line (ui_blank_rows 2 (ui_rows_of 2 line (ui_blank_rows 2 (ui_rows_of 2 line (nil (list int))))))))))

; A grid of four squares, view-grid.
(def ui_icon_grid () (list (list int))
  (let row ".######..######."
    (ui_art 1 (ui_rows_of 6 row (ui_blank_rows 2 (ui_rows_of 6 row (nil (list int))))))))

; A computer: its screen, and the stand under it.
(def ui_icon_computer () (list (list int))
  (ui_art 2 (cons ".##############."
              (ui_rows_of 7 ".#............#."
                (split_spaces ".##############. ......####...... ....########....")))))

; A magnifying glass, its lens and handle, system-search.
(def ui_icon_search () (list (list int))
  (ui_art 2 (split_spaces (append ".....####....... ....#....#...... ...#......#..... "
                          (append "...#......#..... ...#......#..... ...#......#..... "
                          (append "....#....#...... .....#####...... .........###.... "
                                  "..........###... ...........###.."))))))
