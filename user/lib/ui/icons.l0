; icons.l0 -- the symbolic icons the toolkit draws: GNOME's, 16 by 16 at
; scale 1, one color, drawn in the color of the text beside them, and
; named as GNOME's icon theme names them. Each is an SVG under icons/
; (icons/adwaita/symbolic/NAME-symbolic.svg, or another GNOME project's
; beside it), which tools/mkicons rasterizes at build time into
; /etc/icons; face.l0 loads it and paint.l0 paints from it. And the
; full-color icons a program loads for itself, as images.

; An icon's width and height, in the desktop's pixels, at scale 1.
(def ui_icon_size () int 16)

; Every icon there is: each has its SVG under icons/.
(def ui_icon_names () (list (list int))
  (split_spaces (append "window-close pan-down pan-up view-refresh open-menu system-search drive-harddisk "
                (append "utilities-terminal utilities-system-monitor view-app-grid "
                        "folder text-x-generic application-x-executable go-previous go-next view-list view-grid computer"))))

; Every full-color icon there is, as Nautilus and Disks show things,
; named as GNOME's theme names them: each is Adwaita's SVG
; (icons/adwaita/scalable/NAME.svg), which tools/mkicon draws at build
; time into /etc/images/NAME.face, and face.l0's ui_images_load reads.
(def ui_image_names () (list (list int))
  (split_spaces "folder text-x-generic application-x-executable drive-harddisk drive-multidisk computer"))
