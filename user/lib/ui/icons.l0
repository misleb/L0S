; icons.l0 -- Adwaita's symbolic icons, the few the toolkit draws: 16 by
; 16, one color, drawn in the color of the text beside them. Each is kept
; as it looks, 16 rows of 16 of # and ., so that it can be read and
; changed here, and is turned into a row's 16 bits, the leftmost the
; highest, as it is drawn. Named as GNOME's icon theme names them.

(def ui_icon_size () int 16)

; Every icon there is.
(def ui_icon_names () (list (list int))
  (split_spaces "window-close pan-down pan-up view-refresh open-menu system-search drive-harddisk"))

; An icon's rows as drawn, or none for a name there is no icon of.
(def ui_icon_art ((name (list int))) (list (list int))
  (if (eq name "window-close") (ui_icon_close)
  (if (eq name "pan-down") (ui_icon_pan_down)
  (if (eq name "pan-up") (rev (ui_icon_pan_down))
  (if (eq name "view-refresh") (ui_icon_refresh)
  (if (eq name "open-menu") (ui_icon_menu)
  (if (eq name "system-search") (ui_icon_search)
  (if (eq name "drive-harddisk") (ui_icon_drive)
  (nil (list int))))))))))

; An icon's rows as bits, the leftmost pixel bit 15; none for no icon.
(def ui_icon_rows ((name (list int))) (list int)
  (ui_art_bits (ui_icon_art name) (nil int)))

(def ui_art_bits ((rows (list (list int))) (acc (list int))) (list int)
  (if (is_empty rows)
      (rev acc)
      (ui_art_bits (tail rows) (cons (ui_row_bits (head rows) 0) acc))))

(def ui_row_bits ((row (list int)) (acc int)) int
  (if (is_empty row)
      acc
      (ui_row_bits (tail row) (bit_or (bit_shl acc 1) (if (eq (head row) 35) 1 0)))))

(def ui_blank_rows ((n int) (acc (list (list int)))) (list (list int))
  (if (le n 0) acc (ui_blank_rows (sub n 1) (cons "................" acc))))

; Rows in the middle of an icon: n blank above them, and as many below
; as make 16.
(def ui_art ((above int) (rows (list (list int)))) (list (list int))
  (ui_blank_rows above (append rows (ui_blank_rows (sub (sub 16 above) (length rows)) (nil (list int))))))

(def ui_icon_close () (list (list int))
  (ui_art 4 (split_spaces (append "....##....##.... .....##..##..... ......####...... "
                          (append ".......##....... ......####...... .....##..##..... "
                                  "....##....##....")))))

(def ui_icon_pan_down () (list (list int))
  (ui_art 6 (split_spaces (append "...##......##... ....##....##.... .....##..##..... "
                                  "......####...... .......##......."))))

(def ui_icon_refresh () (list (list int))
  (ui_art 2 (split_spaces (append "......####.#.... ....##....###... ...#.....####... "
                          (append "..##............ ..#............. ..#..........#.. "
                          (append "..#..........#.. ..##........##.. ...#........#... "
                                  "....##....##.... ......####......"))))))

(def ui_icon_menu () (list (list int))
  (ui_art 4 (split_spaces (append "...##########... ...##########... ................ "
                          (append "...##########... ...##########... ................ "
                                  "...##########... ...##########...")))))

; A drive: its case, the line where its bay begins, and its light.
(def ui_icon_drive () (list (list int))
  (ui_art 3 (split_spaces (append "..############.. .#............#. .#............#. "
                          (append ".#............#. .#............#. .##############. "
                                  ".#............#. .#........##..#. .#............#. ..############..")))))

(def ui_icon_search () (list (list int))
  (ui_art 2 (split_spaces (append ".....####....... ....#....#...... ...#......#..... "
                          (append "...#......#..... ...#......#..... ...#......#..... "
                          (append "....#....#...... .....#####...... .........###.... "
                                  "..........###... ...........###.."))))))
