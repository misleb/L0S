; grid.l0 -- a data grid, as GTK's GtkColumnView with libadwaita's look:
; rows of cells under a header of column titles, on a view's ground. A
; sortable column's title sorts by it when pressed, and again the other
; way; a row is selected by pressing it, and with the arrow keys, Home,
; End, Page Up, and Page Down, which scroll it into view. When there are
; more rows than fit, the wheel scrolls them, three rows a step, and an
; overlay scrollbar says where those shown are; its slider can be
; dragged, and a press on its strip off the slider brings the slider
; there, as GTK's does. When its columns are wider than it, the wheel
; across scrolls them, and a scrollbar along its bottom does the same
; across.
;
; Its actions are named from a prefix the program gives, as PREFIX.sort.N
; for column N's title, PREFIX.select.KEY for the row whose key is KEY,
; and PREFIX.scrollto.N, from window.l0, for row N to be the first
; shown; ui_grid_action makes the grid's next state from one. Its rows'
; area and its scrollbar are a scroller's nodes, as widget.l0 names
; them, PREFIX.scroll and PREFIX.scrollbar. Cells are widgets of their
; own: text, numbers, level bars, statuses, and an icon with text, each
; with the key it sorts by.

; A column: its title, its width, or 0 to share the room left over, how
; its cells and title are aligned, and whether it sorts.
(data UiColumn (UiColumn (list int) int UiAlign bool))

; A cell: what it shows, and so what it sorts by, each kind as beside it.
(data UiCell
  (UiCellText (list int))
  (UiCellNum int (list int))            ; a number, and what follows it, such as " MiB"
  (UiCellSize int)                      ; a size in bytes, as format_size says it, sorted by its bytes
  (UiCellLevel int)                     ; a level bar, in percent
  (UiCellStatus UiTone (list int))      ; a status's dot and text
  (UiCellIcon (list int) (list int))    ; an icon's name, and text
  (UiCellTinted (list int) int (list int)) ; the same, the icon in a color of its own, as an app's
  (UiCellImage (list UiCov) (list int)))  ; an image of its own colors, as an app's icon.svg makes, and text

; A row: its key, which names it in actions and in the selection, and its
; cells, a column each.
(data UiRow (UiRow (list int) (list UiCell)))

; Which column the rows are sorted by, -1 for none, and whether
; descending; the selected row's key, "" for none; the first row shown,
; as scrolling and the keys left it; and how many pixels of its columns
; are scrolled off to the left, as the wheel across left it. The layout
; shows them, or the most that can be if they are past it.
(data UiGridState (UiGridState int bool (list int) int int))

; A grid's state at first: unsorted, nothing selected, from the first row
; and the first column's start.
(def ui_grid_state_new () UiGridState (UiGridState -1 false "" 0 0))

; The selected row's key, "" for none.
(def ui_gs_selected ((s UiGridState)) (list int) (match s ((UiGridState c d k f l) k)))

; A grid to show: its actions' prefix, its columns, its rows, and its
; state.
(data UiGridView (UiGridView (list int) (list UiColumn) (list UiRow) UiGridState))

; How far a cell's content and a title are in from each side of its
; column, in pixels.
(def ui_cell_pad () int 9)

; -------------------------------------------------------------- sorting

; What a cell sorts by: a number, or text.
(data UiSortKey (UiKeyNum int) (UiKeyText (list int)))

; What cell c sorts by: its number for a number, a size or a level, else
; its text.
(def ui_cell_key ((c UiCell)) UiSortKey
  (match c
    ((UiCellText s) (UiKeyText s))
    ((UiCellNum n s) (UiKeyNum n))
    ((UiCellSize n) (UiKeyNum n))
    ((UiCellLevel p) (UiKeyNum p))
    ((UiCellStatus t s) (UiKeyText s))
    ((UiCellIcon i s) (UiKeyText s))
    ((UiCellTinted i c s) (UiKeyText s))
    ((UiCellImage ts s) (UiKeyText s))))

; A row's key.
(def ui_row_key ((r UiRow)) (list int) (match r ((UiRow k cs) k)))

; A row with what it sorts by first, then its key, so that rows alike in
; the column keep one order.
(data UiSortRow (UiSortRow UiSortKey (list int) UiRow))

; The rows in the order the state says: as given, or sorted by the
; column, ascending or descending.
(def ui_grid_shown ((rows (list UiRow)) (s UiGridState)) (list UiRow)
  (match s
    ((UiGridState col desc sel first left)
      (if (lt col 0)
          rows
          (let sorted (ui_sort_unkeyed (sort (ui_sort_keyed rows col (nil UiSortRow))) (nil UiRow))
            (if desc (rev sorted) sorted))))))

; Each of rows with what it sorts by in column col, an empty text if it
; has no such cell, onto acc, reversed.
(def ui_sort_keyed ((rows (list UiRow)) (col int) (acc (list UiSortRow))) (list UiSortRow)
  (if (is_empty rows)
      acc
      (match (head rows)
        ((UiRow k cs)
          (ui_sort_keyed (tail rows) col (cons (UiSortRow (ui_cell_key (nth_or cs col (UiCellText ""))) k (head rows)) acc))))))

; The rows of rs, in their order, without what they were sorted by.
(def ui_sort_unkeyed ((rs (list UiSortRow)) (acc (list UiRow))) (list UiRow)
  (if (is_empty rs) (rev acc) (match (head rs) ((UiSortRow key k r) (ui_sort_unkeyed (tail rs) (cons r acc))))))

; -------------------------------------------------------------- actions

; The grid's state after action, one of its own or not.
(def ui_grid_action ((s UiGridState) (prefix (list int)) (action (list int))) UiGridState
  (let sort_p (append prefix ".sort.")
    (let sel_p (append prefix ".select.")
      (let to_p (append prefix ".scrollto.")
        (match s
          ((UiGridState col desc sel first left)
            (if (starts_with action sort_p)
                (let n (int_prefix (drop_n action (length sort_p)) 0)
                  (if (eq n col) (UiGridState col (not desc) sel first left) (UiGridState n false sel first left)))
                (if (starts_with action sel_p)
                    (UiGridState col desc (drop_n action (length sel_p)) first left)
                    (if (starts_with action to_p)
                        (UiGridState col desc sel (int_prefix (drop_n action (length to_p)) 0) left)
                        (ui_grid_across s prefix action))))))))))

; The grid's state after action, if it is NAME.acrossto.N, prefix its
; NAME: scrolled N pixels across; else s.
(def ui_grid_across ((s UiGridState) (prefix (list int)) (action (list int))) UiGridState
  (let p (append prefix ".acrossto.")
    (if (not (starts_with action p))
        s
        (match s
          ((UiGridState col desc sel first left)
            (UiGridState col desc sel first (int_prefix (drop_n action (length p)) 0)))))))

; Linux's codes for the keys that move the selection.
(def ui_key_up () int 103)
(def ui_key_down () int 108)
(def ui_key_page_up () int 104)
(def ui_key_page_down () int 109)
(def ui_key_home () int 102)
(def ui_key_end () int 107)

; The state after a key: the selection moved, among the rows as shown,
; a page at a time for Page Up and Page Down, a row fewer than show, and
; scrolled from where sc says the grid is just enough to show it. A key
; that does not move it leaves it. Before the grid is laid out, sc is
; ui_no_scroller, and a page is a row.
(def ui_grid_key ((g UiGridView) (code int) (sc UiScroller)) UiGridState
  (match g
    ((UiGridView prefix cols rows s)
      (let shown (ui_grid_shown rows s)
        (let n (length shown)
          (match sc
            ((UiScroller at most vis)
              (match s
                ((UiGridState col desc sel first left)
                  (let j (ui_moved (ui_index_of_key shown sel 0) n code (max 1 (sub vis 1)))
                    (if (if (lt j 0) true (eq n 0))
                        s
                        (UiGridState col desc (ui_row_key (nth_or shown j (UiRow "" (nil UiCell))))
                                     (if (gt vis 0) (ui_grid_first at j n vis) first) left))))))))))))

; Where the row whose key is k is among rows, counting from i; -1 if none
; is.
(def ui_index_of_key ((rows (list UiRow)) (k (list int)) (i int)) int
  (if (is_empty rows) -1 (if (eq (ui_row_key (head rows)) k) i (ui_index_of_key (tail rows) k (add i 1)))))

; Where the selection goes from i, -1 for none, among n: -1 if the key
; is not one that moves it.
(def ui_moved ((i int) (n int) (code int) (page int)) int
  (let last (sub n 1)
    (if (eq code (ui_key_down)) (if (lt i 0) 0 (min last (add i 1)))
    (if (eq code (ui_key_up)) (if (lt i 0) 0 (max 0 (sub i 1)))
    (if (eq code (ui_key_home)) 0
    (if (eq code (ui_key_end)) last
    (if (eq code (ui_key_page_down)) (min last (max 0 (add i page)))
    (if (eq code (ui_key_page_up)) (max 0 (sub i page))
    -1))))))))

; The first row shown, of n, visible at a time: as the state asks, moved
; so that the selected row, at sel, is in view, and never past the end.
(def ui_grid_first ((first int) (sel int) (n int) (visible int)) int
  (let f (if (lt sel 0) first (if (lt sel first) sel (if (ge sel (add first visible)) (add (sub sel visible) 1) first)))
    (max 0 (min f (max 0 (sub n visible))))))

; ----------------------------------------------------------------- pages

; A window that is a grid of processes, as GNOME's System Monitor is: a
; toolbar of Refresh, app.refresh, a line saying status, and End
; Process, app.end, sensitive while a row is selected; then a separator,
; and the grid view, filling the rest, keyed by itself (ui_keyed_self),
; so a hover over the toolbar lays the grid out no more.
(def ui_grid_page ((status (list int)) (view UiGridView)) UiWidget
  (match view
    ((UiGridView prefix cols rows gs)
      (UiBox (UiV) 0
        (cons (UiPad (ui_space_s) (ui_space_s)
                (UiBox (UiH) (ui_space_s)
                  (cons (UiButton "app.refresh" "view-refresh" "" (UiBtnFlat) true)
                  (cons (UiExpand (UiLabel status (UiDimmed) (UiCenter)))
                  (cons (UiButton "app.end" "" "End Process" (UiBtnDestructive) (not (is_empty (ui_gs_selected gs))))
                        (nil UiWidget))))))
        (cons (UiSeparator (UiH))
        (cons (UiExpand (ui_keyed_self (append "grid." prefix) (UiGrid view)))
              (nil UiWidget))))))))

; The page's line once gs has changed: which process is selected, if one
; is, or status.
(def ui_selected_line ((gs UiGridState) (status (list int))) (list int)
  (if (is_empty (ui_gs_selected gs)) status (append "Process " (append (ui_gs_selected gs) " selected"))))

; ---------------------------------------------------------------- sizes

; Each column's width across total: its own, or a share of what is left,
; at least 40.
(def ui_grid_widths ((cols (list UiColumn)) (total int)) (list int)
  (let fixed (ui_fixed_sum cols 0)
    (let n (ui_flex_count cols 0)
      (ui_widths_onto cols (max (mul 40 n) (sub total fixed)) n 0 (nil int)))))

; The columns' own widths added up, after acc; those that share count 0.
(def ui_fixed_sum ((cols (list UiColumn)) (acc int)) int
  (if (is_empty cols) acc (match (head cols) ((UiColumn t w a s) (ui_fixed_sum (tail cols) (add acc w))))))

; How many of cols share the room left over, after acc.
(def ui_flex_count ((cols (list UiColumn)) (acc int)) int
  (if (is_empty cols) acc (match (head cols) ((UiColumn t w a s) (ui_flex_count (tail cols) (if (eq w 0) (add acc 1) acc))))))

; ui_grid_widths's loop: each column's width onto acc, reversed, a
; sharing one its part of left among n by ui_share, seen being how many
; sharing ones came before it.
(def ui_widths_onto ((cols (list UiColumn)) (left int) (n int) (seen int) (acc (list int))) (list int)
  (if (is_empty cols)
      (rev acc)
      (match (head cols)
        ((UiColumn t w a s)
          (if (eq w 0)
              (ui_widths_onto (tail cols) left n (add seen 1) (cons (ui_share left n seen) acc))
              (ui_widths_onto (tail cols) left n seen (cons w acc)))))))

; A grid's natural size: 40 across for each column, the least a sharing
; one is given, not their own widths, since it scrolls across what does
; not fit, as GTK's scrolled window asks no more than its least across
; for its child; its header and four rows, down.
(def ui_grid_measure ((g UiGridView)) UiSize
  (match g
    ((UiGridView prefix cols rows s)
      (UiSize (mul 40 (length cols))
              (add (ui_grid_header_h) (mul (ui_row_h) 4))))))

; How many rows fit in a grid h tall, whole ones only.
(def ui_grid_visible ((h int)) int (max 0 (div (sub h (ui_grid_header_h)) (ui_row_h))))

; --------------------------------------------------------------- layout

; The grid in r: its ground, the area the wheel across scrolls if its
; columns are wider than it, its header, the area the wheel scrolls, the
; rows that fit from the first the state asks for, scrolled across as far
; as it asks, and the scrollbars down and across if not all fit.
(def ui_grid_lay ((g UiGridView) (r Rect) (st UiState) (acc (list UiNode))) (list UiNode)
  (match g
    ((UiGridView prefix cols rows s)
      (let style (ui_st_style st)
        (let gbg (ui_view_bg style)
          (let ws (ui_grid_widths cols (rect_w r))
            (let shown (ui_grid_shown rows s)
              (let n (length shown)
                (let vis (ui_grid_visible (rect_h r))
                  (match s
                    ((UiGridState col desc sel first left)
                      (let f (ui_grid_first first -1 n vis)
                        (let cw (ui_ints_sum ws 0)
                          (let most (max 0 (sub cw (rect_w r)))
                            (let l (ui_clamp left 0 most)
                              (let a0 (ui_across_area prefix r l most (ui_leaf r (cons (UiPFill r gbg) (nil UiPaint)) acc))
                                (let a1 (ui_header_cells prefix cols ws col desc (sub (rect_x r) l) (rect_y r) 0 st gbg r a0)
                                  (let a2 (ui_leaf r (cons (UiPFill (Rect (rect_x r) (sub (add (rect_y r) (ui_grid_header_h)) 1) (rect_w r) 1)
                                                                    (ui_border style gbg)) (nil UiPaint)) a1)
                                    (let a3 (ui_grid_rows prefix cols ws (drop shown f) sel r (sub (rect_x r) l)
                                                          (add (rect_y r) (ui_grid_header_h)) vis st gbg (ui_scroll_area prefix r n vis f a2))
                                      (ui_acrossbar prefix r cw l most (if (gt n vis) (ui_scrollbar_hit_w) 0) st gbg
                                                    (ui_scrollbar prefix r n vis f st gbg a3)))))))))))))))))))))

; The numbers of ns added up, after acc.
(def ui_ints_sum ((ns (list int)) (acc int)) int
  (if (is_empty ns) acc (ui_ints_sum (tail ns) (add acc (head ns)))))

; The node of all of r that the wheel across scrolls, beneath the rest,
; when its columns are wider than it, most pixels of them, left of which
; are scrolled off; none if they are not.
(def ui_across_area ((prefix (list int)) (r Rect) (left int) (most int) (acc (list UiNode))) (list UiNode)
  (if (le most 0) acc (cons (UiNode r (nil UiPaint) (ui_across_action prefix left most) false) acc)))

; The overlay scrollbar across, when columns cw wide are wider than r: a
; strip along the bottom of r, short of the scrollbar down by inset, on
; top of the rows, that takes the pointer, and in it the slider, as long
; as the share of the columns shown and as far across as left is of the
; most it can be. It is thicker and darker while the pointer is over the
; strip or drags it.
(def ui_acrossbar ((prefix (list int)) (r Rect) (cw int) (left int) (most int) (inset int) (st UiState) (gbg int) (acc (list UiNode))) (list UiNode)
  (if (if (le most 0) true (le cw 0))
      acc
      (let track (max 0 (sub (rect_w r) inset))
        (let sl (min track (max (ui_slider_min) (div (mul track (rect_w r)) cw)))
          (let span (sub track sl)
            (let bottom (rect_y1 r)
              (let active (ui_acrossbar_active prefix st)
                (let sw (if active (ui_slider_wide) (ui_slider_w))
                  (let sr (Rect (add (ui_slider_top (rect_x r) left most span) 2) (sub bottom (add (ui_slider_margin) sw)) (sub sl 4) sw)
                    (cons (UiNode (Rect (rect_x r) (sub bottom (ui_scrollbar_hit_w)) track (ui_scrollbar_hit_w))
                                  (cons (UiPRound sr (div sw 2) (ui_slider_fg (ui_st_style st) gbg active) -1) (nil UiPaint))
                                  (ui_acrossbar_action prefix left most span sl) false)
                          acc))))))))))

; Whether the pointer is over the grid's scrollbar across, or drags its
; slider.
(def ui_acrossbar_active ((prefix (list int)) (st UiState)) bool
  (let p (append prefix ".acrossbar.")
    (if (starts_with (ui_st_hover st) p) true (starts_with (ui_st_pressed st) p))))

; ops cut to the columns from x0 up to x1, as a grid scrolled across
; shows them: a fill to its part between them; a text to its whole
; characters between them, as it would be drawn, from its first that
; starts at or after x0 to its last that ends by x1; and an icon, image
; or rounded rectangle only if all of it is between them.
(def ui_cut_across ((ops (list UiPaint)) (x0 int) (x1 int)) (list UiPaint)
  (rev (ui_cut_across_onto ops x0 x1 (nil UiPaint))))

; ui_cut_across's loop: each op cut, if any of it is left, onto acc,
; reversed.
(def ui_cut_across_onto ((ops (list UiPaint)) (x0 int) (x1 int) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty ops)
      acc
      (ui_cut_across_onto (tail ops) x0 x1
        (match (head ops)
          ((UiPFill r c)
            (let k (rect_clip r (Rect x0 (rect_y r) (sub x1 x0) (rect_h r)))
              (if (rect_empty k) acc (cons (UiPFill k c) acc))))
          ((UiPRound r rad c u) (if (ui_within_across (rect_x r) (rect_x1 r) x0 x1) (cons (head ops) acc) acc))
          ((UiPText r t a c f b sc) (ui_text_cut_onto r t a c f b sc x0 x1 acc))
          ((UiPIcon x y nm c sc) (if (ui_within_across x (add x (mul (ui_icon_size) sc)) x0 x1) (cons (head ops) acc) acc))
          ((UiPImage x y nn d ts) (if (ui_within_across x (add x nn) x0 x1) (cons (head ops) acc) acc))))))

; Whether a to b lies between x0 and x1.
(def ui_within_across ((a int) (b int) (x0 int) (x1 int)) bool
  (if (ge a x0) (le b x1) false))

; A text op, rect r, text t aligned a, in color c, face f, bold b, at
; scale sc, cut to whole characters between x0 and x1 onto acc: as it
; would be drawn, cut short with "..." if r is too narrow; then, if any
; of it is outside, the characters from the first whose pen is at or
; after x0 to the last that ends by x1, from that first's pen, aligned to
; their start in a rect just as wide; nothing if none is. The face's
; advances are walked once, so a long line costs its length.
(def ui_text_cut_onto ((r Rect) (t (list int)) (a UiAlign) (c int) (f UiFont) (b bool) (sc int)
                       (x0 int) (x1 int) (acc (list UiPaint))) (list UiPaint)
  (let shown (ui_ellipsized t (rect_w r) f b sc)
    (let tw (ui_text_w shown f b sc)
      (let tx (ui_aligned (rect_x r) (rect_w r) tw a)
        (if (ui_within_across tx (add tx tw) x0 x1)
            (cons (UiPText r t a c f b sc) acc)
            (let m (ui_font_metric f b)
              (let upm (ui_font_upm f b)
                (let h (ui_font_line f sc)
                  (match (ui_cut_start shown m upm h tx x0 0)
                    ((UiCutStart nx from)
                      (let rest (ui_cut_end from m upm h (sub x1 nx) 0 (nil int))
                        (if (is_empty rest)
                            acc
                            (cons (UiPText (Rect nx (rect_y r) (ui_text_w rest f b sc) (rect_h r)) rest (UiStart) c f b sc) acc)))))))))))))

; Where a text cut at its start begins: the pen of its first character
; left, and the characters from it.
(data UiCutStart (UiCutStart int (list int)))

; The first of s, the rest of a text drawn from pen tx whose characters
; before it moved the pen u units of face m (upm a em, lines h high),
; whose pen is at or after x0, and the characters from it; none if no
; character's is.
(def ui_cut_start ((s (list int)) (m int) (upm int) (h int) (tx int) (x0 int) (u int)) UiCutStart
  (if (is_empty s)
      (UiCutStart tx (nil int))
      (let pen (add tx (ui_pen_px u upm h))
        (if (ge pen x0)
            (UiCutStart pen s)
            (ui_cut_start (tail s) m upm h tx x0 (add u (ui_char_units_m s m)))))))

; As many of s from its start as are no wider than room, as ui_text_w
; measures them, u the units of those taken, acc them reversed.
(def ui_cut_end ((s (list int)) (m int) (upm int) (h int) (room int) (u int) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (gt (ui_units_px (add u (ui_metric_adv m (head s))) upm h) room)
          (rev acc)
          (ui_cut_end (tail s) m upm h room (add u (ui_char_units_m s m)) (cons (head s) acc)))))

; The node of the area under the header that the wheel scrolls, beneath
; the rows, so that they still take presses; none if no row fits.
(def ui_scroll_area ((prefix (list int)) (r Rect) (n int) (vis int) (first int) (acc (list UiNode))) (list UiNode)
  (if (le vis 0)
      acc
      (cons (UiNode (Rect (rect_x r) (add (rect_y r) (ui_grid_header_h)) (rect_w r) (sub (rect_h r) (ui_grid_header_h)))
                    (nil UiPaint) (ui_scroll_area_action prefix first (max 0 (sub n vis)) vis (ui_row_h)) false)
            acc)))

; The header's cells from x: each title, bold and dimmed, a sorted
; column's with its arrow at its end, and a line between each and the
; next, each cut to the grid's own r across; one wholly outside it is
; left out. A sortable one is a target, and shows the pointer over it.
(def ui_header_cells ((prefix (list int)) (cols (list UiColumn)) (ws (list int)) (col int) (desc bool)
                      (x int) (y int) (i int) (st UiState) (gbg int) (r Rect) (acc (list UiNode))) (list UiNode)
  (if (if (is_empty cols) true (is_empty ws))
      acc
      (match (head cols)
        ((UiColumn title w align sortable)
          (let cw (head ws)
            (let action (if sortable (append prefix (append ".sort." (digits i))) "")
              (let hover (if sortable (eq (ui_st_hover st) action) false)
                (let bg (if hover (ui_hover_bg (ui_st_style st) gbg) gbg)
                  (let cr (Rect x y cw (sub (ui_grid_header_h) 1))
                    (let kr (rect_clip cr r)
                      (let ops (ui_cut_across (ui_header_ops cr title align (eq col i) desc (is_empty (tail cols)) st gbg bg) (rect_x r) (rect_x1 r))
                        (ui_header_cells prefix (tail cols) (tail ws) col desc (add x cw) y (add i 1) st gbg r
                                         (if (rect_empty kr) acc (cons (UiNode kr ops action false) acc))))))))))))))

; One title's ops in cr: its ground bg, the title bold and dimmed within
; the pads, the arrow up or down at its end if it is the sorted column,
; and, unless it is the last, a line at its right edge, 8 short of each
; end.
(def ui_header_ops ((cr Rect) (title (list int)) (align UiAlign) (sorted bool) (desc bool) (last bool)
                    (st UiState) (gbg int) (bg int)) (list UiPaint)
  (let dim (ui_dim_fg (ui_st_style st) bg)
    (let room (sub (rect_w cr) (add (mul 2 (ui_cell_pad)) (if sorted (add (ui_icon_size) 4) 0)))
      (let tr (Rect (add (rect_x cr) (ui_cell_pad)) (rect_y cr) (max 0 room) (rect_h cr))
        (let ops (cons (UiPFill cr bg) (cons (UiPText tr title align dim (ui_text_font) true 1) (nil UiPaint)))
          (let ops2 (if sorted
                        (append ops (cons (UiPIcon (sub (add (rect_x cr) (rect_w cr)) (add (ui_cell_pad) (ui_icon_size)))
                                                   (ui_aligned (rect_y cr) (rect_h cr) (ui_icon_size) (UiCenter))
                                                   (if desc "pan-down" "pan-up") dim 1) (nil UiPaint)))
                        ops)
            (if last
                ops2
                (append ops2 (cons (UiPFill (Rect (sub (add (rect_x cr) (rect_w cr)) 1) (add (rect_y cr) 8) 1 (sub (rect_h cr) 16))
                                            (ui_border (ui_st_style st) gbg)) (nil UiPaint))))))))))

; The rows that fit, from y, across all of the grid's r: each a target
; selecting it, its ground the selection's tint or the pointer's, then
; its cells from cx, cut to r across.
(def ui_grid_rows ((prefix (list int)) (cols (list UiColumn)) (ws (list int)) (rows (list UiRow)) (sel (list int))
                   (r Rect) (cx int) (y int) (left int) (st UiState) (gbg int) (acc (list UiNode))) (list UiNode)
  (if (if (le left 0) true (is_empty rows))
      acc
      (match (head rows)
        ((UiRow k cells)
          (let action (append prefix (append ".select." k))
            (let bg (if (eq k sel) (ui_selected_bg gbg) (if (eq (ui_st_hover st) action) (ui_hover_bg (ui_st_style st) gbg) gbg))
              (let rr (Rect (rect_x r) y (rect_w r) (ui_row_h))
                (let cells_ops (ui_cut_across (ui_cells_ops cols ws cells cx y st bg (nil UiPaint)) (rect_x r) (rect_x1 r))
                  (let node (UiNode rr (cons (UiPFill rr bg) cells_ops) action false)
                    (ui_grid_rows prefix cols ws (tail rows) sel r cx (add y (ui_row_h)) (sub left 1) st gbg (cons node acc)))))))))))

; One row's cells from x, y, each in its column's width less its pads,
; aligned as its column says, after acc.
(def ui_cells_ops ((cols (list UiColumn)) (ws (list int)) (cells (list UiCell)) (x int) (y int) (st UiState) (bg int) (acc (list UiPaint))) (list UiPaint)
  (if (if (is_empty cols) true (if (is_empty ws) true (is_empty cells)))
      acc
      (match (head cols)
        ((UiColumn title w align sortable)
          (let cr (Rect (add x (ui_cell_pad)) y (max 0 (sub (head ws) (mul 2 (ui_cell_pad)))) (ui_row_h))
            (ui_cells_ops (tail cols) (tail ws) (tail cells) (add x (head ws)) y st bg
                          (append acc (ui_cell_ops (head cells) cr align st bg))))))))

; One cell's ops in cr.
(def ui_cell_ops ((c UiCell) (cr Rect) (align UiAlign) (st UiState) (bg int)) (list UiPaint)
  (let fg (ui_fg (ui_st_style st))
    (match c
      ((UiCellText s) (cons (UiPText cr s align fg (ui_text_font) false 1) (nil UiPaint)))
      ((UiCellNum n suffix) (cons (UiPText cr (append (digits n) suffix) align fg (ui_text_font) false 1) (nil UiPaint)))
      ((UiCellSize n) (cons (UiPText cr (format_size n) align fg (ui_text_font) false 1) (nil UiPaint)))
      ((UiCellLevel p) (ui_level_ops cr p st bg))
      ((UiCellStatus tone s) (ui_status_ops cr tone s st bg))
      ((UiCellIcon icon s) (ui_icon_cell_ops cr icon fg s fg))
      ((UiCellTinted icon c s) (ui_icon_cell_ops cr icon c s fg))
      ((UiCellImage ts s)
        (ui_beside_icon_ops cr (UiPImage (rect_x cr) (ui_aligned (rect_y cr) (rect_h cr) (ui_icon_size) (UiCenter)) (ui_icon_size) false ts) s fg)))))

; An icon in ic and text beside it in fg, in cr: the icon at the start,
; in the middle up and down, and the text 6 after it.
(def ui_icon_cell_ops ((cr Rect) (icon (list int)) (ic int) (s (list int)) (fg int)) (list UiPaint)
  (ui_beside_icon_ops cr (UiPIcon (rect_x cr) (ui_aligned (rect_y cr) (rect_h cr) (ui_icon_size) (UiCenter)) icon ic 1) s fg))

; An icon's op, as ui_icon_cell_ops places it, and text after it.
(def ui_beside_icon_ops ((cr Rect) (icon UiPaint) (s (list int)) (fg int)) (list UiPaint)
  (cons icon
        (cons (UiPText (Rect (add (rect_x cr) (add (ui_icon_size) (ui_space_s))) (rect_y cr)
                             (max 0 (sub (rect_w cr) (add (ui_icon_size) (ui_space_s)))) (rect_h cr)) s (UiStart) fg (ui_text_font) false 1)
              (nil UiPaint))))

; The overlay scrollbar, when n rows are more than the vis that fit: a
; strip along the right of the rows, on top of them, that takes the
; pointer, and in it the slider, as long as the share of the rows shown
; and as far down as first is of the most it can be. It is wider and
; darker while the pointer is over the strip or drags it.
(def ui_scrollbar ((prefix (list int)) (r Rect) (n int) (vis int) (first int) (st UiState) (gbg int) (acc (list UiNode))) (list UiNode)
  (ui_scrollbar_on prefix (rect_x r) (rect_w r) (add (rect_y r) (ui_grid_header_h)) (ui_row_h) n vis first st gbg acc))

; The same, for any scroller: its rows step high from top, in a strip
; along the right of x to x + w; the icon view's too.
(def ui_scrollbar_on ((prefix (list int)) (x int) (w int) (top int) (step int) (n int) (vis int) (first int) (st UiState) (gbg int) (acc (list UiNode))) (list UiNode)
  (if (if (le n vis) true (le vis 0))
      acc
      (let r (Rect x top w 0)
        (let track (mul vis step)
          (let sh (max (ui_slider_min) (div (mul track vis) n))
            (let most (sub n vis)
              (let span (sub track sh)
                (let right (add (rect_x r) (rect_w r))
                  (let active (ui_scrollbar_active prefix st)
                    (let sw (if active (ui_slider_wide) (ui_slider_w))
                      (let sr (Rect (sub right (add (ui_slider_margin) sw)) (add (ui_slider_top top first most span) 2) sw (sub sh 4))
                        (cons (UiNode (Rect (sub right (ui_scrollbar_hit_w)) top (ui_scrollbar_hit_w) track)
                                      (cons (UiPRound sr (div sw 2) (ui_slider_fg (ui_st_style st) gbg active) -1) (nil UiPaint))
                                      (ui_scrollbar_action prefix first most span sh) false)
                              acc))))))))))))

; Whether the pointer is over the grid's scrollbar, or drags its slider.
(def ui_scrollbar_active ((prefix (list int)) (st UiState)) bool
  (let p (append prefix ".scrollbar.")
    (if (starts_with (ui_st_hover st) p) true (starts_with (ui_st_pressed st) p))))
