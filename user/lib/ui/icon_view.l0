; icon_view.l0 -- an icon view, as GTK's GtkGridView shows Nautilus'
; files in a grid: a tile for each item, its icon large and its name
; under it, as many tiles across as fit and as many rows as there are, on
; a view's ground. A tile is selected by pressing it, and with the arrow
; keys, Home, End, Page Up and Page Down, which scroll it into view;
; when there are more rows than fit, the wheel scrolls them and an
; overlay scrollbar, the grid's, says where those shown are.
;
; Its actions are named from a prefix the program gives, as the grid's
; are: PREFIX.select.KEY for the tile whose key is KEY, and from
; window.l0 PREFIX.scrollto.N for row N of tiles to be the first shown.
; Its area is a scroller's, PREFIX.scroll, its rows a tile high; a press
; on it, between the tiles, selects nothing. ui_icon_action makes the
; view's next state from any of them. Its UiWidget constructor is
; widget.l0's UiIconView.

; A tile: its key, which names it in actions and the selection, its
; icon, its name, and its icon's tone: UiAccentTone in the accent, as
; Adwaita's folders are blue, anything else in the text's color dimmed.
(data UiTile (UiTile (list int) (list int) (list int) UiTone))

; The selected tile's key, "" for none, and the first row of tiles shown.
(data UiIconState (UiIconState (list int) int))

; A view at first: nothing selected, from the first row.
(def ui_icon_state_new () UiIconState (UiIconState "" 0))

; The selected tile's key.
(def ui_is_selected ((s UiIconState)) (list int) (match s ((UiIconState k f) k)))

; An icon view to show: its actions' prefix, its tiles in order, and its
; state.
(data UiIconData (UiIconData (list int) (list UiTile) UiIconState))

; A tile's key.
(def ui_tile_key ((t UiTile)) (list int) (match t ((UiTile k i l tone) k)))

; ---------------------------------------------------------------- sizes

; How many tiles go across a view w wide: as many as fit 12 in from its
; sides, at least one.
(def ui_icon_cols ((w int)) int (max 1 (div (sub w (mul 2 (ui_space_m))) (ui_tile_w))))

; How many rows of tiles show in a view h high, 12 under its top: whole
; ones only.
(def ui_icon_visible ((h int)) int (max 0 (div (sub h (ui_space_m)) (ui_tile_h))))

; How many rows n tiles take, cols across.
(def ui_icon_row_count ((n int) (cols int)) int (ceil_div n (max 1 cols)))

; An icon view's natural size: a tile, and its margins.
(def ui_icon_size_of ((d UiIconData)) UiSize
  (UiSize (add (ui_tile_w) (mul 2 (ui_space_m))) (add (ui_tile_h) (ui_space_m))))

; Where the row of tiles that shows the first is: as the state asks, so
; that the tile at sel, if it is not -1, is in view, cols across, vis
; rows shown of rows; and never past the end.
(def ui_icon_first ((first int) (sel int) (cols int) (rows int) (vis int)) int
  (let row (if (lt sel 0) -1 (div sel (max 1 cols)))
    (let f (if (lt row 0) first (if (lt row first) row (if (ge row (add first vis)) (add (sub row vis) 1) first)))
      (max 0 (min f (max 0 (sub rows vis)))))))

; --------------------------------------------------------------- actions

; The view's state after action, one of its own or not: a tile selected;
; a press between the tiles, on its area, selecting nothing, as
; Nautilus' does; or scrolled.
(def ui_icon_action ((s UiIconState) (prefix (list int)) (action (list int))) UiIconState
  (let sel_p (append prefix ".select.")
    (let to_p (append prefix ".scrollto.")
      (match s
        ((UiIconState sel first)
          (if (starts_with action sel_p)
              (UiIconState (drop_n action (length sel_p)) first)
              (if (starts_with action to_p)
                  (UiIconState sel (int_prefix (drop_n action (length to_p)) 0))
                  (match (ui_scroll_of action)
                    ((UiScrollArea name f m sh st) (if (eq name prefix) (UiIconState "" first) s))
                    ((UiScrollBar name f m sp sl) s)
                    ((UiNoScroll) s)))))))))

; Where a tile's key is among tiles, counting from i; -1 if none is.
(def ui_tile_index ((tiles (list UiTile)) (k (list int)) (i int)) int
  (if (is_empty tiles) -1 (if (eq (ui_tile_key (head tiles)) k) i (ui_tile_index (tail tiles) k (add i 1)))))

; The state after a key: the selection moved along the tiles, cols
; across, by one for Left and Right, a row for Up and Down, a page of
; rows less one for Page Up and Page Down, to the ends for Home and End,
; and scrolled from where sc says the view is just enough to show it. A
; key that does not move it leaves it; with nothing selected, any of them
; selects the first.
(def ui_icon_key ((d UiIconData) (code int) (sc UiScroller) (cols int)) UiIconState
  (match d
    ((UiIconData prefix tiles s)
      (match s
        ((UiIconState sel first)
          (match sc
            ((UiScroller at most vis)
              (let n (length tiles)
                (let i (ui_tile_index tiles sel 0)
                  (let j (ui_icon_moved i n code cols (mul cols (max 1 (sub vis 1))))
                    (if (if (lt j 0) true (eq n 0))
                        s
                        (UiIconState (ui_tile_key (nth tiles j))
                                     (if (gt vis 0) (ui_icon_first at j cols (ui_icon_row_count n cols) vis) first)))))))))))))

; Where the selection goes from i, -1 for none, among n, cols across: -1
; if code is not a key that moves it.
(def ui_icon_moved ((i int) (n int) (code int) (cols int) (page int)) int
  (let last (sub n 1)
    (if (lt i 0)
        (if (any_eq code (ui_icon_keys)) 0 -1)
        (if (eq code (ui_key_right)) (min last (add i 1))
        (if (eq code (ui_key_left)) (max 0 (sub i 1))
        (if (eq code (ui_key_down)) (if (lt (add i cols) n) (add i cols) i)
        (if (eq code (ui_key_up)) (if (ge i cols) (sub i cols) i)
        (ui_moved i n code page))))))))

; The keys that move an icon view's selection.
(def ui_icon_keys () (list int)
  (cons (ui_key_left) (cons (ui_key_right) (cons (ui_key_up) (cons (ui_key_down)
    (cons (ui_key_home) (cons (ui_key_end) (cons (ui_key_page_up) (cons (ui_key_page_down) (nil int))))))))))

; --------------------------------------------------------------- layout

; The view in r: its ground; its area under the margin above, which the
; wheel scrolls, a tile high a row; the tiles of the rows that fit from
; the first the state asks for, in the middle across; and the scrollbar
; if not all rows fit.
(def ui_icon_lay ((d UiIconData) (r Rect) (st UiState) (acc (list UiNode))) (list UiNode)
  (match d
    ((UiIconData prefix tiles s)
      (match s
        ((UiIconState sel first)
          (let gbg (ui_view_bg (ui_st_style st))
            (let cols (ui_icon_cols (rect_w r))
              (let rows (ui_icon_row_count (length tiles) cols)
                (let vis (ui_icon_visible (rect_h r))
                  (let f (ui_icon_first first -1 cols rows vis)
                    (let top (add (rect_y r) (ui_space_m))
                      (let x0 (ui_aligned (rect_x r) (rect_w r) (mul cols (ui_tile_w)) (UiCenter))
                        (let a0 (ui_leaf r (cons (UiPFill r gbg) (nil UiPaint)) acc)
                          (let a1 (if (le vis 0)
                                      a0
                                      (cons (UiNode (Rect (rect_x r) top (rect_w r) (mul vis (ui_tile_h))) (nil UiPaint)
                                                    (ui_scroll_area_action prefix f (max 0 (sub rows vis)) vis (ui_tile_h)) false)
                                            a0))
                            (let a2 (ui_tiles_lay prefix (drop tiles (mul f cols)) sel x0 top cols 0 (mul vis cols) st gbg a1)
                              (ui_scrollbar_on prefix (rect_x r) (rect_w r) top (ui_tile_h) rows vis f st gbg a2))))))))))))))))

; The tiles from the i-th shown on, of left more that fit, cols across
; from x, y, onto acc.
(def ui_tiles_lay ((prefix (list int)) (tiles (list UiTile)) (sel (list int)) (x int) (y int) (cols int) (i int) (left int)
                   (st UiState) (gbg int) (acc (list UiNode))) (list UiNode)
  (if (if (le left 0) true (is_empty tiles))
      acc
      (let tr (Rect (add x (mul (mod i cols) (ui_tile_w))) (add y (mul (div i cols) (ui_tile_h))) (ui_tile_w) (ui_tile_h))
        (ui_tiles_lay prefix (tail tiles) sel x y cols (add i 1) (sub left 1) st gbg
                      (cons (ui_tile_node prefix (head tiles) sel tr st gbg) acc)))))

; A tile's node in tr: a target selecting it; rounded in the selection's
; tint if it is selected, or the pointer's if it is over it; its icon 48
; square in the middle 12 from its top, and its name under it, cut short
; to the tile less 6 either side.
(def ui_tile_node ((prefix (list int)) (t UiTile) (sel (list int)) (tr Rect) (st UiState) (gbg int)) UiNode
  (match t
    ((UiTile key icon label tone)
      (let action (ui_select_action prefix key)
        (let s (ui_st_style st)
          (let bg (if (eq key sel) (ui_selected_bg gbg) (if (eq (ui_st_hover st) action) (ui_hover_bg s gbg) gbg))
            (let iy (add (rect_y tr) (ui_space_m))
              (let ix (ui_aligned (rect_x tr) (rect_w tr) (ui_tile_icon) (UiCenter))
                (let ly (add iy (add (ui_tile_icon) (ui_space_s)))
                  (let ink (match tone ((UiAccentTone) (ui_accent_bg)) ((UiNeutral) (ui_dim_fg s bg)) ((UiGood) (ui_dim_fg s bg)) ((UiWarn) (ui_dim_fg s bg)) ((UiBad) (ui_dim_fg s bg)))
                    (let text (UiPText (Rect (add (rect_x tr) (ui_space_s)) ly (max 0 (sub (rect_w tr) (mul 2 (ui_space_s)))) (ui_char_h)) label (UiCenter) (ui_fg s) false 1)
                      (let icon_op (UiPIcon ix iy icon ink (div (ui_tile_icon) (ui_icon_size)))
                        (UiNode tr (if (eq bg gbg)
                                       (cons icon_op (cons text (nil UiPaint)))
                                       (cons (UiPRound tr (ui_tile_radius) bg gbg) (cons icon_op (cons text (nil UiPaint)))))
                                action true)))))))))))))
