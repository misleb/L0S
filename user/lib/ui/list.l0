; list.l0 -- a boxed list, libadwaita's .boxed-list of AdwActionRows: a
; card of rows 50 high, a line between each two, each row an icon or
; none, a widget at its start (a check box, as a list of things to do
; has), its title over a dimmed subtitle, and a widget at its end (a
; switch, a button); a row the program says is actionable sets off
; PREFIX.select.KEY when clicked, read back with panes.l0's
; ui_select_key, and is tinted under the pointer. The widgets at a row's
; start and end set off their own actions over it. A scroller by rows,
; with the grid's overlay scrollbar, so a list longer than its room
; scrolls by the wheel and its slider with no help from the program but
; keeping its first row, ui_list_first. Its UiWidget constructor is
; widget.l0's UiList.

; A row: its key, its icon or "", the widget at its start, its title,
; its subtitle or "", the widget at its end, UiSpace 0 0 for none, and
; whether a click on it sets off PREFIX.select.KEY.
(data UiListRow
  (UiListRow (key (list int)) (icon (list int)) (start UiWidget) (title (list int)) (subtitle (list int)) (end UiWidget) (actionable bool)))

; A list: the prefix of its actions, its rows, and the first shown, as
; the program keeps it.
(data UiListData (UiListData (prefix (list int)) (rows (list UiListRow)) (first int)))

; A row of a title and a subtitle, nothing at its start or end, set off
; when clicked; the rest is given with its fields, as (.end row
; (UiSwitch "wifi" on)).
(def ui_list_row ((key (list int)) (title (list int)) (subtitle (list int))) UiListRow
  (UiListRow key "" (UiSpace 0 0) title subtitle (UiSpace 0 0) true))

; The first row the program keeps after action, from first, for the
; list called prefix: N for its PREFIX.scrollto.N, else as it was.
(def ui_list_first ((first int) (prefix (list int)) (action (list int))) int
  (let p (append prefix ".scrollto.")
    (if (starts_with action p) (int_prefix (drop_n action (length p)) 0) first)))

; A list's natural size: 320 wide, and as high as its rows, at most
; five; in a UiExpand it takes the room there is, and scrolls the rest.
(def ui_list_size_of ((d UiListData)) UiSize
  (UiSize (ui_list_min_w) (mul (min 5 (length (.rows d))) (ui_list_row_h))))

; The list in r: its card, as high as the rows that show, the area the
; wheel scrolls, a row a step, the rows that fit from the first shown,
; and the scrollbar if not all fit. No rows, no card.
(def ui_list_lay ((d UiListData) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (let (rh (ui_list_row_h)
        rows (.rows d)
        n (length rows)
        vis (div (.h r) rh)
        f (max 0 (min (.first d) (sub n vis)))
        shown (min n vis)
        card (Rect (.x r) (.y r) (.w r) (mul shown rh))
        cbg (ui_card_bg (.style st))
        prefix (.prefix d))
    (if (or (eq n 0) (le vis 0))
        acc
        (let (a0 (ui_leaf card (cons (UiPRound card (ui_window_radius) cbg bg) (nil UiPaint)) acc)
              a1 (cons (UiNode card (nil UiPaint) (ui_scroll_area_action prefix f (max 0 (sub n vis)) vis rh) false) a0)
              a2 (ui_list_rows_lay prefix (take (drop rows f) vis) (.x r) (.w r) (.y r) true st cbg a1))
          (ui_scrollbar_on prefix (.x r) (.w r) (.y r) rh n vis f st cbg a2)))))

; Each of rows laid out from y down, the first of them first, onto acc.
(def ui_list_rows_lay ((prefix (list int)) (rows (list UiListRow)) (x int) (w int) (y int) (first bool) (st UiState) (cbg int) (acc (list UiNode))) (list UiNode)
  (if (is_empty rows)
      acc
      (ui_list_rows_lay prefix (tail rows) x w (add y (ui_list_row_h)) false st cbg
                        (ui_list_row_lay prefix (head rows) (Rect x y w (ui_list_row_h)) first st cbg acc))))

; A row in rr, onto acc: its node, the line above it unless it is the
; first shown, the tint under the pointer if it is actionable, its icon,
; title and subtitle; then the widgets at its start and end, over it, so
; that a press on one is theirs.
(def ui_list_row_lay ((prefix (list int)) (row UiListRow) (rr Rect) (first bool) (st UiState) (cbg int) (acc (list UiNode))) (list UiNode)
  (let (s (.style st)
        a (if (.actionable row) (ui_select_action prefix (.key row)) "")
        hover (and (not (is_empty a)) (eq (.hover st) a))
        pad (ui_space_m)
        x0 (add (.x rr) pad)
        ix (if (is_empty (.icon row)) x0 (add x0 (add (ui_icon_size) pad)))
        sw (.sw (ui_measure (.start row)))
        tx (if (eq sw 0) ix (add ix (add sw pad)))
        ew (.sw (ui_measure (.end row)))
        ex (sub (add (.x rr) (.w rr)) (add pad ew))
        tw (max 0 (sub (if (eq ew 0) (sub (add (.x rr) (.w rr)) pad) (sub ex pad)) tx))
        two (not (is_empty (.subtitle row)))
        ty (add (.y rr) (div (sub (ui_list_row_h) (if two (add (mul 2 (ui_char_h)) 2) (ui_char_h))) 2))
        line (if first (nil UiPaint) (cons (UiPFill (Rect (.x rr) (.y rr) (.w rr) 1) (ui_border s cbg)) (nil UiPaint)))
        tint (if hover (cons (UiPRound (rect_inset rr 3) (ui_tile_radius) (ui_hover_bg s cbg) cbg) (nil UiPaint)) (nil UiPaint))
        rbg (if hover (ui_hover_bg s cbg) cbg)
        icon (if (is_empty (.icon row)) (nil UiPaint)
                 (cons (UiPIcon x0 (add (.y rr) (div (sub (ui_list_row_h) (ui_icon_size)) 2)) (.icon row) (ui_fg s) 1) (nil UiPaint)))
        texts (cons (UiPText (Rect tx ty tw (ui_char_h)) (.title row) (UiStart) (ui_fg s) (ui_text_font) false 1)
                    (if two
                        (cons (UiPText (Rect tx (add ty (add (ui_char_h) 2)) tw (ui_char_h)) (.subtitle row) (UiStart) (ui_dim_fg s rbg) (ui_text_font) false 1)
                              (nil UiPaint))
                        (nil UiPaint)))
        a0 (cons (UiNode rr (append line (append tint (append icon texts))) a (not (is_empty a))) acc)
        a1 (if (eq sw 0) a0 (ui_lay (.start row) (Rect ix (.y rr) sw (ui_list_row_h)) st rbg a0)))
    (if (eq ew 0) a1 (ui_lay (.end row) (Rect ex (.y rr) ew (ui_list_row_h)) st rbg a1))))
