; uiapp.l0 -- an app and its windows, any number of them, on one port,
; as a GApplication keeps its GtkWindows on one connection: the
; compositor, the port every window's events come to, the face they are
; painted with, shared so a strike is opened once for them all, and the
; windows by their ids. Linked with window.l0, whose UiWin each is.
;
; An app's loop, its own view and update in between:
;
;   (match (ui_app_start) ...)                         once
;   (ui_app_open app TITLE W H)                        a window, and more
;   (ui_app_next app)              -> (UiAppNext app1 (UiAppEvent ID EVENT))
;   (ui_app_route app ID EVENT)    -> (UiAppRouted app2 ACTION)
;   state = update state ID ACTION EVENT               the window's own
;   (ui_app_present app2 ID (view state ID))           paints what changed
;   (ui_app_close app ID)                              one closed
;
; ui_app_route and ui_app_present are ui_route and ui_present on window
; ID, put back into the app by its id. A window's win.close (window.l0)
; is the app's to answer with ui_app_close, ending once it has closed
; the last; a window it presents again with the close unanswered is
; closed by ui_app_present, and the app ended with its last.
;
; The loop's messages are taken in one place, "the loop" below:
; ui_app_next waits for the next and ui_app_event says what it is and of
; which window, through the app's loop (uiloop.l0), which puts together
; what waits before a step.
;
; The app's port is registered as its name, app.EXEC (appopen.l0), and a
; launch of it while it runs comes as an open, an event of no window,
; UiAppEvent -1 (UiOpen REPLY ARGS); ui_app_route sets off app.open for
; it and answers shown 0, so the app's front window comes forward. An app
; that opens something for it says so once, ui_app_opening, and answers
; each itself, ui_app_shown, with the window to bring forward.
;
; Every window takes a region of the 64 a process may have open (its
; buffer), and a resize one more for a moment; the face's strikes one
; each. ui_app_open refuses a window past what is left, keeping
; ui_app_reserve for the program's own.

; ------------------------------------------------------------------ model

; An app: the compositor, the port its windows' events come to, the face
; they are painted with, as the window presented last left it, its
; windows by id, and whether it answers an open itself (ui_app_opening),
; or the toolkit answers it shown 0 as it routes it.
(data UiApp (UiApp Compositor int UiFace (Map int UiWin) bool UiLoop))

; An app started, or why not.
(data UiAppStarted (UiAppStarted UiApp) (UiAppFailed (list int)))

; The app with a window opened, and its id; or the app as it was, and
; why not.
(data UiAppOpened (UiAppOpened UiApp int) (UiAppRefused UiApp (list int)))

; A message to the app's port: the id of the window it is of, -1 for
; none of the app's, and what it is to that window (window.l0's
; ui_event_of), or, for none, an exit or anything else.
(data UiAppEvent (UiAppEvent int UiEvent))

; The app after a window's event, and the action it set off, or "".
(data UiAppRouted (UiAppRouted UiApp (list int)))

; An app with no window yet: the compositor found, its face loaded at the
; desktop's scale, and a port made for its windows' events, registered
; as the app's name (ui_app_named); or why not, as there is no
; compositor, or no font to draw text with.
(def ui_app_start () UiAppStarted
  (match (compositor_open)
    ((NoCompositor why) (UiAppFailed why))
    ((Compositor cport rp pid s)
      (let face (ui_face_load s)
        (if (not (ui_face_has_text face))
            (UiAppFailed "no font")
            (let port (port_new)
              (let n (ui_app_named port)
                (let rport (port_new)
                  (let aport (port_new)
                    (UiAppStarted (UiApp (Compositor cport rp pid s) port face ((MapEmpty int UiWin)) false (ui_loop_ports rport aport))))))))))))

; port registered as the app's name, app.EXEC (appopen.l0), EXEC the
; file name of this process's program, so that a launch of the app finds
; it running and asks it to open (wm's launch) rather than starting it
; again. A second of the same program, started by run, finds the name
; taken, and goes without: 0 either way.
(def ui_app_named ((port int)) int
  (let path (proc_path (l0s_pid))
    (if (is_empty path) 0 (let r (name_register port (app_port_name path)) 0))))

; The app, answering each open itself, with ui_app_shown, once its
; action, app.open, is set off: as Files opens a window for one. An app
; that does not say so has every open answered shown 0 as it is routed,
; its front window brought forward and nothing more opened.
(def ui_app_opening ((a UiApp)) UiApp
  (match a ((UiApp c port f ws o lp) (UiApp c port f ws true lp))))

; The open ev answered: window id to bring forward, 0 for the app's front
; one; told, never waited on.
(def ui_app_shown ((a UiApp) (ev UiEvent) (id int)) UiApp
  (let t (ui_open_answer ev id) a))

; The port the app's windows' events come to, and the compositor.
(def ui_app_port ((a UiApp)) int (match a ((UiApp c port f ws o lp) port)))
(def ui_app_compositor ((a UiApp)) Compositor (match a ((UiApp c port f ws o lp) c)))

; The scale its windows are painted at, its face's: what a program loads
; its full-color icons at (face.l0's ui_images_load).
(def ui_app_scale ((a UiApp)) int (match a ((UiApp c port f ws o lp) (ui_face_scale f))))

; How many windows the app has open, and their ids, in order.
(def ui_app_count ((a UiApp)) int (match a ((UiApp c port f ws o lp) (map_size ws))))
(def ui_app_ids ((a UiApp)) (list int) (match a ((UiApp c port f ws o lp) (sort (map_keys ws)))))

; Window id of the app, if it is open.
(def ui_app_win ((a UiApp) (id int)) (Option UiWin) (match a ((UiApp c port f ws o lp) (map_get ws id))))

; The app with w put back by its id, the app's face kept: what a program
; does with a window it took out with ui_app_win and routed or changed
; itself.
(def ui_app_put ((a UiApp) (w UiWin)) UiApp
  (match a ((UiApp c port f ws o lp) (UiApp c port f (map_put ws (ui_win_id w) w) o lp))))

; The same, w just presented with the app's face: its face, which holds
; any strike that presenting asked for, the app's from now on.
(def ui_app_put_faced ((a UiApp) (w UiWin)) UiApp
  (match a ((UiApp c port f ws o lp) (UiApp c port (ui_win_face w) (map_put ws (ui_win_id w) w) o lp))))

; ---------------------------------------------------------------- windows

; One more window, w by h titled title, in front, on the app's port,
; painted nothing yet; or refused, if it would take a region past what
; the process has left (ui_app_room).
(def ui_app_open ((a UiApp) (title (list int)) (w int) (h int)) UiAppOpened (ui_app_open_as a title w h false))

; The same, a window that draws its own title bar (window.l0's ui_open_csd).
(def ui_app_open_csd ((a UiApp) (title (list int)) (w int) (h int)) UiAppOpened (ui_app_open_as a title w h true))

; A window opened, decorated by its client if csd.
(def ui_app_open_as ((a UiApp) (title (list int)) (w int) (h int) (csd bool)) UiAppOpened
  (match a
    ((UiApp c port f ws o lp)
      (let used (ui_app_regions a)
        (if (not (ui_regions_room used))
            (UiAppRefused a (ui_regions_full_why used))
            (match (ui_win_open c f port title w h csd)
              ((UiOpenFailed why) (UiAppRefused a why))
              ((UiOpenedWin win) (UiAppOpened (ui_app_put a (ui_win_ported win (ui_loop_rport lp) (ui_loop_aport lp))) (ui_win_id win)))))))))

; Window id closed, and its buffers given up, and the app without it; as
; it was if it has no such window.
(def ui_app_close ((a UiApp) (id int)) UiApp
  (match a
    ((UiApp c port f ws o lp)
      (match (map_get ws id)
        ((None) a)
        ((Some w) (let x (ui_close w) (UiApp c port f (map_remove ws id) o lp)))))))

; The app ended by the compositor, as the toolkit ends one that did
; nothing with the close of its last window (window.l0's
; ui_closed_unasked).
(def ui_app_end ((a UiApp)) int (let e (compositor_end (ui_app_compositor a)) 0))

; ---------------------------------------------------------------- regions

; The most regions a process may have open at once, the proc runtime's;
; and how many of them an app keeps for its own, its disks' buffers and
; such, past its windows and its face.
(def ui_regions_max () int 64)
(def ui_app_reserve () int 8)

; How many regions the app holds: one for each strike of its face, which
; is read in place from the pages font shares; two for each window, its
; buffer shown and the one it paints (window.l0's UiBack); and one more,
; for the buffer a resize makes before it gives up the old.
(def ui_app_regions ((a UiApp)) int
  (match a ((UiApp c port f ws o lp) (add (ui_face_regions f) (add (mul 2 (map_size ws)) 1)))))

; How many of face f's strikes are regions.
(def ui_face_regions ((f UiFace)) int
  (match f ((UiFace s ts ks) (ui_strikes_in (map_values ks) 0))))

; How many of ks are over pages font shares, onto n.
(def ui_strikes_in ((ks (list UiStrike)) (n int)) int
  (if (is_empty ks)
      n
      (ui_strikes_in (tail ks) (match (head ks) ((UiStrikeIn r) (add n 1)) ((UiStrikeBytes b) n) ((UiStrikeAsked t) n)))))

; Whether a window, two regions more, fits with used held: within the
; process's 64, ui_app_reserve kept.
(def ui_regions_room ((used int)) bool
  (le (add used 2) (sub (ui_regions_max) (ui_app_reserve))))

; Why a window is refused, used regions held.
(def ui_regions_full_why ((used int)) (list int)
  (append "no room for another window: " (append (digits used) (append " of a process's " (append (digits (ui_regions_max)) " regions held")))))

; --------------------------------------------------------------- the loop

; The app after its next message was taken, and what it is.
(data UiAppNext (UiAppNext UiApp UiAppEvent))

; The next message to the app's port, as an event of one of its windows
; or of none: the one place the loop takes its messages. The app's loop
; (uiloop.l0's ui_loop_take) takes what waits first and puts it
; together, each window's moves of the pointer and turns of the wheel
; that follow one another made one, by the buttons each window last
; knew; if nothing waits, the next is waited for.
(def ui_app_next ((a UiApp)) UiAppNext
  (match a
    ((UiApp c port f ws o lp)
      (match (ui_loop_take lp port (compositor_pid c) (ui_app_held (map_values ws) ((MapEmpty int int))))
        ((UiTaken lp2 got)
          (let a2 (UiApp c port f ws o lp2)
            (match got
              ((UiGotMsg m) (UiAppNext a2 (ui_app_event a2 m)))
              ((UiGotStrike payload) (ui_app_struck a2 payload))
              ((UiGotReply tag m) (UiAppNext a2 (UiAppEvent -1 (UiReply tag m))))
              ((UiGotIdle) (UiAppNext a2 (UiAppEvent -1 (UiIdle))))
              ((UiGotRedraw id) (UiAppNext a2 (UiAppEvent id (UiReply -1 (RecvFailed)))))
              ((UiGotLost) (UiAppNext a2 (UiAppEvent -1 (UiOther -1 "")))))))))))

; a once font answered a strike it asked for, payload: the strike taken
; into the app's face, every window's text from it to be painted again
; (window.l0's ui_win_restruck), and each window told, UiReply -1, the
; first now and the rest by the steps after (the loop's redraws), so
; that the app presents each.
(def ui_app_struck ((a UiApp) (payload (list int))) UiAppNext
  (match a
    ((UiApp c port f ws o lp)
      (match (ui_face_answered f payload)
        ((UiAnswered f2 name)
          (let ids (sort (map_keys ws))
            (let a2 (UiApp c port f2 (ui_wins_restruck ws (map_values ws) name) o (ui_loop_redrawing lp (if (is_empty ids) ids (tail ids))))
              (UiAppNext a2 (UiAppEvent (if (is_empty ids) -1 (head ids)) (UiReply -1 (RecvFailed)))))))))))

; ws with each of wins restruck by name.
(def ui_wins_restruck ((ws (Map int UiWin)) (wins (list UiWin)) (name (list int))) (Map int UiWin)
  (if (is_empty wins) ws (ui_wins_restruck (map_put ws (ui_win_id (head wins)) (ui_win_restruck (head wins) name)) (tail wins) name)))

; a after it asked port body, the answer to come as an event of no
; window, UiReply tag: sent, never waited on (uiloop.l0's ui_loop_ask),
; as Files lists a folder.
(def ui_app_ask ((a UiApp) (tag int) (port int) (body (list int))) UiApp
  (match a ((UiApp c p f ws o lp) (UiApp c p f ws o (ui_loop_ask lp tag port body)))))

; a with idle work, so ui_app_next hands out UiIdle, of no window, while
; nothing waits; or with none, so it waits.
(def ui_app_idling ((a UiApp) (idle bool)) UiApp
  (match a ((UiApp c p f ws o lp) (UiApp c p f ws o (ui_loop_idling lp idle)))))

; Each of wins's buttons as last told, by its id, onto m.
(def ui_app_held ((wins (list UiWin)) (m (Map int int))) (Map int int)
  (if (is_empty wins) m (ui_app_held (tail wins) (map_put m (ui_win_id (head wins)) (ui_win_held (head wins))))))

; What a message m to the app's port is: of the window the compositor's
; window notice names (window.l0's ui_event_of of it), if it is the
; app's; else of none, -1: an exit, an open (the app launched again), or
; anything else as UiOther (window.l0's ui_message_event).
(def ui_app_event ((a UiApp) (m Message)) UiAppEvent
  (match (ui_app_window_of a m)
    ((Some w) (UiAppEvent (ui_win_id w) (ui_event_of w m)))
    ((None) (UiAppEvent -1 (ui_message_event m)))))

; Whether e says the app's port is gone, as a receive that failed gives:
; the loop has nothing more to wait for.
(def ui_app_event_lost ((e UiAppEvent)) bool
  (match e
    ((UiAppEvent id ev) (if (lt id 0) (ui_event_lost ev) false))))

; The app's window m, a window notice from the compositor, is of, if it
; is one and the window is open.
(def ui_app_window_of ((a UiApp) (m Message)) (Option UiWin)
  (match m
    ((RecvFailed) ((None UiWin)))
    ((Message from b)
      (if (not (eq from (compositor_pid (ui_app_compositor a))))
          ((None UiWin))
          (match (win_notice_of m)
            ((NoWinNotice) ((None UiWin)))
            ((WinNotice id at) (ui_app_win a id)))))))

; Window id's event ev routed, as window.l0's ui_route does, the window
; put back: the app, and the action set off, "" for none or no window.
; An open, of no window, sets off app.open (ui_open_action), its
; arguments ui_open_args's, and is answered shown 0 here unless the app
; answers opens itself (ui_app_opening).
(def ui_app_route ((a UiApp) (id int) (ev UiEvent)) UiAppRouted
  (if (ge (ui_open_reply ev) 0)
      (UiAppRouted (ui_app_open_routed a ev) (ui_open_action))
      (match (ui_app_win a id)
        ((None) (UiAppRouted a ""))
        ((Some w) (match (ui_route w ev) ((UiRouted w2 action) (UiAppRouted (ui_app_put a w2) action)))))))

; The app after an open, ev, is routed: answered shown 0, unless the app
; answers its opens itself.
(def ui_app_open_routed ((a UiApp) (ev UiEvent)) UiApp
  (match a ((UiApp c port f ws o lp) (if o a (ui_app_shown a ev 0)))))

; Whether the app answers its opens itself.
(def ui_app_answers_opens ((a UiApp)) bool (match a ((UiApp c port f ws o lp) o)))

; Window id showing widget, as window.l0's ui_present paints it, with the
; app's face, which it keeps any strike it is given in, so the next
; window has it too; then put back. A window asked to close that the app
; presents again did nothing with the close: it is closed instead, and,
; if it was the last, the app ended (ui_app_end).
(def ui_app_present ((a UiApp) (id int) (widget UiWidget)) UiApp
  (match (ui_app_win a id)
    ((None) a)
    ((Some w)
      (if (ui_win_close_asked w)
          (let a2 (ui_app_close a id)
            (if (eq (ui_app_count a2) 0) (let e (ui_app_end a2) a2) a2))
          (match a ((UiApp c port f ws o lp) (ui_app_put_faced a (ui_present (ui_win_faced w f) widget))))))))
