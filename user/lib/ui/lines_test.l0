; lines_test.l0 -- text that wraps and scrolls: wrapping at spaces and
; inside a long word, a paragraph's rows, the end shown and kept, and
; the nodes laid out.

(def lrect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; The actions of the nodes that have one, and where each is.
(def ln_targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (ln_targets (tail ns)) (append a (append "@" (append (lrect r) (append " " (ln_targets (tail ns)))))))))))

(def ln_light () UiState (ui_state_new (UiLight)))

; Lines as text, joined by |.
(def lines_text ((ls (list (list int)))) (list int)
  (if (is_empty ls) "" (append (head ls) (if (is_empty (tail ls)) "" (cons 124 (lines_text (tail ls)))))))

(def tw ((s (list int))) int (ui_text_w s (ui_text_font) false 1))

; Exactly as wide as "aa bb", it is one line; a pixel less, two.
(def test_wrap_at_spaces () int
  (add (check_str "fits" (lines_text (ui_wrapped "aa bb" (tw "aa bb") (UiLinePlain))) "aa bb")
       (check_str "wraps" (lines_text (ui_wrapped "aa bb" (sub (tw "aa bb") 1) (UiLinePlain))) "aa|bb")))

; Runs of spaces are one, and nothing is one empty line.
(def test_wrap_spaces_and_empty () int
  (add (check_str "spaces" (lines_text (ui_wrapped "  aa   bb " 1000 (UiLinePlain))) "aa bb")
       (check_int "empty" (length (ui_wrapped "" 1000 (UiLinePlain))) 1)))

; A word wider than the row is cut where it no longer fits: "abcdef" in
; the width of "abc" is three and three; and a row narrower than a
; character still takes one.
(def test_wrap_long_word () int
  (add (check_str "cut" (lines_text (ui_wrapped "abcdef" (tw "abc") (UiLinePlain))) "abc|def")
       (check_str "one each" (lines_text (ui_wrapped "ab" 1 (UiLinePlain))) "a|b")))

; A paragraph with an icon has it on its first row, the rest indented,
; and wraps short of the icon's room.
(def test_rows_icon () int
  (let rows (ui_lines_rows (cons (UiPara "aa bb" (UiLineDim) "go-next" "x.tool.1") (nil UiPara)) (add (tw "aa") (ui_lines_icon_room)))
    (if (lt (length rows) 2)
        (fail_because "rows" "fewer than two")
        (let a (head rows)
          (add (check_str "first" (append (.icon a) (append " " (.text a))) "go-next aa")
               (check_bool "then indented" (.indent (nth rows 1)) true))))))

; Of 30 rows, 10 showing: the end, 20, for -1 or anything past it.
(def test_shown_from () int
  (add (check_int "the end" (ui_lines_shown_from -1 30 10) 20)
       (add (check_int "past it" (ui_lines_shown_from 25 30 10) 20)
            (check_int "as asked" (ui_lines_shown_from 4 30 10) 4))))

; Scrolled to the most there is, the end is kept as rows come: -1.
(def test_first () int
  (add (check_int "to the end" (ui_lines_first 3 "ln" "ln.scrollto.20" (UiScroller 4 20 10)) -1)
       (add (check_int "up" (ui_lines_first -1 "ln" "ln.scrollto.7" (UiScroller 20 20 10)) 7)
            (check_int "another's" (ui_lines_first 7 "ln" "xs.scrollto.1" (UiScroller 7 20 10)) 7))))

; Paragraphs a, b, c... of n, the last two with actions.
(def paras_of ((n int)) (list UiPara) (paras_onto n n (nil UiPara)))

(def paras_onto ((i int) (n int) (acc (list UiPara))) (list UiPara)
  (if (le i 0)
      acc
      (paras_onto (sub i 1) n
        (cons (UiPara (cons (add 96 i) (nil int)) (UiLinePlain) "" (if (gt i (sub n 2)) (append "ln.row." (digits i)) "")) acc))))

; Three paragraphs in 400 by 100 all show: 4 rows of 20 fit, (100 - 6)
; / 20, from 6 down; the area, then the two rows with actions, 20 high.
(def test_layout_all () int
  (check_str "targets"
    (ln_targets (ui_layout (UiLines (UiLinesData "ln" (paras_of 3) -1)) (Rect 0 0 400 100) (ln_light) 0))
    "ln.scroll.0.0.4.20@0,6 400x80 ln.row.2@0,26 400x20 ln.row.3@0,46 400x20 "))

; Six of them, 4 showing: the end shows, from row 2, the last rows with
; actions from 46, and a scrollbar along the right, its slider two
; thirds of the 80 rows, 53, with 27 to travel.
(def test_layout_end () int
  (let t (ln_targets (ui_layout (UiLines (UiLinesData "ln" (paras_of 6) -1)) (Rect 0 0 400 100) (ln_light) 0))
    (add (check_bool "from row 2" (starts_with t "ln.scroll.2.2.4.20@0,6 400x80 ln.row.5@0,46 400x20 ln.row.6@0,66 400x20 ") true)
         (check_bool "a scrollbar" (has_text t "ln.scrollbar.2.2.") true))))

; Whether s holds part.
(def has_text ((s (list int)) (part (list int))) bool
  (if (starts_with s part) true (is_empty s) false (has_text (tail s) part)))
