(def rect_text ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def test_ui_fills () int
  (let ops (ui_fills (cons (Rect 1 2 3 4) (cons (Rect 5 6 7 8) (nil Rect))) 255)
    (add (check_int "an op a rectangle" (length ops) 2)
         (check_bool "in order" (eq (head (tail ops)) (UiPFill (Rect 5 6 7 8) 255)) true))))

; ------------------------------------------------- painting, on an array

; The color at x, y of c, as hex.
(def px_at ((c Canvas) (x int) (y int)) (list int) (hex_digits (canvas_pixel c x y) 6))

; No font, at scale 1.
(def no_face () UiFace (ui_face_1x (array_new 0 0)))

; A fill of the whole 4 by 4 canvas, cut to its left half.
(def test_ui_paint_clipped () int
  (let c (ui_paint (canvas_new 4 4 0) (no_face) (Rect 0 0 2 4) (cons (UiPFill (Rect 0 0 4 4) 16711680) (nil UiPaint)))
    (add (check_str "inside the clip" (px_at c 1 3) "ff0000")
         (check_str "outside it" (px_at c 2 0) "000000"))))

; A round of radius 10 over a 20 by 20 canvas of 242424, mixed with what
; is there: its corner is the ground, its middle the color, and row 0's
; edge pixel 6, one the corner partly covers, the color at its coverage,
; (ui_corner_pct 10 0 6) percent.
(def test_ui_paint_round () int
  (let c (ui_paint (canvas_new 20 20 (ui_hex "242424")) (no_face) (Rect 0 0 20 20)
                   (cons (UiPRound (Rect 0 0 20 20) 10 (ui_hex "1c71d8") -1) (nil UiPaint)))
    (add (check_str "a cut corner" (px_at c 0 0) "242424")
         (add (check_str "the middle" (px_at c 10 10) "1c71d8")
              (check_str "an edge pixel, mixed" (px_at c 6 0) (hex_digits (ui_mix (ui_hex "1c71d8") (ui_hex "242424") (ui_corner_pct 10 0 6)) 6))))))

; With no font, text paints nothing.
(def test_ui_paint_no_font () int
  (let c (ui_paint (canvas_new 16 16 0) (no_face) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 16 16) "A" (UiStart) 16777215 false 1) (nil UiPaint)))
    (check_str "untouched" (px_at c 3 8) "000000")))

; An icon at scale 2: view-app-grid's first row lit from column 0 to 3,
; so pixels 0 to 7 of rows 0 and 1.
(def test_ui_paint_icon () int
  (let c (ui_paint (canvas_new 32 32 0) (no_face) (Rect 0 0 32 32)
                   (cons (UiPIcon 0 0 "view-app-grid" 16777215 2) (nil UiPaint)))
    (add (check_str "lit" (px_at c 7 1) "ffffff")
         (check_str "past it" (px_at c 8 0) "000000"))))

(def test_ui_text_w () int
  (add (check_int "plain" (ui_text_w "abc" false 1) 24)
       (add (check_int "bold" (ui_text_w "abc" true 1) 25)
            (check_int "twice the size" (ui_text_w "abc" false 2) 48))))

(def test_ui_ellipsized () int
  (add (check_str "fits" (ui_ellipsized "hello" 40 1) "hello")
       (add (check_str "cut" (ui_ellipsized "hello world" 64 1) "hello...")
            (check_str "no room for more than dots" (ui_ellipsized "hello" 16 1) ".."))))

(def test_ui_aligned () int
  (add (check_int "start" (ui_aligned 10 100 20 (UiStart)) 10)
       (add (check_int "center" (ui_aligned 10 100 20 (UiCenter)) 50)
            (check_int "end" (ui_aligned 10 100 20 (UiEnd)) 90))))

; A corner of 12: its top row is not all covered for 12 pixels, its
; twelfth for 1, and the row after it not at all.
(def test_ui_corner_reach () int
  (add (check_int "the top row" (ui_corner_reach 12 0) 12)
       (add (check_int "the twelfth" (ui_corner_reach 12 11) 1)
            (check_int "past the corner" (ui_corner_reach 12 12) 0))))

(def test_ui_corner_row () int
  (add (check_int "the bottom row as the top" (ui_corner_row 12 40 39) 0)
       (check_int "the middle" (ui_corner_row 12 40 20) -1)))

; Coverage of a corner of 12: none in its corner pixel, all past it, and
; rising along every row.
(def test_ui_corner_pct () int
  (add (check_int "the corner pixel" (ui_corner_pct 12 0 0) 0)
       (add (check_int "past the corner" (ui_corner_pct 12 0 12) 100)
            (check_int "its twelfth row's first" (ui_corner_pct 12 11 0) 99))))

; Along a row coverage never falls, and read across or down, the corner
; is the same within the sampling's error.
(def test_ui_corner_pct_shape () int
  (add (check_int "nondecreasing along 5" (ui_pct_falls 12 5 0 0) 0)
       (check_int "symmetric about the diagonal" (ui_pct_asymmetric 12 0 0) 0)))

; How many pixels of row dy have less coverage than the one before.
(def ui_pct_falls ((r int) (dy int) (i int) (bad int)) int
  (if (ge i (sub r 1))
      bad
      (ui_pct_falls r dy (add i 1) (add bad (if (lt (ui_corner_pct r dy (add i 1)) (ui_corner_pct r dy i)) 1 0)))))

; How many pixels of a corner of r differ from their mirror in the
; diagonal by more than 4 percent.
(def ui_pct_asymmetric ((r int) (dy int) (bad int)) int
  (if (ge dy r)
      bad
      (ui_pct_asymmetric r (add dy 1) (add bad (ui_row_asymmetric r dy 0 0)))))

(def ui_row_asymmetric ((r int) (dy int) (i int) (bad int)) int
  (if (ge i r)
      bad
      (let d (sub (ui_corner_pct r dy i) (ui_corner_pct r i dy))
        (ui_row_asymmetric r dy (add i 1) (add bad (if (gt (if (lt d 0) (neg d) d) 4) 1 0))))))

(def test_ui_fit_radius () int
  (add (check_int "fits" (ui_fit_radius 6 100 34) 6)
       (check_int "a circle at most" (ui_fit_radius 20 24 24) 12)))

(def test_ui_arrow () int
  (add (check_int "17 rows" (length (ui_arrow_art)) 17)
       (check_str "its tip" (head (ui_arrow_art)) "W")))

; ------------------------------------------------------------- at scale 2

; A face at scale 2 with no tables: text and icons doubled from bitmaps.
(def face2_bare () UiFace (UiFace 2 (array_new 0 0) ((MapEmpty (list int) UiCov))))

; A face at scale 2 whose regular glyphs, 16 by 32, are blank but for A's
; top row: fully covered at its first column, half at its second.
(def face2_glyphs () UiFace
  (let words (array_set (array_new (mul 95 32) 0) (mul (sub 65 32) 32) (bit_shl 248 56))   ; f8: 15, then 8
    (UiFace 2 (array_new 0 0) (map_put ((MapEmpty (list int) UiCov)) "glyph.regular.32" (UiCov 16 32 words)))))

; A fill at scale 2 covers twice as much each way.
(def test_scaled_fill () int
  (let c (ui_paint (canvas_new 8 8 0) (face2_bare) (Rect 0 0 4 4) (cons (UiPFill (Rect 1 1 1 1) 16711680) (nil UiPaint)))
    (add (check_str "its top left" (px_at c 2 2) "ff0000")
         (add (check_str "its bottom right" (px_at c 3 3) "ff0000")
              (check_str "past it" (px_at c 4 4) "000000")))))

; The clip is the desktop's pixels too: a clip of 2 by 4 is the canvas's
; left half of 8 by 8.
(def test_scaled_clip () int
  (let c (ui_paint (canvas_new 8 8 0) (face2_bare) (Rect 0 0 2 4) (cons (UiPFill (Rect 0 0 4 4) 255) (nil UiPaint)))
    (add (check_str "inside the clip" (px_at c 3 7) "0000ff")
         (check_str "outside it" (px_at c 4 0) "000000"))))

; Text at scale 2 is drawn from the face's glyphs, each pixel mixed by its
; cover: A at 0, 0 of a 16 by 16 box, its cell 16 by 32 at 0, 0.
(def test_smooth_text () int
  (let c (ui_paint (canvas_new 32 32 0) (face2_glyphs) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 8 16) "A" (UiStart) 16777215 false 1) (nil UiPaint)))
    (add (check_str "covered" (px_at c 0 0) "ffffff")
         (add (check_str "8 of 15 covered, mixed 53%" (px_at c 1 0) (hex_digits (ui_mix 16777215 0 53) 6))
              (check_str "not covered" (px_at c 2 0) "000000")))))

; Without the face's glyphs, text at 2 is the bitmap's doubled; without a
; font at all, nothing.
(def test_text_no_glyphs () int
  (let c (ui_paint (canvas_new 32 32 0) (face2_bare) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 16 16) "A" (UiStart) 16777215 false 1) (nil UiPaint)))
    (check_str "untouched" (px_at c 6 16) "000000")))

; An icon without the face's table at 2 is its bitmap at twice its scale:
; view-app-grid's first square, 4 pixels at scale 1, is 8 at 2.
(def test_icon_doubled () int
  (let c (ui_paint (canvas_new 64 64 0) (face2_bare) (Rect 0 0 32 32)
                   (cons (UiPIcon 0 0 "view-app-grid" 16777215 1) (nil UiPaint)))
    (add (check_str "lit" (px_at c 7 7) "ffffff")
         (check_str "past it" (px_at c 8 0) "000000"))))

; A round at 2 has twice the radius: its corner's first row is cut as a
; radius of 20's is.
(def test_scaled_round () int
  (let c (ui_paint (canvas_new 40 40 0) (face2_bare) (Rect 0 0 20 20)
                   (cons (UiPRound (Rect 0 0 20 20) 10 16777215 0) (nil UiPaint)))
    (add (check_str "cut" (px_at c 0 0) "000000")
         (check_str "the middle" (px_at c 20 20) "ffffff"))))

; The pointer at 2 is the face's: each of its words a pixel, as it is.
(def test_cursor_from_face () int
  (let words (array_set (array_new (mul 64 64) 0) 65 4278190080)               ; ff000000 at 1, 1
    (let face (UiFace 2 (array_new 0 0) (map_put ((MapEmpty (list int) UiCov)) "cursor" (UiCov 64 64 words)))
      (let c (ui_paint_cursor (canvas_new 64 64 0) face)
        (check_str "its pixel, alpha and all" (hex_digits (canvas_whole_pixel c 1 1) 8) "ff000000")))))

(def canvas_whole_pixel ((c Canvas) (x int) (y int)) int
  (match c ((Canvas fb w h top) 0) ((ArrayCanvas px w h top) (array_get px (add (mul y w) x)))))

(def test_buffer_at () int
  (check_int "pages at 2" (buffer_pages (mul 640 2) (mul 400 2)) 1000))
