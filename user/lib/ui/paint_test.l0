(def rect_text ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def test_ui_fills () int
  (let ops (ui_fills (cons (Rect 1 2 3 4) (cons (Rect 5 6 7 8) (nil Rect))) 255)
    (add (check_int "an op a rectangle" (length ops) 2)
         (check_bool "in order" (eq (head (tail ops)) (UiPFill (Rect 5 6 7 8) 255)) true))))

; ------------------------------------------------- painting, on an array

; The color at x, y of c, as hex.
(def px_at ((c Canvas) (x int) (y int)) (list int) (hex_digits (canvas_pixel c x y) 6))

; No font, at scale 1.
(def no_face () UiFace (ui_face_none))

; A fill of the whole 4 by 4 canvas, cut to its left half.
(def test_ui_paint_clipped () int
  (let c (ui_paint (canvas_new 4 4 0) (no_face) (Rect 0 0 2 4) (cons (UiPFill (Rect 0 0 4 4) 16711680) (nil UiPaint)))
    (add (check_str "inside the clip" (px_at c 1 3) "ff0000")
         (check_str "outside it" (px_at c 2 0) "000000"))))

; A round of radius 10 over a 20 by 20 canvas of 242424, mixed with what
; is there: its corner is the ground, its middle the color, and row 0's
; edge pixel 6, one the corner partly covers, the color at its coverage,
; (ui_corner_pct 10 0 6) percent.
(def test_ui_paint_round () int
  (let c (ui_paint (canvas_new 20 20 (ui_hex "242424")) (no_face) (Rect 0 0 20 20)
                   (cons (UiPRound (Rect 0 0 20 20) 10 (ui_hex "1c71d8") -1) (nil UiPaint)))
    (add (check_str "a cut corner" (px_at c 0 0) "242424")
         (add (check_str "the middle" (px_at c 10 10) "1c71d8")
              (check_str "an edge pixel, mixed" (px_at c 6 0) (hex_digits (ui_mix (ui_hex "1c71d8") (ui_hex "242424") (ui_corner_pct 10 0 6)) 6))))))

; With no font, text paints nothing.
(def test_ui_paint_no_font () int
  (let c (ui_paint (canvas_new 16 16 0) (no_face) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 16 16) "A" (UiStart) 16777215 (UiMono) false 1) (nil UiPaint)))
    (check_str "untouched" (px_at c 3 8) "000000")))

; An icon's table n by n covering its top left 8 by 8 wholly: each of
; those rows' first word eight 15s, then nothing.
(def box_icon ((n int)) UiCov
  (UiCov n n (box_words n 0 (array_new (mul n (ui_cov_wpr n)) 0))))

(def box_words ((n int) (y int) (out (array int))) (array int)
  (if (ge y 8) out (box_words n (add y 1) (array_set out (mul y (ui_cov_wpr n)) (bit_shl 4294967295 32)))))

; A face at scale s with the icon "box" at 16 and 32 times s.
(def box_face ((s int)) UiFace
  (UiFace s (map_put (map_put ((MapEmpty (list int) UiCov)) (ui_icon_table "box" (mul 16 s)) (box_icon (mul 16 s)))
                                     (ui_icon_table "box" (mul 32 s)) (box_icon (mul 32 s)))
          (ui_strikes_none)))

; An icon at its scale 2 is the face's table of 32: lit to 7, not 8.
(def test_ui_paint_icon () int
  (let c (ui_paint (canvas_new 32 32 0) (box_face 1) (Rect 0 0 32 32)
                   (cons (UiPIcon 0 0 "box" 16777215 2) (nil UiPaint)))
    (add (check_str "lit" (px_at c 7 7) "ffffff")
         (check_str "past it" (px_at c 8 0) "000000"))))

; With no table of its size, an icon is not drawn.
(def test_ui_paint_no_icon () int
  (let c (ui_paint (canvas_new 32 32 0) (no_face) (Rect 0 0 32 32)
                   (cons (UiPIcon 0 0 "box" 16777215 1) (nil UiPaint)))
    (check_str "nothing" (px_at c 0 0) "000000")))

; Source Code Pro's cells: 8 a character, bold too, its own advances.
(def test_ui_text_w () int
  (add (check_int "plain" (ui_text_w "abc" (UiMono) false 1) 24)
       (add (check_int "bold" (ui_text_w "abc" (UiMono) true 1) 24)
            (check_int "twice the size" (ui_text_w "abc" (UiMono) false 2) 48))))

; Source Sans 3's advances: a, b and c are 1513 units of its 1000 an
; em, which at a line of 16 is 40/3 pixels, so 20.17, rounded up 21; at
; 32, 40.35, so 41, not twice 21, as the sum is turned into pixels once.
(def test_ui_text_w_sans () int
  (add (check_int "plain" (ui_text_w "abc" (UiSans) false 1) 21)
       (add (check_int "at 2" (ui_text_w "abc" (UiSans) false 2) 41)
            (check_int "bold, its own advances, 1567" (ui_text_w "abc" (UiSans) true 1) 21))))

; An i is 246 units, 3.28 pixels, so 4; an m 829, 11.05, so 12.
(def test_sans_proportional () int
  (add (check_int "i" (ui_text_w "i" (UiSans) false 1) 4)
       (check_int "m" (ui_text_w "m" (UiSans) false 1) 12)))

; How many of the digits from code to 9 have an advance other than 0's.
(def digits_apart ((f UiFont) (bold bool) (code int) (n int)) int
  (if (gt code 57)
      n
      (digits_apart f bold (add code 1) (add n (if (eq (ui_font_adv f bold code) (ui_font_adv f bold 48)) 0 1)))))

; Source Sans 3's default figures are tabular, all one advance, 497
; units and bold's 528, so numbers line up in columns in it as in
; Source Code Pro, and the grid's numbers, Monitor's columns and the
; clock need no other face.
(def test_sans_digits_line_up () int
  (add (check_int "regular" (digits_apart (UiSans) false 48 0) 0)
       (add (check_int "bold" (digits_apart (UiSans) true 48 0) 0)
            (check_int "497" (ui_font_adv (UiSans) false 48) 497))))

(def test_ui_ellipsized () int
  (add (check_str "fits" (ui_ellipsized "hello" 40 (UiMono) false 1) "hello")
       (add (check_str "cut" (ui_ellipsized "hello world" 64 (UiMono) false 1) "hello...")
            (check_str "no room for more than dots" (ui_ellipsized "hello" 16 (UiMono) false 1) ".."))))

; In 40 pixels of Source Sans 3: hello and ... are 2839 units, 37.85
; pixels, which fit; with the space after hello, 3039, 40.52, do not.
(def test_ui_ellipsized_sans () int
  (add (check_str "cut" (ui_ellipsized "hello world" 40 (UiSans) false 1) "hello...")
       (check_str "fits" (ui_ellipsized "hello" 28 (UiSans) false 1) "hello")))

(def test_ui_aligned () int
  (add (check_int "start" (ui_aligned 10 100 20 (UiStart)) 10)
       (add (check_int "center" (ui_aligned 10 100 20 (UiCenter)) 50)
            (check_int "end" (ui_aligned 10 100 20 (UiEnd)) 90))))

; A corner of 12: its top row is not all covered for 12 pixels, its
; twelfth for 1, and the row after it not at all.
(def test_ui_corner_reach () int
  (add (check_int "the top row" (ui_corner_reach 12 0) 12)
       (add (check_int "the twelfth" (ui_corner_reach 12 11) 1)
            (check_int "past the corner" (ui_corner_reach 12 12) 0))))

(def test_ui_corner_row () int
  (add (check_int "the bottom row as the top" (ui_corner_row 12 40 39) 0)
       (check_int "the middle" (ui_corner_row 12 40 20) -1)))

; Coverage of a corner of 12: none in its corner pixel, all past it, and
; rising along every row.
(def test_ui_corner_pct () int
  (add (check_int "the corner pixel" (ui_corner_pct 12 0 0) 0)
       (add (check_int "past the corner" (ui_corner_pct 12 0 12) 100)
            (check_int "its twelfth row's first" (ui_corner_pct 12 11 0) 99))))

; Along a row coverage never falls, and read across or down, the corner
; is the same within the sampling's error.
(def test_ui_corner_pct_shape () int
  (add (check_int "nondecreasing along 5" (ui_pct_falls 12 5 0 0) 0)
       (check_int "symmetric about the diagonal" (ui_pct_asymmetric 12 0 0) 0)))

; How many pixels of row dy have less coverage than the one before.
(def ui_pct_falls ((r int) (dy int) (i int) (bad int)) int
  (if (ge i (sub r 1))
      bad
      (ui_pct_falls r dy (add i 1) (add bad (if (lt (ui_corner_pct r dy (add i 1)) (ui_corner_pct r dy i)) 1 0)))))

; How many pixels of a corner of r differ from their mirror in the
; diagonal by more than 4 percent.
(def ui_pct_asymmetric ((r int) (dy int) (bad int)) int
  (if (ge dy r)
      bad
      (ui_pct_asymmetric r (add dy 1) (add bad (ui_row_asymmetric r dy 0 0)))))

(def ui_row_asymmetric ((r int) (dy int) (i int) (bad int)) int
  (if (ge i r)
      bad
      (let d (sub (ui_corner_pct r dy i) (ui_corner_pct r i dy))
        (ui_row_asymmetric r dy (add i 1) (add bad (if (gt (if (lt d 0) (neg d) d) 4) 1 0))))))

(def test_ui_fit_radius () int
  (add (check_int "fits" (ui_fit_radius 6 100 34) 6)
       (check_int "a circle at most" (ui_fit_radius 20 24 24) 12)))

(def test_ui_arrow () int
  (add (check_int "17 rows" (length (ui_arrow_art)) 17)
       (check_str "its tip" (head (ui_arrow_art)) "W")))

; Each row of a resize pointer's art as long as its first, so that it is
; a rectangle: 23 by 11 across, 13 by 21 up and down, 19 by 17 on the
; diagonals, its last row the last drawn on.
(def art_size ((name (list int))) (list int)
  (let rows (ui_cursor_art name)
    (append (digits (length (head rows)))
            (append "x" (append (digits (length rows)) (if (all_len rows (length (head rows))) "" " ragged"))))))

(def all_len ((rows (list (list int))) (n int)) bool
  (if (is_empty rows) true (if (eq (length (head rows)) n) (all_len (tail rows) n) false)))

(def test_cursor_art () int
  (add (check_str "across" (art_size "ew-resize") "23x11")
       (add (check_str "up and down" (art_size "ns-resize") "13x21")
            (add (check_str "a diagonal" (art_size "nwse-resize") "19x17")
                 (add (check_str "the other" (art_size "nesw-resize") "19x17")
                      (check_str "an unknown name, the arrow" (art_size "busy") "1x17 ragged"))))))

; A resize pointer's hot spot is the black middle of its art: 11, 6
; across, 6, 11 up and down, 9, 9 on a diagonal; at scale 2 twice as far,
; in the middle of the pixel; the arrow's its tip at any scale.
(def test_cursor_hot () int
  (add (check_str "across" (append (digits (ui_cursor_hot_x "ew-resize" 1)) (append "," (digits (ui_cursor_hot_y "ew-resize" 1)))) "11,6")
       (add (check_str "at 2" (append (digits (ui_cursor_hot_x "ew-resize" 2)) (append "," (digits (ui_cursor_hot_y "ew-resize" 2)))) "23,13")
            (add (check_int "the arrow's" (ui_cursor_hot_x "" 2) 0)
                 (check_str "black there" (px_at (ui_paint_named_cursor (canvas_new 64 64 0) (ui_face_none) "nwse-resize") 9 9) "000000")))))

; Painting a pointer clears what was there: the arrow's tip is not left
; under the across pointer, which is clear at 0, 0.
(def test_cursor_cleared () int
  (let face (ui_face_none)
    (let c (ui_paint_named_cursor (ui_paint_named_cursor (canvas_new 64 64 0) face "") face "ew-resize")
      (check_str "clear" (hex_digits (canvas_whole_pixel c 0 0) 8) "00000000"))))

(def test_cursor_tables () int
  (add (check_str "the arrow's" (ui_cursor_table "") "cursor")
       (check_str "a resize pointer's" (ui_cursor_table "ns-resize") "cursor.ns-resize")))

; ------------------------------------------------------------- at scale 2

; A face at scale 2 with no tables: no text or icons.
(def face2_bare () UiFace (UiFace 2 ((MapEmpty (list int) UiCov)) (ui_strikes_none)))

; A strike h tall with no ink but A's: one row, its box at the pen and
; the line's top, fully covered at its first column, half at its second.
(def strike_a ((h int)) UiStrike
  (UiStrikeBytes (bytes_from_list (rev (push (le64 (bit_shl 248 56)) (strike_entries_a 32 (strike_header_a h)))))))   ; f8: 15, then 8

; A strike's header, h tall, reversed.
(def strike_header_a ((h int)) (list int)
  (push (u32_le 95) (push (u32_le 1000) (push (u32_le 600) (push (u32_le 0) (push (u32_le h) (push "L0ST" (nil int))))))))

; Entries from code on onto acc, reversed: A's a box 16 wide and a row
; tall at the coverage's start, every other's empty.
(def strike_entries_a ((code int) (acc (list int))) (list int)
  (if (gt code 126)
      acc
      (strike_entries_a (add code 1)
        (push (u32_le (if (eq code 65) 2304 0)) (push (u32_le (if (eq code 65) 1 0)) (push (u32_le (if (eq code 65) 16 0))
          (push (u32_le 0) (push (u32_le 0) (push (u32_le 512) acc)))))))))

; A face at scale 2 whose regular glyphs, 32 tall, are blank but for A's
; top row.
(def face2_glyphs () UiFace
  (UiFace 2 ((MapEmpty (list int) UiCov)) (map_put (ui_strikes_none) "glyph.code.32" (strike_a 32))))

; A face at scale 1 whose regular glyphs, 16 tall, are blank but for A's
; top row.
(def face1_glyphs () UiFace
  (UiFace 1 ((MapEmpty (list int) UiCov)) (map_put (ui_strikes_none) "glyph.code.16" (strike_a 16))))

; Faces at scales 1 and 2 whose Source Sans 3 glyphs are blank but for
; A's top row, as face1_glyphs' Source Code Pro.
(def sans1_glyphs () UiFace
  (UiFace 1 ((MapEmpty (list int) UiCov)) (map_put (ui_strikes_none) "glyph.sans.16" (strike_a 16))))
(def sans2_glyphs () UiFace
  (UiFace 2 ((MapEmpty (list int) UiCov)) (map_put (ui_strikes_none) "glyph.sans.32" (strike_a 32))))

; "AA" in Source Sans 3: the second A's pen is the first's advance, 544
; units, 7.25 pixels at a line of 16, rounded 7; so its covered pixel is
; 7, and 8 is mixed, where in Source Code Pro's cells it is 8.
(def test_sans_text_by_advance () int
  (let c (ui_paint (canvas_new 32 16 0) (sans1_glyphs) (Rect 0 0 32 16)
                   (cons (UiPText (Rect 0 0 32 16) "AA" (UiStart) 16777215 (UiSans) false 1) (nil UiPaint)))
    (add (check_str "the second A" (px_at c 7 0) "ffffff")
         (add (check_str "mixed after it" (px_at c 8 0) (hex_digits (ui_mix 16777215 0 53) 6))
              (check_str "between them" (px_at c 3 0) "000000")))))

; At scale 2 the pen is placed in the screen's pixels: 544 units at a
; line of 32 are 14.51, rounded 15, not twice 7.
(def test_sans_text_at_2 () int
  (let c (ui_paint (canvas_new 64 32 0) (sans2_glyphs) (Rect 0 0 32 16)
                   (cons (UiPText (Rect 0 0 32 16) "AA" (UiStart) 16777215 (UiSans) false 1) (nil UiPaint)))
    (add (check_str "the second A" (px_at c 15 0) "ffffff")
         (check_str "not at 14" (px_at c 14 0) "000000"))))

; The face's Source Code Pro strike draws no Source Sans 3 text.
(def test_sans_not_mono () int
  (let c (ui_paint (canvas_new 16 16 0) (face1_glyphs) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 16 16) "A" (UiStart) 16777215 (UiSans) false 1) (nil UiPaint)))
    (check_str "untouched" (px_at c 0 0) "000000")))

; Text at scale 1 is drawn from the face's 8 by 16 glyphs the same way.
(def test_smooth_text_1x () int
  (let c (ui_paint (canvas_new 16 16 0) (face1_glyphs) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 8 16) "A" (UiStart) 16777215 (UiMono) false 1) (nil UiPaint)))
    (add (check_str "covered" (px_at c 0 0) "ffffff")
         (add (check_str "8 of 15 covered, mixed 53%" (px_at c 1 0) (hex_digits (ui_mix 16777215 0 53) 6))
              (check_str "not covered" (px_at c 2 0) "000000")))))

; A fill at scale 2 covers twice as much each way.
(def test_scaled_fill () int
  (let c (ui_paint (canvas_new 8 8 0) (face2_bare) (Rect 0 0 4 4) (cons (UiPFill (Rect 1 1 1 1) 16711680) (nil UiPaint)))
    (add (check_str "its top left" (px_at c 2 2) "ff0000")
         (add (check_str "its bottom right" (px_at c 3 3) "ff0000")
              (check_str "past it" (px_at c 4 4) "000000")))))

; The clip is the desktop's pixels too: a clip of 2 by 4 is the canvas's
; left half of 8 by 8.
(def test_scaled_clip () int
  (let c (ui_paint (canvas_new 8 8 0) (face2_bare) (Rect 0 0 2 4) (cons (UiPFill (Rect 0 0 4 4) 255) (nil UiPaint)))
    (add (check_str "inside the clip" (px_at c 3 7) "0000ff")
         (check_str "outside it" (px_at c 4 0) "000000"))))

; Text at scale 2 is drawn from the face's glyphs, each pixel mixed by its
; cover: A at 0, 0 of a 16 by 16 box, its cell 16 by 32 at 0, 0.
(def test_smooth_text () int
  (let c (ui_paint (canvas_new 32 32 0) (face2_glyphs) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 8 16) "A" (UiStart) 16777215 (UiMono) false 1) (nil UiPaint)))
    (add (check_str "covered" (px_at c 0 0) "ffffff")
         (add (check_str "8 of 15 covered, mixed 53%" (px_at c 1 0) (hex_digits (ui_mix 16777215 0 53) 6))
              (check_str "not covered" (px_at c 2 0) "000000")))))

; Without the face's glyphs, no text is drawn.
(def test_text_no_glyphs () int
  (let c (ui_paint (canvas_new 32 32 0) (face2_bare) (Rect 0 0 16 16)
                   (cons (UiPText (Rect 0 0 16 16) "A" (UiStart) 16777215 (UiMono) false 1) (nil UiPaint)))
    (check_str "untouched" (px_at c 6 16) "000000")))

; At the desktop's scale 2, an icon at its scale 1 is the table of 32,
; placed at twice its place.
(def test_icon_at_scale_2 () int
  (let c (ui_paint (canvas_new 64 64 0) (box_face 2) (Rect 0 0 32 32)
                   (cons (UiPIcon 2 0 "box" 16777215 1) (nil UiPaint)))
    (add (check_str "lit" (px_at c 11 7) "ffffff")
         (check_str "before it" (px_at c 3 0) "000000"))))

; A round at 2 has twice the radius: its corner's first row is cut as a
; radius of 20's is.
(def test_scaled_round () int
  (let c (ui_paint (canvas_new 40 40 0) (face2_bare) (Rect 0 0 20 20)
                   (cons (UiPRound (Rect 0 0 20 20) 10 16777215 0) (nil UiPaint)))
    (add (check_str "cut" (px_at c 0 0) "000000")
         (check_str "the middle" (px_at c 20 20) "ffffff"))))

; The pointer at 2 is the face's: each of its words a pixel, as it is.
(def test_cursor_from_face () int
  (let words (array_set (array_new (mul 64 64) 0) 65 4278190080)               ; ff000000 at 1, 1
    (let face (UiFace 2 (map_put ((MapEmpty (list int) UiCov)) "cursor" (UiCov 64 64 words)) (ui_strikes_none))
      (let c (ui_paint_cursor (canvas_new 64 64 0) face)
        (check_str "its pixel, alpha and all" (hex_digits (canvas_whole_pixel c 1 1) 8) "ff000000")))))

(def canvas_whole_pixel ((c Canvas) (x int) (y int)) int
  (match c ((Canvas fb w h top) 0) ((ArrayCanvas px w h top) (array_get px (add (mul y w) x)))))

; A drawing made from 0, 0 moved to 30, 40: each op's place, its size
; and the rest kept.
(def test_ops_offset () int
  (check_bool "moved"
    (eq (ui_ops_offset (cons (UiPRound (Rect 0 0 48 48) 10 255 -1) (cons (UiPIcon 8 8 "folder" 0 2) (nil UiPaint))) 30 40)
        (cons (UiPRound (Rect 30 40 48 48) 10 255 -1) (cons (UiPIcon 38 48 "folder" 0 2) (nil UiPaint))))
    true))

(def test_buffer_at () int
  (check_int "pages at 2" (buffer_pages (mul 640 2) (mul 400 2)) 1000))
