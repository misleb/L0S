(def rect_text ((r UiRect)) (list int)
  (match r ((UiRect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def test_ui_rect_clip () int
  (add (check_str "overlap" (rect_text (ui_rect_clip (UiRect 0 0 10 10) (UiRect 5 6 10 10))) "5,6 5x4")
       (check_bool "apart" (ui_rect_empty (ui_rect_clip (UiRect 0 0 10 10) (UiRect 20 0 5 5))) true)))

(def test_ui_rect_union () int
  (add (check_str "both" (rect_text (ui_rect_union (UiRect 0 0 10 10) (UiRect 20 5 5 10))) "0,0 25x15")
       (check_str "an empty one holds nothing" (rect_text (ui_rect_union (UiRect 0 0 0 0) (UiRect 3 4 5 6))) "3,4 5x6")))

(def test_ui_rect_has () int
  (add (check_bool "inside" (ui_rect_has (UiRect 10 10 5 5) 14 10) true)
       (add (check_bool "past the right" (ui_rect_has (UiRect 10 10 5 5) 15 10) false)
            (check_bool "above" (ui_rect_has (UiRect 10 10 5 5) 12 9) false))))

(def test_ui_rect_inset () int
  (add (check_str "by 2" (rect_text (ui_rect_inset (UiRect 0 0 10 8) 2)) "2,2 6x4")
       (check_str "not below nothing" (rect_text (ui_rect_inset (UiRect 0 0 2 2) 3)) "3,3 0x0")))

(def test_ui_text_w () int
  (add (check_int "plain" (ui_text_w "abc" false 1) 24)
       (add (check_int "bold" (ui_text_w "abc" true 1) 25)
            (check_int "twice the size" (ui_text_w "abc" false 2) 48))))

(def test_ui_ellipsized () int
  (add (check_str "fits" (ui_ellipsized "hello" 40 1) "hello")
       (add (check_str "cut" (ui_ellipsized "hello world" 64 1) "hello...")
            (check_str "no room for more than dots" (ui_ellipsized "hello" 16 1) ".."))))

(def test_ui_aligned () int
  (add (check_int "start" (ui_aligned 10 100 20 (UiStart)) 10)
       (add (check_int "center" (ui_aligned 10 100 20 (UiCenter)) 50)
            (check_int "end" (ui_aligned 10 100 20 (UiEnd)) 90))))

; A corner of 12: its top row cut 8 and 10/16 pixels in, its twelfth
; one sixteenth, and the row after it not at all.
(def test_ui_corner_inset () int
  (add (check_int "the top row" (ui_corner_inset16 12 0) 138)
       (add (check_int "the twelfth" (ui_corner_inset16 12 11) 1)
            (check_int "past the corner" (ui_corner_inset16 12 12) 0))))

; As the display's driver cuts a corner of 12: 9 6 5 4 3 2 1 1 1 0 0 0.
(def test_ui_corner_cut () int
  (add (check_int "the top row" (ui_corner_cut 12 0) 9)
       (add (check_int "the seventh" (ui_corner_cut 12 6) 1)
            (check_int "the tenth" (ui_corner_cut 12 9) 0))))

(def test_ui_row_inset () int
  (add (check_int "the bottom row as the top" (ui_row_inset16 12 40 39) (ui_row_inset16 12 40 0))
       (check_int "the middle" (ui_row_inset16 12 40 20) 0)))

(def test_ui_fit_radius () int
  (add (check_int "fits" (ui_fit_radius 6 100 34) 6)
       (check_int "a circle at most" (ui_fit_radius 20 24 24) 12)))

(def test_ui_arrow () int
  (add (check_int "17 rows" (length (ui_arrow_art)) 17)
       (check_str "its tip" (head (ui_arrow_art)) "W")))
