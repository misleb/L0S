; preview.l0 -- an app's views shown on the host, before any board boots:
; each a scene, a widget at a size, laid out, painted as ui_present paints
; a window's client area, in the dark style, with the board's own
; strikes and icons as the build made them, and written as a PNG. An
; app's preview.l0 is a main that calls ui_preview with its scenes, built
; from its own state, view and update, so a scene after a click is one
; more call of the update. make preview APP=NAME, and the builder's
; l0s-app-preview, build and run it. Linked by those and its test only.

; A scene: the file it is written as, NAME.png, and the widget, w by h.
(data UiShot (UiShot (name (list int)) (w int) (h int) (widget UiWidget)))

; The face a preview paints with, at scale 1: the icons of dir's
; icons.face at the sizes scale 1 paints, and the eight strikes of
; ui_text_names from dir/strikes, dir the build's directory. Whatever is
; missing is said on standard error and not drawn, as on the board.
(def ui_host_face ((dir (list int))) UiFace
  (UiFace 1
          (ui_face_file_tables (append dir "/icons.face") "no icons drawn" (ui_icon_sizes 1) ((MapEmpty (list int) UiCov)))
          (ui_host_strikes dir (ui_text_names 1) false (ui_strikes_none))))

; The strikes names put into ks, each read from its file under dir, as
; bytes; one that cannot be read left out, the first such said.
(def ui_host_strikes ((dir (list int)) (names (list (list int))) (said bool) (ks (Map (list int) UiStrike))) (Map (list int) UiStrike)
  (if (is_empty names)
      ks
      (let (n (head names) path (ui_strike_path dir n))
        (match (read_whole path)
          ((Ok b) (ui_host_strikes dir (tail names) said (map_put ks n (UiStrikeBytes b))))
          ((Err why)
            (let w (if said 0 (write_err (append path (append ": " (append why "; its text not drawn\n")))))
              (ui_host_strikes dir (tail names) true ks)))))))

; The file the build writes strike name in under dir: glyph.sans-bold.32
; is dir/strikes/sans-bold-32.strike.
(def ui_strike_path ((dir (list int)) (name (list int))) (list int)
  (append dir (append "/strikes/" (append (ui_strike_face name) (append "-" (append (digits (ui_strike_h name)) ".strike"))))))

; widget laid out at w by h and painted with face on a canvas of its own,
; as ui_present paints a window's client area: in the program's style,
; on the window's ground, nothing under the pointer or focused.
(def ui_shot_canvas ((face UiFace) (w int) (h int) (widget UiWidget)) Canvas
  (let st (ui_state_new (ui_style))
    (ui_paint_nodes (canvas_new w h (ui_window_bg (ui_style))) face (Rect 0 0 w h) (ui_layout_window widget w h st))))

; Canvas c, w by h, as a PNG's bytes.
(def ui_canvas_png ((c Canvas) (w int) (h int)) bytes
  (png_bytes w h (ui_canvas_rows c w (sub h 1) (nil bytes))))

; The rows of c from row y up to the first, in front of acc: so all of
; them, top first, from the last.
(def ui_canvas_rows ((c Canvas) (w int) (y int) (acc (list bytes))) (list bytes)
  (if (lt y 0)
      acc
      (ui_canvas_rows c w (sub y 1) (cons (png_row (ui_canvas_row c y (sub w 1) (nil int))) acc))))

; Row y's colors from column x down to the first, in front of acc.
(def ui_canvas_row ((c Canvas) (y int) (x int) (acc (list int))) (list int)
  (if (lt x 0) acc (ui_canvas_row c y (sub x 1) (cons (canvas_pixel c x y) acc))))

; Each scene painted with face and written to dir/NAME.png, its path
; said on standard output; 0, or 1 at the first that cannot be written,
; said as preview.
(def ui_shots ((dir (list int)) (face UiFace) (shots (list UiShot))) int
  (if (is_empty shots)
      0
      (match (head shots)
        ((UiShot name w h widget)
          (let (path (append dir (append "/" (append name ".png")))
                why (write_whole path (ui_canvas_png (ui_shot_canvas face w h widget) w h)))
            (if (is_empty why)
                (let s (say (append path "\n")) (ui_shots dir face (tail shots)))
                (complain_as "preview" (append path (append ": " why)))))))))

; A preview's main: shots written to the directory its first argument
; names (. for none), painted with the strikes and icons of the build
; directory its second names (build for none); its status.
(def ui_preview ((shots (list UiShot))) int
  (let (out (if (gt (arg_count) 0) (arg 0) ".")
        dir (if (gt (arg_count) 1) (arg 1) "build"))
    (ui_shots out (ui_host_face dir) shots)))
