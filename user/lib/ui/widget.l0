; widget.l0 -- widgets, laid out into what to paint. GTK's widgets, as few
; as a window of L0S needs, drawn as libadwaita draws them.
;
; L0 has no function values, so a widget cannot hold a callback. A widget
; that does something holds an action's name instead, as GTK's GActions
; are named, "win.close" or "grid.sort.2"; window.l0 says which action the
; pointer or the keyboard set off, and the program matches on its name.
; A program says what its window shows as a tree of UiWidget, made afresh
; from its state each time, as the Elm architecture has it:
;
;   view   state -> UiWidget
;   update state, action -> state
;
; ui_layout turns a tree into UiNodes: where each part is, the ops that
; paint it, already in the colors its state gives, and its action. Nodes
; come in the order they are painted, so the last a point is in is on top.
; What changed between two layouts is the nodes that differ, which is all
; that has to be painted again.

; Which way things go: across, UiH, or down, UiV.
(data UiOrient (UiH) (UiV))

; libadwaita's buttons: the plain one; flat, with no ground until the
; pointer is over it; suggested and destructive, in the accent and in
; red; circular; and a title bar's own, round and smaller.
(data UiButtonKind (UiBtnRegular) (UiBtnFlat) (UiBtnSuggested) (UiBtnDestructive) (UiBtnCircular) (UiBtnTitle))

; Text: body, dimmed, a heading in bold, and a page's title, bold and
; twice the size.
(data UiLabelKind (UiBody) (UiDimmed) (UiHeading) (UiLarge))

; What a status says: nothing in particular, the accent, good, a
; warning, an error.
(data UiTone (UiNeutral) (UiAccentTone) (UiGood) (UiWarn) (UiBad))

; A widget, what a window shows, made afresh from the program's state:
; each kind, and what its fields are, beside it.
(data UiWidget
  (UiLabel (list int) UiLabelKind UiAlign)              ; text, kind, along its space
  (UiButton (list int) (list int) (list int) UiButtonKind bool) ; action, icon or "", label or "", kind, sensitive
  (UiBox UiOrient int (list UiWidget))                  ; children in a row or a column, spaced
  (UiExpand UiWidget)                                    ; a box child given the box's room to spare
  (UiPad int int UiWidget)                               ; space left and right, above and below
  (UiSeparator UiOrient)                                 ; a line across, UiH, or up and down, UiV
  (UiHeaderBar (list UiWidget) (list int) (list UiWidget)) ; at its start, its title, at its end
  (UiView UiWidget)                                      ; on a view's ground, as lists and grids are
  (UiLevel int int)                                      ; a level bar: percent, width
  (UiStatus UiTone (list int))                           ; a colored dot, and text
  (UiStatusPage (list int) (list int) (list int))        ; an empty page's icon, title, and description
  (UiGrid UiGridView)                                    ; a data grid, grid.l0
  (UiSpace int int)                                      ; room, w by h, with nothing in it
  (UiSidebar int (list UiSideRow) (list int) (list int)) ; a sidebar, panes.l0: width, rows, prefix, the selected key
  (UiSegmentBar (list int) (list UiSegment) (list int) int) ; a whole in parts by weight: prefix or "" for none chosen, its parts, the selected key, height
  (UiProps (list UiProp))                                ; rows of properties, a name before each value
  (UiModal UiWidget UiWidget)                            ; a window's content, and an alert dialog over it
  (UiEntry (list int) UiEntryText (list int) int)        ; a text entry, entry.l0: name, text, placeholder, width
  (UiCsdBar (list UiWidget) UiWidget (list UiWidget) bool) ; a window's own header bar: at its start, its title widget, at its end, and whether the close button ends it
  (UiPathBar (list int) (list (list int)))               ; a path bar, nav.l0: prefix, each directory's label, the first first
  (UiToggleGroup (list int) (list UiToggle) (list int))  ; a toggle group, nav.l0: prefix, its toggles, the active one's key
  (UiIconView UiIconData)                                ; an icon view, icon_view.l0
  (UiPopover UiWidget UiMenu)                            ; a window's content, and a popover menu over it, menu.l0
  (UiDrawingArea (list int) int int)                     ; an area the program paints itself, as GtkDrawingArea: its name, and the size it asks for
  (UiTabBar (list int) (list UiTab) (list int))          ; a tab bar, nav.l0: prefix, its tabs, the selected one's key
  (UiText (list int) UiFont UiAlign)                     ; text in a face the program names, in the text's color, along its space
  (UiKeyed (list int) UiWidget))                         ; a part keyed by what it shows: its layout kept while the key, its place and its look's state are the same

; What the widgets' look depends on beyond themselves: the action the
; pointer is over, the one pressed, the one with the keyboard's focus,
; whether the window is in the backdrop, not in front, and the style;
; and, while a window is laid out, the parts of its last layout keyed
; by a value (UiKeyed), which it may keep, empty otherwise.
(data UiState (UiState (hover (list int)) (pressed (list int)) (focus (list int)) (backdrop bool) (style UiStyle) (kept (Map (list int) UiKept))))

; A state at first, in style s: nothing under the pointer, pressed or
; focused, and in front.
(def ui_state_new ((s UiStyle)) UiState (UiState "" "" "" false s (ui_kept_none)))

; ----------------------------------------------------------- keyed parts

; A part of a layout kept by its key: where it was laid out, what it
; was laid out against (ui_key_sig), and its nodes, in the order they
; are painted.
(data UiKept (UiKept Rect int (list UiNode)))

; None kept.
(def ui_kept_none () (Map (list int) UiKept) ((MapEmpty (list int) UiKept)))

; What a keyed part's look depends on beyond its key and its place, as
; one number: the ground it is laid on, whether the window is in the
; backdrop, the style, and the actions under the pointer, pressed and
; focused, each only if it is one of the part's nodes', ns, so that the
; pointer over anything else changes nothing.
(def ui_key_sig ((st UiState) (bg int) (ns (list UiNode))) int
  (match st
    ((UiState h p f b s k)
      (hash (UiKeySig bg b s (ui_action_in h ns) (ui_action_in p ns) (ui_action_in f ns))))))

; What ui_key_sig hashes.
(data UiKeySig (UiKeySig int bool UiStyle (list int) (list int) (list int)))

; a, if it is the action of one of ns, else "".
(def ui_action_in ((a (list int)) (ns (list UiNode))) (list int)
  (if (is_empty a) "" (ui_has_action ns a) a ""))

; Whether one of ns has action a.
(def ui_has_action ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (eq (.action (head ns)) a) true (ui_has_action (tail ns) a)))

; The node that marks a keyed part's nodes in a layout, before them: no
; place, so nothing hits it and nothing paints it, and its action
; ui.kept.N.X.Y.W.H.SIG.KEY, the count of the part's nodes, where it was
; laid out, its ui_key_sig, and its key.
(def ui_kept_mark ((key (list int)) (r Rect) (sig int) (n int)) UiNode
  (UiNode (Rect 0 0 0 0) (nil UiPaint)
    (append "ui.kept." (append (digits n) (append "." (append (ui_rect_words r) (append "." (append (digits sig) (append "." key)))))))
    false))

; r as X.Y.W.H, each a whole number, x and y at least 0.
(def ui_rect_words ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits (max 0 x)) (append "." (append (digits (max 0 y)) (append "." (append (digits w) (append "." (digits h))))))))))

; The keyed parts of ns, the nodes of a layout in the order they are
; painted, by their keys: each mark's next N nodes, laid out where it
; says, against its sig. A part inside another is kept too.
(def ui_kept_of ((ns (list UiNode))) (Map (list int) UiKept)
  (ui_kept_onto ns (ui_kept_none)))

; ui_kept_of's loop, onto m.
(def ui_kept_onto ((ns (list UiNode)) (m (Map (list int) UiKept))) (Map (list int) UiKept)
  (if (is_empty ns)
      m
      (let a (.action (head ns))
        (if (not (starts_with a "ui.kept."))
            (ui_kept_onto (tail ns) m)
            (let ws (split_on 46 (drop_n a 8))
              (if (lt (length ws) 7)
                  (ui_kept_onto (tail ns) m)
                  (let n (int_prefix (nth ws 0) 0)
                    (ui_kept_onto (tail ns)
                      (map_put m (join_with "." (drop ws 6))
                        (UiKept (Rect (int_prefix (nth ws 1) 0) (int_prefix (nth ws 2) 0) (int_prefix (nth ws 3) 0) (int_prefix (nth ws 4) 0))
                                (int_prefix (nth ws 5) 0) (take (tail ns) n)))))))))))

; The nodes of child, a part keyed key, laid out in r on bg, onto acc
; after its mark: those st keeps of the last layout, if it laid out key
; in r against what it would be laid out against now; else laid out.
(def ui_keyed_lay ((key (list int)) (child UiWidget) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (match (map_get (.kept st) key)
    ((Some k)
      (match k
        ((UiKept kr sig ns)
          (if (and (eq kr r) (eq sig (ui_key_sig st bg ns)))
              (rev_onto ns (cons (ui_kept_mark key r sig (length ns)) acc))
              (ui_keyed_fresh key child r st bg acc)))))
    ((None) (ui_keyed_fresh key child r st bg acc))))

; w as a part keyed by itself, name and its hash: kept while it is the
; same, as a grid whose rows and state are what they were. Hashing it
; reads all of it, so key a part holding images by what it shows
; instead, a cheaper value (UiKeyed itself).
(def ui_keyed_self ((name (list int)) (w UiWidget)) UiWidget
  (UiKeyed (append name (append "." (digits (hash w)))) w))

; child laid out afresh as a part keyed key, its mark first.
(def ui_keyed_fresh ((key (list int)) (child UiWidget) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (let (laid (ui_lay child r st bg (nil UiNode))
        ns (rev laid))
    (rev_onto ns (cons (ui_kept_mark key r (ui_key_sig st bg ns) (length ns)) acc))))

; A part of a window laid out: where it is, the ops that paint it, its
; action or "", and whether the keyboard's focus can be on it.
(data UiNode (UiNode (rect Rect) (ops (list UiPaint)) (action (list int)) (f bool)))

; A size a widget asks for, its width sw and height sh, in pixels.
(data UiSize (UiSize (sw int) (sh int)))

; ------------------------------------------------------------------- sizes

; Whether a label of kind k is bold: a heading and a page's title are.
(def ui_label_bold ((k UiLabelKind)) bool
  (match k ((UiBody) false) ((UiDimmed) false) ((UiHeading) true) ((UiLarge) true)))

; The scale a label of kind k's text is drawn at: 2 for a page's title,
; else 1.
(def ui_label_scale ((k UiLabelKind)) int
  (match k ((UiBody) 1) ((UiDimmed) 1) ((UiHeading) 1) ((UiLarge) 2)))

; The size a widget asks for: its natural size.
(def ui_measure ((w UiWidget)) UiSize
  (match w
    ((UiLabel s k a) (UiSize (ui_text_w s (ui_text_font) (ui_label_bold k) (ui_label_scale k)) (mul (ui_char_h) (ui_label_scale k))))
    ((UiButton action icon label k sensitive) (ui_button_size icon label k))
    ((UiBox o sp cs) (ui_box_size o sp cs))
    ((UiExpand c) (ui_measure c))
    ((UiPad px py c) (match (ui_measure c) ((UiSize cw ch) (UiSize (add cw (mul 2 px)) (add ch (mul 2 py))))))
    ((UiSeparator o) (match o ((UiH) (UiSize 0 1)) ((UiV) (UiSize 1 0))))
    ((UiHeaderBar st title en)
      (UiSize (add (ui_row_w st) (add (ui_text_w title (ui_text_font) true 1) (add (ui_row_w en) (mul 4 (ui_space_s))))) (ui_headerbar_h)))
    ((UiView c) (ui_measure c))
    ((UiLevel pct lw) (UiSize lw 8))
    ((UiStatus tone s) (UiSize (add 14 (ui_text_w s (ui_text_font) false 1)) (ui_char_h)))
    ((UiStatusPage icon title d)
      (UiSize (max 64 (max (ui_text_w title (ui_text_font) true 2) (ui_text_w d (ui_text_font) false 1))) (ui_status_page_h)))
    ((UiGrid g) (ui_grid_measure g))
    ((UiSpace sw sh) (UiSize sw sh))
    ((UiSidebar sw rows prefix sel) (ui_sidebar_size sw rows))
    ((UiSegmentBar prefix segs sel h) (ui_segbar_size segs h))
    ((UiProps ps) (ui_props_size ps))
    ((UiModal base alert) (ui_measure base))
    ((UiEntry name t placeholder ew) (ui_entry_size ew))
    ((UiCsdBar st title en closes) (ui_csd_size st title en closes))
    ((UiPathBar prefix labels) (ui_pathbar_size labels))
    ((UiToggleGroup prefix ts sel) (ui_toggles_size ts))
    ((UiIconView d) (ui_icon_size_of d))
    ((UiPopover base menu) (ui_measure base))
    ((UiDrawingArea name dw dh) (UiSize dw dh))
    ((UiTabBar prefix ts sel) (ui_tabbar_size ts))
    ((UiText s f a) (UiSize (ui_text_w s f false 1) (ui_font_line f 1)))
    ((UiKeyed key c) (ui_measure c))))

; A status page's height: its icon, 64, then 12, its title, 32, then 6,
; and its line of text.
(def ui_status_page_h () int (add 64 (add (ui_space_m) (add 32 (add (ui_space_s) (ui_char_h))))))

; A button's natural size: a title bar's 24 square, a circular one 34
; square, and the rest as ui_button_box says.
(def ui_button_size ((icon (list int)) (label (list int)) (k UiButtonKind)) UiSize
  (match k
    ((UiBtnTitle) (UiSize (ui_titlebutton) (ui_titlebutton)))
    ((UiBtnCircular) (UiSize (ui_button_h) (ui_button_h)))
    ((UiBtnRegular) (ui_button_box icon label))
    ((UiBtnFlat) (ui_button_box icon label))
    ((UiBtnSuggested) (ui_button_box icon label))
    ((UiBtnDestructive) (ui_button_box icon label))))

; A button with text is the text and 10 either side; with an icon alone,
; square.
(def ui_button_box ((icon (list int)) (label (list int))) UiSize
  (if (is_empty label)
      (UiSize (ui_button_h) (ui_button_h))
      (UiSize (max (ui_button_h) (add (ui_content_w icon label) (mul 2 (ui_button_pad)))) (ui_button_h))))

; An icon, then 6, then the label: how wide that is.
(def ui_content_w ((icon (list int)) (label (list int))) int
  (add (if (is_empty icon) 0 (ui_icon_size))
       (add (if (or (is_empty icon) (is_empty label)) 0 (ui_space_s)) (ui_text_w label (ui_text_font) false 1))))

; A row of widgets 6 apart, as a header bar packs them.
(def ui_row_w ((ws (list UiWidget))) int (.sw (ui_box_size (UiH) (ui_space_s) ws)))

; A box's natural size: along it, its children's sizes and sp between
; each two; across it, the largest of them.
(def ui_box_size ((o UiOrient) (sp int) (cs (list UiWidget))) UiSize
  (ui_box_size_onto o sp cs 0 0 true))

; ui_box_size's loop: along and across, so far, before the children cs;
; first while none has been counted.
(def ui_box_size_onto ((o UiOrient) (sp int) (cs (list UiWidget)) (along int) (across int) (first bool)) UiSize
  (if (is_empty cs)
      (match o ((UiH) (UiSize along across)) ((UiV) (UiSize across along)))
      (let (s (ui_measure (head cs))
            a (match o ((UiH) (.sw s)) ((UiV) (.sh s)))
            c (match o ((UiH) (.sh s)) ((UiV) (.sw s))))
        (ui_box_size_onto o sp (tail cs) (add along (add a (if first 0 sp))) (max across c) false))))

; ------------------------------------------------------------------ layout

; The nodes of w laid out in r, in the order they are painted, on a
; ground of color bg.
(def ui_layout ((w UiWidget) (r Rect) (st UiState) (bg int)) (list UiNode)
  (rev (ui_lay w r st bg (nil UiNode))))

; A window's nodes: its ground, then w over all of it.
(def ui_layout_window ((w UiWidget) (width int) (height int) (st UiState)) (list UiNode)
  (let (r (Rect 0 0 width height)
        bg (ui_window_bg (.style st)))
    (rev (ui_lay w r st bg (cons (UiNode r (cons (UiPFill r bg) (nil UiPaint)) "" false) (nil UiNode))))))

; A node in r painted with ops, with no action and no focus, onto acc.
(def ui_leaf ((r Rect) (ops (list UiPaint)) (acc (list UiNode))) (list UiNode)
  (cons (UiNode r ops "" false) acc))

; ui_layout's work: the nodes of w laid out in r, onto acc, the last
; painted first; each kind of widget by its own layout.
(def ui_lay ((w UiWidget) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (match w
    ((UiLabel s k a) (ui_leaf r (cons (UiPText r s a (ui_label_color k st bg) (ui_text_font) (ui_label_bold k) (ui_label_scale k)) (nil UiPaint)) acc))
    ((UiButton action icon label k sensitive) (cons (ui_button_node r action icon label k sensitive st bg) acc))
    ((UiBox o sp cs) (ui_box_lay o sp cs r st bg acc))
    ((UiExpand c) (ui_lay c r st bg acc))
    ((UiPad px py c)
      (match r ((Rect x y rw rh) (ui_lay c (Rect (add x px) (add y py) (max 0 (sub rw (mul 2 px))) (max 0 (sub rh (mul 2 py)))) st bg acc))))
    ((UiSeparator o) (ui_leaf r (cons (UiPFill r (ui_border (.style st) bg)) (nil UiPaint)) acc))
    ((UiHeaderBar start title en) (ui_headerbar_lay start title en r st acc))
    ((UiView c)
      (let vbg (ui_view_bg (.style st))
        (ui_lay c r st vbg (ui_leaf r (cons (UiPFill r vbg) (nil UiPaint)) acc))))
    ((UiLevel pct lw) (ui_leaf r (ui_level_ops r pct st bg) acc))
    ((UiStatus tone s) (ui_leaf r (ui_status_ops r tone s st bg) acc))
    ((UiStatusPage icon title d) (ui_leaf r (ui_status_page_ops r icon title d st bg) acc))
    ((UiGrid g) (ui_grid_lay g r st acc))
    ((UiSpace sw sh) acc)
    ((UiSidebar sw rows prefix sel) (ui_sidebar_lay rows prefix sel r st acc))
    ((UiSegmentBar prefix segs sel h) (ui_segbar_lay prefix segs sel h r st bg acc))
    ((UiProps ps) (ui_props_lay ps r st bg acc))
    ((UiModal base alert) (ui_modal_lay base alert r st bg acc))
    ((UiEntry name t placeholder ew) (cons (ui_entry_node r name t placeholder st bg) acc))
    ((UiCsdBar start title en closes) (ui_csd_lay start title (ui_csd_end en closes) r st acc))
    ((UiPathBar prefix labels) (ui_pathbar_lay prefix labels r st bg acc))
    ((UiToggleGroup prefix ts sel) (ui_toggles_lay prefix ts sel r st bg acc))
    ((UiIconView d) (ui_icon_lay d r st acc))
    ((UiPopover base menu) (ui_popover_lay base menu r st bg acc))
    ((UiDrawingArea name dw dh) (cons (UiNode r (nil UiPaint) (ui_drawing_action name) false) acc))
    ((UiTabBar prefix ts sel) (ui_tabbar_lay prefix ts sel r st acc))
    ((UiText s f a) (ui_leaf r (cons (UiPText r s a (ui_fg (.style st)) f false 1) (nil UiPaint)) acc))
    ((UiKeyed key c) (ui_keyed_lay key c r st bg acc))))

; The action of a drawing area's node, NAME.drawing: a press there sets
; it off, and ui_drawn says which nodes are the program's to paint.
(def ui_drawing_action ((name (list int))) (list int) (append name ".drawing"))

; The rectangles of ns that drawing areas hold, which the window leaves
; to its program to paint: nothing of the toolkit's is painted there, not
; even the window's ground.
(def ui_drawn ((ns (list UiNode))) (list Rect) (ui_drawn_onto ns (nil Rect)))

; ui_drawn's loop, onto acc.
(def ui_drawn_onto ((ns (list UiNode)) (acc (list Rect))) (list Rect)
  (if (is_empty ns)
      acc
      (match (head ns)
        ((UiNode r ops a f) (ui_drawn_onto (tail ns) (if (ends_with a ".drawing") (cons r acc) acc))))))

; The rectangle of the drawing area called name in ns, if it is laid out.
(def ui_drawing_rect ((ns (list UiNode)) (name (list int))) (Option Rect)
  (match (ui_node_with_last ns (ui_drawing_action name)) ((None) ((None Rect))) ((Some n) (Some (.rect n)))))

; The last node of ns whose action is a, if one is.
(def ui_node_with_last ((ns (list UiNode)) (a (list int))) (Option UiNode)
  (if (is_empty ns)
      ((None UiNode))
      (match (ui_node_with_last (tail ns) a)
        ((Some n) (Some n))
        ((None) (if (eq (.action (head ns)) a) (Some (head ns)) ((None UiNode)))))))

; A label's text color on bg: dimmed for a dimmed one, else the text's.
(def ui_label_color ((k UiLabelKind) (st UiState) (bg int)) int
  (match k
    ((UiBody) (ui_fg (.style st)))
    ((UiDimmed) (ui_dim_fg (.style st) bg))
    ((UiHeading) (ui_fg (.style st)))
    ((UiLarge) (ui_fg (.style st)))))

; ------------------------------------------------------------------ boxes

; Children along r, each its natural size, those in UiExpand sharing what
; is left over equally, the last of them the remainder; across r, all of
; it.
(def ui_box_lay ((o UiOrient) (sp int) (cs (list UiWidget)) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (let (room (match o ((UiH) (.w r)) ((UiV) (.h r)))
        want (match (ui_box_size o sp cs) ((UiSize bw bh) (match o ((UiH) bw) ((UiV) bh)))))
    (ui_box_children o sp cs r st bg (max 0 (sub room want)) (ui_expanders cs 0) 0
                     (match o ((UiH) (.x r)) ((UiV) (.y r))) acc)))

; How many of cs are in UiExpand, after n.
(def ui_expanders ((cs (list UiWidget)) (n int)) int
  (if (is_empty cs) n (ui_expanders (tail cs) (if (ui_is_expand (head cs)) (add n 1) n))))

; Whether w is a UiExpand.
(def ui_is_expand ((w UiWidget)) bool
  (match w
    ((UiExpand c) true)
    ((UiLabel s k a) false) ((UiButton a i l k s) false) ((UiBox o sp cs) false) ((UiPad px py c) false)
    ((UiSeparator o) false) ((UiHeaderBar s t e) false) ((UiView c) false) ((UiLevel p w) false)
    ((UiStatus t s) false) ((UiStatusPage i t d) false) ((UiGrid g) false) ((UiSpace w h) false)
    ((UiSidebar w rs p k) false) ((UiSegmentBar p ss k h) false) ((UiProps ps) false) ((UiModal b a) false)
    ((UiEntry n t p w) false) ((UiCsdBar s t e c) false) ((UiPathBar p ls) false) ((UiToggleGroup p ts k) false)
    ((UiIconView d) false) ((UiPopover b m) false) ((UiDrawingArea n w h) false) ((UiTabBar p ts k) false)
    ((UiText s f a) false) ((UiKeyed key c) false)))

; What the seen-th of n expanders gets of extra.
(def ui_share ((extra int) (n int) (seen int)) int
  (if (eq n 0) 0 (eq seen (sub n 1)) (sub extra (mul (div extra n) (sub n 1))) (div extra n)))

; ui_box_lay's loop: each child from at along r, its natural length and,
; for the seen-th of n expanders, its share of extra, then sp; laid out
; onto acc.
(def ui_box_children ((o UiOrient) (sp int) (cs (list UiWidget)) (r Rect) (st UiState) (bg int)
                      (extra int) (n int) (seen int) (at int) (acc (list UiNode))) (list UiNode)
  (if (is_empty cs)
      acc
      (let (c (head cs)
            s (ui_measure c)
            grow (if (ui_is_expand c) (ui_share extra n seen) 0)
            len (add grow (match o ((UiH) (.sw s)) ((UiV) (.sh s))))
            cr (match o ((UiH) (Rect at (.y r) len (.h r))) ((UiV) (Rect (.x r) at (.w r) len))))
        (ui_box_children o sp (tail cs) r st bg extra n (if (ui_is_expand c) (add seen 1) seen)
                         (add at (add len sp)) (ui_lay c cr st bg acc)))))

; ---------------------------------------------------------------- buttons

; A button's ground and ink, or -1 for no ground.
(data UiInk (UiInk int int))

; A button of kind k's ground and ink on bg, at rest, under the pointer,
; or pressed: a plain one the text's color at 10, 15 and 30% over bg; a
; flat one no ground at rest, then 7 and 16%; a suggested or destructive
; one its color, lighter or darker, with white on it.
(def ui_button_ink ((k UiButtonKind) (hover bool) (pressed bool) (st UiState) (bg int)) UiInk
  (let (fg (ui_fg (.style st))
        level (if pressed 2 hover 1 0))
    (match k
      ((UiBtnRegular) (UiInk (ui_mix fg bg (ui_pick level 10 15 30)) fg))
      ((UiBtnCircular) (UiInk (ui_mix fg bg (ui_pick level 10 15 30)) fg))
      ((UiBtnTitle) (UiInk (ui_mix fg bg (ui_pick level 10 15 30)) fg))
      ((UiBtnFlat) (UiInk (if (eq level 0) -1 (ui_mix fg bg (ui_pick level 0 7 16))) fg))
      ((UiBtnSuggested) (UiInk (ui_strong (ui_accent_bg) level) (ui_accent_fg)))
      ((UiBtnDestructive) (UiInk (ui_strong (ui_destructive_bg) level) (ui_white))))))

; a at level 0, b at 1, and c at any other.
(def ui_pick ((level int) (a int) (b int) (c int)) int (if (eq level 0) a (eq level 1) b c))

; A colored button's ground: lighter under the pointer, darker pressed.
(def ui_strong ((c int) (level int)) int
  (if (eq level 0) c (eq level 1) (ui_mix (ui_white) c 10) (ui_mix (ui_black) c 20)))

; A button's corners, h tall: round, half h, for a title bar's or a
; circular one, else the theme's button radius.
(def ui_button_radius_of ((k UiButtonKind) (h int)) int
  (match k
    ((UiBtnTitle) (div h 2)) ((UiBtnCircular) (div h 2))
    ((UiBtnRegular) (ui_button_radius)) ((UiBtnFlat) (ui_button_radius))
    ((UiBtnSuggested) (ui_button_radius)) ((UiBtnDestructive) (ui_button_radius))))

; A button laid out in r: centered in it at its natural size, its ground,
; the focus ring if the keyboard's focus is on it, its icon and label.
; One that is not sensitive is drawn at half, and has no action.
(def ui_button_node ((r Rect) (action (list int)) (icon (list int)) (label (list int)) (k UiButtonKind)
                     (sensitive bool) (st UiState) (bg int)) UiNode
  (let (s (ui_button_size icon label k)
        b (Rect (ui_aligned (.x r) (.w r) (min (.w r) (.sw s)) (UiCenter))
                (ui_aligned (.y r) (.h r) (min (.h r) (.sh s)) (UiCenter))
                (min (.w r) (.sw s)) (min (.h r) (.sh s)))
        live (and sensitive (not (is_empty action)))
        ink (ui_button_ink k (and live (eq (.hover st) action))
                             (and live (eq (.pressed st) action)) st bg))
    (UiNode b (ui_button_ops b icon label k (ui_faded ink sensitive bg)
                             (and live (eq (.focus st) action)) bg)
            (if live action "") live)))

; ink at half, for a button that is not sensitive: the whole button at
; half its opacity over bg, as GTK draws one, its ground and its label
; each mixed with bg. Mixing the label with the button's own ground
; instead would leave it all but the ground's color.
(def ui_faded ((ink UiInk) (sensitive bool) (bg int)) UiInk
  (if sensitive
      ink
      (match ink ((UiInk g f) (UiInk (if (lt g 0) -1 (ui_mix g bg 50)) (ui_mix f bg 50))))))

; A button's ops in b: focused, the ring, then its ground 2 inside it;
; else its ground, if it has one; then its icon and label in the ink.
(def ui_button_ops ((b Rect) (icon (list int)) (label (list int)) (k UiButtonKind) (ink UiInk) (focused bool) (bg int)) (list UiPaint)
  (match ink
    ((UiInk ground fg)
      (let (rad (ui_button_radius_of k (.h b))
            face (if (lt ground 0) bg ground)
            base (if focused
                     (cons (UiPRound b rad (ui_focus_ring bg) bg)
                           (cons (UiPRound (rect_inset b 2) (max 0 (sub rad 2)) face (ui_focus_ring bg)) (nil UiPaint)))
                     (lt ground 0) (nil UiPaint)
                     (cons (UiPRound b rad ground bg) (nil UiPaint))))
        (append base (ui_content_ops b icon label fg))))))

; An icon and a label, side by side in the middle of b.
(def ui_content_ops ((b Rect) (icon (list int)) (label (list int)) (fg int)) (list UiPaint)
  (let (x (ui_aligned (.x b) (.w b) (ui_content_w icon label) (UiCenter))
        iy (ui_aligned (.y b) (.h b) (ui_icon_size) (UiCenter))
        lx (if (is_empty icon) x (add x (add (ui_icon_size) (ui_space_s))))
        ops (if (is_empty label)
                (nil UiPaint)
                (cons (UiPText (Rect lx (.y b) (max 0 (sub (add (.x b) (.w b)) lx)) (.h b)) label (UiStart) fg (ui_text_font) false 1)
                      (nil UiPaint))))
    (if (is_empty icon) ops (cons (UiPIcon x iy icon fg 1) ops))))

; ------------------------------------------------------------- header bars

; A header bar across r: its ground and the line under it; its start's
; widgets from the left, its end's to the right, each 6 apart and 6 in
; from the edges, in the middle up and down; its title, bold, in the
; middle of the bar if there is room, and else between the two. In the
; backdrop it is lighter and its title dimmed.
(def ui_headerbar_lay ((start (list UiWidget)) (title (list int)) (en (list UiWidget)) (r Rect) (st UiState) (acc (list UiNode))) (list UiNode)
  (match r
    ((Rect x y w h)
      (let (active (not (.backdrop st))
            s (.style st)
            hbg (ui_headerbar_bg s active)
            ground (ui_leaf r (ui_headerbar_ground r st) acc)
            sw (ui_row_w start)
            ew (ui_row_w en)
            left (add x (ui_space_s))
            right (sub (add x w) (add (ui_space_s) ew))
            a1 (ui_box_lay (UiH) (ui_space_s) start (Rect left y sw (sub h 1)) st hbg ground)
            a2 (ui_box_lay (UiH) (ui_space_s) en (Rect right y ew (sub h 1)) st hbg a1))
        (ui_title_node title (if (is_empty start) left (add left (add sw (ui_space_s))))
                       (if (is_empty en) (add x (sub w (ui_space_s))) (sub right (ui_space_s)))
                       r (ui_headerbar_fg s active) a2)))))

; A header bar's ground in r: its color, in front or in the backdrop, and
; the shade along its foot.
(def ui_headerbar_ground ((r Rect) (st UiState)) (list UiPaint)
  (match r
    ((Rect x y w h)
      (let (active (not (.backdrop st))
            s (.style st))
        (cons (UiPFill (Rect x y w (sub h 1)) (ui_headerbar_bg s active))
              (cons (UiPFill (Rect x (sub (add y h) 1) w 1) (ui_headerbar_shade s active)) (nil UiPaint)))))))

; --------------------------------------------------------- csd header bars

; A window's own header bar, libadwaita's AdwHeaderBar in a window that
; draws its own title bar (window.l0's ui_open_csd): what it holds at its
; start, a title widget, any widget, in its middle, and what it holds at
; its end, then the window's close button if it has one. Its ground is
; the window's to drag, its action ui_move_action, which window.l0 turns
; into the compositor's move as it is pressed; the close button sets off
; ui_close_action, which the program answers by closing.

; The actions of a header bar's ground, and of its close button.
(def ui_move_action () (list int) "win.move")
(def ui_close_action () (list int) "win.close")

; What a header bar holds at its end: en, and the close button after it
; if closes.
(def ui_csd_end ((en (list UiWidget)) (closes bool)) (list UiWidget)
  (if closes
      (append en (cons (UiButton (ui_close_action) "window-close" "" (UiBtnTitle) true) (nil UiWidget)))
      en))

; Its size: its start, title and end in a row, 6 apart and 6 in from
; each side, and a header bar high.
(def ui_csd_size ((start (list UiWidget)) (title UiWidget) (en (list UiWidget)) (closes bool)) UiSize
  (UiSize (add (ui_row_w start) (add (.sw (ui_measure title)) (add (ui_row_w (ui_csd_end en closes)) (mul 4 (ui_space_s)))))
          (ui_headerbar_h)))

; A header bar in r: its ground, which drags the window, then its start
; packed from the left and its end from the right, 6 in, and the title
; widget its natural width in the middle of the bar, or as near it as the
; room between them lets it be, cut to that room.
(def ui_csd_lay ((start (list UiWidget)) (title UiWidget) (en (list UiWidget)) (r Rect) (st UiState) (acc (list UiNode))) (list UiNode)
  (match r
    ((Rect x y w h)
      (let (hbg (ui_headerbar_bg (.style st) (not (.backdrop st)))
            ground (cons (UiNode r (ui_headerbar_ground r st) (ui_move_action) false) acc)
            sw (ui_row_w start)
            ew (ui_row_w en)
            left (add x (ui_space_s))
            right (sub (add x w) (add (ui_space_s) ew))
            a1 (ui_box_lay (UiH) (ui_space_s) start (Rect left y sw (sub h 1)) st hbg ground)
            a2 (ui_box_lay (UiH) (ui_space_s) en (Rect right y ew (sub h 1)) st hbg a1))
        (ui_lay title (ui_csd_title_rect (.sw (ui_measure title)) (if (is_empty start) left (add left (add sw (ui_space_s))))
                                         (if (is_empty en) (add x (sub w (ui_space_s))) (sub right (ui_space_s)))
                                         x w y (sub h 1))
                st hbg a2)))))

; Where a title widget tw wide goes in a bar from x, w wide, between lo
; and hi: centered on the bar, moved to stay between them, and no wider
; than they are apart.
(def ui_csd_title_rect ((tw int) (lo int) (hi int) (x int) (w int) (y int) (h int)) Rect
  (let (room (max 0 (sub hi lo))
        cw (min tw room))
    (Rect (max lo (min (sub hi cw) (add x (div (sub w cw) 2)))) y cw h)))

; The title between from and to, in the middle of r if it fits there.
(def ui_title_node ((title (list int)) (from int) (to int) (r Rect) (fg int) (acc (list UiNode))) (list UiNode)
  (if (is_empty title)
      acc
      (let (room (max 0 (sub to from))
            tw (min room (ui_text_w title (ui_text_font) true 1))
            x (max from (min (sub to tw) (ui_aligned (.x r) (.w r) tw (UiCenter))))
            tr (Rect x (.y r) tw (sub (.h r) 1)))
        (ui_leaf tr (cons (UiPText tr title (UiCenter) fg (ui_text_font) true 1) (nil UiPaint)) acc))))

; ---------------------------------------------------------- small widgets

; A level bar: a trough 8 high in the middle of r, filled pct of the way
; in the accent; any fill at all at least as wide as it is high, round.
(def ui_level_ops ((r Rect) (pct int) (st UiState) (bg int)) (list UiPaint)
  (let (t (Rect (.x r) (ui_aligned (.y r) (.h r) 8 (UiCenter)) (.w r) 8)
        fw (if (le pct 0) 0 (min (.w r) (max 8 (div (mul (.w r) (min 100 pct)) 100))))
        trough (ui_mix (ui_fg (.style st)) bg 10))
    (cons (UiPRound t 4 trough bg)
          (if (eq fw 0) (nil UiPaint)
              (cons (UiPRound (Rect (.x t) (.y t) fw 8) 4 (ui_accent_bg) trough) (nil UiPaint))))))

; A tone's color on bg: neutral the dimmed text's, the accent, and the
; theme's success, warning and error.
(def ui_tone_color ((tone UiTone) (st UiState) (bg int)) int
  (match tone
    ((UiNeutral) (ui_dim_fg (.style st) bg))
    ((UiAccentTone) (ui_accent_bg))
    ((UiGood) (ui_success))
    ((UiWarn) (ui_warning))
    ((UiBad) (ui_error))))

; A dot 8 across in the tone's color, then the text, 6 after it.
(def ui_status_ops ((r Rect) (tone UiTone) (s (list int)) (st UiState) (bg int)) (list UiPaint)
  (let dy (ui_aligned (.y r) (.h r) 8 (UiCenter))
    (cons (UiPRound (Rect (.x r) dy 8 8) 4 (ui_tone_color tone st bg) bg)
          (cons (UiPText (Rect (add (.x r) 14) (.y r) (max 0 (sub (.w r) 14)) (.h r)) s (UiStart)
                         (ui_fg (.style st)) (ui_text_font) false 1)
                (nil UiPaint)))))

; An empty page, the HIG's status page: a large dimmed icon, a title, and
; what to do, in the middle of r.
(def ui_status_page_ops ((r Rect) (icon (list int)) (title (list int)) (d (list int)) (st UiState) (bg int)) (list UiPaint)
  (let (y (ui_aligned (.y r) (.h r) (ui_status_page_h) (UiCenter))
        dim (ui_dim_fg (.style st) bg)
        ty (add y (add 64 (ui_space_m))))
    (cons (UiPIcon (ui_aligned (.x r) (.w r) 64 (UiCenter)) y icon dim 4)
          (cons (UiPText (Rect (.x r) ty (.w r) 32) title (UiCenter) (ui_fg (.style st)) (ui_text_font) true 2)
                (cons (UiPText (Rect (.x r) (add ty (add 32 (ui_space_s))) (.w r) (ui_char_h)) d (UiCenter) dim (ui_text_font) false 1)
                      (nil UiPaint))))))

; ------------------------------------------------------------ using nodes

; Linux's codes for the keys that move and use the focus, and Esc, which
; closes a dialog, and the compositor's launcher.
(def ui_key_tab () int 15)
(def ui_key_enter () int 28)
(def ui_key_space () int 57)
(def ui_key_esc () int 1)

; The action of the topmost node with one at x, y, or "".
(def ui_hit ((ns (list UiNode)) (x int) (y int)) (list int)
  (ui_hit_onto ns x y ""))

; ui_hit's loop: found, the action of the last node so far with one at
; x, y, replaced by any later one.
(def ui_hit_onto ((ns (list UiNode)) (x int) (y int) (found (list int))) (list int)
  (if (is_empty ns)
      found
      (match (head ns)
        ((UiNode r ops a f)
          (ui_hit_onto (tail ns) x y (if (and (not (is_empty a)) (rect_has r x y)) a found))))))

; -------------------------------------------------------------- scrolling

; A widget that scrolls, as the grid does, says how it is scrolled in the
; actions of two of its nodes, so that window.l0 can scroll it from the
; nodes laid out, as GTK's scrolled window does with its adjustment:
;
;   NAME.scroll.FIRST.MOST.SHOWN.STEP       the area the wheel scrolls
;   NAME.scrollbar.FIRST.MOST.SPAN.SLIDER   its scrollbar's strip, which
;                                           takes the wheel too, and
;                                           whose slider the pointer drags
;
; FIRST is the first row shown, MOST the most it can be, SHOWN how many
; rows show at once, and STEP how high a row is, in pixels, the rows laid
; out from the area's top; SPAN is how far the slider can travel along
; the strip, in pixels, and SLIDER its length. Either way, the program is
; set off NAME.scrollto.N: row N is to be the first shown. STEP is how
; window.l0 knows how far a scroll moved what is painted, to move those
; pixels rather than paint them again.

; What a node's action says of a scroller: its area, with its name, first
; row, most first row, rows shown and row height; its scrollbar, with its
; name, first row, most first row, span and slider; or neither.
(data UiScrollNode
  (UiScrollArea (list int) int int int int)
  (UiScrollBar (list int) int int int int)
  (UiNoScroll))

; Where a scroller is scrolled, as a program needs it to keep a selection
; in view: the first row shown, the most it can be, and how many show;
; all 0 when it has not been laid out.
(data UiScroller (UiScroller int int int))

; A scroller not laid out.
(def ui_no_scroller () UiScroller (UiScroller 0 0 0))

; The action of a scroller's area, NAME.scroll.FIRST.MOST.SHOWN.STEP.
(def ui_scroll_area_action ((name (list int)) (first int) (most int) (shown int) (step int)) (list int)
  (append name (append ".scroll" (ui_dot_nums (cons first (cons most (cons shown (cons step (nil int)))))))))

; The action of a scroller's strip, NAME.scrollbar.FIRST.MOST.SPAN.SLIDER.
(def ui_scrollbar_action ((name (list int)) (first int) (most int) (span int) (slider int)) (list int)
  (append name (append ".scrollbar" (ui_dot_nums (cons first (cons most (cons span (cons slider (nil int)))))))))

; The action that asks for row first to be shown first,
; NAME.scrollto.FIRST.
(def ui_scrollto_action ((name (list int)) (first int)) (list int)
  (append name (append ".scrollto." (digits first))))

; Each number with a dot before it.
(def ui_dot_nums ((ns (list int))) (list int)
  (if (is_empty ns) "" (append "." (append (digits (head ns)) (ui_dot_nums (tail ns))))))

; What action a says of a scroller.
(def ui_scroll_of ((a (list int))) UiScrollNode
  (let fs (rev (split_on 46 a))                     ; its fields between dots, the last first
    (if (ui_numbers_then fs 4 "scrollbar")
        (UiScrollBar (join_with "." (rev (drop fs 5))) (ui_field_num fs 3) (ui_field_num fs 2) (ui_field_num fs 1) (ui_field_num fs 0))
        (ui_numbers_then fs 4 "scroll")
        (UiScrollArea (join_with "." (rev (drop fs 5))) (ui_field_num fs 3) (ui_field_num fs 2) (ui_field_num fs 1) (ui_field_num fs 0))
        (UiNoScroll))))

; Whether the first n of fs, last first, are numbers, the next is word,
; and a name comes before it.
(def ui_numbers_then ((fs (list (list int))) (n int) (word (list int))) bool
  (if (le (length fs) (add n 1)) false
      (eq n 0) (eq (head fs) word)
      (is_number (head fs)) (ui_numbers_then (tail fs) (sub n 1) word)
      false))

; Field i of fs as a number; 0 if there is none.
(def ui_field_num ((fs (list (list int))) (i int)) int (int_prefix (nth_or fs i "") 0))

; v, but no less than lo and no more than hi.
(def ui_clamp ((v int) (lo int) (hi int)) int (max lo (min v hi)))

; The scroller under x, y: the topmost node there that is one's area or
; scrollbar, though other nodes, such as rows, lie over it; or none.
(def ui_scroll_hit ((ns (list UiNode)) (x int) (y int)) UiScrollNode
  (ui_scroll_hit_onto ns x y (UiNoScroll)))

; ui_scroll_hit's loop: found, the last scroller's node so far at x, y,
; replaced by any later one.
(def ui_scroll_hit_onto ((ns (list UiNode)) (x int) (y int) (found UiScrollNode)) UiScrollNode
  (if (is_empty ns)
      found
      (match (head ns)
        ((UiNode r ops a f)
          (ui_scroll_hit_onto (tail ns) x y
            (if (rect_has r x y)
                (match (ui_scroll_of a)
                  ((UiNoScroll) found)
                  ((UiScrollArea n fi m s st) (ui_scroll_of a))
                  ((UiScrollBar n fi m sp sl) (ui_scroll_of a)))
                found))))))

; The scrollbar node of the scroller called name, if one is laid out.
(def ui_scrollbar_named ((ns (list UiNode)) (name (list int))) (Option UiNode)
  (if (is_empty ns)
      ((None UiNode))
      (match (ui_scroll_of (.action (head ns)))
        ((UiScrollBar n fi m sp sl) (if (eq n name) (Some (head ns)) (ui_scrollbar_named (tail ns) name)))
        ((UiScrollArea n fi m s st) (ui_scrollbar_named (tail ns) name))
        ((UiNoScroll) (ui_scrollbar_named (tail ns) name)))))

; Where the scroller called name is scrolled, as its area's node says.
(def ui_scroller_of ((ns (list UiNode)) (name (list int))) UiScroller
  (if (is_empty ns)
      (ui_no_scroller)
      (match (ui_scroll_of (.action (head ns)))
        ((UiScrollArea n fi m s st) (if (eq n name) (UiScroller fi m s) (ui_scroller_of (tail ns) name)))
        ((UiScrollBar n fi m sp sl) (ui_scroller_of (tail ns) name))
        ((UiNoScroll) (ui_scroller_of (tail ns) name)))))

; The first row after dy steps of the wheel from first, of most.
(def ui_wheel_first ((first int) (most int) (dy int)) int
  (ui_clamp (add first (mul dy (ui_wheel_rows))) 0 most))

; Where the slider's top is on a strip from y, with first of most shown
; and span to travel.
(def ui_slider_top ((y int) (first int) (most int) (span int)) int
  (if (le most 0) y (add y (div (mul first span) most))))

; The first row shown with the slider's top at top, on a strip from y:
; the nearest row to where it is along its span.
(def ui_slider_first ((top int) (y int) (most int) (span int)) int
  (if (le span 0)
      0
      (ui_clamp (div (add (mul (ui_clamp (sub top y) 0 span) most) (div span 2)) span) 0 most)))

; ---------------------------------------------------------- scrolling across
;
; A scroller wider than it shows, as the grid is when its columns add up
; to more than its width, says how far across it is scrolled in two more
; nodes' actions, as it says how far down:
;
;   NAME.across.LEFT.MOST                    the area the wheel across
;                                            scrolls
;   NAME.acrossbar.LEFT.MOST.SPAN.SLIDER     its scrollbar's strip along
;                                            its bottom, which takes the
;                                            wheel across too, and whose
;                                            slider the pointer drags
;
; LEFT is how many pixels of it are scrolled off to the left, MOST the
; most that can be, and SPAN and SLIDER as a scrollbar's down. Either way,
; the program is set off NAME.acrossto.N: N pixels are to be scrolled off
; to the left.

; What a node's action says of a scroller across: its area, with its
; name, pixels scrolled off and the most they can be; its scrollbar, with
; its name, the same, span and slider; or neither.
(data UiAcrossNode
  (UiAcrossArea (list int) int int)
  (UiAcrossBar (list int) int int int int)
  (UiNoAcross))

; The action of a scroller's area across, NAME.across.LEFT.MOST.
(def ui_across_action ((name (list int)) (left int) (most int)) (list int)
  (append name (append ".across" (ui_dot_nums (cons left (cons most (nil int)))))))

; The action of a scroller's strip across, NAME.acrossbar.LEFT.MOST.SPAN.SLIDER.
(def ui_acrossbar_action ((name (list int)) (left int) (most int) (span int) (slider int)) (list int)
  (append name (append ".acrossbar" (ui_dot_nums (cons left (cons most (cons span (cons slider (nil int)))))))))

; The action that asks for left pixels to be scrolled off to the left,
; NAME.acrossto.LEFT.
(def ui_acrossto_action ((name (list int)) (left int)) (list int)
  (append name (append ".acrossto." (digits left))))

; What action a says of a scroller across.
(def ui_across_of ((a (list int))) UiAcrossNode
  (let fs (rev (split_on 46 a))                     ; its fields between dots, the last first
    (if (ui_numbers_then fs 4 "acrossbar")
        (UiAcrossBar (join_with "." (rev (drop fs 5))) (ui_field_num fs 3) (ui_field_num fs 2) (ui_field_num fs 1) (ui_field_num fs 0))
        (ui_numbers_then fs 2 "across")
        (UiAcrossArea (join_with "." (rev (drop fs 3))) (ui_field_num fs 1) (ui_field_num fs 0))
        (UiNoAcross))))

; The scroller across under x, y: the topmost node there that is one's
; area or scrollbar, though other nodes lie over it; or none.
(def ui_across_hit ((ns (list UiNode)) (x int) (y int)) UiAcrossNode
  (ui_across_hit_onto ns x y (UiNoAcross)))

; ui_across_hit's loop: found, the last such node so far at x, y,
; replaced by any later one.
(def ui_across_hit_onto ((ns (list UiNode)) (x int) (y int) (found UiAcrossNode)) UiAcrossNode
  (if (is_empty ns)
      found
      (match (head ns)
        ((UiNode r ops a f)
          (ui_across_hit_onto (tail ns) x y
            (if (rect_has r x y)
                (match (ui_across_of a)
                  ((UiNoAcross) found)
                  ((UiAcrossArea n l m) (ui_across_of a))
                  ((UiAcrossBar n l m sp sl) (ui_across_of a)))
                found))))))

; The scrollbar node across of the scroller called name, if one is laid
; out.
(def ui_acrossbar_named ((ns (list UiNode)) (name (list int))) (Option UiNode)
  (if (is_empty ns)
      ((None UiNode))
      (match (ui_across_of (.action (head ns)))
        ((UiAcrossBar n l m sp sl) (if (eq n name) (Some (head ns)) (ui_acrossbar_named (tail ns) name)))
        ((UiAcrossArea n l m) (ui_acrossbar_named (tail ns) name))
        ((UiNoAcross) (ui_acrossbar_named (tail ns) name)))))

; How far across, of most, after dx steps of the wheel from left.
(def ui_wheel_left ((left int) (most int) (dx int)) int
  (ui_clamp (add left (mul dx (ui_wheel_across))) 0 most))

; The actions the keyboard's focus can be on, in order.
(def ui_focusables ((ns (list UiNode))) (list (list int))
  (rev (ui_focusables_onto ns (nil (list int)))))

; ui_focusables's loop: the action of each node that can take the focus,
; onto acc, reversed.
(def ui_focusables_onto ((ns (list UiNode)) (acc (list (list int)))) (list (list int))
  (if (is_empty ns)
      acc
      (match (head ns) ((UiNode r ops a f) (ui_focusables_onto (tail ns) (if f (cons a acc) acc))))))

; Where Tab takes the focus from cur: the next that can have it, round to
; the first; or "" if none can.
(def ui_focus_next ((ns (list UiNode)) (cur (list int))) (list int)
  (let fs (ui_focusables ns)
    (if (is_empty fs) "" (ui_after fs cur (head fs)))))

; Where Shift-Tab takes the focus from cur: the one before that can have
; it, round to the last, as from none; or "" if none can.
(def ui_focus_prev ((ns (list UiNode)) (cur (list int))) (list int)
  (let fs (rev (ui_focusables ns))
    (if (is_empty fs) "" (ui_after fs cur (head fs)))))

; The action after cur among fs, or first if cur is the last or is not
; among them.
(def ui_after ((fs (list (list int))) (cur (list int)) (first (list int))) (list int)
  (if (is_empty fs) first
      (eq (head fs) cur) (if (is_empty (tail fs)) first (head (tail fs)))
      (ui_after (tail fs) cur first)))

; Every node in clip painted, in order, cut to clip, at the face's scale.
(def ui_paint_nodes ((c Canvas) (face UiFace) (clip Rect) (ns (list UiNode))) Canvas
  (if (is_empty ns)
      c
      (match (head ns)
        ((UiNode r ops a f)
          (ui_paint_nodes (if (rect_overlaps r clip) (ui_paint c face clip ops) c) face clip (tail ns))))))
