(def parsed_text ((r (Result UiDraw (list int)))) (list int)
  (match r
    ((Err why) (append "error: " why))
    ((Ok d)
      (match d
        ((UiDrawBasic cmd) "basic")
        ((UiDrawRound x y w h rad c) (append "round " (append (digits rad) (append " " (hex_digits c 6)))))
        ((UiDrawButton x y k label) (append "button " label))))))

(def test_ui_draw_round () int
  (add (check_str "a palette color" (parsed_text (ui_parse_draw (split_spaces "round 10 10 100 50 12 blue_3"))) "round 12 3584e4")
       (check_str "white unless given" (parsed_text (ui_parse_draw (split_spaces "round 10 10 100 50 12"))) "round 12 ffffff")))

(def test_ui_draw_round_bad () int
  (add (check_str "too few" (parsed_text (ui_parse_draw (split_spaces "round 1 2 3"))) "error: round takes 5 numbers and a color")
       (check_str "a negative radius" (parsed_text (ui_parse_draw (split_spaces "round 1 2 3 4 -5"))) "error: round's radius must not be negative")))

(def test_ui_draw_button () int
  (add (check_str "its label" (parsed_text (ui_parse_draw (split_spaces "button 10 10 suggested Get Started"))) "button Get Started")
       (check_str "no such kind" (parsed_text (ui_parse_draw (split_spaces "button 10 10 pill Go"))) "error: no kind of button pill")))

(def test_ui_draw_basic () int
  (add (check_str "render's own" (parsed_text (ui_parse_draw (split_spaces "line 0 0 9 9 red_3"))) "basic")
       (add (check_str "its errors" (parsed_text (ui_parse_draw (split_spaces "blah"))) "error: no command blah")
            (check_str "nothing" (parsed_text (ui_parse_draw (nil (list int)))) "error: no command"))))

(def test_ui_draw_ops () int
  (add (check_int "a round's one op" (length (ui_draw_ops (UiDrawRound 0 0 10 10 3 0))) 1)
       (check_bool "a button paints" (gt (length (ui_draw_ops (UiDrawButton 0 0 (UiBtnRegular) "Go"))) 1) true)))
