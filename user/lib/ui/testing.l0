; testing.l0 -- what an app's host tests ask of its view, made once: a
; widget laid out as a window in the light style, which actions it sets
; off and where, and the text it paints, in order. Linked into the
; apps' and the toolkit's tests (UI_TESTING), never into a program.

; widget laid out as a window w by h in the light style, nothing hovered
; or focused: the nodes ui_present would paint.
(def ui_laid ((widget UiWidget) (w int) (h int)) (list UiNode)
  (ui_layout_window widget w h (ui_state_new (UiLight))))

; Whether a node of ns sets off action a: a target there is, sensitive.
(def ui_has_target ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (eq (.action (head ns)) a) true (ui_has_target (tail ns) a)))

; Where the first node setting off a is, as "X Y W H", or "none".
(def ui_target_at ((ns (list UiNode)) (a (list int))) (list int)
  (if (is_empty ns)
      "none"
      (eq (.action (head ns)) a)
          (let r (.rect (head ns))
            (unwords (cons (digits (.x r)) (cons (digits (.y r)) (cons (digits (.w r)) (cons (digits (.h r)) (nil (list int))))))))
      (ui_target_at (tail ns) a)))

; The texts ns paint, in the order painted, each followed by |.
(def ui_texts ((ns (list UiNode))) (list int)
  (rev (ui_texts_onto ns (nil int))))

; ui_texts' loop: each node's texts onto acc, reversed.
(def ui_texts_onto ((ns (list UiNode)) (acc (list int))) (list int)
  (if (is_empty ns) acc (ui_texts_onto (tail ns) (ui_op_texts_onto (.ops (head ns)) acc))))

; Each text op's text and a |, onto acc, reversed.
(def ui_op_texts_onto ((ops (list UiPaint)) (acc (list int))) (list int)
  (if (is_empty ops)
      acc
      (ui_op_texts_onto (tail ops)
                        (match (head ops)
                          ((UiPText r s a c f b sc) (push "|" (push s acc)))
                          ((UiPFill r c) acc) ((UiPRound r rad c g) acc) ((UiPRing r rad c) acc) ((UiPIcon x y n c sc) acc) ((UiPImage x y n d cov) acc)))))

; Whether ns paint s as one text.
(def ui_has_text ((ns (list UiNode)) (s (list int))) bool
  (contains (cons 124 (ui_texts ns)) (append "|" (append s "|"))))

; The actions of the nodes of ns with an op that reaches past the node,
; each followed by |: what painting, which cuts each node's ops to it,
; would cut short. A view's are none.
(def ui_ops_past ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (let n (head ns)
        (append (if (ui_ops_within (.ops n) (.rect n)) "" (append (.action n) "|")) (ui_ops_past (tail ns))))))

; Whether each of ops paints inside r, or paints nothing.
(def ui_ops_within ((ops (list UiPaint)) (r Rect)) bool
  (if (is_empty ops)
      true
      (let b (ui_op_rect (head ops))
        (and (or (rect_empty b) (eq (rect_clip b r) b)) (ui_ops_within (tail ops) r)))))
