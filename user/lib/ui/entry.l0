; entry.l0 -- a text entry, as libadwaita draws GtkEntry: a line of text
; on a faint ground, rounded, with a cursor and the accent's ring while it
; has the keyboard's focus. Its UiWidget constructor is UiEntry, in
; widget.l0.
;
; The text and the cursor are the program's, in its own state, as the Elm
; architecture keeps everything: an entry is drawn from a UiEntryText and
; changes nothing itself. Its node's action is NAME.entry; window.l0 gives
; it the focus when it is pressed, and while it has the focus sets off, for
; the program to pass to ui_entry_update:
;
;   NAME.place.N    a press: the cursor to go before character N
;   NAME.edit       a key, the event's, to type or move with
;   NAME.activate   Enter, as GtkEntry's activate
;
; Text wider than the entry is cut short with "...", as any text is:
; there is no scrolling within it, so an entry is made as wide as what
; it is to hold.

; An entry's text, and where its cursor is: before character N, from 0, so
; at its length the cursor is at the end.
(data UiEntryText (UiEntryText (text (list int)) (cursor int)))

; Text with the cursor at its end.
(def ui_entry_new ((s (list int))) UiEntryText (UiEntryText s (length s)))

; The text with the cursor before character n, kept within it.
(def ui_entry_placed ((t UiEntryText) (n int)) UiEntryText
  (let k (length (.text t))
    (.cursor t (max 0 (min n k)))))

; Linux's codes for the keys that delete.
(def ui_key_backspace () int 14)
(def ui_key_delete () int 111)

; The text after a key: a character typed goes in at the cursor; Backspace
; takes away the one before it, Delete the one after; Left and Right move
; it a character, Home and End to the ends. A release, a key with Alt
; held, which is a shortcut's, and any other key, change nothing.
(def ui_entry_keyed ((t UiEntryText) (k KeyEvent)) UiEntryText
  (match k
    ((KeyEvent code value ch mods)
      (if (or (eq value 0) (not (eq (bit_and mods (key_mod_alt)) 0)))
          t
          (ui_entry_deleted (ui_entry_placed t (.cursor t)) code ch)))))

; Backspace and Delete; the rest moves or types.
(def ui_entry_deleted ((t UiEntryText) (code int) (ch int)) UiEntryText
  (match t
    ((UiEntryText s c)
      (if (eq code (ui_key_backspace))
          (if (eq c 0) t (UiEntryText (append (take s (sub c 1)) (drop_n s c)) (sub c 1)))
          (eq code (ui_key_delete))
          (UiEntryText (append (take s c) (drop_n s (add c 1))) c)
          (ui_entry_moved t code ch)))))

; The cursor moved by Left, Right, Home and End; else ch typed, if it is
; a character the font has.
(def ui_entry_moved ((t UiEntryText) (code int) (ch int)) UiEntryText
  (match t
    ((UiEntryText s c)
      (if (eq code (ui_key_left)) (UiEntryText s (max 0 (sub c 1)))
          (eq code (ui_key_right)) (UiEntryText s (min (length s) (add c 1)))
          (eq code (ui_key_home)) (UiEntryText s 0)
          (eq code (ui_key_end)) (UiEntryText s (length s))
          (and (ge ch 32) (le ch 126)) (UiEntryText (append (take s c) (cons ch (drop_n s c))) (add c 1))
          t))))

; ----------------------------------------------------------------- actions

; An entry's own action, and those it sets off.
(def ui_entry_action ((name (list int))) (list int) (append name ".entry"))
(def ui_entry_edit_action ((name (list int))) (list int) (append name ".edit"))
(def ui_entry_activate_action ((name (list int))) (list int) (append name ".activate"))
(def ui_entry_place_action ((name (list int)) (n int)) (list int) (append name (append ".place." (digits n))))

; The entry's name, if action is an entry's own; else "".
(def ui_entry_name_of ((action (list int))) (list int)
  (let n (length action)
    (if (lt n 7) ""
        (eq (drop_n action (sub n 6)) ".entry") (take action (sub n 6))
        "")))

; The character a press at x is before, in an entry laid out as node n:
; in its text, the first op of text in its ops, before each character
; whose middle x is past, by the sums of the advances its text is drawn
; by; 0 if it has no text.
(def ui_entry_char_at ((n UiNode) (x int)) int
  (ui_entry_char_at_xy n x (.y (.rect n))))

; The character a press at x and y is before, in an entry or a text
; area laid out as node n: its ops of text are its rows, in order, and
; the press is in the last whose top is not below y, or the first; its
; character there counted from the text's start, past the rows before,
; a row of no width the rows scrolled out of view. 0 if it has no text.
(def ui_entry_char_at_xy ((n UiNode) (x int) (y int)) int
  (ui_entry_char_in (.ops n) x y 0 -1))

; ui_entry_char_at_xy's loop over ops: at, how many characters the rows
; before hold, and found, the character so far, -1 for none.
(def ui_entry_char_in ((ops (list UiPaint)) (x int) (y int) (at int) (found int)) int
  (if (is_empty ops)
      (max 0 found)
      (match (head ops)
        ((UiPText r s a c f bold scale)
          (let (shown (gt (.w r) 0)
                here (and shown (or (lt found 0) (le (.y r) y))))
            (ui_entry_char_in (tail ops) x y (add at (length s)) (if here (add at (ui_text_char_at s f bold (sub x (.x r)) 0)) found))))
        ((UiPFill r c) (ui_entry_char_in (tail ops) x y at found))
        ((UiPRound r rad c u) (ui_entry_char_in (tail ops) x y at found))
        ((UiPIcon ix iy nm c sc) (ui_entry_char_in (tail ops) x y at found))
        ((UiPImage ix iy n d ts) (ui_entry_char_in (tail ops) x y at found)))))

; How many of s's characters, from i on, have their middle no further
; than dx from the text's start, at text scale 1.
(def ui_text_char_at ((s (list int)) (f UiFont) (bold bool) (dx int) (i int)) int
  (if (ge i (length s))
      i
      (let mid (div (add (ui_text_pen s f bold i) (ui_text_pen s f bold (add i 1))) 2)
        (if (lt dx mid) i (ui_text_char_at s f bold dx (add i 1))))))

; ------------------------------------------------------------------ layout

; An entry's size: w wide, a button high.
(def ui_entry_size ((w int)) UiSize (UiSize w (ui_button_h)))

; An entry called name laid out across r, a button high in its middle: its
; ground, the ring if it has the focus, its text, or the placeholder dimmed
; if it has none, and the cursor while it has the focus.
(def ui_entry_node ((r Rect) (name (list int)) (t UiEntryText) (placeholder (list int)) (st UiState) (bg int)) UiNode
  (let (h (min (.h r) (ui_button_h))
        b (Rect (.x r) (ui_aligned (.y r) (.h r) h (UiCenter)) (.w r) h)
        action (ui_entry_action name))
    (UiNode b (ui_entry_ops b t placeholder (eq (.focus st) action) (.style st) bg) action true)))

; An entry's ground in b on bg: rounded, with the accent's ring inside
; its edge while it has the focus.
(def ui_entry_ground ((b Rect) (focused bool) (s UiStyle) (bg int)) (list UiPaint)
  (let g (ui_entry_bg s bg)
    (if focused
        (cons (UiPRound b (ui_button_radius) (ui_focus_ring bg) bg)
              (cons (UiPRound (rect_inset b 2) (sub (ui_button_radius) 2) g (ui_focus_ring bg)) (nil UiPaint)))
        (cons (UiPRound b (ui_button_radius) g bg) (nil UiPaint)))))

; The ops that paint an entry in b, as ui_entry_node says.
(def ui_entry_ops ((b Rect) (t UiEntryText) (placeholder (list int)) (focused bool) (s UiStyle) (bg int)) (list UiPaint)
  (let (g (ui_entry_bg s bg)
        ground (ui_entry_ground b focused s bg)
        tr (Rect (add (.x b) (ui_entry_pad)) (.y b) (max 0 (sub (.w b) (mul 2 (ui_entry_pad)))) (.h b))
        text (if (is_empty (.text t))
                 (if (is_empty placeholder) (nil UiPaint) (cons (UiPText tr placeholder (UiStart) (ui_dim_fg s g) (ui_text_font) false 1) (nil UiPaint)))
                 (cons (UiPText tr (.text t) (UiStart) (ui_fg s) (ui_text_font) false 1) (nil UiPaint))))
    (append ground (append text (if focused (cons (ui_entry_cursor_op tr t s) (nil UiPaint)) (nil UiPaint))))))

; The cursor: a line the text's height, before its character, where the
; sum of the advances before it puts that character's pen.
(def ui_entry_cursor_op ((tr Rect) (t UiEntryText) (s UiStyle)) UiPaint
  (let c (.cursor (ui_entry_placed t (.cursor t)))
    (UiPFill (Rect (min (add (.x tr) (ui_text_pen (.text t) (ui_text_font) false c)) (add (.x tr) (.w tr)))
                     (ui_aligned (.y tr) (.h tr) (ui_char_h) (UiCenter))
                     (ui_entry_cursor_w) (ui_char_h))
             (ui_fg s))))

; ------------------------------------------------------------- text areas

; A text area is an entry whose text wraps, as a chat's GtkTextView
; that grows as it is typed into: the same text, cursor, actions and
; keys, Enter still its activate, but its text in rows at its spaces,
; every character kept, a word too long for a row cut where it no
; longer fits, and the area a row taller for each row up to the most it
; is given, those rows kept around the cursor after that. Its UiWidget
; constructor is UiTextArea, in widget.l0; a column gives it the height
; its rows take at the width it has (ui_height_in).

; How wide a text area's text may be in an area w wide: inside its
; insets, with room for the cursor after it.
(def ui_area_text_w ((w int)) int
  (max 1 (sub (sub w (mul 2 (ui_entry_pad))) (ui_entry_cursor_w))))

; s in rows at most w wide, at its spaces, each row keeping the spaces
; after its last word; a word wider than w cut where it no longer fits;
; nothing one empty row.
(def ui_area_rows ((s (list int)) (w int)) (list (list int))
  (ui_area_wrap (ui_area_tokens s (nil (list int))) w (nil int) (nil (list int))))

; s as tokens, each a word and the spaces after it, a run of spaces at
; s's start one of its own, in order after acc reversed.
(def ui_area_tokens ((s (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (rev acc)
      (let (word (up_to 32 s)
            n (add (length word) (ui_spaces_n (drop_n s (length word)) 0)))
        (ui_area_tokens (drop_n s n) (cons (take s n) acc)))))

; How many spaces s starts with, after n.
(def ui_spaces_n ((s (list int)) (n int)) int
  (if (and (not (is_empty s)) (eq (head s) 32)) (ui_spaces_n (tail s) (add n 1)) n))

; row without the spaces after its last word.
(def ui_row_trimmed ((row (list int))) (list int)
  (rev (drop_n (rev row) (ui_spaces_n (rev row) 0))))

; ui_area_rows' loop: the tokens ts onto the row so far, line,
; reversed, each row ended onto acc, reversed; a row is measured
; without its last spaces, which hang past its end.
(def ui_area_wrap ((ts (list (list int))) (w int) (line (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty ts)
      (rev (cons (rev line) acc))
      (let (tok (head ts)
            more (rev_onto tok line))
        (if (le (ui_text_w (ui_row_trimmed (rev more)) (ui_text_font) false 1) w)
            (ui_area_wrap (tail ts) w more acc)
            (not (is_empty line))
            (ui_area_wrap ts w (nil int) (cons (rev line) acc))
            (let k (max 1 (length (ui_fitting tok w (ui_text_font) false 1 (nil int))))
              (ui_area_wrap (if (ge k (length tok)) (tail ts) (cons (drop tok k) (tail ts))) w (nil int) (cons (take tok k) acc)))))))

; The row of rows the cursor before character c is in, counting from i
; at the row that starts at character start: the last row it is not
; past the end of, a cursor at a row's end in the row after.
(def ui_area_cursor_row ((rows (list (list int))) (c int) (i int) (start int)) int
  (let n (length (head rows))
    (if (or (is_empty (tail rows)) (lt c (add start n))) i (ui_area_cursor_row (tail rows) c (add i 1) (add start n)))))

; How high a text area w wide is that shows t, most rows at most: a
; button's height for one row, and a row of text more for each other.
(def ui_area_h ((t UiEntryText) (w int) (most int)) int
  (let shown (max 1 (min most (length (ui_area_rows (.text t) (ui_area_text_w w)))))
    (add (ui_button_h) (mul (sub shown 1) (ui_text_row_h)))))

; A text area's natural size: w wide, a row high; its height in a
; column is ui_area_h.
(def ui_area_size ((w int)) UiSize (UiSize w (ui_button_h)))

; A text area called name laid out across r, as high as its rows in the
; middle of r: an entry's ground, the rows shown, from the first that
; keeps the cursor's row in view, the placeholder dimmed while it holds
; nothing, and the cursor while it has the focus.
(def ui_area_node ((r Rect) (name (list int)) (t UiEntryText) (placeholder (list int)) (most int) (st UiState) (bg int)) UiNode
  (let (rows (ui_area_rows (.text t) (ui_area_text_w (.w r)))
        n (length rows)
        shown (max 1 (min most n))
        h (min (.h r) (add (ui_button_h) (mul (sub shown 1) (ui_text_row_h))))
        b (Rect (.x r) (ui_aligned (.y r) (.h r) h (UiCenter)) (.w r) h)
        c (.cursor (ui_entry_placed t (.cursor t)))
        crow (ui_area_cursor_row rows c 0 0)
        first (max 0 (min (sub n shown) (add (sub crow shown) 1)))
        action (ui_entry_action name)
        focused (eq (.focus st) action)
        s (.style st))
    (UiNode b
            (append (ui_entry_ground b focused s bg)
              (append (ui_area_text_ops b rows first shown t placeholder s bg)
                (if focused (cons (ui_area_cursor_op b rows first crow c s) (nil UiPaint)) (nil UiPaint))))
            action true)))

; Row j's rectangle of a text area in b: inside its insets, a row of
; text high, the first as an entry's line is.
(def ui_area_row_rect ((b Rect) (j int)) Rect
  (Rect (add (.x b) (ui_entry_pad))
        (add (.y b) (add (div (sub (ui_button_h) (ui_text_row_h)) 2) (mul j (ui_text_row_h))))
        (max 0 (sub (.w b) (mul 2 (ui_entry_pad))))
        (ui_text_row_h)))

; A text area's text in b: the placeholder, dimmed, if it holds
; nothing; else the rows before first as text of no width, which draws
; nothing but counts for a press, then the shown rows from first, each
; drawn without its last spaces and those spaces after it, of no width.
(def ui_area_text_ops ((b Rect) (rows (list (list int))) (first int) (shown int) (t UiEntryText) (placeholder (list int)) (s UiStyle) (bg int)) (list UiPaint)
  (let (r0 (ui_area_row_rect b 0)
        hidden (join_with "" (take rows first)))
    (if (is_empty (.text t))
        (if (is_empty placeholder) (nil UiPaint) (cons (UiPText r0 placeholder (UiStart) (ui_dim_fg s (ui_entry_bg s bg)) (ui_text_font) false 1) (nil UiPaint)))
        (ui_area_rows_ops b (take (drop rows first) shown) 0 (ui_fg s)
          (if (is_empty hidden) (nil UiPaint) (cons (UiPText (Rect (.x r0) (.y r0) 0 0) hidden (UiStart) (ui_fg s) (ui_text_font) false 1) (nil UiPaint)))))))

; Each of rows, row j on, its ops in color onto acc, reversed; then in
; order.
(def ui_area_rows_ops ((b Rect) (rows (list (list int))) (j int) (color int) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty rows)
      (rev acc)
      (let (rr (ui_area_row_rect b j)
            row (head rows)
            vis (ui_row_trimmed row)
            gap (drop_n row (length vis))
            drawn (cons (UiPText rr vis (UiStart) color (ui_text_font) false 1) acc))
        (ui_area_rows_ops b (tail rows) (add j 1) color
          (if (is_empty gap) drawn (cons (UiPText (Rect (.x rr) (.y rr) 0 0) gap (UiStart) color (ui_text_font) false 1) drawn))))))

; A text area's cursor before character c, in row crow of rows, shown
; from first: a line the text's height, where the advances before it in
; its row put it, kept inside the area.
(def ui_area_cursor_op ((b Rect) (rows (list (list int))) (first int) (crow int) (c int) (s UiStyle)) UiPaint
  (let (rr (ui_area_row_rect b (sub crow first))
        row (nth rows crow)
        col (sub c (length (join_with "" (take rows crow)))))
    (UiPFill (Rect (min (add (.x rr) (ui_text_pen row (ui_text_font) false col)) (rect_x1 rr))
                   (ui_aligned (.y rr) (.h rr) (ui_char_h) (UiCenter))
                   (ui_entry_cursor_w) (ui_char_h))
             (ui_fg s))))
