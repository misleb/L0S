; entry.l0 -- a text entry, as libadwaita draws GtkEntry: a line of text
; on a faint ground, rounded, with a cursor and the accent's ring while it
; has the keyboard's focus. Its UiWidget constructor is UiEntry, in
; widget.l0.
;
; The text and the cursor are the program's, in its own state, as the Elm
; architecture keeps everything: an entry is drawn from a UiEntryText and
; changes nothing itself. Its node's action is NAME.entry; window.l0 gives
; it the focus when it is pressed, and while it has the focus sets off, for
; the program to pass to ui_entry_update:
;
;   NAME.place.N    a press: the cursor to go before character N
;   NAME.edit       a key, the event's, to type or move with
;   NAME.activate   Enter, as GtkEntry's activate
;
; Text wider than the entry is cut short with "...", as any text is:
; there is no scrolling within it, so an entry is made as wide as what
; it is to hold.

; An entry's text, and where its cursor is: before character N, from 0, so
; at its length the cursor is at the end.
(data UiEntryText (UiEntryText (list int) int))

; Text with the cursor at its end.
(def ui_entry_new ((s (list int))) UiEntryText (UiEntryText s (length s)))

; An entry's text, and its cursor.
(def ui_entry_text ((t UiEntryText)) (list int) (match t ((UiEntryText s c) s)))
(def ui_entry_cursor ((t UiEntryText)) int (match t ((UiEntryText s c) c)))

; The text with the cursor before character n, kept within it.
(def ui_entry_placed ((t UiEntryText) (n int)) UiEntryText
  (match t ((UiEntryText s c) (UiEntryText s (max 0 (min n (length s)))))))

; Linux's codes for the keys that delete.
(def ui_key_backspace () int 14)
(def ui_key_delete () int 111)

; The text after a key: a character typed goes in at the cursor; Backspace
; takes away the one before it, Delete the one after; Left and Right move
; it a character, Home and End to the ends. A release, and any other key,
; change nothing.
(def ui_entry_keyed ((t UiEntryText) (k KeyEvent)) UiEntryText
  (match k
    ((KeyEvent code value ch)
      (if (eq value 0) t (ui_entry_deleted (ui_entry_placed t (ui_entry_cursor t)) code ch)))))

; Backspace and Delete; the rest moves or types.
(def ui_entry_deleted ((t UiEntryText) (code int) (ch int)) UiEntryText
  (match t
    ((UiEntryText s c)
      (if (eq code (ui_key_backspace))
          (if (eq c 0) t (UiEntryText (append (take s (sub c 1)) (drop_n s c)) (sub c 1)))
          (if (eq code (ui_key_delete))
              (UiEntryText (append (take s c) (drop_n s (add c 1))) c)
              (ui_entry_moved t code ch))))))

; The cursor moved by Left, Right, Home and End; else ch typed, if it is
; a character the font has.
(def ui_entry_moved ((t UiEntryText) (code int) (ch int)) UiEntryText
  (match t
    ((UiEntryText s c)
      (if (eq code (ui_key_left)) (UiEntryText s (max 0 (sub c 1)))
      (if (eq code (ui_key_right)) (UiEntryText s (min (length s) (add c 1)))
      (if (eq code (ui_key_home)) (UiEntryText s 0)
      (if (eq code (ui_key_end)) (UiEntryText s (length s))
      (if (if (ge ch 32) (le ch 126) false)
          (UiEntryText (append (take s c) (cons ch (drop_n s c))) (add c 1))
          t))))))))

; ----------------------------------------------------------------- actions

; An entry's own action, and those it sets off.
(def ui_entry_action ((name (list int))) (list int) (append name ".entry"))
(def ui_entry_edit_action ((name (list int))) (list int) (append name ".edit"))
(def ui_entry_activate_action ((name (list int))) (list int) (append name ".activate"))
(def ui_entry_place_action ((name (list int)) (n int)) (list int) (append name (append ".place." (digits n))))

; The entry's name, if action is an entry's own; else "".
(def ui_entry_name_of ((action (list int))) (list int)
  (let n (length action)
    (if (lt n 7)
        ""
        (if (eq (drop_n action (sub n 6)) ".entry") (take action (sub n 6)) ""))))

; The character a press at x is before, in an entry laid out in r.
(def ui_entry_char_at ((r Rect) (x int)) int
  (max 0 (div (add (sub x (add (rect_x r) (ui_entry_pad))) (div (ui_char_w) 2)) (ui_char_w))))

; ------------------------------------------------------------------ layout

; An entry's size: w wide, a button high.
(def ui_entry_size ((w int)) UiSize (UiSize w (ui_button_h)))

; An entry called name laid out across r, a button high in its middle: its
; ground, the ring if it has the focus, its text, or the placeholder dimmed
; if it has none, and the cursor while it has the focus.
(def ui_entry_node ((r Rect) (name (list int)) (t UiEntryText) (placeholder (list int)) (st UiState) (bg int)) UiNode
  (let h (min (rect_h r) (ui_button_h))
    (let b (Rect (rect_x r) (ui_aligned (rect_y r) (rect_h r) h (UiCenter)) (rect_w r) h)
      (let action (ui_entry_action name)
        (UiNode b (ui_entry_ops b t placeholder (eq (ui_st_focus st) action) (ui_st_style st) bg) action true)))))

; The ops that paint an entry in b, as ui_entry_node says.
(def ui_entry_ops ((b Rect) (t UiEntryText) (placeholder (list int)) (focused bool) (s UiStyle) (bg int)) (list UiPaint)
  (let g (ui_entry_bg s bg)
    (let ground (if focused
                    (cons (UiPRound b (ui_button_radius) (ui_focus_ring bg) bg)
                          (cons (UiPRound (rect_inset b 2) (sub (ui_button_radius) 2) g (ui_focus_ring bg)) (nil UiPaint)))
                    (cons (UiPRound b (ui_button_radius) g bg) (nil UiPaint)))
      (let tr (Rect (add (rect_x b) (ui_entry_pad)) (rect_y b) (max 0 (sub (rect_w b) (mul 2 (ui_entry_pad)))) (rect_h b))
        (let text (if (is_empty (ui_entry_text t))
                      (if (is_empty placeholder) (nil UiPaint) (cons (UiPText tr placeholder (UiStart) (ui_dim_fg s g) false 1) (nil UiPaint)))
                      (cons (UiPText tr (ui_entry_text t) (UiStart) (ui_fg s) false 1) (nil UiPaint)))
          (append ground (append text (if focused (cons (ui_entry_cursor_op tr t s) (nil UiPaint)) (nil UiPaint)))))))))

; The cursor: a line the text's height, before its character.
(def ui_entry_cursor_op ((tr Rect) (t UiEntryText) (s UiStyle)) UiPaint
  (let c (ui_entry_cursor (ui_entry_placed t (ui_entry_cursor t)))
    (UiPFill (Rect (min (add (rect_x tr) (mul c (ui_char_w))) (add (rect_x tr) (rect_w tr)))
                     (ui_aligned (rect_y tr) (rect_h tr) (ui_char_h) (UiCenter))
                     (ui_entry_cursor_w) (ui_char_h))
             (ui_fg s))))
