; A strike's file is named as the build's STRIKES are.
(def test_strike_path () int
  (check_str "sans bold, 32" (ui_strike_path "build" "glyph.sans-bold.32") "build/strikes/sans-bold-32.strike"))

; Nothing in the window is its ground, the dark style's window color,
; 242424, as ui_present paints it on the board.
(def test_shot_ground () int
  (let c (ui_shot_canvas (ui_face_none) 8 6 (UiSpace 0 0))
    (add (check_str "a corner" (hex_digits (canvas_pixel c 0 0) 6) "242424")
         (check_str "the other" (hex_digits (canvas_pixel c 7 5) 6) "242424"))))

; A view fills the window with the view's ground, 1e1e1e.
(def test_shot_view () int
  (check_str "its middle" (hex_digits (canvas_pixel (ui_shot_canvas (ui_face_none) 8 6 (UiView (UiSpace 0 0))) 4 3) 6) "1e1e1e"))

; A canvas's pixels are the PNG's, row by row.
(def test_canvas_png () int
  (let c (put (put (canvas_new 2 2 255) 0 0 16711680) 1 1 65280)
    (check_bool "as png_bytes"
      (eq (ui_canvas_png c 2 2)
          (png_bytes 2 2 (cons (png_row (cons 16711680 (cons 255 (nil int))))
                               (cons (png_row (cons 255 (cons 65280 (nil int)))) (nil bytes)))))
      true)))

; With no build directory there is nothing to draw text with, and that
; is no failure.
(def test_host_face_missing () int
  (check_bool "no text" (ui_face_has_text (ui_host_face "build/no-such-dir")) false))

; With the build's strikes, the interface's text can be drawn (make test
; makes them first for this test).
(def test_host_face_built () int
  (let f (ui_host_face "build")
    (add (check_bool "text" (ui_face_has_text f) true)
         (check_int "all eight" (map_size (.ks f)) 8))))

; A label's text, drawn with the build's strikes, puts ink on the
; ground: some pixel of its row is not the window's color.
(def test_shot_text () int
  (let c (ui_shot_canvas (ui_host_face "build") 60 20 (UiLabel "Hello" (UiBody) (UiStart)))
    (check_bool "ink" (inked c 60 20 0) true)))

; Whether any pixel of c from index i on differs from the window's ground.
(def inked ((c Canvas) (w int) (h int) (i int)) bool
  (if (ge i (mul w h))
      false
      (if (eq (canvas_pixel c (mod i w) (div i w)) (ui_window_bg (ui_style)))
          (inked c w h (add i 1))
          true)))
