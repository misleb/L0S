; nav.l0 -- the widgets a window that goes from place to place puts in
; its header bar, as Nautilus does: a path bar, the directories of where
; it is as buttons, each going there, the last, where it is, in bold; and
; a toggle group, AdwToggleGroup, linked buttons of which one is active,
; as for showing files as a grid or a list. Their UiWidget constructors
; are in widget.l0: UiPathBar, UiToggleGroup.
;
; A path bar's buttons set off PREFIX.select.N, N the depth they go to,
; 0 for the first; a toggle PREFIX.select.KEY. ui_select_key (panes.l0)
; reads either back.

; ---------------------------------------------------------------- path bar

; A path bar's parts, as wide as they are drawn: a button, its depth and
; its label, a separator, or the button standing for those cut off, which
; goes to the depth before the first shown.
(data UiCrumb (UiCrumbAt int (list int)) (UiCrumbSep) (UiCrumbMore int))

; How wide a part is: a button its label and 8 either side, a separator
; its slash and 2 either side, the cut-off one an ellipsis's button.
(def ui_crumb_pad () int 8)
(def ui_crumb_w ((c UiCrumb) (last bool)) int
  (match c
    ((UiCrumbAt d label) (add (ui_text_w label last 1) (mul 2 (ui_crumb_pad))))
    ((UiCrumbSep) (add (ui_char_w) 4))
    ((UiCrumbMore d) (add (ui_text_w "..." false 1) (mul 2 (ui_crumb_pad))))))

; The parts for labels from depth d on, a separator between each two.
(def ui_crumbs ((labels (list (list int))) (d int)) (list UiCrumb)
  (if (is_empty labels)
      (nil UiCrumb)
      (cons (UiCrumbAt d (head labels))
            (if (is_empty (tail labels)) (nil UiCrumb) (cons (UiCrumbSep) (ui_crumbs (tail labels) (add d 1)))))))

; The parts' widths added up, the last's in bold.
(def ui_crumbs_w ((cs (list UiCrumb))) int
  (if (is_empty cs) 0 (add (ui_crumb_w (head cs) (is_empty (tail cs))) (ui_crumbs_w (tail cs)))))

; A path bar's natural size: all of its parts, a button high.
(def ui_pathbar_size ((labels (list (list int)))) UiSize
  (UiSize (ui_crumbs_w (ui_crumbs labels 0)) (ui_button_h)))

; The parts that fit in w: all of them; else the last few that fit after
; the ellipsis's button, which goes to the one before them; and at the
; least the last, cut to fit.
(def ui_crumbs_fit ((labels (list (list int))) (w int)) (list UiCrumb)
  (let all (ui_crumbs labels 0)
    (if (le (ui_crumbs_w all) w)
        all
        (ui_crumbs_from labels 1 w))))

; ui_crumbs_fit's loop: the ellipsis and the parts from depth d on, if
; they fit in w or only the last is left.
(def ui_crumbs_from ((labels (list (list int))) (d int) (w int)) (list UiCrumb)
  (let rest (drop labels d)
    (let cs (cons (UiCrumbMore (sub d 1)) (cons (UiCrumbSep) (ui_crumbs rest d)))
      (if (if (le (ui_crumbs_w cs) w) true (le (length rest) 1))
          cs
          (ui_crumbs_from labels (add d 1) w)))))

; A path bar in r: its ground, a button high in the middle of r, rounded,
; the text's color at 10% over bg; then its parts from the left. Each but
; the last is a flat button, lit under the pointer, going to its depth;
; the last is where one is, bold, and no target.
(def ui_pathbar_lay ((prefix (list int)) (labels (list (list int))) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (let h (ui_button_h)
    (let br (Rect (rect_x r) (ui_aligned (rect_y r) (rect_h r) h (UiCenter)) (rect_w r) (min h (rect_h r)))
      (let ground (ui_mix (ui_fg (ui_st_style st)) bg 10)
        (ui_crumbs_lay prefix (ui_crumbs_fit labels (rect_w br)) (rect_x br) br st ground
                       (ui_leaf br (cons (UiPRound br (ui_button_radius) ground bg) (nil UiPaint)) acc))))))

; Each part from x along the bar br, onto acc; the last cut to what is
; left of the bar.
(def ui_crumbs_lay ((prefix (list int)) (cs (list UiCrumb)) (x int) (br Rect) (st UiState) (ground int) (acc (list UiNode))) (list UiNode)
  (if (is_empty cs)
      acc
      (let last (is_empty (tail cs))
        (let cw (if last (max 0 (sub (rect_x1 br) x)) (ui_crumb_w (head cs) last))
          (let cr (Rect x (rect_y br) cw (rect_h br))
            (ui_crumbs_lay prefix (tail cs) (add x cw) br st ground
                           (cons (ui_crumb_node prefix (head cs) last cr st ground) acc)))))))

; A part's node in cr on the bar's ground.
(def ui_crumb_node ((prefix (list int)) (c UiCrumb) (last bool) (cr Rect) (st UiState) (ground int)) UiNode
  (let fg (ui_fg (ui_st_style st))
    (match c
      ((UiCrumbSep) (UiNode cr (cons (UiPText cr "/" (UiCenter) (ui_dim_fg (ui_st_style st) ground) false 1) (nil UiPaint)) "" false))
      ((UiCrumbAt d label)
        (if last
            (UiNode cr (cons (UiPText (ui_crumb_text_rect cr) label (UiCenter) fg true 1) (nil UiPaint)) "" false)
            (ui_crumb_button (ui_select_action prefix (digits d)) label cr st ground)))
      ((UiCrumbMore d) (ui_crumb_button (ui_select_action prefix (digits d)) "..." cr st ground)))))

; Where a part's label goes in cr: within its pads.
(def ui_crumb_text_rect ((cr Rect)) Rect
  (Rect (add (rect_x cr) (ui_crumb_pad)) (rect_y cr) (max 0 (sub (rect_w cr) (mul 2 (ui_crumb_pad)))) (rect_h cr)))

; A part that goes somewhere: a flat button, lit under the pointer and
; darker pressed, as a flat button is, rounded inside the bar.
(def ui_crumb_button ((action (list int)) (label (list int)) (cr Rect) (st UiState) (ground int)) UiNode
  (match (ui_button_ink (UiBtnFlat) (eq (ui_st_hover st) action) (eq (ui_st_pressed st) action) st ground)
    ((UiInk bg fg)
      (let text (UiPText (ui_crumb_text_rect cr) label (UiCenter) fg false 1)
        (UiNode cr (if (lt bg 0) (cons text (nil UiPaint)) (cons (UiPRound cr (ui_button_radius) bg ground) (cons text (nil UiPaint))))
                action true)))))

; ------------------------------------------------------------ toggle group

; A toggle: its key, its icon or "", and its label or "".
(data UiToggle (UiToggle (list int) (list int) (list int)))

; How wide a toggle is: as a button with its icon and label would be.
(def ui_toggle_w ((t UiToggle)) int
  (match t ((UiToggle key icon label) (ui_sw (ui_button_box icon label)))))

; The toggles' widths added up.
(def ui_toggles_w ((ts (list UiToggle))) int
  (if (is_empty ts) 0 (add (ui_toggle_w (head ts)) (ui_toggles_w (tail ts)))))

; A toggle group's natural size: its toggles side by side, a button high.
(def ui_toggles_size ((ts (list UiToggle))) UiSize (UiSize (ui_toggles_w ts) (ui_button_h)))

; A toggle group in r: its ground, a button high in the middle of r,
; rounded, the text's color at 10% over bg; then each toggle along it,
; the active one raised, on the view's ground 3 in from the group's
; edge, the one the pointer is over on a darker ground.
(def ui_toggles_lay ((prefix (list int)) (ts (list UiToggle)) (sel (list int)) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (let h (ui_button_h)
    (let gr (Rect (rect_x r) (ui_aligned (rect_y r) (rect_h r) h (UiCenter)) (ui_toggles_w ts) (min h (rect_h r)))
      (let ground (ui_mix (ui_fg (ui_st_style st)) bg 10)
        (ui_toggle_nodes prefix ts sel (rect_x gr) gr st ground
                         (ui_leaf gr (cons (UiPRound gr (ui_button_radius) ground bg) (nil UiPaint)) acc))))))

; Each toggle from x along the group gr, onto acc.
(def ui_toggle_nodes ((prefix (list int)) (ts (list UiToggle)) (sel (list int)) (x int) (gr Rect) (st UiState) (ground int) (acc (list UiNode))) (list UiNode)
  (if (is_empty ts)
      acc
      (match (head ts)
        ((UiToggle key icon label)
          (let tw (ui_toggle_w (head ts))
            (let tr (Rect x (rect_y gr) tw (rect_h gr))
              (ui_toggle_nodes prefix (tail ts) sel (add x tw) gr st ground
                               (cons (ui_toggle_node (ui_select_action prefix key) icon label (eq key sel) tr st ground) acc))))))))

; One toggle's node in tr: raised if active, its icon and label in the
; middle in the text's color.
(def ui_toggle_node ((action (list int)) (icon (list int)) (label (list int)) (active bool) (tr Rect) (st UiState) (ground int)) UiNode
  (let s (ui_st_style st)
    (let fg (ui_fg s)
      (let inner (rect_inset tr (ui_toggle_inset))
        (let raised (if active (ui_card_bg s) (if (eq (ui_st_hover st) action) (ui_mix fg ground 7) -1))
          (let content (ui_content_ops tr icon label fg)
            (UiNode tr (if (lt raised 0) content (cons (UiPRound inner (sub (ui_button_radius) 2) raised ground) content))
                    action true)))))))
