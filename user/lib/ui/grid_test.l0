(def cols () (list UiColumn)
  (cons (UiColumn "PID" 60 (UiEnd) true)
  (cons (UiColumn "Name" 0 (UiStart) true)
  (cons (UiColumn "CPU" 100 (UiStart) true) (nil UiColumn)))))

(def row ((pid int) (name (list int)) (cpu int)) UiRow
  (UiRow (digits pid) (cons (UiCellNum pid "") (cons (UiCellText name) (cons (UiCellLevel cpu) (nil UiCell))))))

(def rows () (list UiRow)
  (cons (row 3 "wm" 20) (cons (row 1 "sh" 5) (cons (row 2 "vt" 50) (nil UiRow)))))

(def keys_of ((rs (list UiRow))) (list int)
  (if (is_empty rs) "" (append (ui_row_key (head rs)) (append " " (keys_of (tail rs))))))

(def ints_text ((ns (list int))) (list int)
  (if (is_empty ns) "" (append (digits (head ns)) (append " " (ints_text (tail ns))))))

(def state_text ((s UiGridState)) (list int)
  (match s ((UiGridState c d k f) (append (digits c) (append (if d " desc " " asc ") (append k (append " " (digits f))))))))

(def test_ui_grid_widths () int
  (add (check_str "the name the rest" (ints_text (ui_grid_widths (cols) 400)) "60 240 100 ")
       (check_str "at least 40" (ints_text (ui_grid_widths (cols) 100)) "60 40 100 ")))

(def test_ui_grid_unsorted () int
  (check_str "as given" (keys_of (ui_grid_shown (rows) (ui_grid_state_new))) "3 1 2 "))

(def test_ui_grid_sorted () int
  (add (check_str "by pid" (keys_of (ui_grid_shown (rows) (UiGridState 0 false "" 0))) "1 2 3 ")
       (add (check_str "by name" (keys_of (ui_grid_shown (rows) (UiGridState 1 false "" 0))) "1 2 3 ")
            (check_str "by cpu, descending" (keys_of (ui_grid_shown (rows) (UiGridState 2 true "" 0))) "2 3 1 "))))

; Sizes sort by their bytes, where their text would put 12.3 kB before
; 9.0 kB, and are shown as format_size says them.
(def size_rows () (list UiRow)
  (cons (UiRow "a" (cons (UiCellSize 12288) (nil UiCell)))
  (cons (UiRow "b" (cons (UiCellSize 9000) (nil UiCell))) (nil UiRow))))

(def test_ui_grid_size_sorted () int
  (check_str "by bytes" (keys_of (ui_grid_shown (size_rows) (UiGridState 0 false "" 0))) "b a "))

(def test_ui_grid_size_text () int
  (let ops (ui_cell_ops (UiCellSize 12288) (Rect 0 0 100 30) (UiEnd) (ui_state_new (UiLight)) (ui_view_bg (UiLight)))
    (if (is_empty ops)
        (fail_because "a size" "no ops")
        (match (head ops)
          ((UiPText r s a c f b sc) (check_str "as GNOME says it" s "12.3 kB"))
          ((UiPFill r c) (fail_because "a size" "a fill"))
          ((UiPRound r rad c g) (fail_because "a size" "a round"))
          ((UiPIcon x y nm c sc) (fail_because "a size" "an icon"))
          ((UiPImage x y n d ts) (fail_because "a size" "an image"))))))

; A tinted icon's cell: the icon in its own color, the text in the
; text's, 6 after the icon.
(def test_ui_grid_tinted () int
  (let ops (ui_cell_ops (UiCellTinted "folder" 255 "a") (Rect 0 0 100 30) (UiStart) (ui_state_new (UiLight)) (ui_view_bg (UiLight)))
    (add (check_bool "the icon's color" (eq (head ops) (UiPIcon 0 7 "folder" 255 1)) true)
         (check_bool "the text's" (eq (nth ops 1) (UiPText (Rect 22 0 78 30) "a" (UiStart) (ui_fg (UiLight)) (ui_text_font) false 1)) true))))

(def test_ui_grid_action_sort () int
  (add (check_str "a new column, ascending" (state_text (ui_grid_action (ui_grid_state_new) "p" "p.sort.2")) "2 asc  0")
       (check_str "the same, the other way" (state_text (ui_grid_action (UiGridState 2 false "" 0) "p" "p.sort.2")) "2 desc  0")))

(def test_ui_grid_action_select () int
  (add (check_str "a row" (state_text (ui_grid_action (ui_grid_state_new) "p" "p.select.7")) "-1 asc 7 0")
       (check_str "not the grid's" (state_text (ui_grid_action (ui_grid_state_new) "p" "app.quit")) "-1 asc  0")))

(def view ((s UiGridState)) UiGridView (UiGridView "p" (cols) (rows) s))

(def test_ui_grid_keys () int
  (add (check_str "down from none, the first" (ui_gs_selected (ui_grid_key (view (UiGridState 0 false "" 0)) (ui_key_down) (ui_no_scroller))) "1")
       (add (check_str "down" (ui_gs_selected (ui_grid_key (view (UiGridState 0 false "1" 0)) (ui_key_down) (ui_no_scroller))) "2")
            (add (check_str "not past the end" (ui_gs_selected (ui_grid_key (view (UiGridState 0 false "3" 0)) (ui_key_down) (ui_no_scroller))) "3")
                 (check_str "home" (ui_gs_selected (ui_grid_key (view (UiGridState 0 false "3" 0)) (ui_key_home) (ui_no_scroller))) "1")))))

(def test_ui_grid_other_key () int
  (check_str "left alone" (ui_gs_selected (ui_grid_key (view (UiGridState 0 false "2" 0)) 30 (ui_no_scroller))) "2"))

; Twenty rows, keys 1 to 20, sorted by pid, ten of them shown from the
; first: the most first row is 10.
(def many_rows ((i int) (acc (list UiRow))) (list UiRow)
  (if (eq i 0) acc (many_rows (sub i 1) (cons (row i "p" 0) acc))))

(def many ((s UiGridState)) UiGridView (UiGridView "p" (cols) (many_rows 20 (nil UiRow)) s))

(def ten () UiScroller (UiScroller 0 10 10))

; Down from row 10, the last shown, to 11: scrolled a row, so 11 is the
; last shown. Down from 5: still in view, not scrolled.
(def test_ui_grid_key_scrolls () int
  (add (check_str "scrolled a row" (state_text (ui_grid_key (many (UiGridState 0 false "10" 0)) (ui_key_down) (ten))) "0 asc 11 1")
       (check_str "in view" (state_text (ui_grid_key (many (UiGridState 0 false "5" 0)) (ui_key_down) (ten))) "0 asc 6 0")))

; Page Down from the first is nine rows, a row fewer than show: to 10,
; still in view; End to 20, so 11 to 20 show.
(def test_ui_grid_page_keys () int
  (add (check_str "a page" (state_text (ui_grid_key (many (UiGridState 0 false "1" 0)) (ui_key_page_down) (ten))) "0 asc 10 0")
       (check_str "the end" (state_text (ui_grid_key (many (UiGridState 0 false "1" 0)) (ui_key_end) (ten))) "0 asc 20 10")))

; Up from 12 with 11 to 20 shown, as the scroller says although the
; state's first is 0: from where it is shown, to 11.
(def test_ui_grid_key_from_shown () int
  (check_str "the shown first kept" (state_text (ui_grid_key (many (UiGridState 0 false "12" 0)) (ui_key_up) (UiScroller 10 10 10))) "0 asc 11 10"))

(def test_ui_grid_action_scrollto () int
  (add (check_str "row 7 first" (state_text (ui_grid_action (UiGridState 0 false "3" 1) "p" "p.scrollto.7")) "0 asc 3 7")
       (check_str "another's" (state_text (ui_grid_action (UiGridState 0 false "3" 1) "p" "q.scrollto.7")) "0 asc 3 1")))

(def test_ui_grid_first () int
  (add (check_int "the selection below the view" (ui_grid_first 0 12 20 5) 8)
       (add (check_int "above it" (ui_grid_first 8 2 20 5) 2)
            (check_int "not past the end" (ui_grid_first 30 -1 20 5) 15))))

; A grid 400 by 92: its header and two of its three rows, so a
; scrollbar too.
(def row_targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f) (if (is_empty a) (row_targets (tail ns)) (append a (append " " (row_targets (tail ns)))))))))

(def small ((s UiGridState)) (list int)
  (row_targets (ui_layout (UiGrid (view s)) (Rect 0 0 400 92) (ui_state_new (UiLight)) 0)))

; Two rows show under the 32 of the header, (92 - 32) / 30, of three, so
; the most first is 1. The scrollbar's strip is the two rows, 60 high;
; its slider two thirds of it, 40, so it travels 20.
(def test_ui_grid_layout () int
  (check_str "the titles, the area scrolled, the rows that fit, sorted, the scrollbar"
    (small (UiGridState 0 false "" 0))
    "p.sort.0 p.sort.1 p.sort.2 p.scroll.0.1.2.30 p.select.1 p.select.2 p.scrollbar.0.1.20.40 "))

(def test_ui_grid_layout_scrolled () int
  (check_str "from the second row"
    (small (UiGridState 0 false "" 1))
    "p.sort.0 p.sort.1 p.sort.2 p.scroll.1.1.2.30 p.select.2 p.select.3 p.scrollbar.1.1.20.40 "))

(def test_ui_grid_layout_past_the_end () int
  (check_str "the last that can be first"
    (small (UiGridState 0 false "" 5))
    "p.sort.0 p.sort.1 p.sort.2 p.scroll.1.1.2.30 p.select.2 p.select.3 p.scrollbar.1.1.20.40 "))

; The selection is kept in view by the keys that move it, not by the
; layout, so that the wheel can scroll it away.
(def test_ui_grid_selection_scrolled_away () int
  (check_str "the third selected, not shown"
    (small (UiGridState 0 false "3" 0))
    "p.sort.0 p.sort.1 p.sort.2 p.scroll.0.1.2.30 p.select.1 p.select.2 p.scrollbar.0.1.20.40 "))

; All three fit in a grid 400 by 122: no scrollbar, and the area cannot
; scroll.
(def test_ui_grid_no_scrollbar () int
  (check_str "the area only"
    (row_targets (ui_layout (UiGrid (view (UiGridState 0 false "" 0))) (Rect 0 0 400 122) (ui_state_new (UiLight)) 0))
    "p.sort.0 p.sort.1 p.sort.2 p.scroll.0.0.3.30 p.select.1 p.select.2 p.select.3 "))

(def strip_of ((ns (list UiNode))) (list int)
  (match (ui_scrollbar_named ns "p")
    ((None) "none")
    ((Some n) (match (ui_node_rect n) ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))))

; The strip along the right, 12 wide, from under the header, the rows'
; height.
(def test_ui_grid_scrollbar_strip () int
  (check_str "388,32 12x60" (strip_of (ui_layout (UiGrid (view (UiGridState 0 false "" 0))) (Rect 0 0 400 92) (ui_state_new (UiLight)) 0)) "388,32 12x60"))

; ----------------------------------------------------------------- pages

(def test_ui_selected_line () int
  (add (check_str "none selected" (ui_selected_line (UiGridState 0 false "" 0) "Select a process") "Select a process")
       (check_str "one" (ui_selected_line (UiGridState 0 false "7" 0) "Select a process") "Process 7 selected")))
