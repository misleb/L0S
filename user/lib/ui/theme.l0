; theme.l0 -- the toolkit's look: GNOME's Adwaita, as libadwaita draws it.
; Its palette of named colors, the semantic colors widgets are drawn in,
; in the light style and the dark, and the sizes and spacings of the
; GNOME Human Interface Guidelines. Colors are as the frame keeps them,
; red in bits 16 to 23, green 8 to 15, blue 0 to 7.
;
; Adwaita draws many colors with alpha, a border as 15% of the text's
; color say. No layer here blends, so each is mixed here instead, with
; ui_mix, over the color it is drawn on. Depends on nothing, so a program
; that wants only the colors, such as draw, links this file alone.

; ------------------------------------------------------------------ colors

; The color six hex digits RRGGBB spell; 0 for anything else.
(def ui_hex ((s (list int))) int (ui_hex_onto s 0))

(def ui_hex_onto ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (let d (hex_val (head s))
        (if (lt d 0) 0 (ui_hex_onto (tail s) (bit_or (bit_shl acc 4) d))))))

(def ui_red_of ((c int)) int (bit_and (bit_shr c 16) 255))
(def ui_green_of ((c int)) int (bit_and (bit_shr c 8) 255))
(def ui_blue_of ((c int)) int (bit_and c 255))

(def ui_rgb ((r int) (g int) (b int)) int
  (bit_or (bit_shl r 16) (bit_or (bit_shl g 8) b)))

; a drawn at pct percent over b: what a color of alpha pct / 100 shows
; as, on b.
(def ui_mix ((a int) (b int) (pct int)) int
  (let p (max 0 (min 100 pct))
    (ui_rgb (ui_mix_channel (ui_red_of a) (ui_red_of b) p)
            (ui_mix_channel (ui_green_of a) (ui_green_of b) p)
            (ui_mix_channel (ui_blue_of a) (ui_blue_of b) p))))

(def ui_mix_channel ((a int) (b int) (p int)) int
  (div (add (add (mul a p) (mul b (sub 100 p))) 50) 100))

; ----------------------------------------------------------------- palette

; libadwaita's named colors, five shades of each hue, 1 the lightest,
; and of light and dark grays: name, then RRGGBB.
(def ui_palette () (list (list int))
  (split_spaces (append
    "blue_1 99c1f1 blue_2 62a0ea blue_3 3584e4 blue_4 1c71d8 blue_5 1a5fb4 "
    (append
    "green_1 8ff0a4 green_2 57e389 green_3 33d17a green_4 2ec27e green_5 26a269 "
    (append
    "yellow_1 f9f06b yellow_2 f8e45c yellow_3 f6d32d yellow_4 f5c211 yellow_5 e5a50a "
    (append
    "orange_1 ffbe6f orange_2 ffa348 orange_3 ff7800 orange_4 e66100 orange_5 c64600 "
    (append
    "red_1 f66151 red_2 ed333b red_3 e01b24 red_4 c01c28 red_5 a51d2d "
    (append
    "purple_1 dc8add purple_2 c061cb purple_3 9141ac purple_4 813d9c purple_5 613583 "
    (append
    "brown_1 cdab8f brown_2 b5835a brown_3 986a44 brown_4 865e3c brown_5 63452c "
    (append
    "light_1 ffffff light_2 f6f5f4 light_3 deddda light_4 c0bfbc light_5 9a9996 "
    (append
    "dark_1 77767b dark_2 5e5c64 dark_3 3d3846 dark_4 241f31 dark_5 000000 "
    "accent 3584e4 destructive e01b24 success 2ec27e warning e5a50a error e01b24")))))))))))

; A palette color by name, or none.
(def ui_color_named ((name (list int))) (Option int)
  (ui_color_in (ui_palette) name))

(def ui_color_in ((ws (list (list int))) (name (list int))) (Option int)
  (if (if (is_empty ws) true (is_empty (tail ws)))
      ((None int))
      (if (eq (head ws) name)
          (Some (ui_hex (head (tail ws))))
          (ui_color_in (tail (tail ws)) name))))

; Every name the palette has, in order.
(def ui_palette_names () (list (list int))
  (ui_every_other (ui_palette) (nil (list int))))

(def ui_every_other ((ws (list (list int))) (acc (list (list int)))) (list (list int))
  (if (if (is_empty ws) true (is_empty (tail ws)))
      (rev acc)
      (ui_every_other (tail (tail ws)) (cons (head ws) acc))))

; The named colors used below.
(def ui_blue_2 () int (ui_hex "62a0ea"))
(def ui_blue_3 () int (ui_hex "3584e4"))
(def ui_green_4 () int (ui_hex "2ec27e"))
(def ui_yellow_5 () int (ui_hex "e5a50a"))
(def ui_red_3 () int (ui_hex "e01b24"))
(def ui_white () int (ui_hex "ffffff"))
(def ui_black () int 0)

; ------------------------------------------------------------------ styles

; Adwaita's two styles: light, the default, and dark.
(data UiStyle (UiLight) (UiDark))

(def ui_is_dark ((s UiStyle)) bool (match s ((UiLight) false) ((UiDark) true)))

; The style programs draw in.
(def ui_style () UiStyle (UiLight))

; Where widgets sit: a window's background, and a view's, the lighter
; ground of lists, grids, and text.
(def ui_window_bg ((s UiStyle)) int (if (ui_is_dark s) (ui_hex "242424") (ui_hex "fafafa")))
(def ui_view_bg ((s UiStyle)) int (if (ui_is_dark s) (ui_hex "1e1e1e") (ui_hex "ffffff")))
(def ui_card_bg ((s UiStyle)) int (if (ui_is_dark s) (ui_hex "363636") (ui_hex "ffffff")))

; Text: 80% black on light, white on dark.
(def ui_fg ((s UiStyle)) int (if (ui_is_dark s) (ui_white) (ui_mix (ui_black) (ui_window_bg s) 80)))

; A header bar's, in front and in the backdrop, where its window is not.
(def ui_headerbar_bg ((s UiStyle) (active bool)) int
  (if (ui_is_dark s)
      (if active (ui_hex "303030") (ui_hex "242424"))
      (if active (ui_hex "ebebeb") (ui_hex "fafafa"))))

(def ui_headerbar_fg ((s UiStyle) (active bool)) int
  (if active (ui_fg s) (ui_mix (ui_fg s) (ui_headerbar_bg s active) 50)))

; The line under a header bar: 12% black, or 36% on dark, a little more
; than Adwaita's 7%, which with no blending would hardly show.
(def ui_headerbar_shade ((s UiStyle) (active bool)) int
  (ui_mix (ui_black) (ui_headerbar_bg s active) (if (ui_is_dark s) 36 12)))

; Text that matters less: 55% of the text's color.
(def ui_dim_fg ((s UiStyle) (bg int)) int (ui_mix (ui_fg s) bg 55))

; Borders and separators: 15% of the text's color.
(def ui_border ((s UiStyle) (bg int)) int (ui_mix (ui_fg s) bg 15))

; The accent, blue_3, with white on it; as text, a shade that reads on
; the ground.
(def ui_accent_bg () int (ui_blue_3))
(def ui_accent_fg () int (ui_white))
(def ui_accent_color ((s UiStyle)) int (if (ui_is_dark s) (ui_hex "78aeed") (ui_hex "1c71d8")))

(def ui_destructive_bg () int (ui_red_3))
(def ui_success () int (ui_green_4))
(def ui_warning () int (ui_yellow_5))
(def ui_error () int (ui_red_3))

; A row the pointer is over, and a selected row, on bg.
(def ui_hover_bg ((s UiStyle) (bg int)) int (ui_mix (ui_fg s) bg 4))
(def ui_selected_bg ((bg int)) int (ui_mix (ui_accent_bg) bg 25))

; A scrollbar's slider on bg: the text's color at 40%, and at 60% while
; the pointer is over it or drags it.
(def ui_slider_fg ((s UiStyle) (bg int) (active bool)) int (ui_mix (ui_fg s) bg (if active 60 40)))

; A sidebar's ground, as libadwaita's navigation sidebar has it, and a
; selected row's on it: the text's color at 10%.
(def ui_sidebar_bg ((s UiStyle)) int (if (ui_is_dark s) (ui_hex "2e2e32") (ui_hex "ebebed")))
(def ui_sidebar_selected_bg ((s UiStyle)) int (ui_mix (ui_fg s) (ui_sidebar_bg s) 10))

; What a dialog does to the window beneath it: every color there mixed
; with black at 30%, as libadwaita's dimming shows on light.
(def ui_scrim ((c int)) int (ui_mix (ui_black) c 30))

; The keyboard focus ring: the accent at half.
(def ui_focus_ring ((bg int)) int (ui_mix (ui_accent_bg) bg 50))

; A terminal's ground, text, and cursor, as GNOME Console has them.
(def ui_term_bg () int (ui_hex "1e1e1e"))
(def ui_term_fg () int (ui_hex "ffffff"))
(def ui_term_cursor () int (ui_hex "ffffff"))

; What the desktop shows where there is no wallpaper: dark_4.
(def ui_desktop_bg () int (ui_hex "241f31"))

; ----------------------------------------------------------------- metrics

; The HIG's spacing: 6 between related things, 12 between groups, 18
; around a page.
(def ui_space_s () int 6)
(def ui_space_m () int 12)
(def ui_space_l () int 18)

; Corners: a button's, and a window's or a card's.
(def ui_button_radius () int 6)
(def ui_window_radius () int 12)

; A header bar's height, and a button's: 34, its 16 rows of text with 9
; above and below; a title bar's own buttons, round, 24.
(def ui_headerbar_h () int 46)
(def ui_button_h () int 34)
(def ui_button_pad () int 10)
(def ui_titlebutton () int 24)

; A data grid's rows, and its header's.
(def ui_row_h () int 30)
(def ui_grid_header_h () int 32)

; An overlay scrollbar, as GTK's: its slider 6 wide, 3 in from the edge,
; and 8 wide while the pointer is over it or drags it; at least 24 long;
; and the strip along the edge that takes the pointer, 12 wide.
(def ui_slider_w () int 6)
(def ui_slider_wide () int 8)
(def ui_slider_margin () int 3)
(def ui_slider_min () int 24)
(def ui_scrollbar_hit_w () int 12)

; A sidebar's width, and its rows: 48, a 32-pixel icon or a title over
; a subtitle, with 8 above and below.
(def ui_sidebar_w () int 220)
(def ui_side_row_h () int 48)

; A segment bar's height that shows each part's title over its line, as
; GNOME Disks' bar of volumes does, and the narrowest a part may be, so
; that the smallest can be clicked.
(def ui_segbar_h () int 64)
(def ui_segment_min_w () int 48)

; An alert dialog: its corners, and its width, as libadwaita's.
(def ui_dialog_radius () int 12)
(def ui_dialog_w () int 320)

; How many rows a step of the scroll wheel scrolls.
(def ui_wheel_rows () int 3)

; Text: the font's cell.
(def ui_char_w () int 8)
(def ui_char_h () int 16)
