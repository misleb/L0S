; window.l0 -- a toolkit program's window: opened with the compositor,
; user/wm, its events read, and what it shows drawn. Linked with the
; compositor's protocol, user/lib/wm.l0.
;
; A program's loop, its own view and update in between:
;
;   (match (ui_open TITLE W H) ...)                  once
;   next     = (ui_win_next win)                     the window, and its next
;                                                    event, put together
;   routed   = (ui_route win event)                  the window, and the
;                                                    action set off, or ""
;   state    = update state action event
;   win      = (ui_present win (view state))
;
; ui_route does what GTK does with the pointer and keys: the pointer over
; a target is shown, a press shows it pressed, and its release over the
; same target sets off its action; Tab moves the keyboard's focus to the
; next target, and Enter or Space sets off the one it is on. It also
; scrolls what widget.l0 calls a scroller: the wheel over its area or its
; scrollbar, a press on the scrollbar's strip, and a drag of its slider
; set off NAME.scrollto.N at once, as GTK's scrolled window moves; and,
; for a scroller wider than it shows, the wheel across and its scrollbar
; across the same way, setting off NAME.acrossto.N.
;
; ui_present lays the view out, and paints only the parts that differ from
; what it painted last, telling the compositor of each.
;
; When the user drags the window's edge, the compositor asks for a size
; and ui_route makes a buffer that size (UiResize); the next ui_present
; lays the view out for it, paints all of it, and gives it to the
; compositor in place of the old one, which is then given up. A program
; needs no code for it, if its view is made from the window's size.
;
; When the compositor's close button, or the window's own, asks it to
; close, ui_route sets off win.close (ui_close_action): a program closes
; the window then, as it closes when it is done. One that does nothing
; with it presents the window again, and ui_present closes it instead,
; and has the compositor end the program, so that every program closes
; as it did when the close button killed it.

; The window: the compositor, its id there, the canvas it is drawn in,
; the port its events come to, the face (at the desktop's scale, as the
; canvas is), the widgets' state, the nodes painted last, the pointer's
; buttons as last told, and, while a scrollbar's slider is dragged, how
; far below its top the pointer holds it; the click before, to tell a
; double click; then where the canvas's buffer is, and what a resize has
; done to it that wm has not yet been told; and whether it draws its own
; decorations, so the inside of its edge resizes it; and whether its
; close has been asked, by the compositor's close notice or its own close
; button, and not yet done (ui_win_close_asked); its loop (uiloop.l0),
; which times its steps; and the pointer it last asked wm to show over
; it, as ui_cursor_names names them, "" the arrow.
(data UiWin (UiWin Compositor int Canvas int UiFace UiState (list UiNode) int int UiClick UiMem bool bool UiLoop (list int)))

; The last click: the action it set off, when, in clock_ns, and whether
; it was the second of a double click, as GTK's n-press of 2 is: the
; same action set off again within ui_double_ns.
(data UiClick (UiClick (list int) int bool))

; No click yet.
(def ui_click_none () UiClick (UiClick "" 0 false))

; The click after one, c, that set off action at t: a double if it set
; off the same as c within ui_double_ns, and c not a double itself, so a
; third click starts again.
(def ui_click_after ((c UiClick) (action (list int)) (t int)) UiClick
  (match c
    ((UiClick last at double)
      (UiClick action t (if double false (if (eq last action) (lt (sub t at) (ui_double_ns)) false))))))

; w after a release that set off action, "" for none, at t: its click
; told after the one before; a release that set off nothing is no click,
; and no double.
(def ui_win_clicked ((w UiWin) (action (list int)) (t int)) UiWin
  (match w
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (UiWin c id cv port font st ns b g (if (is_empty action) (UiClick "" t false) (ui_click_after k action t)) m csd cl lp sh))))

; Whether the last click the window routed was the second of a double
; click: a program opens what a click selects when it is, as a file
; manager does.
(def ui_win_double ((w UiWin)) bool
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (match k ((UiClick a t d) d)))))

; The scale the window is painted at, its face's: what a program loads
; its full-color icons at (face.l0's ui_images_load).
(def ui_win_scale ((w UiWin)) int
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (ui_face_scale font))))

; The address of the window's buffer, its pages, the window's width and
; height, the desktop's pixels, and a resize wm is yet to be told of. The
; canvas is all of the buffer, which may be bigger than the window, room
; to grow into: its rows are as far apart as it is wide, whatever size
; the window is, so what is painted keeps its place as the window grows
; and shrinks in it, and only what changed is painted again.
; Last, its second buffer and its pacing (UiDb).
(data UiMem (UiMem int int int int UiSwap UiDb))

; A window's second buffer, and its pacing, as Wayland's clients keep
; theirs: where wm has the buffer shown, its address there; the buffer
; not shown, if one is made yet; whether the window waits for the
; display's next frame, and for the buffer not shown to be released; and
; since when it waits, in clock_ns. A window paints only the buffer not
; shown, once neither is awaited, and gives it to wm (attach), so no
; frame shows it half painted, and it paints at most once a frame.
(data UiDb (UiDb int UiBack bool bool int))

; The buffer not shown: its address here, its pages, its canvas, all of
; it, its address in wm, 0 until it is shared, and the boxes of the
; desktop's pixels in which the buffer shown has what it has not.
(data UiBack (UiBack int int Canvas int (list Rect)) (UiNoBack))

; How long a window waits for a frame or a release before it paints all
; the same: 100 ms, a few frames, should a display tell neither.
(def ui_pace_ns () int 100000000)

; What a resize did that wm is yet to be told of: made a new buffer, the
; old one's address, pages and canvas kept until wm has the new one, with
; the window's width and height in it; or
; made the window another size in the same buffer, which had room, its
; width and height before kept to go back to if wm will not have it; or
; nothing.
(data UiSwap (UiSwap int int Canvas int int) (UiInPlace int int) (UiNoSwap))

; The window's width and height, the desktop's pixels.
(def ui_win_w ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (match m ((UiMem va n ww wh swap db) ww)))))
(def ui_win_h ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (match m ((UiMem va n ww wh swap db) wh)))))

; A window opened, or why not.
(data UiOpened (UiOpenedWin UiWin) (UiOpenFailed (list int)))

; The canvas it is painted in, all of its buffer, and its face: what a
; program paints a drawing area (widget.l0's UiDrawingArea) with, in the
; desktop's pixels, at the face's scale. After a resize into a new buffer
; the canvas is the new one, which ui_present gives wm.
(def ui_win_canvas ((w UiWin)) Canvas (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) cv)))
(def ui_win_face ((w UiWin)) UiFace (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) font)))

; wm told of rs, what a program painted in its drawing areas, in one
; damage request; nothing if rs is empty.
(def ui_win_damaged ((w UiWin) (rs (list Rect))) int
  (if (is_empty rs)
      0
      (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (let d (window_damage_many c id rs) 0)))))

; wm told the window's new title, as the top bar and run windows show it.
(def ui_win_titled ((w UiWin) (title (list int))) int
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (let t (window_title c id title) 0))))

; The pid of the compositor, which sends the window's events.
(def ui_win_wm_pid ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (compositor_pid c))))

; Its id in the compositor, which every notice about it names.
(def ui_win_id ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) id)))

; Its port, its widgets' state, and the nodes it painted last.
(def ui_win_port ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) port)))
(def ui_win_state ((w UiWin)) UiState (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) st)))
(def ui_win_nodes ((w UiWin)) (list UiNode) (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) ns)))

; w with the widgets' state st and the pointer's buttons b.
(def ui_win_with ((w UiWin) (st UiState) (b int)) UiWin
  (match w ((UiWin c id cv port font old ns ob g k m csd cl lp sh) (UiWin c id cv port font st ns b g k m csd cl lp sh))))

; How far below a dragged slider's top the pointer holds it, or, for a
; slider across, right of its left.
(def ui_win_grab ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) g)))

; w with its slider held g below its top, or right of its left.
(def ui_win_grabbing ((w UiWin) (g int)) UiWin
  (match w ((UiWin c id cv port font st ns b old k m csd cl lp sh) (UiWin c id cv port font st ns b g k m csd cl lp sh))))

; Where the scroller called name is scrolled in the window as last
; painted, for keys that keep a selection in view (ui_grid_key).
(def ui_win_scroller ((w UiWin) (name (list int))) UiScroller (ui_scroller_of (ui_win_nodes w) name))

; How many tiles go across the icon view called name, as last painted,
; for the keys that move its selection a row (ui_icon_key); one if it is
; not laid out.
(def ui_win_icon_cols ((w UiWin) (name (list int))) int
  (ui_icon_cols (ui_area_w (ui_win_nodes w) name)))

; How wide the area of the scroller called name is, 0 if there is none.
(def ui_area_w ((ns (list UiNode)) (name (list int))) int
  (if (is_empty ns)
      0
      (match (ui_scroll_of (ui_node_action (head ns)))
        ((UiScrollArea n fi m s st) (if (eq n name) (rect_w (ui_node_rect (head ns))) (ui_area_w (tail ns) name)))
        ((UiScrollBar n fi m sp sl) (ui_area_w (tail ns) name))
        ((UiNoScroll) (ui_area_w (tail ns) name)))))

; A window w by h titled title, in front, painted nothing yet: w by h of
; the desktop's pixels, its buffer and face at the desktop's scale.
(def ui_open ((title (list int)) (w int) (h int)) UiOpened (ui_open_as title w h false))

; The same, but a window that draws its own title bar, as GNOME's apps
; do: the compositor draws none, nor a frame, and the program puts a
; UiCsdBar at its top, whose ground moves the window and whose close
; button sets off ui_close_action.
(def ui_open_csd ((title (list int)) (w int) (h int)) UiOpened (ui_open_as title w h true))

; A window opened, decorated by its client if csd: the one window of an
; app (uiapp.l0) started for it, which is as a program of one window
; needs no more of.
(def ui_open_as ((title (list int)) (w int) (h int) (csd bool)) UiOpened
  (match (ui_app_start)
    ((UiAppFailed why) (UiOpenFailed why))
    ((UiAppStarted a)
      (match (ui_app_open_as a title w h csd)
        ((UiAppRefused a2 why) (UiOpenFailed why))
        ((UiAppOpened a2 id)
          (match (ui_app_win a2 id)
            ((None) (UiOpenFailed "no window"))
            ((Some win) (UiOpenedWin win))))))))

; A window of the compositor c, painted with face f, its events to port:
; w by h titled title, in front, decorated by its client if csd, painted
; nothing yet, its buffer at f's scale; or why not, its buffer given up
; again if the compositor will not have it.
(def ui_win_open ((c Compositor) (f UiFace) (port int) (title (list int)) (w int) (h int) (csd bool)) UiOpened
  (match (ui_buffer_at w h (ui_face_scale f))
    ((UiNoBuf why) (UiOpenFailed why))
    ((UiBuf va n canvas)
      (match (if csd (window_open_csd c w h va n port title) (window_open c w h va n port title))
        ((WindowFailed why) (let u (ui_buffer_free va n canvas) (UiOpenFailed why)))
        ((WindowOpened id there)
          (UiOpenedWin (UiWin c id canvas port f (ui_state_new (ui_style)) (nil UiNode) 0 0 (ui_click_none) (UiMem va n w h (UiNoSwap) (ui_db_new there)) csd false (ui_loop_new) "")))))))

; A window's second buffer and pacing as it opens, its buffer at there in
; wm: no buffer not shown yet, and nothing awaited.
(def ui_db_new ((there int)) UiDb (UiDb there (UiNoBack) false false 0))

; w painted with face f from now on, as an app's windows share its face.
(def ui_win_faced ((w UiWin) (f UiFace)) UiWin
  (match w ((UiWin c id cv port old st ns b g k m csd cl lp sh) (UiWin c id cv port f st ns b g k m csd cl lp sh))))

; The window closed, and its buffer, its buffer not shown, and any a
; resize has not yet replaced, given up.
(def ui_close ((w UiWin)) int
  (match w
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (let x (window_close c id)
            (let f (ui_buffer_free va n cv)
              (let fb (match db ((UiDb there bk fr rl since) (ui_back_free bk)))
                (match swap
                  ((UiNoSwap) 0)
                  ((UiInPlace ow oh) 0)
                  ((UiSwap ova on ocv ow oh) (ui_buffer_free ova on ocv)))))))))))

; A buffer not shown given up, if there is one: 0.
(def ui_back_free ((b UiBack)) int
  (match b ((UiBack bva bn bcv bt stale) (ui_buffer_free bva bn bcv)) ((UiNoBack) 0)))

; A buffer's side n of the desktop's pixels with room to grow: a quarter
; more, and 64.
(def ui_grown ((n int)) int (add n (add (div n 4) 64)))

; --------------------------------------------------------------- events

; What came to the window's port, each kind as beside it; a press is the
; pointer's buttons going down from none held, a release all of them
; coming up.
(data UiEvent
  (UiKey KeyEvent)
  (UiPress int int int)          ; x, y in the window, and the buttons now down
  (UiRelease int int int)
  (UiMotion int int int)
  (UiContext int int int)        ; the right button pressed, the left up: x, y, and the buttons
  (UiLeave)                      ; the pointer has gone from the window
  (UiFocus bool)                 ; the window has come to the front, or gone from it
  (UiScroll int int int int)     ; the wheel turned at x, y: its steps across, and down
  (UiResize int int)             ; the user drags the window's edge: the size wanted
  (UiCloseAsked)                 ; the compositor's close button asks the window to close
  (UiExit int int)               ; a process watched has exited: its pid, its status
  (UiOpen int (list (list int))) ; the app launched again (appopen.l0): the reply port, the arguments
  (UiReply int Message)          ; an answer to the program's ask (ui_win_ask), its tag, or -1 for the toolkit's own, a strike that came
  (UiIdle)                       ; nothing waits, and the program said it has idle work: do a piece of it
  (UiOther int (list int)))      ; anything else: who sent it, and what

; The key event ev is, or none if it is something else.
(def ui_key_of ((ev UiEvent)) (Option KeyEvent)
  (match ev
    ((UiKey k) (Some k))
    ((UiPress x y b) ((None KeyEvent))) ((UiRelease x y b) ((None KeyEvent))) ((UiMotion x y b) ((None KeyEvent)))
    ((UiContext x y b) ((None KeyEvent)))
    ((UiLeave) ((None KeyEvent))) ((UiFocus f) ((None KeyEvent))) ((UiScroll x y dx dy) ((None KeyEvent)))
    ((UiResize rw rh) ((None KeyEvent))) ((UiCloseAsked) ((None KeyEvent)))
    ((UiExit p s) ((None KeyEvent))) ((UiOpen r args) ((None KeyEvent))) ((UiOther f p) ((None KeyEvent)))
    ((UiReply t m) ((None KeyEvent))) ((UiIdle) ((None KeyEvent)))))

; The code of the key ev presses, or holds down so that it repeats; -1
; for a release, and for anything that is not a key.
(def ui_key_pressed ((ev UiEvent)) int
  (match (ui_key_of ev)
    ((None) -1)
    ((Some k) (match k ((KeyEvent code value ch mods) (if (eq value 0) -1 code))))))

; The modifiers held with the key ev is, as KeyEvent's bits
; (key_mod_shift and the rest); 0 for anything that is not a key.
(def ui_key_mods ((ev UiEvent)) int
  (match (ui_key_of ev)
    ((None) 0)
    ((Some k) (match k ((KeyEvent code value ch mods) mods)))))

; The window after its next message was taken, and what the message is.
(data UiWinNext (UiWinNext UiWin UiEvent))

; The window's next event, for a program of one window: the next message
; to its port, taken by its loop (uiloop.l0's ui_loop_take), which takes
; what waits first and puts it together, the pointer's moves and the
; wheel's turns that follow one another made one, so that a step slower
; than the pointer is not a queue of steps. What it is, as ui_event_of
; says; a port gone is UiOther from -1. An answer to one of the
; program's asks (ui_win_ask) is UiReply TAG MESSAGE; a strike font
; answered with is taken into the window's face, its text to be painted
; again, and is UiReply -1, so the program presents the window; with
; idle work (ui_win_idling) and nothing waiting, UiIdle.
(def ui_win_next ((w UiWin)) UiWinNext
  (match w
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (match (ui_loop_take lp port (compositor_pid c) (map_put ((MapEmpty int int)) id b))
        ((UiTaken lp2 got)
          (let w2 (UiWin c id cv port font st ns b g k m csd cl lp2 sh)
            (match got
              ((UiGotMsg msg) (UiWinNext w2 (ui_event_of w2 msg)))
              ((UiGotStrike payload)
                (match (ui_face_answered font payload)
                  ((UiAnswered f2 name) (UiWinNext (ui_win_restruck (ui_win_faced w2 f2) name) (UiReply -1 (RecvFailed))))))
              ((UiGotReply tag msg) (UiWinNext w2 (UiReply tag msg)))
              ((UiGotIdle) (UiWinNext w2 (UiIdle)))
              ((UiGotRedraw i) (UiWinNext w2 (UiReply -1 (RecvFailed))))
              ((UiGotLost) (UiWinNext w2 (UiOther -1 ""))))))))))

; w, a program of one window, after it asked port body, the answer to
; come as UiReply tag: sent, never waited on (uiloop.l0's ui_loop_ask).
(def ui_win_ask ((w UiWin) (tag int) (port int) (body (list int))) UiWin
  (match w ((UiWin c id cv port0 font st ns b g k m csd cl lp sh) (UiWin c id cv port0 font st ns b g k m csd cl (ui_loop_ask lp tag port body) sh))))

; w with idle work, so ui_win_next hands out UiIdle while nothing
; waits, or with none, so it waits.
(def ui_win_idling ((w UiWin) (idle bool)) UiWin
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (UiWin c id cv port font st ns b g k m csd cl (ui_loop_idling lp idle) sh))))

; The kernel's alarm asked for the window's port at t, in clock_ns, in
; place of any earlier: it comes as an event ui_is_alarm says is one, so
; a window that refreshes on a timer waits for it rather than polls.
(def ui_win_alarm ((w UiWin) (t int)) UiWin
  (let a (alarm_at (ui_win_port w) t) w))

; Whether ev is the kernel's alarm (alarm_at), as ui_message_event gives
; it: UiOther from the kernel, pid 0, saying alarm.
(def ui_is_alarm ((ev UiEvent)) bool
  (match ev
    ((UiOther from p) (if (eq from 0) (eq p "alarm") false))
    ((UiIdle) false) ((UiReply t m) false) ((UiOpen r args) false) ((UiKey k) false) ((UiPress x y b) false) ((UiRelease x y b) false)
    ((UiMotion x y b) false) ((UiContext x y b) false) ((UiLeave) false) ((UiFocus f) false)
    ((UiScroll x y dx dy) false) ((UiResize rw rh) false) ((UiCloseAsked) false) ((UiExit p s) false)))

; w with its loop's reply ports rport and aport, as its app's.
(def ui_win_ported ((w UiWin) (rport int) (aport int)) UiWin
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (UiWin c id cv port font st ns b g k m csd cl (ui_loop_ports rport aport) sh))))

; w once strike name has come: the text drawn from it no longer counted
; as painted, so the next present paints it, and every keyed part laid
; out again (its marks forgotten), as its nodes may hold such text.
(def ui_win_restruck ((w UiWin) (name (list int))) UiWin
  (if (is_empty name)
      w
      (match w
        ((UiWin c id cv port font st ns b g k m csd cl lp sh)
          (UiWin c id cv port font st (ui_nodes_restruck ns name (ui_face_scale font) (nil UiNode)) b g k m csd cl lp sh)))))

; Each of ns with its text from strike name, at face scale s, left out,
; and no mark, onto the reversed acc.
(def ui_nodes_restruck ((ns (list UiNode)) (name (list int)) (s int) (acc (list UiNode))) (list UiNode)
  (if (is_empty ns)
      (rev acc)
      (match (head ns)
        ((UiNode r ops a f)
          (ui_nodes_restruck (tail ns) name s
            (cons (UiNode r (ui_ops_without ops name s (nil UiPaint)) (if (starts_with a "ui.kept.") "" a) f) acc))))))

; ops but the text drawn from strike name at face scale s, onto the
; reversed acc.
(def ui_ops_without ((ops (list UiPaint)) (name (list int)) (s int) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty ops)
      (rev acc)
      (ui_ops_without (tail ops) name s
        (match (head ops)
          ((UiPText r t a c font b sc) (if (eq (ui_text_strike font b sc s) name) acc (cons (head ops) acc)))
          ((UiPFill r c) (cons (head ops) acc))
          ((UiPRound r rad c u) (cons (head ops) acc))
          ((UiPIcon x y n c sc) (cons (head ops) acc))
          ((UiPImage x y n d ts) (cons (head ops) acc))))))

; Whether ev says the port is gone, as a receive that failed gives
; (UiOther from -1): the loop has nothing more to wait for.
(def ui_event_lost ((ev UiEvent)) bool
  (match ev
    ((UiOther from p) (lt from 0)) ((UiKey k) false) ((UiPress x y b) false) ((UiRelease x y b) false)
    ((UiMotion x y b) false) ((UiContext x y b) false) ((UiLeave) false) ((UiFocus f) false)
    ((UiScroll x y dx dy) false) ((UiResize w h) false) ((UiCloseAsked) false) ((UiExit p s) false)
    ((UiOpen r args) false) ((UiReply t m) false) ((UiIdle) false)))

; What a message to the window's port is. The compositor names the window
; each of its notices is about (l0s.l0's win_notice): one about another
; window is UiOther; anything that is no window notice, ui_message_event.
(def ui_event_of ((w UiWin) (m Message)) UiEvent
  (match w
    ((UiWin c id cv port font st ns held g k mem csd cl lp sh)
      (match m
        ((RecvFailed) (UiOther -1 ""))
        ((Message from b)
          (if (if (eq from (compositor_pid c)) (gt from 0) false)
              (match (win_notice_of m)
                ((WinNotice wid at) (if (eq wid id) (ui_from_wm m at held from b) (UiOther from (msg_text b))))
                ((NoWinNotice) (ui_message_event m)))
              (ui_message_event m)))))))

; What a message m that is no window's notice is: a watched process's
; exit, the app launched again (an open, appopen.l0's, which the
; compositor sends; one that does not read is answered as an open of no
; arguments), or anything else.
(def ui_message_event ((m Message)) UiEvent
  (match m
    ((RecvFailed) (UiOther -1 ""))
    ((Message from b)
      (match (exit_of m)
        ((Exited pid status) (UiExit pid status))
        ((NotExit)
          (match (app_open_of m)
            ((AppOpenAsked r args) (UiOpen r args))
            ((AppOpenBad r why) (UiOpen r (nil (list int))))
            ((NotAppOpen) (UiOther from (msg_text b)))))))))

; The action an open sets off, the app launched again: GApplication's
; activate and open, as one.
(def ui_open_action () (list int) "app.open")

; The arguments of an open, ev, as it came: paths or URLs, or none; none
; for any other event.
(def ui_open_args ((ev UiEvent)) (list (list int))
  (match ev
    ((UiOpen r args) args)
    ((UiKey k) (nil (list int))) ((UiPress x y b) (nil (list int))) ((UiRelease x y b) (nil (list int)))
    ((UiMotion x y b) (nil (list int))) ((UiContext x y b) (nil (list int))) ((UiLeave) (nil (list int)))
    ((UiFocus f) (nil (list int))) ((UiScroll x y dx dy) (nil (list int))) ((UiResize rw rh) (nil (list int)))
    ((UiCloseAsked) (nil (list int))) ((UiExit p s) (nil (list int))) ((UiOther f p) (nil (list int)))
    ((UiReply t m) (nil (list int))) ((UiIdle) (nil (list int)))))

; The port an open, ev, wants its answer on; -1 for any other event.
(def ui_open_reply ((ev UiEvent)) int
  (match ev
    ((UiOpen r args) r)
    ((UiKey k) -1) ((UiPress x y b) -1) ((UiRelease x y b) -1) ((UiMotion x y b) -1) ((UiContext x y b) -1)
    ((UiLeave) -1) ((UiFocus f) -1) ((UiScroll x y dx dy) -1) ((UiResize rw rh) -1) ((UiCloseAsked) -1)
    ((UiExit p s) -1) ((UiOther f p) -1) ((UiReply t m) -1) ((UiIdle) -1)))

; A reply to the program's ask: its tag and message; or none.
(data UiReplyOf (UiReplyTo int Message) (UiNoReply))

; The tag and message of a reply, ev, to the program's ask (ui_win_ask,
; ui_app_ask), if it is one; none for the toolkit's own, a strike, and
; any other event.
(def ui_reply_of ((ev UiEvent)) UiReplyOf
  (match ev
    ((UiReply t m) (if (ge t 0) (UiReplyTo t m) (UiNoReply)))
    ((UiOpen r args) (UiNoReply)) ((UiKey k) (UiNoReply)) ((UiPress x y b) (UiNoReply)) ((UiRelease x y b) (UiNoReply))
    ((UiMotion x y b) (UiNoReply)) ((UiContext x y b) (UiNoReply)) ((UiLeave) (UiNoReply)) ((UiFocus f) (UiNoReply))
    ((UiScroll x y dx dy) (UiNoReply)) ((UiResize rw rh) (UiNoReply)) ((UiCloseAsked) (UiNoReply)) ((UiExit p s) (UiNoReply))
    ((UiOther f p) (UiNoReply)) ((UiIdle) (UiNoReply))))

; Whether ev is idle work's turn.
(def ui_is_idle ((ev UiEvent)) bool
  (match ev
    ((UiIdle) true)
    ((UiReply t m) false) ((UiOpen r args) false) ((UiKey k) false) ((UiPress x y b) false) ((UiRelease x y b) false)
    ((UiMotion x y b) false) ((UiContext x y b) false) ((UiLeave) false) ((UiFocus f) false)
    ((UiScroll x y dx dy) false) ((UiResize rw rh) false) ((UiCloseAsked) false) ((UiExit p s) false)
    ((UiOther f p) false)))

; The open ev answered: window id to be brought forward, 0 for the app's
; front one, told to its reply port, whatever came of it, so that it
; never waits (port_tell); nothing for any other event.
(def ui_open_answer ((ev UiEvent) (id int)) int
  (let r (ui_open_reply ev)
    (if (le r 0) 0 (port_tell r (app_shown id)))))

; A window notice from the compositor, m with bytes b from from, its
; notice at byte at of the payload: a key, the pointer
; (ui_pointer_event), the wheel, or another notice.
(def ui_from_wm ((m Message) (at int) (held int) (from int) (b bytes)) UiEvent
  (match (key_event_at m at)
    ((Some k) (UiKey k))
    ((None)
      (match (pointer_event_at m at)
        ((Some p) (match p ((PointerEvent x y b) (ui_pointer_event x y (bit_and b 3) held))))
        ((None)
          (match (wheel_event_at m at)
            ((Some e) (match e ((WheelEvent x y dx dy) (UiScroll x y dx dy))))
            ((None) (ui_notice_of m at from b))))))))

; The pointer at x, y holding buttons b, the left 1 and the right 2, the
; middle dropped before this: a press or a release of the left, by b
; beside held, the buttons before; a press of the right while the left is
; up, which asks for a context menu, as GTK's secondary click; else a
; motion. Only the left presses and clicks, as wm's does.
(def ui_pointer_event ((x int) (y int) (b int) (held int)) UiEvent
  (let lb (bit_and b 1)
    (let lh (bit_and held 1)
      (if (if (eq lh 0) (eq lb 1) false)
          (UiPress x y b)
          (if (if (eq lh 1) (eq lb 0) false)
              (UiRelease x y b)
              (if (if (eq lb 0) (if (eq (bit_and held 2) 0) (not (eq (bit_and b 2) 0)) false) false)
                  (UiContext x y b)
                  (UiMotion x y b)))))))

; A compositor's notice: the pointer gone, the window asked to close, come
; to the front or gone from it, a size asked for, or anything else; b is
; m's bytes,
; the notice at byte at of its payload.
(def ui_notice_of ((m Message) (at int) (from int) (b bytes)) UiEvent
  (if (is_leave_notice_at m at)
      (UiLeave)
      (if (is_close_notice_at m at)
          (UiCloseAsked)
          (ui_notice_more m at from b))))

; More of ui_notice_of: the focus, a size, or anything else.
(def ui_notice_more ((m Message) (at int) (from int) (b bytes)) UiEvent
  (match (focus_notice_at m at)
    ((Some front) (UiFocus front))
    ((None)
      (match (size_notice_at m at)
        ((Some ns) (UiResize (nth ns 0) (nth ns 1)))
        ((None)
          (if (ge (shown_notice_at m at) 0)
              (UiOther from (ui_frame_told))
              (if (ge (release_notice_at m at) 0)
                  (UiOther from (ui_release_told))
                  (UiOther from (msg_text b)))))))))

; What a frame notice of the window, and a release of its buffer not
; shown, are as events: UiOther from the compositor, saying so, which
; ui_route takes, so the next ui_present paints what is waiting.
(def ui_frame_told () (list int) "ui.frame")
(def ui_release_told () (list int) "ui.release")

; The window after an event, and the action it set off, or "".
(data UiRouted (UiRouted UiWin (list int)))

; What ev does to the window, as this file's header says: the pointer,
; the wheel and keys each by its own; a release sets off what was pressed
; if it is over the same target, and leaves nothing pressed; leaving
; shows nothing under the pointer; and the focus moves the window in front
; or into the backdrop. A process's exit and anything else do nothing.
; The compositor's close notice, and a click on the window's own close
; button, set off ui_close_action, win.close, as GTK's close-request: the
; window kept as asked to close (ui_win_close_asked), so that if the
; program does nothing with it, the next ui_present closes it. An open,
; the app launched again, sets off app.open and is answered shown 0, so
; that the compositor brings the window forward: a program of one
; window opens nothing more (uiapp.l0's UiApp can).
; The route is timed, its start and end kept in the window's loop
; (uiloop.l0), as a step's first stage.
(def ui_route ((w UiWin) (ev UiEvent)) UiRouted
  (let t0 (clock_ns)
    (match (ui_route_of w ev)
      ((UiRouted w2 a)
        (let w3 (ui_win_times w2 (ui_times_routed (ui_win_times_of w2) t0 (clock_ns)))
          (if (eq a (ui_close_action)) (UiRouted (ui_win_closing w3 true) a) (UiRouted w3 a)))))))

; The window's loop's times, and w with others.
(def ui_win_times_of ((w UiWin)) UiTimes (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (ui_loop_times lp))))
(def ui_win_times ((w UiWin) (t UiTimes)) UiWin
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (UiWin c id cv port font st ns b g k m csd cl (ui_loop_timed lp t) sh))))

; ui_route's event, before a close is kept.
(def ui_route_of ((w UiWin) (ev UiEvent)) UiRouted
  (let st (ui_win_state w)
    (let ns (ui_win_nodes w)
      (match w
        ((UiWin c id cv port font old nodes held g k m csd cl lp sh)
          (match ev
            ((UiResize rw rh) (UiRouted (ui_resized w rw rh) ""))
            ((UiCloseAsked) (UiRouted w (ui_close_action)))
            ((UiMotion x y b) (ui_motion_routed w st x y b))
            ((UiPress x y b) (ui_press_routed w st x y b))
            ((UiScroll x y dx dy) (if (eq dy 0) (ui_wheel_across_routed w x y dx) (ui_wheel_routed w x y dy)))
            ((UiRelease x y b)
              (let t (ui_hit ns x y)
                (let p (ui_st_pressed st)
                  (let a (if (if (is_empty p) false (eq p t)) p "")
                    (UiRouted (ui_win_released (ui_win_with w (ui_st_pressing (ui_st_hovering st t) "") b) p a (clock_ns)) a)))))
            ((UiContext x y b)
              (let t (ui_hit ns x y)
                (UiRouted (ui_win_with w (ui_st_hovering st t) b) (ui_context_action x y t))))
            ((UiLeave) (UiRouted (ui_win_with w (ui_st_hovering st "") held) ""))
            ((UiFocus front) (UiRouted (ui_win_with w (ui_st_backdropped st (not front)) held) ""))
            ((UiKey k) (ui_keyed w k))
            ((UiExit pid status) (UiRouted w ""))
            ((UiOpen r args) (let t (ui_open_answer ev 0) (UiRouted w (ui_open_action))))
            ((UiReply t m) (UiRouted w ""))
            ((UiIdle) (UiRouted w ""))
            ((UiOther from payload)
              (UiRouted (if (eq payload (ui_frame_told)) (ui_win_paced_by w true false)
                            (if (eq payload (ui_release_told)) (ui_win_paced_by w false true) w))
                        ""))))))))

; w once its frame came, if frame, and its buffer not shown was
; released, if released: no longer waiting for either.
(def ui_win_paced_by ((w UiWin) (frame bool) (released bool)) UiWin
  (match w
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match db
            ((UiDb there bk fr rl since)
              (UiWin c id cv port font st ns b g k
                     (UiMem va n ww wh swap (UiDb there bk (if frame false fr) (if released false rl) since)) csd cl lp sh))))))))

; Whether the window waits still, at now, for its frame or the release
; of its buffer not shown, so ui_present paints nothing yet: not past
; ui_pace_ns of waiting.
(def ui_win_waits ((w UiWin) (now int)) bool
  (match w
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match db
            ((UiDb there bk fr rl since)
              (if (if fr true rl) (lt (sub now since) (ui_pace_ns)) false))))))))

; ---------------------------------------------------------- context menus

; The right button pressed at x, y over what sets off target, "" for
; nothing: the action context.X.Y.TARGET, which a program answers with a
; popover menu there for what target names, as GTK's secondary click
; does. A right press is no press: nothing is pressed or clicked.
(def ui_context_action ((x int) (y int) (target (list int))) (list int)
  (append "context." (append (digits x) (append "." (append (digits y) (append "." target))))))

; Where a context menu was asked for, and over what: x, y in the window,
; and the action of what the pointer was over, "" for nothing.
(data UiContextAt (UiContextAt int int (list int)))

; What a context action says, if action is one.
(def ui_context_of ((action (list int))) (Option UiContextAt)
  (if (not (starts_with action "context."))
      ((None UiContextAt))
      (let rest (drop_n action 8)
        (let xs (up_to 46 rest)
          (let after_x (drop_n rest (add (length xs) 1))
            (let ys (up_to 46 after_x)
              (if (if (is_number xs) (if (is_number ys) (lt (length ys) (length after_x)) false) false)
                  (Some (UiContextAt (int_prefix xs 0) (int_prefix ys 0) (drop_n after_x (add (length ys) 1))))
                  ((None UiContextAt)))))))))

; A motion: the pointer shown over its target, and while a scrollbar's
; slider is held, its scroller scrolled to keep the slider under the
; pointer where it was taken.
(def ui_motion_routed ((w UiWin) (st UiState) (x int) (y int) (b int)) UiRouted
  (let w2 (ui_pointer_asked (ui_win_with w (ui_st_hovering st (ui_hit (ui_win_nodes w) x y)) b) x y)
    (if (eq b 0)
        (UiRouted w2 "")
        (match (ui_scroll_of (ui_st_pressed st))
          ((UiScrollBar name f m sp sl) (UiRouted w2 (ui_slid_to (ui_win_nodes w) name (sub y (ui_win_grab w)))))
          ((UiScrollArea name f m s st) (UiRouted w2 ""))
          ((UiNoScroll)
            (match (ui_across_of (ui_st_pressed st))
              ((UiAcrossBar name l m sp sl) (UiRouted w2 (ui_across_slid_to (ui_win_nodes w) name (sub x (ui_win_grab w)))))
              ((UiAcrossArea name l m) (UiRouted w2 ""))
              ((UiNoAcross) (UiRouted w2 ""))))))))

; w with the pointer for x, y in it asked of wm (proto/wm.l0's cursor
; request), unless it is the one asked last, which wm still shows over
; the window: so a motion that keeps the pointer asks nothing.
(def ui_pointer_asked ((w UiWin) (x int) (y int)) UiWin
  (let want (ui_pointer_at w x y)
    (match w
      ((UiWin c id cv port font st ns b g k m csd cl lp sh)
        (if (eq want sh)
            w
            (let r (window_cursor c id want)
              (UiWin c id cv port font st ns b g k m csd cl lp want)))))))

; The pointer x, y in the window wants, as GTK's widgets set theirs:
; inside the edge of a window that draws its own decorations, the resize
; pointer of the edges a press there resizes it by (ui_csd_edges), as
; wm shows over the border outside; over an entry, the I-beam, text;
; else the arrow, "".
(def ui_pointer_at ((w UiWin) (x int) (y int)) (list int)
  (let e (if (ui_win_csd w) (ui_csd_edges (ui_win_w w) (ui_win_h w) x y) 0)
    (if (not (eq e 0))
        (ui_edges_pointer e)
        (if (is_empty (ui_entry_name_of (ui_hit (ui_win_nodes w) x y))) "" "text"))))

; The resize pointer of edges e, as window_edge_left and the others add:
; across for the left or right, up and down for the top or bottom, and
; for a corner the diagonal it moves along; "" for none.
(def ui_edges_pointer ((e int)) (list int)
  (let across (not (eq (bit_and e (add (window_edge_left) (window_edge_right))) 0))
    (let down (not (eq (bit_and e (add (window_edge_top) (window_edge_bottom))) 0))
      (if (not down)
          (if across "ew-resize" "")
          (if (not across)
              "ns-resize"
              (if (eq (eq (bit_and e (window_edge_left)) 0) (eq (bit_and e (window_edge_top)) 0)) "nwse-resize" "nesw-resize"))))))

; The pointer the window last asked wm for.
(def ui_win_pointer ((w UiWin)) (list int) (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) sh)))

; A press: its target shown pressed, and the focus gone, as GTK's does.
; On a scrollbar's slider, the slider is taken where it was pressed; on
; its strip off the slider, the slider is brought there, its middle under
; the pointer, and taken by its middle.
(def ui_press_routed ((w UiWin) (st UiState) (x int) (y int) (b int)) UiRouted
  (let ns (ui_win_nodes w)
    (let t (ui_hit ns x y)
      (let e (if (if (ui_win_csd w) (eq (bit_and b 1) 1) false) (ui_csd_edges (ui_win_w w) (ui_win_h w) x y) 0)
        (if (not (eq e 0))
            (ui_press_edges w st e b)
            (if (eq t (ui_move_action))
                (ui_press_move w st t b)
                (if (is_empty (ui_entry_name_of t))
                    (ui_press_target w st ns t x y b)
                    (ui_press_entry w st ns t x b))))))))

; Whether the window has been asked to close, by the compositor's close
; button or its own, since it was last presented: ui_route keeps it so.
(def ui_win_close_asked ((w UiWin)) bool (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) cl)))

; w asked to close, or, if not asked, kept open: what a program calls
; with false when it answers win.close by keeping the window, as an app
; asking first whether to save would, so that ui_present does not close it.
(def ui_win_closing ((w UiWin) (asked bool)) UiWin
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (UiWin c id cv port font st ns b g k m csd asked lp sh))))

; w kept open after win.close, as ui_win_closing with false.
(def ui_win_close_kept ((w UiWin)) UiWin (ui_win_closing w false))

; Whether the window draws its own decorations.
(def ui_win_csd ((w UiWin)) bool (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) csd)))

; The edges of a window ww by wh whose inside x, y in it is on, as
; window_edge_left and the others added, or 0 if none: within ui_csd_edge
; of a side, that side, and there within ui_csd_corner of a corner, both
; the edges that meet there, as the compositor's corners are.
(def ui_csd_edges ((ww int) (wh int) (x int) (y int)) int
  (let e (ui_csd_edge)
    (if (not (or (or (lt x e) (ge x (sub ww e))) (or (lt y e) (ge y (sub wh e)))))
        0
        (let c (ui_csd_corner)
          (add (if (lt x c) (window_edge_left) (if (ge x (sub ww c)) (window_edge_right) 0))
               (if (lt y c) (window_edge_top) (if (ge y (sub wh c)) (window_edge_bottom) 0)))))))

; A left press inside the edges e of a window that draws its own
; decorations: the compositor asked to resize it by them with the pointer
; at once, as xdg_toplevel's resize is asked on the press; nothing left
; pressed or under the pointer, and no click told, since the compositor
; takes the drag and its release. It sets off nothing.
(def ui_press_edges ((w UiWin) (st UiState) (e int) (b int)) UiRouted
  (match w
    ((UiWin c id cv port font old ns held g k m csd cl lp sh)
      (let r (window_edges c id e)
        (match (ui_win_with w (ui_st_pressing (ui_st_hovering st "") "") b)
          ((UiWin c2 id2 cv2 port2 font2 st2 ns2 b2 g2 ok m2 csd2 cl2 lp2 sh2)
            (UiRouted (UiWin c2 id2 cv2 port2 font2 st2 ns2 b2 g2 (ui_click_none) m2 csd2 cl2 lp2 sh2) "")))))))

; A press on a header bar's ground, in a window that draws its own: the
; compositor asked to move the window with the pointer at once, as
; xdg_toplevel's move is asked on the press, or, if it is the second
; press of a double click there, to maximize it or restore it, as GTK's
; header bar does; and nothing left pressed or focused. The press is the
; click told, since the compositor takes the release. It sets off nothing.
(def ui_press_move ((w UiWin) (st UiState) (t (list int)) (b int)) UiRouted
  (match w
    ((UiWin c id cv port font old ns held g k m csd cl lp sh)
      (let k2 (ui_click_after k t (clock_ns))
        (let e (if (match k2 ((UiClick a at d) d)) (window_maximize c id) (window_move c id))
          (match (ui_win_with w (ui_st_focusing (ui_st_pressing (ui_st_hovering st t) "") "") b)
            ((UiWin c2 id2 cv2 port2 font2 st2 ns2 b2 g2 ok m2 csd2 cl2 lp2 sh2)
              (UiRouted (UiWin c2 id2 cv2 port2 font2 st2 ns2 b2 g2 k2 m2 csd2 cl2 lp2 sh2) ""))))))))

; The click told after a release that set off a, nothing pressed before
; it being p: the one told before kept, if it was a press on a header
; bar's ground, whose release the compositor took, so a second press
; there makes a double; else as ui_win_clicked tells it.
(def ui_win_released ((w UiWin) (p (list int)) (a (list int)) (t int)) UiWin
  (match w
    ((UiWin c id cv port font st ns b g k m csd cl lp sh)
      (if (if (is_empty p) (match k ((UiClick last at d) (eq last (ui_move_action)))) false)
          w
          (ui_win_clicked w a t)))))

; A press on an entry: the focus on it, nothing left pressed, and its
; cursor placed under the pointer, as GtkEntry does.
(def ui_press_entry ((w UiWin) (st UiState) (ns (list UiNode)) (t (list int)) (x int) (b int)) UiRouted
  (UiRouted (ui_win_with w (ui_st_focusing (ui_st_pressing (ui_st_hovering st t) "") t) b)
            (match (ui_node_with ns t)
              ((None) "")
              ((Some n) (ui_entry_place_action (ui_entry_name_of t) (ui_entry_char_at n x))))))

; The last node whose action is a, if one is.
(def ui_node_with ((ns (list UiNode)) (a (list int))) (Option UiNode)
  (ui_node_with_onto ns a ((None UiNode))))

; ui_node_with's loop: found, the last node so far whose action is a,
; replaced by any later one.
(def ui_node_with_onto ((ns (list UiNode)) (a (list int)) (found (Option UiNode))) (Option UiNode)
  (if (is_empty ns)
      found
      (ui_node_with_onto (tail ns) a (if (eq (ui_node_action (head ns)) a) (Some (head ns)) found))))

; A press on anything else: shown pressed, and on a scrollbar, down or
; across, scrolled.
(def ui_press_target ((w UiWin) (st UiState) (ns (list UiNode)) (t (list int)) (x int) (y int) (b int)) UiRouted
  (let w2 (ui_win_with w (ui_st_focusing (ui_st_pressing (ui_st_hovering st t) t) "") b)
    (match (ui_scroll_of t)
      ((UiScrollBar name f m sp sl)
        (match (ui_scrollbar_named ns name)
          ((None) (UiRouted w2 ""))
          ((Some n)
            (let top (ui_slider_top (rect_y (ui_node_rect n)) f m sp)
              (if (if (ge y top) (lt y (add top sl)) false)
                  (UiRouted (ui_win_grabbing w2 (sub y top)) "")
                  (UiRouted (ui_win_grabbing w2 (div sl 2)) (ui_slid_to ns name (sub y (div sl 2)))))))))
      ((UiScrollArea name f m s st) (UiRouted w2 ""))
      ((UiNoScroll) (ui_press_across w2 ns t x)))))

; A press on a scrollbar across, as on one down: on its slider, the
; slider taken where it was pressed; on its strip off the slider, the
; slider brought there, its middle under the pointer, and taken by its
; middle. A press on anything else, w as it is.
(def ui_press_across ((w UiWin) (ns (list UiNode)) (t (list int)) (x int)) UiRouted
  (match (ui_across_of t)
    ((UiAcrossBar name l m sp sl)
      (match (ui_acrossbar_named ns name)
        ((None) (UiRouted w ""))
        ((Some n)
          (let left (ui_slider_top (rect_x (ui_node_rect n)) l m sp)
            (if (if (ge x left) (lt x (add left sl)) false)
                (UiRouted (ui_win_grabbing w (sub x left)) "")
                (UiRouted (ui_win_grabbing w (div sl 2)) (ui_across_slid_to ns name (sub x (div sl 2)))))))))
    ((UiAcrossArea name l m) (UiRouted w ""))
    ((UiNoAcross) (UiRouted w ""))))

; The action that scrolls the scroller called name so that its slider's
; top is at top, as near as a whole row goes; "" if it is there already.
(def ui_slid_to ((ns (list UiNode)) (name (list int)) (top int)) (list int)
  (match (ui_scrollbar_named ns name)
    ((None) "")
    ((Some n)
      (match (ui_scroll_of (ui_node_action n))
        ((UiScrollBar nm f m sp sl)
          (let to (ui_slider_first top (rect_y (ui_node_rect n)) m sp)
            (if (eq to f) "" (ui_scrollto_action name to))))
        ((UiScrollArea nm f m s st) "")
        ((UiNoScroll) "")))))

; The wheel turned dy steps at x, y: the scroller there scrolled, if one
; is and it can go that way.
(def ui_wheel_routed ((w UiWin) (x int) (y int) (dy int)) UiRouted
  (UiRouted w
    (match (ui_scroll_hit (ui_win_nodes w) x y)
      ((UiScrollArea name f m s st) (ui_wheeled_to name f m dy))
      ((UiScrollBar name f m sp sl) (ui_wheeled_to name f m dy))
      ((UiNoScroll) ""))))

; The action that scrolls the scroller called name, first row f of most
; m, dy steps of the wheel; "" if it cannot go that way.
(def ui_wheeled_to ((name (list int)) (f int) (m int) (dy int)) (list int)
  (let to (ui_wheel_first f m dy) (if (eq to f) "" (ui_scrollto_action name to))))

; The action that scrolls the scroller across called name so that its
; slider's left is at left; "" if it is there already.
(def ui_across_slid_to ((ns (list UiNode)) (name (list int)) (left int)) (list int)
  (match (ui_acrossbar_named ns name)
    ((None) "")
    ((Some n)
      (match (ui_across_of (ui_node_action n))
        ((UiAcrossBar nm l m sp sl)
          (let to (ui_slider_first left (rect_x (ui_node_rect n)) m sp)
            (if (eq to l) "" (ui_acrossto_action name to))))
        ((UiAcrossArea nm l m) "")
        ((UiNoAcross) "")))))

; The wheel turned dx steps across at x, y: the scroller across there
; scrolled, if one is and it can go that way.
(def ui_wheel_across_routed ((w UiWin) (x int) (y int) (dx int)) UiRouted
  (UiRouted w
    (match (ui_across_hit (ui_win_nodes w) x y)
      ((UiAcrossArea name l m) (ui_wheeled_across name l m dx))
      ((UiAcrossBar name l m sp sl) (ui_wheeled_across name l m dx))
      ((UiNoAcross) ""))))

; The action that scrolls the scroller across called name, l of most m
; scrolled off, dx steps of the wheel; "" if it cannot go that way.
(def ui_wheeled_across ((name (list int)) (l int) (m int) (dx int)) (list int)
  (let to (ui_wheel_left l m dx) (if (eq to l) "" (ui_acrossto_action name to))))

; A key, pressed or repeated (a release does nothing): Tab moves the
; focus to the next target, Shift-Tab to the one before, Esc takes it
; away, a focused entry takes any other key, as its activate action for
; Enter and its edit action for the rest; else Enter or Space sets off
; what the focus is on.
(def ui_keyed ((w UiWin) (k KeyEvent)) UiRouted
  (let st (ui_win_state w)
    (match k
      ((KeyEvent code value ch mods)
        (if (eq value 0)
            (UiRouted w "")
            (if (eq code (ui_key_tab))
                (UiRouted (ui_win_with w (ui_st_focusing st (ui_tabbed (ui_win_nodes w) (ui_st_focus st) mods)) (ui_win_held w)) "")
                (if (eq code (ui_key_esc))
                    (UiRouted (ui_win_with w (ui_st_focusing st "") (ui_win_held w)) "")
                    (let entry (ui_focused_entry w)
                      (if (not (is_empty entry))
                          (UiRouted w (if (eq code (ui_key_enter)) (ui_entry_activate_action entry) (ui_entry_edit_action entry)))
                          (if (if (any_eq code (cons (ui_key_enter) (cons (ui_key_space) (nil int)))) (not (is_empty (ui_st_focus st))) false)
                              (UiRouted w (ui_st_focus st))
                              (UiRouted w "")))))))))))

; Where Tab with the modifiers mods takes the focus from cur among ns:
; back with Shift held, else on.
(def ui_tabbed ((ns (list UiNode)) (cur (list int)) (mods int)) (list int)
  (if (eq (bit_and mods (key_mod_shift)) 0) (ui_focus_next ns cur) (ui_focus_prev ns cur)))

; The name of the entry the focus is on, if it is one and is laid out:
; it takes every key but Tab and Esc. Else "".
(def ui_focused_entry ((w UiWin)) (list int)
  (let f (ui_st_focus (ui_win_state w))
    (let name (ui_entry_name_of f)
      (if (is_empty name)
          ""
          (match (ui_node_with (ui_win_nodes w) f) ((None) "") ((Some n) name))))))

; The focus put on action, as a program does when a dialog with an entry
; opens, so that typing goes to it at once.
(def ui_win_focusing ((w UiWin) (action (list int))) UiWin
  (ui_win_with w (ui_st_focusing (ui_win_state w) action) (ui_win_held w)))

; An entry's text after action, set off with ev: edited by a key, or its
; cursor placed by a press; as it was for any other action.
(def ui_entry_update ((name (list int)) (t UiEntryText) (action (list int)) (ev UiEvent)) UiEntryText
  (if (eq action (ui_entry_edit_action name))
      (match (ui_key_of ev) ((Some k) (ui_entry_keyed t k)) ((None) t))
      (let p (append name ".place.")
        (if (starts_with action p) (ui_entry_placed t (int_prefix (drop_n action (length p)) 0)) t))))

; The pointer's buttons as last told.
(def ui_win_held ((w UiWin)) int (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) b)))

; ------------------------------------------------------------- painting

; The window showing widget: laid out at its size, and where that differs
; from what was painted last, painted and its damage told; what a scroll
; moved is moved rather than painted again (ui_presented). After a resize
; in its buffer, what kept its place is not painted again either, only
; what changed and what the window has grown into, and wm is told of the
; size; after one into a new buffer, all of it is painted, and wm given
; that buffer in place of the old one. A window asked to close
; (ui_win_close_asked) that the program presents again did nothing with
; the close: it is closed instead (ui_closed_unasked).
;
; A window paces itself (ui_double_presented): it paints the buffer the
; screen does not show, gives it to wm in place of the one shown, and
; paints no more until the display's next frame and the release of the
; buffer it gave up, keeping what changed meanwhile, which the next
; ui_present paints. One whose program paints a drawing area itself,
; as vt does, is painted as before, in the buffer shown.
(def ui_present ((w UiWin) (widget UiWidget)) UiWin
  (if (ui_win_close_asked w)
      (ui_closed_unasked w)
      (if (ui_win_waits w (clock_ns)) w (ui_presented_now w widget))))

; A window whose close the program did nothing with, closed for it, as
; the compositor's close button did before it asked: the window first,
; then, as it is the program's only one, the program, which the
; compositor ends (wm.l0's compositor_end), since a program cannot end
; itself but by returning from main. The window, closed and asked no
; more, in case it is not ended.
(def ui_closed_unasked ((w UiWin)) UiWin
  (let c (ui_close w)
    (let e (compositor_end (ui_win_compositor w))
      (ui_win_closing w false))))

; The compositor the window is of.
(def ui_win_compositor ((w UiWin)) Compositor (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) c)))

; ui_present's window laid out and painted.
(def ui_presented_now ((w UiWin) (widget UiWidget)) UiWin
  (match w
    ((UiWin c id canvas port font st old held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (let p0 (clock_ns)
            (let ns (ui_layout_window widget ww wh (ui_st_keeping st (ui_kept_of old)))
              (let l (clock_ns)
                (let full (Rect 0 0 ww wh)
                  (let w2 (UiWin c id canvas port (ui_face_asking font (ui_strikes_wanted font ns (nil (list int))) (ui_loop_rport lp)) st ns held g k m csd cl lp sh)
                    (let s (clock_ns)
                      (ui_win_stepped
                        (if (is_empty (ui_drawn ns))
                            (ui_double_presented w2 old ns full)
                            (ui_single_presented w2 old ns full))
                        p0 l s))))))))))))

; w, showing ns, painted in the buffer the screen shows, as a window
; whose program paints a drawing area does: where they differ from old,
; and after a resize what was exposed, or all of a new buffer.
(def ui_single_presented ((w UiWin) (old (list UiNode)) (ns (list UiNode)) (full Rect)) UiWin
  (match (ui_win_swap w)
    ((UiNoSwap) (ui_presented w old ns full))
    ((UiInPlace ow oh)
      (ui_swapped w (ui_changed_onto old ns full (rects_minus (cons full (nil Rect)) (cons (Rect 0 0 ow oh) (nil Rect))))))
    ((UiSwap ova on ocv ow oh) (ui_swapped w (cons full (nil Rect))))))

; What a resize did that wm is yet to be told of.
(def ui_win_swap ((w UiWin)) UiSwap
  (match w ((UiWin c id cv port font st ns b g k m csd cl lp sh) (match m ((UiMem va n ww wh swap db) swap)))))

; Whether a resize has done nothing wm is yet to be told of.
(def ui_swap_none ((s UiSwap)) bool
  (match s ((UiNoSwap) true) ((UiInPlace ow oh) false) ((UiSwap ova on ocv ow oh) false)))

; The part of the window the buffer shown has, the desktop's pixels: all
; of it but after a resize, the size it had.
(def ui_shown_size ((s UiSwap) (ww int) (wh int)) Rect
  (match s ((UiNoSwap) (Rect 0 0 ww wh)) ((UiInPlace ow oh) (Rect 0 0 ow oh)) ((UiSwap ova on ocv ow oh) (Rect 0 0 ow oh))))

; What a present paints, what of the window it changes, and how a
; scroll moved what an area shows, if it did.
(data UiPlan (UiPlan (list Rect) (list Rect) UiScrollMove))

; The plan for showing ns, where old was painted last, within full: what
; differs (ui_changed), what a scroll did not move in (ui_scrolled_changed),
; or, after a resize, what differs and what the window grew by.
(def ui_plan ((old (list UiNode)) (ns (list UiNode)) (full Rect) (swap UiSwap)) UiPlan
  (match swap
    ((UiInPlace ow oh)
      (let b (ui_undrawn ns (ui_changed_onto old ns full (rects_minus (cons full (nil Rect)) (cons (Rect 0 0 ow oh) (nil Rect)))))
        (UiPlan b b (UiNoScrollMove))))
    ((UiSwap ova on ocv ow oh) (UiPlan (cons full (nil Rect)) (cons full (nil Rect)) (UiNoScrollMove)))
    ((UiNoSwap)
      (match (ui_scroll_moved ns old)
        ((UiNoScrollMove)
          (let same (ui_parts_same old ns)
            (let b (ui_undrawn ns (ui_changed (ui_parts_out old same) (ui_parts_out ns same) full))
              (UiPlan b b (UiNoScrollMove)))))
        ((UiScrollMove area dy)
          (let b (ui_undrawn ns (ui_scrolled_changed old ns full area dy))
            (UiPlan b (ui_merged (cons area b) full) (UiScrollMove area dy))))))))

; w, showing ns, paced (ui_present): what the plan says painted in the
; buffer not shown, made first if there is none or it is too small,
; once what it lacks of the shown one is copied over (ui_back_painted),
; and given to wm in place of the one shown (ui_back_given). Nothing is
; painted or asked if nothing changed; and if there is no memory for a
; buffer not shown, the window is painted as before, in the one shown.
(def ui_double_presented ((w UiWin) (old (list UiNode)) (ns (list UiNode)) (full Rect)) UiWin
  (match w
    ((UiWin c id canvas port font st nodes held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match (ui_plan old ns full swap)
            ((UiPlan paint told mv)
              (if (if (is_empty told) (ui_swap_none swap) false)
                  (ui_win_painted w (clock_ns))
                  (match db
                    ((UiDb there bk fr rl since)
                      (match (ui_back_for bk ww wh (ui_face_scale font))
                        ((UiNoBack) (ui_single_presented w old ns full))
                        ((UiBack bva bn bcv bt stale)
                          (ui_back_painted w (UiPlan paint told mv) (UiBack bva bn bcv bt stale) (ui_shown_size swap ww wh))))))))))))))

; The buffer not shown, for a window ww by wh of the desktop's pixels at
; scale s: b if it holds that; else a new one, b given up, with room to
; grow, lacking all of the shown one, and not yet shared with wm; none
; if there is no memory for it.
(def ui_back_for ((b UiBack) (ww int) (wh int) (s int)) UiBack
  (match b
    ((UiBack bva bn bcv bt stale)
      (if (if (le (mul ww s) (canvas_w bcv)) (le (mul wh s) (canvas_h bcv)) false)
          b
          (let f (ui_buffer_free bva bn bcv) (ui_back_new ww wh s))))
    ((UiNoBack) (ui_back_new ww wh s))))

; A new buffer not shown for a window ww by wh at scale s, as ui_back_for
; makes it.
(def ui_back_new ((ww int) (wh int) (s int)) UiBack
  (match (ui_buffer_at (ui_grown ww) (ui_grown wh) s)
    ((UiNoBuf why) (UiNoBack))
    ((UiBuf va n cv) (UiBack va n cv 0 (cons (Rect 0 0 (ui_grown ww) (ui_grown wh)) (nil Rect))))))

; The buffer not shown, b, brought up to what w shows and then painted as
; plan says: what it lacks copied over from the buffer shown, within
; shown, the part that has it, but for what is painted anyway; a scroll's
; rows moved; then the boxes painted. Then given to wm (ui_back_given),
; with the damage that shows it: what it lacked, and what changed.
(def ui_back_painted ((w UiWin) (plan UiPlan) (b UiBack) (shown Rect)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match plan
            ((UiPlan paint told mv)
              (match b
                ((UiNoBack) w)
                ((UiBack bva bn bcv bt stale)
                  (let s (ui_face_scale font)
                    (let copied (ui_copied_over bcv canvas (ui_copy_boxes stale paint mv shown) s)
                      (let moved (match mv ((UiNoScrollMove) copied) ((UiScrollMove area dy) (canvas_copy_rows copied (rect_scaled area s) (mul dy s))))
                        (let p (ui_paint_boxes moved font ns paint)
                          (let at (clock_ns)
                            (ui_back_given w (UiBack bva bn p bt stale) (ui_merged (append stale told) (Rect 0 0 ww wh)) told at)))))))))))))))

; What of stale, what a buffer not shown lacks, to copy over from the one
; shown, within shown: all of it if a scroll moves rows, which may be
; read from anywhere in the area, else but what is painted anyway.
(def ui_copy_boxes ((stale (list Rect)) (paint (list Rect)) (mv UiScrollMove) (shown Rect)) (list Rect)
  (ui_merged (match mv ((UiNoScrollMove) (rects_minus stale paint)) ((UiScrollMove area dy) stale)) shown))

; Each of boxes, the desktop's pixels, of src copied to the same place in
; dst, at scale s: dst, which has them.
(def ui_copied_over ((dst Canvas) (src Canvas) (boxes (list Rect)) (s int)) Canvas
  (if (is_empty boxes)
      dst
      (let r (rect_clip (rect_clip (rect_scaled (head boxes) s) (Rect 0 0 (canvas_w dst) (canvas_h dst))) (Rect 0 0 (canvas_w src) (canvas_h src)))
        (ui_copied_over (if (rect_empty r) dst (ui_rows_copied dst src (rect_x r) (rect_w r) (rect_y r) (rect_y1 r))) src (tail boxes) s))))

; Rows y up to end of src, w pixels from column x, copied into dst.
(def ui_rows_copied ((dst Canvas) (src Canvas) (x int) (w int) (y int) (end int)) Canvas
  (if (ge y end) dst (ui_rows_copied (ui_row_copied dst src x w y) src x w (add y 1) end)))

; Row y of src, w pixels from column x, copied into dst: between two
; regions in one copy, read as bytes and written as a range; over arrays
; a cell at a time.
(def ui_row_copied ((dst Canvas) (src Canvas) (x int) (w int) (y int)) Canvas
  (match dst
    ((Canvas dfb dw dh dtop)
      (match src
        ((Canvas sfb sw sh stop)
          (let row (device_read_bytes sfb (mul (add (row_start src y) x) 4) (mul w 4))
            (let p (put_bytes_range dfb (mul (add (row_start dst y) x) 4) row 0 (mul w 4)) dst)))
        ((ArrayCanvas px sw sh stop) (ui_cells_copied dst src x (add x w) y))))
    ((ArrayCanvas px dw dh dtop) (ui_cells_copied dst src x (add x w) y))))

; Pixels x up to end of src's row y copied into dst's, one at a time.
(def ui_cells_copied ((dst Canvas) (src Canvas) (x int) (end int) (y int)) Canvas
  (if (ge x end)
      dst
      (let i (add (row_start dst y) x)
        (ui_cells_copied (canvas_fill dst (canvas_pixel src x y) i (add i 1)) src (add x 1) end y))))

; The buffer not shown, b, painted at at, given to wm: the next frame
; asked for (window_frame), then, after a resize, the resize's new
; buffer, else attach and the damage dmg, which shows it, what it lacked
; and what changed. Once wm has it, it is the window's, the one shown
; before is the buffer not shown, lacking told, and the window waits for
; the frame, if wm took that ask, and for the release. If wm will not
; have it, the window is as wm shows it (ui_back_kept). If it cannot be
; shared with wm, which has no room for it, that is said once and the
; buffer kept marked -1, not shared again, which took 6 ms each present
; (roadmap 0038), until a resize makes another.
(def ui_back_given ((w UiWin) (b UiBack) (dmg (list Rect)) (told (list Rect)) (at int)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match db
            ((UiDb there bk fr rl since)
              (match b
                ((UiNoBack) (ui_win_painted w at))
                ((UiBack bva bn bcv bt stale)
                  (match (if (gt bt 0)
                             ((Ok int (list int)) bt)
                             (if (lt bt 0) ((Err int (list int)) "") (shm_share_to bva bn (compositor_pid c) "the compositor")))
                    ((Err why)
                      (let s (if (eq bt 0) (warn_as (app_open_base (proc_path (l0s_pid))) (append "the window's next buffer is not shown: " why)) 0)
                        (ui_win_painted (ui_back_kept w (UiBack bva bn bcv -1 stale)) at)))
                    ((Ok bt2)
                      (let f (window_frame c id)
                        (let e (if (ui_swap_none swap)
                                   (let a (window_attach c id bt2 bn (canvas_w bcv)) (if (is_empty a) (window_damage_many c id dmg) a))
                                   (window_resize_at c id ww wh bt2 bn (canvas_w bcv)))
                          (ui_win_painted
                            (if (is_empty e)
                                (UiWin c id bcv port font st ns held g k
                                       (UiMem bva bn ww wh (UiNoSwap) (UiDb bt2 (UiBack va n canvas there told) (is_empty f) true (clock_ns))) csd cl lp sh)
                                (ui_back_kept w (UiBack bva bn bcv bt2 (cons (Rect 0 0 (canvas_w bcv) (canvas_h bcv)) (nil Rect)))))
                            at))))))))))))))

; w as wm shows it, after wm would not have its buffer not shown, b,
; kept: at the size it had, nothing awaited, and its nodes forgotten so
; that all of it is painted next.
(def ui_back_kept ((w UiWin) (b UiBack)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match db
            ((UiDb there bk fr rl since)
              (UiWin c id canvas port font st (nil UiNode) held g k
                     (match swap
                       ((UiInPlace ow oh) (UiMem va n ow oh (UiNoSwap) (UiDb there b false false since)))
                       ((UiSwap ova on ocv ow oh) (UiMem va n ww wh swap (UiDb there b false false since)))
                       ((UiNoSwap) (UiMem va n ww wh swap (UiDb there b false false since))))
                     csd cl lp sh))))))))

; w at the end of its step's present, which started at p0, was laid out
; by l and had its waits done by s: the step's stages taken from its
; times (uiloop.l0's ui_times_stepped), and a slow step said.
(def ui_win_stepped ((w UiWin) (p0 int) (l int) (s int)) UiWin
  (let e (clock_ns)
    (let t (ui_win_times_of w)
      (match t
        ((UiTimes st r pa said)
          (ui_win_times w (ui_times_stepped t (ui_stages_of t p0 l s (if (lt pa s) e pa) e))))))))

; w with its painting's end, at, in its times.
(def ui_win_painted ((w UiWin) (at int)) UiWin
  (ui_win_times w (ui_times_painted (ui_win_times_of w) at)))

; The strikes the text of ns in faces a program names (UiFontAt) is
; drawn from that face f does not have, onto acc, each once.
(def ui_strikes_wanted ((f UiFace) (ns (list UiNode)) (acc (list (list int)))) (list (list int))
  (if (is_empty ns)
      acc
      (match (head ns) ((UiNode r ops a fo) (ui_strikes_wanted f (tail ns) (ui_op_strikes f ops acc))))))

; ui_strikes_wanted of the ops of one node.
(def ui_op_strikes ((f UiFace) (ops (list UiPaint)) (acc (list (list int)))) (list (list int))
  (if (is_empty ops)
      acc
      (ui_op_strikes f (tail ops)
        (match (head ops)
          ((UiPText r s a c font b sc) (ui_strike_wanted f font b sc acc))
          ((UiPFill r c) acc)
          ((UiPRound r rad c u) acc)
          ((UiPIcon x y n c sc) acc)
          ((UiPImage x y n d ts) acc)))))

; acc with the strike text in font is drawn from on f, if it is a
; UiFontAt's and f has it not, and acc not already.
(def ui_strike_wanted ((f UiFace) (font UiFont) (bold bool) (scale int) (acc (list (list int)))) (list (list int))
  (match font
    ((UiMono) acc)
    ((UiSans) acc)
    ((UiFontAt name h)
      (let k (ui_text_strike font bold scale (ui_face_scale f))
        (if (any_eq k acc)
            acc
            (match (ui_face_strike f k) ((Some g) acc) ((None) (cons k acc))))))))

; w, showing ns, painted where they differ from old, the nodes painted
; last, within full, and wm told: as ui_changed says, or, if a scroll
; moved what the scroller's area shows, those pixels moved by as much
; and only what that does not show painted (ui_scrolled_changed), the
; whole area told, as all of its pixels have changed.
(def ui_presented ((w UiWin) (old (list UiNode)) (ns (list UiNode)) (full Rect)) UiWin
  (match w
    ((UiWin c id canvas port font st nodes held g k m csd cl lp sh)
      (match (ui_scroll_moved ns old)
        ((UiNoScrollMove)
          (let same (ui_parts_same old ns)
            (let boxes (ui_undrawn ns (ui_changed (ui_parts_out old same) (ui_parts_out ns same) full))
              (ui_win_painted w (ui_repaint c id canvas font ns boxes boxes)))))
        ((UiScrollMove area dy)
          (let s (ui_face_scale font)
            (let moved (canvas_copy_rows canvas (rect_scaled area s) (mul dy s))
              (let boxes (ui_undrawn ns (ui_scrolled_changed old ns full area dy))
                (ui_win_painted w (ui_repaint c id moved font ns boxes (ui_merged (cons area boxes) full)))))))))))

; The marks of the keyed parts (widget.l0's UiKeyed) both old and ns lay
; out alike, the same key in the same place against the same look: their
; nodes are the same, so ui_changed need not compare them.
(def ui_parts_same ((old (list UiNode)) (ns (list UiNode))) (list (list int))
  (ui_marks_in ns (ui_marks_of old (nil (list int))) (nil (list int))))

; The marks among ns, onto acc.
(def ui_marks_of ((ns (list UiNode)) (acc (list (list int)))) (list (list int))
  (if (is_empty ns)
      acc
      (let a (ui_node_action (head ns))
        (ui_marks_of (tail ns) (if (starts_with a "ui.kept.") (cons a acc) acc)))))

; The marks among ns that are in marks too, onto acc.
(def ui_marks_in ((ns (list UiNode)) (marks (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty ns)
      acc
      (let a (ui_node_action (head ns))
        (ui_marks_in (tail ns) marks (if (if (starts_with a "ui.kept.") (any_eq a marks) false) (cons a acc) acc)))))

; ns without the parts whose marks are in same, each mark and the nodes
; it counts.
(def ui_parts_out ((ns (list UiNode)) (same (list (list int)))) (list UiNode)
  (if (is_empty same) ns (rev (ui_parts_out_onto ns same (nil UiNode)))))

; ui_parts_out's loop, onto the reversed acc.
(def ui_parts_out_onto ((ns (list UiNode)) (same (list (list int))) (acc (list UiNode))) (list UiNode)
  (if (is_empty ns)
      acc
      (let a (ui_node_action (head ns))
        (if (if (starts_with a "ui.kept.") (any_eq a same) false)
            (ui_parts_out_onto (drop (tail ns) (int_prefix (drop_n a 8) 0)) same acc)
            (ui_parts_out_onto (tail ns) same (cons (head ns) acc))))))

; What of boxes is no drawing area of ns: the toolkit paints none of what
; a program paints itself, nor tells wm of it.
(def ui_undrawn ((ns (list UiNode)) (boxes (list Rect))) (list Rect)
  (let ds (ui_drawn ns) (if (is_empty ds) boxes (rects_minus boxes ds))))

; The window, resized, painted in boxes and wm told: of its new size, if it
; was resized in its buffer, or of its new buffer, which wm then shows in
; place of the old one, and the old one given up. If wm will not have it,
; the window goes back to the buffer and size wm shows, to be painted
; again, a new buffer given up.
(def ui_swapped ((w UiWin) (boxes (list Rect))) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (let p (ui_paint_boxes canvas font ns (ui_undrawn ns boxes))
            (let at (clock_ns)
              (let e (match swap
                       ((UiInPlace ow oh) (window_resize_in_place c id ww wh))
                       ((UiSwap ova on ocv ow oh) (window_resize c id ww wh va n (canvas_w canvas)))
                       ((UiNoSwap) ""))
                (ui_win_painted (if (is_empty e) (ui_told w) (ui_refused w)) at)))))))))

; w once wm has its resize: any old buffer given up.
(def ui_told ((w UiWin)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (let f (match swap ((UiSwap ova on ocv ow oh) (ui_buffer_free ova on ocv)) ((UiInPlace ow oh) 0) ((UiNoSwap) 0))
            (UiWin c id canvas port font st ns held g k (UiMem va n ww wh (UiNoSwap) db) csd cl lp sh)))))))

; w once wm has refused its resize: as wm shows it, at the size it had, in
; the same buffer or the old one, the new one given up; nothing painted,
; so all of it is painted next.
(def ui_refused ((w UiWin)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (match swap
            ((UiInPlace ow oh) (UiWin c id canvas port font st (nil UiNode) held g k (UiMem va n ow oh (UiNoSwap) db) csd cl lp sh))
            ((UiSwap ova on ocv ow oh)
              (let f (ui_buffer_free va n canvas)
                (UiWin c id ocv port font st (nil UiNode) held g k (UiMem ova on ow oh (UiNoSwap) db) csd cl lp sh)))
            ((UiNoSwap) w)))))))

; The window asked to be rw by rh: a window that paces itself only keeps
; the size, the size it had kept too, for ui_present to paint its buffer
; not shown at it (ui_double_presented); any other, in the buffer it has,
; if its canvas holds that, what was painted kept where it is for the next ui_present to
; paint only what changed; else in a new one with room to grow, the old
; one kept until wm has the new one, and its nodes forgotten so that all
; of it is painted. A buffer that wm has never been told of is given up,
; as nothing shows it. As it was if the size is the one it has, or there
; is no memory for a new buffer.
(def ui_resized ((w UiWin) (rw int) (rh int)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem va n ww wh swap db)
          (if (if (lt rw 1) true (if (lt rh 1) true (if (eq rw ww) (eq rh wh) false)))
              w
              (let s (ui_face_scale font)
                (if (if (is_empty (ui_drawn ns)) true (if (le (mul rw s) (canvas_w canvas)) (le (mul rh s) (canvas_h canvas)) false))
                    (UiWin c id canvas port font st ns held g k
                           (UiMem va n rw rh (match swap ((UiNoSwap) (UiInPlace ww wh)) ((UiInPlace ow oh) swap) ((UiSwap ova on ocv ow oh) swap)) db) csd cl lp sh)
                    (match (ui_buffer_at (ui_grown rw) (ui_grown rh) s)
                      ((UiNoBuf why) w)
                      ((UiBuf nva nn big) (ui_swapped_in w nva nn big rw rh)))))))))))

; w with the new buffer at va, n pages, canvas ncv, as its own, rw by rh:
; the one it had kept until wm has the new one, unless wm has never been
; told of it.
(def ui_swapped_in ((w UiWin) (va int) (n int) (ncv Canvas) (rw int) (rh int)) UiWin
  (match w
    ((UiWin c id canvas port font st ns held g k m csd cl lp sh)
      (match m
        ((UiMem cva cn ww wh swap db)
          (match swap
            ((UiNoSwap) (UiWin c id ncv port font st (nil UiNode) held g k (UiMem va n rw rh (UiSwap cva cn canvas ww wh) db) csd cl lp sh))
            ((UiInPlace ow oh) (UiWin c id ncv port font st (nil UiNode) held g k (UiMem va n rw rh (UiSwap cva cn canvas ow oh) db) csd cl lp sh))
            ((UiSwap ova on ocv ow oh)
              (let f (ui_buffer_free cva cn canvas)
                (UiWin c id ncv port font st (nil UiNode) held g k (UiMem va n rw rh swap db) csd cl lp sh)))))))))

; Each of boxes painted, then each of told, where pixels have changed,
; told to wm in one damage request: when the painting ended, in
; clock_ns, the step's paint told from its present.
(def ui_repaint ((c Compositor) (id int) (canvas Canvas) (font UiFace) (ns (list UiNode)) (boxes (list Rect)) (told (list Rect))) int
  (let p (ui_paint_boxes canvas font ns boxes)
    (let at (clock_ns)
      (let d (window_damage_many c id told) at))))

; The nodes ns painted in each of boxes, cut to it, a box at a time.
(def ui_paint_boxes ((canvas Canvas) (font UiFace) (ns (list UiNode)) (boxes (list Rect))) Canvas
  (if (is_empty boxes)
      canvas
      (ui_paint_boxes (ui_paint_nodes canvas font (head boxes) ns) font ns (tail boxes))))

; ---------------------------------------------------------------- damage

; Where what new paints differs from what old painted, within full: the
; boxes to paint again, as GTK's render nodes are diffed. Each paint op is
; compared, not each node, as a multiset: an op both paint is unchanged,
; wherever it is in the list; one only one side paints is damage, all of
; where it paints, but a fill only where the other side's fills of its
; color do not cover. So a window's ground grown wider is damage only in
; the strip it grew by, and a pane whose ops are all as they were is not
; painted again.
(def ui_changed ((old (list UiNode)) (new (list UiNode)) (full Rect)) (list Rect)
  (ui_changed_onto old new full (nil Rect)))

; ui_changed's boxes, with each of more too, as what a resize has exposed.
(def ui_changed_onto ((old (list UiNode)) (new (list UiNode)) (full Rect) (more (list Rect))) (list Rect)
  (ui_ops_changed (ui_ops_of old) (ui_ops_of new) full more))

; Where ops news differ from olds, and more, within full, merged.
(def ui_ops_changed ((olds (list UiPaint)) (news (list UiPaint)) (full Rect) (more (list Rect))) (list Rect)
  (let gone (ui_ops_unmatched olds (ui_op_counts news ((MapEmpty UiPaint int))) (nil UiPaint))
    (let came (ui_ops_unmatched news (ui_op_counts olds ((MapEmpty UiPaint int))) (nil UiPaint))
      (ui_merged (ui_ops_damage gone news (ui_ops_damage came olds more)) full))))

; rs cut to full and made disjoint, each less those before it: so no
; pixel is painted twice, and none is added, as merging two that overlap
; into the least rectangle holding both would add, a thin scrollbar and a
; wide strip across it becoming all of the area. More than ui_max_boxes
; are one, the least that holds them.
(def ui_merged ((rs (list Rect)) (full Rect)) (list Rect)
  (let ms (ui_disjoint (ui_largest_first (ui_clipped rs full (nil Rect))) (nil Rect))
    (if (gt (length ms) (ui_max_boxes)) (cons (rect_union_all ms) (nil Rect)) ms)))

; A rectangle and its area, less than 0, so that sorting puts the
; largest first.
(data UiByArea (UiByArea int Rect))

; rs, the largest first: so the small ones inside it, a row's text in its
; row, are taken from what is left of it, not it cut around them.
(def ui_largest_first ((rs (list Rect))) (list Rect)
  (ui_rects_of (sort (ui_by_area rs (nil UiByArea))) (nil Rect)))

; Each of rs with its area, onto acc.
(def ui_by_area ((rs (list Rect)) (acc (list UiByArea))) (list UiByArea)
  (if (is_empty rs) acc (ui_by_area (tail rs) (cons (UiByArea (sub 0 (mul (rect_w (head rs)) (rect_h (head rs)))) (head rs)) acc))))

; The rectangles of bs, in order.
(def ui_rects_of ((bs (list UiByArea)) (acc (list Rect))) (list Rect)
  (if (is_empty bs) (rev acc) (match (head bs) ((UiByArea a r) (ui_rects_of (tail bs) (cons r acc))))))

; rs made disjoint onto acc, which is: each of rs less all of acc, its
; pieces then part of acc.
(def ui_disjoint ((rs (list Rect)) (acc (list Rect))) (list Rect)
  (if (is_empty rs)
      (rev acc)
      (ui_disjoint (tail rs) (rects_rev_onto (rects_minus (cons (head rs) (nil Rect)) acc) acc))))

; Each of rs cut to full, onto the reversed acc.
(def ui_clipped ((rs (list Rect)) (full Rect) (acc (list Rect))) (list Rect)
  (if (is_empty rs) (rev acc) (ui_clipped (tail rs) full (cons (rect_clip (head rs) full) acc))))

; More boxes than this are painted as one.
(def ui_max_boxes () int 24)

; Every op of ns, in order.
(def ui_ops_of ((ns (list UiNode))) (list UiPaint) (rev (ui_ops_onto ns (nil UiPaint))))

; ui_ops_of's loop: each node's ops onto the reversed acc.
(def ui_ops_onto ((ns (list UiNode)) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty ns)
      acc
      (match (head ns) ((UiNode r ops a f) (ui_ops_onto (tail ns) (ui_paints_onto ops acc))))))

; ops onto the reversed acc, each as ui_op_key compares it.
(def ui_paints_onto ((ops (list UiPaint)) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty ops) acc (ui_paints_onto (tail ops) (cons (ui_op_key (head ops)) acc))))

; op as what it paints: a line of text as the characters it shows, cut
; short as ui_text_smooth cuts them, in the rectangle they cover, aligned and
; centred as they are in its own; so text in a cell that grew, which
; paints the same pixels, is the same. Any other op as it is.
(def ui_op_key ((op UiPaint)) UiPaint
  (match op
    ((UiPText r s a c f bold scale)
      (let shown (ui_ellipsized s (rect_w r) f bold scale)
        (let tw (ui_text_w shown f bold scale)
          (let th (ui_font_line f scale)
            (UiPText (Rect (ui_aligned (rect_x r) (rect_w r) tw a) (add (rect_y r) (div (sub (rect_h r) th) 2)) tw th)
                     shown (UiStart) c f bold scale)))))
    ((UiPFill r c) op)
    ((UiPRound r radius c under) op)
    ((UiPIcon x y name c scale) op)
    ((UiPImage x y n d ts) op)))

; m with how many times each of ops is in it added.
(def ui_op_counts ((ops (list UiPaint)) (m (Map UiPaint int))) (Map UiPaint int)
  (if (is_empty ops)
      m
      (ui_op_counts (tail ops) (map_put m (head ops) (add 1 (match (map_get m (head ops)) ((None) 0) ((Some k) k)))))))

; The ops of xs that m's counts do not match, each count matching one,
; onto the reversed acc: what xs paints that the other side does not.
(def ui_ops_unmatched ((xs (list UiPaint)) (m (Map UiPaint int)) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty xs)
      (rev acc)
      (match (map_get m (head xs))
        ((Some k) (if (gt k 0) (ui_ops_unmatched (tail xs) (map_put m (head xs) (sub k 1)) acc) (ui_ops_unmatched (tail xs) m (cons (head xs) acc))))
        ((None) (ui_ops_unmatched (tail xs) m (cons (head xs) acc))))))

; Where each of ops, painted on one side only, is damage against other,
; the ops of the other side, onto acc.
(def ui_ops_damage ((ops (list UiPaint)) (other (list UiPaint)) (acc (list Rect))) (list Rect)
  (if (is_empty ops)
      acc
      (ui_ops_damage (tail ops) other (rects_rev_onto (ui_op_damage (head ops) other) acc))))

; Where op is damage: a fill where other's fills of its color do not
; cover, anything else all of where it paints.
(def ui_op_damage ((op UiPaint) (other (list UiPaint))) (list Rect)
  (match op
    ((UiPFill r c) (rects_minus (cons r (nil Rect)) (ui_fill_rects other c (nil Rect))))
    ((UiPRound r radius c under) (cons r (nil Rect)))
    ((UiPText r s a c f bold scale) (cons r (nil Rect)))
    ((UiPIcon x y name c scale) (cons (ui_op_rect op) (nil Rect)))
    ((UiPImage x y n d ts) (cons (ui_op_rect op) (nil Rect)))))

; The rectangles of ops's fills of color c, onto acc.
(def ui_fill_rects ((ops (list UiPaint)) (c int) (acc (list Rect))) (list Rect)
  (if (is_empty ops)
      acc
      (ui_fill_rects (tail ops) c
        (match (head ops)
          ((UiPFill r fc) (if (eq fc c) (cons r acc) acc))
          ((UiPRound r radius fc under) acc) ((UiPText r s a fc f bold scale) acc) ((UiPIcon x y name fc scale) acc)
          ((UiPImage x y n d ts) acc)))))

; Where op paints: its rectangle, or an icon's or an image's square.
(def ui_op_rect ((op UiPaint)) Rect
  (match op
    ((UiPFill r c) r)
    ((UiPRound r radius c under) r)
    ((UiPText r s a c f bold scale) r)
    ((UiPIcon x y name c scale) (Rect x y (mul (ui_icon_size) scale) (mul (ui_icon_size) scale)))
    ((UiPImage x y n d ts) (Rect x y n n))))

; op painted dy rows higher, below 0 lower.
(def ui_op_up ((op UiPaint) (dy int)) UiPaint
  (match op
    ((UiPFill r c) (UiPFill (ui_rect_up r dy) c))
    ((UiPRound r radius c under) (UiPRound (ui_rect_up r dy) radius c under))
    ((UiPText r s a c f bold scale) (UiPText (ui_rect_up r dy) s a c f bold scale))
    ((UiPIcon x y name c scale) (UiPIcon x (sub y dy) name c scale))
    ((UiPImage x y n d ts) (UiPImage x (sub y dy) n d ts))))

; r dy rows higher.
(def ui_rect_up ((r Rect) (dy int)) Rect (match r ((Rect x y w h) (Rect x (sub y dy) w h))))

; ------------------------------------------------------------- scrolling

; How a scroll moved what a scroller's area shows: its area, and how many
; pixels up its rows moved, below 0 down; or it did not, or by too much
; for any of them still to show.
(data UiScrollMove (UiScrollMove Rect int) (UiNoScrollMove))

; The first scroller of ns whose area, as old laid it out, is where it
; was and showed rows that it still shows, moved by its rows' height for
; each row its first moved by.
(def ui_scroll_moved ((ns (list UiNode)) (old (list UiNode))) UiScrollMove
  (if (is_empty ns)
      (UiNoScrollMove)
      (match (head ns)
        ((UiNode r ops a f)
          (match (ui_scroll_of a)
            ((UiScrollArea name first most shown step)
              (match (ui_area_named old name)
                ((None) (ui_scroll_moved (tail ns) old))
                ((Some on)
                  (match on
                    ((UiNode or2 oops oa of)
                      (match (ui_scroll_of oa)
                        ((UiScrollArea n2 f2 m2 s2 st2)
                          (let d (sub first f2)
                            (if (if (if (eq or2 r) (eq st2 step) false) (if (gt step 0) (if (not (eq d 0)) (lt (max d (sub 0 d)) shown) false) false) false)
                                (UiScrollMove r (mul d step))
                                (ui_scroll_moved (tail ns) old))))
                        ((UiScrollBar n2 f2 m2 sp sl) (ui_scroll_moved (tail ns) old))
                        ((UiNoScroll) (ui_scroll_moved (tail ns) old))))))))
            ((UiScrollBar n fi m sp sl) (ui_scroll_moved (tail ns) old))
            ((UiNoScroll) (ui_scroll_moved (tail ns) old)))))))

; The area node of the scroller called name in ns, if there is one.
(def ui_area_named ((ns (list UiNode)) (name (list int))) (Option UiNode)
  (if (is_empty ns)
      ((None UiNode))
      (match (ui_scroll_of (ui_node_action (head ns)))
        ((UiScrollArea n f m s st) (if (eq n name) (Some (head ns)) (ui_area_named (tail ns) name)))
        ((UiScrollBar n f m sp sl) (ui_area_named (tail ns) name))
        ((UiNoScroll) (ui_area_named (tail ns) name)))))

; What old and new differ by, within full, once area's pixels have been
; moved dy up: old's ops wholly in area moved with them and compared so;
; the rows nothing moved into; and, for an op across the area's edge,
; what of it is in the area, where its pixels were moved from and to,
; unless it is a fill as high as the area, which moving leaves alike.
(def ui_scrolled_changed ((old (list UiNode)) (new (list UiNode)) (full Rect) (area Rect) (dy int)) (list Rect)
  (match (ui_ops_moved (ui_ops_of old) area dy (nil UiPaint) (nil Rect))
    ((UiMovedOps olds extra)
      (let news (ui_ops_of new)
        (ui_ops_changed olds news full (cons (ui_scroll_strip area dy) (ui_across_damage news area 0 extra)))))))

; Old ops as a scroll left them, and damage they make.
(data UiMovedOps (UiMovedOps (list UiPaint) (list Rect)))

; Each of ops as it is once area's pixels are moved dy up, onto the
; reversed acc, and what that damages onto extra: one wholly in area moved
; with them, if it is still wholly in it, else what of it is still in the
; area damaged and the op dropped; one across the area's edge kept where
; it was, what of it is in the area damaged where it was and where that
; moved to; any other as it was. A fill as high as the area, such as its
; ground, is not moved: moving the area's rows leaves it as it was.
(def ui_ops_moved ((ops (list UiPaint)) (area Rect) (dy int) (acc (list UiPaint)) (extra (list Rect))) UiMovedOps
  (if (is_empty ops)
      (UiMovedOps (rev acc) extra)
      (let op (head ops)
        (let b (ui_op_rect op)
          (if (if (eq (rect_clip b area) b) (not (ui_fill_spans op area)) false)
              (let up (ui_op_up op dy)
                (if (eq (rect_clip (ui_op_rect up) area) (ui_op_rect up))
                    (ui_ops_moved (tail ops) area dy (cons up acc) extra)
                    (ui_ops_moved (tail ops) area dy acc (cons (rect_clip (ui_op_rect up) area) extra))))
              (if (rect_overlaps b area)
                  (ui_ops_moved (tail ops) area dy (cons op acc) (ui_across_one op area dy extra))
                  (ui_ops_moved (tail ops) area dy (cons op acc) extra)))))))

; What op, across area's edge, damages once area's pixels are moved dy
; up, onto extra: nothing if it is a fill as high as the area; else
; what of it is in the area, and that moved up dy, cut to the area.
(def ui_across_one ((op UiPaint) (area Rect) (dy int) (extra (list Rect))) (list Rect)
  (if (ui_fill_spans op area)
      extra
      (let k (rect_clip (ui_op_rect op) area)
        (cons k (cons (rect_clip (ui_rect_up k dy) area) extra)))))

; What each of news across area's edge damages, as ui_across_one says,
; dy 0: where the pixels moved into its part of the area were another's.
(def ui_across_damage ((news (list UiPaint)) (area Rect) (dy int) (extra (list Rect))) (list Rect)
  (if (is_empty news)
      extra
      (let b (ui_op_rect (head news))
        (ui_across_damage (tail news) area dy
          (if (if (rect_overlaps b area) (not (eq (rect_clip b area) b)) false)
              (ui_across_one (head news) area dy extra)
              extra)))))

; Whether op is a fill from the area's top to its bottom, or past them,
; which looks the same however the area's rows are moved.
(def ui_fill_spans ((op UiPaint) (area Rect)) bool
  (match op
    ((UiPFill r c) (if (le (rect_y r) (rect_y area)) (ge (rect_y1 r) (rect_y1 area)) false))
    ((UiPRound r radius c under) false) ((UiPText r s a c f bold scale) false) ((UiPIcon x y name c scale) false)
    ((UiPImage x y n d ts) false)))

; The rows of area nothing moves into when its pixels move dy up: dy at
; its foot, or, below 0, at its top.
(def ui_scroll_strip ((area Rect) (dy int)) Rect
  (match area
    ((Rect x y w h) (if (gt dy 0) (Rect x (sub (add y h) dy) w dy) (Rect x y w (sub 0 dy))))))
