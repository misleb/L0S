; Two buttons side by side, a and b, in a window 100 by 34.
(def two_buttons () UiWidget
  (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true) (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget)))))

; Window id of a compositor whose pid is 9, its events to port 4, laid
; out with two_buttons, nothing under the pointer.
(def app_win ((id int)) UiWin
  (UiWin (Compositor 1 2 9 1) id (Canvas (IoDevice 0) 100 34 0) 4 (ui_face_none) (ui_state_new (UiLight))
         (ui_layout_window (two_buttons) 100 34 (ui_state_new (UiLight))) 0 0 (ui_click_none) (UiMem 0 1 100 34 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new) ""))

; An app of two windows, 3 and 5, on port 4.
(def two () UiApp
  (UiApp (Compositor 1 2 9 1) 4 (ui_face_none) (map_put (map_put ((MapEmpty int UiWin)) 3 (app_win 3)) 5 (app_win 5)) false (ui_loop_new)))

; An event as text: its window, and what it is.
(def app_event_text ((e UiAppEvent)) (list int)
  (match e
    ((UiAppEvent id ev)
      (append (if (lt id 0) "none" (digits id))
        (match ev
          ((UiKey k) " key") ((UiPress x y b) " press") ((UiRelease x y b) " release") ((UiMotion x y b) " motion")
          ((UiContext x y b) " context") ((UiLeave) " leave") ((UiFocus f) " focus") ((UiScroll x y dx dy) " scroll")
          ((UiResize w h) " resize") ((UiCloseAsked) " close") ((UiExit p s) " exit")
          ((UiOpen r args) (append " open " (append (digits r) (append " " (unwords args)))))
          ((UiReply t m) (append " reply " (digits t))) ((UiIdle) " idle") ((UiPort p m) (append " port " (digits p)))
          ((UiOther f p) " other"))))))

; An open to reply port 7 with args, from the compositor, pid 9.
(def open_message ((args (list (list int)))) Message
  (match (app_open_request 7 args)
    ((Err why) (RecvFailed))
    ((Ok b) (message_new 9 (bytes_to_list b)))))

; The app launched again is an event of no window, an open, its reply
; port and its arguments read; one whose lengths do not read is an open
; of none, so it is still answered.
(def test_ui_app_event_open () int
  (add (check_str "an open" (app_event_text (ui_app_event (two) (open_message (cons "/Volumes" (cons "a b" (nil (list int))))))) "none open 7 /Volumes a b")
       (check_str "a bad one" (app_event_text (ui_app_event (two) (message_new 9 (append (u32_le 7) (append "open" (cons 4 (nil int))))))) "none open 7 ")))

; An open from no compositor, as the shell might send one, is an open
; still: the name is the app's, whoever asks.
(def test_ui_app_event_open_any () int
  (check_str "from 30" (app_event_text (ui_app_event (two) (match (open_message (nil (list int))) ((Message f b) (Message 30 b)) ((RecvFailed) (RecvFailed))))) "none open 7 "))

; An open routed sets off app.open, with its arguments, and is no
; window's: both windows as they were.
(def test_ui_app_route_open () int
  (match (ui_app_route (two) -1 (UiOpen 7 (cons "/Volumes" (nil (list int)))))
    ((UiAppRouted a action)
      (add (check_str "the action" action "app.open")
           (add (check_str "its arguments" (unwords (ui_open_args (UiOpen 7 (cons "/Volumes" (nil (list int)))))) "/Volumes")
                (check_int "the windows" (ui_app_count a) 2))))))

; An app answers its opens itself only once it says so.
(def test_ui_app_opening () int
  (add (check_bool "by default, the toolkit" (ui_app_answers_opens (two)) false)
       (check_bool "once it says" (ui_app_answers_opens (ui_app_opening (two))) true)))

; Only an open has a reply port, and arguments.
(def test_ui_open_reply () int
  (add (check_int "an open" (ui_open_reply (UiOpen 7 (nil (list int)))) 7)
       (add (check_int "a key" (ui_open_reply (UiKey (KeyEvent 30 1 97 0))) -1)
            (check_int "no arguments" (length (ui_open_args (UiLeave))) 0))))

(def test_ui_app_ids () int
  (add (check_int "two" (ui_app_count (two)) 2)
       (check_str "3 and 5" (unwords (numbers_words (ui_app_ids (two)))) "3 5")))

; Each window notice is of the window it names; the pointer's press at
; 10, 10 is window 5's alone.
(def test_ui_app_event_by_window () int
  (add (check_str "window 5's key" (app_event_text (ui_app_event (two) (message_new 9 (win_notice 5 (key_notice (KeyEvent 30 1 97 0)))))) "5 key")
       (check_str "window 3's press" (app_event_text (ui_app_event (two) (message_new 9 (win_notice 3 (pointer_notice (PointerEvent 10 10 1)))))) "3 press")))

; A notice of a window not the app's, a bare one, one not from the
; compositor, and an exit are of none.
(def test_ui_app_event_of_none () int
  (add (check_str "window 7's" (app_event_text (ui_app_event (two) (message_new 9 (win_notice 7 (leave_notice))))) "none other")
       (add (check_str "bare" (app_event_text (ui_app_event (two) (message_new 9 (leave_notice)))) "none other")
            (add (check_str "from 8" (app_event_text (ui_app_event (two) (message_new 8 (win_notice 3 (leave_notice))))) "none other")
                 (check_str "an exit" (app_event_text (ui_app_event (two) (message_new 0 (exit_notice 12 0)))) "none exit")))))

; The pointer over button a, 0 to 46 across (its label and 12 either
; side; ui_measure), in window 3: window 3 has it under the pointer,
; window 5 nothing.
(def test_ui_app_route_kept_apart () int
  (match (ui_app_route (two) 3 (UiMotion 10 10 0))
    ((UiAppRouted a action)
      (add (check_str "3's hover" (hover_of a 3) "a")
           (check_str "5's hover" (hover_of a 5) "")))))

; What is under the pointer in window id of a.
(def hover_of ((a UiApp) (id int)) (list int)
  (match (ui_app_win a id) ((None) "none") ((Some w) (ui_st_hover (ui_win_state w)))))

; The damage presenting each would paint: window 3, whose button is now
; lit, its button's box; window 5, nothing.
(def test_ui_app_damage_kept_apart () int
  (match (ui_app_route (two) 3 (UiMotion 10 10 0))
    ((UiAppRouted a action)
      (add (check_int "window 3 paints" (length (damage_of a 3)) 1)
           (check_int "window 5 paints nothing" (length (damage_of a 5)) 0)))))

; Where window id of a would paint again, showing two_buttons as its
; state now has it, as ui_present diffs it.
(def damage_of ((a UiApp) (id int)) (list Rect)
  (match (ui_app_win a id)
    ((None) (nil Rect))
    ((Some w) (ui_changed (ui_win_nodes w) (ui_layout_window (two_buttons) 100 34 (ui_win_state w)) (Rect 0 0 100 34)))))

; A close asked of window 5 is kept on window 5 only.
(def test_ui_app_close_asked_apart () int
  (match (ui_app_route (two) 5 (UiCloseAsked))
    ((UiAppRouted a action)
      (add (check_str "win.close" action "win.close")
           (add (check_bool "5 asked" (asked_of a 5) true)
                (check_bool "3 not" (asked_of a 3) false))))))

; Whether window id of a has been asked to close.
(def asked_of ((a UiApp) (id int)) bool
  (match (ui_app_win a id) ((None) false) ((Some w) (ui_win_close_asked w))))

; A receive that failed is the port lost; an exit is not.
(def test_ui_app_event_lost () int
  (add (check_bool "failed" (ui_app_event_lost (ui_app_event (two) (RecvFailed))) true)
       (check_bool "an exit" (ui_app_event_lost (ui_app_event (two) (message_new 0 (exit_notice 12 0)))) false)))

; A window of none is routed as nothing.
(def test_ui_app_route_none () int
  (match (ui_app_route (two) 9 (UiMotion 10 10 0))
    ((UiAppRouted a action) (add (check_str "nothing" action "") (check_int "still two" (ui_app_count a) 2)))))

; Two windows and no strike hold 5 regions: two each, its buffer shown
; and the one it paints, and one for a resize.
(def test_ui_app_regions () int
  (check_int "two windows" (ui_app_regions (two)) 5))

; Of 64, 8 kept: a window, two regions, fits while 54 are held, as it
; makes 56.
(def test_ui_regions_room () int
  (add (check_bool "54 held" (ui_regions_room 54) true)
       (check_bool "55 held" (ui_regions_room 55) false)))

(def test_ui_regions_full_why () int
  (check_str "why" (ui_regions_full_why 56) "no room for another window: 56 of a process's 64 regions held"))

; Strikes held as bytes, as a test's or a refused one, are no region.
(def test_ui_face_regions () int
  (add (check_int "none" (ui_face_regions (ui_face_none)) 0)
       (check_int "bytes" (ui_face_regions (UiFace 1 ((MapEmpty (list int) UiCov)) (map_put ((MapEmpty (list int) UiStrike)) "glyph.sans.16" (UiStrikeBytes (bytes_from_list ""))))) 0)))

; Under an operating system there is no compositor.
(def test_ui_app_no_compositor () int
  (match (ui_app_start)
    ((UiAppStarted a) (fail_because "start" "a compositor"))
    ((UiAppFailed why) (pass "start"))))
