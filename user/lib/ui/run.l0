; run.l0 -- a program of one window, run in the Elm architecture from
; its state, its view and its update, so that it writes no loop: the
; window opened, its update given app.start once, then each event taken
; (ui_win_next), routed (ui_route), given to the update with the action
; it set off, and the view presented (ui_present). The update gets the
; window and gives it back, so that it can ask a server (ui_win_ask), set
; an alarm (ui_win_alarm), give the loop its own ports (ui_win_ports),
; focus an entry (ui_win_focusing), find a scroller (ui_win_scroller) or
; keep the window open when it is asked to close (ui_win_close_kept). A
; close it does not keep ends the program. An app of many windows keeps
; its own loop over uiapp.l0's UiApp.

; What an update gives back: the window, and the state.
(data (UiStepped S) (UiStepped (win UiWin) (s S)))

; The action an update is given once, as the window opens, before the
; first present: where it asks what it shows first, sets its first
; alarm or focuses its entry.
(def ui_start_action () (list int) "app.start")

; who's window titled title, w by h, from state s0, drawn by view and
; changed by update; its status once it ends: 0 once closed, or 1, said
; as who, if it cannot open or loses its port.
(def (ui_run S) ((who (list int)) (title (list int)) (w int) (h int) (s0 S)
                 (view (fn (S) UiWidget)) (update (fn (S (list int) UiEvent UiWin) (UiStepped S)))) int
  (ui_run_opened who (ui_open title w h) s0 view update))

; The same, for a window that draws its own header bar (ui_open_csd),
; as a view whose top is a UiCsdBar.
(def (ui_run_csd S) ((who (list int)) (title (list int)) (w int) (h int) (s0 S)
                     (view (fn (S) UiWidget)) (update (fn (S (list int) UiEvent UiWin) (UiStepped S)))) int
  (ui_run_opened who (ui_open_csd title w h) s0 view update))

; The window opened, or why not: its update started and the loop run.
(def (ui_run_opened S) ((who (list int)) (o UiOpened) (s0 S)
                        (view (fn (S) UiWidget)) (update (fn (S (list int) UiEvent UiWin) (UiStepped S)))) int
  (match o
    ((UiOpenFailed why) (complain_as who why))
    ((UiOpenedWin win) (ui_run_stepped who (update s0 (ui_start_action) (UiOther 0 "") win) view update))))

; After a step: the window closed and 0, if it was asked to close and the
; update did not keep it; else the view presented and the next taken.
(def (ui_run_stepped S) ((who (list int)) (st (UiStepped S))
                         (view (fn (S) UiWidget)) (update (fn (S (list int) UiEvent UiWin) (UiStepped S)))) int
  (match st
    ((UiStepped w s)
      (if (.close_asked w)
          (let c (ui_close w) 0)
          (ui_run_loop who (ui_present w (view s)) s view update)))))

; The loop: the next event, routed, and given to the update.
(def (ui_run_loop S) ((who (list int)) (w0 UiWin) (s S)
                      (view (fn (S) UiWidget)) (update (fn (S (list int) UiEvent UiWin) (UiStepped S)))) int
  (match (ui_win_next w0)
    ((UiWinNext w ev)
      (if (ui_event_lost ev)
          (complain_as who "lost its port")
          (match (ui_route w ev)
            ((UiRouted w2 action) (ui_run_stepped who (update s action ev w2) view update)))))))
