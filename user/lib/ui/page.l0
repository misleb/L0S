; page.l0 -- the pieces apps kept making for themselves, made once: a
; page with a title and a line under it, a heading row with buttons at
; its end, a value as properties show one, a line along a pane's foot, a
; toolbar over a page, a sidebar beside a pane, an entry's width, a
; widget kept at least so wide, a dialog's Cancel and a dialog that
; confirms, toggles from their labels, and a list's element taken out
; by its key with the one to select after it. Each composes the widgets
; there are, as GNOME's apps compose GTK's: nothing here lays out or
; paints of its own.

; ----------------------------------------------------------------- pages

; A page as GNOME's preferences and about pages are: title large, the
; line under it dimmed, each left out if empty, then children, 12
; apart, 18 in from the window's edges.
(def ui_page ((title (list int)) (line (list int)) (children (list UiWidget))) UiWidget
  (UiPad (ui_space_l) (ui_space_l)
         (UiBox (UiV) (ui_space_m) (ui_page_top title line children))))

; children after the title and the line that are there.
(def ui_page_top ((title (list int)) (line (list int)) (children (list UiWidget))) (list UiWidget)
  (let rest (if (is_empty line) children (cons (UiLabel line (UiDimmed) (UiStart)) children))
    (if (is_empty title) rest (cons (UiLabel title (UiLarge) (UiStart)) rest))))

; A heading row: title large at its start, buttons at its end, 6
; apart, as Disks heads its drive.
(def ui_heading_row ((title (list int)) (buttons (list UiWidget))) UiWidget
  (UiBox (UiH) (ui_space_s)
         (cons (UiLabel title (UiLarge) (UiStart)) (cons (UiExpand (UiSpace 0 0)) buttons))))

; A value as properties show one (UiProps): text, in the body's color.
(def ui_value ((s (list int))) UiWidget (UiLabel s (UiBody) (UiStart)))

; A line along a pane's foot: a separator, then s dimmed, 12 in and 6
; down, as Files says what it did.
(def ui_footer ((s (list int))) UiWidget
  (UiBox (UiV) 0
         (cons (UiSeparator (UiH))
               (cons (UiPad (ui_space_m) (ui_space_s) (UiLabel s (UiDimmed) (UiStart))) (nil UiWidget)))))

; body over a footer saying s, body given all the room there is.
(def ui_with_footer ((body UiWidget) (s (list int))) UiWidget
  (UiBox (UiV) 0 (cons (UiExpand body) (cons (ui_footer s) (nil UiWidget)))))

; A toolbar over body: start's widgets, a line saying status in the
; middle, dimmed, and end's, 6 apart and 6 in; a separator; then body,
; given the rest. As System Monitor's page over its grid.
(def ui_toolbar_page ((start (list UiWidget)) (status (list int)) (end (list UiWidget)) (body UiWidget)) UiWidget
  (UiBox (UiV) 0
         (cons (UiPad (ui_space_s) (ui_space_s)
                      (UiBox (UiH) (ui_space_s) (append start (cons (UiExpand (UiLabel status (UiDimmed) (UiCenter))) end))))
               (cons (UiSeparator (UiH)) (cons (UiExpand body) (nil UiWidget))))))

; A sidebar beside pane, a line between them, pane given the rest, as
; AdwNavigationSplitView shows them.
(def ui_split ((sidebar UiWidget) (pane UiWidget)) UiWidget
  (UiBox (UiH) 0 (cons sidebar (cons (UiSeparator (UiV)) (cons (UiExpand pane) (nil UiWidget))))))

; ----------------------------------------------------------------- sizes

; How wide an entry that holds n of anything is: n of the face's widest
; characters, its text's inset each side, and its cursor.
(def ui_entry_w ((n int)) int
  (add (ui_chars_w n (ui_text_font) false) (add (mul 2 (ui_entry_pad)) (ui_entry_cursor_w))))

; w kept at least wd wide, so a dialog keeps its width as what is in it
; is typed.
(def ui_at_least ((wd int) (w UiWidget)) UiWidget
  (UiBox (UiV) 0 (cons (UiSpace wd 0) (cons w (nil UiWidget)))))

; --------------------------------------------------------------- dialogs

; What a dialog's Cancel sets off.
(def ui_cancel_action () (list int) "dialog.cancel")

; A dialog's Cancel.
(def ui_cancel_button () UiWidget (UiButton (ui_cancel_action) "" "Cancel" (UiBtnRegular) true))

; An alert asking whether to do something: heading, lines, Cancel, and
; a button labelled label setting off action, red if it destroys
; something, else in the accent. Over a page as UiModal's second.
(def ui_confirm ((heading (list int)) (lines (list (list int))) (action (list int)) (label (list int)) (destructive bool)) UiWidget
  (ui_alert heading lines
            (cons (ui_cancel_button)
                  (cons (UiButton action "" label (if destructive (UiBtnDestructive) (UiBtnSuggested)) true) (nil UiWidget)))))

; --------------------------------------------------------------- choices

; A toggle for each of labels, its key the label, for a UiToggleGroup.
(def ui_toggles ((labels (list (list int)))) (list UiToggle)
  (rev (ui_toggles_onto labels (nil UiToggle))))

; ui_toggles' loop, onto acc, reversed.
(def ui_toggles_onto ((labels (list (list int))) (acc (list UiToggle))) (list UiToggle)
  (if (is_empty labels) acc (ui_toggles_onto (tail labels) (cons (UiToggle (head labels) "" (head labels)) acc))))

; ----------------------------------------------------------------- lists

; xs without the element whose key is k, key giving each one's: a tab
; closed, a row deleted.
(def (ui_without T K) ((key (fn (T) K)) (k K) (xs (list T))) (list T)
  (ui_without_onto key k xs (nil T)))

; ui_without's loop, onto acc, reversed.
(def (ui_without_onto T K) ((key (fn (T) K)) (k K) (xs (list T)) (acc (list T))) (list T)
  (if (is_empty xs)
      (rev acc)
      (ui_without_onto key k (tail xs) (if (eq (key (head xs)) k) acc (cons (head xs) acc)))))

; The key to select once the element keyed k is taken out of xs, as
; GNOME's tab bars choose: the next one's, or the one before's if it is
; the last; before, given as none, if it is alone or not there.
(def (ui_key_after T K) ((key (fn (T) K)) (k K) (xs (list T)) (before K)) K
  (if (is_empty xs) before
      (eq (key (head xs)) k) (if (is_empty (tail xs)) before (key (head (tail xs))))
      (ui_key_after key k (tail xs) (key (head xs)))))

; A tab's key, for ui_without and ui_key_after over a tab bar's tabs.
(def ui_tab_key ((t UiTab)) (list int) (match t ((UiTab k title) k)))
