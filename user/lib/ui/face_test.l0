; face_test.l0 -- tests of the face: levels read from packed words,
; tables found by name, and the face file written and read back.

; A table 20 wide and 2 high: two words a row, the first pixel of row 1 at
; 15 and pixel 17 of it at 3.
(def table () UiCov
  (UiCov 20 2 (array_from (cons 0 (cons 0 (cons (bit_shl 15 60) (cons (bit_shl 3 56) (nil int))))) 0)))

(def test_levels () int
  (add (check_int "row 1's first" (ui_cov_level (table) 0 1) 15)
       (add (check_int "its seventeenth" (ui_cov_level (table) 17 1) 3)
            (check_int "row 0" (ui_cov_level (table) 0 0) 0))))

(def test_words_per_row () int
  (add (check_int "16" (ui_cov_wpr 16) 1)
       (add (check_int "17" (ui_cov_wpr 17) 2)
            (check_int "128" (ui_cov_wpr 128) 8))))

; Glyph code's rows follow those of every code before it.
(def test_glyph_level () int
  (let words (array_set (array_new (mul 95 2) 0) (add (mul (sub 66 32) 2) 1) (bit_shl 9 60))
    (add (check_int "B's second row" (ui_glyph_level (UiCov 16 2 words) 66 0 1) 9)
         (check_int "A's" (ui_glyph_level (UiCov 16 2 words) 65 0 1) 0))))

(def test_table_names () int
  (add (check_str "bold" (ui_glyph_table true 64) "glyph.bold.64")
       (add (check_str "regular" (ui_glyph_table false 32) "glyph.regular.32")
            (check_str "an icon" (ui_icon_table "pan-down" 32) "icon.pan-down.32"))))

(def test_round_trip () int
  (let m (ui_face_tables (ui_face_file (cons (UiNamedCov "icon.x.20" (table)) (nil UiNamedCov))))
    (match (map_get m "icon.x.20")
      ((None) (fail_because "table" "not read back"))
      ((Some c) (add (check_int "its level" (ui_cov_level c 17 1) 3)
                     (check_int "its width" (match c ((UiCov w h ws) w)) 20))))))

; What is not a face file holds no tables; one cut short keeps those
; before the cut.
(def test_not_a_face () int
  (add (check_int "not one" (map_size (ui_face_tables (bytes_from_list "P6 not a face"))) 0)
       (let b (ui_face_file (cons (UiNamedCov "a" (table)) (cons (UiNamedCov "b" (table)) (nil UiNamedCov))))
         (check_int "cut short" (map_size (ui_face_tables (bytes_from_list (take (bytes_to_list b) (sub (bytes_len b) 4))))) 1))))

(def test_face_none () int
  (let f (ui_face_none)
    (add (check_int "scale" (ui_face_scale f) 1)
         (check_bool "no text" (ui_face_has_text f) false))))

; A face has text when it has the regular glyphs of its scale's height:
; 16 at 1, 32 at 2.
(def test_face_has_text () int
  (let c (UiCov 8 16 (array_new 0 0))
    (add (check_bool "at 1" (ui_face_has_text (UiFace 1 (map_put ((MapEmpty (list int) UiCov)) "glyph.regular.16" c))) true)
         (add (check_bool "at 2 wanting 32" (ui_face_has_text (UiFace 2 (map_put ((MapEmpty (list int) UiCov)) "glyph.regular.16" c))) false)
              (check_str "the name" (ui_glyph_table false 16) "glyph.regular.16")))))

; An image file's tables in size order, the sizes it has only, and none
; from what is not a face file.
(def test_images_of () int
  (let one (UiCov 16 16 (array_new 256 0))
    (let two (UiCov 48 48 (array_new 2304 0))
      (let b (ui_face_file (cons (UiNamedCov (ui_image_table 48) two) (cons (UiNamedCov "glyph.regular.16" one) (cons (UiNamedCov (ui_image_table 16) one) (nil UiNamedCov)))))
        (add (check_int "two" (length (ui_images_of b (ui_image_sizes))) 2)
             (add (check_true "16 first" (eq (head (ui_images_of b (ui_image_sizes))) one))
                  (check_int "not a face" (length (ui_images_of (bytes_from_list "nope") (ui_image_sizes))) 0)))))))

; Only the sizes a scale paints are kept: at 2, of 16 and 48, none but
; 32, 64 and 96.
(def test_images_at_scale () int
  (let b (ui_face_file (cons (UiNamedCov (ui_image_table 16) (UiCov 16 16 (array_new 256 0)))
                             (cons (UiNamedCov (ui_image_table 96) (UiCov 96 96 (array_new 9216 0))) (nil UiNamedCov))))
    (add (check_true "at 2" (eq (ui_image_sizes_at 2) (cons 32 (cons 64 (cons 96 (nil int))))))
         (check_int "the 96 alone" (length (ui_images_of b (ui_image_sizes_at 2))) 1))))

; Loaded images are found by name; one not loaded is none, and one with
; no tables is not kept.
(def test_images_by_name () int
  (let ts (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov))
    (let im (ui_images_with (ui_images_with (ui_images_none) "folder" ts) "computer" (nil UiCov))
      (add (check_true "folder" (eq (ui_image im "folder") ts))
           (add (check_int "computer" (length (ui_image im "computer")) 0)
                (check_str "path" (ui_image_path "folder") "/etc/images/folder.face"))))))

; With no /etc/images on this host, nothing is loaded.
(def test_images_load_none () int
  (check_int "none" (length (ui_image (ui_images_load (cons "folder" (nil (list int))) 1) "folder")) 0))
