; entry_test.l0 -- the text entry: editing its text and moving its cursor,
; its actions, and how it is laid out and painted.

(def et ((s (list int)) (c int)) UiEntryText (UiEntryText s c))

(def et_text ((t UiEntryText)) (list int)
  (append (ui_entry_text t) (append "|" (digits (ui_entry_cursor t)))))

; A key pressed: its code and the character it typed.
(def press ((code int) (ch int)) KeyEvent (KeyEvent code 1 ch))

(def er ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; Each op, briefly: what it paints, where, and in what color.
(def eops ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPFill r c) (append "fill " (append (er r) (append " " (hex_digits c 6)))))
                ((UiPRound r rad c u) (append "round " (append (er r) (append " " (hex_digits c 6)))))
                ((UiPText r s a c f b sc) (append "text " (append s (append " " (append (er r) (append " " (hex_digits c 6)))))))
                ((UiPIcon x y n c sc) "icon")
                ((UiPImage x y n d ts) "image"))
              (append "; " (eops (tail ops))))))

(def light () UiState (ui_state_new (UiLight)))

(def node_text ((n UiNode)) (list int)
  (match n ((UiNode r ops a f) (append a (append "@" (append (er r) (if f " focusable" "")))))))

(def node_ops ((n UiNode)) (list int) (match n ((UiNode r ops a f) (eops ops))))

; An entry 200 wide in a row 50 high at 10, 0, on the window's ground.
(def laid ((t UiEntryText) (st UiState)) UiNode
  (head (ui_layout (UiEntry "size" t "Size" 200) (Rect 10 0 200 50) st (ui_hex "fafafa"))))

; ----------------------------------------------------------------- editing

(def test_new () int
  (check_str "the cursor at the end" (et_text (ui_entry_new "abc")) "abc|3"))

(def test_typed () int
  (add (check_str "at the cursor" (et_text (ui_entry_keyed (et "ac" 1) (press 48 98))) "abc|2")
       (add (check_str "at the end" (et_text (ui_entry_keyed (et "ab" 2) (press 46 99))) "abc|3")
            (check_str "a space" (et_text (ui_entry_keyed (et "ab" 0) (press 57 32))) " ab|1"))))

(def test_backspace () int
  (add (check_str "the one before" (et_text (ui_entry_keyed (et "abc" 2) (press (ui_key_backspace) 8))) "ac|1")
       (check_str "nothing before" (et_text (ui_entry_keyed (et "abc" 0) (press (ui_key_backspace) 8))) "abc|0")))

(def test_delete () int
  (add (check_str "the one after" (et_text (ui_entry_keyed (et "abc" 1) (press (ui_key_delete) 0))) "ac|1")
       (check_str "nothing after" (et_text (ui_entry_keyed (et "abc" 3) (press (ui_key_delete) 0))) "abc|3")))

(def test_left_right () int
  (add (check_str "left" (et_text (ui_entry_keyed (et "abc" 2) (press (ui_key_left) 0))) "abc|1")
       (add (check_str "not past the start" (et_text (ui_entry_keyed (et "abc" 0) (press (ui_key_left) 0))) "abc|0")
            (check_str "not past the end" (et_text (ui_entry_keyed (et "abc" 3) (press (ui_key_right) 0))) "abc|3"))))

(def test_home_end () int
  (add (check_str "home" (et_text (ui_entry_keyed (et "abc" 2) (press (ui_key_home) 0))) "abc|0")
       (check_str "end" (et_text (ui_entry_keyed (et "abc" 1) (press (ui_key_end) 0))) "abc|3")))

; Held, a key repeats; let go, it does nothing; Tab's character, 9, is
; not one the entry types.
(def test_keys_ignored () int
  (add (check_str "repeated" (et_text (ui_entry_keyed (et "a" 1) (KeyEvent 30 2 97))) "aa|2")
       (add (check_str "released" (et_text (ui_entry_keyed (et "a" 1) (KeyEvent 30 0 0))) "a|1")
            (check_str "a control character" (et_text (ui_entry_keyed (et "a" 1) (press 15 9))) "a|1"))))

; A cursor past the text, as a program might keep one, is taken as at its
; end.
(def test_placed () int
  (add (check_str "within" (et_text (ui_entry_placed (et "abc" 0) 2)) "abc|2")
       (add (check_str "past the end" (et_text (ui_entry_placed (et "abc" 0) 9)) "abc|3")
            (check_str "typing past the end" (et_text (ui_entry_keyed (et "ab" 7) (press 46 99))) "abc|3"))))

; ----------------------------------------------------------------- actions

(def test_actions () int
  (add (check_str "its own" (ui_entry_action "size") "size.entry")
       (add (check_str "edit" (ui_entry_edit_action "size") "size.edit")
            (add (check_str "activate" (ui_entry_activate_action "size") "size.activate")
                 (check_str "place" (ui_entry_place_action "size" 3) "size.place.3")))))

(def test_name_of () int
  (add (check_str "an entry" (ui_entry_name_of "dialog.size.entry") "dialog.size")
       (add (check_str "a button" (ui_entry_name_of "app.refresh") "")
            (check_str "no name" (ui_entry_name_of ".entry") ""))))

; An entry's node from 100, its text "abc" from 109, in face f.
(def entry_at ((f UiFont)) UiNode
  (UiNode (Rect 100 0 200 34) (cons (UiPRound (Rect 100 0 200 34) 6 0 0) (cons (UiPText (Rect 109 0 182 34) "abc" (UiStart) 0 f false 1) (nil UiPaint))) "e.entry" true))

; In Source Code Pro, 8 a character: a press before a character's middle
; is before it, after its middle after it.
(def test_char_at () int
  (let n (entry_at (UiMono))
    (add (check_int "at the text's start" (ui_entry_char_at n 109) 0)
         (add (check_int "past the first's middle" (ui_entry_char_at n 113) 1)
              (add (check_int "before its middle" (ui_entry_char_at n 112) 0)
                   (add (check_int "left of the text" (ui_entry_char_at n 101) 0)
                        (check_int "past its end" (ui_entry_char_at n 200) 3)))))))

; In Source Sans 3, a is 504 units, so b's pen 6.72 pixels in, rounded
; 7, and a's middle 3: a press at 112 is after it, at 111 before.
(def test_char_at_sans () int
  (let n (entry_at (UiSans))
    (add (check_int "after a's middle" (ui_entry_char_at n 112) 1)
         (check_int "before it" (ui_entry_char_at n 111) 0))))

; The pens of Source Sans 3's "abc": a is 504 units, b 553, so 6.72,
; and 14.09, rounded 7 and 14.
(def test_text_pen () int
  (add (check_int "b" (ui_text_pen "abc" (UiSans) false 1) 7)
       (add (check_int "c" (ui_text_pen "abc" (UiSans) false 2) 14)
            (check_int "mono's c" (ui_text_pen "abc" (UiMono) false 2) 16))))

; ------------------------------------------------------------------ layout

(def test_size () int
  (check_bool "its width, a button high" (eq (ui_measure (UiEntry "a" (ui_entry_new "") "" 120)) (UiSize 120 34)) true))

; 34 high in the middle of 50: from 8.
(def test_node () int
  (check_str "its action, a button high in the middle" (node_text (laid (et "ab" 1) (light))) "size.entry@10,8 200x34 focusable"))

; Its ground the text at 10% on fafafa, e6e6e6; its text 9 in, in the
; text's color, 323232; no cursor without the focus.
(def test_unfocused () int
  (check_str "ground and text" (node_ops (laid (et "ab" 1) (light)))
             "round 10,8 200x34 e6e6e6; text ab 19,8 182x34 323232; "))

; Focused: the ring, the accent at half on fafafa, 98bfef; the ground 2
; in; and the cursor before b, at 19 + a's advance, 504 units of Source
; Sans 3, 6.72 pixels, rounded 7, in the middle of the row, 8 + 9.
(def test_focused () int
  (check_str "ring, ground, text, cursor" (node_ops (laid (et "ab" 1) (ui_st_focusing (light) "size.entry")))
             "round 10,8 200x34 98bfef; round 12,10 196x30 e6e6e6; text ab 19,8 182x34 323232; fill 26,17 1x16 323232; "))

; Empty, the placeholder in the dimmed text's color on the entry's
; ground: 50 * 0.55 + 230 * 0.45 = 131, 83.
(def test_placeholder () int
  (check_str "dimmed" (node_ops (laid (et "" 0) (light)))
             "round 10,8 200x34 e6e6e6; text Size 19,8 182x34 838383; "))

; The cursor never goes past the entry's end.
(def test_cursor_kept_in () int
  (check_str "at the text's edge"
    (eops (cons (ui_entry_cursor_op (Rect 0 0 16 16) (et "abcdef" 6) (UiLight)) (nil UiPaint)))
    "fill 16,0 1x16 323232; "))
