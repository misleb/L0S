(def irect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; The actions of the nodes that have one, and where each is.
(def iv_targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (iv_targets (tail ns)) (append a (append "@" (append (irect r) (append " " (iv_targets (tail ns)))))))))))

(def iv_light () UiState (ui_state_new (UiLight)))

; Tiles a, b, c... of n.
(def tiles_of ((n int)) (list UiTile) (tiles_onto n (nil UiTile)))

(def tiles_onto ((n int) (acc (list UiTile))) (list UiTile)
  (if (le n 0) acc (tiles_onto (sub n 1) (cons (UiTile (cons (add 96 n) (nil int)) "folder" "x" (UiAccentTone)) acc))))

(def view_of ((n int) (sel (list int)) (first int)) UiIconData (UiIconData "iv" (tiles_of n) (UiIconState sel first)))

; A view 400 wide holds 3 tiles across, (400 - 24) / 112, in the middle,
; 336 of them from 32; 300 high, 3 rows, (300 - 12) / 96, from 12 down.
; Five tiles are two rows, which all show: no scrollbar.
(def test_ui_icon_layout () int
  (check_str "the area, then the tiles"
    (iv_targets (ui_layout (UiIconView (view_of 5 "" 0)) (Rect 0 0 400 300) (iv_light) 0))
    (append "iv.scroll.0.0.3.96@0,12 400x288 iv.select.a@32,12 112x96 iv.select.b@144,12 112x96 iv.select.c@256,12 112x96 "
            "iv.select.d@32,108 112x96 iv.select.e@144,108 112x96 ")))

; Twelve tiles are four rows, of which three show: from the second, its
; tiles first, then the scrollbar's strip, the last 12 of the view, its
; slider three quarters of the 288 rows, 216, with 72 to travel.
(def test_ui_icon_scrolled () int
  (let t (iv_targets (ui_layout (UiIconView (view_of 12 "" 1)) (Rect 0 0 400 300) (iv_light) 0))
    (add (check_bool "from the second row" (starts_with t "iv.scroll.1.1.3.96@0,12 400x288 iv.select.d@32,12 ") true)
         (check_bool "and its scrollbar" (ends_with t "iv.scrollbar.1.1.72.216@388,12 12x288 ") true))))

(def test_ui_icon_cols () int
  (add (check_int "three in 400" (ui_icon_cols 400) 3)
       (add (check_int "one, however narrow" (ui_icon_cols 50) 1)
            (check_int "rows of 7, 3 across" (ui_icon_row_count 7 3) 3))))

(def sel_of ((s UiIconState)) (list int) (match s ((UiIconState k f) k)))
(def first_of ((s UiIconState)) int (match s ((UiIconState k f) f)))

; Five tiles, 3 across, 2 rows showing: Down from b is e, a row on; from
; c there is none under it, so it stays; Right from e, the last, stays;
; Up from e is b; and with none selected, Down selects a.
(def test_ui_icon_keys () int
  (let sc (UiScroller 0 0 2)
    (add (check_str "down" (sel_of (ui_icon_key (view_of 5 "b" 0) (ui_key_down) sc 3)) "e")
         (add (check_str "down, none under" (sel_of (ui_icon_key (view_of 5 "c" 0) (ui_key_down) sc 3)) "c")
              (add (check_str "right, at the end" (sel_of (ui_icon_key (view_of 5 "e" 0) (ui_key_right) sc 3)) "e")
                   (add (check_str "up" (sel_of (ui_icon_key (view_of 5 "e" 0) (ui_key_up) sc 3)) "b")
                        (check_str "from none" (sel_of (ui_icon_key (view_of 5 "" 0) (ui_key_down) sc 3)) "a")))))))

; Twelve tiles, 4 rows, 2 showing from the first: End selects l, in the
; last row, so the third row is shown first.
(def test_ui_icon_key_scrolls () int
  (check_int "the last row shown" (first_of (ui_icon_key (view_of 12 "a" 0) (ui_key_end) (UiScroller 0 2 2) 3)) 2))

; A tile selected by its action; a press between the tiles, on the area,
; selects nothing; scrolled by scrollto.
(def test_ui_icon_action () int
  (add (check_str "selected" (sel_of (ui_icon_action (UiIconState "" 0) "iv" "iv.select.c")) "c")
       (add (check_str "between them" (sel_of (ui_icon_action (UiIconState "c" 0) "iv" "iv.scroll.0.0.3.96")) "")
            (add (check_int "scrolled" (first_of (ui_icon_action (UiIconState "c" 0) "iv" "iv.scrollto.2")) 2)
                 (check_str "another's" (sel_of (ui_icon_action (UiIconState "c" 0) "iv" "other.select.a")) "c")))))

; The row of tile 7, 3 across, is the third: with 2 rows showing from
; the first, the second is shown first, to show it.
(def test_ui_icon_first () int
  (add (check_int "brought into view" (ui_icon_first 0 7 3 4 2) 1)
       (check_int "never past the end" (ui_icon_first 9 -1 3 4 2) 2)))

; A selected tile is rounded in the selection's tint; its icon in the
; accent, for a folder.
(def test_ui_icon_selected () int
  (match (head (rev (ui_layout (UiIconView (view_of 1 "a" 0)) (Rect 0 0 400 300) (iv_light) 0)))
    ((UiNode r ops a f)
      (if (lt (length ops) 2)
          (fail_because "selected" "too few ops")
          (add (check_bool "rounded" (match (head ops) ((UiPRound x rd c u) (eq c (ui_selected_bg (ui_view_bg (UiLight))))) ((UiPFill x c) false) ((UiPText x s al c b sc) false) ((UiPIcon x y n c s) false)) true)
               (check_bool "an accent icon" (match (nth ops 1) ((UiPIcon x y n c s) (eq c (ui_accent_bg))) ((UiPRound x rd c u) false) ((UiPFill x c) false) ((UiPText x s al c b sc) false)) true))))))
