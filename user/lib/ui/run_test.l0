; A counter, the smallest program ui_run runs: its view a label and a
; button, its update counting app.add.
(data Count (Count (n int) (started bool)))

(def count_view ((c Count)) UiWidget
  (UiBox (UiV) 0 (cons (UiLabel (digits (.n c)) (UiLarge) (UiCenter)) (cons (UiButton "app.add" "" "Add" (UiBtnRegular) true) (nil UiWidget)))))

(def count_step ((c Count) (action (list int)) (ev UiEvent) (w UiWin)) (UiStepped Count)
  (UiStepped w (if (eq action "app.add") (.n c (add (.n c) 1)) (eq action (ui_start_action)) (.started c true) c)))

; Under an operating system there is no compositor: the window cannot
; open, and the program fails, saying so.
(def test_no_compositor () int
  (check_int "fails" (ui_run "count" "Count" 200 100 (Count 0 false) count_view count_step) 1))

(def test_no_compositor_csd () int
  (check_int "fails" (ui_run_csd "count" "Count" 200 100 (Count 0 false) count_view count_step) 1))

; The start's action is the one the update is given as the window opens.
(def test_start_action () int
  (check_str "app.start" (ui_start_action) "app.start"))
