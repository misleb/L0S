; menu.l0 -- a popover menu, as GTK's GtkPopoverMenu: a card of items
; over the window, under the button that opened it, as a header bar's
; menu button opens the app's menu, or where the pointer was, as a right
; click opens a context menu. What is beneath it is drawn as it was, but
; is no target while it is open: a press outside it closes it and does
; nothing else, as GTK's popovers do, so the program closes it on
; PREFIX.dismiss, and on Esc. Its UiWidget constructor is widget.l0's
; UiPopover.

; Where a menu goes: under the node whose action is the one given, its
; middle under the node's; or with its top left at a point of the window.
(data UiAnchor (UiBelow (list int)) (UiAt int int))

; An item: its action, its label, and whether it can be chosen; or a line
; between groups of them.
(data UiMenuItem (UiItem (list int) (list int) bool) (UiItemSep))

; A menu: its actions' prefix, for its dismiss, where it goes, and its
; items, in order.
(data UiMenu (UiMenu (list int) UiAnchor (list UiMenuItem)))

; The action a press outside a menu sets off, PREFIX.dismiss; and the
; one of its card's own ground, which does nothing.
(def ui_menu_dismiss_action ((prefix (list int))) (list int) (append prefix ".dismiss"))
(def ui_menu_card_action ((prefix (list int))) (list int) (append prefix ".card"))

; ---------------------------------------------------------------- sizes

; How far an item's label is in from the card's side, its row's 6 and
; 12 more, as libadwaita's are.
(def ui_item_pad () int (add (ui_menu_pad) (ui_space_m)))

; How high an item is: a row, a data grid's; a line between groups, the
; line and 6 above and below it.
(def ui_item_h ((it UiMenuItem)) int
  (match it ((UiItem a l s) (ui_row_h)) ((UiItemSep) (add 1 (mul 2 (ui_menu_pad))))))

; How wide an item's label wants the card to be.
(def ui_item_w ((it UiMenuItem)) int
  (match it ((UiItem a l s) (add (ui_text_w l (ui_text_font) false 1) (mul 2 (ui_item_pad)))) ((UiItemSep) 0)))

; A menu's card: as wide as its widest item, at least ui_menu_min_w; its
; items' heights and 6 above and below them.
(def ui_menu_size ((items (list UiMenuItem))) UiSize
  (UiSize (ui_menu_width items (ui_menu_min_w)) (add (mul 2 (ui_menu_pad)) (ui_items_h items))))

; The widest of items, and w.
(def ui_menu_width ((items (list UiMenuItem)) (w int)) int
  (if (is_empty items) w (ui_menu_width (tail items) (max w (ui_item_w (head items))))))

; The items' heights added up.
(def ui_items_h ((items (list UiMenuItem))) int
  (if (is_empty items) 0 (add (ui_item_h (head items)) (ui_items_h (tail items)))))

; Where a card cw by ch goes in r for anchor a, the nodes beneath being
; ns, newest first: under its node, 4 below and centered on it, or at its
; point; either way kept 6 inside r. An anchor whose node is not there
; puts it in r's middle.
(def ui_menu_rect ((a UiAnchor) (ns (list UiNode)) (cw int) (ch int) (r Rect)) Rect
  (let (at (match a
             ((UiAt x y) (Rect x y 0 0))
             ((UiBelow action)
               (match (ui_newest_with ns action)
                 ((None) (Rect (add (.x r) (div (sub (.w r) cw) 2)) (add (.y r) (div (sub (.h r) ch) 2)) 0 0))
                 ((Some n)
                   (let nr (.rect n)
                     (Rect (sub (add (.x nr) (div (.w nr) 2)) (div cw 2)) (add (rect_y1 nr) 4) 0 0))))))
        m (ui_space_s))
    (Rect (ui_clamp (.x at) (add (.x r) m) (max (add (.x r) m) (sub (rect_x1 r) (add cw m))))
          (ui_clamp (.y at) (add (.y r) m) (max (add (.y r) m) (sub (rect_y1 r) (add ch m))))
          (min cw (.w r)) (min ch (.h r)))))

; The first of nodes ns, newest first, whose action is a.
(def ui_newest_with ((ns (list UiNode)) (a (list int))) (Option UiNode)
  (if (is_empty ns) ((None UiNode)) (eq (.action (head ns)) a) (Some (head ns)) (ui_newest_with (tail ns) a)))

; --------------------------------------------------------------- layout

; base laid out in r, then the menu over it: a node over all of r that
; dismisses it, so nothing beneath is a target; the card, its border the
; border's color and its ground the card's, rounded as a card is; and its
; items down it.
(def ui_popover_lay ((base UiWidget) (menu UiMenu) (r Rect) (st UiState) (bg int) (acc (list UiNode))) (list UiNode)
  (match menu
    ((UiMenu prefix anchor items)
      (let (under (ui_lay base r st bg acc)
            s (.style st)
            cbg (ui_card_bg s)
            line (ui_border s bg))
        (match (ui_menu_size items)
          ((UiSize cw ch)
            (let (card (ui_menu_rect anchor under cw ch r)
                  catcher (cons (UiNode r (nil UiPaint) (ui_menu_dismiss_action prefix) false) under)
                  ground (cons (UiNode card (cons (UiPRound card (ui_window_radius) line -1)
                                                  (cons (UiPRound (rect_inset card 1) (sub (ui_window_radius) 1) cbg line) (nil UiPaint)))
                                       (ui_menu_card_action prefix) false)
                               catcher))
              (ui_items_lay items (add (.x card) (ui_menu_pad)) (add (.y card) (ui_menu_pad))
                            (max 0 (sub (.w card) (mul 2 (ui_menu_pad)))) st cbg ground))))))))

; Each item from x, y down, w wide, on the card's ground cbg, onto acc.
(def ui_items_lay ((items (list UiMenuItem)) (x int) (y int) (w int) (st UiState) (cbg int) (acc (list UiNode))) (list UiNode)
  (if (is_empty items)
      acc
      (let it (head items)
        (ui_items_lay (tail items) x (add y (ui_item_h it)) w st cbg
                      (cons (ui_item_node it (Rect x y w (ui_item_h it)) st cbg) acc)))))

; An item's node in ir: one that can be chosen a target, lit under the
; pointer and darker pressed, as a flat button, its label 12 in; one that
; cannot be, its label dimmed and no target; a line, across the card.
(def ui_item_node ((it UiMenuItem) (ir Rect) (st UiState) (cbg int)) UiNode
  (let s (.style st)
    (match it
      ((UiItemSep)
        (UiNode ir (cons (UiPFill (Rect (.x ir) (add (.y ir) (ui_menu_pad)) (.w ir) 1) (ui_border s cbg)) (nil UiPaint)) "" false))
      ((UiItem action label sensitive)
        (let tr (Rect (add (.x ir) (ui_space_m)) (.y ir) (max 0 (sub (.w ir) (mul 2 (ui_space_m)))) (.h ir))
          (if (not sensitive)
              (UiNode ir (cons (UiPText tr label (UiStart) (ui_dim_fg s cbg) (ui_text_font) false 1) (nil UiPaint)) "" false)
              (match (ui_button_ink (UiBtnFlat) (eq (.hover st) action) (eq (.pressed st) action) st cbg)
                ((UiInk ground fg)
                  (let text (UiPText tr label (UiStart) fg (ui_text_font) false 1)
                    (UiNode ir (if (lt ground 0) (cons text (nil UiPaint)) (cons (UiPRound ir (ui_button_radius) ground cbg) (cons text (nil UiPaint))))
                            action true))))))))))
