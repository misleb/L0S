; n rows keyed 1 to n, titled Row K, each a click's.
(def numbered ((n int)) (list UiListRow) (numbered_onto n (nil UiListRow)))
(def numbered_onto ((k int) (acc (list UiListRow))) (list UiListRow)
  (if (lt k 1) acc (numbered_onto (sub k 1) (cons (ui_list_row (digits k) (append "Row " (digits k)) "") acc))))

; A list of rows laid out in a window w by h, from its first row first.
(def list_in ((rows (list UiListRow)) (first int) (w int) (h int)) (list UiNode)
  (ui_laid (UiList (UiListData "items" rows first)) w h))

; Each row is 50 high, from the list's top, and sets off its select.
(def test_rows_placed () int
  (let ns (list_in (numbered 3) 0 400 300)
    (add (check_str "the first" (ui_target_at ns "items.select.1") "0 0 400 50")
         (check_str "the third" (ui_target_at ns "items.select.3") "0 100 400 50"))))

; Its texts: each row's title, in order, and a subtitle under its title.
(def test_row_texts () int
  (check_str "titles" (ui_texts (list_in (cons (ui_list_row "a" "Milk" "2 litres") (numbered 1)) 0 400 300))
             "Milk|2 litres|Row 1|"))

; A switch at a row's end sets off its own toggle over the row: a press
; on it is the switch's, one on the title the row's.
(def test_end_widget () int
  (let ns (list_in (cons (.end (ui_list_row "w" "Wi-Fi" "") (UiSwitch "wifi" true)) (nil UiListRow)) 0 400 300)
    (add (check_str "on the switch" (ui_hit ns (sub 400 (add (ui_space_m) 10)) 25) "wifi.toggle")
         (check_str "on the title" (ui_hit ns 60 25) "items.select.w"))))

; A check box at its start comes before its title, which moves past it.
(def test_start_widget () int
  (let ns (list_in (cons (.start (ui_list_row "t" "Milk" "") (UiCheck "item.t" false "")) (nil UiListRow)) 0 400 300)
    (add (check_str "the check" (ui_target_at ns "item.t.toggle") "12 17 16 16")
         (check_str "the row under it" (ui_hit ns 200 25) "items.select.t"))))

; A row the program says is not actionable sets off nothing.
(def test_not_actionable () int
  (check_bool "no target" (ui_has_target (list_in (cons (.actionable (ui_list_row "x" "Info" "") false) (nil UiListRow)) 0 400 300) "items.select.x")
              false))

; Ten rows in 160 rows of room: three show, from the first kept, and the
; area says so, for the wheel: first 4, at most 7, 3 shown, steps of 50.
(def test_scrolls () int
  (let ns (list_in (numbered 10) 4 400 160)
    (add (check_bool "the area" (ui_has_target ns "items.scroll.4.7.3.50") true)
         (add (check_bool "row 5 first" (eq (ui_target_at ns "items.select.5") "0 0 400 50") true)
              (check_bool "row 4 gone" (ui_has_target ns "items.select.4") false)))))

; A first past the end shows the last rows that fit.
(def test_first_kept_in () int
  (check_str "8 to 10" (ui_target_at (list_in (numbered 10) 99 400 160) "items.select.8") "0 0 400 50"))

; The program keeps the first row a scrollto says.
(def test_list_first () int
  (add (check_int "scrolled" (ui_list_first 0 "items" "items.scrollto.6") 6)
       (check_int "another's" (ui_list_first 2 "items" "procs.scrollto.6") 2)))

; No rows, nothing drawn but the window.
(def test_empty () int
  (check_int "the ground alone" (length (list_in (nil UiListRow) 0 400 300)) 1))

; Its natural height is its rows', at most five.
(def test_size () int
  (add (check_int "two" (.sh (ui_measure (UiList (UiListData "i" (numbered 2) 0)))) 100)
       (check_int "nine" (.sh (ui_measure (UiList (UiListData "i" (numbered 9) 0)))) 250)))
