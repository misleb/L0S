(def wrect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def size_text ((s UiSize)) (list int) (append (digits (ui_sw s)) (append "x" (digits (ui_sh s)))))

; The actions of the nodes that have one, and where each is.
(def targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (targets (tail ns)) (append a (append "@" (append (wrect r) (append " " (targets (tail ns)))))))))))

(def light () UiState (ui_state_new (UiLight)))

; "abc" in Source Sans 3 is 1513 units, 20.17 pixels, so 21; large, bold
; at 2, 1567 units, 41.79, so 42.
(def test_ui_measure_label () int
  (add (check_str "body" (size_text (ui_measure (UiLabel "abc" (UiBody) (UiStart)))) "21x16")
       (check_str "large" (size_text (ui_measure (UiLabel "abc" (UiLarge) (UiStart)))) "42x32")))

; Text in a face at a height: "abc" in sans at 32, 1513 units, 40.35
; pixels, so 41, a line of 32 high.
(def test_ui_measure_text () int
  (check_str "41 by 32" (size_text (ui_measure (UiText "abc" (UiFontAt "sans" 32) (UiStart)))) "41x32"))

; Refresh is 3163 units of advances, less 20 of its pairs' kerning,
; 3143, 41.91 pixels, so 42, and 10 either side.
(def test_ui_measure_button () int
  (add (check_str "text" (size_text (ui_measure (UiButton "a" "" "Refresh" (UiBtnRegular) true))) "62x34")
       (add (check_str "an icon alone" (size_text (ui_measure (UiButton "a" "view-refresh" "" (UiBtnFlat) true))) "34x34")
            (check_str "a title bar's" (size_text (ui_measure (UiButton "a" "window-close" "" (UiBtnTitle) true))) "24x24"))))

; "ab", 1057 units, 14.09 pixels, so 15; 6; a button of x, 34 square.
(def test_ui_measure_box () int
  (check_str "a row, 6 apart"
    (size_text (ui_measure (UiBox (UiH) 6 (cons (UiLabel "ab" (UiBody) (UiStart)) (cons (UiButton "a" "" "x" (UiBtnRegular) true) (nil UiWidget))))))
    "55x34"))

; 200 across: the label 16, the button 34, the spacer between them the
; rest, 200 - 16 - 34 - 12.
(def test_ui_box_expands () int
  (check_str "the button at the end"
    (targets (ui_layout (UiBox (UiH) 6 (cons (UiLabel "ab" (UiBody) (UiStart))
                                       (cons (UiExpand (UiSpace 0 0))
                                       (cons (UiButton "go" "" "x" (UiBtnRegular) true) (nil UiWidget)))))
                        (Rect 0 0 200 34) (light) 0))
    "go@166,0 34x34 "))

; 101 rows: 50 and the remainder, 51, each button in the middle of its.
(def test_ui_box_shares () int
  (check_str "two expanders, the last the remainder"
    (targets (ui_layout (UiBox (UiV) 0 (cons (UiExpand (UiButton "a" "" "a" (UiBtnFlat) true))
                                       (cons (UiExpand (UiButton "b" "" "b" (UiBtnFlat) true)) (nil UiWidget))))
                        (Rect 0 0 34 101) (light) 0))
    "a@0,8 34x34 b@0,58 34x34 "))

(def test_ui_insensitive () int
  (check_str "no target"
    (targets (ui_layout (UiButton "end" "" "End" (UiBtnDestructive) false) (Rect 0 0 100 34) (light) 0))
    ""))

; The colors a button is painted in: its ground's, then its label's.
(def button_colors ((ns (list UiNode))) (list int)
  (if (is_empty ns) "" (match (head ns) ((UiNode r ops a f) (append (ops_colors ops) (button_colors (tail ns)))))))

(def ops_colors ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPRound r rad c u) (append "ground " (append (hex_digits c 6) " ")))
                ((UiPText r s a c f b sc) (append "label " (append (hex_digits c 6) " ")))
                ((UiPFill r c) "")
                ((UiPIcon x y n c sc) "")
                ((UiPImage x y n d ts) ""))
              (ops_colors (tail ops)))))

; End Process with nothing selected, on the window's fafafa: its red and
; its white label both at half over fafafa, so the label still reads.
(def test_ui_insensitive_label () int
  (check_str "the label mixed with the window's ground, not the button's"
    (button_colors (ui_layout (UiButton "end" "" "End" (UiBtnDestructive) false) (Rect 0 0 100 34) (light) (ui_hex "fafafa")))
    "ground ed8b8f label fdfdfd "))

(def test_ui_hit () int
  (let ns (ui_layout (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true) (cons (UiButton "b" "" "b" (UiBtnRegular) true) (nil UiWidget))))
                     (Rect 0 0 100 34) (light) 0)
    (add (check_str "the first" (ui_hit ns 10 10) "a")
         (add (check_str "the second" (ui_hit ns 45 10) "b")
              (check_str "past them" (ui_hit ns 90 10) "")))))

(def test_ui_hover_changes () int
  (let w (UiButton "a" "" "a" (UiBtnRegular) true)
    (check_bool "hovered paints otherwise"
      (eq (ui_layout w (Rect 0 0 34 34) (light) 0)
          (ui_layout w (Rect 0 0 34 34) (ui_st_hovering (light) "a") 0))
      false)))

; A title bar 640 wide: its close button 6 in from the right, in the
; middle of the 45 rows over its line.
(def test_ui_headerbar_close () int
  (check_str "at the end"
    (targets (ui_layout (UiHeaderBar (nil UiWidget) "vt1" (cons (UiButton "win.close" "window-close" "" (UiBtnTitle) true) (nil UiWidget)))
                        (Rect 0 0 640 (ui_headerbar_h)) (light) 0))
    "win.close@610,10 24x24 "))

(def title_rect ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      "none"
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty ops) (title_rect (tail ns))
              (match (head ops)
                ((UiPText tr s al c f b sc) (if b (wrect tr) (title_rect (tail ns))))
                ((UiPFill x c) (title_rect (tail ns)))
                ((UiPRound x rd c u) (title_rect (tail ns)))
                ((UiPIcon x y n c s) (title_rect (tail ns)))
                ((UiPImage x y n d ts) (title_rect (tail ns)))))))))

; vt1 in bold Source Sans 3, 1434 units, 19.12 pixels, so 20, in the
; middle of 640: from 310.
(def test_ui_headerbar_title () int
  (check_str "bold, in the middle"
    (title_rect (ui_layout (UiHeaderBar (nil UiWidget) "vt1" (nil UiWidget)) (Rect 0 0 640 (ui_headerbar_h)) (light) 0))
    "310,0 20x45"))

; A window's own header bar, 640 wide: its ground drags the window; a
; back button 6 in at its start, in the middle of the 45 rows over its
; line; the close button 6 in from the end; and the title, a button of
; Files, 1910 units, 25.47 pixels, so 26, and 10 either side, 46 wide,
; in the middle of the bar, at 297.
(def test_ui_csd_bar () int
  (check_str "the ground, the start, the end, the title"
    (targets (ui_layout (UiCsdBar (cons (UiButton "back" "go-previous" "" (UiBtnFlat) true) (nil UiWidget))
                                  (UiButton "title" "" "Files" (UiBtnFlat) true) (nil UiWidget) true)
                        (Rect 0 0 640 (ui_headerbar_h)) (light) 0))
    "win.move@0,0 640x46 back@6,5 34x34 win.close@610,10 24x24 title@297,5 46x34 "))

; With no close button, nothing at its end.
(def test_ui_csd_bar_no_close () int
  (check_str "the ground alone"
    (targets (ui_layout (UiCsdBar (nil UiWidget) (UiSpace 0 0) (nil UiWidget) false) (Rect 0 0 220 (ui_headerbar_h)) (light) 0))
    "win.move@0,0 220x46 "))

; A title 300 wide, between 46 and 400 of a bar 640 wide, is pushed left
; of the middle, to end at 400; one 500 wide is cut to the 354 there is,
; from 46.
(def test_ui_csd_title_rect () int
  (add (check_str "moved to fit" (wrect (ui_csd_title_rect 300 46 400 0 640 0 45)) "100,0 300x45")
       (add (check_str "cut to fit" (wrect (ui_csd_title_rect 500 46 400 0 640 0 45)) "46,0 354x45")
            (check_str "in the middle" (wrect (ui_csd_title_rect 100 46 600 0 640 0 45)) "270,0 100x45"))))

; Its natural size: the start, title and end, 6 apart and in, a header
; bar high: 34 + 46 + 24 + 24.
(def test_ui_csd_size () int
  (check_str "the row"
    (size_text (ui_measure (UiCsdBar (cons (UiButton "back" "go-previous" "" (UiBtnFlat) true) (nil UiWidget))
                                     (UiButton "title" "" "Files" (UiBtnFlat) true) (nil UiWidget) true)))
    "128x46"))

(def test_ui_focus_next () int
  (let ns (ui_layout (UiBox (UiH) 6 (cons (UiButton "a" "" "a" (UiBtnRegular) true)
                                    (cons (UiButton "b" "" "b" (UiBtnRegular) false)
                                    (cons (UiButton "c" "" "c" (UiBtnRegular) true) (nil UiWidget)))))
                     (Rect 0 0 200 34) (light) 0)
    (add (check_str "from nothing" (ui_focus_next ns "") "a")
         (add (check_str "past one not sensitive" (ui_focus_next ns "a") "c")
              (check_str "round again" (ui_focus_next ns "c") "a")))))

(def test_ui_layout_window () int
  (match (head (ui_layout_window (UiSpace 0 0) 100 50 (light)))
    ((UiNode r ops a f) (check_str "its ground first" (wrect r) "0,0 100x50"))))

; ------------------------------------------------------------- scrolling

(def scroll_text ((s UiScrollNode)) (list int)
  (match s
    ((UiScrollArea n f m v st) (append "area " (append n (ui_dot_nums (cons f (cons m (cons v (cons st (nil int)))))))))
    ((UiScrollBar n f m sp sl) (append "bar " (append n (ui_dot_nums (cons f (cons m (cons sp (cons sl (nil int)))))))))
    ((UiNoScroll) "none")))

(def test_ui_scroll_round_trip () int
  (add (check_str "an area" (scroll_text (ui_scroll_of (ui_scroll_area_action "procs" 3 12 10 30))) "area procs.3.12.10.30")
       (check_str "a scrollbar" (scroll_text (ui_scroll_of (ui_scrollbar_action "procs" 3 12 200 100))) "bar procs.3.12.200.100")))

(def test_ui_scroll_dotted_name () int
  (check_str "a name with dots" (scroll_text (ui_scroll_of "app.list.scroll.1.2.3.30")) "area app.list.1.2.3.30"))

(def test_ui_scroll_not_one () int
  (add (check_str "a row's" (scroll_text (ui_scroll_of "procs.select.5")) "none")
       (add (check_str "no name" (scroll_text (ui_scroll_of "scroll.1.2.3.30")) "none")
            (check_str "not a number" (scroll_text (ui_scroll_of "p.scroll.x.2.3.30")) "none"))))

(def test_ui_scrollto () int
  (check_str "row 7" (ui_scrollto_action "procs" 7) "procs.scrollto.7"))

; Three rows a step: 5 down a step is 8; up two steps from 5, not past
; 0; down ten steps, not past the most, 12.
(def test_ui_wheel_first () int
  (add (check_int "down" (ui_wheel_first 5 12 1) 8)
       (add (check_int "up, to the top" (ui_wheel_first 5 12 -2) 0)
            (check_int "down, to the end" (ui_wheel_first 5 12 10) 12))))

; A strip from y 100, 10 the most first, the slider travelling 200:
; first 5 has its top halfway, at 200. Back again, a top 10 down is half
; a row's travel, 20 a row, and rounds to row 1; off either end is 0 or
; 10.
(def test_ui_slider () int
  (add (check_int "halfway" (ui_slider_top 100 5 10 200) 200)
       (add (check_int "back again" (ui_slider_first 200 100 10 200) 5)
            (add (check_int "half a row rounds up" (ui_slider_first 110 100 10 200) 1)
                 (add (check_int "above the strip" (ui_slider_first 0 100 10 200) 0)
                      (check_int "below it" (ui_slider_first 900 100 10 200) 10))))))

; The scroller under a point, though a node with another action lies
; over it; and where it is scrolled, by its name.
(def scrolled_nodes () (list UiNode)
  (cons (UiNode (Rect 0 0 100 100) (nil UiPaint) (ui_scroll_area_action "p" 2 9 5 30) false)
  (cons (UiNode (Rect 0 0 100 30) (nil UiPaint) "p.select.1" false)
  (cons (UiNode (Rect 90 0 10 100) (nil UiPaint) (ui_scrollbar_action "p" 2 9 50 40) false) (nil UiNode)))))

(def test_ui_scroll_hit () int
  (add (check_str "under a row" (scroll_text (ui_scroll_hit (scrolled_nodes) 10 10)) "area p.2.9.5.30")
       (add (check_str "the scrollbar, on top" (scroll_text (ui_scroll_hit (scrolled_nodes) 95 50)) "bar p.2.9.50.40")
            (check_str "outside" (scroll_text (ui_scroll_hit (scrolled_nodes) 150 10)) "none"))))

(def test_ui_scroller_of () int
  (add (check_bool "p" (eq (ui_scroller_of (scrolled_nodes) "p") (UiScroller 2 9 5)) true)
       (check_bool "none called q" (eq (ui_scroller_of (scrolled_nodes) "q") (ui_no_scroller)) true)))

; ------------------------------------------------------------- keyed parts

; A page keyed "page" under a Back button, 200 by 100: the button 34
; high from 0, the page, a label, under it from 34, 200 by 66. With
; inner, the page has a button of its own, page.inner.
(def keyed_view ((inner bool)) UiWidget
  (UiBox (UiV) 0
    (cons (UiButton "app.back" "" "Back" (UiBtnRegular) true)
          (cons (UiExpand (UiKeyed "page" (if inner (UiButton "page.inner" "" "In" (UiBtnRegular) true) (UiLabel "words" (UiBody) (UiStart)))))
                (nil UiWidget)))))

(def keyed_rect () Rect (Rect 0 34 200 66))

(def laid_keyed ((st UiState) (inner bool)) (list UiNode) (ui_layout (keyed_view inner) (Rect 0 0 200 100) st 0))

; Laid out fresh, the page's nodes follow its mark, which says where it
; was laid out; ui_kept_of finds them again by the key.
(def test_keyed_kept_of () int
  (match (map_get (ui_kept_of (laid_keyed (light) false)) "page")
    ((None) (fail_because "kept" "no page"))
    ((Some k) (match k ((UiKept r sig ns) (add (check_str "where" (wrect r) "0,34 200x66") (check_int "one node, the label" (length ns) 1)))))))

; Nothing hits a mark, and it paints nothing.
(def test_keyed_mark_not_hit () int
  (check_str "the label's ground" (ui_hit (laid_keyed (light) false) 10 50) ""))

; Kept nodes for page, as a layout of st laid it out, against what st
; looks like: told apart from a fresh layout by their action, kept.
(def kept_fake ((st UiState) (inner bool)) (Map (list int) UiKept)
  (let ns (cons (UiNode (keyed_rect) (nil UiPaint) (if inner "page.inner" "kept") false) (nil UiNode))
    (map_put (ui_kept_none) "page" (UiKept (keyed_rect) (ui_key_sig st 0 ns) ns))))

; A hover over Back lays out Back and keeps the page.
(def test_keyed_hover_elsewhere () int
  (let st (ui_st_hovering (light) "app.back")
    (check_true "kept" (contains (targets (laid_keyed (ui_st_keeping st (kept_fake (light) false)) false)) "kept@"))))

; A hover over the page's own button lays it out again.
(def test_keyed_hover_inside () int
  (let st (ui_st_hovering (light) "page.inner")
    (check_true "laid out again" (not (contains (targets (laid_keyed (ui_st_keeping st (kept_fake (light) true)) true)) "kept@")))))

; Kept from another place, or another key, it is laid out again.
(def test_keyed_moved () int
  (let ns (cons (UiNode (keyed_rect) (nil UiPaint) "kept" false) (nil UiNode))
    (let moved (map_put (ui_kept_none) "page" (UiKept (Rect 0 40 200 60) (ui_key_sig (light) 0 ns) ns))
      (add (check_true "moved" (not (contains (targets (laid_keyed (ui_st_keeping (light) moved) false)) "kept@")))
           (check_true "another key" (not (contains (targets (laid_keyed (ui_st_keeping (light) (map_put (ui_kept_none) "other" (UiKept (keyed_rect) 0 ns))) false)) "kept@")))))))

; In the backdrop the page is laid out again, as its colors may change.
(def test_keyed_backdrop () int
  (check_true "laid out again" (not (contains (targets (laid_keyed (ui_st_keeping (ui_st_backdropped (light) true) (kept_fake (light) false)) false)) "kept@"))))

; A key may hold dots: it is found again whole.
(def test_keyed_dots () int
  (let ns (ui_layout (UiKeyed "a.b.c" (UiLabel "x" (UiBody) (UiStart))) (Rect 0 0 50 20) (light) 0)
    (check_true "a.b.c" (map_has (ui_kept_of ns) "a.b.c"))))
