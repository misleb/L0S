; w laid out as a window of 400 by 300.
(def laid ((w UiWidget)) (list UiNode) (ui_laid w 400 300))

; A page's title and line, then what is in it.
(def test_page_texts () int
  (check_str "in order" (ui_texts (laid (ui_page "Title" "A line" (cons (ui_value "x") (nil UiWidget))))) "Title|A line|x|"))

; An empty title or line is left out.
(def test_page_no_line () int
  (check_str "no line" (ui_texts (laid (ui_page "Title" "" (cons (ui_value "x") (nil UiWidget))))) "Title|x|"))

; Its first child is 18 down from the window's top, and centered across
; the 364 between its insets, as a column's children are: Go is 36
; wide, so at 18 + (364 - 36) / 2.
(def test_page_inset () int
  (check_str "the button"
             (ui_target_at (laid (ui_page "" "" (cons (UiButton "app.go" "" "Go" (UiBtnRegular) true) (nil UiWidget)))) "app.go")
             "182 18 36 34"))

; A heading row puts its buttons at its end: Refresh's right edge is the
; row's, the window's 400.
(def test_heading_row_end () int
  (match (ui_measure (UiButton "app.refresh" "" "Refresh" (UiBtnRegular) true))
    ((UiSize bw bh)
      (check_str "Refresh at the end"
                 (first_word (ui_target_at (laid (ui_heading_row "Disk" (cons (UiButton "app.refresh" "" "Refresh" (UiBtnRegular) true) (nil UiWidget))))
                                      "app.refresh"))
                 (digits (sub 400 bw))))))

; The first word of s.
(def first_word ((s (list int))) (list int) (head (split_spaces s)))

; A footer's line is at the window's foot, under the body.
(def test_with_footer () int
  (check_str "texts" (ui_texts (laid (ui_with_footer (ui_value "body") "3 items"))) "body|3 items|"))

; A toolbar page: its buttons, its line, then the body.
(def test_toolbar_page () int
  (let ns (laid (ui_toolbar_page (cons (UiButton "app.add" "" "Add" (UiBtnRegular) true) (nil UiWidget)) "Ready"
                                 (cons (UiButton "app.clear" "" "Clear" (UiBtnRegular) true) (nil UiWidget)) (ui_value "body")))
    (add (check_str "texts" (ui_texts ns) "Add|Ready|Clear|body|")
         (check_str "Add's place" (ui_target_at ns "app.add") (rect_of_add)))))

; Add, 6 in and 6 down, as wide as it measures.
(def rect_of_add () (list int)
  (match (ui_measure (UiButton "app.add" "" "Add" (UiBtnRegular) true))
    ((UiSize w h) (unwords (cons "6" (cons "6" (cons (digits w) (cons (digits h) (nil (list int))))))))))

; An entry for n characters is as entry.l0 makes one: the widest
; characters, its insets and cursor.
(def test_entry_w () int
  (check_int "24" (ui_entry_w 24) (add (ui_chars_w 24 (ui_text_font) false) (add (mul 2 (ui_entry_pad)) (ui_entry_cursor_w)))))

; A confirmation's buttons: Cancel, and the action.
(def test_confirm () int
  (let ns (laid (UiModal (ui_value "page") (ui_confirm "Delete?" (cons "Gone for good." (nil (list int))) "dialog.delete" "Delete" true)))
    (add (check_bool "cancel" (not (eq (ui_target_at ns (ui_cancel_action)) "none")) true)
         (add (check_bool "delete" (not (eq (ui_target_at ns "dialog.delete") "none")) true)
              (check_str "what it says" (ui_texts ns) "page|Delete?|Gone for good.|Cancel|Delete|")))))

; Toggles keyed by their labels, in order.
(def test_toggles () int
  (check_str "keys" (toggle_keys (ui_toggles (split_spaces "a b c"))) "abc"))

(def toggle_keys ((ts (list UiToggle))) (list int)
  (if (is_empty ts) "" (match (head ts) ((UiToggle k i l) (append k (toggle_keys (tail ts)))))))

(def three () (list UiTab) (cons (UiTab "1" "One") (cons (UiTab "2" "Two") (cons (UiTab "3" "Three") (nil UiTab)))))

(def tab_keys ((ts (list UiTab))) (list int)
  (if (is_empty ts) "" (append (ui_tab_key (head ts)) (tab_keys (tail ts)))))

; A tab taken out by its key; the others kept in order.
(def test_without () int
  (add (check_str "the middle" (tab_keys (ui_without ui_tab_key "2" (three))) "13")
       (check_str "none such" (tab_keys (ui_without ui_tab_key "9" (three))) "123")))

; After a tab closes, the next is selected, or the one before the last.
(def test_key_after () int
  (add (check_str "after the first" (ui_key_after ui_tab_key "1" (three) "") "2")
       (add (check_str "before the last" (ui_key_after ui_tab_key "3" (three) "") "2")
            (check_str "alone" (ui_key_after ui_tab_key "1" (cons (UiTab "1" "One") (nil UiTab)) "") ""))))
