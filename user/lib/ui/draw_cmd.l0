; draw_cmd.l0 -- the desktop's drawing commands, as the toolkit has them:
; render.l0's (parse_command), with the colors of Adwaita's palette by
; name, and the toolkit's own shapes. draw parses a command with
; ui_parse_draw before it sends it, so a mistake is told without asking
; the compositor; the compositor parses it again, and draws it.
;
;   round X Y W H R [COLOR]    a filled rectangle, its corners of radius R,
;                              their edges mixed with what is under them
;   button X Y KIND LABEL ...  a button as Adwaita draws one, at its
;                              natural size: KIND is regular, flat,
;                              suggested, or destructive
;   icon X Y NAME [SCALE [COLOR]]
;                              a symbolic icon of icons.l0, each of its
;                              pixels SCALE square, 1 to 4, 1 and white
;                              unless given

; A drawing command as the toolkit reads it: one of render.l0's, or one
; of its own, in the desktop's pixels, colors as 0xRRGGBB.
(data UiDraw
  (UiDrawBasic Command)
  (UiDrawRound int int int int int int)                 ; x, y, w, h, radius, color
  (UiDrawButton int int UiButtonKind (list int))        ; x, y, kind, label
  (UiDrawIcon int int (list int) int int))              ; x, y, name, scale, color

; A command refused, for why; and one read.
(def ui_draw_bad ((why (list int))) (Result UiDraw (list int)) ((Err UiDraw (list int)) why))
(def ui_draw_good ((d UiDraw)) (Result UiDraw (list int)) ((Ok UiDraw (list int)) d))

; The words with each of the palette's names as its RRGGBB.
(def ui_named_colors ((ws (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty ws)
      (rev acc)
      (ui_named_colors (tail ws)
        (cons (match (ui_color_named (head ws)) ((None) (head ws)) ((Some c) (hex_digits c 6))) acc))))

; One command's words as the command they name, or why not: the palette's
; names read as their colors first, then round, button and icon read
; here, and anything else by render.l0's parse_command.
(def ui_parse_draw ((words (list (list int)))) (Result UiDraw (list int))
  (let ws (ui_named_colors words (nil (list int)))
    (if (is_empty ws)
        (ui_draw_basic ws)
        (if (eq (head ws) "round")
            (ui_parse_round (tail ws))
            (if (eq (head ws) "button") (ui_parse_button (tail ws))
                (if (eq (head ws) "icon") (ui_parse_icon (tail ws)) (ui_draw_basic ws)))))))

; Words ws as one of render.l0's commands, by its parse_command.
(def ui_draw_basic ((ws (list (list int)))) (Result UiDraw (list int))
  (match (parse_command ws)
    ((Err why) (ui_draw_bad why))
    ((Ok cmd) (ui_draw_good (UiDrawBasic cmd)))))

; round X Y W H R [COLOR]: five numbers, R not negative, and a color,
; white unless given.
(def ui_parse_round ((rest (list (list int)))) (Result UiDraw (list int))
  (if (if (lt (length rest) 5) true (gt (length rest) 6))
      (ui_draw_bad "round takes 5 numbers and a color")
      (match (parse_ints rest 5 (nil int))
        ((None) (ui_draw_bad (numbers_out_of_range "round")))
        ((Some ns)
          (if (lt (nth ns 4) 0)
              (ui_draw_bad "round's radius must not be negative")
              (let cw (if (eq (length rest) 5) "white" (nth rest 5))
                (match (parse_color cw)
                  ((None) (ui_draw_bad (append "no color " cw)))
                  ((Some c) (ui_draw_good (UiDrawRound (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3) (nth ns 4) c))))))))))

; The kinds of button a button command may name.
(def ui_button_kinds () (list (list int)) (split_spaces "regular flat suggested destructive"))

; The kind of button the word w names; regular for any other word.
(def ui_kind_named ((w (list int))) UiButtonKind
  (if (eq w "flat") (UiBtnFlat)
  (if (eq w "suggested") (UiBtnSuggested)
  (if (eq w "destructive") (UiBtnDestructive)
  (UiBtnRegular)))))

; button X Y KIND LABEL ...: two numbers, one of ui_button_kinds, and the
; label, every word after the kind, joined by spaces.
(def ui_parse_button ((rest (list (list int)))) (Result UiDraw (list int))
  (if (lt (length rest) 4)
      (ui_draw_bad "button takes X Y KIND LABEL")
      (match (parse_ints rest 2 (nil int))
        ((None) (ui_draw_bad (numbers_out_of_range "button")))
        ((Some xy)
          (if (not (any_eq (nth rest 2) (ui_button_kinds)))
              (ui_draw_bad (append "no kind of button " (nth rest 2)))
              (ui_draw_good (UiDrawButton (nth xy 0) (nth xy 1) (ui_kind_named (nth rest 2)) (unwords (drop rest 3)))))))))

; icon X Y NAME [SCALE [COLOR]]: an icon there is, at a scale of 1 to 4.
(def ui_parse_icon ((rest (list (list int)))) (Result UiDraw (list int))
  (if (if (lt (length rest) 3) true (gt (length rest) 5))
      (ui_draw_bad "icon takes X Y NAME, a scale and a color")
      (match (parse_ints rest 2 (nil int))
        ((None) (ui_draw_bad (numbers_out_of_range "icon")))
        ((Some xy)
          (if (not (any_eq (nth rest 2) (ui_icon_names)))
              (ui_draw_bad (append "no icon " (nth rest 2)))
              (ui_parse_icon_look (nth xy 0) (nth xy 1) (nth rest 2) (drop rest 3)))))))

; The rest of an icon command at x, y named name: its scale, 1 to 4, and
; its color, from the words rest, 1 and white unless given.
(def ui_parse_icon_look ((x int) (y int) (name (list int)) (rest (list (list int)))) (Result UiDraw (list int))
  (let sw (if (is_empty rest) "1" (head rest))
    (let cw (if (if (is_empty rest) true (is_empty (tail rest))) "white" (head (tail rest)))
      (match (parse_int sw)
        ((None) (ui_draw_bad "icon's scale must be from 1 to 4"))
        ((Some sc)
          (if (if (lt sc 1) true (gt sc 4))
              (ui_draw_bad "icon's scale must be from 1 to 4")
              (match (parse_color cw)
                ((None) (ui_draw_bad (append "no color " cw)))
                ((Some c) (ui_draw_good (UiDrawIcon x y name sc c))))))))))

; What a toolkit command paints: the ops, every corner mixed with what is
; already there.
(def ui_draw_ops ((d UiDraw)) (list UiPaint)
  (match d
    ((UiDrawBasic cmd) (nil UiPaint))
    ((UiDrawRound x y w h r c) (cons (UiPRound (Rect x y w h) r c -1) (nil UiPaint)))
    ((UiDrawIcon x y name sc c) (cons (UiPIcon x y name c sc) (nil UiPaint)))
    ((UiDrawButton x y k label)
      (let s (ui_button_size "" label k)
        (let st (ui_state_new (ui_style))
          (ui_under_read (ui_nodes_ops (ui_layout (UiButton "draw" "" label k true) (Rect x y (ui_sw s) (ui_sh s))
                                                  st (ui_window_bg (ui_style)))
                                       (nil UiPaint))
                         (nil UiPaint)))))))

; The ops of every node of ns, in order, after acc.
(def ui_nodes_ops ((ns (list UiNode)) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty ns) acc (match (head ns) ((UiNode r ops a f) (ui_nodes_ops (tail ns) (append acc ops))))))

; ops with every round's corners mixed with the pixel already there (-1)
; rather than a color given, onto acc reversed; the rest as they are.
(def ui_under_read ((ops (list UiPaint)) (acc (list UiPaint))) (list UiPaint)
  (if (is_empty ops)
      (rev acc)
      (ui_under_read (tail ops)
        (cons (match (head ops)
                ((UiPRound r rad c u) (UiPRound r rad c -1))
                ((UiPFill r c) (head ops))
                ((UiPText r s a c f b sc) (head ops))
                ((UiPIcon x y n c sc) (head ops))
                ((UiPImage x y n d ts) (head ops)))
              acc))))

; A toolkit command done on c, where it is on it, at the face's scale.
(def ui_draw_exec ((c Canvas) (face UiFace) (d UiDraw)) Canvas
  (ui_paint c face (Rect 0 0 (canvas_w c) (canvas_h c)) (ui_draw_ops d)))

; ------------------------------------------------------ drawing at a scale

; render.l0's shapes, given in the desktop's pixels and drawn on a canvas
; of the screen's at scale s, as wm draws them on the desktop and mkicon
; in an icon: a filled shape covers s times as much each way, and a line
; or an outline is s pixels thick, so it looks as it does at 1.

; The rectangle r filled.
(def ui_draw_fill ((c Canvas) (r Rect) (color int) (s int)) Canvas
  (match (rect_scaled r s) ((Rect x y w h) (fill_rect c x y w h color))))

; A line from x0, y0 to x1, y1, both ends included, s thick.
(def ui_draw_line ((c Canvas) (x0 int) (y0 int) (x1 int) (y1 int) (color int) (s int)) Canvas
  (ui_draw_dots c (line_points (mul x0 s) (mul y0 s) (mul x1 s) (mul y1 s)) color s))

; A circle's outline around cx, cy of radius r, s thick.
(def ui_draw_circle ((c Canvas) (cx int) (cy int) (r int) (color int) (s int)) Canvas
  (ui_draw_dots c (circle_points (mul cx s) (mul cy s) (mul r s)) color s))

; Each of ps a dot s by s, as much of it as is on the canvas.
(def ui_draw_dots ((c Canvas) (ps (list Point)) (color int) (s int)) Canvas
  (if (eq s 1)
      (plot_all c ps color)
      (if (is_empty ps)
          c
          (match (head ps)
            ((Point x y)
              (ui_draw_dots (match (rect_clip (Rect x y s s) (Rect 0 0 (canvas_w c) (canvas_h c)))
                              ((Rect dx dy dw dh) (if (rect_empty (Rect dx dy dw dh)) c (fill_rect c dx dy dw dh color))))
                            (tail ps) color s))))))

; A filled circle around cx, cy of radius r.
(def ui_draw_disc ((c Canvas) (cx int) (cy int) (r int) (color int) (s int)) Canvas
  (disc c (mul cx s) (mul cy s) (mul r s) color (neg (mul r s))))

; An outline s thick: s outlines, each a pixel inside the one before.
(def ui_draw_outline ((c Canvas) (x int) (y int) (w int) (h int) (color int) (s int)) Canvas
  (ui_draw_outlines c (mul x s) (mul y s) (mul w s) (mul h s) color s 0))

; ui_draw_outline's rings, in the screen's pixels: the i-th and those
; inside it, up to s of them, stopping early once one would be empty.
(def ui_draw_outlines ((c Canvas) (x int) (y int) (w int) (h int) (color int) (s int) (i int)) Canvas
  (if (if (ge i s) true (if (le w (mul 2 i)) true (le h (mul 2 i))))
      c
      (ui_draw_outlines (outline c (add x i) (add y i) (sub w (mul 2 i)) (sub h (mul 2 i)) color) x y w h color s (add i 1))))

; Characters from x, y, one cell each, each cell filled with bg first
; unless bg is negative, drawn from the face's glyphs, smooth: Source
; Code Pro, as draw's char is a cell.
(def ui_draw_text ((c Canvas) (face UiFace) (x int) (y int) (fg int) (bg int) (cs (list int))) Canvas
  (let r (Rect x y (mul (length cs) (glyph_w)) (glyph_h))
    (ui_paint c face r
      (append (if (ge bg 0) (cons (UiPFill r bg) (nil UiPaint)) (nil UiPaint))
              (cons (UiPText r cs (UiStart) fg (UiMono) false 1) (nil UiPaint))))))
