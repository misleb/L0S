; face.l0 -- what the toolkit draws text, icons and the pointer from, at
; the desktop's scale. Icons, at every scale, are GNOME's SVGs as
; tools/mkicons rasterized them, /etc/icons: how much of each pixel an
; icon covers, 0 to 15, which painting mixes the color with what is
; under it by. The pointer at scale 2 is what tools/mkfont rasterized
; from fonts/cursors.paths, /etc/face. Both files are written alike:
;
;   "L0SF", a u32 version (1), a u32 count of tables, then each table:
;   a u32 name length, the name, u32 width, height, and word count, and
;   that many u64 words, all least significant byte first.
;
; A table named icon.NAME.N is an icon N by N; each row is as many words
; as its 16s, each word 16 levels, the leftmost pixel in the highest four
; bits. The one named cursor is the pointer, 64 by 64, a word a pixel,
; its alpha, red, green and blue.
;
; Text is the font service's (user/sbin/font): Source Code Pro and Source
; Sans 3, regular and bold, at the heights the scale paints, each a
; strike (format/strike.l0) in pages font shares with every program that
; asks, read in place, never copied. Its glyphs are kept by the names
; glyph.FACE.H, FACE the font service's name for the face: code,
; code-bold, sans or sans-bold.

; A table: its width, height and words.
(data UiCov (UiCov int int (array int)))

; A strike, one face at one line height, read in place: over the pages
; the font service shared, the region over its arena, where the arena is
; in this process, and the strike's offset in it, every strike of one
; arena read through the same region; or, as a host tool or a test has
; one, bytes; or asked of font, at clock_ns T, its answer to come to the
; loop as a reply (ui_face_asking), drawn as none until then.
(data UiStrike (UiStrikeIn IoDevice int int) (UiStrikeBytes bytes) (UiStrikeAsked int))

; A face: its scale, its tables by name, its icons' and the pointers',
; and its strikes by name, its glyphs'.
(data UiFace (UiFace int (Map (list int) UiCov) (Map (list int) UiStrike)))

; Where the face is, as mkfont wrote it, and the icons, as mkicons did.
(def ui_face_path () (list int) "/etc/face")
(def ui_icons_path () (list int) "/etc/icons")

; No strikes: a face that draws no text.
(def ui_strikes_none () (Map (list int) UiStrike) ((MapEmpty (list int) UiStrike)))

; A face of no tables, at scale 1: nothing is drawn with it, which is what
; a host test that draws no text wants.
(def ui_face_none () UiFace (UiFace 1 ((MapEmpty (list int) UiCov)) (ui_strikes_none)))

; The face at scale s: its icons, if /etc/icons can be read, at the
; sizes that scale paints, and its text's strikes, asked of font. With no
; icons, none is drawn; with no font, no text. Each missing is said once,
; on standard error.
(def ui_face_load ((s int)) UiFace
  (let icons (ui_face_file_tables (ui_icons_path) "no icons drawn" (ui_icon_sizes s) ((MapEmpty (list int) UiCov)))
    (UiFace s icons (ui_face_strikes s))))

; Face f with the pointers of /etc/face, which only the compositor
; draws, and only at scale 2, its 1x art at 1 (paint.l0's
; ui_paint_named_cursor); at scale 1, f as it is. With no face, the 1x
; art is drawn at 2 too, as is said on standard error.
(def ui_face_pointers ((f UiFace)) UiFace
  (match f
    ((UiFace s ts ks)
      (if (lt s 2) f (UiFace s (ui_face_file_tables (ui_face_path) "the 1x pointers drawn" (nil int) ts) ks)))))

; Whether the face can draw text: it has the interface's regular glyphs,
; 16 tall at scale 1.
(def ui_face_has_text ((f UiFace)) bool
  (match (ui_face_strike f (ui_glyph_table (ui_font_face (ui_text_font) false) (mul (ui_char_h) (ui_face_scale f))))
    ((Some g) true)
    ((None) false)))

; The strike called name, if the face has it.
(def ui_face_strike ((f UiFace) (name (list int))) (Option UiStrike)
  (match f ((UiFace s ts ks) (map_get ks name))))

; ------------------------------------------------------------- strikes

; How long a program waits for font to register: long enough for it to
; make the strikes it makes before it does, on a slow board.
(def ui_font_wait_ns () int 20000000000)

; The strikes text is drawn from at scale s, asked of font: both faces'
; regular and bold at the heights ui_text_names gives; none, and
; why said once, if font is not there, and any it will not give left out,
; the first's why said.
(def ui_face_strikes ((s int)) (Map (list int) UiStrike)
  (match (font_open (ui_font_wait_ns))
    ((NoFontPort why) (ui_no_text why (ui_strikes_none)))
    ((FontPort port rp) (ui_strikes_asked (FontPort port rp) (ui_text_names s) false (ui_strikes_none)))))

; The strikes' names at scale s: each face, regular and bold, 16 and 32
; times s, the text sizes 1 and 2 a widget asks for.
(def ui_text_names ((s int)) (list (list int))
  (ui_text_names_of (split_spaces "code code-bold sans sans-bold") s (nil (list int))))

; ui_text_names' loop: each of faces at 16 and 32 times s, onto acc, in
; order.
(def ui_text_names_of ((faces (list (list int))) (s int) (acc (list (list int)))) (list (list int))
  (if (is_empty faces)
      (rev acc)
      (ui_text_names_of (tail faces) s
        (cons (ui_glyph_table (head faces) (mul 32 s)) (cons (ui_glyph_table (head faces) (mul 16 s)) acc)))))

; The face and height a strike's name says: glyph.code-bold.32 is
; code-bold at 32; a name of no height, 0.
(def ui_strike_face ((name (list int))) (list int)
  (up_to 46 (drop_n name 6)))
(def ui_strike_h ((name (list int))) int
  (match (word_number (last (split_on 46 name)))
    ((Some h) h)
    ((None) 0)))

; ui_face_strikes' loop: each of names asked of fp and opened where it
; is, into m; said, whether a failure has been said.
(def ui_strikes_asked ((fp FontPort) (names (list (list int))) (said bool) (m (Map (list int) UiStrike))) (Map (list int) UiStrike)
  (if (is_empty names)
      m
      (match (ui_strike_open m (font_strike fp (ui_strike_face (head names)) (ui_strike_h (head names))))
        ((Err why) (ui_strikes_asked fp (tail names) true (if said m (ui_no_text why m))))
        ((Ok k) (ui_strikes_asked fp (tail names) said (map_put m (head names) k))))))

; A strike font gave, to read in place: through the region one of ks
; already reads its arena through, or one opened over the arena; or why
; not.
(def ui_strike_open ((ks (Map (list int) UiStrike)) (s FontStrike)) (Result UiStrike (list int))
  (match s
    ((NoFontStrike why) ((Err UiStrike (list int)) why))
    ((FontStrike va n off m)
      (match (ui_arena_region (map_values ks) va)
        ((Some r) ((Ok UiStrike (list int)) (UiStrikeIn r va off)))
        ((None)
          (match (dma_open va n)
            ((DeviceFailed fault why) ((Err UiStrike (list int)) why))
            ((DeviceOpened r) ((Ok UiStrike (list int)) (UiStrikeIn r va off)))))))))

; The region of the first of ks read through the arena at va, if one is.
(def ui_arena_region ((ks (list UiStrike)) (va int)) (Option IoDevice)
  (if (is_empty ks)
      ((None IoDevice))
      (match (head ks)
        ((UiStrikeIn r at off) (if (eq at va) (Some r) (ui_arena_region (tail ks) va)))
        ((UiStrikeBytes b) (ui_arena_region (tail ks) va))
        ((UiStrikeAsked t) (ui_arena_region (tail ks) va)))))

; How many regions ks are read through: one an arena.
(def ui_strike_regions ((ks (list UiStrike)) (seen (list int))) int
  (if (is_empty ks)
      (length seen)
      (match (head ks)
        ((UiStrikeIn r va off) (ui_strike_regions (tail ks) (if (any_eq va seen) seen (cons va seen))))
        ((UiStrikeBytes b) (ui_strike_regions (tail ks) seen))
        ((UiStrikeAsked t) (ui_strike_regions (tail ks) seen)))))

; m, with why there is no text, or not all of it, said on standard error.
(def ui_no_text ((why (list int)) (m (Map (list int) UiStrike))) (Map (list int) UiStrike)
  (let w (write_err (append "font: " (append why "; no text drawn\n"))) m))

; Whether a strike can be read: one over pages font shared is; one held
; as bytes only if it holds a strike's header and entries, as one a
; window could not get, kept so that it is not asked for again, does
; not.
(def ui_strike_whole ((k UiStrike)) bool
  (match k
    ((UiStrikeIn r va off) true)
    ((UiStrikeBytes b) (strike_ok b))
    ((UiStrikeAsked t) false)))

; The face f with the strikes names asked of font, none waited for: each
; request sent with its answer to rport, the loop's port for the
; toolkit's replies (uiloop.l0), and the strike kept as asked, so it is
; not asked again, and drawn as none until its answer comes
; (ui_face_answered). With no font, or no rport, each is kept as none.
(def ui_face_asking ((f UiFace) (names (list (list int))) (rport int)) UiFace
  (if (is_empty names)
      f
      (match f
        ((UiFace s ts ks)
          (if (le rport 0)
              (UiFace s ts (ui_strikes_none_of names ks))
              (match (name_wait "font" 0)
                ((NotFound) (UiFace s ts (ui_strikes_none_of names ks)))
                ((Found port) (UiFace s ts (ui_strikes_sent port rport names ks)))))))))

; Each of names asked of font, on port, its answer to rport, and kept in
; ks as asked; one whose request is refused, as none.
(def ui_strikes_sent ((port int) (rport int) (names (list (list int))) (ks (Map (list int) UiStrike))) (Map (list int) UiStrike)
  (if (is_empty names)
      ks
      (let n (head names)
        (match (port_send port (request rport (font_strike_request (ui_strike_face n) (ui_strike_h n))))
          ((Sent) (ui_strikes_sent port rport (tail names) (map_put ks n (UiStrikeAsked (clock_ns)))))
          ((SendNoPort) (ui_strikes_sent port rport (tail names) (map_put ks n (UiStrikeBytes (bytes_from_list "")))))
          ((SendFull) (ui_strikes_sent port rport (tail names) (map_put ks n (UiStrikeBytes (bytes_from_list "")))))
          ((SendTooBig) (ui_strikes_sent port rport (tail names) (map_put ks n (UiStrikeBytes (bytes_from_list "")))))))))

; The strike f asked of font first of those it is still waiting for, by
; name, "" if none: what an answer that names no strike is taken to be
; for.
(def ui_face_oldest_ask ((f UiFace)) (list int)
  (match f ((UiFace s ts ks) (ui_oldest_ask (map_keys ks) ks "" -1))))

; ui_face_oldest_ask's loop over names: best, asked at at, so far.
(def ui_oldest_ask ((names (list (list int))) (ks (Map (list int) UiStrike)) (best (list int)) (at int)) (list int)
  (if (is_empty names)
      best
      (match (map_get ks (head names))
        ((Some k)
          (match k
            ((UiStrikeAsked t) (if (if (lt at 0) true (lt t at)) (ui_oldest_ask (tail names) ks (head names) t) (ui_oldest_ask (tail names) ks best at)))
            ((UiStrikeIn r va off) (ui_oldest_ask (tail names) ks best at))
            ((UiStrikeBytes b) (ui_oldest_ask (tail names) ks best at))))
        ((None) (ui_oldest_ask (tail names) ks best at)))))

; A face after an answer from font, and the strike's name the answer
; was to, "" for none.
(data UiAnswered (UiAnswered UiFace (list int)))

; f with font's answer, payload, to the strike it names, FACE H, if f
; asked for that one, or else to the oldest it asked for: opened to read
; in place, or kept as none if font would not give it or it cannot be
; opened, so its text is not drawn; and that strike's name, "" if f
; asked for none. font answers a strike once it is made, not in the
; order asked, so the name is what tells the answers apart.
(def ui_face_answered ((f UiFace) (payload (list int))) UiAnswered
  (let name (ui_answer_name f payload)
    (if (is_empty name)
        (UiAnswered f "")
        (match f
          ((UiFace s ts ks)
            (match (ui_strike_open ks (font_strike_of payload))
              ((Err why) (UiAnswered (UiFace s ts (map_put ks name (UiStrikeBytes (bytes_from_list "")))) name))
              ((Ok k) (UiAnswered (UiFace s ts (map_put ks name k)) name))))))))

; The name of the strike f asked for that answer payload is to: the one
; it names, if f is waiting for it; else the oldest asked.
(def ui_answer_name ((f UiFace) (payload (list int))) (list int)
  (let key (font_reply_key payload)
    (let named (if (is_empty key) "" (ui_glyph_table (up_to 32 key) (ui_strike_h_of key)))
      (match (ui_face_strike f named)
        ((Some k) (match k ((UiStrikeAsked t) named) ((UiStrikeIn r va off) (ui_face_oldest_ask f)) ((UiStrikeBytes b) (ui_face_oldest_ask f))))
        ((None) (ui_face_oldest_ask f))))))

; The height a key FACE H names, 0 for none.
(def ui_strike_h_of ((key (list int))) int
  (match (word_number (last (split_spaces key))) ((Some h) h) ((None) 0)))

; ks with each of names kept as no strike.
(def ui_strikes_none_of ((names (list (list int))) (ks (Map (list int) UiStrike))) (Map (list int) UiStrike)
  (if (is_empty names) ks (ui_strikes_none_of (tail names) (map_put ks (head names) (UiStrikeBytes (bytes_from_list ""))))))

; A strike's u32 and u64 at off.
(def ui_strike_u32 ((k UiStrike) (off int)) int
  (match k
    ((UiStrikeIn r va at) (device_read32 r (add at off)))
    ((UiStrikeBytes b) (le_u32 b off))
    ((UiStrikeAsked t) 0)))
(def ui_strike_u64 ((k UiStrike) (off int)) int
  (match k
    ((UiStrikeIn r va at) (device_read64 r (add at off)))
    ((UiStrikeBytes b) (le_u64_at b off))
    ((UiStrikeAsked t) 0)))

; The sizes icons are painted at, at scale s: 16 · k · s for the scales
; k 1 to 4 a widget asks for.
(def ui_icon_sizes ((s int)) (list int)
  (cons (mul 16 s) (cons (mul 32 s) (cons (mul 48 s) (cons (mul 64 s) (nil int))))))

; The tables of the file at path put into m, those of icons only at the
; sizes given (all, for none); m alone, and why said, if it cannot be
; read.
(def ui_face_file_tables ((path (list int)) (then (list int)) (sizes (list int)) (m (Map (list int) UiCov))) (Map (list int) UiCov)
  (match (read_whole path)
    ((Err why) (let w (write_err (append path (append ": " (append why (append "; " (append then "\n")))))) m))
    ((Ok b) (ui_face_kept b sizes m))))

; Its scale.
(def ui_face_scale ((f UiFace)) int (match f ((UiFace s ts ks) s)))

; The table called name, if the face has it.
(def ui_face_table ((f UiFace) (name (list int))) (Option UiCov)
  (match f ((UiFace s ts ks) (map_get ts name))))

; ----------------------------------------------------------- the tables

; The level of pixel x, y of a table of coverage, 0 to 15.
(def ui_cov_level ((c UiCov) (x int) (y int)) int
  (match c
    ((UiCov w h words)
      (let word (array_get words (add (mul y (ui_cov_wpr w)) (div x 16)))
        (bit_and (bit_shr word (mul 4 (sub 15 (mod x 16)))) 15)))))

; The words a row w wide takes.
(def ui_cov_wpr ((w int)) int (div (add w 15) 16))

; The name of the strike of face's glyphs h tall, face the font
; service's name for it (paint.l0's ui_font_face).
(def ui_glyph_table ((face (list int)) (h int)) (list int)
  (append "glyph." (append face (append "." (digits h)))))

; The name of the table of icon name, n by n.
(def ui_icon_table ((name (list int)) (n int)) (list int)
  (append "icon." (append name (append "." (digits n)))))

; The name of an app's image n by n, in its bundle's icon.face: a word a
; pixel, its alpha, red, green and blue, as the pointer's.
(def ui_image_table ((n int)) (list int) (append "image." (digits n)))

; ------------------------------------------------------------- images

; The sizes mkicon draws an image at, an app's icon.face or a full-color
; icon's: a list's 16, a sidebar's 32 and a tile's 48, at scales 1 and
; 2.
(def ui_image_sizes () (list int) (cons 16 (cons 32 (cons 48 (cons 64 (cons 96 (nil int)))))))

; The sizes of an image painted at scale s: a list's, a sidebar's and a
; tile's, 16, 32 and 48 times s.
(def ui_image_sizes_at ((s int)) (list int) (cons (mul 16 s) (cons (mul 32 s) (cons (mul 48 s) (nil int)))))

; An image file's tables, image.N, of those of sizes there are, in
; their order, as UiPImage takes them; none if it is not a face file.
(def ui_images_of ((b bytes) (sizes (list int))) (list UiCov)
  (ui_images_sized (ui_face_tables b) sizes))

; The tables of m's images of sizes there are, in order.
(def ui_images_sized ((m (Map (list int) UiCov)) (sizes (list int))) (list UiCov)
  (if (is_empty sizes)
      (nil UiCov)
      (match (map_get m (ui_image_table (head sizes)))
        ((Some c) (cons c (ui_images_sized m (tail sizes))))
        ((None) (ui_images_sized m (tail sizes))))))

; Full-color icons a program has loaded (icons.l0's ui_image_names), by
; name: each one's images, as an app's icon.face holds its own.
(data UiImages (UiImages (Map (list int) (list UiCov))))

; None loaded: every icon falls back to its symbolic one.
(def ui_images_none () UiImages (UiImages ((MapEmpty (list int) (list UiCov)))))

; Where full-color icon name is, as mkicon drew it.
(def ui_image_path ((name (list int))) (list int) (append "/etc/images/" (append name ".face")))

; The full-color icons names, each read from /etc/images, only at the
; sizes scale s paints, as a whole file's would take a program's heap
; for nothing; one that cannot be read is left out, and said on
; standard error once.
(def ui_images_load ((names (list (list int))) (s int)) UiImages
  (ui_images_loading names (ui_image_sizes_at s) (ui_images_none)))

; ui_images_load's loop: each of names read into im.
(def ui_images_loading ((names (list (list int))) (sizes (list int)) (im UiImages)) UiImages
  (if (is_empty names)
      im
      (match (read_whole (ui_image_path (head names)))
        ((Err why)
          (let w (write_err (append (ui_image_path (head names)) (append ": " (append why "; its symbolic icon drawn\n"))))
            (ui_images_loading (tail names) sizes im)))
        ((Ok b) (ui_images_loading (tail names) sizes (ui_images_with im (head names) (ui_images_of b sizes)))))))

; im with name's images ts; with none, im.
(def ui_images_with ((im UiImages) (name (list int)) (ts (list UiCov))) UiImages
  (if (is_empty ts) im (match im ((UiImages m) (UiImages (map_put m name ts))))))

; The images of icon name, none if it was not loaded.
(def ui_image ((im UiImages) (name (list int))) (list UiCov)
  (match im ((UiImages m) (match (map_get m name) ((Some ts) ts) ((None) (nil UiCov))))))

; ------------------------------------------------------------- the file

; The tables a face file holds; none if it is not one.
(def ui_face_tables ((b bytes)) (Map (list int) UiCov)
  (ui_face_kept b (nil int) ((MapEmpty (list int) UiCov))))

; The tables a face file holds put into m, those of icons only at the
; sizes given, or all for none.
(def ui_face_kept ((b bytes) (sizes (list int)) (m (Map (list int) UiCov))) (Map (list int) UiCov)
  (if (if (has b 0 12) (bytes_is_at b 0 "L0SF") false)
      (ui_face_read b 12 (le_u32 b 8) sizes m)
      m))

; Whether a table is kept: any but an icon's, and an icon's if it is one
; of the sizes, or there are none.
(def ui_face_keeps ((name (list int)) (w int) (sizes (list int))) bool
  (if (if (is_empty sizes) true (not (starts_with name "icon."))) true (any_eq w sizes)))

; ui_face_kept's loop: the n tables left from byte at, each kept put in
; m by its name; it stops, keeping those before, at one the bytes cut
; short.
(def ui_face_read ((b bytes) (at int) (n int) (sizes (list int)) (m (Map (list int) UiCov))) (Map (list int) UiCov)
  (if (if (le n 0) true (not (has b at 4)))
      m
      (let nl (le_u32 b at)
        (if (not (has b (add at 4) (add nl 12)))
            m
            (let name (bytes_range b (add at 4) (add (add at 4) nl))
              (let p (add (add at 4) nl)
                (let k (le_u32 b (add p 8))
                  (if (not (has b (add p 12) (mul k 8)))
                      m
                      (ui_face_read b (add (add p 12) (mul k 8)) (sub n 1) sizes
                        (if (ui_face_keeps name (le_u32 b p) sizes)
                            (map_put m name (UiCov (le_u32 b p) (le_u32 b (add p 4)) (ui_face_words b (add p 12) 0 k (array_new k 0))))
                            m))))))))))

; Words i up to k of a table, read from b at at, 8 bytes each, least
; significant first, into out.
(def ui_face_words ((b bytes) (at int) (i int) (k int) (out (array int))) (array int)
  (if (ge i k)
      out
      (ui_face_words b at (add i 1) k (array_set out i (le_u64_at b (add at (mul i 8)))))))

; A face file of tables, named, as bytes: what mkfont writes.
(data UiNamedCov (UiNamedCov (list int) UiCov))

; The face file holding tables ts, in order, as the header describes it.
(def ui_face_file ((ts (list UiNamedCov))) bytes
  (bytes_from_list (rev (ui_face_onto ts (push (u32_le (length ts)) (push (u32_le 1) (push "L0SF" (nil int))))))))

; ui_face_file's tables: each one's name length, name, width, height,
; word count and words, onto the bytes acc, reversed.
(def ui_face_onto ((ts (list UiNamedCov)) (acc (list int))) (list int)
  (if (is_empty ts)
      acc
      (match (head ts)
        ((UiNamedCov name c)
          (match c
            ((UiCov w h words)
              (ui_face_onto (tail ts)
                (ui_words_onto words 0 (push (u32_le (array_len words)) (push (u32_le h) (push (u32_le w)
                  (push name (push (u32_le (length name)) acc)))))))))))))

; Words i on, 8 bytes each, least significant first, onto acc, reversed.
(def ui_words_onto ((words (array int)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len words))
      acc
      (ui_words_onto words (add i 1) (push (le64 (array_get words i)) acc))))
