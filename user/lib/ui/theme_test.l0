(def test_ui_hex () int
  (add (check_int "blue_3" (ui_hex "3584e4") 3507428)
       (add (check_int "upper case" (ui_hex "FFFFFF") 16777215)
            (check_int "not hex" (ui_hex "zz0000") 0))))

(def test_ui_channels () int
  (add (check_int "red" (rgb_red (ui_hex "3584e4")) 53)
       (add (check_int "green" (rgb_green (ui_hex "3584e4")) 132)
            (check_int "blue" (rgb_blue (ui_hex "3584e4")) 228))))

(def test_ui_mix () int
  (add (check_int "all of a" (ui_mix (ui_hex "ff0000") (ui_hex "0000ff") 100) (ui_hex "ff0000"))
       (add (check_int "none of a" (ui_mix (ui_hex "ff0000") (ui_hex "0000ff") 0) (ui_hex "0000ff"))
            (check_int "half, rounded" (ui_mix (ui_hex "ffffff") (ui_hex "000000") 50) (ui_hex "808080")))))

; Adwaita's text, 80% black on fafafa.
(def test_ui_fg () int
  (add (check_str "light" (hex_digits (ui_fg (UiLight)) 6) "323232")
       (check_str "dark" (hex_digits (ui_fg (UiDark)) 6) "ffffff")))

(def test_ui_color_named () int
  (add (check_bool "blue_3" (eq (ui_color_named "blue_3") (Some (ui_hex "3584e4"))) true)
       (add (check_bool "dark_5" (eq (ui_color_named "dark_5") (Some 0)) true)
            (check_bool "none" (eq (ui_color_named "blue_9") ((None int))) true))))

(def test_ui_palette_names () int
  (add (check_int "nine hues of five, and five more" (length (ui_palette_names)) 50)
       (check_str "the first" (head (ui_palette_names)) "blue_1")))

(def test_ui_headerbar () int
  (add (check_str "in front" (hex_digits (ui_headerbar_bg (UiLight) true) 6) "ebebeb")
       (check_str "backdrop" (hex_digits (ui_headerbar_bg (UiLight) false) 6) "fafafa")))

; The text, 323232, at 40% on white is 50 * 0.4 + 255 * 0.6 = 173, ad;
; at 60%, 50 * 0.6 + 255 * 0.4 = 132, 84.
(def test_ui_slider_fg () int
  (add (check_str "at rest" (hex_digits (ui_slider_fg (UiLight) (ui_hex "ffffff") false) 6) "adadad")
       (check_str "under the pointer" (hex_digits (ui_slider_fg (UiLight) (ui_hex "ffffff") true) 6) "848484")))

(def test_ui_scrollbar_sizes () int
  (add (check_int "the slider fits its strip, wide, in from the edge" (add (ui_slider_wide) (ui_slider_margin)) 11)
       (add (check_bool "narrower than the strip" (lt (add (ui_slider_wide) (ui_slider_margin)) (ui_scrollbar_hit_w)) true)
            (check_int "three rows a step" (ui_wheel_rows) 3))))

; A window's inside edge is no deeper than a scrollbar's slider is in
; from it, and its corners reach past its header bar's rounded ones.
(def test_ui_csd_edge () int
  (add (check_bool "clear of the slider" (le (ui_csd_edge) (ui_slider_margin)) true)
       (check_bool "past the window's corner" (gt (ui_csd_corner) (ui_window_radius)) true)))

; The text, 323232, at 10% on ebebed: 50 * 0.1 + 235 * 0.9 = 216.5, d9,
; and 50 * 0.1 + 237 * 0.9 = 218.3, da.
(def test_ui_sidebar () int
  (add (check_str "the ground" (hex_digits (ui_sidebar_bg (UiLight)) 6) "ebebed")
       (check_str "a selected row" (hex_digits (ui_sidebar_selected_bg (UiLight)) 6) "d9d9da")))

; White under a dialog: 255 * 0.7 = 178.5, b3.
(def test_ui_scrim () int
  (add (check_str "white" (hex_digits (ui_scrim (ui_hex "ffffff")) 6) "b3b3b3")
       (check_str "black stays" (hex_digits (ui_scrim 0) 6) "000000")))

(def test_ui_disk_sizes () int
  (add (check_bool "a sidebar row holds a 32-pixel icon, 8 above and below" (eq (ui_side_row_h) (add 32 16)) true)
       (add (check_bool "a part's title and line fit a bar" (ge (ui_segbar_h) (add (mul 2 (ui_char_h)) (ui_space_m))) true)
            (add (check_bool "the narrowest volume shows a few letters" (ge (ui_segment_min_w) (mul 4 (ui_char_w))) true)
                 (check_int "a dialog's corners are a window's" (ui_dialog_radius) (ui_window_radius))))))

(def test_ui_selected () int
  (check_str "a quarter accent on white" (hex_digits (ui_selected_bg (ui_hex "ffffff")) 6) "cde0f8"))

; The text, 323232, at 10%: on a dialog's white, 50 * 0.1 + 255 * 0.9 =
; 234.5, eb; on the window's fafafa, 5 + 225 = 230, e6.
(def test_ui_entry_bg () int
  (add (check_str "on a card" (hex_digits (ui_entry_bg (UiLight) (ui_hex "ffffff")) 6) "ebebeb")
       (check_str "on the window" (hex_digits (ui_entry_bg (UiLight) (ui_window_bg (UiLight))) 6) "e6e6e6")))

(def test_ui_entry_sizes () int
  (add (check_bool "a line of text fits, padded, a button high" (ge (ui_button_h) (add (ui_char_h) (mul 2 (ui_entry_pad)))) true)
       (check_bool "the cursor is narrower than a character" (lt (ui_entry_cursor_w) (ui_char_w)) true)))

; White at a quarter on black: 255 * 0.25 = 63.75, 40.
(def test_ui_launcher_colors () int
  (add (check_str "the ground" (hex_digits (ui_launcher_bg) 6) "242424")
       (add (check_str "the open button" (hex_digits (ui_bar_active_bg) 6) "404040")
            (check_str "an icon of none" (hex_digits (ui_app_icon_plain) 6) "5e5c64"))))

(def test_ui_app_sizes () int
  (add (check_bool "an icon fits its cell, a name under it" (ge (ui_app_cell_h) (add (ui_app_icon) (add (ui_char_h) (ui_space_m)))) true)
       (check_bool "a name of 16 letters fits a cell" (ge (ui_app_cell_w) (mul 16 (ui_char_w))) true)))

(def test_ui_double_click () int
  (check_int "GTK's 400 ms" (ui_double_ns) 400000000))

; A tile holds its icon 12 down, 6 under it a line of text, and room
; under that: 12 + 48 + 6 + 16 = 82, of 96; and a name of 12 letters.
(def test_ui_tile_sizes () int
  (add (check_bool "an icon and a name fit a tile" (ge (ui_tile_h) (add (ui_space_m) (add (ui_tile_icon) (add (ui_space_s) (ui_char_h))))) true)
       (check_bool "a name of 12 letters fits, 8 in either side" (ge (ui_tile_w) (add (mul 12 (ui_char_w)) 16)) true)))

(def test_ui_menu_sizes () int
  (add (check_bool "a menu is wider than a button" (gt (ui_menu_min_w) (ui_button_h)) true)
       (check_bool "a toggle's inset is less than half a button" (lt (mul 2 (ui_toggle_inset)) (ui_button_h)) true)))

; A tab, 3 from the bar's top and foot, is 34, a button's height; its
; close button fits in it with room around.
(def test_ui_tab_sizes () int
  (add (check_int "a tab is a button high" (sub (ui_tabbar_h) (mul 2 (ui_tab_gap))) (ui_button_h))
       (check_bool "its close button fits" (lt (add (ui_titlebutton) (ui_tab_close_in)) (ui_button_h)) true)))

; On the dark header bar, 303030: the selected tab white at 10%,
; (255 * 10 + 48 * 90 + 50) / 100 = 69, 454545.
(def test_ui_tab_bg_dark () int
  (check_str "selected" (hex_digits (ui_tab_bg (UiDark) (ui_hex "303030") true false) 6) "454545"))
