(def test_ui_hex () int
  (add (check_int "blue_3" (ui_hex "3584e4") 3507428)
       (add (check_int "upper case" (ui_hex "FFFFFF") 16777215)
            (check_int "not hex" (ui_hex "zz0000") 0))))

(def test_ui_channels () int
  (add (check_int "red" (ui_red_of (ui_hex "3584e4")) 53)
       (add (check_int "green" (ui_green_of (ui_hex "3584e4")) 132)
            (check_int "blue" (ui_blue_of (ui_hex "3584e4")) 228))))

(def test_ui_mix () int
  (add (check_int "all of a" (ui_mix (ui_hex "ff0000") (ui_hex "0000ff") 100) (ui_hex "ff0000"))
       (add (check_int "none of a" (ui_mix (ui_hex "ff0000") (ui_hex "0000ff") 0) (ui_hex "0000ff"))
            (check_int "half, rounded" (ui_mix (ui_hex "ffffff") (ui_hex "000000") 50) (ui_hex "808080")))))

; Adwaita's text, 80% black on fafafa.
(def test_ui_fg () int
  (add (check_str "light" (hex_digits (ui_fg (UiLight)) 6) "323232")
       (check_str "dark" (hex_digits (ui_fg (UiDark)) 6) "ffffff")))

(def test_ui_color_named () int
  (add (check_bool "blue_3" (eq (ui_color_named "blue_3") (Some (ui_hex "3584e4"))) true)
       (add (check_bool "dark_5" (eq (ui_color_named "dark_5") (Some 0)) true)
            (check_bool "none" (eq (ui_color_named "blue_9") ((None int))) true))))

(def test_ui_palette_names () int
  (add (check_int "nine hues of five, and five more" (length (ui_palette_names)) 50)
       (check_str "the first" (head (ui_palette_names)) "blue_1")))

(def test_ui_headerbar () int
  (add (check_str "in front" (hex_digits (ui_headerbar_bg (UiLight) true) 6) "ebebeb")
       (check_str "backdrop" (hex_digits (ui_headerbar_bg (UiLight) false) 6) "fafafa")))

; The text, 323232, at 40% on white is 50 * 0.4 + 255 * 0.6 = 173, ad;
; at 60%, 50 * 0.6 + 255 * 0.4 = 132, 84.
(def test_ui_slider_fg () int
  (add (check_str "at rest" (hex_digits (ui_slider_fg (UiLight) (ui_hex "ffffff") false) 6) "adadad")
       (check_str "under the pointer" (hex_digits (ui_slider_fg (UiLight) (ui_hex "ffffff") true) 6) "848484")))

(def test_ui_scrollbar_sizes () int
  (add (check_int "the slider fits its strip, wide, in from the edge" (add (ui_slider_wide) (ui_slider_margin)) 11)
       (add (check_bool "narrower than the strip" (lt (add (ui_slider_wide) (ui_slider_margin)) (ui_scrollbar_hit_w)) true)
            (check_int "three rows a step" (ui_wheel_rows) 3))))

(def test_ui_selected () int
  (check_str "a quarter accent on white" (hex_digits (ui_selected_bg (ui_hex "ffffff")) 6) "cde0f8"))
