(def nrect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; The actions of the nodes that have one, and where each is.
(def nav_targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (nav_targets (tail ns)) (append a (append "@" (append (nrect r) (append " " (nav_targets (tail ns)))))))))))

(def nav_light () UiState (ui_state_new (UiLight)))

(def three () (list (list int)) (split_spaces "Computer Volumes data"))

; Computer, 8 letters, 64 and 8 either side, 80; a slash, 8 and 2 either
; side, 12; Volumes 56 + 16, 72; another 12; data in bold, 33 + 16, 49:
; 225 in all, a button high.
(def test_ui_pathbar_size () int
  (add (check_str "three" (nsize (ui_measure (UiPathBar "path" (three)))) "225x34")
       (check_str "one, in bold" (nsize (ui_measure (UiPathBar "path" (cons "Computer" (nil (list int)))))) "81x34")))

(def nsize ((s UiSize)) (list int) (append (digits (ui_sw s)) (append "x" (digits (ui_sh s)))))

; In 300 by 45, the bar is a button high from 5 down; Computer and
; Volumes are targets, going to depths 0 and 1, the slash between them
; 12 wide; data, where one is, is none.
(def test_ui_pathbar_targets () int
  (check_str "each but the last"
    (nav_targets (ui_layout (UiPathBar "path" (three)) (Rect 0 0 300 45) (nav_light) 0))
    "path.select.0@0,5 80x34 path.select.1@92,5 72x34 "))

; In 150, all of it, 225, does not fit, nor ... and Volumes and data,
; 185: the ellipsis and data do, 101, and the ellipsis goes to Volumes.
(def test_ui_pathbar_cut () int
  (check_str "the ellipsis, to depth 1"
    (nav_targets (ui_layout (UiPathBar "path" (three)) (Rect 0 0 150 45) (nav_light) 0))
    "path.select.1@0,5 40x34 "))

; Too narrow even for that, the last is still there, cut short.
(def test_ui_pathbar_last_only () int
  (check_int "the ellipsis, a slash and the last" (length (ui_crumbs_fit (three) 20)) 3))

(def grid_list () (list UiToggle)
  (cons (UiToggle "grid" "view-grid" "") (cons (UiToggle "list" "view-list" "") (nil UiToggle))))

; Two icons, 34 square each, side by side from the left, in the middle
; of 45 rows.
(def test_ui_toggles_targets () int
  (check_str "both"
    (nav_targets (ui_layout (UiToggleGroup "view" (grid_list) "grid") (Rect 0 0 100 45) (nav_light) 0))
    "view.select.grid@0,5 34x34 view.select.list@34,5 34x34 "))

(def test_ui_toggles_size () int
  (check_str "68 by a button" (nsize (ui_measure (UiToggleGroup "view" (grid_list) "grid"))) "68x34"))

; The first color a node with action a paints, or -1.
(def first_color_of ((ns (list UiNode)) (a (list int))) int
  (if (is_empty ns)
      -1
      (match (head ns)
        ((UiNode r ops act f)
          (if (if (eq act a) (not (is_empty ops)) false)
              (match (head ops)
                ((UiPFill x c) c) ((UiPRound x rd c u) c) ((UiPText x s al c b sc) c) ((UiPIcon x y n c s) c) ((UiPImage x y n d ts) -1))
              (first_color_of (tail ns) a))))))

; The active toggle is raised on the card's white; the other has no
; ground, its icon first.
(def test_ui_toggles_active () int
  (let ns (ui_layout (UiToggleGroup "view" (grid_list) "grid") (Rect 0 0 100 45) (nav_light) (ui_hex "ebebeb"))
    (add (check_str "raised" (hex_digits (first_color_of ns "view.select.grid") 6) "ffffff")
         (check_str "the other's icon" (hex_digits (first_color_of ns "view.select.list") 6) (hex_digits (ui_fg (UiLight)) 6)))))

(def two_tabs () (list UiTab) (cons (UiTab "1" "vt1") (cons (UiTab "2" "vt2") (nil UiTab))))

; In 640: 6 in from each side and 3 between, 625 to share, 312 each; 34
; high, 3 down. Each tab's close button is 24 square, 5 in from its end
; and in its middle: 6 + 312 - 29 = 289, 3 + 5 = 8.
(def test_ui_tabbar_targets () int
  (check_str "two tabs, each with its close button"
    (nav_targets (ui_layout (UiTabBar "tabs" (two_tabs) "2") (Rect 0 0 640 40) (nav_light) 0))
    "tabs.select.1@6,3 312x34 tabs.close.1@289,8 24x24 tabs.select.2@321,3 312x34 tabs.close.2@604,8 24x24 "))

; All the bar's width shared, however wide it is.
(def test_ui_tab_w () int
  (add (check_int "shared" (ui_tab_w 640 2) 312)
       (add (check_int "three in 1000" (ui_tab_w 1000 3) 327)
            (check_int "none" (ui_tab_w 640 0) 0))))

(def test_ui_tabbar_size () int
  (check_str "two at their widest" (nsize (ui_measure (UiTabBar "tabs" (two_tabs) "1"))) "455x40"))

; The selected tab is raised, the text's color at 10% over the bar's
; ground; the other has none until the pointer is over it, then 7%.
(def test_ui_tab_grounds () int
  (let s (UiLight)
    (let bg (ui_headerbar_bg s true)
      (add (check_str "selected" (hex_digits (ui_tab_bg s bg true false) 6) (hex_digits (ui_mix (ui_fg s) bg 10) 6))
           (add (check_int "at rest" (ui_tab_bg s bg false false) -1)
                (check_str "under the pointer" (hex_digits (ui_tab_bg s bg false true) 6) (hex_digits (ui_mix (ui_fg s) bg 7) 6)))))))

(def test_ui_tab_close_key () int
  (add (check_str "its key" (ui_tab_close_key "tabs" "tabs.close.12") "12")
       (check_str "not a close" (ui_tab_close_key "tabs" "tabs.select.12") "")))
