; uiloop.l0 -- the toolkit's loop: what a window or an app (uiapp.l0)
; keeps of the steps it takes, a message at a time. Linked with
; window.l0, whose UiWin keeps one, as an app does.
;
; A step is what a message does: routed (ui_route), the app's update
; and view, then laid out, painted and given to the compositor
; (ui_present). The toolkit times its stages as it goes, and a step
; longer than a frame, ui_frame_ns, is said once at the debug level
; (ui_slow_line, which dmesg shows), and again only after a step under
; it, so the next slow app says why it is slow.

; ------------------------------------------------------------------ times

; What a window knows of the step it is in, in clock_ns: when it was
; routed and when that ended, 0 for a present with no route before it;
; when the present's painting ended; and whether a slow step has been
; said since the last that was not.
(data UiTimes (UiTimes int int int bool))

; No step yet.
(def ui_times_new () UiTimes (UiTimes 0 0 0 false))

; The loop's state: its steps' times.
(data UiLoop (UiLoop UiTimes))

; A loop with nothing taken yet.
(def ui_loop_new () UiLoop (UiLoop (ui_times_new)))

; Its times, and the loop with others.
(def ui_loop_times ((l UiLoop)) UiTimes (match l ((UiLoop t) t)))
(def ui_loop_timed ((l UiLoop) (t UiTimes)) UiLoop (match l ((UiLoop old) (UiLoop t))))

; t with the route's start and end, a and b.
(def ui_times_routed ((t UiTimes) (a int) (b int)) UiTimes
  (match t ((UiTimes s r p said) (UiTimes a b p said))))

; t with the painting's end, at.
(def ui_times_painted ((t UiTimes) (at int)) UiTimes
  (match t ((UiTimes s r p said) (UiTimes s r at said))))

; How long a frame is, 16 ms: a step longer than it is slow.
(def ui_frame_ns () int 16000000)

; How long each stage of a step took, in ns: the route, the app's update
; and view, the layout, any wait on a server (a strike asked of font),
; the paint, and the present, telling the compositor what changed.
(data UiStages (UiStages int int int int int int))

; The stages of a step whose present started at p0, laid out by l, its
; waits done by s, painted by pa and ended at e, after the route t says;
; a present with no route before it has none, nor any update.
(def ui_stages_of ((t UiTimes) (p0 int) (l int) (s int) (pa int) (e int)) UiStages
  (match t
    ((UiTimes st r p said)
      (if (le st 0)
          (UiStages 0 0 (sub l p0) (sub s l) (sub pa s) (sub e pa))
          (UiStages (sub r st) (sub p0 r) (sub l p0) (sub s l) (sub pa s) (sub e pa))))))

; How long the whole step took.
(def ui_stages_total ((s UiStages)) int
  (match s ((UiStages r u l w p e) (add r (add u (add l (add w (add p e))))))))

; Whether a step of total ns is said, a slow one said already, said, or
; not: a slow one is said if none was since the last under a frame.
(def ui_slow_due ((total int) (said bool)) bool
  (if (gt total (ui_frame_ns)) (not said) false))

; ns as milliseconds, to a tenth: 37.2.
(def ui_ms_text ((ns int)) (list int)
  (let tenths (div (add ns 50000) 100000)
    (append (digits (div tenths 10)) (append "." (digits (mod tenths 10))))))

; The line a slow step is said in: how long it took, and each stage.
(def ui_slow_line ((s UiStages)) (list int)
  (match s
    ((UiStages r u l w p e)
      (append "slow step: " (append (ui_ms_text (ui_stages_total s))
        (append " ms: route " (append (ui_ms_text r)
        (append ", update and view " (append (ui_ms_text u)
        (append ", layout " (append (ui_ms_text l)
        (append ", wait " (append (ui_ms_text w)
        (append ", paint " (append (ui_ms_text p)
        (append ", present " (ui_ms_text e)))))))))))))))))

; t after a step of stages s: said at the debug level, as the program,
; if it is slow and none was said since the last under a frame; ready
; for the next step, its route not yet known.
(def ui_times_stepped ((t UiTimes) (s UiStages)) UiTimes
  (match t
    ((UiTimes st r p said)
      (let total (ui_stages_total s)
        (let d (if (ui_slow_due total said) (debug_as (app_open_base (proc_path (l0s_pid))) (ui_slow_line s)) 0)
          (UiTimes 0 0 0 (gt total (ui_frame_ns))))))))
