; uiloop.l0 -- the toolkit's loop: what a window or an app (uiapp.l0)
; keeps of the steps it takes, a message at a time. Linked with
; window.l0, whose UiWin keeps one, as an app does.
;
; A step is what a message does: routed (ui_route), the app's update
; and view, then laid out, painted and given to the compositor
; (ui_present). The toolkit times its stages as it goes, and a step
; longer than a frame, ui_frame_ns, is said once at the debug level
; (ui_slow_line, which dmesg shows), and again only after a step under
; it, so the next slow app says why it is slow.

; ------------------------------------------------------------------ times

; What a window knows of the step it is in, in clock_ns: when it was
; routed and when that ended, 0 for a present with no route before it;
; when the present's painting ended; and whether a slow step has been
; said since the last that was not.
(data UiTimes (UiTimes int int int bool))

; No step yet.
(def ui_times_new () UiTimes (UiTimes 0 0 0 false))

; The loop's state: its steps' times, the messages taken from the port
; and not yet handed out, put together (ui_together), in order, and what
; it waits on beside the port (UiWaits).
(data UiLoop (UiLoop UiTimes (list Message) UiWaits))

; What a loop waits on beside its port, and for: its port for the
; toolkit's own replies, a strike's from font, and its port for the
; program's (ui_app_ask), 0 for none; the tags of the program's asks
; still to be answered, the oldest first; the replies taken and not yet
; handed out, with the port each came on; whether its ports are the
; process's set (port_set) yet; whether the program has idle work, so
; that the loop hands out UiIdle rather than wait; the windows still
; to be told a strike came, so that each paints its text again; and the
; program's own ports, waited on in the set too (ui_loop_own).
(data UiWaits (UiWaits int int (list int) (list UiReplied) bool bool (list int) (list int)))

; A reply taken: the port it came on, and the message.
(data UiReplied (UiReplied int Message))

; A loop with nothing taken yet, and no ports beside its own.
(def ui_loop_new () UiLoop (UiLoop (ui_times_new) (nil Message) (UiWaits 0 0 (nil int) (nil UiReplied) false false (nil int) (nil int))))

; A loop with nothing taken yet, its replies to rport and aport.
(def ui_loop_ports ((rport int) (aport int)) UiLoop
  (UiLoop (ui_times_new) (nil Message) (UiWaits rport aport (nil int) (nil UiReplied) false false (nil int) (nil int))))

; Its times, and the loop with others.
(def ui_loop_times ((l UiLoop)) UiTimes (match l ((UiLoop t q ws) t)))
(def ui_loop_timed ((l UiLoop) (t UiTimes)) UiLoop (match l ((UiLoop old q ws) (UiLoop t q ws))))

; The messages it holds, and the loop holding others.
(def ui_loop_queue ((l UiLoop)) (list Message) (match l ((UiLoop t q ws) q)))
(def ui_loop_queued ((l UiLoop) (q (list Message))) UiLoop (match l ((UiLoop t old ws) (UiLoop t q ws))))

; What it waits on, and the loop with that.
(def ui_loop_waits ((l UiLoop)) UiWaits (match l ((UiLoop t q ws) ws)))
(def ui_loop_waiting ((l UiLoop) (ws UiWaits)) UiLoop (match l ((UiLoop t q old) (UiLoop t q ws))))

; Its port for the toolkit's replies, and for the program's.
(def ui_loop_rport ((l UiLoop)) int (match (ui_loop_waits l) ((UiWaits r a asks rs set idle redraw own) r)))
(def ui_loop_aport ((l UiLoop)) int (match (ui_loop_waits l) ((UiWaits r a asks rs set idle redraw own) a)))

; l with idle work, or none.
(def ui_loop_idling ((l UiLoop) (idle bool)) UiLoop
  (match (ui_loop_waits l) ((UiWaits r a asks rs set old redraw own) (ui_loop_waiting l (UiWaits r a asks rs set idle redraw own)))))

; l waiting on the program's own ports too, beside its port and its
; reply ports, as one set: a message on one is handed out as UiGotPort,
; before the port's own, as replies are. Given other ports than it has,
; the set is made again at the next take, so a program adds or lets go a
; port by giving the list again.
(def ui_loop_own ((l UiLoop) (ports (list int))) UiLoop
  (match (ui_loop_waits l)
    ((UiWaits r a asks rs set idle redraw own)
      (if (eq ports own) l (ui_loop_waiting l (UiWaits r a asks rs false idle redraw ports))))))

; The program's own ports l waits on.
(def ui_loop_own_ports ((l UiLoop)) (list int) (match (ui_loop_waits l) ((UiWaits r a asks rs set idle redraw own) own)))

; l with ids to be told a strike came, after any it has.
(def ui_loop_redrawing ((l UiLoop) (ids (list int))) UiLoop
  (match (ui_loop_waits l) ((UiWaits r a asks rs set idle redraw own) (ui_loop_waiting l (UiWaits r a asks rs set idle (append redraw ids) own)))))

; ---------------------------------------------------------------- asking

; l after the program asked port body, its answer to come as a reply
; tagged tag (UiReply TAG MESSAGE): the request sent, never waited on,
; its answer to the loop's port for the program's replies; one that
; cannot be sent is answered at once, as a reply that failed
; (RecvFailed), so the program's state does not wait for it.
(def ui_loop_ask ((l UiLoop) (tag int) (port int) (body (list int))) UiLoop
  (match (ui_loop_waits l)
    ((UiWaits r a asks rs set idle redraw own)
      (let sent (if (le a 0) false (match (port_send port (request a body)) ((Sent) true) ((SendNoPort) false) ((SendFull) false) ((SendTooBig) false)))
        (if sent
            (ui_loop_waiting l (UiWaits r a (append asks (cons tag (nil int))) rs set idle redraw own))
            (ui_loop_waiting l (UiWaits r a (append asks (cons tag (nil int))) (append rs (cons (UiReplied a (RecvFailed)) (nil UiReplied))) set idle redraw own)))))))

; t with the route's start and end, a and b.
(def ui_times_routed ((t UiTimes) (a int) (b int)) UiTimes
  (match t ((UiTimes s r p said) (UiTimes a b p said))))

; t with the painting's end, at.
(def ui_times_painted ((t UiTimes) (at int)) UiTimes
  (match t ((UiTimes s r p said) (UiTimes s r at said))))

; How long a frame is, 16 ms: a step longer than it is slow.
(def ui_frame_ns () int 16000000)

; How long each stage of a step took, in ns: the route, the app's update
; and view, the layout, any wait on a server (a strike asked of font),
; the paint, and the present, telling the compositor what changed.
(data UiStages (UiStages int int int int int int))

; The stages of a step whose present started at p0, laid out by l, its
; waits done by s, painted by pa and ended at e, after the route t says;
; a present with no route before it has none, nor any update.
(def ui_stages_of ((t UiTimes) (p0 int) (l int) (s int) (pa int) (e int)) UiStages
  (match t
    ((UiTimes st r p said)
      (if (le st 0)
          (UiStages 0 0 (sub l p0) (sub s l) (sub pa s) (sub e pa))
          (UiStages (sub r st) (sub p0 r) (sub l p0) (sub s l) (sub pa s) (sub e pa))))))

; How long the whole step took.
(def ui_stages_total ((s UiStages)) int
  (match s ((UiStages r u l w p e) (add r (add u (add l (add w (add p e))))))))

; Whether a step of total ns is said, a slow one said already, said, or
; not: a slow one is said if none was since the last under a frame.
(def ui_slow_due ((total int) (said bool)) bool
  (if (gt total (ui_frame_ns)) (not said) false))

; ns as milliseconds, to a tenth: 37.2.
(def ui_ms_text ((ns int)) (list int)
  (let tenths (div (add ns 50000) 100000)
    (append (digits (div tenths 10)) (append "." (digits (mod tenths 10))))))

; The line a slow step is said in: how long it took, and each stage.
(def ui_slow_line ((s UiStages)) (list int)
  (match s
    ((UiStages r u l w p e)
      (append "slow step: " (append (ui_ms_text (ui_stages_total s))
        (append " ms: route " (append (ui_ms_text r)
        (append ", update and view " (append (ui_ms_text u)
        (append ", layout " (append (ui_ms_text l)
        (append ", wait " (append (ui_ms_text w)
        (append ", paint " (append (ui_ms_text p)
        (append ", present " (ui_ms_text e)))))))))))))))))

; t after a step of stages s: said at the debug level, as the program,
; if it is slow and none was said since the last under a frame; ready
; for the next step, its route not yet known.
(def ui_times_stepped ((t UiTimes) (s UiStages)) UiTimes
  (match t
    ((UiTimes st r p said)
      (let total (ui_stages_total s)
        (let d (if (ui_slow_due total said) (debug_as (app_open_base (proc_path (l0s_pid))) (ui_slow_line s)) 0)
          (UiTimes 0 0 0 (gt total (ui_frame_ns))))))))

; ---------------------------------------------------------------- taking

; What the loop took for a step: a message to the port; a strike's
; answer from font, its payload; a reply to one of the program's asks,
; its tag and the message (RecvFailed if it could not be sent); a
; message on one of the program's own ports, the port and the message;
; idle work's turn, nothing waiting; a window to be told a strike came;
; or nothing, the port gone.
(data UiGot (UiGotMsg Message) (UiGotStrike (list int)) (UiGotReply int Message) (UiGotPort int Message) (UiGotIdle) (UiGotRedraw int) (UiGotLost))

; The loop after it took something for a step, and what.
(data UiTaken (UiTaken UiLoop UiGot))

; The most messages taken at once before a step: more than a port
; holds, so a sender that keeps it full still waits for steps.
(def ui_drain_most () int 64)

; What a step takes, from l, its port port: a window still to be told a
; strike came first; else what waits taken, all of it, the port's onto
; the queue, put together (ui_together, cpid the compositor's pid and
; held each window's buttons), the replies onto theirs; then a reply,
; or the queue's first; with nothing, idle work's turn if the program
; has any, else the next waited for, and what came with it taken too.
; The loop waits on its port, its two reply ports and the program's own
; ports as the process's set (port_set), made the first time and again
; when the own ports change; with no reply ports and no own ports, or a
; set refused, on its port alone.
(def ui_loop_take ((l UiLoop) (port int) (cpid int) (held (Map int int))) UiTaken
  (match (ui_loop_waits l)
    ((UiWaits r a asks rs set idle redraw own)
      (if (not (is_empty redraw))
          (UiTaken (ui_loop_waiting l (UiWaits r a asks rs set idle (tail redraw) own)) (UiGotRedraw (head redraw)))
          (let l2 (ui_loop_drained (ui_loop_set l port) port cpid held (nil UiReplied))
            (if (ui_loop_has l2)
                (ui_loop_popped l2)
                (if idle (UiTaken l2 (UiGotIdle)) (ui_loop_waited l2 port cpid held))))))))

; Whether l holds a reply or a message.
(def ui_loop_has ((l UiLoop)) bool
  (match (ui_loop_waits l)
    ((UiWaits r a asks rs set idle redraw own) (if (is_empty rs) (not (is_empty (ui_loop_queue l))) true))))

; l with its port, its reply ports and the program's own ports made the
; process's set, once, and again once the program's own ports change;
; with no reply port and no own port, or the set refused, as it is, its
; ports none, so it waits on port alone, said as a warning if it had
; ports of its own, which are then never heard.
(def ui_loop_set ((l UiLoop) (port int)) UiLoop
  (match (ui_loop_waits l)
    ((UiWaits r a asks rs set idle redraw own)
      (if (if set true (if (le r 0) (is_empty own) false))
          l
          (match (port_set (ui_set_ports port r a own))
            ((PortSetMade) (ui_loop_waiting l (UiWaits r a asks rs true idle redraw own)))
            ((PortSetNotYours) (ui_loop_unset l (port_setting_why (PortSetNotYours))))
            ((PortSetSize) (ui_loop_unset l (port_setting_why (PortSetSize)))))))))

; The ports of a set: port, the reply ports r and a that are ports, and
; the program's own.
(def ui_set_ports ((port int) (r int) (a int) (own (list int))) (list int)
  (cons port (append (if (gt r 0) (cons r (nil int)) (nil int)) (append (if (gt a 0) (cons a (nil int)) (nil int)) own))))

; l waiting on its port alone, its set refused for why: said, as a
; warning, if it had ports of its own.
(def ui_loop_unset ((l UiLoop) (why (list int))) UiLoop
  (match (ui_loop_waits l)
    ((UiWaits r a asks rs set idle redraw own)
      (let w (if (is_empty own) 0 (warn_as (app_open_base (proc_path (l0s_pid))) (append "cannot wait on its own ports: " why)))
        (ui_loop_waiting l (UiWaits 0 0 asks rs false idle redraw (nil int)))))))

; Whether l waits on its set, not its port alone.
(def ui_loop_on_set ((l UiLoop)) bool (match (ui_loop_waits l) ((UiWaits r a asks rs set idle redraw own) set)))

; ui_loop_take with nothing waiting: the next waited for.
(def ui_loop_waited ((l UiLoop) (port int) (cpid int) (held (Map int int))) UiTaken
  (if (ui_loop_on_set l)
      (match (port_receive_set)
        ((SetRecvFailed) (UiTaken l (UiGotLost)))
        ((SetMessage p m) (ui_loop_popped (ui_loop_drained l port cpid held (cons (UiReplied p m) (nil UiReplied))))))
      (match (port_receive port)
        ((RecvFailed) (UiTaken l (UiGotLost)))
        ((Message from b) (ui_loop_popped (ui_loop_drained l port cpid held (cons (UiReplied port (Message from b)) (nil UiReplied))))))))

; l with first, then what waits, taken: the port's messages after its
; queue, put together, the replies after its replies.
(def ui_loop_drained ((l UiLoop) (port int) (cpid int) (held (Map int int)) (first (list UiReplied))) UiLoop
  (let got (ui_drained_onto l port (ui_drain_most) (rev first))
    (ui_loop_sorted l port cpid held got)))

; Up to n messages waiting taken, from the set if l waits on it, else
; from port, onto the reversed acc, each with its port; the whole in
; order.
(def ui_drained_onto ((l UiLoop) (port int) (n int) (acc (list UiReplied))) (list UiReplied)
  (if (le n 0)
      (rev acc)
      (if (ui_loop_on_set l)
          (match (port_try_receive_set)
            ((SetRecvFailed) (rev acc))
            ((SetMessage p m) (ui_drained_onto l port (sub n 1) (cons (UiReplied p m) acc))))
          (match (port_try_receive port)
            ((RecvFailed) (rev acc))
            ((Message from b) (ui_drained_onto l port (sub n 1) (cons (UiReplied port (Message from b)) acc)))))))

; l with got, messages taken in order, each where it goes: one on port
; after its queue, the whole put together; a reply after its replies.
(def ui_loop_sorted ((l UiLoop) (port int) (cpid int) (held (Map int int)) (got (list UiReplied))) UiLoop
  (match l
    ((UiLoop t q ws)
      (match ws
        ((UiWaits r a asks rs set idle redraw own)
          (UiLoop t (ui_together (append q (rev (ui_on_port got port true (nil Message)))) cpid held)
                  (UiWaits r a asks (append rs (ui_replies_of got port (nil UiReplied))) set idle redraw own)))))))

; The messages of got on port, reversed onto acc.
(def ui_on_port ((got (list UiReplied)) (port int) (on bool) (acc (list Message))) (list Message)
  (if (is_empty got)
      acc
      (match (head got)
        ((UiReplied p m) (ui_on_port (tail got) port on (if (eq p port) (cons m acc) acc))))))

; The replies of got, those on another port than port, in order, after
; the reversed acc.
(def ui_replies_of ((got (list UiReplied)) (port int) (acc (list UiReplied))) (list UiReplied)
  (if (is_empty got)
      (rev acc)
      (match (head got)
        ((UiReplied p m) (ui_replies_of (tail got) port (if (eq p port) acc (cons (head got) acc)))))))

; What l hands out first: a reply, as a message on one of the program's
; own ports, a strike's answer if it came on the toolkit's port or the
; oldest ask's if on the program's; else the queue's first message.
(def ui_loop_popped ((l UiLoop)) UiTaken
  (match l
    ((UiLoop t q ws)
      (match ws
        ((UiWaits r a asks rs set idle redraw own)
          (if (is_empty rs)
              (if (is_empty q) (UiTaken l (UiGotLost)) (UiTaken (UiLoop t (tail q) ws) (UiGotMsg (head q))))
              (match (head rs)
                ((UiReplied p m)
                  (if (any_eq p own)
                      (UiTaken (UiLoop t q (UiWaits r a asks (tail rs) set idle redraw own)) (UiGotPort p m))
                  (if (eq p r)
                      (UiTaken (UiLoop t q (UiWaits r a asks (tail rs) set idle redraw own)) (UiGotStrike (ui_reply_text m)))
                      (UiTaken (UiLoop t q (UiWaits r a (if (is_empty asks) asks (tail asks)) (tail rs) set idle redraw own))
                               (UiGotReply (if (is_empty asks) -1 (head asks)) m))))))))))))

; A reply's payload as text: error: no answer for one that failed.
(def ui_reply_text ((m Message)) (list int)
  (match m ((RecvFailed) "error: no answer") ((Message from b) (msg_text b))))

; ------------------------------------------------------- putting together

; What a message waiting is, to put together: of window ID, a move of
; the pointer, its buttons as they were (a pure move, which a later
; move of the window may stand for), a turn of the wheel, a size asked,
; or anything else of the window, which nothing is put together across;
; or of no window.
(data UiKind (UiKindMove int) (UiKindWheel int) (UiKindSize int) (UiKindBarrier int) (UiKindNone))

; A window's run of pure moves and wheel turns, between two of its other
; messages: the window, and the run's number.
(data UiRun (UiRun int int))

; What a queue's runs come to: for each run, the place of its last move
; and of its last wheel turn, and the wheel's steps summed; for each
; window, the place of its last size; each message's run, -1 for none;
; and each window's buttons as its last pointer notice said, and its
; runs so far.
(data UiRuns (UiRuns (Map UiRun int) (Map UiRun int) (Map UiRun UiSum) (Map int int) (list UiRun) (Map int int) (Map int int)))

; Steps of the wheel summed, across and down.
(data UiSum (UiSum int int))

; ms, the messages waiting, in order, from the compositor, pid cpid, put
; together before they are handed out, as GTK compresses motion before a
; frame: of the pointer's moves of a window in a run (no other message
; of the window between them, a press, a release, a key, or anything
; else), only the last; of its wheel's turns in a run, one, the last, its
; steps the run's sum; of the sizes it is asked, only the last. Every
; other message is kept, in order. held is each window's buttons as the
; toolkit last knew them, so that the first pointer notice of a window
; that changes them is a press or a release, not a move.
(def ui_together ((ms (list Message)) (cpid int) (held (Map int int))) (list Message)
  (match (ui_runs_of ms cpid (UiRuns ((MapEmpty UiRun int)) ((MapEmpty UiRun int)) ((MapEmpty UiRun UiSum)) ((MapEmpty int int)) (nil UiRun) held ((MapEmpty int int))) 0)
    ((UiRuns moves wheels sums sizes runs bs ns)
      (ui_kept ms cpid (UiRuns moves wheels sums sizes (rev runs) bs ns) 0 (nil Message)))))

; What m is, from the compositor, pid cpid, as ui_together sees it: a
; pure move if its buttons are b's, the window's before it.
(def ui_kind_of ((m Message) (cpid int) (b (Option int))) UiKind
  (match m
    ((RecvFailed) (UiKindNone))
    ((Message from bs)
      (if (not (eq from cpid))
          (UiKindNone)
          (match (win_notice_of m)
            ((NoWinNotice) (UiKindNone))
            ((WinNotice id at)
              (match (pointer_event_at m at)
                ((Some p) (match p ((PointerEvent x y pb) (if (eq (Some (bit_and pb 3)) b) (UiKindMove id) (UiKindBarrier id)))))
                ((None)
                  (if (not (is_empty (ui_opt_list (wheel_event_at m at))))
                      (UiKindWheel id)
                      (match (size_notice_at m at) ((Some s) (UiKindSize id)) ((None) (UiKindBarrier id))))))))))))

; A wheel event as a list of it, none or one, to tell whether there is one.
(def ui_opt_list ((o (Option WheelEvent))) (list WheelEvent)
  (match o ((Some e) (cons e (nil WheelEvent))) ((None) (nil WheelEvent))))

; The window a pointer notice m is of and the buttons it says, if it is
; one.
(def ui_pointer_buttons ((m Message)) (Option int)
  (match (win_notice_of m)
    ((NoWinNotice) ((None int)))
    ((WinNotice id at) (match (pointer_event_at m at) ((Some p) (match p ((PointerEvent x y b) (Some (bit_and b 3))))) ((None) ((None int)))))))

; r's runs counted through ms from place i on.
(def ui_runs_of ((ms (list Message)) (cpid int) (r UiRuns) (i int)) UiRuns
  (if (is_empty ms)
      r
      (ui_runs_of (tail ms) cpid (ui_run_step (head ms) cpid r i) (add i 1))))

; r after message m, place i.
(def ui_run_step ((m Message) (cpid int) (r UiRuns) (i int)) UiRuns
  (match r
    ((UiRuns moves wheels sums sizes runs bs ns)
      (match (ui_kind_of m cpid (ui_held_of bs m))
        ((UiKindNone) (UiRuns moves wheels sums sizes (cons (UiRun -1 -1) runs) bs ns))
        ((UiKindBarrier id)
          (UiRuns moves wheels sums sizes (cons (UiRun -1 -1) runs) (ui_buttons_after bs id m) (map_put ns id (add 1 (ui_run_n ns id)))))
        ((UiKindSize id)
          (UiRuns moves wheels sums (map_put sizes id i) (cons (UiRun -1 -1) runs) bs (map_put ns id (add 1 (ui_run_n ns id)))))
        ((UiKindMove id)
          (let k (UiRun id (ui_run_n ns id))
            (UiRuns (map_put moves k i) wheels sums sizes (cons k runs) bs ns)))
        ((UiKindWheel id)
          (let k (UiRun id (ui_run_n ns id))
            (UiRuns moves (map_put wheels k i) (map_put sums k (ui_sum_more (map_get sums k) m)) sizes (cons k runs) bs ns)))))))

; Window id's run so far, 0 for its first.
(def ui_run_n ((ns (Map int int)) (id int)) int (match (map_get ns id) ((Some n) n) ((None) 0)))

; The buttons the window of pointer notice m had before it, as bs keeps
; them; none if m is no pointer notice, or the window's are not known.
(def ui_held_of ((bs (Map int int)) (m Message)) (Option int)
  (match (win_notice_of m) ((NoWinNotice) ((None int))) ((WinNotice id at) (map_get bs id))))

; bs with window id's buttons as m says them, if it is a pointer notice.
(def ui_buttons_after ((bs (Map int int)) (id int) (m Message)) (Map int int)
  (match (ui_pointer_buttons m) ((Some b) (map_put bs id b)) ((None) bs)))

; A run's wheel sum, s if it has one, with m's steps added.
(def ui_sum_more ((s (Option UiSum)) (m Message)) UiSum
  (let base (match s ((Some u) u) ((None) (UiSum 0 0)))
    (match (win_notice_of m)
      ((NoWinNotice) base)
      ((WinNotice id at)
        (match (wheel_event_at m at)
          ((None) base)
          ((Some e) (match e ((WheelEvent x y dx dy) (match base ((UiSum sx sy) (UiSum (add sx dx) (add sy dy))))))))))))

; ms from place i on, as r says to keep them, onto the reversed acc: a
; move kept if it is its run's last, a wheel's turn if it is its run's
; last, with the run's sum, a size if it is its window's last; the rest
; as they are.
(def ui_kept ((ms (list Message)) (cpid int) (r UiRuns) (i int) (acc (list Message))) (list Message)
  (if (is_empty ms)
      (rev acc)
      (match r
        ((UiRuns moves wheels sums sizes runs bs ns)
          (let m (head ms)
            (let rest (UiRuns moves wheels sums sizes (tail runs) bs ns)
              (ui_kept (tail ms) cpid rest (add i 1) (ui_keep_onto m (head runs) r i acc))))))))

; acc with m, place i in run k, as r says, if it is kept.
(def ui_keep_onto ((m Message) (k UiRun) (r UiRuns) (i int) (acc (list Message))) (list Message)
  (match r
    ((UiRuns moves wheels sums sizes runs bs ns)
      (match k
        ((UiRun id n)
          (if (ge id 0)
              (if (eq (map_get moves k) (Some i))
                  (cons m acc)
                  (if (eq (map_get wheels k) (Some i))
                      (cons (ui_wheel_summed m (map_get sums k)) acc)
                      acc))
              (match (ui_size_window m)
                ((Some w) (if (eq (map_get sizes w) (Some i)) (cons m acc) acc))
                ((None) (cons m acc)))))))))

; The window size notice m is of, if it is one.
(def ui_size_window ((m Message)) (Option int)
  (match (win_notice_of m)
    ((NoWinNotice) ((None int)))
    ((WinNotice id at) (match (size_notice_at m at) ((Some s) (Some id)) ((None) ((None int)))))))

; Wheel notice m with its steps made sum's, from the same sender to the
; same window at its place: as it was if sum is none.
(def ui_wheel_summed ((m Message) (sum (Option UiSum))) Message
  (match m
    ((RecvFailed) m)
    ((Message from b)
      (match (win_notice_of m)
        ((NoWinNotice) m)
        ((WinNotice id at)
          (match (wheel_event_at m at)
            ((None) m)
            ((Some e)
              (match e
                ((WheelEvent x y dx dy)
                  (match sum
                    ((None) m)
                    ((Some s) (match s ((UiSum sx sy) (message_new from (win_notice id (wheel_notice (WheelEvent x y sx sy)))))))))))))))))
