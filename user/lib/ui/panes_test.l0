; ----------------------------------------------------------------- dialogs

(def modal () UiWidget
  (UiModal (UiButton "app.go" "" "Go" (UiBtnRegular) true)
           (ui_alert "Format Volume?" (cons "Every file on data will be lost." (nil (list int)))
                     (cons (UiButton "dialog.cancel" "" "Cancel" (UiBtnRegular) true)
                           (cons (UiButton "dialog.format" "" "Format" (UiBtnDestructive) true) (nil UiWidget))))))

(def has_target ((ns (list UiNode)) (action (list int))) bool
  (if (is_empty ns) false (if (eq (ui_node_action (head ns)) action) true (has_target (tail ns) action))))

(def test_modal_targets () int
  (let ns (ui_layout_window (modal) 640 400 (light))
    (add (check_bool "the window's own button is no target" (has_target ns "app.go") false)
         (add (check_bool "cancel" (has_target ns "dialog.cancel") true)
              (check_bool "format" (has_target ns "dialog.format") true)))))

; The window's ground, fafafa, under the dialog: 250 * 0.7 = 175, af.
(def test_modal_dims () int
  (check_str "dimmed" (first_color (head (ui_layout_window (modal) 640 400 (light)))) "afafaf"))

; The card in the middle: 320 wide, as high as the alert, 24 in each way:
; a heading 16, 12, a line 16, 12, 6, 12, the buttons 34: 108, and 48.
(def test_modal_card () int
  (check_str "320 by 156, centered" (wrect (ui_node_rect (card_of (ui_layout_window (modal) 640 400 (light))))) "160,122 320x156"))

; An alert asking for a size, an entry 120 wide in its properties.
(def form () UiWidget
  (ui_alert_form "Create Partition" (cons "Free space: 254.0 kB" (nil (list int)))
                 (cons (UiProps (cons (UiProp "Size" (UiEntry "size" (ui_entry_new "254.0") "" 120)) (nil UiProp))) (nil UiWidget))
                 (cons (UiButton "dialog.cancel" "" "Cancel" (UiBtnRegular) true)
                       (cons (UiButton "dialog.create" "" "Create" (UiBtnSuggested) true) (nil UiWidget)))))

; 24 in each way around: a heading 16, 12, a line 16, 12, the entry's row
; 34, 12, 6, 12, the buttons 34: 154, and 48.
(def test_alert_form_size () int
  (check_int "the body between the lines and the buttons" (ui_sh (ui_measure (form))) 202))

; The card 202 high in the middle of 400, from 99; the entry's row 24 + 56
; down it, from 179, after the name's column, "Size" 32, and 12, 24 in:
; at 160 + 24 + 44. A value has the rest of its row, so the entry is as
; wide as that: 272 - 44, 228.
(def test_alert_form_entry () int
  (let ns (ui_layout_window (UiModal (UiSpace 0 0) (form)) 640 400 (light))
    (check_str "laid out, a target" (wrect (ui_node_rect (node_of ns "size.entry"))) "228,179 228x34")))

; The first node after the dimmed ones: the card.
(def card_of ((ns (list UiNode))) UiNode
  (if (is_empty ns)
      (UiNode (Rect 0 0 0 0) (nil UiPaint) "" false)
      (if (eq (first_color (head ns)) (hex_digits (ui_border (UiLight) (ui_scrim (ui_hex "fafafa"))) 6))
          (head ns)
          (card_of (tail ns)))))
