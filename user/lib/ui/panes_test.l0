             "side.select.a@6,6 208x48 side.select.b@6,54 208x48 "))

; The ground ebebed; the selected row, 10% of the text on it, d9d9da; the
; other none, its first op its icon in the text's color.
(def test_sidebar_colors () int
  (let ns (ui_layout (sidebar) (Rect 0 0 220 400) (light) 0)
    (add (check_str "the ground" (first_color (head ns)) "ebebed")
         (add (check_str "selected" (first_color (node_of ns "side.select.a")) "d9d9da")
              (check_str "not" (first_color (node_of ns "side.select.b")) "323232")))))

; A row with its full-color images draws them, 32 square 8 in, instead
; of the symbolic icon.
(def test_sidebar_image () int
  (let ts (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov))
    (let ns (ui_layout (UiSidebar 220 (cons (UiSideRow "c" "drive-harddisk" "Disk" "" ts) (nil UiSideRow)) "side" "") (Rect 0 0 220 400) (light) 0)
      (match (node_of ns "side.select.c")
        ((UiNode r ops a f) (check_true "image" (eq (head ops) (UiPImage 14 14 32 false ts))))))))

(def test_sidebar_text () int
  (check_str "title, then its line, after the icon and 12"
    (texts (ui_layout (UiSidebar 220 (cons (head (two_rows)) (nil UiSideRow)) "side" "") (Rect 0 0 220 400) (light) 0))
    "1.0 MB Disk@58,14 148x16 virtio-blk@58,30 148x16 "))

; ---------------------------------------------------------------- shares

(def total_of ((xs (list int))) int (if (is_empty xs) 0 (add (head xs) (total_of (tail xs)))))

(def least_of ((xs (list int)) (acc int)) int (if (is_empty xs) acc (least_of (tail xs) (min acc (head xs)))))

; 400 for weights 1528 and 512: 48 each, and 304 shared, 227 of it to the
; first, 304 * 1528 / 2040 rounded down; the last the rest.
(def test_shares () int
  (add (check_str "by weight" (int_list (ui_shares (cons 1528 (cons 512 (nil int))) 400 48)) "275 125 ")
       (add (check_str "no weight, alike" (int_list (ui_shares (cons 0 (cons 0 (nil int))) 101 48)) "50 51 ")
            (add (check_str "too little room for the least, alike" (int_list (ui_shares (cons 9 (cons 1 (cons 1 (nil int)))) 90 48)) "30 30 30 ")
                 (check_int "none" (length (ui_shares (nil int) 100 48)) 0)))))

(def int_list ((xs (list int))) (list int)
  (if (is_empty xs) "" (append (digits (head xs)) (append " " (int_list (tail xs))))))

; A few hundred bars of 1 to 6 parts, of any weights, in any room: they
; fill it exactly, none is narrower than the least, and each is within a
; part's rounding of its share by weight.
(def test_shares_property () int
  (shares_cases 300 12345))

(def shares_cases ((n int) (seed int)) int
  (if (eq n 0)
      0
      (let s1 (rand_next seed)
        (let parts (add 1 (mod (abs_of s1) 6))
          (let s2 (rand_next s1)
            (let total (mod (abs_of s2) 1200)
              (let ws (weights_of parts (rand_next s2) (nil int))
                (add (shares_case ws total)
                     (shares_cases (sub n 1) (rand_next (rand_next s2)))))))))))

(def weights_of ((n int) (seed int) (acc (list int))) (list int)
  (if (eq n 0) acc (weights_of (sub n 1) (rand_next seed) (cons (mod (abs_of seed) 3000) acc))))

(def shares_case ((ws (list int)) (total int)) int
  (let got (ui_shares ws total 48)
    (let n (length ws)
      (let least (if (le (mul n 48) total) 48 (div total n))
        (add (check_int "fills the room" (total_of got) total)
             (add (check_bool "none below the least" (ge (least_of got total) least) true)
                  (check_bool "each near its share" (near_shares ws got least (sub total (mul n least)) (total_of ws) n) true)))))))

(def near_shares ((ws (list int)) (got (list int)) (least int) (extra int) (sum int) (n int)) bool
  (if (is_empty ws)
      true
      (let want (add least (if (le sum 0) (div extra n) (div (mul extra (head ws)) sum)))
        (if (le (abs_of (sub (head got) want)) n) (near_shares (tail ws) (tail got) least extra sum n) false))))

; ------------------------------------------------------------ segment bars

; A small part, muted, then two plain ones, by weight.
(def three () (list UiSegment)
  (cons (UiSegment "a" 7 "Empty" "7" (UiSegMuted))
        (cons (UiSegment "b" 1528 "Big" "1528 of them" (UiSegPlain))
              (cons (UiSegment "c" 512 "Small" "512" (UiSegPlain)) (nil UiSegment)))))

(def bar ((sel (list int))) UiWidget (UiSegmentBar "parts" (three) sel (ui_segbar_h)))

; Inside the frame, 4 in: 392, less two gaps of 2, 388. Each 48, and 244
; shared: none to the first, 7 of 2047; 182 to the second; the rest, 110,
; to the third.
(def test_segbar_layout () int
  (check_str "parts by weight"
    (targets (ui_layout (bar "b") (Rect 0 0 400 64) (light) (ui_hex "fafafa")))
    "parts.select.a@4,4 48x56 parts.select.b@54,4 230x56 parts.select.c@286,4 110x56 "))

(def test_segbar_size () int
  (add (check_str "three at their least, 2 apart, and 6 either side" (size_text (ui_measure (bar "b"))) "162x64")
       (check_str "as high as asked" (size_text (ui_measure (UiSegmentBar "" (three) "" 12))) "162x12")))

; Selected: the accent, 3584e4, with no edge. Muted: an edge, then the
; window's ground, fafafa.
(def test_segbar_colors () int
  (let ns (ui_layout (bar "b") (Rect 0 0 400 64) (light) (ui_hex "fafafa"))
    (add (check_str "selected" (first_color (node_of ns "parts.select.b")) "3584e4")
         (check_str "muted's ground" (second_color (node_of ns "parts.select.a")) "fafafa"))))

(def second_color ((n UiNode)) (list int)
  (match n ((UiNode r ops a f) (first_color (UiNode r (tail ops) a f)))))

(def one () (list UiSegment) (cons (head (tail (three))) (nil UiSegment)))

(def test_segbar_text () int
  (check_str "title over its line, in the middle"
    (texts (ui_layout (UiSegmentBar "parts" (one) "" (ui_segbar_h)) (Rect 0 0 200 64) (light) 0))
    "Big@8,16 184x16 1528 of them@8,32 184x16 "))

; 28 high: the part 20 inside, room for the title alone, in its middle.
; 8 high: a usage bar, room for no text.
(def test_segbar_low () int
  (add (check_str "the title alone"
         (texts (ui_layout (UiSegmentBar "parts" (one) "" 28) (Rect 0 0 200 28) (light) 0)) "Big@8,6 184x16 ")
       (check_str "no text"
         (texts (ui_layout (UiSegmentBar "parts" (one) "" 8) (Rect 0 0 200 8) (light) 0)) "")))

; With no prefix, nothing is a target and none is selected, though a key
; is given.
(def test_segbar_unselectable () int
  (let ns (ui_layout (UiSegmentBar "" (three) "b" (ui_segbar_h)) (Rect 0 0 400 64) (light) (ui_hex "fafafa"))
    (add (check_str "no targets" (targets ns) "")
         (check_bool "nothing in the accent" (has_color ns "3584e4") false))))

(def has_color ((ns (list UiNode)) (c (list int))) bool
  (if (is_empty ns) false (if (eq (first_color (head ns)) c) true (has_color (tail ns) c))))

(def test_segbar_keys () int
  (add (check_str "left" (ui_segbar_key (three) "b" (ui_key_left)) "a")
       (add (check_str "right" (ui_segbar_key (three) "b" (ui_key_right)) "c")
            (add (check_str "at the start" (ui_segbar_key (three) "a" (ui_key_left)) "a")
                 (add (check_str "at the end" (ui_segbar_key (three) "c" (ui_key_right)) "c")
                      (check_str "another key" (ui_segbar_key (three) "b" 30) "b"))))))

; -------------------------------------------------------------- properties

(def props () UiWidget
  (UiProps (cons (UiProp "Size" (UiLabel "1 MB" (UiBody) (UiStart)))
                 (cons (UiProp "Partition Type" (UiLabel "L0S (0x4C)" (UiBody) (UiStart))) (nil UiProp)))))

; The names' column as wide as "Partition Type", 112; 12; the widest
; value, 80. Two rows of 16, 6 apart.
(def test_props_size () int
