(def wrect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def size_text ((s UiSize)) (list int) (append (digits (ui_sw s)) (append "x" (digits (ui_sh s)))))

; The actions of the nodes that have one, and where each is.
(def targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (targets (tail ns)) (append a (append "@" (append (wrect r) (append " " (targets (tail ns)))))))))))

; Every text painted, and where.
(def texts ((ns (list UiNode))) (list int)
  (if (is_empty ns) "" (match (head ns) ((UiNode r ops a f) (append (op_texts ops) (texts (tail ns)))))))

(def op_texts ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPText r s a c b sc) (append s (append "@" (append (wrect r) " "))))
                ((UiPFill r c) "") ((UiPRound r rad c u) "") ((UiPIcon x y n c sc) "") ((UiPImage x y n d ts) ""))
              (op_texts (tail ops)))))

; The color of a node's first op.
(def first_color ((n UiNode)) (list int)
  (match n
    ((UiNode r ops a f)
      (if (is_empty ops)
          "none"
          (match (head ops)
            ((UiPFill r2 c) (hex_digits c 6)) ((UiPRound r2 rad c u) (hex_digits c 6))
            ((UiPText r2 s al c b sc) (hex_digits c 6)) ((UiPIcon x y nm c sc) (hex_digits c 6)) ((UiPImage x y n d ts) "image"))))))

(def node_of ((ns (list UiNode)) (action (list int))) UiNode
  (if (is_empty ns)
      (UiNode (Rect 0 0 0 0) (nil UiPaint) "" false)
      (match (head ns) ((UiNode r ops a f) (if (eq a action) (head ns) (node_of (tail ns) action))))))

(def light () UiState (ui_state_new (UiLight)))

; ---------------------------------------------------------------- selecting

(def test_select_key () int
  (add (check_str "a key" (ui_select_key "vols" "vols.select.free.8") "free.8")
       (add (check_str "another prefix" (ui_select_key "vols" "side.select.1") "")
            (check_str "made back" (ui_select_action "side" "disk") "side.select.disk"))))

