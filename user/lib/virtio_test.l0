(def test_le_bytes () int
  (add (check_str "16 bits" (le16 4660) (cons 52 (cons 18 (nil int))))
       (check_int "64 bits" (length (le64 1)) 8)))

(def test_descriptor () int
  (let b (bytes_from_list (descriptor 2550140928 408 2 7))
    (add (check_int "16 bytes" (bytes_len b) 16)
         (add (check_int "addr" (le_u32 b 0) 2550140928)
              (add (check_int "len" (le_u32 b 8) 408)
                   (check_int "flags, next" (le_u32 b 12) 458754))))))   ; 2, then 7

(def test_device_at () int
  (let addrs (array_from (cons 40960 (cons 12288 (nil int))) 0)
    (add (check_int "page 0" (device_at addrs 512) 41472)
         (check_int "page 1" (device_at addrs 4100) 12292))))

(def test_treg () int
  (add (check_int "transport 31's status" (treg 31 (reg_status)) 15984)
       (check_int "transport 0's config" (treg 0 (reg_config)) 256)))

(def test_transport_irq () int
  (check_int "transport 30" (transport_irq 30) 78))
