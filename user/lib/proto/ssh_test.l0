; ssh_test.l0 -- tests of ssh.l0 against a server written apart from it:
; tests/ssh/vectors.py, on Python's cryptography, made the bytes below,
; with the client's X25519 secret all 0x11 and its cookie all 0x22. For
; each cipher: what the server sends (its version line, KEXINIT, ECDH
; reply signed by an Ed25519 host key, NEWKEYS, then SERVICE_ACCEPT and
; a channel's DATA sealed), and what the client must send once the host
; key is accepted (NEWKEYS, and SERVICE_REQUEST sealed). And packets
; refused: a tag changed, a length too long.

; The bytes the hex digits of s spell, two to a byte.
(def sv_unhex ((s (list int))) bytes (bn_hex s))

; The bytes of b in lowercase hex.
(def sv_hex ((b bytes)) (list int)
  (sv_hex_from b 0 (nil int)))

; The bytes of b from i on in hex, after the reversed acc.
(def sv_hex_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b))
      (rev acc)
      (sv_hex_from b (add i 1) (push (hex_digits (bytes_get b i) 2) acc))))

; An event as a word, data as its text.
(def sv_event ((e SshEvent)) (list int)
  (match e
    ((SshHostKey b) (append "hostkey:" (sv_hex b)))
    ((SshReady) "ready")
    ((SshBanner t) (append "banner:" t))
    ((SshAuthOk) "auth-ok")
    ((SshAuthFailed ms partial) (append "auth-failed:" (join_with "," ms)))
    ((SshAuthPrompts n i ps) (append "prompts:" (digits (length ps))))
    ((SshOpened) "opened")
    ((SshOpenFailed why) (append "open-failed:" why))
    ((SshRequestOk) "request-ok")
    ((SshRequestFailed) "request-failed")
    ((SshData d) (append "data:" (bytes_to_list d)))
    ((SshStderr d) (append "stderr:" (bytes_to_list d)))
    ((SshEof) "eof")
    ((SshExitStatus n) (append "exit:" (digits n)))
    ((SshExitSignal g) (append "signal:" g))
    ((SshChanClosed) "closed")
    ((SshGone why) (append "gone:" why))))

; A step's events, a line each.
(def sv_events ((o SshOut)) (list int)
  (sv_events_from (.events o) (nil int)))

; The events es as lines, after the reversed acc.
(def sv_events_from ((es (list SshEvent)) (acc (list int))) (list int)
  (if (is_empty es) (rev acc) (sv_events_from (tail es) (push "\n" (push (sv_event (head es)) acc)))))

; A step's bytes to send, as one hex string.
(def sv_sent ((o SshOut)) (list int)
  (sv_hex (bytes_concat (.send o))))

; The client begun with the fixed secret and cookie.
(def sv_begun () SshOut
  (ssh_start (bytes_from_list (rsa_repeat 17 32 (nil int))) (bytes_from_list (rsa_repeat 34 16 (nil int)))))

; The vectors.
(def sv_hostkey () (list int) "0000000b7373682d6564323535313900000020c6822637c7d310ec57627be00ba259d253749f4aaf644470cffbe53a35f73242")
(def sv_client_start () (list int) "")
(def sv_chacha_server () (list int) "")
(def sv_chacha_client () (list int) "0000000c0a1500000000000000000000ad1b84e8426f1dad52efb52de127f9847a0bdcac6fedf640022175beee38ca3004852c60e958331c0cc2be65")
(def sv_chacha_h () (list int) "750c322f26d7699fa3eab2a190eb27d4684febf429bae24abdb4f61713be3d8f")
(def sv_aes256_server () (list int) "")
(def sv_aes256_client () (list int) "0000000c0a15000000000000000000000000002025fb9ab2647ed7cef08f8af5b5e8bfd59072fb28c377c9fd824eaade1371e7c440ff00c85a1452a7467ee5ba90c37e6e")
(def sv_aes128_server () (list int) "")
(def sv_aes128_client () (list int) "0000000c0a150000000000000000000000000020ba3b897a6c9338eaee834e2e178560ab0d40c513a3e7a77f80d6b4c854de7b03a2a322b1c8bb9e1f50adfee5e00e57da")

; The client after the server's bytes of hex hx, fed k bytes at a time.
(def sv_fed ((hx (list int)) (k int)) SshOut
  (let b (sv_unhex hx)
    (sv_feed (.s (sv_begun)) b 0 k (nil SshEvent) (nil bytes))))

; The client fed the bytes of b from i on, k at a time, the events and
; bytes sent so far kept reversed.
(def sv_feed ((s Ssh) (b bytes) (i int) (k int) (evs (list SshEvent)) (sent (list bytes))) SshOut
  (if (ge i (bytes_len b))
      (SshOut s (rev sent) (rev evs))
      (let o (ssh_more s b i (min (bytes_len b) (add i k)))
        (sv_feed (.s o) b (add i k) k (rev_onto (.events o) evs) (rev_onto (.send o) sent)))))

; ------------------------------------------------------------- starting

; The version line and KEXINIT, byte for byte.
(def test_ssh_start () int
  (check_str "start" (sv_sent (sv_begun)) (sv_client_start)))

; ------------------------------------------------------------- the exchange

; The host key is told, its signature of H checked, and the exchange
; waits; H is the server's.
(def test_ssh_exchange_chacha () int
  (let o (sv_fed (sv_chacha_server) 100000)
    (add (check_str "events" (sv_events o) (append "hostkey:" (append (sv_hostkey) "\n")))
         (add (check_str "H" (sv_hex (.h (.s o))) (sv_chacha_h))
              (check_int "stage" (.stage (.s o)) (ssh_stage_host))))))

; Accepted: NEWKEYS and the sealed SERVICE_REQUEST as the server's side
; made them, and the held SERVICE_ACCEPT and DATA opened.
(def test_ssh_accept_chacha () int
  (let o (ssh_host_accept (.s (sv_fed (sv_chacha_server) 100000)))
    (add (check_str "sent" (sv_sent o) (sv_chacha_client))
         (check_str "events" (sv_events o) "ready\ndata:hello from the server\n\n"))))

; The same, the server's bytes coming 7 at a time.
(def test_ssh_pieces_chacha () int
  (let o (ssh_host_accept (.s (sv_fed (sv_chacha_server) 7)))
    (add (check_str "sent" (sv_sent o) (sv_chacha_client))
         (check_str "events" (sv_events o) "ready\ndata:hello from the server\n\n"))))

(def test_ssh_accept_aes256 () int
  (let o (ssh_host_accept (.s (sv_fed (sv_aes256_server) 100000)))
    (add (check_str "sent" (sv_sent o) (sv_aes256_client))
         (check_str "events" (sv_events o) "ready\ndata:hello from the server\n\n"))))

(def test_ssh_accept_aes128 () int
  (let o (ssh_host_accept (.s (sv_fed (sv_aes128_server) 100000)))
    (add (check_str "sent" (sv_sent o) (sv_aes128_client))
         (check_str "events" (sv_events o) "ready\ndata:hello from the server\n\n"))))

; ------------------------------------------------------------- refused

; The server's bytes with the byte at i, of its hex, changed.
(def sv_flipped ((hx (list int)) (i int)) (list int)
  (append (take hx i) (cons (if (eq (nth hx i) 48) 49 48) (drop hx (add i 1)))))

; A bit of the last packet's tag changed: the DATA is refused, after
; the SERVICE_ACCEPT before it.
(def test_ssh_tag_refused () int
  (let (hx (sv_flipped (sv_chacha_server) (sub (length (sv_chacha_server)) 1))
        o (ssh_host_accept (.s (sv_fed hx 100000))))
    (check_str "events" (sv_events o) "ready\ngone:a packet's tag does not check\n")))

; The ECDH reply's signature changed: refused before the host key is
; told.
(def test_ssh_signature_refused () int
  (let (at (add 48 (mul 2 (add 224 140)))
        o (sv_fed (sv_flipped (sv_chacha_server) at) 100000))
    (check_str "events" (sv_events o) "gone:the server's signature of the exchange does not check\n")))

; A server that speaks only SSH 1.
(def test_ssh_version_refused () int
  (let o (sv_fed (sv_hex (bytes_from_list "SSH-1.5-Old\r\n")) 100)
    (check_str "events" (sv_events o) "gone:the server speaks another SSH: SSH-1.5-Old\n")))

; Lines before the version line are passed over.
(def test_ssh_version_after_lines () int
  (let o (sv_fed (sv_hex (bytes_from_list "hello\r\nSSH-2.0-X\r\n")) 100)
    (add (check_str "vs" (.vs (.s o)) "SSH-2.0-X")
         (check_int "stage" (.stage (.s o)) (ssh_stage_kexinit)))))

; A plain packet's length past the most taken.
(def test_ssh_long_packet_refused () int
  (let o (sv_fed (append (sv_hex (bytes_from_list "SSH-2.0-X\r\n")) "7fffffff00") 100)
    (check_str "events" (sv_events o) "gone:a packet's length is wrong\n")))

; ------------------------------------------------------------- packets

; A payload sealed by each cipher opens again by the same keys, at
; several lengths, which pad differently.
(def test_ssh_seal_round_trip () int
  (add (sv_round (SshChacha (bn_hex (sv_chacha_h)) (bn_hex (sv_chacha_h))))
       (sv_round (SshGcm (gcm_key (bn_hex (sv_chacha_h))) (bytes_slice (bn_hex (sv_chacha_h)) 0 12)))))

; Failures sealing then opening payloads of 0 to 40 bytes under a.
(def sv_round ((a SshAead)) int
  (sv_round_from a 0 0))

; The rest of sv_round, from length n.
(def sv_round_from ((a SshAead) (n int) (fails int)) int
  (if (gt n 40)
      (check_int "round trips failed" fails 0)
      (let (d (SshDir a 7 3)
            p (bytes_from_list (rsa_repeat n n (nil int))))
        (match (ssh_seal d p)
          ((SshSealed d1 b)
            (match (ssh_unseal d b)
              ((SshGot q next d2) (sv_round_from a (add n 1) (if (and (eq q p) (eq next (bytes_len b))) fails (add fails 1))))
              ((SshNeed) (sv_round_from a (add n 1) (add fails 1)))
              ((SshBad why) (sv_round_from a (add n 1) (add fails 1)))))))))
