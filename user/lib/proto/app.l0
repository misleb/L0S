; app.l0 -- apps, as the initramfs keeps them: each in a bundle, a
; directory /Applications/NAME.app, holding its program, its icon, and its
; manifest, which says what they are, a line each, # for a comment:
;
;   name Terminal                 what the app is called: the launcher
;                                 and the top bar show it
;   exec vt                       its program, a file in the bundle
;   icon icon.ppm                 its icon, a 48 by 48 binary PPM there
;   summary A terminal in a window
;
; name and exec are needed; icon and summary may be left out. A bundle's
; name is one word, since the shell and the inittab split at spaces; the
; app's name may be several. Pure but for app_read, which reads a
; manifest, and app_bundles, which reads every one.

; An app: its name, its program's path and its icon's, "" for none, and
; what it is.
(data App (App (list int) (list int) (list int) (list int)))

; An app's name, program, icon and summary.
(def app_name ((a App)) (list int) (match a ((App n e i s) n)))
(def app_exec ((a App)) (list int) (match a ((App n e i s) e)))
(def app_icon ((a App)) (list int) (match a ((App n e i s) i)))
(def app_summary ((a App)) (list int) (match a ((App n e i s) s)))

; The manifest's path in a bundle.
(def app_manifest_path ((bundle (list int))) (list int) (append bundle "/manifest"))

; ---------------------------------------------------------------- reading

; The app a bundle's manifest, text, describes, its files' paths in the
; bundle; or why it is not one, with the line.
(def app_parse ((bundle (list int)) (text (list int))) (Result App (list int))
  (app_lines bundle text 1 (App "" "" "" "")))

(def app_lines ((bundle (list int)) (text (list int)) (n int) (a App)) (Result App (list int))
  (if (is_empty text)
      (app_complete a)
      (match (app_line bundle (split_spaces (strip_cr (take_line text))) a)
        ((Ok next) (app_lines bundle (drop_line text) (add n 1) next))
        ((Err why) ((Err App (list int)) (append "line " (append (digits n) (append ": " why))))))))

; A manifest needs a name and a program.
(def app_complete ((a App)) (Result App (list int))
  (if (is_empty (app_name a))
      ((Err App (list int)) "no name")
      (if (is_empty (app_exec a)) ((Err App (list int)) "no exec") ((Ok App (list int)) a))))

; a, with one line's words: a key and its value, or nothing.
(def app_line ((bundle (list int)) (words (list (list int))) (a App)) (Result App (list int))
  (if (is_empty words)
      ((Ok App (list int)) a)
      (if (starts_with (head words) "#")
          ((Ok App (list int)) a)
          (if (is_empty (tail words))
              ((Err App (list int)) (append (head words) " needs a value"))
              (app_keyed bundle (head words) (tail words) a)))))

(def app_keyed ((bundle (list int)) (key (list int)) (vals (list (list int))) (a App)) (Result App (list int))
  (match a
    ((App n e i s)
      (if (eq key "name") ((Ok App (list int)) (App (unwords vals) e i s))
      (if (eq key "summary") ((Ok App (list int)) (App n e i (unwords vals)))
      (if (eq key "exec") (app_file bundle key vals a)
      (if (eq key "icon") (app_file bundle key vals a)
      ((Err App (list int)) (append "no key " key)))))))))

; exec or icon: one file, in the bundle itself.
(def app_file ((bundle (list int)) (key (list int)) (vals (list (list int))) (a App)) (Result App (list int))
  (if (not (is_empty (tail vals)))
      ((Err App (list int)) (append key " is one file"))
      (if (any_eq 47 (head vals))
          ((Err App (list int)) (append key " is a file in the bundle, with no /"))
          (let path (append bundle (cons 47 (head vals)))
            (match a
              ((App n e i s)
                ((Ok App (list int)) (if (eq key "exec") (App n path i s) (App n e path s)))))))))

; The app in bundle, its manifest read; or why not, naming the manifest.
(def app_read ((bundle (list int))) (Result App (list int))
  (let path (app_manifest_path bundle)
    (match (read_whole path)
      ((Err why) ((Err App (list int)) (append path (append ": " why))))
      ((Ok b)
        (match (app_parse bundle (bytes_to_list b))
          ((Ok a) ((Ok App (list int)) a))
          ((Err why) ((Err App (list int)) (append path (append " " why)))))))))

; ---------------------------------------------------------------- bundles

; The bundles among paths, as entry_paths gives them: each directory
; /Applications/NAME.app, without its final /, in order.
(def app_bundle_dirs ((paths (list (list int)))) (list (list int))
  (app_dirs_onto paths (nil (list int))))

(def app_dirs_onto ((paths (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty paths)
      (rev acc)
      (app_dirs_onto (tail paths) (if (app_is_bundle_dir (head paths)) (cons (app_undir (head paths)) acc) acc))))

; Whether path is a bundle's directory, as the archive names it, with a
; final /.
(def app_is_bundle_dir ((path (list int))) bool
  (if (not (starts_with path (apps_dir)))
      false
      (let rest (drop_n path (length (apps_dir)))
        (if (is_empty rest)
            false
            (if (eq (head (rev rest)) 47) (is_bundle_name (app_undir rest)) false)))))

(def app_undir ((path (list int))) (list int)
  (if (is_empty path) path (if (eq (head (rev path)) 47) (rev (tail (rev path))) path)))

; The bundle a name or a path means: a path to one, NAME.app with or
; without its final /, or a bare NAME, /Applications/NAME.app; or "" if
; it means none.
(def app_bundle_named ((what (list int))) (list int)
  (if (any_eq 47 what)
      (let p (normal_path what)
        (if (app_is_bundle_dir (append p "/")) p ""))
      (if (is_bundle_name (append what ".app")) (append (apps_dir) (append what ".app")) "")))

; Every app whose bundle is in the initramfs and whose manifest reads,
; in the archive's order.
(def app_bundles () (list App)
  (app_read_all (app_bundle_dirs (entry_paths)) (nil App)))

(def app_read_all ((dirs (list (list int))) (acc (list App))) (list App)
  (if (is_empty dirs)
      (rev acc)
      (app_read_all (tail dirs)
        (match (app_read (head dirs))
          ((Ok a) (cons a acc))
          ((Err why) acc)))))

; The app among apps whose program is at path, if any.
(def app_for_exec ((apps (list App)) (path (list int))) (Option App)
  (if (is_empty apps)
      ((None App))
      (if (eq (app_exec (head apps)) path) (Some (head apps)) (app_for_exec (tail apps) path))))

; ----------------------------------------------------------------- running

; The entry of the program what names, among paths: as program_entry finds
; it, or else the program of the app whose bundle what names, read from
; its manifest; or -1.
(def app_program_entry ((what (list int)) (paths (list (list int)))) int
  (let e (program_entry what paths)
    (if (ge e 0)
        e
        (let b (app_bundle_named what)
          (if (if (is_empty b) true (not (any_eq (append b "/") paths)))
              -1
              (match (app_read b)
                ((Ok a) (index_of (app_exec a) paths))
                ((Err why) -1)))))))
