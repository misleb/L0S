; app.l0 -- apps, as the initramfs keeps them: each in a bundle, a
; directory /Applications/NAME.app, holding its program, its icon, and its
; manifest, which says what they are, a line each, # for a comment:
;
;   name Terminal                 what the app is called: the launcher
;                                 and the top bar show it
;   exec vt                       its program, a file in the bundle
;   icon icon.ppm                 its icon, a 48 by 48 binary PPM there
;   summary A terminal in a window
;
; name and exec are needed; icon and summary may be left out. A bundle's
; name is one word, since the shell and the inittab split at spaces; the
; app's name may be several. Pure but for app_read, which reads a
; manifest, and app_bundles, which reads every one.

; An app: its name, its program's path and its icon's, "" for none, and
; what it is.
(data App (App (name (list int)) (exec (list int)) (icon (list int)) (summary (list int))))

; The manifest's path in a bundle.
(def app_manifest_path ((bundle (list int))) (list int) (append bundle "/manifest"))

; ---------------------------------------------------------------- reading

; The app a bundle's manifest, text, describes, its files' paths in the
; bundle; or why it is not one, with the line.
(def app_parse ((bundle (list int)) (text (list int))) (Result App (list int))
  (app_lines bundle text 1 (App "" "" "" "")))

; app_parse's loop: a after each line of text from line n on; the first
; bad line is the error, numbered.
(def app_lines ((bundle (list int)) (text (list int)) (n int) (a App)) (Result App (list int))
  (if (is_empty text)
      (app_complete a)
      (match (app_line bundle (split_spaces (strip_cr (take_line text))) a)
        ((Ok next) (app_lines bundle (drop_line text) (add n 1) next))
        ((Err why) ((Err App (list int)) (append "line " (append (digits n) (append ": " why))))))))

; A manifest needs a name and a program.
(def app_complete ((a App)) (Result App (list int))
  (if (is_empty (.name a)) ((Err App (list int)) "no name")
      (is_empty (.exec a)) ((Err App (list int)) "no exec")
      ((Ok App (list int)) a)))

; a, with one line's words: a key and its value, or nothing.
(def app_line ((bundle (list int)) (words (list (list int))) (a App)) (Result App (list int))
  (if (is_empty words) ((Ok App (list int)) a)
      (starts_with (head words) "#") ((Ok App (list int)) a)
      (is_empty (tail words)) ((Err App (list int)) (append (head words) " needs a value"))
      (app_keyed bundle (head words) (tail words) a)))

; a with key set to vals: name and summary take every word, exec and
; icon one file; any other key is an error.
(def app_keyed ((bundle (list int)) (key (list int)) (vals (list (list int))) (a App)) (Result App (list int))
  (match a
    ((App n e i s)
      (if (eq key "name") ((Ok App (list int)) (App (unwords vals) e i s))
          (eq key "summary") ((Ok App (list int)) (App n e i (unwords vals)))
          (eq key "exec") (app_file bundle key vals a)
          (eq key "icon") (app_file bundle key vals a)
          ((Err App (list int)) (append "no key " key))))))

; exec or icon: one file, in the bundle itself.
(def app_file ((bundle (list int)) (key (list int)) (vals (list (list int))) (a App)) (Result App (list int))
  (if (not (is_empty (tail vals))) ((Err App (list int)) (append key " is one file"))
      (any_eq 47 (head vals)) ((Err App (list int)) (append key " is a file in the bundle, with no /"))
      (let path (append bundle (cons 47 (head vals)))
        (match a
          ((App n e i s)
            ((Ok App (list int)) (if (eq key "exec") (App n path i s) (App n e path s))))))))

; The app in bundle, its manifest read; or why not, naming the manifest.
(def app_read ((bundle (list int))) (Result App (list int))
  (let path (app_manifest_path bundle)
    (match (read_whole path)
      ((Err why) ((Err App (list int)) (append path (append ": " why))))
      ((Ok b)
        (match (app_parse bundle (bytes_to_list b))
          ((Ok a) ((Ok App (list int)) a))
          ((Err why) ((Err App (list int)) (append path (append " " why)))))))))

; ---------------------------------------------------------------- bundles

; The bundles among paths, as entry_paths gives them: each directory
; /Applications/NAME.app, without its final /, in order.
(def app_bundle_dirs ((paths (list (list int)))) (list (list int))
  (app_dirs_onto paths (nil (list int))))

; app_bundle_dirs's loop: each bundle's directory among paths, without
; its final /, onto the reversed acc.
(def app_dirs_onto ((paths (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty paths)
      (rev acc)
      (app_dirs_onto (tail paths) (if (app_is_bundle_dir (head paths)) (cons (app_undir (head paths)) acc) acc))))

; Whether path is a bundle's directory, as the archive names it, with a
; final /.
(def app_is_bundle_dir ((path (list int))) bool
  (if (not (starts_with path (apps_dir)))
      false
      (let rest (drop_n path (length (apps_dir)))
        (and (not (is_empty rest)) (and (eq (head (rev rest)) 47) (is_bundle_name (app_undir rest)))))))

; path without one final /, if it has one.
(def app_undir ((path (list int))) (list int)
  (if (is_empty path) path (eq (head (rev path)) 47) (rev (tail (rev path))) path))

; The bundle a name or a path means: a path to one, NAME.app with or
; without its final /, or a bare NAME, /Applications/NAME.app; or "" if
; it means none.
(def app_bundle_named ((what (list int))) (list int)
  (if (any_eq 47 what)
      (let p (normal_path what)
        (if (app_is_bundle_dir (append p "/")) p ""))
      (is_bundle_name (append what ".app")) (append (apps_dir) (append what ".app"))
      ""))

; Every app whose bundle is in /Applications and whose manifest reads, in
; the order app_dirs_now gives them: the initramfs's, or the system
; volume's, from a listing of /Applications alone; none if it refuses
; the listing.
(def app_bundles () (list App)
  (match (app_dirs_now)
    ((None) (nil App))
    ((Some dirs) (app_read_all dirs (nil App)))))

; app_bundles's loop: the app in each bundle of dirs onto the reversed
; acc; a bundle whose manifest does not read is skipped.
(def app_read_all ((dirs (list (list int))) (acc (list App))) (list App)
  (if (is_empty dirs)
      (rev acc)
      (app_read_all (tail dirs)
        (match (app_read (head dirs))
          ((Ok a) (cons a acc))
          ((Err why) acc)))))

; ---------------------------------------------------------------- rescanning

; The bundles in /Applications now, each directory without its final /:
; the initramfs's, which never change, or, when / is a volume, those its
; file server lists; none if it refuses the listing.
(def app_dirs_now () (Option (list (list int)))
  (if (is_empty (fs_system_volume))
      (Some (app_bundle_dirs (entry_paths)))
      (match (fs_list (drop_last (apps_dir)))
        ((FsListRefused code) ((None (list (list int)))))
        ((FsFiles files) (Some (app_bundle_dirs (app_listed (stats_names files))))))))

; The paths in /Applications of the names a listing of it gave.
(def app_listed ((names (list (list int)))) (list (list int))
  (if (is_empty names)
      (nil (list int))
      (cons (append (apps_dir) (head names)) (app_listed (tail names)))))

; The directory of each app's program: its bundle, without its final /.
(def app_dirs_of ((apps (list App))) (list (list int))
  (if (is_empty apps)
      (nil (list int))
      (cons (app_dir_of (.exec (head apps))) (app_dirs_of (tail apps)))))

; The directory a file's path is in, without its final /: path up to its
; last /, or "" if it has none.
(def app_dir_of ((path (list int))) (list int)
  (rev (app_after_slash (rev path))))

; A reversed path without its last name, and the / before it.
(def app_after_slash ((rp (list int))) (list int)
  (if (is_empty rp) rp
      (eq (head rp) 47) (tail rp)
      (app_after_slash (tail rp))))

; The apps there are now, if they are not those of known: every bundle
; read again when the set of bundle directories differs from known's,
; in whatever order. A bundle whose manifest did not read is not in
; known, so it is tried again each time, and shows once its manifest
; does. None if nothing changed, or the listing was refused.
(def app_refreshed ((known (list App))) (Option (list App))
  (match (app_dirs_now)
    ((None) ((None (list App))))
    ((Some dirs)
      (if (eq (sort dirs) (sort (app_dirs_of known)))
          ((None (list App)))
          (Some (app_read_all dirs (nil App)))))))

; The app whose program is at path, if it is in a bundle whose manifest
; says so: for a program started before its bundle was known.
(def app_for_path ((path (list int))) (Option App)
  (let dir (app_dir_of path)
    (if (app_is_bundle_dir (append dir "/"))
        (match (app_read dir)
          ((Ok a) (if (eq (.exec a) path) (Some a) ((None App))))
          ((Err why) ((None App))))
        ((None App)))))

; The app among apps whose program is at path, if any.
(def app_for_exec ((apps (list App)) (path (list int))) (Option App)
  (if (is_empty apps) ((None App))
      (eq (.exec (head apps)) path) (Some (head apps))
      (app_for_exec (tail apps) path)))

; ----------------------------------------------------------------- running

; The path of the program what names, among paths, as program_paths
; gives them: as program_found finds it, or else the program of the app
; whose bundle what names, read from its manifest, as program_found
; finds that; or empty for none.
(def app_program_path ((what (list int)) (paths (list (list int)))) (list int)
  (let p (program_found what paths)
    (if (not (is_empty p))
        p
        (let b (app_bundle_named what)
          (if (or (is_empty b) (not (any_eq (append b "/") paths)))
              ""
              (match (app_read b)
                ((Ok a) (program_found (.exec a) paths))
                ((Err why) "")))))))
