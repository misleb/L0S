; agent_test.l0 -- the agent protocol: each notice made and read back,
; the requests' bodies, and what the client makes of answers.

(def bb ((s (list int))) bytes (bytes_from_list s))

; A notice as agentd sends it, as the client receives it, from pid 9.
(def got ((notice bytes)) AgentEvent
  (match (message_new 9 (bytes_to_list notice)) ((Message from b) (agent_event_of b)) ((RecvFailed) (AgentNone))))

; An event as text, to compare.
(def event_text ((e AgentEvent)) (list int)
  (match e
    ((AgentText t) (append "text " (bytes_to_list t)))
    ((AgentTool n t) (append "tool " (append n (cons 32 (bytes_to_list t)))))
    ((AgentResult n f t) (append "result " (append n (append (if f " failed " " ok ") (bytes_to_list t)))))
    ((AgentCompacted a z) (append "compacted " (append (digits a) (cons 32 (digits z)))))
    ((AgentDone r) (append "done " r))
    ((AgentError t) (append "error " (bytes_to_list t)))
    ((AgentSaid src t) (append "said " (append src (cons 32 (bytes_to_list t)))))
    ((AgentOpened busy) (if busy "opened busy" "opened idle"))
    ((AgentNone) "none")))

(def test_text_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_text_notice (bb "Hello,\nworld"))) "agent text\nHello,\nworld")
       (check_str "read" (event_text (got (agent_text_notice (bb "Hello,\nworld")))) "text Hello,\nworld")))

(def test_text_empty () int
  (check_str "read" (event_text (got (agent_text_notice (bb "")))) "text "))

(def test_tool_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_tool_notice "make_dir" (bb "{\"path\":\"notes\"}"))) "agent tool make_dir\n{\"path\":\"notes\"}")
       (check_str "read" (event_text (got (agent_tool_notice "make_dir" (bb "{}")))) "tool make_dir {}")))

(def test_result_notice () int
  (add (check_str "ok" (event_text (got (agent_result_notice "run" false (bb "exit 0\nhi")))) "result run ok exit 0\nhi")
       (check_str "failed" (event_text (got (agent_result_notice "run" true (bb "no program x")))) "result run failed no program x")))

(def test_compacted_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_compacted_notice 120000 9000)) "agent compacted 120000 9000")
       (check_str "read" (event_text (got (agent_compacted_notice 120000 9000))) "compacted 120000 9000")))

(def test_done_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_done_notice "end_turn")) "agent done end_turn")
       (check_str "read" (event_text (got (agent_done_notice "stopped"))) "done stopped")))

(def test_error_notice () int
  (check_str "read" (event_text (got (agent_error_notice (bb "Overloaded")))) "error Overloaded"))

(def test_said_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_said_notice "speech" (bb "make a note"))) "agent said speech\nmake a note")
       (check_str "read" (event_text (got (agent_said_notice "speech" (bb "make a note")))) "said speech make a note")))

(def test_opened_notice () int
  (add (check_str "busy" (event_text (got (agent_opened_notice true))) "opened busy")
       (add (check_str "idle" (event_text (got (agent_opened_notice false))) "opened idle")
            (check_str "neither" (event_text (got (bb "agent opened maybe"))) "none"))))

(def test_not_notices () int
  (add (check_str "other" (event_text (got (bb "tty"))) "none")
       (add (check_str "no kind" (event_text (got (bb "agent "))) "none")
            (check_str "unknown" (event_text (got (bb "agent sing loud"))) "none"))))

(def test_bodies () int
  (add (check_str "open" (agent_open_body 12) "open 12")
       (add (check_str "say" (agent_say_body "app" "hi there") "say app\nhi there")
            (add (check_str "stop" (agent_stop_body) "stop")
                 (add (check_str "clear" (agent_clear_body) "clear")
                      (check_str "close" (agent_close_body 12) "close 12"))))))

(def test_opened () int
  (match (agent_opened 5 6 8 7 "ok")
    ((Ok c) (add (check_int "notices" (.np c) 8) (check_int "pid" (.pid c) 7)))
    ((Err why) (fail_because "opened" why))))

(def test_opened_refused () int
  (match (agent_opened 5 6 8 7 "error: no port 0")
    ((Ok c) (fail_because "refused" "opened"))
    ((Err why) (check_str "why" why "no port 0"))))

; Under an operating system no agentd is running.
(def test_no_agent () int
  (match (agent_open 1 2)
    ((Ok c) (fail_because "open" "opened"))
    ((Err why) (check_str "why" why "the agent is not running (no /etc/agent/config?)"))))
