; agent_test.l0 -- the agent protocol: each notice made and read back,
; the requests' bodies, and what the client makes of answers.

(def bb ((s (list int))) bytes (bytes_from_list s))

; A notice as agentd sends it, as the client receives it, from pid 9.
(def got ((notice bytes)) AgentEvent
  (match (message_new 9 (bytes_to_list notice)) ((Message from b) (agent_event_of b)) ((RecvFailed) (AgentNone))))

; An event as text, to compare.
(def event_text ((e AgentEvent)) (list int)
  (match e
    ((AgentText id t) (append "text " (append (digits id) (cons 32 (bytes_to_list t)))))
    ((AgentTool id n t) (append "tool " (append (digits id) (append " " (append n (cons 32 (bytes_to_list t)))))))
    ((AgentResult id n f t) (append "result " (append (digits id) (append " " (append n (append (if f " failed " " ok ") (bytes_to_list t)))))))
    ((AgentCompacted id a z) (append "compacted " (append (digits id) (append " " (append (digits a) (cons 32 (digits z)))))))
    ((AgentDone id r) (append "done " (append (digits id) (cons 32 r))))
    ((AgentError id t) (append "error " (append (digits id) (cons 32 (bytes_to_list t)))))
    ((AgentNone) "none")))

(def test_text_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_text_notice 3 (bb "Hello,\nworld"))) "agent 3 text\nHello,\nworld")
       (check_str "read" (event_text (got (agent_text_notice 3 (bb "Hello,\nworld")))) "text 3 Hello,\nworld")))

(def test_text_empty () int
  (check_str "read" (event_text (got (agent_text_notice 1 (bb "")))) "text 1 "))

(def test_tool_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_tool_notice 2 "make_dir" (bb "{\"path\":\"notes\"}"))) "agent 2 tool make_dir\n{\"path\":\"notes\"}")
       (check_str "read" (event_text (got (agent_tool_notice 2 "make_dir" (bb "{}")))) "tool 2 make_dir {}")))

(def test_result_notice () int
  (add (check_str "ok" (event_text (got (agent_result_notice 2 "run" false (bb "exit 0\nhi")))) "result 2 run ok exit 0\nhi")
       (check_str "failed" (event_text (got (agent_result_notice 2 "run" true (bb "no program x")))) "result 2 run failed no program x")))

(def test_compacted_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_compacted_notice 4 120000 9000)) "agent 4 compacted 120000 9000")
       (check_str "read" (event_text (got (agent_compacted_notice 4 120000 9000))) "compacted 4 120000 9000")))

(def test_done_notice () int
  (add (check_str "bytes" (bytes_to_list (agent_done_notice 1 "end_turn")) "agent 1 done end_turn")
       (check_str "read" (event_text (got (agent_done_notice 1 "stopped"))) "done 1 stopped")))

(def test_error_notice () int
  (check_str "read" (event_text (got (agent_error_notice 5 (bb "Overloaded")))) "error 5 Overloaded"))

(def test_not_notices () int
  (add (check_str "other" (event_text (got (bb "tty"))) "none")
       (add (check_str "no id" (event_text (got (bb "agent x text\nhi"))) "none")
            (check_str "unknown" (event_text (got (bb "agent 1 sing loud"))) "none"))))

(def test_bodies () int
  (add (check_str "open" (agent_open_body 12) "open 12")
       (add (check_str "say" (agent_say_body 1 "hi there") "say 1\nhi there")
            (add (check_str "stop" (agent_stop_body 1) "stop 1")
                 (check_str "close" (agent_close_body 2) "close 2")))))

(def test_opened () int
  (match (agent_opened 5 6 7 "conv 3")
    ((Ok c) (add (check_int "id" (.id c) 3) (check_int "pid" (.pid c) 7)))
    ((Err why) (fail_because "opened" why))))

(def test_opened_refused () int
  (match (agent_opened 5 6 7 "error: no port 0")
    ((Ok c) (fail_because "refused" "opened"))
    ((Err why) (check_str "why" why "no port 0"))))

; Under an operating system no agentd is running.
(def test_no_agent () int
  (match (agent_open 1 2)
    ((Ok c) (fail_because "open" "opened"))
    ((Err why) (check_str "why" why "the agent is not running (no /etc/agent/config?)"))))
