; fs_test.l0 -- tests of the fs protocol's encodings.

; The bytes of a message from pid 2 with payload, as fs's reply comes.
(def reply_msg ((payload (list int))) bytes
  (match (message_new 2 payload) ((Message from b) b) ((RecvFailed) (bytes_from_list (nil int)))))

(def test_reply_round_trip () int
  (match (fs_reply_of (reply_msg (fs_reply_bytes -6 "x")))
    ((FsReply w rest) (add (check_int "word" w -6) (check_str "rest" rest "x")))))

; With no kernel there is no fs to ask.
(def test_no_server_to_partition () int
  (add (check_bool "partition" (eq (fs_partition_on 0 "disk0" 100 -1) (FsPartitionRefused -3 "no file server")) true)
       (check_bool "mkfs" (eq (fs_mkfs_on 0 (uuid_nil) "x") (FsMkfsRefused -3 "no file server")) true)))

(def test_reply_short () int
  (match (fs_reply_of (reply_msg "ab"))
    ((FsReply w rest) (check_int "-5" w -5))))

(def test_volume_of () int
  (add (check_str "a file" (fs_volume_of "/Volumes/data/notes") "/Volumes/data")
       (add (check_str "the volume" (fs_volume_of "/Volumes/data") "/Volumes/data")
            (add (check_str "/Volumes" (fs_volume_of "/Volumes") "")
                 (check_str "the initramfs" (fs_volume_of "/etc/motd") "")))))

(def test_port_in () int
  (let ms (cons (MountInfo "/" 0 "") (cons (MountInfo "/Volumes/data" 7 "") (nil MountInfo)))
    (add (check_int "data" (fs_port_in ms "/Volumes/data") 7)
         (add (check_int "none" (fs_port_in ms "/Volumes/x") 0)
              (check_strs "volumes" (fs_volumes_in ms) (cons "/Volumes/data" (nil (list int))))))))

; A UUID, as fs mounts its volumes with them.
(def sys_uuid () (list int) "018f0000-0000-7000-8000-000000000001")

; / the system volume, sys, from port 7; data from the same port, and sys
; itself in /Volumes.
(def switched () (list MountInfo)
  (cons (MountInfo "/" 7 (sys_uuid))
        (cons (MountInfo "/Volumes/data" 7 "018f0000-0000-7000-8000-000000000002")
              (cons (MountInfo "/Volumes/sys" 7 (sys_uuid)) (nil MountInfo)))))

(def test_system_volume () int
  (add (check_str "sys" (fs_system_in (switched)) "/Volumes/sys")
       (add (check_str "none yet" (fs_system_in (cons (MountInfo "/" 0 "") (nil MountInfo))) "")
            (check_strs "volumes, not /" (fs_volumes_in (switched)) (split_spaces "/Volumes/data /Volumes/sys")))))

(def test_server_path () int
  (add (check_str "/etc/motd" (fs_server_path_in "/Volumes/sys" "/etc/motd") "/Volumes/sys/etc/motd")
       (add (check_str "/" (fs_server_path_in "/Volumes/sys" "/") "/Volumes/sys")
            (add (check_str "a volume's" (fs_server_path_in "/Volumes/sys" "/Volumes/data/a") "/Volumes/data/a")
                 (check_str "the initramfs's" (fs_server_path_in "" "/etc/motd") "/etc/motd")))))

(def test_listing_round_trip () int
  (let fs (cons (FsStat "a" 10) (cons (FsStat "notes.txt" 4100) (nil FsStat)))
    (add (check_str "bytes" (fs_listing fs) "a 10\nnotes.txt 4100\n")
         (check_true "read back" (eq (fs_stats_of (fs_listing fs)) fs)))))

(def test_space () int
  (add (check_true "read" (eq (fs_space_of (fs_space_text 1528 190 180 3)) (FsSpace 1528 190 180 3)))
       (check_true "bad" (eq (fs_space_of "1 2") (FsSpaceRefused -5)))))

(def test_rescan_of () int
  (add (check_true "two" (eq (fs_rescan_of (FsReply 2 "data\nscratch\n"))
                             (FsRescanned (cons "data" (cons "scratch" (nil (list int)))))))
       (add (check_true "none" (eq (fs_rescan_of (FsReply 0 "")) (FsRescanned (nil (list int)))))
            (check_true "refused" (eq (fs_rescan_of (FsReply -4 "")) (FsRescanRefused -4))))))

; Under an operating system there is no kernel, so no volume is mounted.
(def test_no_volumes () int
  (add (check_int "none" (length (fs_volumes)) 0)
       (add (check_true "list" (eq (fs_list "/Volumes/data") (FsListRefused -3)))
            (check_int "format" (fs_format "/Volumes/data") -3))))

(def test_kind_of () int
  (add (check_true "a directory" (eq (fs_kind_of "dir") (FsIsDir)))
       (add (check_true "a program" (eq (fs_kind_of "file 120 x") (FsIsFile 120 true)))
            (add (check_true "a file" (eq (fs_kind_of "file 3 -") (FsIsFile 3 false)))
                 (check_true "neither" (eq (fs_kind_of "what") (FsNoKind -5)))))))

; Nor are the requests of one path answered by any server.
(def test_no_path_server () int
  (add (check_int "mkdir" (fs_mkdir "/Volumes/data/a") -3)
       (add (check_true "stat" (eq (fs_stat "/Volumes/data/a") (FsNoKind -3)))
            (check_int "chmod" (fs_chmod "/Volumes/data/a" true) -3))))

; Nor, through a reply port of the caller's, is any volume or fs found.
(def test_no_server () int
  (add (check_int "format" (fs_format_on 7 "/Volumes/data") -3)
       (add (check_true "df" (eq (fs_df_on 7 "/Volumes/data") (FsSpaceRefused -3)))
            (check_true "rescan" (eq (fs_rescan_on 7) (FsRescanRefused -3))))))
