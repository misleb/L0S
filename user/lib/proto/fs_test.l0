; fs_test.l0 -- tests of the fs protocol's encodings.

; The bytes of a message from pid 2 with payload, as fs's reply comes.
(def reply_msg ((payload (list int))) bytes
  (match (message_new 2 payload) ((Message from b) b) ((RecvFailed) (bytes_from_list (nil int)))))

(def test_reply_round_trip () int
  (match (fs_reply_of (reply_msg (fs_reply_bytes -6 "x")))
    ((FsReply w rest) (add (check_int "word" w -6) (check_str "rest" rest "x")))))

; A read's reply, the file's bytes joined to the word, reads back as the
; text one does.
(def test_reply_data_round_trip () int
  (let d (fs_reply_data 3 (bytes_from_list "abc"))
    (add (check_str "as fs_reply_bytes" (bytes_to_list d) (fs_reply_bytes 3 "abc"))
         (match (fs_reply_of (reply_msg (bytes_to_list d)))
           ((FsReply w rest) (add (check_int "word" w 3) (check_str "rest" rest "abc")))))))

; With no kernel there is no fs to ask.
(def test_no_server_to_partition () int
  (add (check_bool "partition" (eq (fs_partition_on 0 "disk0" 100 -1) (FsPartitionRefused -3 "no file server")) true)
       (check_bool "mkfs" (eq (fs_mkfs_on 0 (uuid_nil) "x") (FsMkfsRefused -3 "no file server")) true)))

(def test_reply_short () int
  (match (fs_reply_of (reply_msg "ab"))
    ((FsReply w rest) (check_int "-5" w -5))))

(def test_volume_of () int
  (add (check_str "a file" (fs_volume_of "/Volumes/data/notes") "/Volumes/data")
       (add (check_str "the volume" (fs_volume_of "/Volumes/data") "/Volumes/data")
            (add (check_str "/Volumes" (fs_volume_of "/Volumes") "")
                 (check_str "the initramfs" (fs_volume_of "/etc/motd") "")))))

(def test_port_in () int
  (let ms (cons (MountInfo "/" 0 "") (cons (MountInfo "/Volumes/data" 7 "") (nil MountInfo)))
    (add (check_int "data" (fs_port_in ms "/Volumes/data") 7)
         (add (check_int "none" (fs_port_in ms "/Volumes/x") 0)
              (check_strs "volumes" (fs_volumes_in ms) (cons "/Volumes/data" (nil (list int))))))))

; A UUID, as fs mounts its volumes with them.
(def sys_uuid () (list int) "018f0000-0000-7000-8000-000000000001")

; / the system volume, sys, from port 7; data from the same port, and sys
; itself in /Volumes.
(def switched () (list MountInfo)
  (cons (MountInfo "/" 7 (sys_uuid))
        (cons (MountInfo "/Volumes/data" 7 "018f0000-0000-7000-8000-000000000002")
              (cons (MountInfo "/Volumes/sys" 7 (sys_uuid)) (nil MountInfo)))))

(def test_system_volume () int
  (add (check_str "sys" (fs_system_in (switched)) "/Volumes/sys")
       (add (check_str "none yet" (fs_system_in (cons (MountInfo "/" 0 "") (nil MountInfo))) "")
            (check_strs "volumes, not /" (fs_volumes_in (switched)) (split_spaces "/Volumes/data /Volumes/sys")))))

(def test_server_path () int
  (add (check_str "/etc/motd" (fs_server_path_in "/Volumes/sys" "/etc/motd") "/Volumes/sys/etc/motd")
       (add (check_str "/" (fs_server_path_in "/Volumes/sys" "/") "/Volumes/sys")
            (add (check_str "a volume's" (fs_server_path_in "/Volumes/sys" "/Volumes/data/a") "/Volumes/data/a")
                 (check_str "the initramfs's" (fs_server_path_in "" "/etc/motd") "/etc/motd")))))

(def test_listing_round_trip () int
  (let fs (cons (FsStat "a" 10) (cons (FsStat "notes.txt" 4100) (nil FsStat)))
    (add (check_str "bytes" (fs_listing fs) "a 10\nnotes.txt 4100\n")
         (check_true "read back" (eq (fs_stats_of (fs_listing fs)) fs)))))

; A page holds the lines from the fromth that fit: "a 10\n" is 5 bytes,
; "notes.txt 4100\n" 15, so 19 bytes hold only the first.
(def test_listing_from () int
  (let fs (cons (FsStat "a" 10) (cons (FsStat "notes.txt" 4100) (nil FsStat)))
    (add (check_str "all" (fs_listing_from fs 0 (fs_list_room)) "a 10\nnotes.txt 4100\n")
         (add (check_str "from 1" (fs_listing_from fs 1 (fs_list_room)) "notes.txt 4100\n")
              (check_str "what fits" (fs_listing_from fs 0 19) "a 10\n")))))

; n files named f0, f1, ... of size i each.
(def many_stats ((i int) (n int)) (list FsStat)
  (if (ge i n) (nil FsStat) (cons (FsStat (append "file-number-" (digits i)) i) (many_stats (add i 1) n))))

; The pages of fs's listing from from, read back and joined, as fs_list
; joins them, onto the reversed acc.
(def pages_joined ((fs (list FsStat)) (from int) (acc (list FsStat))) (list FsStat)
  (let page (fs_stats_of (fs_listing_from fs from (fs_list_room)))
    (if (is_empty page)
        (rev acc)
        (pages_joined fs (add from (length page)) (append (rev page) acc)))))

; 500 entries, about 9 KB, more than a message: every page fits, and the
; pages joined are every entry, in order.
(def test_listing_pages () int
  (let fs (many_stats 0 500)
    (add (check_true "a page fits" (le (length (fs_listing_from fs 0 (fs_list_room))) (fs_list_room)))
         (add (check_true "more than one" (lt (length (fs_stats_of (fs_listing_from fs 0 (fs_list_room)))) 500))
              (check_true "joined" (eq (pages_joined fs 0 (nil FsStat)) fs))))))

(def test_space () int
  (add (check_true "read" (eq (fs_space_of (fs_space_text 1528 190 180 3)) (FsSpace 1528 190 180 3)))
       (check_true "bad" (eq (fs_space_of "1 2") (FsSpaceRefused -5)))))

(def test_rescan_of () int
  (add (check_true "two" (eq (fs_rescan_of (FsReply 2 "data\nscratch\n"))
                             (FsRescanned (cons "data" (cons "scratch" (nil (list int)))))))
       (add (check_true "none" (eq (fs_rescan_of (FsReply 0 "")) (FsRescanned (nil (list int)))))
            (check_true "refused" (eq (fs_rescan_of (FsReply -4 "")) (FsRescanRefused -4))))))

; Under an operating system there is no kernel, so no volume is mounted.
(def test_no_volumes () int
  (add (check_int "none" (length (fs_volumes)) 0)
       (add (check_true "list" (eq (fs_list "/Volumes/data") (FsListRefused -3)))
            (check_int "format" (fs_format "/Volumes/data") -3))))

(def test_kind_of () int
  (add (check_true "a directory" (eq (fs_kind_of "dir") (FsIsDir)))
       (add (check_true "a program" (eq (fs_kind_of "file 120 x") (FsIsFile 120 true)))
            (add (check_true "a file" (eq (fs_kind_of "file 3 -") (FsIsFile 3 false)))
                 (check_true "neither" (eq (fs_kind_of "what") (FsNoKind -5)))))))

; Nor are the requests of one path answered by any server.
(def test_no_path_server () int
  (add (check_int "mkdir" (fs_mkdir "/Volumes/data/a") -3)
       (add (check_true "stat" (eq (fs_stat "/Volumes/data/a") (FsNoKind -3)))
            (check_int "chmod" (fs_chmod "/Volumes/data/a" true) -3))))

; Nor, through a reply port of the caller's, is any volume or fs found.
(def test_no_server () int
  (add (check_int "format" (fs_format_on 7 "/Volumes/data") -3)
       (add (check_true "df" (eq (fs_df_on 7 "/Volumes/data") (FsSpaceRefused -3)))
            (check_true "rescan" (eq (fs_rescan_on 7) (FsRescanRefused -3))))))

; The bodies a program sends itself, asking without waiting: paths as
; the server knows them (under l0 test / is no volume, so as they are).
(def test_bodies () int
  (add (check_str "list" (fs_list_body "/Volumes/data/docs" 0) "list /Volumes/data/docs")
       (add (check_str "list from 40" (fs_list_body "/Volumes/data/docs" 40) "list /Volumes/data/docs 40")
            (add (check_str "open" (fs_open_body "/Volumes/data/notes") "open 1 /Volumes/data/notes")
                 (check_str "rename" (fs_rename_body "/Volumes/data/a" "/Volumes/data/b") "rename /Volumes/data/a /Volumes/data/b")))))

(def test_bodies_more () int
  (add (check_str "read" (fs_read_body 5 4092) "read 5 4092")
       (add (check_str "close" (fs_close_body 5) "close 5")
            (add (check_str "stat" (fs_stat_body "/Volumes/data/x") "stat /Volumes/data/x")
                 (add (check_str "remove" (fs_remove_body "/Volumes/data/x") "remove /Volumes/data/x")
                      (check_str "mkdir" (fs_mkdir_body "/Volumes/data/d") "mkdir /Volumes/data/d"))))))

(def test_bodies_volumes () int
  (add (check_str "df" (fs_df_body "/Volumes/data") "df /Volumes/data")
       (add (check_str "format" (fs_format_body "/Volumes/data") "format /Volumes/data")
            (add (check_str "relabel" (fs_relabel_body "/Volumes/data" "notes") "relabel /Volumes/data notes")
                 (add (check_str "partition" (fs_partition_body "disk0" 496 1040) "partition disk0 496 1040")
                      (add (check_str "partition anywhere" (fs_partition_body "disk0" 496 -1) "partition disk0 496")
                           (add (check_str "erase" (fs_erase_body "disk0") "erase disk0")
                                (check_str "mkfs" (fs_mkfs_body (uuid_nil) "made" true) (append "mkfs " (append (uuid_text (uuid_nil)) " made fat32"))))))))))

; A reply taken as a message: its word and words; one that never came
; is -5.
(def test_reply_msg () int
  (add (check_true "came" (eq (fs_reply_msg (message_new 2 (fs_reply_bytes 3 "x"))) (FsReply 3 "x")))
       (check_true "none" (eq (fs_reply_msg (RecvFailed)) (FsReply -5 "")))))

; A read's reply: its count, and its bytes kept from the message in
; place; a refusal's are none, and so are a reply that never came's.
(def test_read_of () int
  (match (fs_read_of (message_new 2 (fs_reply_bytes 3 "abc")))
    ((FsRead w b i j)
      (add (check_int "three" w 3)
           (add (check_str "the bytes" (bytes_to_list (fs_read_piece (FsRead w b i j))) "abc")
                (add (check_int "refused" (match (fs_read_of (message_new 2 (fs_reply_bytes -3 ""))) ((FsRead w2 b2 i2 j2) w2)) -3)
                     (check_int "none" (match (fs_read_of (RecvFailed)) ((FsRead w2 b2 i2 j2) w2)) -5)))))))

; Each reply read as what it said.
(def test_replies_of () int
  (add (check_true "df" (eq (fs_df_of (FsReply 0 (fs_space_text 1528 190 180 3))) (FsSpace 1528 190 180 3)))
       (add (check_true "df refused" (eq (fs_df_of (FsReply -3 "")) (FsSpaceRefused -3)))
            (add (check_true "relabel" (eq (fs_relabel_of (FsReply 0 "notes")) (FsRelabelled "notes")))
                 (add (check_true "erase" (eq (fs_erase_of (FsReply -4 "a file on it is open")) (FsEraseRefused -4 "a file on it is open")))
                      (add (check_true "mkfs" (eq (fs_mkfs_of (FsReply 0 "made")) (FsMade "made")))
                           (check_true "partition, no UUID" (eq (fs_partition_of (FsReply 0 "what")) (FsPartitionRefused -5 "the answer is not a UUID")))))))))

; With no kernel there is no fs, and no port serves any path.
(def test_no_ports () int
  (add (check_int "fs" (fs_main_port) 0)
       (check_int "a path's" (fs_path_port "/Volumes/data/x") 0)))
