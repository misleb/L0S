; display_test.l0 -- tests of the display protocol's client side: reading
; info's reply.

(def info_text ((r (list int))) (list int)
  (match (info_of r)
    ((Some i) (match i ((DisplayInfo w h cursor s)
                (unwords (cons (digits w) (cons (digits h) (cons (if cursor "cursor" "none") (cons (digits s) (nil (list int))))))))))
    ((None) "none")))

(def test_info_scaled () int
  (check_str "a 4K screen at 2" (info_text "display 3840 2160 cursor scale 2") "3840 2160 cursor 2"))

; A driver that says nothing of a scale means 1.
(def test_info_unscaled () int
  (add (check_str "no scale" (info_text "display 1280 800 cursor") "1280 800 cursor 1")
       (check_str "no cursor" (info_text "display 1280 800") "1280 800 none 1")))

(def test_info_odd_scale () int
  (check_str "scale 3 is 1" (info_text "display 1280 800 cursor scale 3") "1280 800 cursor 1"))

(def test_info_error () int
  (check_str "an error" (info_text "error: no screen") "none"))

; At scale 2 a layer's place and top row are the screen's, twice as far.
(def test_placed_scaled () int
  (check_strs "doubled"
    (numbers_words (placed_nums (cons (Placed 4 10 20 3) (nil Placed)) 2))
    (split_spaces "4 20 40 6")))

(def test_placed_unscaled () int
  (check_strs "as given"
    (numbers_words (placed_nums (cons (Placed 4 10 20 3) (nil Placed)) 1))
    (split_spaces "4 10 20 3")))

(def test_dirty_scaled () int
  (check_strs "each rectangle doubled"
    (numbers_words (dirty_nums (cons (Dirty 2 (Rect 1 2 3 4)) (nil Dirty)) 2 (nil int)))
    (split_spaces "2 2 4 6 8")))

(def test_scale_of_display () int
  (add (check_int "set" (display_scale (display_at_scale (Display 1 2 3 1) 2)) 2)
       (check_int "none" (display_scale (NoDisplay "x")) 1)))
