; wm_test.l0 -- tests of the compositor's protocol, client side: hello's
; reply and the scale it says.

(def scale_or ((r (list int))) int (match (hello_scale r) ((Some s) s) ((None) 0)))

(def test_hello_scaled () int
  (check_int "scale 2" (scale_or "compositor scale 2") 2))

; A compositor that says nothing of a scale means 1.
(def test_hello_plain () int
  (add (check_int "compositor" (scale_or "compositor") 1)
       (check_int "an odd scale" (scale_or "compositor scale 7") 1)))

(def test_hello_not_one () int
  (check_int "an error" (scale_or "error: busy") 0))

(def test_scale_of_none () int
  (check_int "no compositor" (compositor_scale (NoCompositor "gone")) 1))

; No compositor: a frame cannot be asked, and says why.
(def test_frame_no_compositor () int
  (check_true "refused" (not (is_empty (window_frame (NoCompositor "gone") 3)))))
