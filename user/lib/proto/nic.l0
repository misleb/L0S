; nic.l0 -- the nic protocol, as a client of it sends it: what a network
; driver, user/sbin/virtio-net here, serves on the port it registers as
; nic; and Ethernet addresses, as text.
;
;   info                    nic MAC: the card's Ethernet address, as six
;                           hex pairs with colons
;   stats                   rx N tx N dropped N: frames taken from the
;                           wire and put on it, and those lost
;   listen                  ok: every frame taken from now on comes to
;                           the reply port as a frame notice
;   send                    and then, after a space, an Ethernet frame,
;                           without its check sequence: put on the wire.
;                           Answered only if the request names a reply
;                           port, with ok or why not
;
; Each is a request (l0s.l0); the reply is as said above, or error: WHY.
; A frame notice is frm and then the frame, 14 to 1514 bytes. A frame fits
; in a message, so frames travel in messages, not shared pages. Linked
; into the driver and the stack, by the Makefile's NICLIB.

; The fewest and the most bytes a frame has: its header, and that and
; 1500 bytes of payload.
(def frame_min () int 14)
(def frame_max () int 1514)

; The notice that a frame came, as the driver sends it to each listener.
(def frame_notice ((frame (list int))) (list int) (append "frm" frame))

; The frame payload holds, or none if it is not a frame notice.
(def frame_of ((payload (list int))) (Option (list int))
  (if (if (starts_with payload "frm") (ge (length payload) (add 3 (frame_min))) false)
      (Some (drop_n payload 3))
      ((None (list int)))))

; send's request body for frame.
(def nic_send_body ((frame (list int))) (list int) (append "send " frame))

; The frame a send's body holds, or none if it is not one.
(def nic_sent_frame ((body (list int))) (Option (list int))
  (if (starts_with body "send ") (Some (drop_n body 5)) ((None (list int)))))

; ---------------------------------------------------------------- addresses

; An Ethernet address, six bytes, as hex pairs with colons: 52:54:00:12:34:56.
(def mac_text ((m (list int))) (list int)
  (join_with ":" (mac_pairs m (nil (list int)))))

; Each byte of m as two hex digits, after acc, reversed.
(def mac_pairs ((m (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty m) (rev acc) (mac_pairs (tail m) (cons (hex_digits (head m) 2) acc))))

; The six bytes s writes as hex pairs with colons, or none.
(def mac_parse ((s (list int))) (Option (list int))
  (let parts (split_on 58 s)
    (if (eq (length parts) 6) (mac_parts parts (nil int)) ((None (list int))))))

; The rest of mac_parse: each of parts two hex digits, after acc, reversed.
(def mac_parts ((parts (list (list int))) (acc (list int))) (Option (list int))
  (if (is_empty parts)
      (Some (rev acc))
      (let p (head parts)
        (if (if (eq (length p) 2) (if (ge (hex_val (head p)) 0) (ge (hex_val (head (tail p))) 0) false) false)
            (mac_parts (tail parts) (cons (add (mul 16 (hex_val (head p))) (hex_val (head (tail p)))) acc))
            ((None (list int)))))))

; ff:ff:ff:ff:ff:ff, every card on the link.
(def mac_broadcast () (list int) (repeat 6 255))

; The address info's answer gives, or none if it is not that answer.
(def nic_info_of ((r (list int))) (Option (list int))
  (let ws (split_spaces r)
    (if (if (eq (length ws) 2) (eq (head ws) "nic") false)
        (mac_parse (nth ws 1))
        ((None (list int))))))
