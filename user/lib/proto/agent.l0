; agent.l0 -- the agent protocol, as agentd serves it, and its client,
; as the agent command uses it. agentd registers as agent; each is a
; request (l0s.l0's), its answer to the request's reply port:
;
;   open NPORT          conv ID: a conversation, its notices to NPORT
;   say ID\nTEXT        ok, its answer streamed to NPORT as notices; or
;                       error: busy while a turn of any conversation runs
;   stop ID             ok: its turn ended, told as done stopped
;   close ID            ok: the conversation gone
;
; and the notices, to NPORT, each a header line, and after a newline
; what it tells, as bytes:
;
;   agent ID text\nPIECE              a piece of the answer, at most
;                                     agent_piece_max bytes
;   agent ID tool NAME\nINPUT         a tool run, its input's JSON, cut
;                                     to agent_brief_max bytes
;   agent ID result NAME ok|failed\nTEXT
;                                     its result, the start of it
;   agent ID compacted BEFORE AFTER   the conversation compacted, its
;                                     tokens before and after
;   agent ID done REASON              the turn over, and why
;   agent ID error\nWHY               what went wrong, before done
;
; Linked into agentd and agent, as the Makefile's AGENTLIB.

; What a notice tells, its conversation's ID first: a piece of text; a
; tool, its name and input; a result, the tool's name, whether it failed,
; and its text; that the conversation was compacted, tokens before and
; after; the turn done, and why; an error, why; or that the message is
; no notice.
(data AgentEvent
  (AgentText int bytes)
  (AgentTool int (list int) bytes)
  (AgentResult int (list int) bool bytes)
  (AgentCompacted int int int)
  (AgentDone int (list int))
  (AgentError int bytes)
  (AgentNone))

; The most bytes of text one notice holds, and of a tool's input or
; result told.
(def agent_piece_max () int 4000)
(def agent_brief_max () int 1024)

; ------------------------------------------------------------- notices

; A notice: its header, agent ID WORDS, and if body is given, a newline
; and body.
(def agent_notice ((id int) (words (list int)) (body (Option bytes))) bytes
  (let head (append "agent " (append (digits id) (cons 32 words)))
    (match body
      ((None) (bytes_from_list head))
      ((Some b) (bytes_concat (cons (bytes_from_list (append head "\n")) (cons b (nil bytes))))))))

; The notices of each kind, as agentd sends them; their bodies already
; cut as the protocol says.
(def agent_text_notice ((id int) (piece bytes)) bytes (agent_notice id "text" (Some piece)))
(def agent_tool_notice ((id int) (name (list int)) (input bytes)) bytes
  (agent_notice id (append "tool " name) (Some input)))
(def agent_result_notice ((id int) (name (list int)) (failed bool) (text bytes)) bytes
  (agent_notice id (append "result " (append name (if failed " failed" " ok"))) (Some text)))
(def agent_compacted_notice ((id int) (before int) (after int)) bytes
  (agent_notice id (append "compacted " (append (digits before) (cons 32 (digits after)))) ((None bytes))))
(def agent_done_notice ((id int) (reason (list int))) bytes
  (agent_notice id (append "done " reason) ((None bytes))))
(def agent_error_notice ((id int) (why bytes)) bytes (agent_notice id "error" (Some why)))

; The first newline in a message's bytes b from i on, or its end.
(def agent_line_end ((b bytes) (i int)) int
  (if (ge i (bytes_len b)) i (eq (bytes_get b i) 10) i (agent_line_end b (add i 1))))

; The notice in a message's bytes b, read in place but for its header,
; or AgentNone if it is not one.
(def agent_event_of ((b bytes)) AgentEvent
  (if (not (msg_starts b "agent "))
      (AgentNone)
      (let (e (agent_line_end b 4)
            ws (split_spaces (bytes_to_list (bytes_slice b 10 e)))
            body (bytes_slice b (min (add e 1) (bytes_len b)) (bytes_len b)))
        (if (or (is_empty ws) (not (is_number (head ws))))
            (AgentNone)
            (agent_event_words (int_prefix (head ws) 0) (tail ws) body)))))

; The rest of agent_event_of: the notice of conversation id, the words
; after its ID, and its body.
(def agent_event_words ((id int) (ws (list (list int))) (body bytes)) AgentEvent
  (if (is_empty ws)
      (AgentNone)
      (let (kind (head ws) n (length ws))
        (if (and (eq kind "text") (eq n 1)) (AgentText id body)
            (and (eq kind "tool") (eq n 2)) (AgentTool id (nth ws 1) body)
            (and (eq kind "result") (eq n 3)) (AgentResult id (nth ws 1) (eq (nth ws 2) "failed") body)
            (and (eq kind "done") (eq n 2)) (AgentDone id (nth ws 1))
            (and (eq kind "error") (eq n 1)) (AgentError id body)
            (and (eq kind "compacted") (eq n 3)) (agent_compacted_of id (nth ws 1) (nth ws 2))
            (AgentNone)))))

; A compacted notice's counts, if they are numbers.
(def agent_compacted_of ((id int) (before (list int)) (after (list int))) AgentEvent
  (if (and (is_number before) (is_number after))
      (AgentCompacted id (int_prefix before 0) (int_prefix after 0))
      (AgentNone)))

; ------------------------------------------------------------- requests

; The requests' bodies, as agentd reads them.
(def agent_open_body ((nport int)) (list int) (append "open " (digits nport)))
(def agent_say_body ((id int) (text (list int))) (list int) (append "say " (append (digits id) (cons 10 text))))
(def agent_stop_body ((id int)) (list int) (append "stop " (digits id)))
(def agent_close_body ((id int)) (list int) (append "close " (digits id)))

; ---------------------------------------------------------- the client

; A conversation with agentd: its port, the port its answers come back
; to, the conversation's ID, and agentd's pid, which sends its notices.
(data AgentConv (AgentConv (p int) (rp int) (id int) (pid int)))

; How long the client waits for agentd to register: it waits for its
; home's volume first.
(def agent_wait_ns () int 15000000000)

; A conversation opened with agentd, its answers to rp and its notices
; to nport, both this process's: or why not.
(def agent_open ((rp int) (nport int)) (Result AgentConv (list int))
  (match (name_wait "agent" (agent_wait_ns))
    ((NotFound) ((Err AgentConv (list int)) "the agent is not running (no /etc/agent/config?)"))
    ((Found port)
      (match (port_ask port rp (agent_open_body nport) "the agent")
        ((AskFailed why) ((Err AgentConv (list int)) why))
        ((Asked from b) (agent_opened port rp from (msg_text b)))))))

; What open's answer a, from pid, says.
(def agent_opened ((port int) (rp int) (pid int) (a (list int))) (Result AgentConv (list int))
  (let ws (split_spaces a)
    (if (and (eq (length ws) 2) (and (eq (head ws) "conv") (is_number (nth ws 1))))
        ((Ok AgentConv (list int)) (AgentConv port rp (int_prefix (nth ws 1) 0) pid))
        ((Err AgentConv (list int)) (agent_why a)))))

; Why an answer is not what was asked: error: WHY's WHY, or the answer.
(def agent_why ((a (list int))) (list int)
  (if (starts_with a "error: ") (drop_n a 7) (append "the agent said " a)))

; body asked of c's agentd: empty if it answered ok, else why not.
(def agent_ask ((c AgentConv) (body (list int))) (list int)
  (match c
    ((AgentConv port rp id pid)
      (match (port_ask port rp body "the agent")
        ((AskFailed why) why)
        ((Asked from b) (if (msg_is b "ok") (nil int) (agent_why (msg_text b))))))))

; text said in c, stopped, and c closed: empty, or why not.
(def agent_say ((c AgentConv) (text (list int))) (list int) (agent_ask c (agent_say_body (.id c) text)))
(def agent_stop ((c AgentConv)) (list int) (agent_ask c (agent_stop_body (.id c))))
(def agent_close ((c AgentConv)) (list int) (agent_ask c (agent_close_body (.id c))))
