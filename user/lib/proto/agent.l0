; agent.l0 -- the agent protocol, as agentd serves it, and its client,
; as the agent command uses it. agentd holds one conversation, which
; every client shares, and registers as agent; each is a request
; (l0s.l0's), its answer to the request's reply port:
;
;   open NPORT          ok: the conversation so far told to NPORT, as
;                       the notices below would have told it, then
;                       opened; and its notices to NPORT too from then
;   say SOURCE\nTEXT    ok, said told to every NPORT, and the answer
;                       streamed as notices; or error: busy while a
;                       turn runs. SOURCE, a word, says where the text
;                       came from (console, app, speech...); with no
;                       SOURCE it is the sending program's name. The
;                       model is told it, and the program that sent it
;   stop                ok: the turn running ended, told as done stopped
;   clear               ok: the conversation begun anew; or error: busy
;   close NPORT         ok: NPORT told no more
;
; and the notices, to each NPORT open, each a header line, and after a
; newline what it tells, as bytes:
;
;   agent text\nPIECE              a piece of the answer, at most
;                                  agent_piece_max bytes
;   agent tool NAME\nINPUT         a tool run, its input's JSON, cut to
;                                  agent_brief_max bytes
;   agent progress NAME\nTEXT     how a tool still running is going,
;                                  a line (build_app's builder)
;   agent result NAME ok|failed\nTEXT
;                                  its result, the start of it
;   agent compacted BEFORE AFTER   the conversation compacted, its
;                                  tokens before and after
;   agent done REASON              the turn over, and why
;   agent error\nWHY               what went wrong, before done
;   agent said SOURCE\nTEXT        what the person said, and where it
;                                  came from, a turn begun (or, told
;                                  the conversation so far, one that
;                                  was)
;   agent opened busy|idle         the conversation so far told, to the
;                                  port that opened, and whether a turn
;                                  is running
;   agent image\nPATH              an image to show the person, a PNG
;                                  at PATH (an app's preview, or one
;                                  the model chose)
;
; Linked into agentd and agent, as the Makefile's AGENTLIB.

; What a notice tells: a piece of text; a tool, its name and input; how
; a tool running is going, its name and a line; a result, the tool's
; name, whether it failed, and its text; that the conversation was
; compacted, tokens before and after; the turn done, and why; an error,
; why; where what the person said came from, and what they said; the
; conversation so far told, and whether a turn is running; an image to
; show, its path; or that the message is no notice.
(data AgentEvent
  (AgentText bytes)
  (AgentTool (list int) bytes)
  (AgentProgress (list int) bytes)
  (AgentResult (list int) bool bytes)
  (AgentCompacted int int)
  (AgentDone (list int))
  (AgentError bytes)
  (AgentSaid (list int) bytes)
  (AgentOpened bool)
  (AgentImage bytes)
  (AgentNone))

; The most bytes of text one notice holds, and of a tool's input or
; result told.
(def agent_piece_max () int 4000)
(def agent_brief_max () int 1024)

; ------------------------------------------------------------- notices

; A notice: its header, agent WORDS, and if body is given, a newline and
; body.
(def agent_notice ((words (list int)) (body (Option bytes))) bytes
  (let head (append "agent " words)
    (match body
      ((None) (bytes_from_list head))
      ((Some b) (bytes_concat (cons (bytes_from_list (append head "\n")) (cons b (nil bytes))))))))

; The notices of each kind, as agentd sends them; their bodies already
; cut as the protocol says.
(def agent_text_notice ((piece bytes)) bytes (agent_notice "text" (Some piece)))
(def agent_tool_notice ((name (list int)) (input bytes)) bytes
  (agent_notice (append "tool " name) (Some input)))
(def agent_progress_notice ((name (list int)) (text bytes)) bytes
  (agent_notice (append "progress " name) (Some text)))
(def agent_result_notice ((name (list int)) (failed bool) (text bytes)) bytes
  (agent_notice (append "result " (append name (if failed " failed" " ok"))) (Some text)))
(def agent_compacted_notice ((before int) (after int)) bytes
  (agent_notice (append "compacted " (append (digits before) (cons 32 (digits after)))) ((None bytes))))
(def agent_done_notice ((reason (list int))) bytes
  (agent_notice (append "done " reason) ((None bytes))))
(def agent_error_notice ((why bytes)) bytes (agent_notice "error" (Some why)))
(def agent_said_notice ((source (list int)) (text bytes)) bytes
  (agent_notice (append "said " source) (Some text)))
(def agent_opened_notice ((busy bool)) bytes
  (agent_notice (if busy "opened busy" "opened idle") ((None bytes))))
(def agent_image_notice ((path bytes)) bytes (agent_notice "image" (Some path)))

; The first newline in a message's bytes b from i on, or its end.
(def agent_line_end ((b bytes) (i int)) int
  (if (ge i (bytes_len b)) i (eq (bytes_get b i) 10) i (agent_line_end b (add i 1))))

; The notice in a message's bytes b, read in place but for its header,
; or AgentNone if it is not one.
(def agent_event_of ((b bytes)) AgentEvent
  (if (not (msg_starts b "agent "))
      (AgentNone)
      (let (e (agent_line_end b 4)
            ws (split_spaces (bytes_to_list (bytes_slice b 10 e)))
            body (bytes_slice b (min (add e 1) (bytes_len b)) (bytes_len b)))
        (agent_event_words ws body))))

; The rest of agent_event_of: the notice of the words after agent, and
; its body.
(def agent_event_words ((ws (list (list int))) (body bytes)) AgentEvent
  (if (is_empty ws)
      (AgentNone)
      (let (kind (head ws) n (length ws))
        (if (and (eq kind "text") (eq n 1)) (AgentText body)
            (and (eq kind "tool") (eq n 2)) (AgentTool (nth ws 1) body)
            (and (eq kind "progress") (eq n 2)) (AgentProgress (nth ws 1) body)
            (and (eq kind "result") (eq n 3)) (AgentResult (nth ws 1) (eq (nth ws 2) "failed") body)
            (and (eq kind "done") (eq n 2)) (AgentDone (nth ws 1))
            (and (eq kind "error") (eq n 1)) (AgentError body)
            (and (eq kind "image") (eq n 1)) (AgentImage body)
            (and (eq kind "said") (eq n 2)) (AgentSaid (nth ws 1) body)
            (and (eq kind "opened") (and (eq n 2) (or (eq (nth ws 1) "busy") (eq (nth ws 1) "idle")))) (AgentOpened (eq (nth ws 1) "busy"))
            (and (eq kind "compacted") (eq n 3)) (agent_compacted_of (nth ws 1) (nth ws 2))
            (AgentNone)))))

; A compacted notice's counts, if they are numbers.
(def agent_compacted_of ((before (list int)) (after (list int))) AgentEvent
  (if (and (is_number before) (is_number after))
      (AgentCompacted (int_prefix before 0) (int_prefix after 0))
      (AgentNone)))

; ------------------------------------------------------------- requests

; The requests' bodies, as agentd reads them.
(def agent_open_body ((nport int)) (list int) (append "open " (digits nport)))
(def agent_say_body ((source (list int)) (text (list int))) (list int)
  (append "say " (append source (cons 10 text))))
(def agent_stop_body () (list int) "stop")
(def agent_clear_body () (list int) "clear")
(def agent_close_body ((nport int)) (list int) (append "close " (digits nport)))

; ---------------------------------------------------------- the client

; The conversation, as a client holds it: agentd's port, the port its
; answers come back to, the port its notices come to, and agentd's pid,
; which sends them.
(data AgentConv (AgentConv (p int) (rp int) (np int) (pid int)))

; How long the client waits for agentd to register: it waits for its
; home's volume first.
(def agent_wait_ns () int 15000000000)

; The conversation opened with agentd, its answers to rp and its notices
; to nport, both this process's: or why not.
(def agent_open ((rp int) (nport int)) (Result AgentConv (list int))
  (match (name_wait "agent" (agent_wait_ns))
    ((NotFound) ((Err AgentConv (list int)) "the agent is not running (no /etc/agent/config?)"))
    ((Found port)
      (match (port_ask port rp (agent_open_body nport) "the agent")
        ((AskFailed why) ((Err AgentConv (list int)) why))
        ((Asked from b) (agent_opened port rp nport from (msg_text b)))))))

; What open's answer a, from pid, says.
(def agent_opened ((port int) (rp int) (nport int) (pid int) (a (list int))) (Result AgentConv (list int))
  (if (eq a "ok")
      ((Ok AgentConv (list int)) (AgentConv port rp nport pid))
      ((Err AgentConv (list int)) (agent_why a))))

; Why an answer is not what was asked: error: WHY's WHY, or the answer.
(def agent_why ((a (list int))) (list int)
  (if (starts_with a "error: ") (drop_n a 7) (append "the agent said " a)))

; body asked of c's agentd: empty if it answered ok, else why not.
(def agent_ask ((c AgentConv) (body (list int))) (list int)
  (match (port_ask (.p c) (.rp c) body "the agent")
    ((AskFailed why) why)
    ((Asked from b) (if (msg_is b "ok") (nil int) (agent_why (msg_text b))))))

; text said, from source, the turn stopped, the conversation cleared,
; and c's notices ended: empty, or why not.
(def agent_say ((c AgentConv) (source (list int)) (text (list int))) (list int) (agent_ask c (agent_say_body source text)))
(def agent_stop ((c AgentConv)) (list int) (agent_ask c (agent_stop_body)))
(def agent_clear ((c AgentConv)) (list int) (agent_ask c (agent_clear_body)))
(def agent_close ((c AgentConv)) (list int) (agent_ask c (agent_close_body (.np c))))
