; display_server_test.l0 -- tests of what every display driver reads from
; its requests and answers alike.

; ---------------------------------------------------------------- layers

(def test_layers_of () int
  (check_int "two layers" (length (layers_of (cons 0 (cons 0 (cons 0 (cons 0 (cons 1 (cons 5 (cons 6 (cons 2 (nil int))))))))) (nil Layer))) 2))

; ------------------------------------------------------------- wallpaper

; The layers' ids, bottom first, as text.
(def ids_text ((ls (list Layer))) (list int)
  (if (is_empty ls)
      ""
      (match (head ls) ((Layer id x y top) (append (digits id) (append " " (ids_text (tail ls))))))))

; While shown, the wallpaper is under every client's layer; once gone,
; it is not, even where a client names it.
(def test_wall_under () int
  (let ls (cons (Layer 0 0 0 0) (cons (Layer (wall_id) 0 0 0) (cons (Layer 4 10 10 0) (nil Layer))))
    (add (check_str "shown" (ids_text (wall_under ls true)) "1000001 0 4 ")
         (check_str "gone" (ids_text (wall_under ls false)) "0 4 "))))

; A screen 1280 by 800 is covered by a square buffer of its size at 0,
; 0, or larger and further up and left; not by one a pixel short, moved
; a pixel in, or rounded.
(def test_layer_covers () int
  (add (check_bool "the desktop" (layer_covers 0 0 1280 800 true 1280 800) true)
       (add (check_bool "larger" (layer_covers -5 -5 1300 900 true 1280 800) true)
            (add (check_bool "short" (layer_covers 0 0 1279 800 true 1280 800) false)
                 (add (check_bool "moved in" (layer_covers 0 1 1280 800 true 1280 800) false)
                      (check_bool "rounded" (layer_covers 0 0 1280 800 false 1280 800) false))))))

; Clients' ids are 0 to 1000000, below the wallpaper's.
(def test_buffer_id_ok () int
  (add (check_bool "0" (buffer_id_ok 0) true)
       (add (check_bool "the largest" (buffer_id_ok 1000000) true)
            (add (check_bool "the wallpaper's" (buffer_id_ok (wall_id)) false)
                 (check_bool "negative" (buffer_id_ok -1) false)))))

(def test_in_layers () int
  (add (check_bool "the window" (in_layers (cons (Layer 0 0 0 0) (cons (Layer 1 1 0 0) (nil Layer))) 1) true)
       (check_bool "not on the screen" (in_layers (cons (Layer 0 0 0 0) (nil Layer)) 1) false)))

; --------------------------------------------------------------- buffers

(def test_buffer_args () int
  (add (check_int "no pages given" (buffer_pages_arg (split_numbers "3 64 64 4096")) 0)
       (add (check_int "pages given" (buffer_pages_arg (split_numbers "3 64 64 4096 9")) 9)
            (check_int "the width for a stride" (buffer_stride_arg (split_numbers "3 64 64 4096 9")) 64))))

(def test_buffer_stride_arg () int
  (check_int "a stride given" (buffer_stride_arg (split_numbers "3 64 64 4096 9 128")) 128))

(def test_buffer_pages_by_stride () int
  (add (check_int "rows 1024 apart, 2 of them" (buffer_shared_pages 1024 2 0) 2)
       (check_int "or what was shared" (buffer_shared_pages 1024 2 5) 5)))

; The numbers of a request's words, as request_numbers gives them.
(def split_numbers ((s (list int))) (list int) (numbers_of (split_spaces s) (nil int)))

(def numbers_of ((ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws)
      (rev acc)
      (numbers_of (tail ws) (match (word_number (head ws)) ((Some n) (cons n acc)) ((None) acc)))))

; ---------------------------------------------------------------- shapes

(def test_fits_radius () int
  (add (check_bool "half the width" (corners_fit (Corners 15 0 0 15) 30 40) true)
       (add (check_bool "more than half the height" (corners_fit (Corners 0 11 0 0) 40 21) false)
            (check_bool "negative" (corners_fit (Corners 0 0 -1 0) 40 40) false))))

; ---------------------------------------------------------------- damage

(def test_clipped () int
  (let ks (clipped (cons (Rect -5 -5 10 10) (cons (Rect 50 50 4 4) (nil Rect))) 20 20 (nil Rect))
    (add (check_int "one left" (length ks) 1)
         (check_bool "cut to the screen" (eq (head ks) (Rect 0 0 5 5)) true))))

; ----------------------------------------------------------------- scale

(def test_scale_4k () int
  (check_int "3840 by 2160" (scale_of 3840 2160 (nil (list int))) 2))

(def test_scale_default () int
  (add (check_int "1280 by 800" (scale_of 1280 800 (nil (list int))) 1)
       (check_int "1920 by 1080" (scale_of 1920 1080 (nil (list int))) 1)))

(def test_scale_edges () int
  (add (check_int "2560 by 1440" (scale_of 2560 1440 (nil (list int))) 2)
       (add (check_int "2559 by 1440" (scale_of 2559 1440 (nil (list int))) 1)
            (check_int "2560 by 1080" (scale_of 2560 1080 (nil (list int))) 1))))

(def test_scale_arg () int
  (add (check_int "scale=1 at 4K" (scale_of 3840 2160 (split_spaces "root=x scale=1")) 1)
       (check_int "scale=2 at 1280 by 800" (scale_of 1280 800 (split_spaces "scale=2")) 2)))

(def test_scale_arg_refused () int
  (add (check_int "scale=3" (scale_arg (split_spaces "scale=3")) 0)
       (check_int "scale=" (scale_arg (split_spaces "scale=")) 0)))

(def test_info_reply () int
  (check_str "info" (info_reply 3840 2160 2) "display 3840 2160 cursor scale 2"))
