; clock.l0 -- the clock protocol, as rtc clock serves it and a client of
; it, such as wm, reads it; and the time of day, as wm's top bar shows it.
;
;   listen      time S, the reply, then time S again to the request's
;               reply port at the start of every minute from then on
;   time        time S, once
;
; S is the PL031's count of seconds from 1970-01-01 00:00. QEMU sets it
; from the host's clock, as local time when booted with -rtc
; base=localtime, as tools/qemu-boot.sh boots it. L0S has no time zones,
; so the count is shown as it is. Linked into rtc and wm, by the
; Makefile's LIBS_ lists.

; The time s as the clock sends it: time S.
(def time_notice ((s int)) (list int) (append "time " (digits s)))

; The seconds a time notice holds, or none if payload is not one.
(def time_of ((payload (list int))) (Option int)
  (if (starts_with payload "time ")
      (let ds (drop_n payload 5)
        (if (is_number ds) (Some (int_prefix ds 0)) ((None int))))
      ((None int))))

; The start of the minute after s.
(def next_minute ((s int)) int (add (sub s (mod s 60)) 60))

; ------------------------------------------------------------ the date

; A day: its year, month from 1, and day of the month from 1.
(data Civil (Civil int int int))

; The day days after 1970-01-01, days 0 or more, in the Gregorian
; calendar: Howard Hinnant's civil_from_days, counted from 0000-03-01 so
; that February, and its leap day, end each year.
(def civil ((days int)) Civil
  (let z (add days 719468)
    (let era (div z 146097)
      (let doe (sub z (mul era 146097))
        (let yoe (div (sub (add (sub doe (div doe 1460)) (div doe 36524)) (div doe 146096)) 365)
          (let doy (sub doe (sub (add (mul 365 yoe) (div yoe 4)) (div yoe 100)))
            (let mp (div (add (mul 5 doy) 2) 153)
              (let d (add (sub doy (div (add (mul 153 mp) 2) 5)) 1)
                (let m (if (lt mp 10) (add mp 3) (sub mp 9))
                  (Civil (add (add yoe (mul era 400)) (if (le m 2) 1 0)) m d))))))))))

; Month m's short name, Jan for 1 to Dec for 12; empty for any other.
(def month_name ((m int)) (list int)
  (nth_or (split_spaces "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec") (sub m 1) ""))

; n as two digits, 0 to 99.
(def two_digits ((n int)) (list int) (pad_left_with 48 (digits n) 2))

; The time of day s seconds into it, on a 24-hour clock: 22:42.
(def hh_mm ((s int)) (list int)
  (append (two_digits (div s 3600)) (cons 58 (two_digits (div (mod s 3600) 60)))))

; S as the top bar shows it, as GNOME's does by default: the month, the
; day, and the time, Oct 15  22:42. S is 0 or more.
(def clock_text ((s int)) (list int)
  (match (civil (div s 86400))
    ((Civil y m d) (append (month_name m) (append " " (append (digits d) (append "  " (hh_mm (mod s 86400)))))))))
