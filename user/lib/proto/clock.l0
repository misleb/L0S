; clock.l0 -- the clock protocol, as rtc clock serves it and a client of
; it, such as wm, reads it; the zone it is shown in; and the time of day,
; as wm's top bar shows it.
;
;   listen      time S, the reply, then time S again to the request's
;               reply port at the start of every minute from then on
;   time        time S, once
;   set S       ok: the clock says S from now on, and each listener is
;               told time S at once; on the Pi 5 the RTC is set to it too
;   zone        zone M U: the zone in force now, M minutes east of UTC
;               (-480 for PST, -420 for PDT), until the clock says U,
;               when it next changes and the client asks again
;
; S is the board's count of seconds from 1970-01-01 00:00 UTC, a
; PL031's or the Pi 5's RTC's, moved by the last set: QEMU is booted
; with -rtc base=utc, and ntp sets the clock to UTC. The zone is rtc
; clock's, in one place for every client: US Pacific time for now.
; Linked into rtc, wm, fs, inet, ntp, eeprom, agent and agentd, by the
; Makefile's LIBS_ lists.

; The time s as the clock sends it: time S.
(def time_notice ((s int)) (list int) (append "time " (digits s)))

; The seconds a time notice holds, or none if payload is not one.
(def time_of ((payload (list int))) (Option int)
  (if (starts_with payload "time ")
      (let ds (drop_n payload 5)
        (if (is_number ds) (Some (int_prefix ds 0)) ((None int))))
      ((None int))))

; The request setting the clock to s: set S.
(def clock_set_body ((s int)) (list int) (append "set " (digits s)))

; The seconds a set request's body holds, 0 or more, or none if body is
; not one.
(def clock_set_of ((body (list int))) (Option int)
  (if (starts_with body "set ")
      (let ds (drop_n body 4)
        (if (is_number ds) (Some (int_prefix ds 0)) ((None int))))
      ((None int))))

; The clock at port set to s, its answer to rp: empty once it is, or why
; not.
(def clock_set ((port int) (rp int) (s int)) (list int)
  (reply_why (asked_reply (port_ask port rp (clock_set_body s) "the clock")) "the clock"))

; The start of the minute after s.
(def next_minute ((s int)) int (add (sub s (mod s 60)) 60))

; ------------------------------------------------------------ the zone

; A zone in force: how many minutes east of UTC its time is, negative
; west of it, and until when, as the clock counts, when it changes.
(data ClockZone (ClockZone (minutes int) (until int)))

; A count past any the clock will reach, some 31 million years on: a
; zone until then never changes.
(def zone_never () int 1000000000000000)

; UTC, which never changes: the zone with no clock to ask.
(def zone_utc () ClockZone (ClockZone 0 (zone_never)))

; The zone z as the clock answers zone: zone M U.
(def zone_notice ((z ClockZone)) (list int)
  (append "zone " (append (digits (.minutes z)) (cons 32 (digits (.until z))))))

; The zone a zone answer holds, or none if payload is not one.
(def zone_of ((payload (list int))) (Option ClockZone)
  (let ws (split_spaces payload)
    (if (and (eq (length ws) 3) (eq (head ws) "zone"))
        (match (word_numbers (tail ws))
          ((Some ns) (Some (ClockZone (head ns) (head (tail ns)))))
          ((None) ((None ClockZone))))
        ((None ClockZone)))))

; The zone the clock at port says is in force, its answer to rp; UTC if
; it gives none.
(def clock_zone ((port int) (rp int)) ClockZone
  (match (zone_of (asked_reply (port_ask port rp "zone" "the clock")))
    ((Some z) z)
    ((None) (zone_utc))))

; Whether z still holds when the clock says s.
(def zone_holds ((z ClockZone) (s int)) bool (lt s (.until z)))

; The time of day in z when the clock says s, as seconds counted the
; same way: what clock_text shows.
(def zone_local ((z ClockZone) (s int)) int (add s (mul (.minutes z) 60)))

; ------------------------------------------------------------ the date

; A day: its year, month from 1, and day of the month from 1.
(data Civil (Civil int int int))

; The day days after 1970-01-01, days 0 or more, in the Gregorian
; calendar: Howard Hinnant's civil_from_days, counted from 0000-03-01 so
; that February, and its leap day, end each year.
(def civil ((days int)) Civil
  (let (z (add days 719468)
        era (div z 146097)
        doe (sub z (mul era 146097))
        yoe (div (sub (add (sub doe (div doe 1460)) (div doe 36524)) (div doe 146096)) 365)
        doy (sub doe (sub (add (mul 365 yoe) (div yoe 4)) (div yoe 100)))
        mp (div (add (mul 5 doy) 2) 153)
        d (add (sub doy (div (add (mul 153 mp) 2) 5)) 1)
        m (if (lt mp 10) (add mp 3) (sub mp 9)))
    (Civil (add (add yoe (mul era 400)) (if (le m 2) 1 0)) m d)))

; Month m's short name, Jan for 1 to Dec for 12; empty for any other.
(def month_name ((m int)) (list int)
  (nth_or (split_spaces "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec") (sub m 1) ""))

; n as two digits, 0 to 99.
(def two_digits ((n int)) (list int) (pad_left_with 48 (digits n) 2))

; The time of day s seconds into it, on a 24-hour clock: 22:42.
(def hh_mm ((s int)) (list int)
  (append (two_digits (div s 3600)) (cons 58 (two_digits (div (mod s 3600) 60)))))

; S as the top bar shows it, as GNOME's does by default: the month, the
; day, and the time, Oct 15  22:42. S is 0 or more.
(def clock_text ((s int)) (list int)
  (match (civil (div s 86400))
    ((Civil y m d) (append (month_name m) (append " " (append (digits d) (append "  " (hh_mm (mod s 86400)))))))))

; S as clock_text shows it, in UTC and saying so, as the logs of the
; programs that keep the clock say it: Oct 15  22:42 UTC.
(def utc_text ((s int)) (list int) (append (clock_text s) " UTC"))
