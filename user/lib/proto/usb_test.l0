; usb_test.l0 -- the usb protocol's notices, requests and answers.

(def attached_text ((o (Option UsbAttached))) (list int)
  (match o
    ((Some a) (match a ((UsbAttached dev vid pid speed) (unwords (numbers_words (cons dev (cons vid (cons pid (cons speed (nil int))))))))))
    ((None) "none")))

(def test_attach_round_trip () int
  (check_str "usb-kbd at high speed" (attached_text (usb_attached_of (Message 3 (usb_attach_notice (UsbAttached 1 1575 1 3))))) "1 1575 1 3"))

(def test_detach_round_trip () int
  (add (check_bool "device 7" (eq (usb_detached_of (Message 3 (usb_detach_notice 7))) (Some 7)) true)
       (check_bool "not an attach" (eq (usb_attached_of (Message 3 (usb_detach_notice 7))) ((None UsbAttached))) true)))

(def test_report_round_trip () int
  (match (usb_report_of (Message 3 (usb_report_notice (UsbReport 2 129 (cons 2 (cons 0 (cons 4 (nil int))))))))
    ((Some r)
      (match r
        ((UsbReport dev ep bs)
          (add (check_int "device" dev 2) (add (check_int "endpoint" ep 129) (check_bool "bytes" (eq bs (cons 2 (cons 0 (cons 4 (nil int))))) true))))))
    ((None) (fail_because "report" "refused"))))

; A report of no bytes is still one; fewer than the tag and two u32s is
; none.
(def test_report_short () int
  (add (check_bool "empty" (eq (usb_report_of (Message 3 (usb_report_notice (UsbReport 2 129 (nil int)))))
                               (Some (UsbReport 2 129 (nil int)))) true)
       (check_bool "short" (eq (usb_report_of (Message 3 "uin1234")) ((None UsbReport))) true)))

(def test_hex () int
  (add (check_str "bytes" (usb_hex (cons 18 (cons 1 (cons 255 (cons 0 (nil int)))))) "1201ff00")
       (check_str "none" (usb_hex (nil int)) "")))

(def test_unhex () int
  (add (check_bool "back" (eq (usb_unhex "1201FF00") (Some (cons 18 (cons 1 (cons 255 (cons 0 (nil int))))))) true)
       (add (check_bool "odd" (eq (usb_unhex "120") ((None (list int)))) true)
            (check_bool "not hex" (eq (usb_unhex "1g") ((None (list int)))) true))))

(def test_request () int
  (check_str "control" (usb_request "control" (cons 1 (cons 128 (cons 6 (cons 256 (cons 0 (cons 18 (nil int)))))))) "control 1 128 6 256 0 18"))

(def test_bytes_of () int
  (add (check_bool "hex" (eq (usb_bytes_of "0102") ((Ok (list int) (list int)) (cons 1 (cons 2 (nil int))))) true)
       (add (check_bool "error" (eq (usb_bytes_of "error: stall") ((Err (list int) (list int)) "stall")) true)
            (check_bool "other" (eq (usb_bytes_of "ok") ((Err (list int) (list int)) "usb said ok")) true))))

(def test_devices () int
  (let r (append (usb_device_line (UsbAttached 1 1575 1 3)) (usb_device_line (UsbAttached 2 1575 1 1)))
    (add (check_str "lines" r "1 1575 1 3\n2 1575 1 1\n")
         (check_int "read back" (length (usb_devices_of r)) 2))))

(def test_devices_bad_lines () int
  (check_int "passed over" (length (usb_devices_of "1 2 3\nx y z w\n4 5 6 7\n")) 1))

; Under an operating system there is no usb server.
(def test_no_usb () int
  (match (usb_open)
    ((Usb port rp) (fail_because "usb" "found"))
    ((NoUsb why) (check_str "why" (usb_ask (NoUsb why) "devices") "error: no usb; is xhci running?"))))
