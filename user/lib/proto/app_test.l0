; app_test.l0 -- manifests, bundles, and finding an app's program.

(def bundle () (list int) "/Applications/Terminal.app")

; An app as text, to compare: name, program, icon, summary, a | between.
(def app_text ((r (Result App (list int)))) (list int)
  (match r
    ((Err why) (append "error: " why))
    ((Ok a) (append (app_name a) (append "|" (append (app_exec a) (append "|" (append (app_icon a) (append "|" (app_summary a))))))))))

(def test_app_parse () int
  (check_str "every key"
    (app_text (app_parse (bundle) "# Terminal\nname Terminal\nexec vt\nicon icon.ppm\nsummary A terminal in a window\n"))
    "Terminal|/Applications/Terminal.app/vt|/Applications/Terminal.app/icon.ppm|A terminal in a window"))

(def test_app_parse_short () int
  (add (check_str "a name of two words, no icon or summary"
         (app_text (app_parse "/Applications/Monitor.app" "name System Monitor\r\n\nexec procmon"))
         "System Monitor|/Applications/Monitor.app/procmon||")
       (check_str "the last of a key wins" (app_text (app_parse (bundle) "name A\nname B\nexec vt\n")) "B|/Applications/Terminal.app/vt||")))

(def test_app_parse_needs () int
  (add (check_str "no name" (app_text (app_parse (bundle) "exec vt\n")) "error: no name")
       (check_str "no exec" (app_text (app_parse (bundle) "name Terminal\n")) "error: no exec")))

(def test_app_parse_bad () int
  (add (check_str "an unknown key" (app_text (app_parse (bundle) "name T\ncolor red\n")) "error: line 2: no key color")
       (add (check_str "no value" (app_text (app_parse (bundle) "name\n")) "error: line 1: name needs a value")
            (add (check_str "a path out of the bundle" (app_text (app_parse (bundle) "exec /bin/sh\n"))
                            "error: line 1: exec is a file in the bundle, with no /")
                 (check_str "two files" (app_text (app_parse (bundle) "icon a b\n")) "error: line 1: icon is one file")))))

(def paths () (list (list int))
  (split_spaces (append "/ /Applications/ /Applications/Disks.app/ /Applications/Disks.app/disks "
                        "/Applications/Old/ /Applications/.app/ /Applications/Terminal.app/ /bin/ /bin/sh")))

(def test_app_bundle_dirs () int
  (check_strs "each bundle, in order" (app_bundle_dirs (paths))
              (split_spaces "/Applications/Disks.app /Applications/Terminal.app")))

(def test_app_bundle_named () int
  (add (check_str "a name" (app_bundle_named "Terminal") "/Applications/Terminal.app")
       (add (check_str "a path" (app_bundle_named "/Applications/Disks.app/") "/Applications/Disks.app")
            (add (check_str "relative" (app_bundle_named "Applications/Disks.app") "/Applications/Disks.app")
                 (check_str "not a bundle" (app_bundle_named "/bin/sh") "")))))

(def apps () (list App)
  (cons (App "Disks" "/Applications/Disks.app/disks" "" "")
        (cons (App "Terminal" "/Applications/Terminal.app/vt" "" "") (nil App))))

(def test_app_for_exec () int
  (add (match (app_for_exec (apps) "/Applications/Terminal.app/vt")
         ((Some a) (check_str "found" (app_name a) "Terminal"))
         ((None) (fail_because "found" "none")))
       (check_bool "none" (eq (app_for_exec (apps) "/bin/sh") ((None App))) true)))

; A program found as program_entry finds it is not looked for in a
; bundle; on the host, a bundle's manifest cannot be read.
(def test_app_program_path () int
  (add (check_str "a program in /bin" (app_program_path "sh" (paths)) "/bin/sh")
       (add (check_str "a program in a bundle" (app_program_path "disks" (paths)) "/Applications/Disks.app/disks")
            (check_str "no such bundle" (app_program_path "Nope" (paths)) ""))))

; Every bundle's source in this project, user/apps/PROGRAM/NAME.app, as
; make root stages it: its manifest reads, and names its program, which
; the Makefile puts in it by the program's name. Read from the host's
; files.
(def test_app_sources () int
  (add (source_is "user/apps/vt/Terminal.app" "Terminal" "vt")
       (add (source_is "user/apps/procmon/Monitor.app" "System Monitor" "procmon")
            (add (source_is "user/apps/widgets/Widgets.app" "Widgets" "widgets")
                 (source_is "user/apps/disks/Disks.app" "Disks" "disks")))))

(def source_is ((dir (list int)) (name (list int)) (exec (list int))) int
  (match (app_read dir)
    ((Err why) (fail_because dir why))
    ((Ok a) (add (check_str (append dir " name") (app_name a) name)
                 (add (check_str (append dir " exec") (app_exec a) (append dir (cons 47 exec)))
                      (check_str (append dir " icon") (app_icon a) (append dir "/icon.ppm")))))))

; Under an operating system there is no initramfs, and no manifest.
(def test_app_read_none () int
  (add (check_bool "no manifest" (match (app_read (bundle)) ((Ok a) false) ((Err why) true)) true)
       (check_int "no bundles" (length (app_bundles)) 0)))
