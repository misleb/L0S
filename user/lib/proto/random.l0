; random.l0 -- the random protocol, as a client of it sends it: what an
; entropy driver, user/sbin/virtio-rng here, serves on the port it
; registers as random.
;
;   bytes N     random HEX: N bytes, 1 to 1024, that the host's source of
;               randomness gave, as 2N lowercase hex digits
;
; The request is a request (l0s.l0); the reply is as said, or error:
; WHY. A board started without the device has no random, and a client
; then does without, as random_bytes says. Linked into virtio-rng and its
; clients, fs, and inet and every user of its resolver, by the Makefile's
; LIBS_ lists and INETLIB.

; The most bytes one request may ask for.
(def random_max () int 1024)

; bytes N, as a request's body.
(def random_request ((n int)) (list int) (append "bytes " (digits n)))

; Why n bytes cannot be asked for; empty if they can.
(def random_refusal ((n int)) (list int)
  (if (or (lt n 1) (gt n (random_max)))
      (append "a request asks for 1 to " (append (digits (random_max)) " bytes"))
      ""))

; The answer to a request of bs: random, then each byte as two hex
; digits.
(def random_reply ((bs (list int))) (list int)
  (append "random " (random_hex_onto bs (nil int))))

; Each byte of bs as two hex digits, after acc, reversed: in order once
; the last is pushed.
(def random_hex_onto ((bs (list int)) (acc (list int))) (list int)
  (if (is_empty bs) (rev acc) (random_hex_onto (tail bs) (push (hex_digits (head bs) 2) acc))))

; The n bytes a reply r holds, or why it holds none: its error, or that
; it is not random's answer of n bytes.
(def random_of_reply ((r (list int)) (n int)) (Result (list int) (list int))
  (if (not (starts_with r "random "))
      ((Err (list int) (list int)) (reply_why r "random"))
      (match (random_unhex (drop_n r 7) (nil int))
        ((None) ((Err (list int) (list int)) "random's answer is not hex"))
        ((Some bs)
          (if (eq (length bs) n)
              ((Ok (list int) (list int)) bs)
              ((Err (list int) (list int)) (append "random gave " (append (digits (length bs)) " bytes"))))))))

; The bytes s spells, two hex digits each, after acc, reversed; none if
; it spells none.
(def random_unhex ((s (list int)) (acc (list int))) (Option (list int))
  (if (is_empty s) (Some (rev acc))
      (is_empty (tail s)) ((None (list int)))
      (let (hi (hex_val (head s))
            lo (hex_val (head (tail s))))
        (if (or (lt hi 0) (lt lo 0))
            ((None (list int)))
            (random_unhex (tail (tail s)) (cons (add (mul hi 16) lo) acc))))))

; n bytes of randomness, 1 to 1024, asked of random, its answer to rp,
; which must be this process's; or why there are none, at once if no
; driver has registered random.
(def random_bytes ((rp int) (n int)) (Result (list int) (list int))
  (random_found (name_lookup "random") rp n))

; random_bytes, waiting up to ns nanoseconds for a driver to register
; random, as a command started with it at boot must.
(def random_bytes_waiting ((rp int) (n int) (ns int)) (Result (list int) (list int))
  (random_found (name_wait "random" ns) rp n))

; n bytes asked of random, if l found it, its answer to rp.
(def random_found ((l Lookup) (rp int) (n int)) (Result (list int) (list int))
  (match l
    ((NotFound) ((Err (list int) (list int)) "no random; is virtio-rng running?"))
    ((Found port) (random_of_reply (asked_reply (port_ask port rp (random_request n) "random")) n))))

; A word of randomness from random, its answer to rp, or fallback if
; there is none: eight bytes, least significant first.
(def random_word ((rp int) (fallback int)) int
  (match (random_bytes rp 8)
    ((Err why) fallback)
    ((Ok bs) (random_le bs 0 0))))

; bs as a number, least significant first, from the i-th place on, after
; acc.
(def random_le ((bs (list int)) (i int) (acc int)) int
  (if (is_empty bs) acc (random_le (tail bs) (add i 1) (bit_or acc (bit_shl (head bs) (mul 8 i))))))
