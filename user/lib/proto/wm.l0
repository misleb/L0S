; wm.l0 -- the compositor's protocol, as a client of it sends it. The
; compositor, user/wm, registers as compositor and takes these, each a
; request (l0s.l0), its words separated by spaces:
;
;   hello                       compositor scale S: who it is, so the
;                               client learns its pid to share with, and
;                               the desktop's scale, 1 or 2
;   window W H VA PORT TITLE    a window of W by H pixels, its buffer at VA
;                               in the compositor, shared there with
;                               shm_share; keys typed while it is in front,
;                               and presses of the pointer in it, go to
;                               PORT, each a window notice naming ID
;                               (l0s.l0's win_notice), so a client may
;                               give many windows one port; the close
;                               button asks it to close the window, with
;                               the close notice, and kills it if the
;                               window is open 2 s later. The reply is
;                               window ID
;   damage ID X Y W H ...       each rectangle of the window changed, ID X
;                               Y W H again for each, shown together
;   top ID T                    the window's rows read from its buffer's
;                               row T on, as a ring: how a client scrolls
;   attach ID VA N S            the window's content from now on the
;                               buffer at VA in the compositor, N pages,
;                               shared there with shm_share, its rows S
;                               of its own pixels apart, at the window's
;                               size: shown in place of the one it had at
;                               the next damage, the commit, as
;                               wl_surface.attach is; the buffer given up
;                               the client may paint again once told by
;                               a release notice, rel and 0, as a window
;                               notice
;   frame ID                    the window's client told, as a window
;                               notice (l0s.l0's shown_notice, frm and
;                               the display's frame), when the display
;                               shows its next frame: asked once for a
;                               change, before the damage that shows it,
;                               as wl_surface.frame is
;   resize ID W H [VA N S]      the window's content is now W by H: in the
;                               buffer it has, which must have room, its
;                               rows where they were, or in a new one at
;                               VA, N pages, shared as window's is, its
;                               rows S of its own pixels apart, which may
;                               have room to grow into. The answer to a size notice
;                               (l0s.l0), when the user drags the
;                               window's edge; an old buffer is the
;                               client's to give up once the reply is ok
;   csd W H VA PORT TITLE       a window as window makes, but one its
;                               client decorates: no title bar or frame,
;                               all of it the client's content, its four
;                               corners rounded. The reply is window ID
;   move ID                     the window dragged with the pointer, from
;                               where it is, until the button is up: what
;                               a client asks when its own title bar is
;                               pressed, while the left button is down
;                               after a press in the window
;   edges ID E                  the window resized by its edges E with the
;                               pointer, from where it is, until the
;                               button is up, as by the border outside
;                               it: what a client asks when the inside of
;                               its own edge is pressed, as move is
;                               asked. E adds the edges' bits: left 1,
;                               right 2, top 4, bottom 8, one side or
;                               two that meet
;   maximize ID                 the window made to fill the screen under
;                               the top bar, or, if it is maximized,
;                               restored: what a double click on a
;                               client's own title bar asks
;   title ID TEXT               a new title
;   close ID                    the window gone
;   desktop CMD ...             CMD, a drawing command (render.l0's
;                               parse_command), drawn on the desktop
;   end                         the client asking it ended: killed, as the
;                               close button once killed it, its windows
;                               closing with it; what the toolkit asks
;                               for an app that did nothing with the
;                               close of its last window
;   windows                     a line a window, front first: its id,
;                               title, x, y, width, height, front if it
;                               is or -, its client's pid, buffer and
;                               the display's id of the content it
;                               shows, and frames and how many frames
;                               its client has been told; then
;                               pointer X Y, and the name of the
;                               pointer shown if it is not the arrow, as
;                               ew-resize over a window's side
;   launch NAME ARG ...         the app NAME, as the launcher names it, its
;                               bundle's name or its exec, launched with
;                               the ARGs, words: the one running asked to
;                               open them (appopen.l0), else started with
;                               them, and its window brought to the front
;                               with the focus; ok once launched
;   apps                        the apps in /Applications read again, and
;                               the launcher's page painted again, if
;                               / is a volume and its bundles are not the
;                               ones known; opening the launcher does it
;
; A window's buffer is 4-byte pixels, b, g, r, unused, row after row. Its
; size, places and rectangles, and the pointer's, are the desktop's
; pixels; at scale 2 its buffer is twice as wide and high, in the
; screen's, and T counts the desktop's rows. The reply is ok, or as said
; above, or error: WHY. A rectangle is rect.l0's Rect. Linked into the
; compositor's clients, by the Makefile's LIBS_ lists, with rect.l0.

; The compositor: its port, a port for its replies, its pid, and the
; desktop's scale, which hello says.
(data Compositor (Compositor int int int int) (NoCompositor (list int)))

; The compositor, waited for up to 10 seconds, with a new port for its
; replies, and its pid and scale learned from hello; or why there is
; none.
(def compositor_open () Compositor
  (match (name_wait "compositor" 10000000000)
    ((NotFound) (NoCompositor "no compositor; is wm running?"))
    ((Found c)
      (match (compositor_reply (Compositor c (port_new) 0 1) "hello")
        ((Replied c2 r)
          (match (hello_scale r)
            ((None) (NoCompositor (append "the compositor said " r)))
            ((Some s) (match c2 ((Compositor port rp pid old) (Compositor port rp pid s)) ((NoCompositor why) c2)))))))))

; The scale hello's reply says: compositor scale S, or compositor alone
; for 1; none if it is no compositor's.
(def hello_scale ((r (list int))) (Option int)
  (let ws (split_spaces r)
    (if (if (is_empty ws) true (not (eq (head ws) "compositor")))
        ((None int))
        (if (if (eq (length ws) 3) (eq (nth ws 1) "scale") false)
            (Some (if (eq (nth ws 2) "2") 2 1))
            (Some 1)))))

; The desktop's scale, 1 or 2; 1 with no compositor.
(def compositor_scale ((c Compositor)) int
  (match c ((Compositor port rp pid s) s) ((NoCompositor why) 1)))

; The reply to body, and the compositor with its pid, which the reply
; comes from.
(data Replied (Replied Compositor (list int)))

; body asked of the compositor: its reply, or error: WHY if there is no
; compositor or no reply.
(def compositor_reply ((c Compositor) (body (list int))) Replied
  (match c
    ((NoCompositor why) (Replied c (append "error: " why)))
    ((Compositor port rp pid s)
      (match (port_ask port rp body "the compositor")
        ((Asked from b) (Replied (Compositor port rp from s) (msg_text b)))
        ((AskFailed why) (Replied c (append "error: " why)))))))

; The reply to body alone, as compositor_reply gives it.
(def compositor_ask ((c Compositor) (body (list int))) (list int)
  (match (compositor_reply c body) ((Replied c2 r) r)))

; The compositor's pid, to share buffers with; 0 if it is not known.
(def compositor_pid ((c Compositor) ) int
  (match c ((Compositor port rp pid s) pid) ((NoCompositor why) 0)))

; The reply as an error's reason, or empty for ok.
(def wm_error ((r (list int))) (list int) (reply_why r "the compositor"))

; A new window, w by h, of this process's n pages from va, shared with the
; compositor, its events to port: its id, and where the compositor has
; the buffer, to name it in attach later; or why not.
(data Opened (WindowOpened int int) (WindowFailed (list int)))

; A new window, w by h, titled title, its n pages from va shared with
; the compositor and its events sent to port.
(def window_open ((c Compositor) (w int) (h int) (va int) (n int) (port int) (title (list int))) Opened
  (window_open_as c "window" w h va n port title))

; The same, but a window that draws its own title bar in its content,
; which the compositor neither draws nor frames: the csd request.
(def window_open_csd ((c Compositor) (w int) (h int) (va int) (n int) (port int) (title (list int))) Opened
  (window_open_as c "csd" w h va n port title))

; A new window by request op, window or csd.
(def window_open_as ((c Compositor) (op (list int)) (w int) (h int) (va int) (n int) (port int) (title (list int))) Opened
  (match (shm_share_to va n (compositor_pid c) "the compositor")
    ((Ok there) (window_opened (compositor_ask c (window_request op w h there port title)) there))
    ((Err why) (WindowFailed why))))

; The window or csd request op, va where the compositor sees the buffer.
(def window_request ((op (list int)) (w int) (h int) (va int) (port int) (title (list int))) (list int)
  (append (unwords (cons op (numbers_words (cons w (cons h (cons va (cons port (nil int))))))))
          (append " " title)))

; What the reply to a window request says: window ID, its buffer being at
; there in the compositor, or why not.
(def window_opened ((r (list int)) (there int)) Opened
  (let ws (split_spaces r)
    (if (if (eq (length ws) 2) (eq (head ws) "window") false)
        (WindowOpened (int_prefix (head (tail ws)) 0) there)
        (WindowFailed (wm_error r)))))

; Window id now w by h, in a new buffer, its n pages from va shared with
; the compositor, as many as it keeps room for, its rows sd of its own
; pixels apart: the reply as an error's reason, or empty for ok.
(def window_resize ((c Compositor) (id int) (w int) (h int) (va int) (n int) (sd int)) (list int)
  (match (shm_share_to va n (compositor_pid c) "the compositor")
    ((Ok there) (ask_nums c "resize" (cons id (cons w (cons h (cons there (cons n (cons sd (nil int)))))))))
    ((Err why) why)))

; Window id now w by h, in the buffer at there in the compositor, shared
; with it before, n pages, its rows sd of its own pixels apart: the
; window's other buffer, as a client that paints the one not shown gives
; it. The reply as an error's reason, or empty.
(def window_resize_at ((c Compositor) (id int) (w int) (h int) (there int) (n int) (sd int)) (list int)
  (ask_nums c "resize" (cons id (cons w (cons h (cons there (cons n (cons sd (nil int)))))))))

; Window id's content from now on the buffer at there in the compositor,
; shared with it, n pages, its rows sd of its own pixels apart, at the
; window's size: shown in place of the one shown at the next damage,
; which says what it changed. The buffer given up may be painted again
; once a release notice says so. The reply as an error's reason, or
; empty.
(def window_attach ((c Compositor) (id int) (there int) (n int) (sd int)) (list int)
  (ask_nums c "attach" (cons id (cons there (cons n (cons sd (nil int)))))))

; Window id now w by h in the buffer it has, which has room for that, its
; rows where they were.
(def window_resize_in_place ((c Compositor) (id int) (w int) (h int)) (list int)
  (ask_nums c "resize" (cons id (cons w (cons h (nil int))))))

; op and its numbers asked, the reply as an error's reason or empty.
(def ask_nums ((c Compositor) (op (list int)) (ns (list int))) (list int)
  (wm_error (compositor_ask c (unwords (cons op (numbers_words ns))))))

; Rectangle r of window id changed.
(def window_damage ((c Compositor) (id int) (r Rect)) (list int)
  (ask_nums c "damage" (rev (rect_nums_onto id r (nil int)))))

; Every rectangle in rs of window id changed, told in one damage request,
; so the compositor shows them together; nothing to tell for none.
(def window_damage_many ((c Compositor) (id int) (rs (list Rect))) (list int)
  (if (is_empty rs) "" (ask_nums c "damage" (rev (rects_nums_onto id rs (nil int))))))

; Window id's rows read from its buffer's row top on, as a ring. Each
; of these three gives the reply as an error's reason, or empty.
(def window_top ((c Compositor) (id int) (top int)) (list int)
  (ask_nums c "top" (cons id (cons top (nil int)))))

; Window id's client told the display's next frame, as a window notice
; (l0s.l0's shown_notice): what a client asks once for a change, before
; the damage that shows it. The reply as an error's reason, or empty.
(def window_frame ((c Compositor) (id int)) (list int)
  (ask_nums c "frame" (cons id (nil int))))

; Window id's new title.
(def window_title ((c Compositor) (id int) (title (list int))) (list int)
  (wm_error (compositor_ask c (append "title " (append (digits id) (append " " title))))))

; Window id gone.
(def window_close ((c Compositor) (id int)) (list int)
  (ask_nums c "close" (cons id (nil int))))

; This client ended by the compositor, which kills it: what a program
; that has closed its last window asks when it cannot return from its
; loop, as the toolkit's ui_present does for an app that did nothing with
; a close. Nothing comes back once it is done.
(def compositor_end ((c Compositor)) (list int)
  (wm_error (compositor_ask c "end")))

; The app named app launched with args, as the launcher launches it:
; the one running asked to open them, or else started with them; empty
; once the compositor has, or why not. Each of app and args is one word.
(def compositor_launch ((c Compositor) (app (list int)) (args (list (list int)))) (list int)
  (wm_error (compositor_ask c (unwords (cons "launch" (cons app args))))))

; Window id dragged by the pointer, from where it is, while the press in
; its content that asks it is held: how a window that draws its own title
; bar is moved.
(def window_move ((c Compositor) (id int)) (list int)
  (ask_nums c "move" (cons id (nil int))))

; Window id made to fill the screen under the top bar, or restored if it
; does: what a double click on a header bar asks. Its client is then
; asked for the size, as by a drag of its edges.
(def window_maximize ((c Compositor) (id int)) (list int)
  (ask_nums c "maximize" (cons id (nil int))))

; Window id resized by its edges e with the pointer, while the press in
; its content that asks it is held: how a window that draws its own
; decorations is resized from inside its edge, as xdg_toplevel's resize
; is asked. e adds window_edge_left and the others.
(def window_edges ((c Compositor) (id int) (e int)) (list int)
  (ask_nums c "edges" (cons id (cons e (nil int)))))

; The bits of a window's edges in an edges request: the left, the right,
; the top, the bottom.
(def window_edge_left () int 1)
(def window_edge_right () int 2)
(def window_edge_top () int 4)
(def window_edge_bottom () int 8)
