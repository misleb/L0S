; font.l0 -- the font protocol, as a client of it sends it: what
; user/sbin/font serves on the port it registers as font. It owns the
; fonts, /etc/fonts, and gives each face at each line height as a strike
; (format/strike.l0) in pages it shares with whoever asks, read only.
;
;   faces           faces NAME ..., the faces it has
;   strike FACE H   VA N OFF M FACE H: face FACE at line height H, as
;                   a strike of M pages OFF bytes into an arena of N
;                   pages, which the asker sees at VA; made on the first
;                   ask of any client, and only given on every ask
;                   after; or error: FACE H: WHY
;   stats           builds B pages U T, the strikes made and the pages
;                   the strikes take of the arenas' T, then a line for
;                   each strike kept, FACE H BYTES HOLDERS: its size,
;                   and how many live processes hold it
;
; The request is a request (l0s.l0); the reply is as said, or error:
; WHY. H is 8 to 128. An arena is shared whole with a process the
; first time it is given a strike there, so a client reads every strike
; of one arena through one region. Strikes are answered as they are
; ready, not in the order asked, which is why each answer names its
; strike. Linked into font, fonts and the toolkit, by the Makefile's
; LIBS_ lists and FONTLIB.

; The faces, by name, and the file each is in, under /etc/fonts.
(def font_faces () (list (list int)) (split_spaces "code code-bold sans sans-bold"))
(def font_files () (list (list int))
  (split_spaces "SourceCodePro-Regular.ttf SourceCodePro-Bold.ttf SourceSans3-Regular.ttf SourceSans3-Bold.ttf"))

; Where the fonts are.
(def font_dir () (list int) "/etc/fonts/")

; The file face is in, or empty if there is no such face.
(def font_file ((face (list int))) (list int)
  (font_file_in face (font_faces) (font_files)))

; font_file's loop, along the faces and their files together.
(def font_file_in ((face (list int)) (fs (list (list int))) (ps (list (list int)))) (list int)
  (if (if (is_empty fs) true (is_empty ps))
      ""
      (if (eq face (head fs)) (append (font_dir) (head ps)) (font_file_in face (tail fs) (tail ps)))))

; The line heights a strike may be asked at.
(def font_min_h () int 8)
(def font_max_h () int 128)

; Why a strike of face at h cannot be asked for, or empty if it can.
(def font_refusal ((face (list int)) (h int)) (list int)
  (if (not (any_eq face (font_faces)))
      (append "no face " face)
      (if (if (lt h (font_min_h)) true (gt h (font_max_h)))
          (append "a line height is " (append (digits (font_min_h)) (append " to " (digits (font_max_h)))))
          "")))

; strike FACE H, as a request's body.
(def font_strike_request ((face (list int)) (h int)) (list int)
  (append "strike " (append face (append " " (digits h)))))

; The answer to a strike, key FACE H: where its arena is in the asker,
; the arena's pages, where in it the strike starts, in bytes, the
; strike's own pages, and the key.
(def font_strike_reply ((va int) (n int) (off int) (m int) (key (list int))) (list int)
  (unwords (cons (digits va) (cons (digits n) (cons (digits off) (cons (digits m) (cons key (nil (list int)))))))))

; The answer that strike key, FACE H, cannot be given, and why.
(def font_strike_error ((key (list int)) (why (list int))) (list int)
  (error_reply (append key (append ": " why))))

; A strike as a client has it: where its arena is, the arena's pages,
; the strike's offset in it and its own pages; or why not.
(data FontStrike (FontStrike int int int int) (NoFontStrike (list int)))

; The strike a reply r gives, or why it gives none.
(def font_strike_of ((r (list int))) FontStrike
  (let ws (split_spaces r)
    (if (lt (length ws) 4)
        (NoFontStrike (reply_why r "font"))
        (match (word_numbers (take ws 4))
          ((Some ns) (FontStrike (head ns) (nth ns 1) (nth ns 2) (nth ns 3)))
          ((None) (NoFontStrike (reply_why r "font")))))))

; The strike an answer r is to, FACE H, read from it, a refusal's too;
; "" if it names none.
(def font_reply_key ((r (list int))) (list int)
  (let ws (split_spaces r)
    (if (starts_with r "error: ")
        (if (lt (length ws) 3) "" (font_key_of (nth ws 1) (up_to 58 (nth ws 2))))
        (if (lt (length ws) 6) "" (font_key_of (nth ws 4) (nth ws 5))))))

; FACE H, if h is a height; else "".
(def font_key_of ((face (list int)) (h (list int))) (list int)
  (match (word_number h)
    ((Some n) (append face (append " " h)))
    ((None) "")))

; The font service as a client holds it: its port and a port for its
; replies; or why there is none.
(data FontPort (FontPort int int) (NoFontPort (list int)))

; The font service, waiting up to ns nanoseconds for it to register.
(def font_open ((ns int)) FontPort
  (match (name_wait "font" ns)
    ((NotFound) (NoFontPort "no font; is /sbin/font running?"))
    ((Found port)
      (let rp (port_new)
        (if (lt rp 0) (NoFontPort "no port for font's replies") (FontPort port rp))))))

; body asked of font: its answer, or error: WHY.
(def font_ask ((fp FontPort) (body (list int))) (list int)
  (match fp
    ((NoFontPort why) (error_reply why))
    ((FontPort port rp) (asked_reply (port_ask port rp body "font")))))

; Face at line height h, as a strike in this process's pages; or why not.
(def font_strike ((fp FontPort) (face (list int)) (h int)) FontStrike
  (font_strike_of (font_ask fp (font_strike_request face h))))

; The faces font has, or why it cannot say.
(def font_faces_of ((r (list int))) (Result (list (list int)) (list int))
  (if (starts_with r "faces")
      ((Ok (list (list int)) (list int)) (tail (split_spaces r)))
      ((Err (list (list int)) (list int)) (reply_why r "font"))))
