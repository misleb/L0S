; font_test.l0 -- tests of the font protocol's client side: the faces'
; files, what may be asked, and the replies read.

(def test_file () int
  (add (check_str "sans-bold" (font_file "sans-bold") "/etc/fonts/SourceSans3-Bold.ttf")
       (check_str "no such face" (font_file "serif") "")))

(def test_refusal () int
  (add (check_str "a face" (font_refusal "code" 16) "")
       (add (check_str "no face" (font_refusal "serif" 16) "no face serif")
            (check_str "too tall" (font_refusal "code" 129) "a line height is 8 to 128"))))

(def test_request () int
  (check_str "strike" (font_strike_request "code-bold" 32) "strike code-bold 32"))

; A reply, VA N OFF M FACE H, read back.
(def test_strike_of () int
  (match (font_strike_of (font_strike_reply 3221225472 128 12288 4 "sans 24"))
    ((FontStrike va n off m)
      (add (check_int "va" va 3221225472)
           (add (check_int "arena's pages" n 128) (add (check_int "offset" off 12288) (check_int "pages" m 4)))))
    ((NoFontStrike why) (fail_because "read" why))))

(def test_strike_reply () int
  (check_str "reply" (font_strike_reply 3221225472 128 12288 4 "sans 24") "3221225472 128 12288 4 sans 24"))

(def test_strike_of_error () int
  (match (font_strike_of (font_strike_error "serif 16" "no face serif"))
    ((FontStrike va n off m) (fail_because "read" "took an error for a strike"))
    ((NoFontStrike why) (check_str "why" why "serif 16: no face serif"))))

; Each answer names its strike, a refusal too.
(def test_reply_key () int
  (add (check_str "given" (font_reply_key (font_strike_reply 4096 128 0 3 "code-bold 32")) "code-bold 32")
       (add (check_str "refused" (font_reply_key (font_strike_error "serif 16" "no face serif")) "serif 16")
            (check_str "neither" (font_reply_key "error: lost") ""))))

(def test_faces_of () int
  (match (font_faces_of "faces code sans")
    ((Ok fs) (check_str "faces" (unwords fs) "code sans"))
    ((Err why) (fail_because "read" why))))

; Under an operating system there is no font service.
(def test_no_service () int
  (match (font_strike (font_open 0) "code" 16)
    ((FontStrike va n off m) (fail_because "asked" "a strike with no service"))
    ((NoFontStrike why) (check_str "why" why "no font; is /sbin/font running?"))))
