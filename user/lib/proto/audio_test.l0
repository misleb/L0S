; audio_test.l0 -- tests of audio.l0.

(def info_text ((o (Option AudioInfo))) (list int)
  (match o
    ((None) "none")
    ((Some i) (match i ((AudioInfo r q m) (append (digits r) (append " " (append (digits q) (append " " (digits m))))))))))

(def test_audio_info_round_trip () int
  (check_str "info" (info_text (audio_info_of (audio_info_reply 48000 512 2048))) "48000 512 2048"))

(def test_audio_info_not () int
  (add (check_str "error" (info_text (audio_info_of "error: no")) "none")
       (check_str "words" (info_text (audio_info_of "audio 48000 x 1")) "none")))

(def test_audio_played () int
  (add (check_str "reply" (audio_played_reply 12) "played 12")
       (check_int "read" (option_or_zero (audio_played_of "played 12")) 12)))

(def test_audio_played_not () int
  (check_bool "none" (is_none_int (audio_played_of "ok")) true))

(def test_audio_rates () int
  (add (check_bool "48 kHz" (audio_rate_ok 48000) true)
       (check_bool "22.05 kHz" (audio_rate_ok 22050) false)))

(def test_audio_play_request () int
  (check_str "request" (audio_play_request 4096 512 2) "play 4096 512 2"))

; Under an operating system there is no audio driver.
(def test_audio_open_none () int
  (match (audio_open)
    ((NoAudio why) (pass "no driver"))
    ((Audio p rp pid) (fail_because "no driver" "opened one"))))

(def option_or_zero ((o (Option int))) int (match o ((None) 0) ((Some v) v)))
(def is_none_int ((o (Option int))) bool (match o ((None) true) ((Some v) false)))
