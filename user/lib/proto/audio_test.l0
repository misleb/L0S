; audio_test.l0 -- tests of audio.l0: the devices answer, the replies,
; the notices, and that there is no server under an operating system.

; A device's line, and read back the same.
(def test_device_line () int
  (let d (AudioDevice 1 false "hdmi0" 2 (cons 32000 (cons 44100 (cons 48000 (nil int)))) true)
    (add (check_str "line" (audio_device_line d) "1 out hdmi0 2 32000,44100,48000 default")
         (check_bool "back" (match (audio_device_of (audio_device_line d)) ((Some d2) (eq d2 d)) ((None) false)) true))))

; The devices answer: two lines, one not a device's passed over.
(def test_devices_of () int
  (let ds (audio_devices_of "1 out hdmi0 2 48000 default\nnonsense\n2 in usb-046d:0acf-microphone 2 44100,48000\n")
    (add (check_int "two" (length ds) 2)
         (add (check_str "name" (.name (nth ds 1)) "usb-046d:0acf-microphone")
              (check_bool "input" (.input (nth ds 1)) true)))))

; The default of a kind: the one marked, else the first; none of a kind
; there is none of.
(def test_default_of () int
  (let ds (audio_devices_of "1 out a 2 48000\n2 out b 2 48000 default\n3 in c 1 16000\n")
    (add (check_int "out" (match (audio_default_of ds false) ((Some d) (.id d)) ((None) 0)) 2)
         (add (check_int "in" (match (audio_default_of ds true) ((Some d) (.id d)) ((None) 0)) 3)
              (check_int "none" (match (audio_default_of (nil AudioDevice) true) ((Some d) (.id d)) ((None) 0)) 0)))))

; A word and a number, and what else is not one.
(def test_word_reply () int
  (add (check_str "reply" (audio_word_reply "stream" 7) "stream 7")
       (add (check_int "read" (option_or_zero (audio_word_of "stream" "stream 7")) 7)
            (check_int "other" (option_or_zero (audio_word_of "stream" "taken 7")) 0))))

; listen's format answered and read; an error read as why.
(def test_format () int
  (add (check_str "reply" (audio_format_reply (PcmFormat 16000 1 2)) "format 16000 1 2")
       (add (check_bool "back" (match (audio_format_of "format 16000 1 2") ((Ok f) (eq f (PcmFormat 16000 1 2))) ((Err why) false)) true)
            (check_str "error" (match (audio_format_of "error: no input") ((Ok f) "ok") ((Err why) why)) "no input"))))

; A pcm notice is told apart, its samples after the tag.
(def test_pcm_notice () int
  (let b (bytes_from_list (append (u32_le 9) (append "pcm" "ab")))
    (add (check_bool "pcm" (audio_is_pcm b) true)
         (check_int "at" (bytes_get b (audio_pcm_at)) 97))))

; A watcher's notice: the device and whether it came.
(def test_device_notice () int
  (match (audio_device_notice_of (message_new 5 (audio_device_notice 3 true)))
    ((Some ws) (add (check_int "id" (nth ws 0) 3) (check_int "attached" (nth ws 1) 1)))
    ((None) (fail_because "notice" "not read"))))

(def test_write_request () int
  (check_str "request" (audio_write_request 2 4096 512) "write 2 4096 512"))

; Under an operating system there is no audio server.
(def test_audio_open_none () int
  (match (audio_open)
    ((NoAudio why) (pass "no server"))
    ((Audio p rp pid) (fail_because "no server" "opened one"))))

(def option_or_zero ((o (Option int))) int (match o ((None) 0) ((Some v) v)))
