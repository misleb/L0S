(def test_request () int
  (check_str "bytes" (random_request 16) "bytes 16"))

(def test_refusal () int
  (add (check_str "one" (random_refusal 1) "")
       (add (check_str "the most" (random_refusal 1024) "")
            (add (check_str "none" (random_refusal 0) "a request asks for 1 to 1024 bytes")
                 (check_str "too many" (random_refusal 1025) "a request asks for 1 to 1024 bytes")))))

; Each byte two hex digits, lowercase, leading zeros kept.
(def test_reply () int
  (check_str "hex" (random_reply (cons 0 (cons 15 (cons 171 (cons 255 (nil int)))))) "random 000fabff"))

(def test_of_reply () int
  (match (random_of_reply "random 000fabff" 4)
    ((Ok bs) (check_strs "bytes" (cons (digits (length bs)) (cons (digits (nth bs 2)) (nil (list int))))
                         (cons "4" (cons "171" (nil (list int))))))
    ((Err why) (fail_because "bytes" why))))

; What is not random's answer of as many bytes as asked is refused.
(def test_of_reply_refused () int
  (add (check_str "an error" (why_of (random_of_reply "error: busy" 4)) "busy")
       (add (check_str "too few" (why_of (random_of_reply "random 00ff" 4)) "random gave 2 bytes")
            (check_str "not hex" (why_of (random_of_reply "random 0g" 1)) "random's answer is not hex"))))

; Why a result failed, or ok.
(def why_of ((r (Result (list int) (list int)))) (list int)
  (match r ((Ok bs) "ok") ((Err why) why)))

; A reply round trips through the bytes it holds, for every byte.
(def test_round_trip () int
  (let bs (rand_bytes 7 256)
    (match (random_of_reply (random_reply bs) 256)
      ((Ok got) (check_true "the same" (eq got bs)))
      ((Err why) (fail_because "the same" why)))))

; Least significant first: 01 02 is 513.
(def test_le () int
  (check_int "513" (random_le (cons 1 (cons 2 (nil int))) 0 0) 513))

; Under an operating system there is no random, and the fallback is
; what a word is.
(def test_no_random () int
  (add (check_str "why" (why_of (random_bytes 1 8)) "no random; is virtio-rng running?")
       (check_int "the fallback" (random_word 1 42) 42)))
