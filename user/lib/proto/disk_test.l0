(def test_info_of () int
  (add (check_int "a megabyte" (match (disk_info_of "disk 2048 512") ((Some n) n) ((None) -1)) 2048)
       (add (check_int "another size of sector" (match (disk_info_of "disk 2048 4096") ((Some n) n) ((None) -1)) -1)
            (check_int "an error" (match (disk_info_of "error: no") ((Some n) n) ((None) -1)) -1))))

; A read-only disk's info has ro after it; no other fourth word is info's.
(def test_info_of_ro () int
  (add (check_int "read-only" (match (disk_info_of "disk 2048 512 ro") ((Some n) n) ((None) -1)) 2048)
       (check_int "something else" (match (disk_info_of "disk 2048 512 rw") ((Some n) n) ((None) -1)) -1)))

; With no disk, a flush fails as everything does.
(def test_flush_no_disk () int
  (check_str "no disk" (disk_flush (NoDisk "no disk here")) "no disk here"))

(def test_error () int
  (add (check_str "ok" (disk_error "ok") "")
       (add (check_str "error" (disk_error "error: past the end") "past the end")
            (check_str "else" (disk_error "what") "the disk said what"))))

(def test_request () int
  (check_str "read" (disk_request "read" 7 2 3892314112) "read 7 2 3892314112"))

; Under an operating system there is no kernel, so no disk, at once.
(def test_no_disk () int
  (match (disk_open)
    ((Disk name port rp pid n) (fail_because "open" "a disk"))
    ((NoDisk why) (check_str "why" why "no disk; is virtio-blk running?"))))

(def test_no_disk_named () int
  (match (disk_open_named "disk3")
    ((Disk name port rp pid n) (fail_because "open" "a disk"))
    ((NoDisk why) (check_str "why" why "no disk disk3"))))

; ------------------------------------------------------------------ names

(def test_names () int
  (add (check_str "the first" (disk_name 0) "disk0")
       (add (check_bool "disk12" (is_disk_name "disk12") true)
            (add (check_bool "disk alone" (is_disk_name "disk") false)
                 (check_bool "info" (is_disk_name "info") false)))))

; A request names its disk first; one that names none has an empty name.
(def test_asked () int
  (add (check_str "the disk" (match (disk_asked "disk1 read 0 1 4096") ((DiskAsked n rest) n)) "disk1")
       (add (check_str "the rest" (match (disk_asked "disk1 read 0 1 4096") ((DiskAsked n rest) rest)) "read 0 1 4096")
            (check_str "none named" (match (disk_asked "info") ((DiskAsked n rest) (append "[" (append n "]")))) "[]"))))

; Under an operating system no disk is registered, and none can be.
(def test_no_names () int
  (add (check_int "none there" (length (disk_names)) 0)
       (check_bool "none registered" (match (disk_register 1) ((Ok n) false) ((Err why) true)) true)))

(def test_no_buffer () int
  (add (match (disk_buffer (NoDisk "none") 1)
         ((DiskBuf va n there r) (fail_because "buffer" "made"))
         ((NoDiskBuf why) (check_str "why" why "no memory for a disk buffer")))
       (check_str "moved through none" (disk_read (NoDisk "none") (NoDiskBuf "nothing") 0 1) "none")))

; A read a client sends itself names the disk, then the request as
; disk_request makes it, for a buffer with room; nothing for one too
; small, or with no disk or buffer.
(def test_read_body () int
  (let d (Disk "disk1" 7 8 9 2048)
    (add (check_str "two sectors" (disk_read_body d (DiskBuf 4096 1 3892314112 (IoRegion 0)) 1 2) "disk1 read 1 2 3892314112")
         (add (check_str "too many" (disk_read_body d (DiskBuf 4096 1 3892314112 (IoRegion 0)) 1 9) "")
              (add (check_str "no buffer" (disk_read_body d (NoDiskBuf "none") 1 1) "")
                   (check_str "no disk" (disk_read_body (NoDisk "none") (DiskBuf 4096 1 0 (IoRegion 0)) 1 1) ""))))))

; A reply that came says why it failed, or nothing; one that never came
; says so.
(def test_reply_why () int
  (add (check_str "ok" (disk_reply_why (message_new 3 "ok")) "")
       (add (check_str "refused" (disk_reply_why (message_new 3 "error: past the end")) "past the end")
            (check_str "none" (disk_reply_why (RecvFailed)) "no answer from the disk"))))

(def test_port () int
  (add (check_int "its driver's" (disk_port (Disk "disk1" 7 8 9 2048)) 7)
       (check_int "none" (disk_port (NoDisk "none")) 0)))
