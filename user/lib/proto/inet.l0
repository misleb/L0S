; inet.l0 -- the inet protocol, as a client of it sends it: what the
; network stack, user/sbin/inet, serves on the port it registers as
; inet; and IPv4 addresses, as text. Needs nic.l0, for Ethernet's.
;
;   info                    inet ADDR MASK GATEWAY MAC: the interface,
;                           its address, netmask and gateway dotted, its
;                           Ethernet address as six hex pairs
;   dns                     dns ADDR: the name server the interface has,
;                           0.0.0.0 for none, which inet_resolve asks
;   stats                   rx N tx N dropped N arp N: frames taken and
;                           sent, those passed over, the neighbours known
;   arp                     a line ADDR MAC for each neighbour known
;   bind PORT               bound PORT: UDP datagrams to PORT come to the
;                           reply port from now on, as udp notices; 0
;                           for a port inet picks, from 49152
;   unbind PORT             ok: no more of them
;   send SPORT DST DPORT    and then a newline and the datagram's data:
;                           sent from UDP port SPORT to DPORT at DST;
;                           answered only if refused, and with ok if the
;                           request names a reply port
;   ping DST SEQ            an ICMP echo request to DST: answered only if
;                           refused; the echo's reply comes to the reply
;                           port as a pong notice
;
;   connect ADDR PORT NPORT a TCP connection opened to PORT at ADDR, whose
;                           notices go to the port NPORT, which is the
;                           client's: connecting ID LPORT, its number and
;                           local port. It is not open until a notice says
;                           so
;   listen PORT NPORT       listening PORT: TCP connections to PORT are
;                           made, and told to NPORT; 0 for a port inet
;                           picks, from 49152
;   unlisten PORT           ok: no more are made; those made go on
;   write ID                and then a newline and the data: given to
;                           connection ID, which sends it as the peer's
;                           window lets it. Answered only if the request
;                           names a reply port, with ok or why not; more
;                           than 16384 bytes unsent resets the connection
;   finish ID               ok: connection ID closed once its data is sent
;   reset ID                ok: connection ID given up, with a reset
;   tcp                     a line ID STATE LPORT ADDR:RPORT for each
;                           connection, and listen PORT for each listener
;
; Each is a request (l0s.l0), its words separated by spaces; the reply is
; as said above, or error: WHY. Only the process that opened a connection,
; or listened to its port, may write to it, finish it, reset it, or
; unlisten (inet knows it by its pid). The notices inet sends a client:
;
;   udp SRC SPORT DPORT     then a newline and the data: a datagram from
;                           SPORT at SRC to the client's DPORT
;   pong SRC SEQ TTL N      echo reply SEQ from SRC, an ICMP message of N
;                           bytes, with TTL hops left
;
; and, to the port a connection's owner named, each as a TcpEvent:
;
;   tcp ID up               connection ID, which the client opened, is open
;   tcp ID accepted SRC SPORT LPORT
;                           a connection to LPORT, which the client
;                           listens to, from SPORT at SRC, is open, as ID
;   tcp ID data             then a newline and the data that came
;   tcp ID fin              the peer will send no more
;   tcp ID closed WHY       the end of connection ID, and WHY in a word:
;                           closed (it ended as it should, once both
;                           ends had closed), reset (the peer reset it),
;                           refused (the peer reset it at the start),
;                           timeout (nothing came after many tries),
;                           aborted (the client reset it), or
;                           overflow (the client's port was full, or it
;                           wrote too much)
;
; A client asks through its own reply port, and has its connections' notices
; come to another, so that an answer is never taken for a notice; its
; connection's last notice is closed.
;
; An address is an int here, its first byte the most significant: 10.0.2.15
; is 167772687. inet_resolve finds a name's, asking the name server over
; UDP (format/dns.l0). Linked, with nic.l0 and dns.l0, into the stack and
; into the programs that use it, by the Makefile's INETLIB.

; --------------------------------------------------------------- addresses

; a.b.c.d as an address.
(def ip_of ((a int) (b int) (c int) (d int)) int
  (bit_or (bit_shl a 24) (bit_or (bit_shl b 16) (bit_or (bit_shl c 8) d))))

; Byte i of address a, 0 the first, most significant.
(def ip_byte ((a int) (i int)) int
  (bit_and (bit_shr a (mul 8 (sub 3 i))) 255))

; The address s writes as four numbers 0 to 255 with dots between, or none.
(def ip_parse ((s (list int))) (Option int)
  (let parts (split_on 46 s)
    (if (not (eq (length parts) 4))
        ((None int))
        (ip_parts parts 0 0))))

; The rest of ip_parse: each of parts, after the n before them, a number
; 0 to 255 of at most three digits, put after acc.
(def ip_parts ((parts (list (list int))) (n int) (acc int)) (Option int)
  (if (is_empty parts)
      (Some acc)
      (let p (head parts)
        (if (if (is_number p) (le (length p) 3) false)
            (let v (int_prefix p 0)
              (if (gt v 255) ((None int)) (ip_parts (tail parts) (add n 1) (bit_or (bit_shl acc 8) v))))
            ((None int))))))

; Address a, dotted: 10.0.2.15.
(def ip_text ((a int)) (list int)
  (join_with "." (cons (digits (ip_byte a 0)) (cons (digits (ip_byte a 1))
                 (cons (digits (ip_byte a 2)) (cons (digits (ip_byte a 3)) (nil (list int))))))))

; The netmask of a prefix of n bits: 24 is 255.255.255.0.
(def ip_mask ((n int)) int
  (bit_and (bit_shl (sub (bit_shl 1 n) 1) (sub 32 n)) 4294967295))

; The bits a mask's prefix is, if it is one: 255.255.255.0 is 24.
(def ip_prefix_len ((mask int)) int (bit_count mask))

; 255.255.255.255, everyone on the link.
(def ip_broadcast () int 4294967295)

; ------------------------------------------------------------------ client

; The most data one datagram carries: an Ethernet frame's 1500 bytes,
; less IPv4's header and UDP's, since inet does not fragment.
(def udp_max_data () int 1472)

; The stack, as a client holds it: its port, and the port its answers
; and notices come to; or why there is none.
(data Inet (Inet int int) (NoInet (list int)))

; The stack, once it has registered, within 5 seconds; or why not.
(def inet_open () Inet
  (match (name_wait "inet" 5000000000)
    ((NotFound) (NoInet "no network; is inet running?"))
    ((Found port) (Inet port (port_new)))))

; The port answers and notices come to, -1 for none.
(def inet_port ((n Inet)) int (match n ((Inet port rp) rp) ((NoInet why) -1)))

; The answer to body, or error: WHY.
(def inet_ask ((n Inet) (body (list int))) (list int)
  (match n
    ((NoInet why) (append "error: " why))
    ((Inet port rp) (asked_reply (port_ask port rp body "inet")))))

; The answer as an error's reason, or empty for ok.
(def inet_error ((r (list int))) (list int) (reply_why r "inet"))

; The interface, as info's answer gives it: its address, netmask and
; gateway, and its card's Ethernet address.
(data InetInfo (InetInfo int int int (list int)))

; The interface info's answer r gives, or why it gives none.
(def inet_info_of ((r (list int))) (Result InetInfo (list int))
  (let ws (split_spaces r)
    (if (if (eq (length ws) 5) (eq (head ws) "inet") false)
        (inet_info_words (ip_parse (nth ws 1)) (ip_parse (nth ws 2)) (ip_parse (nth ws 3)) (mac_parse (nth ws 4)))
        ((Err InetInfo (list int)) (inet_error r)))))

; The interface of info's words, read as addresses, if each is one.
(def inet_info_words ((a (Option int)) (m (Option int)) (g (Option int)) (mac (Option (list int)))) (Result InetInfo (list int))
  (match a
    ((None) (inet_info_bad))
    ((Some addr)
      (match m
        ((None) (inet_info_bad))
        ((Some mask)
          (match g
            ((None) (inet_info_bad))
            ((Some gw)
              (match mac
                ((None) (inet_info_bad))
                ((Some e) ((Ok InetInfo (list int)) (InetInfo addr mask gw e)))))))))))

; Why an answer to info gives no interface.
(def inet_info_bad () (Result InetInfo (list int))
  ((Err InetInfo (list int)) "inet's info is not addresses"))

; Asks for the interface.
(def inet_info ((n Inet)) (Result InetInfo (list int))
  (inet_info_of (inet_ask n "info")))

; info's answer for an interface.
(def inet_info_text ((i InetInfo)) (list int)
  (match i
    ((InetInfo a m g e)
      (unwords (cons "inet" (cons (ip_text a) (cons (ip_text m) (cons (ip_text g) (cons (mac_text e) (nil (list int)))))))))))

; UDP port p bound for this client, 0 for one inet picks: the port bound,
; or why not.
(def udp_bind ((n Inet) (p int)) (Result int (list int))
  (let r (inet_ask n (append "bind " (digits p)))
    (let ws (split_spaces r)
      (if (if (eq (length ws) 2) (if (eq (head ws) "bound") (is_number (nth ws 1)) false) false)
          ((Ok int (list int)) (int_prefix (nth ws 1) 0))
          ((Err int (list int)) (inet_error r))))))

; UDP port p given up: empty, or why not.
(def udp_unbind ((n Inet) (p int)) (list int)
  (inet_error (inet_ask n (append "unbind " (digits p)))))

; send's request body: its words, a newline, the data.
(def udp_send_body ((sport int) (dst int) (dport int) (content (list int))) (list int)
  (append "send " (append (unwords (cons (digits sport) (cons (ip_text dst) (cons (digits dport) (nil (list int))))))
                          (cons 10 content))))

; A datagram of content from UDP port sport to dport at dst: empty once
; inet has it, or why it never will. Nothing answers; inet sends it when
; it can, as a network does.
(def udp_send ((n Inet) (sport int) (dst int) (dport int) (content (list int))) (list int)
  (match n
    ((NoInet why) why)
    ((Inet port rp)
      (if (gt (length content) (udp_max_data))
          (append "a datagram holds at most " (append (digits (udp_max_data)) " bytes"))
          (sending_why (port_send port (request 0 (udp_send_body sport dst dport content))))))))

; A datagram, as a udp notice gives it: from port sport at src, to dport.
(data Datagram (Datagram int int int (list int)))

; The udp notice of d, as inet sends it to the client bound to its port.
(def udp_notice ((d Datagram)) (list int)
  (match d
    ((Datagram src sport dport content)
      (append "udp " (append (unwords (cons (ip_text src) (cons (digits sport) (cons (digits dport) (nil (list int))))))
                             (cons 10 content))))))

; The datagram payload holds, or none if it is not a udp notice.
(def datagram_of ((payload (list int))) (Option Datagram)
  (if (not (starts_with payload "udp "))
      ((None Datagram))
      (let ws (split_spaces (take_line (drop_n payload 4)))
        (if (not (eq (length ws) 3))
            ((None Datagram))
            (match (ip_parse (head ws))
              ((None) ((None Datagram)))
              ((Some src)
                (match (word_numbers (tail ws))
                  ((None) ((None Datagram)))
                  ((Some ps) (Some (Datagram src (nth ps 0) (nth ps 1) (drop_line payload)))))))))))

; ------------------------------------------------------------------ names

; The name server dns's answer r names, 0 for none, or why it names none.
(def inet_dns_of ((r (list int))) (Result int (list int))
  (let ws (split_spaces r)
    (if (if (eq (length ws) 2) (eq (head ws) "dns") false)
        (match (ip_parse (nth ws 1))
          ((None) ((Err int (list int)) "inet's dns is not an address"))
          ((Some a) ((Ok int (list int)) a)))
        ((Err int (list int)) (inet_error r)))))

; The name server inet's interface has, 0 for none.
(def inet_dns ((n Inet)) (Result int (list int))
  (inet_dns_of (inet_ask n "dns")))

; How long a resolver waits for a name server's answer, and how many
; times it asks.
(def resolve_wait_ns () int 2000000000)
(def resolve_tries () int 3)

; The address name has: itself, if it is one, dotted; or what the name
; server of inet's interface answers for it; or why there is none.
(def inet_resolve ((n Inet) (name (list int))) (Result int (list int))
  (match (ip_parse name)
    ((Some a) ((Ok int (list int)) a))
    ((None)
      (match (inet_dns n)
        ((Err why) ((Err int (list int)) why))
        ((Ok server)
          (if (eq server 0)
              ((Err int (list int)) "inet knows no name server")
              (inet_resolve_at n name server (dns_port))))))))

; The address the name server at port of server answers for name: asked
; from a UDP port inet picks, given up again after, resolve_tries times
; resolve_wait_ns apart. What comes to this client meanwhile that is not
; the answer is dropped.
(def inet_resolve_at ((n Inet) (name (list int)) (server int) (port int)) (Result int (list int))
  (if (not (dns_name_ok name))
      ((Err int (list int)) (append "not a name: " name))
      (match (udp_bind n 0)
        ((Err why) ((Err int (list int)) why))
        ((Ok p)
          (let r (resolve_tries_left n name server port p (resolve_id n) (resolve_tries))
            (let u (udp_unbind n p) r))))))

; A query's id: 16 bits of random's, asked with inet's answer port, so
; an answer is hard to forge; the clock's, which can be guessed, on a
; board with no virtio-rng.
(def resolve_id ((n Inet)) int (bit_and (random_word (inet_port n) (clock_ns)) 65535))

; The query, numbered id, sent from p to the server, and its answer
; waited for; asked again, tries times in all.
(def resolve_tries_left ((n Inet) (name (list int)) (server int) (port int) (p int) (id int) (tries int)) (Result int (list int))
  (if (eq tries 0)
      ((Err int (list int)) (append "the name server did not answer for " name))
      (let why (udp_send n p server port (dns_query id name))
        (if (not (is_empty why))
            ((Err int (list int)) why)
            (match (resolve_wait n server port p id (add (clock_ns) (resolve_wait_ns)))
              ((Some r) r)
              ((None) (resolve_tries_left n name server port p id (sub tries 1))))))))

; The answer to the query numbered id, from port at server to p, once it
; comes before due; none if it does not.
(def resolve_wait ((n Inet) (server int) (port int) (p int) (id int) (due int)) (Option (Result int (list int)))
  (if (gt (clock_ns) due)
      ((None (Result int (list int))))
      (match (port_try_receive (inet_port n))
        ((RecvFailed)
          (if (lt (inet_port n) 0)
              ((None (Result int (list int))))
              (let z (sleep_ns 10000000) (resolve_wait n server port p id due))))
        ((Message from b)
          (match (resolve_heard (msg_text b) server port p id)
            ((Some r) (Some r))
            ((None) (resolve_wait n server port p id due)))))))

; What payload says, if it is the answer to the query numbered id, from
; port at server to p: the address, or why there is none.
(def resolve_heard ((payload (list int)) (server int) (port int) (p int) (id int)) (Option (Result int (list int)))
  (match (datagram_of payload)
    ((None) ((None (Result int (list int)))))
    ((Some d)
      (match d
        ((Datagram src sport dport content)
          (if (not (if (eq src server) (if (eq sport port) (eq dport p) false) false))
              ((None (Result int (list int))))
              (match (dns_answer content id)
                ((DnsAddr a) (Some ((Ok int (list int)) a)))
                ((DnsNone why)
                  (if (is_empty why)
                      ((None (Result int (list int))))
                      (Some ((Err int (list int)) why)))))))))))

; An echo request to dst, the seq'th: empty once inet has it, or why not.
; Its reply comes as a pong notice, or an error if inet refuses it.
(def inet_ping ((n Inet) (dst int) (seq int)) (list int)
  (match n
    ((NoInet why) why)
    ((Inet port rp)
      (sending_why (port_send port (request rp (append "ping " (append (ip_text dst) (append " " (digits seq))))))))))

; An echo's reply: from src, the seq'th, with its time to live and size.
(data Pong (Pong int int int int))

; The pong notice of p, as inet sends it to the client that pinged.
(def pong_notice ((p Pong)) (list int)
  (match p
    ((Pong src seq ttl size)
      (unwords (cons "pong" (cons (ip_text src) (numbers_words (cons seq (cons ttl (cons size (nil int)))))))))))

; The pong payload holds, or none if it is not one.
(def pong_of ((payload (list int))) (Option Pong)
  (let ws (split_spaces payload)
    (if (if (eq (length ws) 5) (eq (head ws) "pong") false)
        (match (ip_parse (nth ws 1))
          ((None) ((None Pong)))
          ((Some src)
            (match (word_numbers (drop ws 2))
              ((None) ((None Pong)))
              ((Some ns) (Some (Pong src (nth ns 0) (nth ns 1) (nth ns 2)))))))
        ((None Pong)))))

; -------------------------------------------------------------------- TCP

; What a notice about a TCP connection tells: that one this process opened
; is up; that a listener's port was connected to, from an address and port,
; as a connection with this number; data that came; that the peer will send
; no more; or that the connection is gone, and why, in one word: closed (it
; ended as it should), reset, refused, timeout, aborted, or overflow (the
; process did not take its notices fast enough).
(data TcpEvent (TcpUp int) (TcpAccepted int int int int) (TcpData int (list int)) (TcpFin int) (TcpClosed int (list int)))

; The tcp notice of e, as inet sends it to the port a connection's notices
; go to.
(def tcp_notice ((e TcpEvent)) (list int)
  (match e
    ((TcpUp id) (unwords (cons "tcp" (cons (digits id) (cons "up" (nil (list int)))))))
    ((TcpAccepted id src sport lport)
      (unwords (cons "tcp" (cons (digits id) (cons "accepted" (cons (ip_text src) (numbers_words (cons sport (cons lport (nil int))))))))))
    ((TcpData id body) (append (unwords (cons "tcp" (cons (digits id) (cons "data" (nil (list int)))))) (cons 10 body)))
    ((TcpFin id) (unwords (cons "tcp" (cons (digits id) (cons "fin" (nil (list int)))))))
    ((TcpClosed id why) (unwords (cons "tcp" (cons (digits id) (cons "closed" (cons why (nil (list int))))))))))

; The event a tcp notice holds, or none if payload is not one.
(def tcp_event_of ((payload (list int))) (Option TcpEvent)
  (if (not (starts_with payload "tcp "))
      ((None TcpEvent))
      (let ws (split_spaces (take_line payload))
        (if (lt (length ws) 3)
            ((None TcpEvent))
            (match (word_number (nth ws 1))
              ((None) ((None TcpEvent)))
              ((Some id) (tcp_event_words id (nth ws 2) (drop ws 3) (drop_line payload))))))))

; The event for connection id of the notice's kind, its other words, and the
; lines after its first.
(def tcp_event_words ((id int) (kind (list int)) (rest (list (list int))) (body (list int))) (Option TcpEvent)
  (if (if (eq kind "up") (is_empty rest) false) (Some (TcpUp id))
  (if (if (eq kind "fin") (is_empty rest) false) (Some (TcpFin id))
  (if (if (eq kind "data") (is_empty rest) false) (Some (TcpData id body))
  (if (eq kind "closed") (Some (TcpClosed id (unwords rest)))
  (if (if (eq kind "accepted") (eq (length rest) 3) false) (tcp_accepted_of id rest)
  ((None TcpEvent))))))))

; The accepted event of connection id, from the words ADDR PORT LPORT.
(def tcp_accepted_of ((id int) (ws (list (list int)))) (Option TcpEvent)
  (match (ip_parse (nth ws 0))
    ((None) ((None TcpEvent)))
    ((Some src)
      (match (word_numbers (tail ws))
        ((None) ((None TcpEvent)))
        ((Some ps) (Some (TcpAccepted id src (nth ps 0) (nth ps 1))))))))

; A connection to port at dst, opened for this process, whose notices go
; to the port np, which must be this process's: its number and its local
; port, or why not. The connection is not open until a tcp notice says
; it is up, or closed, and why not.
(def tcp_connect ((n Inet) (np int) (dst int) (port int)) (Result int (list int))
  (let r (inet_ask n (append "connect " (unwords (cons (ip_text dst) (numbers_words (cons port (cons np (nil int))))))))
    (let ws (split_spaces r)
      (if (if (eq (length ws) 3) (if (eq (head ws) "connecting") (is_number (nth ws 1)) false) false)
          ((Ok int (list int)) (int_prefix (nth ws 1) 0))
          ((Err int (list int)) (inet_error r))))))

; TCP port p listened to for this process, 0 for a port inet picks: the
; port, or why not. Each connection to it is a notice to the port np, as
; accepted, and its notices after that go there too.
(def tcp_listen ((n Inet) (np int) (p int)) (Result int (list int))
  (let r (inet_ask n (append "listen " (unwords (numbers_words (cons p (cons np (nil int)))))))
    (let ws (split_spaces r)
      (if (if (eq (length ws) 2) (if (eq (head ws) "listening") (is_number (nth ws 1)) false) false)
          ((Ok int (list int)) (int_prefix (nth ws 1) 0))
          ((Err int (list int)) (inet_error r))))))

; TCP port p listened to no more: empty, or why not. Connections already
; accepted stay.
(def tcp_unlisten ((n Inet) (p int)) (list int)
  (inet_error (inet_ask n (append "unlisten " (digits p)))))

; The most data one write request holds.
(def tcp_write_max () int 2048)

; The data content given to connection id, which sends it as the peer's
; window lets it: empty once inet has it all, or why not. Nothing answers;
; a connection that cannot take it ends with a closed notice.
(def tcp_write ((n Inet) (id int) (content (list int))) (list int)
  (match n
    ((NoInet why) why)
    ((Inet port rp)
      (if (is_empty content)
          (nil int)
          (let why (tcp_write_chunk port id (take content (tcp_write_max)) 0)
            (if (is_empty why) (tcp_write n id (drop content (tcp_write_max))) why))))))

; How many times a write is tried while inet's queue is full.
(def tcp_write_tries () int 10000)

; One request of at most tcp_write_max bytes, sent, again after a
; millisecond if inet's queue is full, until it has been tried
; tcp_write_tries times, tries of them already.
(def tcp_write_chunk ((port int) (id int) (chunk (list int)) (tries int)) (list int)
  (match (port_send port (request 0 (append "write " (append (digits id) (cons 10 chunk)))))
    ((Sent) (nil int))
    ((SendNoPort) "inet is gone")
    ((SendTooBig) "a write is too big")
    ((SendFull)
      (if (ge tries (tcp_write_tries))
          "inet does not take its requests"
          (let z (sleep_ns 1000000) (tcp_write_chunk port id chunk (add tries 1)))))))

; Connection id told it will send no more, after its data: empty once inet
; has the request, or why not.
(def tcp_finish ((n Inet) (id int)) (list int)
  (tcp_tell n (append "finish " (digits id))))

; Connection id given up, with a reset to the peer.
(def tcp_reset ((n Inet) (id int)) (list int)
  (tcp_tell n (append "reset " (digits id))))

; body sent to inet, with nothing to answer.
(def tcp_tell ((n Inet) (body (list int))) (list int)
  (match n
    ((NoInet why) why)
    ((Inet port rp) (sending_why (port_send port (request 0 body))))))
