; audio_server.l0 -- the audio protocol, as a driver serves it: what
; every sound driver reads from its requests and keeps of what it plays,
; whatever its hardware does with the samples. audio.l0 is the client's
; side and says what each request means, and its replies are built
; there. Linked into hdmi-audio, by the Makefile's AUDIO_SERVER, with
; audio.l0 and wav.l0, for the chime every driver plays as it starts.
;
; A driver plays from a ring of periods its device reads cyclically,
; each period frames long, and is told, by an interrupt or by asking the
; device, as each one ends. Frames are counted from the start, so a
; frame's place in the ring, and any position a format needs (iec958.l0's
; block), follow from its number; the ring here is only those counts.

; --------------------------------------------------------------- requests

; A request, as a driver reads it: info; start RATE; play VA FRAMES
; CHANS; or one refused, and why.
(data AudioAsk (AskInfo) (AskStart int) (AskPlay int int int) (AskRefused (list int)))

; The request whose body is body.
(def audio_ask_of ((body (list int))) AudioAsk
  (match (request_numbers body)
    ((ReqNums op ns)
      (let n (length ns)
        (if (and (eq op "info") (eq n 0)) (AskInfo)
            (and (eq op "start") (eq n 1)) (audio_start_ask (head ns))
            (and (eq op "play") (eq n 3)) (audio_play_ask (nth ns 0) (nth ns 1) (nth ns 2))
            (AskRefused (append "no request " op)))))
    ((ReqBad why) (AskRefused why))))

; start RATE, if RATE is played.
(def audio_start_ask ((rate int)) AudioAsk
  (if (audio_rate_ok rate)
      (AskStart rate)
      (AskRefused (append "no rate " (append (digits rate) (append "; " (audio_rates)))))))

; play VA FRAMES CHANS, if there are frames, of one channel or two.
(def audio_play_ask ((va int) (frames int) (chans int)) AudioAsk
  (if (and (not (eq chans 1)) (not (eq chans 2))) (AskRefused "1 or 2 channels")
      (lt frames 1) (AskRefused "no frames")
      (AskPlay va frames chans)))

; The pages frames frames of chans channels from a client lie in.
(def audio_play_pages ((frames int) (chans int)) int (pages_for (mul frames (mul 2 chans))))

; ------------------------------------------------------------------- ring

; The ring: its periods, the frames in each, the frame the period
; playing now starts at, and the frame written up to, each counted from
; the start.
(data AudioRing (AudioRing (periods int) (period int) (played int) (w int)))

; A ring of periods periods of period frames, nothing played yet: the
; first period plays as it is, silence, and writing starts after it.
(def audio_ring_new ((periods int) (period int)) AudioRing
  (AudioRing periods period 0 period))

; Where the next frame written goes: after what was written, but never
; into the period playing now, which the device has begun.
(def ring_next ((r AudioRing)) int
  (match r ((AudioRing ps p played w) (max w (add played p)))))

; The frames past the period playing that are written and not played.
(def ring_queued ((r AudioRing)) int
  (match r ((AudioRing ps p played w) (max 0 (sub w (add played p))))))

; How many more frames can be written now: up to where the period
; playing comes round again.
(def ring_room ((r AudioRing)) int
  (match r ((AudioRing ps p played w) (sub (add played (mul ps p)) (ring_next r)))))

; The ring once n frames are written at ring_next.
(def ring_wrote ((r AudioRing) (n int)) AudioRing
  (let k (add (ring_next r) n)
    (.w r k)))

; The period frame f is in, and where in it.
(def ring_slot ((r AudioRing) (f int)) int (mod (div f (.period r)) (.periods r)))
(def ring_offset ((r AudioRing) (f int)) int (mod f (.period r)))

; Frame f's place in the ring's memory, as a frame: its period's frames
; before it, then its own place in its period.
(def ring_frame_at ((r AudioRing) (f int)) int
  (add (mul (ring_slot r f) (.period r)) (ring_offset r f)))

; The period playing now.
(def ring_playing ((r AudioRing)) int (ring_slot r (.played r)))

; How many periods ended since r, by the period the device is in now.
(def ring_ended ((r AudioRing) (now int)) int
  (mod (add (sub now (ring_playing r)) (.periods r)) (.periods r)))

; The ring once the period playing has ended and the next plays. The one
; that ended is the period that frame .played plus the ring's frames
; goes in, the first not yet writable, which its driver fills with
; silence before writing anything more.
(def ring_advanced ((r AudioRing)) AudioRing
  (let k (add (.played r) (.period r))
    (.played r k)))

; The frame the period that just ended will play next, which the driver
; silences: the ring's frames past what played in it.
(def ring_reused ((r AudioRing)) int
  (add (.played r) (mul (.periods r) (.period r))))

; ---------------------------------------------------------------- samples

; Sample ch, 0 or 1, of frame i of chans channels in a client's pages m,
; 0 to 65535 as its two bytes read it: a mono frame's one sample is both
; channels'.
(def audio_sample_at ((m IoRegion) (i int) (chans int) (ch int)) int
  (if (eq chans 1)
      (region_get16 m (mul 2 i))
      (region_get16 m (add (mul 4 i) (mul 2 ch)))))

; Where a driver's frames come from: a client's pages, opened for a
; play; or a file's bytes, frame 0 at byte at, as the chime's are.
(data AudioSource (AudioPages IoRegion) (AudioBytes bytes int))

; Sample ch of frame i of chans channels from src, read in place, as
; audio_sample_at reads a client's.
(def audio_source_sample ((src AudioSource) (i int) (chans int) (ch int)) int
  (match src
    ((AudioPages m) (audio_sample_at m i chans ch))
    ((AudioBytes b at) (le_u16_at b (add at (if (eq chans 1) (mul 2 i) (add (mul 4 i) (mul 2 ch))))))))

; ------------------------------------------------------------------ chime

; Every sound driver plays /etc/chime.wav once, as soon as it serves
; audio, as a client would play it: at the file's rate, its frames
; written into the ring as there is room, again as each period ends,
; until all are. It waits for nothing else, the screen least of all. A
; client's start or play stops it there, and the client has the ring
; from then on, what the chime wrote playing out ahead of it. Boot
; argument chime=off plays none; a missing or unplayable file is said
; once, and the driver serves all the same.

; The chime still to play: its file's bytes, its rate and channels, the
; byte its next frame starts at, and where its samples end; or one held
; back until clock_ns reaches a time, for a driver whose output the
; listener's end takes a while to take up; or none.
(data AudioChime (AudioChime bytes int int int int) (ChimeAfter AudioChime int) (ChimeDone))

; The chime's file.
(def audio_chime_path () (list int) "/etc/chime.wav")

; Whether boot arguments args let the chime play: all but chime=off.
(def audio_chime_wanted ((args (list (list int)))) bool
  (not (any_eq "chime=off" args)))

; The chime in b, a WAV file's bytes, if a driver plays its rate; or
; why not.
(def audio_chime_of ((b bytes)) (Result AudioChime (list int))
  (match (parse_wav b)
    ((WavBad why) ((Err AudioChime (list int)) why))
    ((Wav rate chans s e)
      (if (audio_rate_ok rate)
          ((Ok AudioChime (list int)) (if (ge s e) (ChimeDone) (AudioChime b rate chans s e)))
          ((Err AudioChime (list int)) (append "a WAV file at " (append (digits rate) (append " Hz; the driver plays " (audio_rates)))))))))

; The chime driver name starts with: /etc/chime.wav, unless boot
; argument chime=off; none if it is missing or cannot be played, which
; is said once.
(def audio_chime_load ((name (list int))) AudioChime
  (if (not (audio_chime_wanted (boot_args)))
      (ChimeDone)
      (match (read_whole (audio_chime_path))
        ((Err why) (audio_chime_none name why))
        ((Ok b)
          (match (audio_chime_of b)
            ((Err why) (audio_chime_none name why))
            ((Ok c) c))))))

; No chime, for why, said as driver name: none.
(def audio_chime_none ((name (list int)) (why (list int))) AudioChime
  (let w (warn_as name (append "no chime: " (append (audio_chime_path) (append ": " why))))
    (ChimeDone)))

; The rate the chime plays at, or 0 once there is none.
(def audio_chime_rate ((c AudioChime)) int
  (match c ((AudioChime b rate chans s e) rate) ((ChimeAfter c2 at) (audio_chime_rate c2)) ((ChimeDone) 0)))

; Chime c held back ms from now, a clock_ns time: as it is if there is
; none or ms is not more than 0.
(def audio_chime_after ((c AudioChime) (ms int) (now int)) AudioChime
  (match c
    ((AudioChime b rate chans s e) (if (le ms 0) c (ChimeAfter c (add now (mul ms 1000000)))))
    ((ChimeAfter c2 at) c)
    ((ChimeDone) c)))

; Whether chime c is held back still.
(def audio_chime_waiting ((c AudioChime)) bool
  (match c ((ChimeAfter c2 at) true) ((AudioChime b rate chans s e) false) ((ChimeDone) false)))

; Chime c at now, a clock_ns time: the chime itself once its time has
; come; as it is otherwise.
(def audio_chime_due ((c AudioChime) (now int)) AudioChime
  (match c
    ((ChimeAfter c2 at) (if (ge now at) c2 c))
    ((AudioChime b rate chans s e) c)
    ((ChimeDone) c)))

; How long chime c plays, in ms, rounded down: its frames of chans 16-bit
; samples at its rate; 0 once there is none.
(def audio_chime_ms ((c AudioChime)) int
  (match c
    ((AudioChime b rate chans s e)
      (if (or (le rate 0) (le chans 0))
          0
          (div (mul (div (sub e s) (mul 2 chans)) 1000) rate)))
    ((ChimeAfter c2 at) (audio_chime_ms c2))
    ((ChimeDone) 0)))

; What a driver says as chime c starts: the file, how long, at what rate.
(def audio_chime_line ((c AudioChime)) (list int)
  (append "playing the chime, " (append (audio_chime_path)
    (append ", " (append (digits (audio_chime_ms c))
      (append " ms at " (append (digits (audio_chime_rate c)) " Hz")))))))

; Chime c, said by driver name as it starts, unless there is none or it
; is held back still.
(def audio_chime_said ((name (list int)) (c AudioChime)) AudioChime
  (match c
    ((ChimeDone) c)
    ((ChimeAfter c2 at) c)
    ((AudioChime b rate chans s e) (let k (info_as name (audio_chime_line c)) c))))

; What the chime gives a ring now: where its frames come from, their
; channels, how many to write at the ring's ring_next, and the chime
; after them.
(data ChimeFeed (ChimeFeed AudioSource int int AudioChime))

; The chime's next frames for ring r: as many as it has room for, as a
; client's play would have written; none while it is held back.
(def audio_chime_feed ((c AudioChime) (r AudioRing)) ChimeFeed
  (match c
    ((ChimeDone) (ChimeFeed (AudioBytes (bytes_from_list "") 0) 2 0 (ChimeDone)))
    ((ChimeAfter c2 at) (ChimeFeed (AudioBytes (bytes_from_list "") 0) 2 0 c))
    ((AudioChime b rate chans s e)
      (let (fb (mul 2 chans)
            k (min (div (sub e s) fb) (ring_room r))
            s2 (add s (mul k fb)))
        (ChimeFeed (AudioBytes b s) chans k (if (ge s2 e) (ChimeDone) (AudioChime b rate chans s2 e)))))))
