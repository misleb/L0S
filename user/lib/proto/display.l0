; display.l0 -- the display protocol, as a client of it sends it: the
; driver interface between the compositor, user/wm, and whatever drives
; the display hardware, user/virtio-gpu here. A driver for other hardware
; serves the same requests on the port it registers as display, so the
; compositor never knows which it has.
;
;   info                    display W H cursor scale S, the screen's size
;                           in its own pixels, cursor if the driver moves
;                           a pointer itself, and how many of them each
;                           way a pixel of the desktop is, 1 or 2; a
;                           reply without scale means 1
;   buffer ID W H VA [N [S]]
;                           a buffer of W by H pixels, 4 bytes each (b,
;                           g, r, and unused, or alpha for a cursor),
;                           row after row, S pixels apart (W if not
;                           given), at VA in the driver, which the
;                           client shared there with shm_share, N pages
;                           of it if that is more than S by H takes, so a
;                           buffer can be given again at another size in
;                           the same pages, under another ID, its rows
;                           where they were if S is the same
;   forget ID               the buffer dropped, and the driver's mapping
;                           of it given up once no other buffer is in the
;                           same pages; refused while it is in the
;                           layers or is the cursor
;   layers ID X Y TOP ...   the screen, bottom first: each buffer at X, Y,
;                           its rows read from row TOP on, as a ring, so
;                           a client scrolls one by changing TOP
;   damage ID X Y W H ...   each rectangle of its buffer changed: shown
;                           wherever it is on the screen, all of them
;                           together, those that overlap as one
;   shape ID TL TR BL BR    the buffer's corners rounded, top left, top
;                           right, bottom left, bottom right, each radius
;                           in pixels from 0, square, to half its width
;                           and height; the layer beneath shows where a
;                           corner is cut. A new buffer is square
;   cursor ID HX HY         the pointer's image, a 64 by 64 buffer, and
;                           its hot spot. The driver reads a buffer's
;                           pixels the first time it is named and keeps
;                           them, a cursor set, so naming it again is
;                           cheap; such a buffer is not given again
;                           until it is forgotten
;   move X Y                the pointer's hot spot at X, Y
;   frames PORT             PORT told, from now on, frame N after each
;                           frame that showed a change, N from 1, and
;                           release ID once buffer ID, which a layers
;                           left out, is read no more: l0s.l0's
;                           shown_notice and release_notice, sent
;                           before the reply to the request that
;                           caused them
;
; Each is a request (l0s.l0), its words separated by spaces; the reply is
; ok, or display W H cursor scale S for info, or error: WHY. A rectangle
; is rect.l0's Rect. Linked into the programs that talk to a display, by
; the Makefile's LIBS_ lists, with rect.l0.
;
; The driver counts the screen's own pixels. Once info has said the
; scale, a client here counts the desktop's: every place, rectangle and
; radius it gives is made the screen's on the way, s times as far, so at
; scale 2 the compositor lays out half the screen each way and its
; buffers are drawn twice the size. Only a buffer's width and height are
; its own pixels, as it was made.

; The display, as a client holds it: its port, a port for its replies,
; the driver's pid, for sharing buffers with it, and the scale.
(data Display (Display int int int int) (NoDisplay (list int)))

; What info says: the screen's width and height, whether the driver has
; a cursor of its own, and the scale.
(data DisplayInfo (DisplayInfo (w int) (h int) (cursor bool) (scale int)))

; The display, once its driver has registered, within 5 seconds; or why
; not.
(def display_open () Display
  (match (name_wait "display" 5000000000)
    ((Found d) (Display d (port_new) 0 1))
    ((NotFound) (NoDisplay "no display; is a display driver running?"))))

; The reply to body, and the display with the driver's pid, which the
; reply comes from.
(data Reply (Reply Display (list int)))

; body asked of the driver: its reply, or error: WHY if there is no
; display or no reply.
(def display_ask ((d Display) (body (list int))) Reply
  (match d
    ((NoDisplay why) (Reply d (append "error: " why)))
    ((Display port rp pid s)
      (match (port_ask port rp body "the display")
        ((Asked from b) (Reply (Display port rp from s) (msg_text b)))
        ((AskFailed why) (Reply d (append "error: " why)))))))

; The reply, as an error's reason, or empty for ok.
(def reply_error ((r (list int))) (list int) (reply_why r "the display"))

; op and its numbers as a request's body.
(def request_of ((op (list int)) (ns (list int))) (list int)
  (unwords (cons op (numbers_words ns))))

; info's answer, and the display with the driver's pid and the scale.
(data Info (Info Display DisplayInfo) (NoInfo (list int)))

; info asked: what it says, and the display at its scale from then on;
; or why not.
(def display_info ((d Display)) Info
  (match (display_ask d "info")
    ((Reply d2 r)
      (match (info_of r)
        ((Some i) (Info (display_at_scale d2 (.scale i)) i))
        ((None) (NoInfo (reply_error r)))))))

; d with its scale s.
(def display_at_scale ((d Display) (s int)) Display
  (match d ((Display port rp pid old) (Display port rp pid s)) ((NoDisplay why) d)))

; How many of the screen's pixels each way one of the desktop's is.
(def display_scale ((d Display)) int
  (match d ((Display port rp pid s) s) ((NoDisplay why) 1)))

; info's reply read, or none if it is not one.
(def info_of ((r (list int))) (Option DisplayInfo)
  (let ws (split_spaces r)
    (if (and (ge (length ws) 3) (eq (head ws) "display"))
        (Some (DisplayInfo (int_prefix (head (tail ws)) 0) (int_prefix (head (tail (tail ws))) 0)
                           (any_eq "cursor" ws) (info_scale ws)))
        ((None DisplayInfo)))))

; The number after scale in info's words, 1 or 2; 1 if there is none.
(def info_scale ((ws (list (list int)))) int
  (if (is_empty ws) 1
      (and (eq (head ws) "scale") (not (is_empty (tail ws)))) (if (eq (head (tail ws)) "2") 2 1)
      (info_scale (tail ws))))

; The pid the driver runs as, 0 before its first reply.
(def display_pid ((d Display)) int
  (match d ((Display port rp pid s) pid) ((NoDisplay why) 0)))

; Buffer id, w by h of its own pixels, this process's n pages from va,
; shared with the driver and given to it: empty, or why not.
(def display_buffer ((d Display) (id int) (w int) (h int) (va int) (n int)) (list int)
  (match (shm_share_to va n (display_pid d) "the display")
    ((Err why) why)
    ((Ok there)
      (match (display_ask d (request_of "buffer" (cons id (cons w (cons h (cons there (nil int)))))))
        ((Reply d2 r) (reply_error r))))))

; Buffer id, w by h of its own pixels, its rows sd apart, this process's
; n pages from va, shared with the driver and given to it: where the
; driver has them, to give them again at another size with
; display_buffer_at; or why not.
(def display_buffer_shared ((d Display) (id int) (w int) (h int) (sd int) (va int) (n int)) (Result int (list int))
  (match (shm_share_to va n (display_pid d) "the display")
    ((Err why) ((Err int (list int)) why))
    ((Ok there)
      (let e (display_buffer_at d id w h sd there n)
        (if (is_empty e) ((Ok int (list int)) there) ((Err int (list int)) e))))))

; Buffer id, w by h of its own pixels, its rows sd apart, the n pages the
; driver has at there, as display_buffer_shared gave them it, shared
; again for nothing: how a buffer is shown at another size in the same
; pages, under a new id while the old one still shows. Its rows keep
; their places if sd does. The pages stay the driver's until the last id
; over them is forgotten. Empty, or why not.
(def display_buffer_at ((d Display) (id int) (w int) (h int) (sd int) (there int) (n int)) (list int)
  (match (display_ask d (request_of "buffer" (cons id (cons w (cons h (cons there (cons n (cons sd (nil int)))))))))
    ((Reply d2 r) (reply_error r))))

; Buffer id dropped by the driver: empty, or why not.
(def display_forget ((d Display) (id int)) (list int)
  (match (display_ask d (request_of "forget" (cons id (nil int)))) ((Reply d2 r) (reply_error r))))

; A layer: a buffer's id, where it goes, and its top row.
(data Placed (Placed int int int int))

; The layers' numbers, places and top rows made the screen's at scale s.
(def placed_nums ((ls (list Placed)) (s int)) (list int)
  (if (is_empty ls)
      (nil int)
      (match (head ls)
        ((Placed id x y top) (cons id (cons (mul x s) (cons (mul y s) (cons (mul top s) (placed_nums (tail ls) s)))))))))

; The screen made of the layers ls, bottom first: empty, or why not.
(def display_layers ((d Display) (ls (list Placed))) (list int)
  (match (display_ask d (request_of "layers" (placed_nums ls (display_scale d)))) ((Reply d2 r) (reply_error r))))

; Rectangle r of buffer id changed.
(def display_damage ((d Display) (id int) (r Rect)) (list int)
  (display_damage_nums d (rev (rect_nums_onto id (rect_scaled r (display_scale d)) (nil int)))))

; A rectangle of a buffer that changed: the buffer's id, and where.
(data Dirty (Dirty int Rect))

; The damage request's numbers for ds, each rectangle made the screen's
; at scale s, after the reversed acc.
(def dirty_nums ((ds (list Dirty)) (s int) (acc (list int))) (list int)
  (if (is_empty ds)
      (rev acc)
      (match (head ds) ((Dirty id r) (dirty_nums (tail ds) s (rect_nums_onto id (rect_scaled r s) acc))))))

; Every rectangle in ds, of any buffers, in one damage request; nothing to
; send for none.
(def display_damage_many ((d Display) (ds (list Dirty))) (list int)
  (display_damage_nums d (dirty_nums ds (display_scale d) (nil int))))

; Every rectangle in rs of buffer id, in one damage request.
(def display_damage_rects ((d Display) (id int) (rs (list Rect))) (list int)
  (display_damage_nums d (rev (rects_nums_onto id (rects_scaled rs (display_scale d)) (nil int)))))

; damage with ns, each rectangle's id, x, y, width and height; nothing
; to send for none.
(def display_damage_nums ((d Display) (ns (list int))) (list int)
  (if (is_empty ns)
      ""
      (match (display_ask d (request_of "damage" ns)) ((Reply d2 r) (reply_error r)))))

; Buffer id's corners rounded, top left, top right, bottom left and
; bottom right, each radius in the desktop's pixels: empty, or why not.
(def display_shape ((d Display) (id int) (tl int) (tr int) (bl int) (br int)) (list int)
  (let s (display_scale d)
    (match (display_ask d (request_of "shape" (cons id (cons (mul tl s) (cons (mul tr s) (cons (mul bl s) (cons (mul br s) (nil int))))))))
      ((Reply d2 r) (reply_error r)))))

; The pointer's image, buffer id, its own 64 by 64 pixels whatever the
; scale, and its hot spot in them.
(def display_cursor ((d Display) (id int) (hx int) (hy int)) (list int)
  (match (display_ask d (request_of "cursor" (cons id (cons hx (cons hy (nil int)))))) ((Reply d2 r) (reply_error r))))

; port, this process's, told the display's frame and release notices
; from now on: empty, or why not.
(def display_frames ((d Display) (port int)) (list int)
  (match (display_ask d (request_of "frames" (cons port (nil int)))) ((Reply d2 r) (reply_error r))))

; The frame m, a message from the display, says was shown, or -1 if it
; says none.
(def display_frame_of ((m Message)) int (shown_notice_at m 0))

; The buffer m, a message from the display, says is read no more, or -1
; if it says none.
(def display_release_of ((m Message)) int (release_notice_at m 0))

; The pointer's hot spot moved to x, y on the desktop: empty, or why not.
(def display_move ((d Display) (x int) (y int)) (list int)
  (let s (display_scale d)
    (match (display_ask d (request_of "move" (cons (mul x s) (cons (mul y s) (nil int))))) ((Reply d2 r) (reply_error r)))))
