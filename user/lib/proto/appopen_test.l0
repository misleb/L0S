; appopen_test.l0 -- an app's name, the open request and its answer.

(def test_app_port_name () int
  (add (check_str "a program's path" (app_port_name "/Applications/Files.app/files") "app.files")
       (check_str "an exec alone" (app_port_name "vt") "app.vt")))

; An open read back, as text: its reply port, then each argument between
; |s; or bad and why; or none.
(def open_text ((o AppOpen)) (list int)
  (match o
    ((AppOpenAsked r args) (append (digits r) (append "|" (join_with "|" args))))
    ((AppOpenBad r why) (append "bad " (append (digits r) (append ": " why))))
    ((NotAppOpen) "none")))

; The request made for reply and args, received as a message from pid 9.
(def sent ((reply int) (args (list (list int)))) AppOpen
  (match (app_open_request reply args)
    ((Err why) (AppOpenBad -1 why))
    ((Ok b) (app_open_of (message_new 9 (bytes_to_list b))))))

; The request's bytes: the reply port, open, then each argument's length
; and bytes. 7 is 7 0 0 0; /Volumes is 8 long.
(def test_app_open_request_bytes () int
  (match (app_open_request 7 (cons "/Volumes" (nil (list int))))
    ((Err why) (fail_because "bytes" why))
    ((Ok b) (check_str "bytes" (bytes_to_list b) (append (cons 7 (cons 0 (cons 0 (cons 0 (nil int))))) (append "open" (append (cons 8 (cons 0 (nil int))) "/Volumes")))))))

(def test_app_open_round_trip () int
  (add (check_str "no argument" (open_text (sent 12 (nil (list int)))) "12|")
       (check_str "a path with a space, and an empty one"
                  (open_text (sent 300 (cons "/Volumes/My Disk" (cons "" (cons "http://x" (nil (list int)))))))
                  "300|/Volumes/My Disk||http://x")))

(def test_app_open_not () int
  (add (check_str "a window notice" (open_text (app_open_of (message_new 9 (win_notice 3 "close")))) "none")
       (check_str "too short" (open_text (app_open_of (message_new 9 "open"))) "none")))

; An open to reply 5 whose arguments are the bytes rest, read.
(def raw_open ((rest (list int))) AppOpen
  (app_open_of (message_new 9 (append (u32_le 5) (append "open" rest)))))

(def test_app_open_bad () int
  (add (check_str "a length cut short" (open_text (raw_open (cons 3 (nil int))))
                  "bad 5: an argument's length is cut short")
       (check_str "a length past the end" (open_text (raw_open (cons 9 (cons 0 "abc"))))
                  "bad 5: an argument is longer than the request")))

; A request over one message is refused: 4096 bytes of argument, with
; its length and the head, is 4106.
(def test_app_open_too_big () int
  (match (app_open_request 1 (cons (repeat_byte 120 4096) (nil (list int))))
    ((Ok b) (fail_because "refused" "it was made"))
    ((Err why) (check_str "refused" why "the open request is over 4096 bytes"))))

(def repeat_byte ((c int) (n int)) (list int) (if (eq n 0) (nil int) (cons c (repeat_byte c (sub n 1)))))

(def test_app_open_arg_too_long () int
  (match (app_open_request 1 (cons (repeat_byte 120 65536) (nil (list int))))
    ((Ok b) (fail_because "refused" "it was made"))
    ((Err why) (check_str "refused" why "an argument is over 65535 bytes"))))

(def test_app_shown () int
  (add (check_str "the answer" (app_shown 14) "shown 14")
       (add (check_int "read back" (match (app_shown_of "shown 14") ((Some n) n) ((None) -1)) 14)
            (check_int "not an answer" (match (app_shown_of "shown x") ((Some n) n) ((None) -1)) -1))))
