; mic.l0 -- the mic protocol: what usb-audio, the class driver of USB
; audio devices, serves under the name mic, and a client of it, such as
; rec:
;
;   devices             a line for each stream of each audio device: DEV
;                       IFACE, then in or out, what is at its far end
;                       (microphone, speaker...), its channels, bits and
;                       rates: 1 2 in microphone 2 24 44100,48000;
;                       nothing if there are none
;   listen [RATE]       format RATE CHANNELS BYTES: the first microphone
;                       set going, at RATE if it takes it (48000 if not
;                       given) or else its highest, each sample BYTES of
;                       the frame's, least significant first; then what
;                       it hears to the reply port, a notice pcm and the
;                       samples, every 10 ms or so; or error: busy while
;                       another listens, error: no microphone
;   stop                ok: the listening stopped, from the port that
;                       listens
;   silence DEV IFACE MS
;                       sent N packets: silence sent to the stream out of
;                       interface IFACE of DEV for MS milliseconds, a
;                       test of the path out
;
; Each is a request (l0s.l0), its words separated by spaces; the reply is
; as said above, or error: WHY. Linked into usb-audio and its clients by
; the Makefile's LIBS_ lists.

; The name the driver registers.
(def mic_name () (list int) "mic")

; The rate a microphone is asked for when none is given.
(def mic_default_rate () int 48000)

; ----------------------------------------------------------------- format

; What a microphone sends: its rate, channels, and bytes a sample.
(data MicFormat (MicFormat (rate int) (channels int) (size int)))

; listen's answer for f.
(def mic_format_reply ((f MicFormat)) (list int)
  (unwords (cons "format" (numbers_words (cons (.rate f) (cons (.channels f) (cons (.size f) (nil int))))))))

; The format listen's answer r says, or why not.
(def mic_format_of ((r (list int))) (Result MicFormat (list int))
  (let ws (split_spaces r)
    (if (starts_with r "error: ")
        ((Err MicFormat (list int)) (drop r 7))
        (not (and (eq (length ws) 4) (eq (head ws) "format")))
        ((Err MicFormat (list int)) (append "mic said " r))
        (match (word_numbers (tail ws))
          ((None) ((Err MicFormat (list int)) (append "mic said " r)))
          ((Some ns) ((Ok MicFormat (list int)) (MicFormat (nth ns 0) (nth ns 1) (nth ns 2))))))))

; The bytes a frame of f takes: a sample of each channel.
(def mic_frame_bytes ((f MicFormat)) int (mul (.channels f) (.size f)))

; ---------------------------------------------------------------- notices

; The tag of what a microphone heard.
(def mic_pcm_tag () (list int) "pcm")

; Whether a message's bytes b are what a microphone heard; the samples
; start after the tag, at mic_pcm_at of the message's bytes.
(def mic_is_pcm ((b bytes)) bool (msg_starts b (mic_pcm_tag)))
(def mic_pcm_at () int (add (header_len) 3))
