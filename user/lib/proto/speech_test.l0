; speech_test.l0 -- tests of speech.l0: its notices made and read back,
; and its requests read.

; A notice as speech_event_of reads it, as text.
(def event_text ((e SpeechEvent)) (list int)
  (match e
    ((SpeechState s) s)
    ((SpeechHeard t) (append "heard: " (bytes_to_list t)))
    ((SpeechError w) (append "error: " (bytes_to_list w)))
    ((SpeechNone) "none")))

; Notice bytes as a message from pid 9 holds them.
(def read_back ((b bytes)) (list int)
  (match (message_new 9 (bytes_to_list b))
    ((Message from mb) (event_text (speech_event_of mb)))
    ((RecvFailed) "no message")))

; A request's words, read, as text.
(def req_text ((line (list int))) (list int)
  (match (speech_req_of (split_spaces line))
    ((SpListen) "listen")
    ((SpStop) "stop")
    ((SpHear p) (append "hear " p))
    ((SpMute on) (if on "mute on" "mute off"))
    ((SpOpen p) (append "open " (digits p)))
    ((SpClose p) (append "close " (digits p)))
    ((SpWrong why) "wrong")))

(def test_state_notice () int
  (check_str "bytes" (bytes_to_list (speech_state_notice "listening")) "speech listening"))

(def test_state_read_back () int
  (check_str "held" (read_back (speech_state_notice "held")) "held"))

(def test_heard_read_back () int
  (check_str "heard" (read_back (speech_heard_notice (bytes_from_list "Testing, testing."))) "heard: Testing, testing."))

(def test_error_read_back () int
  (check_str "error" (read_back (speech_error_notice (bytes_from_list "no mic"))) "error: no mic"))

(def test_unknown_state_is_none () int
  (check_str "none" (read_back (bytes_from_list "speech sleeping")) "none"))

(def test_other_message_is_none () int
  (check_str "none" (read_back (bytes_from_list "agent done end")) "none"))

(def test_requests () int
  (add (check_str "listen" (req_text "listen") "listen")
       (add (check_str "hear" (req_text "hear /etc/clip.wav") "hear /etc/clip.wav")
            (check_str "open" (req_text "open 12") "open 12"))))

(def test_mute () int
  (add (check_str "on" (req_text "mute on") "mute on")
       (add (check_str "off" (req_text "mute off") "mute off")
            (check_str "other" (req_text "mute loudly") "wrong"))))

(def test_wrong_requests () int
  (add (check_str "none" (req_text "") "wrong")
       (check_str "port" (req_text "open twelve") "wrong")))

(def test_bodies () int
  (add (check_str "open" (speech_open_body 5) "open 5")
       (check_str "hear" (speech_hear_body "/a.wav") "hear /a.wav")))

; Under an operating system there is no speech to ask.
(def test_ask_with_no_kernel () int
  (check_str "why" (speech_ask 1 "listen" 0) "speech is not running"))
