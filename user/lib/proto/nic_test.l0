; nic_test.l0 -- tests of nic.l0: Ethernet addresses as text, and the
; driver's notices and requests.

(def qemu_mac () (list int) (cons 82 (cons 84 (cons 0 (cons 18 (cons 52 (cons 86 (nil int))))))))

(def test_mac_text () int
  (add (check_str "QEMU's" (mac_text (qemu_mac)) "52:54:00:12:34:56")
       (check_str "everyone" (mac_text (mac_broadcast)) "ff:ff:ff:ff:ff:ff")))

(def test_mac_parse () int
  (add (check_bool "read back" (eq (mac_parse "52:54:00:12:34:56") (Some (qemu_mac))) true)
       (check_bool "either case" (eq (mac_parse "FF:ff:FF:ff:FF:ff") (Some (mac_broadcast))) true)))

(def test_mac_parse_bad () int
  (add (check_bool "five" (eq (mac_parse "52:54:00:12:34") ((None (list int)))) true)
       (add (check_bool "not hex" (eq (mac_parse "52:54:00:12:34:5g") ((None (list int)))) true)
            (check_bool "one digit" (eq (mac_parse "52:54:00:12:34:5") ((None (list int)))) true))))

; A notice holds a frame of at least a header.
(def test_frame_of () int
  (add (check_bool "a frame" (eq (frame_of (frame_notice (zeros 14))) (Some (zeros 14))) true)
       (add (check_bool "too short" (eq (frame_of (frame_notice (zeros 13))) ((None (list int)))) true)
            (check_bool "another notice" (eq (frame_of (append "key" (zeros 14))) ((None (list int)))) true))))

(def test_send_body () int
  (add (check_bool "read back" (eq (nic_sent_frame (nic_send_body "frame")) (Some "frame")) true)
       (check_bool "another" (eq (nic_sent_frame "info") ((None (list int)))) true)))

(def test_info_of () int
  (add (check_bool "an address" (eq (nic_info_of "nic 52:54:00:12:34:56") (Some (qemu_mac))) true)
       (check_bool "an error" (eq (nic_info_of "error: no") ((None (list int)))) true)))

(def test_refusal () int
  (add (check_str "too short" (nic_frame_refusal (zeros 13)) "a frame has at least 14 bytes")
       (add (check_str "too long" (nic_frame_refusal (zeros 1515)) "a frame has at most 1514 bytes")
            (check_str "fine" (nic_frame_refusal (zeros 60)) ""))))

(def test_counts () int
  (check_str "counted" (nic_counts_text (nic_counted_tx (nic_counted_rx (nic_counted_rx (NicCounts 0 0 0) true) false) true))
             "rx 1 tx 1 dropped 1"))

; A short frame is padded to 60 bytes; a long one is as it was.
(def test_padded () int
  (add (check_int "padded" (length (nic_padded (repeat 14 7))) 60)
       (add (check_int "zeros after" (nth (nic_padded (repeat 14 7)) 14) 0)
            (check_int "not padded" (length (nic_padded (zeros 1514))) 1514))))
