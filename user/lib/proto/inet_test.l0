; inet_test.l0 -- tests of inet.l0: addresses as text, and the stack's
; requests, answers and notices, read back as they are made.

; A notice's first line, which inet joins a datagram's bytes to, is all
; of udp_notice before its content.
(def test_udp_notice_head () int
  (check_str "head" (udp_notice_head 167772674 69 49152) "udp 10.0.2.2 69 49152\n"))

(def test_ip_of () int
  (add (check_int "10.0.2.15" (ip_of 10 0 2 15) 167772687)      ; 10 * 2^24 + 2 * 256 + 15
       (check_int "its last byte" (ip_byte (ip_of 10 0 2 15) 3) 15)))

(def test_ip_parse () int
  (add (check_bool "dotted" (eq (ip_parse "10.0.2.15") (Some 167772687)) true)
       (check_bool "everyone" (eq (ip_parse "255.255.255.255") (Some (ip_broadcast))) true)))

(def test_ip_parse_bad () int
  (add (check_bool "over 255" (eq (ip_parse "10.0.2.256") ((None int))) true)
       (add (check_bool "three" (eq (ip_parse "10.0.2") ((None int))) true)
            (add (check_bool "empty part" (eq (ip_parse "10..2.15") ((None int))) true)
                 (check_bool "a name" (eq (ip_parse "example.com") ((None int))) true)))))

(def test_ip_text () int
  (add (check_str "dotted" (ip_text 167772687) "10.0.2.15")
       (check_str "zero" (ip_text 0) "0.0.0.0")))

(def test_ip_mask () int
  (add (check_str "24 bits" (ip_text (ip_mask 24)) "255.255.255.0")
       (add (check_str "12 bits" (ip_text (ip_mask 12)) "255.240.0.0")
            (check_int "and back" (ip_prefix_len (ip_mask 12)) 12))))

; An address as random as rand_next makes it, read back from its text.
(def round_trips ((seed int) (n int) (bad int)) int
  (if (eq n 0)
      bad
      (let a (rand_below seed 4294967296)
        (round_trips (rand_next seed) (sub n 1) (if (eq (ip_parse (ip_text a)) (Some a)) bad (add bad 1))))))

(def test_ip_round_trip () int
  (check_int "all read back" (round_trips 7 300 0) 0))

(def test_info_round_trip () int
  (let i (InetInfo 167772687 (ip_mask 24) 167772674 (repeat 6 18))
    (add (check_str "as text" (inet_info_text i) "inet 10.0.2.15 255.255.255.0 10.0.2.2 12:12:12:12:12:12")
         (check_bool "read back" (eq (inet_info_of (inet_info_text i)) ((Ok InetInfo (list int)) i)) true))))

(def test_info_error () int
  (check_bool "the error" (eq (inet_info_of "error: down") ((Err InetInfo (list int)) "down")) true))

(def test_send_body () int
  (check_str "words, a newline, the data" (udp_send_body 49152 167772674 53 "a b") "send 49152 10.0.2.2 53\na b"))

(def test_datagram_round_trip () int
  (let d (Datagram 167772674 69 49152 "line\nmore")
    (add (check_str "as a notice" (udp_notice d) "udp 10.0.2.2 69 49152\nline\nmore")
         (check_bool "read back" (eq (datagram_of (udp_notice d)) (Some d)) true))))

(def test_datagram_bad () int
  (add (check_bool "another notice" (eq (datagram_of "pong 1.2.3.4 1 2 3") ((None Datagram))) true)
       (check_bool "no ports" (eq (datagram_of "udp 10.0.2.2 69\nx") ((None Datagram))) true)))

(def test_pong_round_trip () int
  (let p (Pong 167772674 3 255 64)
    (add (check_str "as a notice" (pong_notice p) "pong 10.0.2.2 3 255 64")
         (check_bool "read back" (eq (pong_of (pong_notice p)) (Some p)) true))))

; Under an operating system there is no stack: every request fails.
(def test_no_inet () int
  (let n (inet_open)
    (add (check_str "no stack" (inet_ask n "info") "error: no network; is inet running?")
         (check_bool "no binding" (eq (udp_bind n 0) ((Err int (list int)) "no network; is inet running?")) true))))

; A datagram too big for one frame is refused before it is sent.
(def test_too_big () int
  (check_str "refused" (udp_send (Inet 1 2) 1 2 3 (zeros 1473)) "a datagram holds at most 1472 bytes"))

; ---------------------------------------------------------------------- TCP

; Each event as a notice, and read back from it.
(def event_round_trips ((es (list TcpEvent)) (bad int)) int
  (if (is_empty es)
      bad
      (event_round_trips (tail es) (if (eq (tcp_event_of (tcp_notice (head es))) (Some (head es))) bad (add bad 1)))))

(def events () (list TcpEvent)
  (cons (TcpUp 3) (cons (TcpAccepted 4 167772674 49999 7000) (cons (TcpData 5 "line\nmore") (cons (TcpData 5 "")
  (cons (TcpFin 6) (cons (TcpClosed 7 "closed") (cons (TcpClosed 7 "timed out") (cons (TcpRoom 8 8576) (nil TcpEvent))))))))))

(def test_tcp_room_notice () int
  (add (check_str "room" (tcp_notice (TcpRoom 8 8576)) "tcp 8 room 8576")
       (add (check_bool "no number" (eq (tcp_event_of "tcp 8 room") ((None TcpEvent))) true)
            (check_bool "two" (eq (tcp_event_of "tcp 8 room 1 2") ((None TcpEvent))) true))))

; ------------------------------------------------------------- in place

; The bytes of a message from pid 30 with payload p, as received.
(def notice_bytes ((p (list int))) bytes
  (match (message_new 30 p) ((Message f b) b) ((RecvFailed) (bytes_from_list (nil int)))))

; A data notice read in place: its data begins after the pid's 4 bytes
; and "tcp 9 data\n"'s 11, at 15.
(def test_tcp_event_in_data () int
  (let b (notice_bytes "tcp 9 data\nhello\nworld")
    (match (tcp_event_in b)
      ((None) (fail_because "data" "not read"))
      ((Some e)
        (add (check_bool "at 15" (eq e (TcpDataAt 9 15)) true)
             (check_str "the data" (bytes_range b 15 (bytes_len b)) "hello\nworld"))))))

; Data that is empty is still data, at the end.
(def test_tcp_event_in_empty () int
  (check_bool "at the end" (eq (tcp_event_in (notice_bytes "tcp 9 data\n")) (Some (TcpDataAt 9 15))) true))

; The other kinds read in place as tcp_event_of reads them.
(def test_tcp_event_in_kinds () int
  (add (check_bool "up" (eq (tcp_event_in (notice_bytes "tcp 3 up")) (Some (TcpUp 3))) true)
       (add (check_bool "room" (eq (tcp_event_in (notice_bytes "tcp 8 room 8576")) (Some (TcpRoom 8 8576))) true)
            (add (check_bool "closed" (eq (tcp_event_in (notice_bytes "tcp 7 closed reset")) (Some (TcpClosed 7 "reset"))) true)
                 (check_bool "accepted" (eq (tcp_event_in (notice_bytes "tcp 4 accepted 10.0.2.2 49999 7000")) (Some (TcpAccepted 4 167772674 49999 7000))) true)))))

; Not a tcp notice, data with no newline, data with more words: none.
(def test_tcp_event_in_bad () int
  (add (check_bool "udp" (eq (tcp_event_in (notice_bytes "udp 10.0.2.2 69 49152\nx")) ((None TcpEvent))) true)
       (add (check_bool "no newline" (eq (tcp_event_in (notice_bytes "tcp 9 data")) ((None TcpEvent))) true)
            (check_bool "more words" (eq (tcp_event_in (notice_bytes "tcp 9 data x\ny")) ((None TcpEvent))) true))))

; A data notice's first line, which inet joins to the data as bytes.
(def test_tcp_data_at_notice () int
  (check_str "the head" (tcp_notice (TcpDataAt 9 15)) "tcp 9 data\n"))

(def test_tcp_events_round_trip () int
  (check_int "all read back" (event_round_trips (events) 0) 0))

(def test_tcp_notices () int
  (add (check_str "up" (tcp_notice (TcpUp 3)) "tcp 3 up")
       (add (check_str "accepted" (tcp_notice (TcpAccepted 4 167772674 49999 7000)) "tcp 4 accepted 10.0.2.2 49999 7000")
            (add (check_str "data, its bytes after a newline" (tcp_notice (TcpData 5 "a b\nc")) "tcp 5 data\na b\nc")
                 (add (check_str "fin" (tcp_notice (TcpFin 6)) "tcp 6 fin")
                      (check_str "closed, and why" (tcp_notice (TcpClosed 7 "reset")) "tcp 7 closed reset"))))))

; Notices that are not these.
(def test_tcp_event_bad () int
  (add (check_bool "another notice" (eq (tcp_event_of "udp 10.0.2.2 69 49152\nx") ((None TcpEvent))) true)
       (add (check_bool "no number" (eq (tcp_event_of "tcp x up") ((None TcpEvent))) true)
            (add (check_bool "no kind" (eq (tcp_event_of "tcp 3") ((None TcpEvent))) true)
                 (add (check_bool "an unknown kind" (eq (tcp_event_of "tcp 3 dance") ((None TcpEvent))) true)
                      (add (check_bool "up with more" (eq (tcp_event_of "tcp 3 up now") ((None TcpEvent))) true)
                           (check_bool "accepted with a bad address" (eq (tcp_event_of "tcp 3 accepted x 1 2") ((None TcpEvent))) true)))))))

; Under an operating system there is no stack: nothing connects, listens,
; or is written to.
(def test_tcp_no_inet () int
  (let n (inet_open)
    (add (check_bool "connect" (eq (tcp_connect n 9 167772674 80) ((Err int (list int)) "no network; is inet running?")) true)
         (add (check_bool "listen" (eq (tcp_listen n 9 7000) ((Err int (list int)) "no network; is inet running?")) true)
              (add (check_str "unlisten" (tcp_unlisten n 7000) "no network; is inet running?")
                   (add (check_str "write" (tcp_write n 1 "x") "no network; is inet running?")
                        (add (check_str "finish" (tcp_finish n 1) "no network; is inet running?")
                             (check_str "reset" (tcp_reset n 1) "no network; is inet running?"))))))))

; ------------------------------------------------------------------ names

; A result as text: the address dotted, or why not.
(def resolved_text ((r (Result int (list int)))) (list int)
  (match r ((Ok a) (ip_text a)) ((Err why) why)))

(def test_dns_of () int
  (add (check_str "a server" (resolved_text (inet_dns_of "dns 10.0.2.3")) "10.0.2.3")
       (add (check_str "none" (resolved_text (inet_dns_of "dns 0.0.0.0")) "0.0.0.0")
            (check_str "an error" (resolved_text (inet_dns_of "error: no")) "no"))))

; An address needs no name server, nor inet.
(def test_resolve_dotted () int
  (check_str "itself" (resolved_text (inet_resolve (NoInet "none") "10.0.2.2")) "10.0.2.2"))

; A name does: with no inet, why not.
(def test_resolve_no_inet () int
  (check_str "no inet" (resolved_text (inet_resolve (NoInet "no network") "example.com")) "no network"))

; What is not a name is refused before anything is asked.
(def test_resolve_bad_name () int
  (check_str "refused" (resolved_text (inet_resolve_at (Inet 1 2) "a..b" 1 53)) "not a name: a..b"))

; A query's id is 16 bits. Under an operating system there is no random,
; so it is the clock's.
(def test_resolve_id () int
  (let id (resolve_id (Inet 1 2))
    (check_true "16 bits" (if (ge id 0) (lt id 65536) false))))

; The server's answer to the query, as a udp notice to port 49152 from
; 10.0.2.3 port 53: 1.2.3.4. One from elsewhere, or to another port, or
; another query's, is not it.
(def test_resolve_heard () int
  (let ans (append (answer_header 9) (append (drop (dns_query 9 "a.bc") 12) (answer_a (ip_of 1 2 3 4))))
    (let server (ip_of 10 0 2 3)
      (add (check_str "the answer" (heard_text (resolve_heard (udp_notice (Datagram server 53 49152 ans)) server 53 49152 9)) "1.2.3.4")
           (add (check_str "another server" (heard_text (resolve_heard (udp_notice (Datagram (ip_of 10 0 2 4) 53 49152 ans)) server 53 49152 9)) "not it")
                (add (check_str "another port" (heard_text (resolve_heard (udp_notice (Datagram server 53 49153 ans)) server 53 49152 9)) "not it")
                     (check_str "another query" (heard_text (resolve_heard (udp_notice (Datagram server 53 49152 ans)) server 53 49152 10)) "not it")))))))

; An answer's header: the id, a response with recursion, no error, one
; question and one answer.
(def answer_header ((id int)) (list int)
  (append (dns_be16 id) (append (cons 129 (cons 128 (nil int))) (append (dns_be16 1) (append (dns_be16 1) (zeros 4))))))

; An A record of the question's name, a pointer to 12, for address a.
(def answer_a ((a int)) (list int)
  (append (cons 192 (cons 12 (nil int)))
    (append (dns_be16 1) (append (dns_be16 1) (append (zeros 4) (append (dns_be16 4)
      (cons (ip_byte a 0) (cons (ip_byte a 1) (cons (ip_byte a 2) (cons (ip_byte a 3) (nil int)))))))))))

; What resolve_heard found, as text.
(def heard_text ((h (Option (Result int (list int))))) (list int)
  (match h ((None) "not it") ((Some r) (resolved_text r))))

; A write of nothing needs no one.
(def test_tcp_write_nothing () int
  (check_str "empty" (tcp_write (Inet 1 2) 1 (nil int)) ""))

; Without a kernel every send finds a full queue: given up after as many
; tries as there are, and not a moment earlier.
(def test_tcp_write_full () int
  (check_str "given up" (tcp_write_chunk 1 1 "x" (tcp_write_tries)) "inet does not take its requests"))

; What tcp_write_bytes did, as text: the notices kept, then why.
(def wrote_text ((w TcpWrote)) (list int)
  (match w ((TcpWrote kept why) (append (digits (length kept)) (append " kept; " why)))))

; Writing bytes: with no stack, why; nothing to write needs no one.
(def test_tcp_write_bytes_none () int
  (let b (bytes_from_list "hello")
    (add (check_str "no inet" (wrote_text (tcp_write_bytes (NoInet "no network") 9 1 b 0 5)) "0 kept; no network")
         (check_str "empty" (wrote_text (tcp_write_bytes (Inet 1 2) 9 1 b 3 3)) "0 kept; "))))

; A request inet never takes is given up after its tries, as an error.
(def test_tcp_write_asked_full () int
  (check_str "given up" (tcp_write_asked 1 2 (bytes_from_list "x") (tcp_write_tries)) "error: inet does not take its requests"))

; Waiting for room on a port that fails gives up, keeping what came.
(def test_tcp_room_wait_fails () int
  (check_str "no notice" (wrote_text (tcp_room_wait 9 1 (nil bytes))) "0 kept; no notice came from inet"))
