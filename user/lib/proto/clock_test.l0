(def civil_text ((c Civil)) (list int)
  (match c ((Civil y m d) (append (digits y) (append "-" (append (digits m) (append "-" (digits d))))))))

(def test_civil_epoch () int
  (check_str "1970" (civil_text (civil 0)) "1970-1-1"))

; 951782400 is 2000-02-29, a leap day in a year divisible by 400.
(def test_civil_leap_day () int
  (add (check_str "the leap day" (civil_text (civil (div 951782400 86400))) "2000-2-29")
       (check_str "the day after" (civil_text (civil (add (div 951782400 86400) 1))) "2000-3-1")))

(def test_civil_year_end () int
  (add (check_str "2099's last day" (civil_text (civil (div 4102444799 86400))) "2099-12-31")
       (check_str "2100's first" (civil_text (civil (add (div 4102444799 86400) 1))) "2100-1-1")))

(def test_clock_text () int
  (add (check_str "midnight" (clock_text 1792108800) "Oct 16  00:00")
       (add (check_str "a minute before" (clock_text 1792108799) "Oct 15  23:59")
            (check_str "the epoch" (clock_text 0) "Jan 1  00:00"))))

(def test_hh_mm () int
  (add (check_str "padded" (hh_mm 3723) "01:02")
       (check_str "the last minute" (hh_mm 86399) "23:59")))

(def test_next_minute () int
  (add (check_int "on the minute" (next_minute 120) 180)
       (check_int "within it" (next_minute 179) 180)))

(def test_time_notice () int
  (add (check_str "written" (time_notice 1792108800) "time 1792108800")
       (check_bool "read back" (eq (time_of (time_notice 1792108800)) (Some 1792108800)) true)))

(def test_time_of_bad () int
  (add (check_bool "no number" (eq (time_of "time ") ((None int))) true)
       (add (check_bool "not a number" (eq (time_of "time 12x") ((None int))) true)
            (check_bool "not a time" (eq (time_of "ok") ((None int))) true))))

(def test_clock_set_body () int
  (add (check_str "written" (clock_set_body 1793318400) "set 1793318400")
       (check_bool "read back" (eq (clock_set_of (clock_set_body 1793318400)) (Some 1793318400)) true)))

(def test_clock_set_of_bad () int
  (add (check_bool "no number" (eq (clock_set_of "set ") ((None int))) true)
       (add (check_bool "negative" (eq (clock_set_of "set -5") ((None int))) true)
            (check_bool "not a set" (eq (clock_set_of "time") ((None int))) true))))

; Under an operating system there is no clock to ask.
(def test_clock_set_none () int
  (check_true "why" (not (is_empty (clock_set 5 (port_new) 60)))))

(def zone_text ((z (Option ClockZone))) (list int)
  (match z
    ((Some c) (append (digits (.minutes c)) (cons 32 (digits (.until c)))))
    ((None) "none")))

; PDT, 7 hours west, until 2026-11-01 09:00 UTC.
(def test_zone_notice () int
  (add (check_str "written" (zone_notice (ClockZone -420 1793523600)) "zone -420 1793523600")
       (check_str "read back" (zone_text (zone_of (zone_notice (ClockZone -420 1793523600)))) "-420 1793523600")))

(def test_zone_of_east () int
  (check_str "east" (zone_text (zone_of "zone 330 1793523600")) "330 1793523600"))

(def test_zone_of_bad () int
  (add (check_str "no until" (zone_text (zone_of "zone -420")) "none")
       (add (check_str "not a number" (zone_text (zone_of "zone -4x 5")) "none")
            (check_str "not a zone" (zone_text (zone_of "time 60 5")) "none"))))

; Under an operating system there is no clock to ask, so the zone is UTC.
(def test_clock_zone_none () int
  (check_str "utc" (zone_text (Some (clock_zone 5 (port_new)))) (append "0 " (digits (zone_never)))))

(def test_zone_holds () int
  (add (check_bool "before" (zone_holds (ClockZone -420 100) 99) true)
       (check_bool "at the change" (zone_holds (ClockZone -420 100) 100) false)))

; 1793400120 is 2026-10-30 22:42 UTC: 15:42 in PDT, 22:42 in UTC.
(def test_zone_local () int
  (add (check_str "PDT" (clock_text (zone_local (ClockZone -420 1793523600) 1793400120)) "Oct 30  15:42")
       (add (check_str "UTC" (clock_text (zone_local (zone_utc) 1793400120)) "Oct 30  22:42")
            (check_str "across midnight" (clock_text (zone_local (ClockZone -480 0) 1793318400)) "Oct 29  16:00"))))

(def test_utc_text () int
  (check_str "says so" (utc_text 1793400120) "Oct 30  22:42 UTC"))
