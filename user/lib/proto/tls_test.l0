; tls_test.l0 -- tests of tls.l0: RFC 8448's simple 1-RTT handshake
; run through the client, its ClientHello and X25519 secret given, the
; server's records fed in as they came, and what the client sends
; compared with the trace's records byte for byte; then data both ways,
; and each close; and what a broken handshake gives.

; ---------------------------------------------------------------- helpers

; The bytes the hex digits s spell, two a byte.
(def unhex ((s (list int))) bytes (bytes_from_list (unhex_onto s (nil int))))
(def unhex_onto ((s (list int)) (acc (list int))) (list int)
  (if (or (is_empty s) (is_empty (tail s)))
      (rev acc)
      (unhex_onto (tail (tail s)) (cons (add (mul (hex_val (head s)) 16) (hex_val (head (tail s)))) acc))))

; b as hex digits.
(def hex_of ((b bytes)) (list int) (hex_from b 0 (nil int)))
(def hex_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b)) (rev acc) (hex_from b (add i 1) (rev_onto (hex_digits (bytes_get b i) 2) acc))))

; The pieces bs joined, as hex.
(def hex_all ((bs (list bytes))) (list int) (hex_of (bytes_concat bs)))

; The time the trace's certificate is checked at: 2018-01-01.
(def r_now () int 1514764800)

; A connection begun as the trace's client began it, its certificate
; the one root.
(def r_begun () TlsOut
  (tls_begin "rsa" (r_priv) (r_hello) (trust_roots_of (cons (r_cert) (nil bytes))) (r_now)))

; b fed to t whole.
(def fed ((t Tls) (b bytes)) TlsOut (tls_more t b 0 (bytes_len b)))

; The connection after the server's whole handshake, fed in one go.
(def r_shaken () TlsOut
  (let o (fed (.t (r_begun)) (r_sh_record))
    (fed (.t o) (r_flight))))

; RFC 8448 3's the client's X25519 secret.
(def r_priv () bytes (unhex "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"))

; RFC 8448 3's the ClientHello message.
(def r_hello () bytes (unhex ""))

; RFC 8448 3's the ClientHello's record.
(def r_ch_record () bytes (unhex ""))

; RFC 8448 3's the ServerHello's record.
(def r_sh_record () bytes (unhex "160303005a020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"))

; RFC 8448 3's the server's encrypted flight: EncryptedExtensions, Certificate, CertificateVerify, Finished.
(def r_flight () bytes (unhex ""))

; RFC 8448 3's the client's Finished, sealed.
(def r_cfin_record () bytes (unhex "170303003575ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546"))

; RFC 8448 3's the server's NewSessionTicket, sealed.
(def r_ticket () bytes (unhex ""))

; RFC 8448 3's the client's application data.
(def r_c_data () bytes (unhex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))

; RFC 8448 3's that data sealed.
(def r_c_data_record () bytes (unhex "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"))

; RFC 8448 3's the server's application data.
(def r_s_data () bytes (unhex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"))

; RFC 8448 3's that data sealed.
(def r_s_data_record () bytes (unhex "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"))

; RFC 8448 3's the client's close_notify, sealed.
(def r_c_alert_record () bytes (unhex "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"))

; RFC 8448 3's the server's close_notify, sealed.
(def r_s_alert_record () bytes (unhex "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9"))

; RFC 8448 3's server certificate, CN=rsa, self-signed.
(def r_cert () bytes (unhex ""))

; ------------------------------------------------------------------- hello

; The ClientHello's record is the trace's.
(def test_hello_record () int
  (check_str "record" (hex_all (.send (r_begun))) (hex_of (r_ch_record))))

; A ClientHello of our own: a handshake message of type 1 whose length
; is right, naming the host, with the key share of the secret.
(def test_own_hello () int
  (let h (tls_hello "example.com" (r_priv) (x25519_base (r_priv)))
    (add (check_int "type" (bytes_get h 0) 1)
         (add (check_int "length" (tls_u24 h 1) (sub (bytes_len h) 4))
              (check_bool "names the host" (contains (bytes_to_list h) "example.com") true)))))

; An address is not named in the ClientHello.
(def test_hello_address () int
  (check_bool "no name" (contains (bytes_to_list (tls_hello "10.0.2.2" (r_priv) (x25519_base (r_priv)))) "10.0.2.2") false))

; ---------------------------------------------------------------- handshake

; After the ServerHello the client waits for EncryptedExtensions, keyed.
(def test_server_hello () int
  (let o (fed (.t (r_begun)) (r_sh_record))
    (add (check_int "stage" (.stage (.t o)) (tls_stage_ee))
         (check_str "why" (tls_why (.t o)) ""))))

; The whole handshake: up, and the client's Finished is the trace's.
(def test_handshake () int
  (let o (r_shaken)
    (add (check_str "why" (tls_why (.t o)) "")
         (add (check_bool "up" (tls_up (.t o)) true)
              (check_str "finished" (hex_all (.send o)) (hex_of (r_cfin_record)))))))

; The server's records fed a byte at a time give the same.
(def test_handshake_bytewise () int
  (let o (fed_bytes (TlsOut (.t (r_begun)) (nil bytes) (nil bytes)) (bytes_concat (cons (r_sh_record) (cons (r_flight) (nil bytes)))) 0)
    (add (check_bool "up" (tls_up (.t o)) true)
         (check_str "finished" (hex_all (rev (.send o))) (hex_of (r_cfin_record))))))

; b fed to o's connection a byte at a time from i, the records sent
; reversed onto o's.
(def fed_bytes ((o TlsOut) (b bytes) (i int)) TlsOut
  (if (ge i (bytes_len b))
      o
      (match (tls_more (.t o) b i (add i 1))
        ((TlsOut t s g) (fed_bytes (TlsOut t (rev_onto s (.send o)) (.got o)) b (add i 1))))))

; A certificate the roots do not hold fails the handshake.
(def test_untrusted () int
  (let (o0 (tls_begin "rsa" (r_priv) (r_hello) (trust_roots_of (nil bytes)) (r_now))
        o (fed (.t (fed (.t o0) (r_sh_record))) (r_flight)))
    (add (check_bool "failed" (tls_failed (.t o)) true)
         (check_bool "says the certificate" (starts_with (tls_why (.t o)) "the server's certificate: ") true))))

; The wrong host fails it.
(def test_wrong_host () int
  (let (o0 (tls_begin "example.com" (r_priv) (r_hello) (trust_roots_of (cons (r_cert) (nil bytes))) (r_now))
        o (fed (.t (fed (.t o0) (r_sh_record))) (r_flight)))
    (check_bool "failed" (tls_failed (.t o)) true)))

; A certificate out of date fails it: 2027.
(def test_expired () int
  (let (o0 (tls_begin "rsa" (r_priv) (r_hello) (trust_roots_of (cons (r_cert) (nil bytes))) 1798761600)
        o (fed (.t (fed (.t o0) (r_sh_record))) (r_flight)))
    (check_bool "failed" (tls_failed (.t o)) true)))

; A flipped byte in the encrypted flight fails it, as a record that
; does not decrypt.
(def test_tampered_flight () int
  (let (f (r_flight)
        bad (bytes_concat (cons (bytes_slice f 0 40) (cons (bytes_from_list (cons (bit_xor (bytes_get f 40) 1) (nil int))) (cons (bytes_slice f 41 (bytes_len f)) (nil bytes)))))
        o (fed (.t (fed (.t (r_begun)) (r_sh_record))) bad))
    (check_str "why" (tls_why (.t o)) "a record from the server did not decrypt")))

; A server alert before the handshake fails it, saying the alert.
(def test_alert () int
  (let o (fed (.t (r_begun)) (bytes_from_list (cons 21 (cons 3 (cons 3 (cons 0 (cons 2 (cons 2 (cons 40 (nil int))))))))))
    (check_str "why" (tls_why (.t o)) "the server's alert: handshake_failure (40)")))

; Data cannot be sent before the handshake.
(def test_send_early () int
  (check_bool "failed" (tls_failed (.t (tls_send (.t (r_begun)) (r_c_data) 0 1))) true))

; -------------------------------------------------------------------- data

; The session ticket is passed over, and the server's data opened.
(def test_server_data () int
  (let (o (fed (.t (fed (.t (r_shaken)) (r_ticket))) (r_s_data_record)))
    (add (check_bool "up" (tls_up (.t o)) true)
         (check_str "data" (hex_all (.got o)) (hex_of (r_s_data))))))

; The client's data sealed is the trace's record.
(def test_client_data () int
  (let o (tls_send (.t (r_shaken)) (r_c_data) 0 (bytes_len (r_c_data)))
    (check_str "record" (hex_all (.send o)) (hex_of (r_c_data_record)))))

; Then its close_notify is the trace's.
(def test_client_close () int
  (let (o (tls_send (.t (r_shaken)) (r_c_data) 0 (bytes_len (r_c_data)))
        c (tls_close (.t o)))
    (check_str "record" (hex_all (.send c)) (hex_of (r_c_alert_record)))))

; The server's close_notify closes it.
(def test_server_close () int
  (let o (fed (.t (fed (.t (fed (.t (r_shaken)) (r_ticket))) (r_s_data_record))) (r_s_alert_record))
    (check_bool "closed" (tls_closed (.t o)) true)))

; Data longer than a record is sealed into several.
(def test_send_long () int
  (let o (tls_send (.t (r_shaken)) (bytes_from_list (tls_be 0 40000 (nil int))) 0 40000)
    (check_int "records" (length (.send o)) 3)))
