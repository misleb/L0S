; uuid.l0 -- UUIDs, as RFC 9562 has them: 16 bytes, most significant
; first; their text, 36 characters, 8-4-4-4-12 hex digits; the order GPT
; keeps them in, its first three fields least significant first; and new
; ones of version 7, which begin with the time in Unix milliseconds and
; are noise after it.
;
; L0S has no source of randomness: the noise is a mixer's, splitmix64,
; seeded from the clock, so it tells UUIDs apart that are made apart, but
; can be guessed. uuid_new reads the clock; everything else is pure.

; A UUID: its 16 bytes, most significant first.
(data Uuid (Uuid (list int)))

; Its bytes.
(def uuid_bytes ((u Uuid)) (list int) (match u ((Uuid bs) bs)))

; The nil UUID, all zeros; n zeros; and whether u is the nil one.
(def uuid_nil () Uuid (Uuid (uuid_zeros 16)))

(def uuid_zeros ((n int)) (list int) (if (le n 0) (nil int) (cons 0 (uuid_zeros (sub n 1)))))

(def uuid_is_nil ((u Uuid)) bool (eq u (uuid_nil)))

; Its version, the high four bits of byte 6.
(def uuid_version ((u Uuid)) int (bit_shr (uuid_nth (uuid_bytes u) 6) 4))

; Its variant's two bits, the high two of byte 8: 2 for RFC 9562's.
(def uuid_variant ((u Uuid)) int (bit_shr (uuid_nth (uuid_bytes u) 8) 6))

; Byte i of bs, 0 past its end.
(def uuid_nth ((bs (list int)) (i int)) int
  (if (is_empty bs) 0 (if (eq i 0) (head bs) (uuid_nth (tail bs) (sub i 1)))))

; ------------------------------------------------------------------- text

; Its text: lowercase hex, with a - after the 4th, 6th, 8th and 10th
; bytes.
(def uuid_text ((u Uuid)) (list int)
  (uuid_text_onto (uuid_bytes u) 0 (nil int)))

; The bytes from the i-th, in hex, dashed, onto acc.
(def uuid_text_onto ((bs (list int)) (i int) (acc (list int))) (list int)
  (if (is_empty bs)
      (rev acc)
      (let dash (if (any_eq i (cons 4 (cons 6 (cons 8 (cons 10 (nil int)))))) (cons 45 acc) acc)
        (uuid_text_onto (tail bs) (add i 1) (push (hex_digits (head bs) 2) dash)))))

; The UUID text spells, hex digits in either case, the dashes where
; uuid_text puts them; none if it spells none.
(def uuid_of_text ((s (list int))) (Option Uuid)
  (if (not (eq (length s) 36))
      ((None Uuid))
      (uuid_hex_bytes s 0 (nil int))))

; The bytes s spells from its i-th character, a dash where one goes,
; onto acc.
(def uuid_hex_bytes ((s (list int)) (i int) (acc (list int))) (Option Uuid)
  (if (is_empty s)
      (Some (Uuid (rev acc)))
      (if (any_eq i (cons 8 (cons 13 (cons 18 (cons 23 (nil int))))))
          (if (eq (head s) 45) (uuid_hex_bytes (tail s) (add i 1) acc) ((None Uuid)))
          (if (is_empty (tail s))
              ((None Uuid))
              (let hi (hex_val (head s))
                (let lo (hex_val (head (tail s)))
                  (if (if (lt hi 0) true (lt lo 0))
                      ((None Uuid))
                      (uuid_hex_bytes (tail (tail s)) (add i 2) (cons (add (mul hi 16) lo) acc)))))))))

; ---------------------------------------------------------------- GUIDs

; Its bytes as GPT keeps them: the first four, then the next two, then
; the next two, each field least significant first; the last eight as
; they are.
(def uuid_guid_bytes ((u Uuid)) (list int)
  (uuid_mixed (uuid_bytes u)))

; The UUID whose GPT bytes are the 16 from i of b.
(def uuid_of_guid ((b bytes) (i int)) Uuid
  (Uuid (uuid_mixed (uuid_range b i (add i 16) (nil int)))))

; The first three fields turned around: the same swap both ways.
(def uuid_mixed ((bs (list int))) (list int)
  (let p (array_from bs 0)
    (if (lt (array_len p) 16)
        bs
        (uuid_picked p (cons 3 (cons 2 (cons 1 (cons 0 (cons 5 (cons 4 (cons 7 (cons 6
                         (cons 8 (cons 9 (cons 10 (cons 11 (cons 12 (cons 13 (cons 14 (cons 15 (nil int)))))))))))))))))))))

; The bytes of p at the places is, in order.
(def uuid_picked ((p (array int)) (is (list int))) (list int)
  (if (is_empty is) (nil int) (cons (array_get p (head is)) (uuid_picked p (tail is)))))

; The bytes of b from i up to j, 0 past its end, onto acc.
(def uuid_range ((b bytes) (i int) (j int) (acc (list int))) (list int)
  (if (le j i) acc (uuid_range b i (sub j 1) (cons (if (lt (sub j 1) (bytes_len b)) (bytes_get b (sub j 1)) 0) acc))))

; ------------------------------------------------------------- version 7

; A version 7 UUID for Unix time ms, milliseconds since 1970, and noise,
; at least ten bytes: the time in bytes 0 to 5, most significant first;
; 7 in the high four bits of byte 6; RFC 9562's variant in the high two
; of byte 8; the noise in every bit left.
(def uuid_v7 ((ms int) (noise (list int))) Uuid
  (let n (array_from (append noise (uuid_zeros 10)) 0)
    (Uuid (append (uuid_be (bit_and ms 281474976710655) 6)
          (cons (bit_or 112 (bit_and (array_get n 0) 15))
          (cons (array_get n 1)
          (cons (bit_or 128 (bit_and (array_get n 2) 63))
                (uuid_picked n (cons 3 (cons 4 (cons 5 (cons 6 (cons 7 (cons 8 (cons 9 (nil int))))))))))))))))

; The time a version 7 UUID begins with, in Unix milliseconds.
(def uuid_v7_ms ((u Uuid)) int
  (uuid_be_value (uuid_bytes u) 6 0))

; The first n of bs as a number, most significant first, after acc.
(def uuid_be_value ((bs (list int)) (n int) (acc int)) int
  (if (if (eq n 0) true (is_empty bs)) acc (uuid_be_value (tail bs) (sub n 1) (bit_or (bit_shl acc 8) (head bs)))))

; The low n bytes of v, most significant first.
(def uuid_be ((v int) (n int)) (list int)
  (uuid_be_onto v n (nil int)))

; The low n bytes of v onto acc, the least significant last.
(def uuid_be_onto ((v int) (n int) (acc (list int))) (list int)
  (if (le n 0) acc (uuid_be_onto (bit_shr v 8) (sub n 1) (cons (bit_and v 255) acc))))

; ----------------------------------------------------------------- noise

; splitmix64's next state from x, and the number it gives there.
(data UuidMix (UuidMix int int))

; One step of splitmix64: the state moved on by its odd constant, and
; that mixed by two multiplications and three shifts.
(def uuid_mix ((x int)) UuidMix
  (let s (add x -7046029254386353131)
    (let z1 (mul (bit_xor s (bit_shr s 30)) -4658895280553007687)
      (let z2 (mul (bit_xor z1 (bit_shr z1 27)) -7723592293110705685)
        (UuidMix s (bit_xor z2 (bit_shr z2 31)))))))

; n bytes of noise from seed: each number the mixer gives, most
; significant byte first, the last cut to fit. The same seed, the same
; bytes.
(def uuid_noise ((seed int) (n int)) (list int)
  (uuid_noise_onto seed n (nil int)))

; n more bytes of noise from state x, after acc.
(def uuid_noise_onto ((x int) (n int) (acc (list int))) (list int)
  (if (le n 0)
      acc
      (match (uuid_mix x)
        ((UuidMix s z) (uuid_noise_onto s (sub n 8) (append acc (uuid_first (uuid_be z 8) (min 8 n))))))))

; The first n of bs, or all of them if there are fewer.
(def uuid_first ((bs (list int)) (n int)) (list int)
  (if (if (le n 0) true (is_empty bs)) (nil int) (cons (head bs) (uuid_first (tail bs) (sub n 1)))))

; A new UUID, of version 7, for Unix time ms: its noise seeded from the
; time, the clock and salt, which a caller making many keeps changing,
; so that those made in one millisecond differ.
(def uuid_new ((ms int) (salt int)) Uuid
  (uuid_v7 ms (uuid_noise (bit_xor (bit_xor (clock_ns) (mul ms 31)) (mul salt -7046029254386353131)) 10)))
