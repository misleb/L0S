; server_test.l0 -- tests of server.l0. Under l0 test there is no kernel,
; so registering and binding fail, and a send's answer is SendFull.

(def nums_text ((r RequestNums)) (list int)
  (match r
    ((ReqNums op ns) (append op (append ": " (unwords (numbers_words ns)))))
    ((ReqBad why) (append "bad: " why))))

(def test_request_numbers () int
  (add (check_str "op and numbers" (nums_text (request_numbers "read 0 3221225472 -2")) "read: 0 3221225472 -2")
       (check_str "an op alone" (nums_text (request_numbers "info")) "info: ")))

(def test_request_numbers_bad () int
  (add (check_str "empty" (nums_text (request_numbers "")) "bad: no request")
       (check_str "a word" (nums_text (request_numbers "read 0 x")) "bad: read's arguments must be numbers")))

(def test_served () int
  (add (check_true "ok" (eq (served_ok 7) (Served 7 "ok")))
       (check_true "error" (eq (served_error 7 "no request x") (Served 7 "error: no request x")))))

(def test_listener_kept () int
  (add (check_true "sent" (listener_kept (Sent)))
       (add (check_true "full, but there" (listener_kept (SendFull)))
            (add (check_bool "gone" (listener_kept (SendNoPort)) false)
                 (check_bool "too big" (listener_kept (SendTooBig)) false)))))

; Listeners keep the order they came in, and none is added twice.
(def test_listener_add () int
  (let ls (listener_add (listener_add (nil int) 5 (Sent)) 9 (Sent))
    (add (check_str "in order" (unwords (numbers_words ls)) "5 9")
         (add (check_str "not twice" (unwords (numbers_words (listener_add ls 5 (Sent)))) "5 9")
              (check_str "not a gone one" (unwords (numbers_words (listener_add ls 4 (SendNoPort)))) "5 9")))))

; With no kernel each send is SendFull, which keeps every listener.
(def test_listeners_tell () int
  (check_str "all kept, in order" (unwords (numbers_words (listeners_tell (cons 3 (cons 1 (cons 2 (nil int)))) "time 0"))) "3 1 2"))

; Under an operating system there is no name table.
(def test_register_refused () int
  (check_true "refused" (starts_with (name_register_or_why 1 "echo") "cannot register as echo: ")))

(def test_bind_refused () int
  (check_true "refused" (starts_with (irq_bind_or_why 33 1) "cannot bind interrupt 33: ")))

(def test_no_reply_port () int
  (check_int "nothing sent" (request_answer "ab" "ok") 0))

; With no kernel beneath nothing is logged, so each line falls back to
; standard error; what each gives is the same.
(def test_log_statuses () int
  (add (check_int "info" (info_as "test" "an info line under l0 test") 0)
       (add (check_int "warn" (warn_as "test" "a warning under l0 test") 0)
            (add (check_int "debug" (debug_as "test" "a debug line under l0 test") 0)
                 (check_int "fail" (fail_as "test" "a failure under l0 test") 1)))))

; ------------------------------------------------------------- devices

; QEMU's PL011 and PL031 give these, as Linux's amba-pl011 and rtc-pl031
; expect: parts 0x011 and 0x031.
(def test_primecell_pl011 () int
  (check_int "a PL011" (primecell_part_of (cons 17 (cons 16 (cons 20 (cons 0 (cons 13 (cons 240 (cons 5 (cons 177 (nil int)))))))))) 17))

(def test_primecell_pl031 () int
  (check_int "a PL031" (primecell_part_of (cons 49 (cons 16 (cons 4 (cons 0 (cons 13 (cons 240 (cons 5 (cons 177 (nil int)))))))))) 49))

(def test_primecell_not () int
  (add (check_int "zeros" (primecell_part_of (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (nil int)))))))))) -1)
       (check_int "too few" (primecell_part_of (cons 17 (nil int))) -1)))
