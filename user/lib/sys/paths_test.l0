; paths_test.l0 -- tests of finding programs among paths, and of what
; there is with no kernel.

; Paths as program_paths gives them, and root_paths.
(def paths () (list (list int))
  (split_spaces "/bin/ /bin/sh /sbin/ /sbin/fs /Applications/ /Applications/Terminal.app/ /Applications/Terminal.app/vt /etc/ /etc/motd"))

(def test_entry_children () int
  (add (check_strs "/" (entry_children (paths) "/") (split_spaces "Applications/ bin/ etc/ sbin/"))
       (add (check_strs "/etc" (entry_children (paths) "/etc") (split_spaces "motd"))
            (check_strs "a bundle" (entry_children (paths) "/Applications") (split_spaces "Terminal.app/")))))

(def test_entry_is_child () int
  (add (check_true "a file" (entry_is_child "motd"))
       (add (check_true "a directory" (entry_is_child "bin/"))
            (add (check_bool "deeper" (entry_is_child "a/b") false)
                 (check_bool "empty" (entry_is_child "") false)))))

(def test_program_found () int
  (add (check_str "in /bin" (program_found "sh" (paths)) "/bin/sh")
       (add (check_str "in /sbin" (program_found "fs" (paths)) "/sbin/fs")
            (add (check_str "in a bundle" (program_found "vt" (paths)) "/Applications/Terminal.app/vt")
                 (check_str "none" (program_found "nope" (paths)) "")))))

(def test_program_found_path () int
  (add (check_str "a path there" (program_found "/etc/motd" (paths)) "/etc/motd")
       (add (check_str "a path not" (program_found "/bin/x" (paths)) "")
            (check_str "a volume's, found by spawn_path" (program_found "/Volumes/data/hello" (paths)) "/Volumes/data/hello"))))

; A path outside the directories programs are looked in, with / the
; initramfs, as it is with no kernel: not found unless among paths.
(def test_program_found_elsewhere () int
  (add (check_str "a file not listed" (program_found "/etc/filler/d1/f1" (paths)) "")
       (add (check_bool "not elsewhere" (path_elsewhere "/etc/filler/d1/f1") false)
            (check_true "a volume's is" (path_elsewhere "/Volumes/data/hello")))))

; Which names a listing of /Applications gives are bundles' directories.
(def test_is_bundle_entry () int
  (add (check_true "a bundle" (is_bundle_entry "Terminal.app/"))
       (add (check_bool "a file so named" (is_bundle_entry "Terminal.app") false)
            (add (check_bool "another directory" (is_bundle_entry "lib/") false)
                 (check_bool "empty" (is_bundle_entry "") false)))))

(def test_path_is_dir () int
  (add (check_true "/bin/" (path_is_dir "/bin/"))
       (check_bool "/bin/sh" (path_is_dir "/bin/sh") false)))

; Under an operating system there is no kernel: no entries, so no paths,
; and nothing started.
(def test_no_kernel () int
  (add (check_int "no paths" (length (root_paths)) 0)
       (add (check_int "no programs' paths" (length (program_paths)) 0)
       (add (check_true "from an entry" (eq (spawn_path "/bin/sh" ((None (list (list int))))) (SpawnNoEntry)))
            (add (check_true "from a volume" (eq (spawn_path "/Volumes/data/x" ((None (list (list int))))) (SpawnNoEntry)))
                 (check_bool "no program" (path_is_program "/bin/sh") false))))))

(def test_on_initramfs () int
  (add (check_true "/bin/sh" (on_initramfs "/bin/sh"))
       (check_bool "a volume's" (on_initramfs "/Volumes/data/a") false)))
