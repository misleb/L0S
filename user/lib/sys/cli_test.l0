; cli_test.l0 -- tests of cli.l0, on the host's files.

(def test_complain_as () int
  (check_int "fails" (complain_as "cli_test" "a test of complain_as") 1))

(def test_note_as () int
  (check_int "no failure" (note_as "cli_test" "a test of note_as") 0))

(def test_say_nothing () int
  (check_int "nothing said" (say "") 0))

(def test_arg_number () int
  (add (check_true "none given" (eq (arg_number (nil (list int)) 20) (Some 20)))
       (add (check_true "given" (eq (arg_number (split_spaces "50 x") 20) (Some 50)))
            (check_true "not a number" (eq (arg_number (split_spaces "x") 20) ((None int)))))))

; A file written whole reads back the same, and is then removed.
(def test_write_then_read () int
  (let (path "build/cli_test.tmp"
        w (write_whole path (bytes_from_list "two\nlines\n")))
    (match (read_whole path)
      ((Err why) (fail_because "read" why))
      ((Ok b) (let r (remove_file path)
                (add (check_str "written" w "")
                     (check_str "read" (bytes_to_list b) "two\nlines\n")))))))

(def test_read_missing () int
  (match (read_whole "build/no such file")
    ((Ok b) (fail_because "missing" "read"))
    ((Err why) (check_str "why" why "no such file"))))

(def test_write_nowhere () int
  (check_bool "refused" (is_empty (write_whole "build/no such dir/f" (bytes_from_list "x"))) false))
