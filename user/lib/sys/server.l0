; server.l0 -- what every server and driver does the same way: taking its
; name and its interrupt, reading a request's op and numbers, answering,
; and keeping the ports that listen to it. A server's loop is its own,
; since L0 has no function values; this is what the loop calls.
;
; A request is (request REPLY BODY), l0s.l0's; an answer is ok, error:
; WHY, or the request's own reply.

; --------------------------------------------------------------- starting

; port registered as name: empty, or why not, as a complaint says it.
(def name_register_or_why ((port int) (name (list int))) (list int)
  (let r (name_register port name)
    (if (eq r (Registered))
        ""
        (append "cannot register as " (append name (append ": " (registration_why r)))))))

; Interrupt irq bound to port: empty, or why not, as a complaint says it.
(def irq_bind_or_why ((irq int) (port int)) (list int)
  (let b (irq_bind irq port)
    (if (eq b (IrqBound))
        ""
        (append "cannot bind interrupt " (append (digits irq) (append ": " (irq_binding_why b)))))))

; --------------------------------------------------------------- requests

; A request's body read as its op and its numbers, or why it is not one.
(data RequestNums (ReqNums (list int) (list int)) (ReqBad (list int)))

; The op, the first word of body, and the numbers its other words are,
; each as word_number reads one, a - before a negative one, of any size,
; since an address is one.
(def request_numbers ((body (list int))) RequestNums
  (let ws (split_spaces body)
    (if (is_empty ws)
        (ReqBad "no request")
        (match (word_numbers (tail ws))
          ((None) (ReqBad (append (head ws) "'s arguments must be numbers")))
          ((Some ns) (ReqNums (head ws) ns))))))

; ---------------------------------------------------------------- answers

; A server's state after a request, of whatever type S it keeps, and the
; answer to send.
(data (Served S) (Served S (list int)))

(def (served_ok S) ((s S)) (Served S) (Served s "ok"))
(def (served_error S) ((s S) (why (list int))) (Served S) (Served s (error_reply why)))

; The answer that a request failed, and why.
(def error_reply ((why (list int))) (list int) (append "error: " why))

; answer sent to the reply port of the request payload, if it names one;
; 0. Whether it arrived does not matter to a server, which goes on to
; the next request: a client that has gone has no use for it, and one
; whose queue is full is slow and will ask again.
(def request_answer ((payload (list int)) (answer (list int))) int
  (let to (request_reply payload)
    (if (le to 0) 0 (port_tell to answer))))

; payload sent to port, whatever came of it: 0. For a notice whose loss
; does not matter, as a server's to a client that may have gone.
(def port_tell ((port int) (payload (list int))) int
  (let s (port_send port payload) 0))

; -------------------------------------------------------------- listeners

; Whether a listener the send s went to is still one: a full queue loses
; that notice but keeps the listener, which is there and slow; a port
; that has gone, or a notice too big for any, drops it.
(def listener_kept ((s Sending)) bool
  (match s ((Sent) true) ((SendFull) true) ((SendNoPort) false) ((SendTooBig) false)))

; notice sent to each port of ls: those still listening, in their order.
(def listeners_tell ((ls (list int)) (notice (list int))) (list int)
  (listeners_tell_onto ls notice (nil int)))

(def listeners_tell_onto ((ls (list int)) (notice (list int)) (kept (list int))) (list int)
  (if (is_empty ls)
      (rev kept)
      (listeners_tell_onto (tail ls) notice
                           (if (listener_kept (port_send (head ls) notice)) (cons (head ls) kept) kept))))

; ls with port listening after it, if the answer to its listen, which
; went as s, says it is still there, and it was not listening already.
(def listener_add ((ls (list int)) (port int) (s Sending)) (list int)
  (if (if (listener_kept s) (not (any_eq port ls)) false) (append ls (cons port (nil int))) ls))
