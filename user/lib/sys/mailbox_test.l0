; mailbox_test.l0 -- tests of mailbox.l0: its messages and statuses, and
; what a property buffer's codes say.

; The property channel in the low four bits, beside the 16-byte-aligned
; address.
(def test_mbox_message () int
  (add (check_str "a page" (hex_digits (mbox_message 1073745920) 8) "40001008")
       (check_str "low bits dropped" (hex_digits (mbox_message 4103) 8) "00001008")))

(def test_mbox_status () int
  (add (check_bool "full" (mbox_full 2147483648) true)
       (add (check_bool "empty" (mbox_empty 1073741824) true)
            (check_bool "neither" (mbox_empty 0) false))))

; A buffer of one tag: its size, its code, the tag, its value's bytes,
; the tag's code, then its value.
(def buffer ((code int) (tagcode int)) (list int)
  (cons 32 (cons code (cons 65539 (cons 8 (cons tagcode (cons 0 (cons 0 (cons 0 (nil int))))))))))

(def test_property_answered () int
  (add (check_bool "both succeeded" (property_answered (buffer 2147483648 2147483654)) true)
       (add (check_bool "the buffer refused" (property_answered (buffer 2147483649 2147483654)) false)
            (check_bool "the tag unanswered" (property_answered (buffer 2147483648 6)) false))))

(def test_property_short () int
  (check_bool "too short" (property_answered (cons 32 (nil int))) false))

; Under an operating system there is no mailbox.
(def test_mailbox_none () int
  (match (mailbox_open)
    ((NoMbox why) (check_str "why" why "no VideoCore mailbox on the board"))
    ((MboxOpen c) (fail_because "none" "found one"))))
