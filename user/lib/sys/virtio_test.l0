(def test_le_bytes () int
  (add (check_str "16 bits" (le16 4660) (cons 52 (cons 18 (nil int))))
       (check_int "64 bits" (length (le64 1)) 8)))

(def test_descriptor () int
  (let b (bytes_from_list (descriptor 2550140928 408 2 7))
    (add (check_int "16 bytes" (bytes_len b) 16)
         (add (check_int "addr" (le_u32 b 0) 2550140928)
              (add (check_int "len" (le_u32 b 8) 408)
                   (check_int "flags, next" (le_u32 b 12) 458754))))))   ; 2, then 7

(def runs_text ((runs (list VirtqRun))) (list int)
  (if (is_empty runs)
      ""
      (match (head runs)
        ((VirtqRun a n) (append (digits a) (append "+" (append (digits n) (append " " (runs_text (tail runs))))))))))

; 9000 bytes from 8192, page 2: the rest of page 2, page 3, which the
; device sees just after it, so one run with it, and 808 of page 4.
(def test_page_runs () int
  (let addrs (array_from (cons 0 (cons 0 (cons 12288 (cons 16384 (cons 40960 (nil int)))))) 0)
    (check_str "cut where pages part" (runs_text (rev (virtq_page_runs addrs 8192 9000 (nil VirtqRun)))) "12288+8192 40960+808 ")))

(def test_push_chain () int
  (let b (bytes_from_list (rev (virtq_push_chain (cons (VirtqRun 4096 16) (cons (VirtqRun 8192 32) (nil VirtqRun))) (desc_next) 3 (nil int))))
    (add (check_int "two descriptors" (bytes_len b) 32)
         (add (check_int "the first to 3" (le_u32 b 12) 196609)       ; NEXT, then 3
              (check_int "the second to 4" (le_u32 b 28) 262145)))))  ; NEXT, then 4

(def test_rings () int
  (add (check_int "16's available ring" (virtq_avail_off 16) 256)
       (check_int "64's used ring" (virtq_used_off 64) 2048)))

(def test_device_at () int
  (let addrs (array_from (cons 40960 (cons 12288 (nil int))) 0)
    (add (check_int "page 0" (device_at addrs 512) 41472)
         (check_int "page 1" (device_at addrs 4100) 12292))))

(def test_treg () int
  (add (check_int "transport 31's status" (treg 31 (reg_status)) 15984)
       (check_int "transport 0's config" (treg 0 (reg_config)) 256)))

(def test_transport_irq () int
  (check_int "transport 30" (transport_irq 30) 78))

; Transport 7 is at 0x0A000000 + 7 * 512 = 0x0A000E00, and its interrupt
; is 48 + 7.
(def test_where () int
  (add (check_str "7" (virtio_where 7) "virtio-mmio 7 at 0x0a000e00, irq 55")
       (check_str "31" (virtio_where 31) "virtio-mmio 31 at 0x0a003e00, irq 79")))
