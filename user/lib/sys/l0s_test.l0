(def test_message_of () int
  (match (message_of (bytes_from_list (append (u32_le 7) "hi")))
    ((Message from b) (add (check_int "sender" from 7) (check_str "payload" (msg_text b) "hi")))
    ((RecvFailed) (fail_because "message" "failed"))))

(def test_message_too_short () int
  (match (message_of (bytes_from_list "ab"))
    ((Message from payload) (fail_because "short" "accepted"))
    ((RecvFailed) (pass "short"))))

(def test_irq_notice () int
  (add (check_bool "notice" (is_irq_notice (message_new 0 (irq_notice 34)) 34) true)
       (add (check_bool "other irq" (is_irq_notice (message_new 0 (irq_notice 33)) 34) false)
            (check_bool "not the kernel" (is_irq_notice (message_new 5 (irq_notice 34)) 34) false))))

; The alarm notice is the kernel's five bytes; under no kernel a call fails.
(def test_alarm_notice () int
  (add (check_bool "notice" (is_alarm_notice (message_new 0 (alarm_notice))) true)
  (add (check_bool "not the kernel" (is_alarm_notice (message_new 5 (alarm_notice))) false)
  (add (check_bool "an irq" (is_alarm_notice (message_new 0 (irq_notice 34))) false)
       (check_bool "no kernel" (lt (alarm_at 1 0) 0) true)))))

(def test_request () int
  (let r (request 70000 "ping")
    (add (check_int "reply" (request_reply r) 70000)
         (add (check_str "body" (request_body r) "ping")
              (check_int "short" (request_reply "ab") -1)))))

; No kernel beneath l0 test: every call says so.
(def test_no_kernel () int
  (add (check_int "pid" (l0s_pid) -3)
       (match (port_receive 1)
         ((Message from payload) (fail_because "receive" "got one"))
         ((RecvFailed) (pass "receive")))))

; No console under l0 test either: console_line reads standard input,
; which l0 test leaves empty.
(def test_console_line_without_console () int
  (add (check_true "no console" (eq (console_port) (NotFound)))
       (check_str "standard input" (console_line) "")))

(def test_proc_info_of () int
  (match (proc_info_of (bytes_from_list (proc_record (state_receiving) 1 3 2 40 8)))
    ((Some info)
      (match info
        ((ProcInfo st parent m detail own shared)
          (add (check_int "state" st (state_receiving))
               (add (check_int "parent" parent 1)
                    (add (check_int "module" m 3) (check_int "port" detail 2)))))))
    ((None) (fail_because "record" "refused"))))

(def test_proc_info_pages () int
  (match (proc_info_of (bytes_from_list (proc_record (state_receiving) 1 3 2 40 8)))
    ((Some info)
      (match info
        ((ProcInfo st parent m detail own shared) (add (check_int "its own" own 40) (check_int "shared" shared 8)))))
    ((None) (fail_because "record" "refused"))))

(def test_proc_info_exited () int
  (match (proc_info_of (bytes_from_list (proc_record (state_exited) 0 -1 -5 0 0)))
    ((Some info)
      (match info
        ((ProcInfo st parent m detail own shared) (add (check_int "no module" m -1) (check_int "status" detail -5)))))
    ((None) (fail_because "record" "refused"))))

; The record of 16 bytes proc_info gave before its pages is refused.
(def test_proc_info_short () int
  (match (proc_info_of (bytes_from_list (take (proc_record 2 1 3 0 0 0) 16)))
    ((Some i) (fail_because "16 bytes" "accepted"))
    ((None) (pass "16 bytes"))))

(def test_mem_info_of () int
  (match (mem_info_of (bytes_from_list (mem_record 98304 1200)))
    ((Some mi) (match mi ((MemInfo total used) (add (check_int "total" total 98304) (check_int "used" used 1200)))))
    ((None) (fail_because "record" "refused"))))

; Under an operating system there is no kernel, and a short record is
; none.
(def test_mem_info_none () int
  (add (match (mem_info_of (bytes_from_list "short")) ((Some i) (fail_because "short" "accepted")) ((None) (pass "short")))
       (match (mem_info) ((Some i) (fail_because "no kernel" "a record")) ((None) (pass "no kernel")))))

; log_write's answers, code by code: a number is the message's, -4 is too
; long, and -5 (a level that is none) and -3 (no kernel) are refused.
(def logging_text ((l Logging)) (list int)
  (match l
    ((Logged n) (append "logged " (digits n)))
    ((LogTooLong) "too long")
    ((LogRefused) "refused")))

(def test_logging_of () int
  (add (check_str "number" (logging_text (logging_of 0)) "logged 0")
       (add (check_str "later" (logging_text (logging_of 41)) "logged 41")
            (add (check_str "too long" (logging_text (logging_of -4)) "too long")
                 (add (check_str "bad level" (logging_text (logging_of -5)) "refused")
                      (check_str "no kernel" (logging_text (logging_of -3)) "refused"))))))

(def test_logging_why () int
  (add (check_str "logged" (logging_why (Logged 3)) "")
       (check_true "refused" (not (is_empty (logging_why (LogRefused)))))))

; Under an operating system there is no kernel: writing is refused, and
; reading gives no messages.
(def test_log_no_kernel () int
  (add (check_str "write" (logging_text (log_write (log_info) "x: y")) "refused")
       (add (check_int "read" (length (log_read 0)) 0)
            (check_int "all" (length (log_all)) 0))))

(def test_proc_info_none () int
  (add (match (proc_info_of (bytes_from_list "short")) ((Some i) (fail_because "short" "accepted")) ((None) (pass "short")))
       (match (proc_info 1) ((Some i) (fail_because "no kernel" "a record")) ((None) (pass "no kernel")))))

(def test_exit_of () int
  (match (exit_of (message_new 0 (exit_notice 4 -5)))
    ((Exited pid status) (add (check_int "pid" pid 4) (check_int "status" status -5)))
    ((NotExit) (fail_because "exit" "not a notice"))))

(def test_not_exit () int
  (add (match (exit_of (message_new 3 (exit_notice 4 0))) ((Exited p s) (fail_because "from 3" "a notice")) ((NotExit) (pass "from 3")))
       (match (exit_of (message_new 0 (irq_notice 33))) ((Exited p s) (fail_because "irq" "a notice")) ((NotExit) (pass "irq")))))

(def test_key_event_round_trip () int
  (match (key_event_of (message_new 4 (key_notice (KeyEvent 30 1 97))))
    ((Some ev)
      (match ev
        ((KeyEvent code value ch)
          (add (check_int "code" code 30) (add (check_int "pressed" value 1) (check_int "a" ch 97))))))
    ((None) (fail_because "event" "refused"))))

(def test_key_event_refused () int
  (add (match (key_event_of (message_new 4 "key")) ((Some ev) (fail_because "short" "accepted")) ((None) (pass "short")))
       (add (match (key_event_of (message_new 4 (append "kez" (drop_n (key_notice (KeyEvent 1 1 27)) 3))))
              ((Some ev) (fail_because "prefix" "accepted")) ((None) (pass "prefix")))
            (match (key_event_of (RecvFailed)) ((Some ev) (fail_because "nothing" "accepted")) ((None) (pass "nothing"))))))

; Without a kernel there is nothing to wait for.
(def test_name_wait_no_kernel () int
  (add (check_true "at once" (eq (name_wait "keyboard" 5000000000) (NotFound)))
       (check_true "no keyboard" (eq (keyboard_listen 1) (NoDriver)))))

; ------------------------------------------------- reading the kernel's word

; Each call's word, as the kernel gives it, read as its answer: success,
; then every error code the call may give.
(def test_sending_of () int
  (add (check_true "sent" (eq (sending_of 0) (Sent)))
       (add (check_true "no port" (eq (sending_of (err_no_port)) (SendNoPort)))
            (add (check_true "full" (eq (sending_of (err_full)) (SendFull)))
                 (check_true "too big" (eq (sending_of (err_too_big)) (SendTooBig)))))))

(def test_registration_of () int
  (add (check_true "registered" (eq (registration_of 0) (Registered)))
       (add (check_true "no port" (eq (registration_of (err_no_port)) (RegisterNoPort)))
            (add (check_true "taken" (eq (registration_of (err_taken)) (RegisterTaken)))
                 (check_true "too long" (eq (registration_of (err_too_big)) (RegisterTooLong)))))))

(def test_lookup_of () int
  (add (check_true "found" (eq (lookup_of 7) (Found 7)))
       (add (check_true "none" (eq (lookup_of (err_no_port)) (NotFound)))
            (check_true "too long to be any" (eq (lookup_of (err_too_big)) (NotFound))))))

(def test_spawn_of () int
  (add (check_true "spawned" (eq (spawn_of 9) (Spawned 9)))
       (add (check_true "no entry" (eq (spawn_of (err_no_port)) (SpawnNoEntry)))
            (add (check_true "not a program" (eq (spawn_of (err_denied)) (SpawnNotProgram)))
                 (add (check_true "too big" (eq (spawn_of (err_too_big)) (SpawnTooBig)))
                      (check_true "no room" (eq (spawn_of (err_fault)) (SpawnNoRoom))))))))

(def test_reaped_of () int
  (add (check_true "status" (eq (reaped_of 130) (Reaped 130)))
       (add (check_true "a negative status" (eq (reaped_of (wait_word -5)) (Reaped -5)))
            (add (check_true "status -1" (eq (reaped_of (wait_word -1)) (Reaped -1)))
                 (check_true "none" (eq (reaped_of (err_no_port)) (WaitNoProc)))))))

(def test_irq_binding_of () int
  (add (check_true "bound" (eq (irq_binding_of 0) (IrqBound)))
       (add (check_true "denied" (eq (irq_binding_of (err_denied)) (IrqDenied)))
            (add (check_true "no port" (eq (irq_binding_of (err_no_port)) (IrqNoPort)))
                 (add (check_true "taken" (eq (irq_binding_of (err_taken)) (IrqTaken)))
                      (check_true "no such interrupt, -3 from the board" (eq (irq_binding_of -3) (IrqAbsent))))))))

(def test_irq_ack_of () int
  (add (check_true "acked" (eq (irq_ack_of 0) (IrqAcked)))
       (check_true "not pending" (eq (irq_ack_of (err_no_port)) (IrqNotPending)))))

(def test_dma_sync_of () int
  (add (check_true "synced" (eq (dma_sync_of 2) (DmaSynced 2)))
       (add (check_true "none" (eq (dma_sync_of 0) (DmaSynced 0)))
            (add (check_true "bad direction" (eq (dma_sync_of (err_fault)) (DmaSyncBad)))
                 (check_true "denied" (eq (dma_sync_of (err_denied)) (DmaSyncDenied)))))))

(def test_dma_alloc_of () int
  (add (check_true "pages" (eq (dma_alloc_of 3892314112) (DmaPages 3892314112)))
       (add (check_true "denied" (eq (dma_alloc_of (err_denied)) (DmaDenied)))
            (add (check_true "too many" (eq (dma_alloc_of (err_too_big)) (DmaTooMany)))
                 (check_true "no room" (eq (dma_alloc_of (err_fault)) (DmaNoRoom)))))))

(def test_dma_where_of () int
  (add (check_true "address" (eq (dma_where_of 1073745920) (DmaAddress 1073745920)))
       (add (check_true "denied" (eq (dma_where_of (err_denied)) (DmaAddressDenied)))
            (check_true "not DMA" (eq (dma_where_of (err_no_port)) (NotDma))))))

(def test_shm_alloc_of () int
  (add (check_true "pages" (eq (shm_alloc_of 3892314112) (ShmPages 3892314112)))
       (add (check_true "too many" (eq (shm_alloc_of (err_too_big)) (ShmTooMany)))
            (check_true "no room" (eq (shm_alloc_of (err_fault)) (ShmNoRoom))))))

(def test_shm_share_of () int
  (add (check_true "shared" (eq (shm_share_of 3892314112) (ShmShared 3892314112)))
       (add (check_true "no process" (eq (shm_share_of (err_no_port)) (ShmShareNoProc)))
            (add (check_true "too many" (eq (shm_share_of (err_too_big)) (ShmShareTooMany)))
                 (check_true "failed" (eq (shm_share_of (err_fault)) (ShmShareFailed)))))))

(def test_shm_unmap_of () int
  (add (check_true "unmapped" (eq (shm_unmap_of 0) (ShmUnmapped)))
       (add (check_true "too many" (eq (shm_unmap_of (err_too_big)) (ShmUnmapTooMany)))
            (check_true "not yours" (eq (shm_unmap_of (err_fault)) (ShmUnmapNotYours))))))

(def test_mounting_of () int
  (add (check_true "mounted" (eq (mounting_of 0) (Mounted)))
       (add (check_true "no port" (eq (mounting_of (err_no_port)) (MountNoPort)))
            (add (check_true "taken" (eq (mounting_of (err_taken)) (MountTaken)))
                 (check_true "bad label" (eq (mounting_of (err_fault)) (MountBadLabel)))))))

(def test_unmounting_of () int
  (add (check_true "unmounted" (eq (unmounting_of 0) (Unmounted)))
       (add (check_true "not mounted" (eq (unmounting_of (err_no_port)) (UnmountNotMounted)))
            (add (check_true "the system volume" (eq (unmounting_of (err_denied)) (UnmountDenied)))
                 (check_true "bad label" (eq (unmounting_of (err_fault)) (UnmountBadLabel)))))))

; Under an operating system there is no kernel: its word, -3, is not
; mounted.
(def test_unmount_no_kernel () int
  (check_str "why" (unmounting_why (fs_unmount "data" 1)) "the volume is not mounted from this process's port"))

; Under an operating system there is no kernel: no port is this one's.
(def test_no_mount () int
  (add (check_true "refused" (eq (fs_mount "data" "" 3) (MountNoPort)))
       (check_int "no mounts" (length (mount_list)) 0)))

(def test_mount_info_of () int
  (add (check_true "data" (eq (mount_info_of (bytes_from_list (append (u32_le 7) "/Volumes/data")))
                              (Some (MountInfo "/Volumes/data" 7 ""))))
       (add (check_true "with a UUID" (eq (mount_info_of (bytes_from_list (append (u32_le 7) (append "/" (cons 0 "u-1")))))
                                          (Some (MountInfo "/" 7 "u-1"))))
            (check_true "short" (eq (mount_info_of (bytes_from_list (u32_le 7))) ((None MountInfo)))))))

(def test_switch_of () int
  (add (check_true "made" (eq (switch_of 0) (Switched)))
       (add (check_true "denied" (eq (switch_of (err_denied)) (SwitchDenied)))
            (add (check_true "done" (eq (switch_of (err_taken)) (SwitchDone)))
                 (add (check_true "no volume" (eq (switch_of (err_no_port)) (SwitchNoVolume)))
                      (check_true "bad label" (eq (switch_of (err_fault)) (SwitchBadLabel))))))))

; Under an operating system there is no kernel to switch, no boot
; arguments, and nothing spawned.
(def test_no_root () int
  (add (check_true "switch" (eq (root_switch "sys") (SwitchBadLabel)))
       (add (check_int "boot args" (length (boot_args)) 0)
            (check_true "spawn" (eq (spawn_image "/bin/x" ((None (list (list int)))) (bytes_from_list "abc")) (SpawnNoEntry))))))

; The path's length and the path, the arguments' length and them, then
; the image.
(def test_spawn_image_bytes () int
  (add (check_str "no arguments" (bytes_to_list (spawn_image_bytes "/b" ((None (list (list int)))) (bytes_from_list "IMG")))
                  (append (u32_le 2) (append "/b" (append (u32_le 0) "IMG"))))
       (check_str "one" (bytes_to_list (spawn_image_bytes "/b" (Some (cons "a" (nil (list int)))) (bytes_from_list "I")))
                  (append (u32_le 2) (append "/b" (append (u32_le 9) (append (encode_args (cons "a" (nil (list int)))) "I")))))))

(def test_proc_path_of () int
  (add (check_str "after the record" (proc_path_of (bytes_from_list (append (proc_record 2 1 3 0 9 0) "/bin/sh"))) "/bin/sh")
       (check_str "none" (proc_path_of (bytes_from_list "abc")) "")))

(def test_shm_revoke_of () int
  (add (check_true "none taken back" (eq (shm_revoke_of 0) (ShmRevoked 0)))
       (add (check_true "no process" (eq (shm_revoke_of (err_no_port)) (ShmRevokeNoProc)))
            (add (check_true "denied" (eq (shm_revoke_of (err_denied)) (ShmRevokeDenied)))
                 (add (check_true "too many" (eq (shm_revoke_of (err_too_big)) (ShmRevokeTooMany)))
                      (check_true "not yours" (eq (shm_revoke_of (err_fault)) (ShmRevokeNotYours))))))))

(def test_restart_why () int
  (add (check_str "denied" (restart_why (err_denied)) "this board cannot be restarted")
       (check_str "no kernel" (restart_why -3) "there is no kernel to restart the board")))

; Under an operating system there is no kernel: board_restart returns why.
(def test_board_restart_none () int
  (check_str "no kernel" (board_restart) "there is no kernel to restart the board"))

(def test_kill_of () int
  (add (check_true "killed" (eq (kill_of 0) (Killed)))
       (add (check_true "no process" (eq (kill_of (err_no_port)) (KillNoProc)))
            (check_true "a driver" (eq (kill_of (err_denied)) (KillDenied))))))

(def test_watch_of () int
  (add (check_true "watched" (eq (watch_of 0) (Watched)))
       (add (check_true "no process" (eq (watch_of (err_no_port)) (WatchNoProc)))
            (check_true "full" (eq (watch_of (err_full)) (WatchFull))))))

(def test_slot_of_code () int
  (add (check_true "held" (eq (slot_of_code 300) (SlotHeld 300)))
       (add (check_true "unused" (eq (slot_of_code 0) (SlotUnused)))
            (check_true "no slot" (eq (slot_of_code (err_no_port)) (NoSlot))))))

(def test_terminals () int
  (add (check_true "set" (eq (tty_change_of 0) (TtySet)))
       (add (check_true "no port" (eq (tty_change_of (err_no_port)) (TtyNoPort)))
            (add (check_true "a port" (eq (terminal_of 12) (Terminal 12)))
                 (check_true "the kernel's" (eq (terminal_of 0) (KernelTerminal)))))))

; With no kernel, -3: err_full where a call has it, else the first failure.
(def test_no_kernel_answers () int
  (add (check_true "send" (eq (port_send 1 "x") (SendFull)))
       (add (check_true "register" (eq (name_register 1 "x") (RegisterNoPort)))
            (add (check_true "spawn" (eq (spawn_entry 0) (SpawnNoEntry)))
                 (add (check_true "kill" (eq (proc_kill 2) (KillNoProc)))
                      (add (check_true "slot" (eq (proc_slot 1) (NoSlot)))
                           (check_true "terminal" (eq (tty_get) (KernelTerminal)))))))))

(def test_pointer_event_round_trip () int
  (match (pointer_event_of (message_new 5 (pointer_notice (PointerEvent 16000 32767 1))))
    ((Some ev)
      (match ev
        ((PointerEvent x y b) (add (check_int "x" x 16000) (add (check_int "y" y 32767) (check_int "left" b 1))))))
    ((None) (fail_because "event" "refused"))))

; Relative to a window, left of it and above it while a button is held.
(def test_pointer_event_negative () int
  (match (pointer_event_of (message_new 5 (pointer_notice (PointerEvent -3 -40 1))))
    ((Some ev) (match ev ((PointerEvent x y b) (add (check_int "x" x -3) (check_int "y" y -40)))))
    ((None) (fail_because "event" "refused"))))

; A mouse's report as text, dx dy buttons wdx wdy, or none.
(def motion_text ((m Message)) (list int)
  (match (pointer_motion_of m)
    ((Some ev)
      (match ev
        ((PointerMotion dx dy b wdx wdy)
          (unwords (cons (int_text dx) (cons (int_text dy) (cons (digits b) (cons (int_text wdx) (cons (int_text wdy) (nil (list int)))))))))))
    ((None) "none")))

(def test_motion_round_trip () int
  (check_str "right and up, left held, wheel down" (motion_text (message_new 5 (motion_notice (PointerMotion 7 -3 1 0 2)))) "7 -3 1 0 2"))

(def test_motion_negative () int
  (check_str "left and up, wheel up and left" (motion_text (message_new 5 (motion_notice (PointerMotion -127 -128 0 -1 -1)))) "-127 -128 0 -1 -1"))

; A motion is no pointer event, nor a pointer event a motion.
(def test_motion_apart () int
  (add (check_str "a pointer event" (motion_text (message_new 5 (pointer_notice (PointerEvent 1 2 0)))) "none")
       (match (pointer_event_of (message_new 5 (motion_notice (PointerMotion 1 2 0 0 0))))
         ((Some ev) (fail_because "motion" "accepted"))
         ((None) (pass "motion")))))

; A wheel event as text, x y dx dy, or none.
(def wheel_text ((m Message)) (list int)
  (match (wheel_event_of m)
    ((Some ev) (match ev ((WheelEvent x y dx dy) (append (digits x) (append " " (append (digits y) (append " " (append (int_text dx) (append " " (int_text dy))))))))))
    ((None) "none")))

(def int_text ((n int)) (list int) (if (lt n 0) (cons 45 (digits (neg n))) (digits n)))

(def test_wheel_event_round_trip () int
  (check_str "down three" (wheel_text (message_new 5 (wheel_notice (WheelEvent 16000 200 0 3)))) "16000 200 0 3"))

; Up and left are negative, and a window's x, y may be too.
(def test_wheel_event_negative () int
  (check_str "up, left of the window" (wheel_text (message_new 5 (wheel_notice (WheelEvent -3 40 -1 -2)))) "-3 40 -1 -2"))

(def test_wheel_not_a_pointer () int
  (add (check_str "a pointer event is not" (wheel_text (message_new 5 (pointer_notice (PointerEvent 1 2 0)))) "none")
       (match (pointer_event_of (message_new 5 (wheel_notice (WheelEvent 1 2 0 1)))) ((Some ev) (fail_because "wheel" "accepted")) ((None) (pass "wheel")))))

(def test_leave_notice () int
  (add (check_bool "left" (is_leave_notice (message_new 5 (leave_notice))) true)
       (check_bool "a key is not" (is_leave_notice (message_new 5 (key_notice (KeyEvent 1 1 27)))) false)))

(def test_focus_notice () int
  (add (check_bool "in front" (eq (focus_notice_of (message_new 5 (focus_notice true))) (Some true)) true)
       (add (check_bool "gone from it" (eq (focus_notice_of (message_new 5 (focus_notice false))) (Some false)) true)
            (check_bool "not one" (eq (focus_notice_of (message_new 5 (leave_notice))) ((None bool))) true))))

; Two addresses, 0x40081000 and 0x1_0000_2000, as the kernel writes them;
; and none for no bytes, as the host gives.
(def test_dma_addresses_of () int
  (let a (dma_addresses_of (bytes_from_list (append (append (u32_le 1074270208) (u32_le 0)) (append (u32_le 8192) (u32_le 1)))))
    (add (check_int "two" (array_len a) 2)
         (add (check_int "the first" (array_get a 0) 1074270208)
              (add (check_int "the second, past 32 bits" (array_get a 1) 4294975488)
                   (check_int "none on the host" (array_len (dma_addresses 3892314112 4)) 0))))))

(def test_size_notice () int
  (add (check_str "w and h" (unwords (numbers_words (match (size_notice_of (message_new 5 (size_notice 640 400))) ((Some ns) ns) ((None) (nil int))))) "640 400")
       (check_bool "not one" (eq (size_notice_of (message_new 5 (leave_notice))) ((None (list int)))) true)))

; An initramfs with a program in each place one can be.
(def tree () (list (list int))
  (split_spaces (append "/bin/ /bin/sh /bin/hello /sbin/ /sbin/wm /sbin/hello /Applications/ "
                (append "/Applications/Terminal.app/ /Applications/Terminal.app/manifest /Applications/Terminal.app/vt "
                        "/Applications/vt /Applications/Old/vt /Applications/.app/vt /etc/vt"))))

(def test_program_places () int
  (add (check_str "/bin" (program_path_in "sh" (tree)) "/bin/sh")
       (add (check_str "/sbin" (program_path_in "wm" (tree)) "/sbin/wm")
            (check_str "/bin before /sbin" (program_path_in "hello" (tree)) "/bin/hello"))))

; Only a file directly in a bundle, NAME.app, is an app's program.
(def test_program_bundled () int
  (add (check_str "in a bundle" (program_path_in "vt" (tree)) "/Applications/Terminal.app/vt")
       (add (check_int "its entry" (program_entry "vt" (tree)) 9)
            (check_str "a bundle's other files" (program_path_in "manifest" (tree)) "/Applications/Terminal.app/manifest"))))

(def test_program_not_bundled () int
  (add (check_bool "loose in /Applications" (is_bundled "/Applications/vt" "vt") false)
       (add (check_bool "a directory not a bundle" (is_bundled "/Applications/Old/vt" "vt") false)
            (add (check_bool "a bundle with no name" (is_bundled "/Applications/.app/vt" "vt") false)
                 (check_bool "deeper in a bundle" (is_bundled "/Applications/A.app/bin/vt" "vt") false)))))

(def test_program_none () int
  (add (check_str "none says /bin" (program_path_in "nope" (tree)) "/bin/nope")
       (add (check_int "no entry" (program_entry "nope" (tree)) -1)
            (check_str "a path is itself" (program_path_in "/etc/vt" (tree)) "/etc/vt"))))

(def test_pointer_not_a_key () int
  (add (match (pointer_event_of (message_new 5 (key_notice (KeyEvent 1 1 27)))) ((Some ev) (fail_because "key" "accepted")) ((None) (pass "key")))
       (match (key_event_of (message_new 5 (pointer_notice (PointerEvent 1 2 0)))) ((Some ev) (fail_because "pointer" "accepted")) ((None) (pass "pointer")))))

(def test_chdir_of () int
  (add (check_true "done" (eq (chdir_of 0) (ChdirDone)))
       (add (check_true "no such directory" (eq (chdir_of -3) (ChdirNoDir)))
            (add (check_true "a file" (eq (chdir_of -9) (ChdirNotDir)))
                 (check_true "a bad path" (eq (chdir_of -5) (ChdirBad)))))))

(def test_chdir_why () int
  (add (check_str "done" (chdir_why (ChdirDone)) "")
       (check_str "a file" (chdir_why (ChdirNotDir)) "not a directory")))

; Under an operating system there is no kernel to ask: the current
; directory is /, and chdir finds no directory.
(def test_cwd_none () int
  (add (check_str "getcwd" (getcwd) "/")
       (add (check_true "chdir" (eq (chdir "/etc") (ChdirNoDir)))
            (add (check_str "an absolute path is itself" (path_abs "/etc/") "/etc/")
                 (check_str "a relative one is from /" (path_abs "etc/../bin") "/bin")))))

; Under an operating system there is no kernel: shm_share_read's word is
; -3, which reads as no such process, as shm_share's does.
(def test_shm_share_read_no_kernel () int
  (check_true "no process" (eq (shm_share_read 3892314112 1 2) (shm_share 3892314112 1 2))))

; A receive on a set gives pid 7, "hi", then port 12: the message is the
; pid and payload, as port_receive gives one, and the port beside it.
(def test_set_message_of () int
  (match (set_message_of (bytes_from_list (append (u32_le 7) (append "hi" (u32_le 12)))))
    ((SetMessage port m)
      (match m
        ((Message from b)
          (add (check_int "port" port 12)
               (add (check_int "from" from 7) (check_str "payload" (msg_text b) "hi"))))
        ((RecvFailed) (check_true "a message" false))))
    ((SetRecvFailed) (check_true "a message" false))))

; Under 8 bytes there is no pid and port: nothing was received.
(def test_set_message_short () int
  (check_true "failed" (eq (set_message_of (bytes_from_list (u32_le 7))) (SetRecvFailed))))

(def test_port_setting_of () int
  (add (check_true "made" (eq (port_setting_of 0) (PortSetMade)))
       (add (check_true "not yours" (eq (port_setting_of (err_no_port)) (PortSetNotYours)))
            (check_true "size" (eq (port_setting_of (err_too_big)) (PortSetSize))))))

(def test_unregistration_of () int
  (add (check_true "let go" (eq (unregistration_of 0) (Unregistered)))
       (add (check_true "no name" (eq (unregistration_of (err_no_port)) (UnregisterNoName)))
            (check_true "another's" (eq (unregistration_of (err_denied)) (UnregisterNotYours))))))

; With no kernel: the set is refused, nothing received, no name let go.
(def test_sets_without_kernel () int
  (add (check_true "set" (eq (port_set (cons 1 (nil int))) (PortSetSize)))
       (add (check_true "receive" (eq (port_receive_any (cons 1 (nil int))) (SetRecvFailed)))
            (check_true "unregister" (eq (name_unregister "x") (UnregisterNoName))))))

(def test_u32s_le () int
  (check_str "two" (u32s_le (cons 1 (cons 258 (nil int))) (nil int)) (append (u32_le 1) (u32_le 258))))
