; cli.l0 -- what every command, service and host tool does the same way:
; saying why it failed, saying something at once, taking a number as an
; argument, and reading or writing a file whole. Needs only the standard
; library and text.l0, so the host tools link it too.

; ---------------------------------------------------------------- saying

; WHO: WHY on standard error, and status 1: how a program fails. Each
; program's own complain names it, as (complain_as "cat" why).
(def complain_as ((who (list int)) (why (list int))) int
  (let w (write_err (append who (append ": " (append why "\n")))) 1))

; WHO: WHY on standard error, delivered at once, and status 0: what a
; driver says when its device is absent, which is no failure, or what a
; program that never exits says while it runs.
(def note_as ((who (list int)) (why (list int))) int
  (let w (write_err (append who (append ": " (append why "\n"))))
    (let f (file_flush (IoFile 2)) 0)))

; Writes s and delivers it at once, so that it shows before the program
; next waits, as a prompt or an echoed key must; 0. Nothing for empty s.
(def say ((s (list int))) int
  (if (is_empty s)
      0
      (let w (write_str s)
        (let f (file_flush (IoFile 1)) 0))))

; The same, for the bytes of b from i up to j, written from b in place.
(def say_bytes ((b bytes) (i int) (j int)) int
  (if (ge i j)
      0
      (let w (file_write_bytes (IoFile 1) b i j)
        (let f (file_flush (IoFile 1)) 0))))

; ------------------------------------------------------------- arguments

; The number the first of argv is, or fallback if it has none; none if
; it is not a number.
(def arg_number ((argv (list (list int))) (fallback int)) (Option int)
  (if (is_empty argv) (Some fallback) (word_number (head argv))))

; ----------------------------------------------------------------- files

; The file at path, all of it; or why it cannot be read, in words.
(def read_whole ((path (list int))) (Result bytes (list int))
  (match (open_in path)
    ((IoFailed fault why) ((Err bytes (list int)) why))
    ((IoOpened f)
      (let got (file_read_all f)
        (let c (file_close f)
          (match got
            ((IoReadFailed code) ((Err bytes (list int)) (io_error code)))
            ((IoBytes b) ((Ok bytes (list int)) b))))))))

; Why r failed, or empty if it is done, for a done of any operation.
(def (done_why E) ((r (IoDone E))) (list int)
  (match r ((Done) "") ((NotDone fault why) why)))

; Makes the file at path hold b: empty, or why it could not, in words.
(def write_whole ((path (list int)) (b bytes)) (list int)
  (match (open_out path)
    ((IoFailed fault why) why)
    ((IoOpened f)
      (let w (file_write_bytes f b 0 (bytes_len b))
        (done_why (file_close f))))))
