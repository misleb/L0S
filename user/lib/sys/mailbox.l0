; mailbox.l0 -- the Raspberry Pi 5's VideoCore mailbox, one of L0's
; regions on the Pi 5, and the firmware's property interface over it: a
; driver asks the firmware for what only it knows (rtc the time, gem the
; board's Ethernet address) by writing a buffer of words into a page of
; DMA memory and sending the page's address. The words are the caller's;
; the asking is a page and four registers. None of it has run on a
; board. Linked by the Makefile's MAILBOX.

; The mailbox in the CPU's map (bcm2712.dtsi's mailbox@7c013880) and its
; bytes.
(def mbox_base () int 70799931520)       ; 0x107C013880
(def mbox_bytes () int 64)

; Its registers: the firmware writes to the ARM in mailbox 0 and the ARM
; to the firmware in mailbox 1 (bcm2835-mailbox.c): MAIL0_RD, MAIL0_STA,
; MAIL1_WRT, MAIL1_STA.
(def mbox_read () int 0)
(def mbox_read_status () int 24)         ; 0x18
(def mbox_write () int 32)               ; 0x20
(def mbox_write_status () int 56)        ; 0x38

; A status's FULL, bit 31, and EMPTY, bit 30.
(def mbox_full ((w int)) bool (eq (bit_and (bit_shr w 31) 1) 1))
(def mbox_empty ((w int)) bool (eq (bit_and (bit_shr w 30) 1) 1))

; The property channel, 8, which a message names in its low four bits
; beside where its buffer is, 16-byte aligned. The firmware node's
; dma-ranges on the BCM2712 are identity, so that is the buffer's own
; address, below mbox_limit.
(def mbox_property () int 8)

; The message naming the buffer at pa on the property channel.
(def mbox_message ((pa int)) int (bit_or (bit_and pa 4294967280) (mbox_property)))

; A request's code, 0, and a reply's that succeeded, bit 31.
(def property_success () int 2147483648) ; 0x80000000

; Whether ws, a buffer of one tag as the firmware wrote it back, says it
; succeeded: the buffer's code, its second word, and the tag's, its
; fifth, bit 31 set.
(def property_answered ((ws (list int))) bool
  (and (not (lt (length ws) 5))
       (and (eq (nth ws 1) (property_success)) (eq (bit_and (bit_shr (nth ws 4) 31) 1) 1))))

; ------------------------------------------------------------- asking

; The mailbox: its registers; the page of DMA memory its messages are in,
; opened, where this process sees it, and its address.
(data Mailbox (Mailbox IoRegion IoRegion int int))

; The mailbox opened, or why not.
(data MboxOpened (MboxOpen Mailbox) (NoMbox (list int)))

; How far up a message's page may be: 4 GB, since a message's address has
; 32 bits.
(def mbox_limit () int 4294967296)       ; 0x100000000

; The page a message is in, or why there is none.
(data MboxPage (MboxPage IoRegion int int) (NoMboxPage (list int)))

; That page, opened, where this process sees it, and its address; or why
; there is none.
(def mbox_page ((n int)) MboxPage
  (if (le n 0)
      (NoMboxPage "no DMA page below 4 GB for the firmware's messages")
      (match (dma_alloc 1)
        ((DmaPages va)
          (let addrs (dma_addresses va 1)
            (if (not (eq (array_len addrs) 1))
                (NoMboxPage "its page is not a DMA page")
                (lt (array_get addrs 0) (mbox_limit))
                (match (dma_open va 1)
                  ((IoRegionFailed fault why) (NoMboxPage why))
                  ((IoRegionOpened m) (MboxPage m va (array_get addrs 0))))
                (mbox_page (sub n 1)))))
        ((DmaDenied) (NoMboxPage (dma_alloc_why (DmaDenied))))
        ((DmaTooMany) (NoMboxPage (dma_alloc_why (DmaTooMany))))
        ((DmaNoRoom) (NoMboxPage (dma_alloc_why (DmaNoRoom)))))))

; The mailbox a region, with a page for its messages; or why not.
(def mailbox_open () MboxOpened
  (match (open_region (mbox_base) (mbox_bytes))
    ((IoRegionFailed fault why) (NoMbox "no VideoCore mailbox on the board"))
    ((IoRegionOpened mb)
      (match (mbox_page 8)
        ((NoMboxPage why) (NoMbox why))
        ((MboxPage m va pa) (MboxOpen (Mailbox mb m va pa)))))))

; Where c's messages are, for saying why the firmware did not answer.
(def mailbox_page_text ((c Mailbox)) (list int)
  (match c ((Mailbox mb m va pa) (append "its page at 0x" (hex_digits pa 1)))))

; The n words the firmware wrote back over ws, a property buffer: ws
; written to the page and cleaned for it, the page's address sent once
; the mailbox has room, the answer waited for, up to a second, and the
; page read back once invalidated; or none if the firmware did not
; answer.
(def mailbox_ask ((c Mailbox) (ws (list int)) (n int)) (Option (list int))
  (match c
    ((Mailbox mb m va pa)
      (let (w (mbox_put m 0 ws) s (dma_sync va 1 (dma_to_device)))
        (if (not (mbox_waited mb (mbox_write_status) false 1000))
            ((None (list int)))
            (let x (region_set32 mb (mbox_write) (mbox_message pa))
              (if (not (mbox_answered mb m va 1000))
                  ((None (list int)))
                  (Some (mbox_got m 0 n (nil int))))))))))

; Whether the mailbox's status at off has room, FULL clear, or, for its
; reads, something to read, EMPTY clear; read up to n times, a
; millisecond apart. reads says which.
(def mbox_waited ((mb IoRegion) (off int) (reads bool) (n int)) bool
  (let w (region_get32 mb off)
    (if (if reads (not (mbox_empty w)) (not (mbox_full w))) true
        (le n 0) false
        (let z (sleep_ns 1000000) (mbox_waited mb off reads (sub n 1))))))

; Whether the firmware has answered the buffer in m, at va, within n
; milliseconds: its code, the second word, has bit 31 once it has. The
; buffer says so, not the mailbox's read register, since rtc, gem and
; hvs share the mailbox and any of them may read the message that names
; another's buffer; so each drains what is there as it waits.
(def mbox_answered ((mb IoRegion) (m IoRegion) (va int) (n int)) bool
  (let (d (mbox_drained mb 8) i (dma_sync va 1 (dma_from_device)))
    (if (eq (bit_and (bit_shr (region_get32 m 4) 31) 1) 1) true
        (le n 0) false
        (let z (sleep_ns 1000000) (mbox_answered mb m va (sub n 1))))))

; The mailbox's read side emptied, up to n messages: 0.
(def mbox_drained ((mb IoRegion) (n int)) int
  (if (le n 0) 0
      (mbox_empty (region_get32 mb (mbox_read_status))) 0
      (let r (region_get32 mb (mbox_read)) (mbox_drained mb (sub n 1)))))

; ws written into m from byte off, a word each: 0.
(def mbox_put ((m IoRegion) (off int) (ws (list int))) int
  (if (is_empty ws)
      0
      (let w (region_set32 m off (head ws)) (mbox_put m (add off 4) (tail ws)))))

; n words of m from byte off, after the reversed acc.
(def mbox_got ((m IoRegion) (off int) (n int) (acc (list int))) (list int)
  (if (le n 0) (rev acc) (mbox_got m (add off 4) (sub n 1) (cons (region_get32 m off) acc))))
