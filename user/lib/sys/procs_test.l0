; procs_test.l0 -- tests of procs.l0.

(def test_state_text () int
  (add (check_str "receiving" (state_text (state_receiving) 5) "waiting for a message on port 5")
       (add (check_str "filing" (state_text (state_filing) 12) "waiting for the file server on port 12")
            (check_str "running" (state_text (state_running) 0) "running"))))

; A process waiting on a set says how many ports it holds.
(def test_state_text_set () int
  (add (check_str "three" (state_text (state_receiving_set) 3) "waiting for a message on 3 ports")
       (check_str "one" (state_text (state_receiving_set) 1) "waiting for a message on 1 port")))

(def test_state_text_more () int
  (add (check_str "writing" (state_text (state_writing) 4) "writing to port 4")
       (add (check_str "reading" (state_text (state_reading) 9) "reading a line, to port 9")
            (check_str "unknown" (state_text 99 0) "state 99"))))

(def test_state_word () int
  (add (check_str "a wait" (state_word (state_waiting)) "waiting")
       (check_str "its detail" (state_detail (state_waiting) 7) "for pid 7")))

; Under an operating system there is no table.
(def test_no_table () int
  (add (check_int "no process" (length (procs_live)) 0)
       (check_str "no program" (program_name 3) "?")))

; ----------------------------------------------------------------- the CPUs

(def seen_two () CpuSeen (CpuSeen 1000000000 (map_put ((MapEmpty int int)) 5 300000000)))
(def seen_later () CpuSeen (CpuSeen 1500000000 (map_put (map_put ((MapEmpty int int)) 5 550000000) 6 10000000)))

; Pid 5 ran 250 ms of the 500 between: 50.0%. Pid 6, new, 10 ms of its
; life of 40 ms: 25.0%.
(def test_pid_tenths () int
  (add (check_int "since" (pid_tenths (seen_two) (seen_later) 5 0) 500)
  (add (check_int "over its life" (pid_tenths (seen_two) (seen_later) 6 40000000) 250)
       (check_int "not seen" (pid_tenths (seen_two) (seen_later) 7 100) 0))))

(def test_cpu_tenths_bounds () int
  (add (check_int "at most 100%" (cpu_tenths 900 600) 1000)
  (add (check_int "no time" (cpu_tenths 5 0) 0)
       (check_int "a third" (cpu_tenths 1 3) 333))))

(def test_tenths_text () int
  (add (check_str "some" (tenths_text 123) "12.3")
  (add (check_str "none" (tenths_text 0) "0.0")
       (check_str "all" (tenths_text 1000) "100.0"))))

(def test_serves_text () int
  (add (check_str "none" (serves_text (nil (list int))) "-")
       (check_str "two" (serves_text (cons "keyboard" (cons "pointer" (nil (list int))))) "keyboard,pointer")))

(def test_cpu_text () int
  (add (check_str "none yet" (cpu_text -1) "-") (check_str "two" (cpu_text 2) "2")))

; 2048 is 1.00; 246 is 0.120..., 0.12; 3071 is 1.4995, 1.50.
(def test_load_text () int
  (add (check_str "one" (load_text 2048) "1.00")
  (add (check_str "a little" (load_text 246) "0.12")
       (check_str "rounded" (load_text 3071) "1.50"))))

(def test_up_text () int
  (check_str "1 h 2 min 5 s" (up_text 3725000000000) "1:02:05"))

; Over a second: CPU 0 waited 600 ms and ran processes 300 ms, so it was
; busy 400 ms, 100 of them the kernel's; CPU 1 ran 990 ms.
(def test_uptime_text () int
  (let (a (CpuUsage 1000000000 0 0 0 0 (cons 0 (cons 0 (nil int))))
        b (CpuUsage 2000000000 600000000 2048 246 0 (cons 300000000 (cons 990000000 (nil int)))))
    (check_str "lines" (uptime_text a b)
      "up 0:00:02, load average: 1.00, 0.12, 0.00\nCPU 0: 40.0% busy, the kernel 10.0%\nCPU 1: 99.0% busy\n")))

; Under an operating system there is nothing to see.
(def test_cpu_seen_none () int
  (check_int "no time" (seen_time (cpu_seen (procs_live)) 1) -1))
