; procs_test.l0 -- tests of procs.l0.

(def test_state_text () int
  (add (check_str "receiving" (state_text (state_receiving) 5) "waiting for a message on port 5")
       (add (check_str "filing" (state_text (state_filing) 12) "waiting for the file server on port 12")
            (check_str "running" (state_text (state_running) 0) "running"))))

; A process waiting on a set says how many ports it holds.
(def test_state_text_set () int
  (add (check_str "three" (state_text (state_receiving_set) 3) "waiting for a message on 3 ports")
       (check_str "one" (state_text (state_receiving_set) 1) "waiting for a message on 1 port")))

(def test_state_text_more () int
  (add (check_str "writing" (state_text (state_writing) 4) "writing to port 4")
       (add (check_str "reading" (state_text (state_reading) 9) "reading a line, to port 9")
            (check_str "unknown" (state_text 99 0) "state 99"))))

(def test_state_word () int
  (add (check_str "a wait" (state_word (state_waiting)) "waiting")
       (check_str "its detail" (state_detail (state_waiting) 7) "for pid 7")))

; Under an operating system there is no table.
(def test_no_table () int
  (add (check_int "no process" (length (procs_live)) 0)
       (check_str "no program" (program_name 3) "?")))
