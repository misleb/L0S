; agenthome_test.l0 -- the home's parts and prompt, what is fixed, the
; history's lines, and writes and undos in a home under build/, which
; the Makefile makes with its .history, as this host has no fs.

; The test's home, and a file in it.
(def th () (list int) "build/agenthome_test")
(def tf () (list int) "build/agenthome_test/notes.txt")

; The test's home with an empty log, and its file holding s: the place
; each test of the history starts from.
(def fresh ((s (list int))) int
  (let (a (write_whole (home_in (th) (home_log_name)) (home_none))
        b (write_whole (tf) (bytes_from_list s)))
    (add (check_str "log emptied" a "") (check_str "file made" b ""))))

; The file's text now.
(def tf_text () (list int) (bytes_to_list (home_read (tf))))

; ---------------------------------------------------------- where it is

(def test_home () int
  (add (check_str "default" (home_of "api 10.0.2.2:8765\n") "/Volumes/data/agent")
       (add (check_str "given" (home_of "api x:1\nhome /Volumes/work/me # mine\n") "/Volumes/work/me")
            (check_str "made absolute" (home_of "home a/b/\n") "/a/b"))))

(def test_conf () int
  (add (check_str "a key" (home_conf "run_timeout 30\n" "run_timeout") "30")
       (check_str "none" (home_conf "# home x\n" "home") "")))

; ------------------------------------------------------------------ fixed

(def test_fixed_constitution () int
  (check_bool "constitution" (home_fixed "/h" "/h/CONSTITUTION.md") true))

(def test_fixed_history () int
  (add (check_bool "the directory" (home_fixed "/h" "/h/.history") true)
       (check_bool "in it" (home_fixed "/h" "/h/.history/log") true)))

; A path resolved as the tools resolve one is fixed however it was
; spelled.
(def test_fixed_spellings () int
  (add (check_bool "relative" (home_fixed "/h" (path_resolve "/h" ".history/3")) true)
       (check_bool "through .." (home_fixed "/h" (path_resolve "/h" "memory/../CONSTITUTION.md")) true)))

(def test_not_fixed () int
  (add (check_bool "rules" (home_fixed "/h" "/h/CLAUDE.md") false)
       (add (check_bool "a name beside" (home_fixed "/h" "/h/.historyx") false)
            (check_bool "another home" (home_fixed "/h" "/g/CONSTITUTION.md") false))))

(def test_inside () int
  (add (check_bool "in" (home_inside "/h" "/h/memory/a.md") true)
       (add (check_bool "itself" (home_inside "/h" "/h") true)
            (check_bool "beside" (home_inside "/h" "/hx/a") false))))

; ----------------------------------------------------------------- prompt

(def test_parts () int
  (check_str "parts"
    (bytes_to_list (home_parts (bytes_from_list "Fixed.\n") (bytes_from_list "Rules.\n") (bytes_from_list "Index.\n")
                               (cons (skill_line "notes" "Keeps notes.") (nil (list int)))))
    "# Your constitution (CONSTITUTION.md, fixed)\n\nFixed.\n\n# Your rules (CLAUDE.md)\n\nRules.\n\n# Your memory's index (memory/MEMORY.md)\n\nIndex.\n\n# Your skills (.claude/skills)\n\n- notes: Keeps notes. (read .claude/skills/notes/SKILL.md before using it)\n"))

(def test_parts_no_skills () int
  (check_bool "none yet" (ends_with (bytes_to_list (home_parts (home_none) (home_none) (home_none) (nil (list int))))
                                    "None yet.\n")
              true))

(def test_skill_description () int
  (check_str "description"
    (skill_description (bytes_from_list "---\nname: notes\ndescription:  Keeps notes in memory.  \n---\nThe body.\n"))
    "Keeps notes in memory."))

(def test_skill_no_frontmatter () int
  (add (check_str "none" (skill_description (bytes_from_list "description: not in frontmatter\n")) "")
       (check_str "after its end" (skill_description (bytes_from_list "---\nname: x\n---\ndescription: no\n")) "")))

(def test_skill_line_no_description () int
  (check_str "line" (skill_line "x" "") "- x: (no description) (read .claude/skills/x/SKILL.md before using it)\n"))

; ------------------------------------------------------------ the lines

(def test_hist_line () int
  (check_str "line" (hist_line (HistEntry 3 1793000000 "1792999000.2" "changed" "/h/my notes.txt"))
    "3 1793000000 1792999000.2 changed /h/my notes.txt\n"))

; A line read back, its path with a space in it.
(def test_hist_of () int
  (match (hist_of "3 1793000000 1792999000.2 changed /h/my notes.txt\n")
    ((None) (fail_because "read" "no entry"))
    ((Some e)
      (add (check_int "n" (.n e) 3)
           (add (check_str "conv" (.conv e) "1792999000.2")
                (check_str "path" (.path e) "/h/my notes.txt"))))))

(def test_hist_of_not_one () int
  (add (check_bool "short" (read_one (hist_of "3 17 x new")) false)
       (check_bool "no number" (read_one (hist_of "x 17 c new /p")) false)))

; Whether a line was read as an entry.
(def read_one ((o (Option HistEntry))) bool
  (match o ((None) false) ((Some e) true)))

; The next number after a log's, its highest, past a line that is not
; one.
(def test_hist_next () int
  (add (check_int "empty" (hist_next (home_none)) 1)
       (check_int "after" (hist_next (bytes_from_list "1 0 c new /a\nbad\n4 0 c dir /b\n2 0 c new /c\n")) 5)))

; 1793396400 is 2026-10-30 21:40 UTC: 20755 days, then 78000 s.
(def test_hist_when () int
  (add (check_str "a time" (hist_when 1793396400) "2026-10-30 21:40")
       (check_str "no clock" (hist_when 0) "-")))

(def test_hist_shown () int
  (check_str "shown" (hist_shown (HistEntry 2 0 "restore" "new" "/h/a")) "2  -  restore  new  /h/a"))

; -------------------------------------------------------------- writes

; A file not there is written, and its entry is new.
(def test_write_new () int
  (let (f (fresh "x")
        p (home_in (th) "fresh.txt")
        r (remove_file p)
        w (home_write (th) p (bytes_from_list "a") "c" 5))
    (add f (add (check_str "written" w "")
                (check_str "log" (bytes_to_list (hist_read (th))) (append "1 5 c new " (append p "\n")))))))

; A file there is kept whole first, and its entry is changed.
(def test_write_changed () int
  (let (f (fresh "before\n")
        w (home_write (th) (tf) (bytes_from_list "after\n") "c" 7))
    (add f (add (check_str "written" w "")
                (add (check_str "now" (tf_text) "after\n")
                     (add (check_str "kept" (bytes_to_list (home_read (hist_saved (th) 1))) "before\n")
                          (check_str "log" (bytes_to_list (hist_read (th)))
                            (append "1 7 c changed " (append (tf) "\n")))))))))

; A write outside the home is not the home's: no entry.
(def test_write_outside () int
  (let (f (fresh "x")
        w (home_write (th) "build/agenthome_test_outside.txt" (bytes_from_list "y") "c" 1))
    (add f (add (check_str "written" w "")
                (check_int "no entry" (length (hist_entries (hist_read (th)))) 0)))))

; A write that fails leaves no entry.
(def test_write_failed () int
  (let (f (fresh "x")
        w (home_write (th) (home_in (th) "no/such/dir.txt") (bytes_from_list "y") "c" 1))
    (add f (add (check_bool "failed" (is_empty w) false)
                (check_int "no entry" (length (hist_entries (hist_read (th)))) 0)))))

; Two writes, numbered in turn.
(def test_write_twice () int
  (let (f (fresh "one")
        a (home_write (th) (tf) (bytes_from_list "two") "c" 1)
        b (home_write (th) (tf) (bytes_from_list "three") "c" 2))
    (add f (check_int "next" (hist_next (hist_read (th))) 3))))

; ------------------------------------------------------------------ undo

; A change undone: the file as it was, and the undo an entry of its own.
(def test_undo_changed () int
  (let (f (fresh "before\n")
        w (home_write (th) (tf) (bytes_from_list "after\n") "c" 7))
    (match (home_undo (th) 1 8)
      ((Err why) (fail_because "undo" why))
      ((Ok said)
        (add f (add (check_str "said" said (append "wrote " (append (tf) " as it was")))
                    (add (check_str "as it was" (tf_text) "before\n")
                         (match (hist_find (hist_entries (hist_read (th))) 2)
                           ((None) (fail_because "its entry" "none"))
                           ((Some e) (add (check_str "conv" (.conv e) "undo:1") (check_str "kind" (.kind e) "changed")))))))))))

; The undo of an undo: the change again.
(def test_undo_undo () int
  (let (f (fresh "before\n")
        w (home_write (th) (tf) (bytes_from_list "after\n") "c" 7)
        u (home_undo (th) 1 8))
    (match (home_undo (th) 2 9)
      ((Err why) (fail_because "undo" why))
      ((Ok said) (add f (check_str "after again" (tf_text) "after\n"))))))

(def test_undo_none () int
  (let f (fresh "x")
    (match (home_undo (th) 9 1)
      ((Ok said) (fail_because "undo" said))
      ((Err why) (add f (check_str "why" why "no entry 9 in the history"))))))

; A new file's undo removes it, which fs does; with no fs here it fails,
; saying so, and nothing is kept.
(def test_undo_new_no_fs () int
  (let (f (fresh "x")
        r (write_whole (home_in (th) (home_log_name)) (bytes_from_list (append "1 0 c new " (append (tf) "\n")))))
    (match (home_undo (th) 1 2)
      ((Ok said) (fail_because "undo" said))
      ((Err why) (add f (check_int "no new entry" (length (hist_entries (hist_read (th)))) 1))))))
