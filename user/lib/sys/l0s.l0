; l0s.l0 -- the kernel's own calls, for programs built with --target proc
; to run under l0s. Link it, and common/abi.l0, common/initramfs.l0, and
; common/queue.l0, into every user program.
; A call that can fail returns a type of its own, whose constructors are
; every answer the kernel can give it, so a match on one handles them all;
; each type's X_of reads the kernel's word as one.
; Under any other host there is no kernel to call: the kernel's word is
; -3, which a call reads as its err_full answer if it has one, and
; otherwise as the first failure its type lists, but wait_pid as a
; status of -3 and tty_get as the kernel's own terminal; receiving gives
; (RecvFailed).

; Gives up the CPU to the next ready process, answering 0; and this
; process's pid.
(def l0s_yield () int (supervisor_call (call_yield) 0 0 0))
(def l0s_pid () int (supervisor_call (call_pid) 0 0 0))

; A new port, which only this process may receive on.
(def port_new () int (supervisor_call (call_port_new) 0 0 0))

; What port_send did: sent; or not, as there is no such port, its queue
; is full, or the payload is over max_message.
(data Sending (Sent) (SendNoPort) (SendFull) (SendTooBig))

; The Sending the kernel's word for port_send is: 0 sent, err_full,
; err_too_big, and anything else no such port.
(def sending_of ((code int)) Sending
  (if (eq code 0)
      (Sent)
      (if (eq code (err_full))
          (SendFull)
          (if (eq code (err_too_big)) (SendTooBig) (SendNoPort)))))

; Why port_send did not send, as a reason; empty if it did.
(def sending_why ((s Sending)) (list int)
  (match s
    ((Sent) "")
    ((SendNoPort) "no such port")
    ((SendFull) "its queue is full")
    ((SendTooBig) "the message is too big")))

; Sends payload to port.
(def port_send ((port int) (payload (list int))) Sending
  (let b (bytes_from_list payload)
    (sending_of (supervisor_send (call_send) port b 0 (bytes_len b)))))

; A message received: the pid that sent it, 0 for the kernel, and its
; payload; or (RecvFailed) if port is not this process's.
(data Message (Message int (list int)) (RecvFailed))

; The next message on port, waiting for one.
(def port_receive ((port int)) Message
  (message_of (supervisor_receive (call_receive) port (add (max_message) (header_len)))))

; The next message on port, or (RecvFailed) at once if none is waiting.
(def port_try_receive ((port int)) Message
  (message_of (supervisor_receive (call_try_receive) port (add (max_message) (header_len)))))

; The Message the kernel's bytes for a receive are: the sender's pid, a
; u32, then the payload; (RecvFailed) if they are shorter than that pid.
(def message_of ((b bytes)) Message
  (if (lt (bytes_len b) (header_len))
      (RecvFailed)
      (Message (le_u32 b 0) (bytes_range b (header_len) (bytes_len b)))))

; What name_register did: registered the name; or not, as the port is not
; this process's, the name is someone's already, or it is over 256 bytes.
(data Registration (Registered) (RegisterNoPort) (RegisterTaken) (RegisterTooLong))

; The Registration the kernel's word for name_register is: 0 registered,
; err_taken, err_too_big, and anything else not this process's port.
(def registration_of ((code int)) Registration
  (if (eq code 0)
      (Registered)
      (if (eq code (err_taken))
          (RegisterTaken)
          (if (eq code (err_too_big)) (RegisterTooLong) (RegisterNoPort)))))

; Why name_register did not register the name, as a reason; empty if it
; did.
(def registration_why ((r Registration)) (list int)
  (match r
    ((Registered) "")
    ((RegisterNoPort) "the port is not this process's")
    ((RegisterTaken) "the name is taken")
    ((RegisterTooLong) "the name is over 256 bytes")))

; Registers port under name.
(def name_register ((port int) (name (list int))) Registration
  (let b (bytes_from_list name)
    (registration_of (supervisor_send (call_register) port b 0 (bytes_len b)))))

; The port a name is registered as, or that none is: no name over 256
; bytes ever is.
(data Lookup (Found int) (NotFound))

; The Lookup the kernel's word for a name is: the port, or NotFound if
; it is negative.
(def lookup_of ((code int)) Lookup
  (if (ge code 0) (Found code) (NotFound)))

; The port registered as name.
(def name_lookup ((name (list int))) Lookup (lookup_of (lookup_code name)))

; The kernel's word for name: its port, or a negative code.
(def lookup_code ((name (list int))) int
  (let b (bytes_from_list name)
    (supervisor_send (call_lookup) 0 b 0 (bytes_len b))))

; The port registered as name, yielding until it is, at most tries times.
(def name_await ((name (list int)) (tries int)) Lookup
  (match (name_lookup name)
    ((Found port) (Found port))
    ((NotFound)
      (if (le tries 0)
          (NotFound)
          (let y (l0s_yield) (name_await name (sub tries 1)))))))

; What spawn_entry did: started the program, as the process with this
; pid; or not, as there is no such entry, it is not a program, or not an
; ELF the kernel starts, the arguments are over max_message bytes
; encoded, or no process can be made: every slot is live, or memory has
; run out.
(data Spawn (Spawned int) (SpawnNoEntry) (SpawnNotProgram) (SpawnTooBig) (SpawnNoRoom))

; The Spawn the kernel's word for a spawn is: a pid if positive,
; err_denied not a program, err_too_big, err_fault no room, and anything
; else no such entry.
(def spawn_of ((code int)) Spawn
  (if (gt code 0)
      (Spawned code)
      (if (eq code (err_denied))
          (SpawnNotProgram)
          (if (eq code (err_too_big))
              (SpawnTooBig)
              (if (eq code (err_fault)) (SpawnNoRoom) (SpawnNoEntry))))))

; Why spawn_entry did not start the program, as a reason; empty if it did.
(def spawn_why ((s Spawn)) (list int)
  (match s
    ((Spawned pid) "")
    ((SpawnNoEntry) "no such program")
    ((SpawnNotProgram) "not a program")
    ((SpawnTooBig) "too big")
    ((SpawnNoRoom) "no room for another process")))

; Starts the program that is entry e of the initramfs, with the arguments
; the inittab gives it.
(def spawn_entry ((e int)) Spawn (spawn_of (supervisor_call (call_spawn) e 0 0)))

; The same, with args in place of the inittab's.
(def spawn_entry_with ((e int) (args (list (list int)))) Spawn
  (let b (bytes_from_list (encode_args args))
    (spawn_of (supervisor_send (call_spawn_args) e b 0 (bytes_len b)))))

; What wait_pid waited for: the process's exit status; or that there is
; no such process. The kernel's word for that, err_no_port, is a status
; too, so a process that exits with -1 reads as (WaitNoProc).
(data Reaped (Reaped int) (WaitNoProc))

; The Reaped the kernel's word for wait_pid is: err_no_port no such
; process, and anything else the status.
(def reaped_of ((code int)) Reaped
  (if (eq code (err_no_port)) (WaitNoProc) (Reaped code)))

; Waits for pid to exit.
(def wait_pid ((pid int)) Reaped (reaped_of (supervisor_call (call_wait) pid 0 0)))

; Waits until clock_ns reaches t.
(def sleep_until ((t int)) int (supervisor_call (call_sleep_until) t 0 0))

; Waits ns nanoseconds, from now.
(def sleep_ns ((ns int)) int (sleep_until (add (clock_ns) ns)))

; What irq_bind did: bound the interrupt; or not, as the board has no
; such interrupt, this program may not drive devices or irq is below 1,
; the port is not this process's, or another has bound it already.
(data IrqBinding (IrqBound) (IrqAbsent) (IrqDenied) (IrqNoPort) (IrqTaken))

; The IrqBinding the kernel's word for irq_bind is: 0 bound, err_denied,
; err_no_port, err_taken, and anything else no such interrupt.
(def irq_binding_of ((code int)) IrqBinding
  (if (eq code 0)
      (IrqBound)
      (if (eq code (err_denied))
          (IrqDenied)
          (if (eq code (err_no_port))
              (IrqNoPort)
              (if (eq code (err_taken)) (IrqTaken) (IrqAbsent))))))

; Why irq_bind did not bind the interrupt, as a reason; empty if it did.
(def irq_binding_why ((b IrqBinding)) (list int)
  (match b
    ((IrqBound) "")
    ((IrqAbsent) "the board has no such interrupt")
    ((IrqDenied) "this program may not drive devices")
    ((IrqNoPort) "the port is not this process's")
    ((IrqTaken) "another process has bound it")))

; Has each interrupt irq sent to port, from pid 0, as irq_notice says.
; Only a program the inittab names in a dev line may.
(def irq_bind ((irq int) (port int)) IrqBinding
  (irq_binding_of (supervisor_call (call_irq_bind) irq port 0)))

; What irq_ack did: ended the interrupt; or not, as it is not this
; process's, or has not happened since it was last ended.
(data IrqAck (IrqAcked) (IrqNotPending))

; The IrqAck the kernel's word for irq_ack is: 0 ended, and anything else
; not pending.
(def irq_ack_of ((code int)) IrqAck
  (if (eq code 0) (IrqAcked) (IrqNotPending)))

; Ends interrupt irq, once its device no longer raises it.
(def irq_ack ((irq int)) IrqAck (irq_ack_of (supervisor_call (call_irq_ack) irq 0 0)))

; What dma_alloc gave: the address of the first page; or nothing, as
; this program may not drive devices, n is below 1 or over dma_limit, or
; memory has run out.
(data DmaAlloc (DmaPages int) (DmaDenied) (DmaTooMany) (DmaNoRoom))

; The DmaAlloc the kernel's word for dma_alloc is: the address if not
; negative, err_too_big, err_fault no room, and anything else denied.
(def dma_alloc_of ((code int)) DmaAlloc
  (if (ge code 0)
      (DmaPages code)
      (if (eq code (err_too_big))
          (DmaTooMany)
          (if (eq code (err_fault)) (DmaNoRoom) (DmaDenied)))))

; Why dma_alloc gave no pages, as a reason; empty if it did.
(def dma_alloc_why ((a DmaAlloc)) (list int)
  (match a
    ((DmaPages va) "")
    ((DmaDenied) "this program may not drive devices")
    ((DmaTooMany) "too many pages")
    ((DmaNoRoom) "memory has run out")))

; n zeroed pages of memory a device can read and write itself, by DMA,
; at consecutive addresses of this process. Only a program the inittab
; names in a dev line may. They last until the system stops.
(def dma_alloc ((n int)) DmaAlloc (dma_alloc_of (supervisor_call (call_dma_alloc) n 0 0)))

; Where a device reaches a DMA page; or nothing, as this program may not
; drive devices, or no DMA page of its holds the address.
(data DmaWhere (DmaAddress int) (DmaAddressDenied) (NotDma))

; The DmaWhere the kernel's word for dma_address is: the address if not
; negative, err_no_port not a DMA page, and anything else denied.
(def dma_where_of ((code int)) DmaWhere
  (if (ge code 0)
      (DmaAddress code)
      (if (eq code (err_no_port)) (NotDma) (DmaAddressDenied))))

; Where a device reaches the DMA page holding va, to write into its
; registers: page aligned, and not the address this process reaches it
; at. Pages next to each other here need not be next to each other
; there.
(def dma_address ((va int)) DmaWhere (dma_where_of (supervisor_call (call_dma_address) va 0 0)))

; What shm_alloc gave: the address of the first page; or nothing, as
; memory has run out, or n is below 1 or over dma_limit.
(data ShmAlloc (ShmPages int) (ShmNoRoom) (ShmTooMany))

; The ShmAlloc the kernel's word for shm_alloc is: the address if not
; negative, err_too_big, and anything else no room.
(def shm_alloc_of ((code int)) ShmAlloc
  (if (ge code 0)
      (ShmPages code)
      (if (eq code (err_too_big)) (ShmTooMany) (ShmNoRoom))))

; n zeroed pages of memory to share with other processes, at consecutive
; addresses of this one. Any process may. dma_open reaches them, as it
; does DMA pages.
(def shm_alloc ((n int)) ShmAlloc (shm_alloc_of (supervisor_call (call_shm_alloc) n 0 0)))

; What shm_share did: mapped the pages into the other process, at this
; address there, to tell it; or not, as there is no such process, n is
; below 1 or over dma_limit, or the pages are not this process's or the
; other has no room for them.
(data ShmShare (ShmShared int) (ShmShareNoProc) (ShmShareTooMany) (ShmShareFailed))

; The ShmShare the kernel's word for shm_share is: the address there if
; not negative, err_too_big, err_fault failed, and anything else no such
; process.
(def shm_share_of ((code int)) ShmShare
  (if (ge code 0)
      (ShmShared code)
      (if (eq code (err_too_big))
          (ShmShareTooMany)
          (if (eq code (err_fault)) (ShmShareFailed) (ShmShareNoProc)))))

; Why shm_share did not map the pages, as a reason; empty if it did.
(def shm_share_why ((s ShmShare)) (list int)
  (match s
    ((ShmShared there) "")
    ((ShmShareNoProc) "no such process")
    ((ShmShareTooMany) "too many pages")
    ((ShmShareFailed) "the pages are not this process's, or there is no room for them")))

; This process's n shared or DMA pages from va mapped into pid's too, the
; same memory.
(def shm_share ((va int) (n int) (pid int)) ShmShare
  (shm_share_of (supervisor_call (call_shm_share) va n pid)))

; What shm_unmap did: gave the pages up; or not, as they are not this
; process's, or n is below 1 or over dma_limit.
(data ShmUnmap (ShmUnmapped) (ShmUnmapNotYours) (ShmUnmapTooMany))

; The ShmUnmap the kernel's word for shm_unmap is: 0 given up,
; err_too_big, and anything else not this process's.
(def shm_unmap_of ((code int)) ShmUnmap
  (if (eq code 0)
      (ShmUnmapped)
      (if (eq code (err_too_big)) (ShmUnmapTooMany) (ShmUnmapNotYours))))

; This process's n shared or DMA pages from va given up: unmapped, and
; their memory freed once no process maps it. Touching them afterwards
; ends the process, and a region over them (dma_open) must not be used
; again.
(def shm_unmap ((va int) (n int)) ShmUnmap (shm_unmap_of (supervisor_call (call_shm_unmap) va n 0)))

; What shm_revoke did: took back this many of the other process's
; mappings; or not, as there is no such process, it is this one or drives
; devices, n is below 1 or over dma_limit, or the pages are not this
; process's.
(data ShmRevoke (ShmRevoked int) (ShmRevokeNoProc) (ShmRevokeDenied) (ShmRevokeTooMany) (ShmRevokeNotYours))

; The ShmRevoke the kernel's word for shm_revoke is: the mappings taken
; back if not negative, err_denied, err_too_big, err_fault not this
; process's, and anything else no such process.
(def shm_revoke_of ((code int)) ShmRevoke
  (if (ge code 0)
      (ShmRevoked code)
      (if (eq code (err_denied))
          (ShmRevokeDenied)
          (if (eq code (err_too_big))
              (ShmRevokeTooMany)
              (if (eq code (err_fault)) (ShmRevokeNotYours) (ShmRevokeNoProc))))))

; This process's n shared pages from va taken back from pid, which may
; have been given them by shm_share.
(def shm_revoke ((va int) (n int) (pid int)) ShmRevoke
  (shm_revoke_of (supervisor_call (call_shm_revoke) va n pid)))

; ---------------------------------------------------------------- mounts

; What fs_mount did: mounted the volume; or not, as the port is not this
; process's, the label is mounted already, or it is no label (1 to 15
; letters, digits, - and _).
(data Mounting (Mounted) (MountNoPort) (MountTaken) (MountBadLabel))

; The Mounting the kernel's word for fs_mount is: 0 mounted, err_taken,
; err_fault a bad label, and anything else not this process's port.
(def mounting_of ((code int)) Mounting
  (if (eq code 0)
      (Mounted)
      (if (eq code (err_taken))
          (MountTaken)
          (if (eq code (err_fault)) (MountBadLabel) (MountNoPort)))))

; Why fs_mount did not mount the volume, as a reason; empty if it did.
(def mounting_why ((m Mounting)) (list int)
  (match m
    ((Mounted) "")
    ((MountNoPort) "the port is not this process's")
    ((MountTaken) "the label is mounted already")
    ((MountBadLabel) "a label is 1 to 15 letters, digits, - and _")))

; The volume label, of the partition whose UUID is uuid, as text, or
; none, mounted at /Volumes/LABEL from port, this process's: the kernel
; sends it every call on a file there, as the fs protocol's requests
; (user/lib/fs.l0), until the port goes.
(def fs_mount ((label (list int)) (uuid (list int)) (port int)) Mounting
  (let b (bytes_from_list (if (is_empty uuid) label (append uuid (cons 32 label))))
    (mounting_of (supervisor_send (call_fs_mount) port b 0 (bytes_len b)))))

; What fs_unmount did: unmounted the volume; or not, as no volume of that
; label is mounted from the port, which is this process's, it is the
; system volume, or it is no label.
(data Unmounting (Unmounted) (UnmountNotMounted) (UnmountDenied) (UnmountBadLabel))

; The Unmounting the kernel's word for fs_unmount is: 0 unmounted,
; err_denied, err_fault a bad label, and anything else not mounted.
(def unmounting_of ((code int)) Unmounting
  (if (eq code 0)
      (Unmounted)
      (if (eq code (err_denied))
          (UnmountDenied)
          (if (eq code (err_fault)) (UnmountBadLabel) (UnmountNotMounted)))))

; Why fs_unmount did not unmount the volume, as a reason; empty if it did.
(def unmounting_why ((u Unmounting)) (list int)
  (match u
    ((Unmounted) "")
    ((UnmountNotMounted) "the volume is not mounted from this process's port")
    ((UnmountDenied) "the system volume is / for good")
    ((UnmountBadLabel) "a label is 1 to 15 letters, digits, - and _")))

; The volume label, which this process mounted from port, unmounted:
; /Volumes/LABEL is no volume from then on, and its label free.
(def fs_unmount ((label (list int)) (port int)) Unmounting
  (let b (bytes_from_list label)
    (unmounting_of (supervisor_send (call_fs_unmount) port b 0 (bytes_len b)))))

; A mount: where it is, / or /Volumes/LABEL, the port of the server whose
; files are there, 0 for the kernel's own, the initramfs, and the UUID
; of its volume's partition, as text, empty for none.
(data MountInfo (MountInfo (list int) int (list int)))

; Mount i of the kernel's table, from 0, /, if there is one.
(def mount_at ((i int)) (Option MountInfo)
  (mount_info_of (supervisor_receive (call_mount_at) i 128)))

; The MountInfo the kernel's bytes for mount_at are: the port, a u32, the
; path and a NUL, then the UUID; none if fewer than 5 bytes, as past the
; table's end.
(def mount_info_of ((b bytes)) (Option MountInfo)
  (if (lt (bytes_len b) 5)
      ((None MountInfo))
      (let rest (bytes_range b 4 (bytes_len b))
        (Some (MountInfo (up_to 0 rest) (le_u32 b 0) (drop_n rest (add (length (up_to 0 rest)) 1)))))))

; What root_switch did: made the volume /, the initramfs given up; or
; not, as this program is not the initramfs's, / is a volume already, the
; label is not mounted, or it is no label.
(data Switch (Switched) (SwitchDenied) (SwitchDone) (SwitchNoVolume) (SwitchBadLabel))

; The Switch the kernel's word for root_switch is: 0 switched,
; err_denied, err_taken done already, err_no_port no such volume, and
; anything else a bad label.
(def switch_of ((code int)) Switch
  (if (eq code 0) (Switched)
  (if (eq code (err_denied)) (SwitchDenied)
  (if (eq code (err_taken)) (SwitchDone)
  (if (eq code (err_no_port)) (SwitchNoVolume) (SwitchBadLabel))))))

; Why root_switch did not make the volume /, as a reason; empty if it did.
(def switch_why ((s Switch)) (list int)
  (match s
    ((Switched) "")
    ((SwitchDenied) "only a program of the initramfs may")
    ((SwitchDone) "/ is a volume already")
    ((SwitchNoVolume) "no such volume is mounted")
    ((SwitchBadLabel) "a label is 1 to 15 letters, digits, - and _")))

; The volume label, mounted at /Volumes/LABEL, made /, the system
; volume, once, for good: every path outside /Volumes is its from then
; on, and the initramfs is given up.
(def root_switch ((label (list int))) Switch
  (let b (bytes_from_list label)
    (switch_of (supervisor_send (call_root_switch) 0 b 0 (bytes_len b)))))

; What chdir did: made the directory the current one, or not, as there is
; none, it is a file, or the path is no good (over 1024 bytes, or not the
; program's to give, or its volume's server gone).
(data Chdir (ChdirDone) (ChdirNoDir) (ChdirNotDir) (ChdirBad))

; The Chdir the kernel's word for chdir is: 0 done, -3 no such directory,
; -9 a file, and anything else a bad path.
(def chdir_of ((code int)) Chdir
  (if (eq code 0) (ChdirDone)
  (if (eq code -3) (ChdirNoDir)
  (if (eq code -9) (ChdirNotDir) (ChdirBad)))))

; Why chdir did not, as a reason; empty if it did.
(def chdir_why ((c Chdir)) (list int)
  (match c
    ((ChdirDone) "")
    ((ChdirNoDir) "no such directory")
    ((ChdirNotDir) "not a directory")
    ((ChdirBad) "no good path")))

; The directory at path, from the current directory, made the current
; one, for this program and every program it starts after.
(def chdir ((path (list int))) Chdir
  (let b (bytes_from_list path)
    (chdir_of (supervisor_send (call_chdir) 0 b 0 (bytes_len b)))))

; The current directory: an absolute path with no final /, "/" at the
; start and under another operating system.
(def getcwd () (list int)
  (let b (supervisor_receive (call_getcwd) 0 (path_limit))
    (if (eq (bytes_len b) 0) "/" (bytes_to_list b))))

; path as an absolute path: itself if it starts with /, else from the
; current directory, with its . and .. taken out.
(def path_abs ((path (list int))) (list int)
  (if (if (is_empty path) false (eq (head path) 47))
      path
      (path_resolve (getcwd) path)))

; The board's boot arguments, as the kernel was booted with them: the
; words of QEMU's -append; none under another operating system.
(def boot_args () (list (list int))
  (match (decode_args (supervisor_receive (call_boot_args) 0 4096))
    ((Some args) args)
    ((None) (nil (list int)))))

; What spawn_image takes, as bytes: path's length and path, the
; arguments' length and the arguments encoded, none for the inittab's,
; then the image.
(def spawn_image_bytes ((path (list int)) (args (Option (list (list int)))) (image bytes)) bytes
  (let enc (match args ((Some a) (encode_args a)) ((None) (nil int)))
    (bytes_from_list (append (u32_le (length path)) (append path (append (u32_le (length enc)) (append enc (bytes_to_list image))))))))

; Starts the program whose image is image, named path, with args, or
; with the arguments the inittab gives path if none: as spawn_entry, but
; from the bytes of a file anywhere, a volume's; it never drives a
; device. SpawnNotProgram for an empty image.
(def spawn_image ((path (list int)) (args (Option (list (list int)))) (image bytes)) Spawn
  (let b (spawn_image_bytes path args image)
    (spawn_of (supervisor_send (call_spawn_image) 0 b 0 (bytes_len b)))))

; Every mount, in the table's order: the initramfs first, then each
; volume.
(def mount_list () (list MountInfo)
  (mount_list_from 0 (nil MountInfo)))

; mount_list's loop: the mounts from i on, after the reversed acc.
(def mount_list_from ((i int) (acc (list MountInfo))) (list MountInfo)
  (match (mount_at i)
    ((None) (rev acc))
    ((Some m) (mount_list_from (add i 1) (cons m acc)))))

; The n pages dma_alloc gave at va, to read and write with device_read32
; and the rest, at offsets from va.
(def dma_open ((va int) (n int)) DeviceOpened
  (open_device va (mul n (page_size))))

; Writes the bytes xs into q from off.
(def put_bytes ((q IoDevice) (off int) (xs (list int))) int
  (if (is_empty xs) 0 (let w (device_write8 q off (head xs)) (put_bytes q (add off 1) (tail xs)))))

; The n bytes of q from off.
(def get_bytes ((q IoDevice) (off int) (n int)) (list int)
  (get_bytes_onto q off (sub (add off n) 1) (nil int)))

; get_bytes's loop, from the end: puts the bytes of q from off up to i
; in front of acc.
(def get_bytes_onto ((q IoDevice) (off int) (i int) (acc (list int))) (list int)
  (if (lt i off) acc (get_bytes_onto q off (sub i 1) (cons (device_read8 q i) acc))))

; The path of entry e of the initramfs, such as "/bin/sh", or "/etc/" for
; a directory, or the empty list if there is no entry e, or the
; initramfs has been given up. Entries are numbered from 0 with no gaps.
(def entry_path_of ((e int)) (list int)
  (up_to 0 (entry_shown e)))

; Whether entry e of the initramfs is a program: the kernel follows its
; path with a NUL and x.
(def entry_is_program ((e int)) bool
  (ends_with (entry_shown e) (cons 0 "x")))

; What the kernel shows of entry e: its path, then for a program a NUL
; and x; empty if there is no entry e.
(def entry_shown ((e int)) (list int)
  (bytes_to_list (supervisor_receive (call_module_name) e (add (path_limit) 2))))

; The entry of the program what names, among paths, as entry_paths gives
; them, or -1: a path if what holds a /; and otherwise the first there is
; of /bin/what, /sbin/what, and what in an app's bundle,
; /Applications/NAME.app/what.
(def program_entry ((what (list int)) (paths (list (list int)))) int
  (index_of (program_path_in what paths) paths))

; The path of the program what names, as program_entry finds it among
; paths; /bin/what if there is none.
(def program_path_in ((what (list int)) (paths (list (list int)))) (list int)
  (if (any_eq 47 what)
      (normal_path what)
      (let sbin (append "/sbin/" what)
        (if (any_eq (program_path what) paths)
            (program_path what)
            (if (any_eq sbin paths) sbin (bundled_path what paths (program_path what)))))))

; What a name means when nothing else is known: /bin/what, or the path.
(def program_path ((what (list int))) (list int)
  (if (any_eq 47 what) (normal_path what) (append "/bin/" what)))

; The first of paths that is the program what in an app's bundle, or none.
(def bundled_path ((what (list int)) (paths (list (list int))) (none (list int))) (list int)
  (if (is_empty paths)
      none
      (if (is_bundled (head paths) what) (head paths) (bundled_path what (tail paths) none))))

; Whether path is /Applications/NAME.app/what, NAME holding no /.
(def is_bundled ((path (list int)) (what (list int))) bool
  (if (not (starts_with path (apps_dir)))
      false
      (let rest (rev (drop_n path (length (apps_dir))))
        (let file (rev (cons 47 what))
          (if (not (starts_with rest file))
              false
              (is_bundle_name (rev (drop_n rest (length file)))))))))

; Where apps are kept, each in a bundle, a directory NAME.app.
(def apps_dir () (list int) "/Applications/")

; Whether name is a bundle's, NAME.app: something before .app, and no /.
(def is_bundle_name ((name (list int))) bool
  (if (any_eq 47 name)
      false
      (if (le (length name) 4) false (starts_with (rev name) "ppa."))))

; Every entry's path, in order: entry_path_of from 0 until it gives none.
; A directory's path ends with a /.
(def entry_paths () (list (list int))
  (entry_paths_from 0 (nil (list int))))

; entry_paths's loop: the paths from entry e on, after the reversed acc.
(def entry_paths_from ((e int) (acc (list (list int)))) (list (list int))
  (let path (entry_path_of e)
    (if (is_empty path) (rev acc) (entry_paths_from (add e 1) (cons path acc)))))

; What proc_kill did: ended the process; or not, as there is no such
; process, or it is a driver, a program with a dev line.
(data Kill (Killed) (KillNoProc) (KillDenied))

; The Kill the kernel's word for proc_kill is: 0 ended, err_denied, and
; anything else no such process.
(def kill_of ((code int)) Kill
  (if (eq code 0)
      (Killed)
      (if (eq code (err_denied)) (KillDenied) (KillNoProc))))

; Ends pid, any process but this one, with killed_status.
(def proc_kill ((pid int)) Kill (kill_of (supervisor_call (call_kill) pid 0 0)))

; What proc_watch did: has the port told; or not, as there is no such
; process or the port is not this process's, or watch_limit ports watch
; it already.
(data Watch (Watched) (WatchNoProc) (WatchFull))

; The Watch the kernel's word for proc_watch is: 0 watched, err_full,
; and anything else no such process or port.
(def watch_of ((code int)) Watch
  (if (eq code 0)
      (Watched)
      (if (eq code (err_full)) (WatchFull) (WatchNoProc))))

; Has the kernel send port, which must be this process's, an exit notice
; when pid exits, or at once if it has.
(def proc_watch ((pid int) (port int)) Watch (watch_of (supervisor_call (call_watch) pid port 0)))

; What proc_info says of a process: its state, one of state_running to
; state_exited; its parent's pid; the entry of its program; a detail, as
; the state says; and the pages of memory it has, its own, and those it
; shares or a device reaches (proc_record).
(data ProcInfo (ProcInfo int int int int int int))

; What the kernel says of pid, or none if no process has it now: none has
; had it, or its slot of the process table has been given to another. A
; pid is never reused, but slots are, so to list every process, ask
; proc_slot for the pid in each slot, 1 to max_procs.
(def proc_info ((pid int)) (Option ProcInfo)
  (proc_info_of (supervisor_receive (call_proc_info) pid (proc_record_len))))

; What a slot of the process table holds: the pid it holds, live or
; exited, or last held; that it has held none; or that there is no such
; slot.
(data Slot (SlotHeld int) (SlotUnused) (NoSlot))

; The Slot the kernel's word for proc_slot is: a pid if positive, 0
; unused, and a negative word no such slot.
(def slot_of_code ((code int)) Slot
  (if (gt code 0) (SlotHeld code) (if (eq code 0) (SlotUnused) (NoSlot))))

; Slot i of the process table, 1 to max_procs.
(def proc_slot ((i int)) Slot (slot_of_code (supervisor_call (call_proc_slot) i 0 0)))

; The path of pid's program, as the kernel has it after its record: its
; entry's in the initramfs, or the path spawn_image was given; empty if
; no live process has pid.
(def proc_path ((pid int)) (list int)
  (proc_path_of (supervisor_receive (call_proc_info) pid (add (proc_record_len) (path_limit)))))

; The path proc_info's bytes hold after the record; empty if they are
; shorter than a record.
(def proc_path_of ((b bytes)) (list int)
  (if (lt (bytes_len b) (proc_record_len)) "" (bytes_range b (proc_record_len) (bytes_len b))))

; The ProcInfo the record proc_info received says, its module and detail
; signed, or none if the bytes are short.
(def proc_info_of ((b bytes)) (Option ProcInfo)
  (if (lt (bytes_len b) (proc_record_len))
      ((None ProcInfo))
      (Some (ProcInfo (le_u32 b 0) (le_u32 b 4) (s32 (le_u32 b 8)) (s32 (le_u32 b 12)) (le_u32 b 16) (le_u32 b 20)))))

; The memory processes are given, as mem_info says: the pages there are,
; and how many are given, each counted once however many processes share
; it. Every page not given is free; the kernel's page tables take theirs
; from the free ones, so the total moves a little as they come and go.
(data MemInfo (MemInfo int int))

; What the kernel says of the memory it gives, or none, under another
; operating system.
(def mem_info () (Option MemInfo)
  (mem_info_of (supervisor_receive (call_mem_info) 0 (mem_record_len))))

; The MemInfo the bytes mem_info received say, or none if they are short.
(def mem_info_of ((b bytes)) (Option MemInfo)
  (if (lt (bytes_len b) (mem_record_len))
      ((None MemInfo))
      (Some (MemInfo (le_u32 b 0) (le_u32 b 4)))))

; What an exit notice says: the pid and its status; or that m is not one.
(data Exit (Exited int int) (NotExit))

; The exit notice m holds: from pid 0, "exit" and two u32s, the status
; signed; NotExit if m is anything else.
(def exit_of ((m Message)) Exit
  (match m
    ((Message from payload)
      (if (if (eq from 0) (if (eq (length payload) 12) (starts_with payload "exit") false) false)
          (let b (bytes_from_list payload)
            (Exited (le_u32 b 4) (s32 (le_u32 b 8))))
          (NotExit)))
    ((RecvFailed) (NotExit))))

; Whether m is the kernel's notice that interrupt irq happened.
(def is_irq_notice ((m Message) (irq int)) bool
  (match m
    ((Message from payload) (if (eq from 0) (eq payload (irq_notice irq)) false))
    ((RecvFailed) false)))

; -------------------------------------------------------------- console

; The console driver's port, or none if no console is running.
(def console_port () Lookup (name_lookup "console"))

; A line typed at the console, with its newline, or empty once input has
; ended. With a terminal (tty_get), that is standard input, which the
; kernel reads from it; without one, it is from the console driver if one
; is running, as user/uart is, and otherwise from standard input. Each
; call to the console driver makes a port, which lasts until the process
; exits, so a program that reads many lines makes one and calls
; console_line_on.
(def console_line () (list int)
  (match (tty_get)
    ((Terminal port) (read_line))
    ((KernelTerminal)
      (match (console_port)
        ((Found console) (console_line_on console (port_new)))
        ((NotFound) (read_line))))))

; ------------------------------------------------------------ terminals

; What tty_set did: made the port the terminal; or not, as there is no
; such port.
(data TtyChange (TtySet) (TtyNoPort))

; The TtyChange the kernel's word for tty_set is: 0 set, and anything
; else no such port.
(def tty_change_of ((code int)) TtyChange
  (if (eq code 0) (TtySet) (TtyNoPort)))

; Makes port, a terminal as user/lib/tty.l0 says, this process's standard
; input, output, and error, and those of every process it starts from now
; on. 0 for port gives back the kernel's own: the serial line, and the
; inittab's stdin file.
(def tty_set ((port int)) TtyChange (tty_change_of (supervisor_call (call_tty_set) port 0 0)))

; A process's terminal: a port, or the kernel's own.
(data Terminal (Terminal int) (KernelTerminal))

; The Terminal the kernel's word for tty_get is: a port if positive, and
; otherwise the kernel's own.
(def terminal_of ((code int)) Terminal
  (if (gt code 0) (Terminal code) (KernelTerminal)))

; This process's terminal.
(def tty_get () Terminal (terminal_of (supervisor_call (call_tty_get) 0 0 0)))

; A line from the console driver at console, its reply sent to port,
; which must be this process's.
(def console_line_on ((console int) (port int)) (list int)
  (match (port_ask console port "r" "the console")
    ((Asked from line) line)
    ((AskFailed why) (nil int))))

; The port registered as name, waiting up to ns nanoseconds for a server
; to register it, sleeping 10 ms between lookups; or none if it never
; does, at once with no kernel at all.
(def name_wait ((name (list int)) (ns int)) Lookup
  (name_wait_until name (add (clock_ns) ns)))

; name_wait's loop, until clock_ns passes deadline; the kernel's word -3,
; no kernel, ends it at once.
(def name_wait_until ((name (list int)) (deadline int)) Lookup
  (let code (lookup_code name)
    (if (if (ge code 0) true (eq code -3))
        (lookup_of code)
        (if (gt (clock_ns) deadline)
            (NotFound)
            (let s (sleep_ns 10000000) (name_wait_until name deadline))))))

; ------------------------------------------------------------- keyboard

; A key event, as the keyboard driver, user/virtio-input, sends one to each port
; listening: the key's Linux code; 1 when pressed, 0 released, 2
; repeated as it is held; and the character it typed, with shift and
; caps lock, or 0 for none and for every release.
(data KeyEvent (KeyEvent int int int))

; The payload a key event is sent as: "key" and its three fields, each a
; u32.
(def key_notice ((ev KeyEvent)) (list int)
  (match ev
    ((KeyEvent code value ch) (append "key" (append (u32_le code) (append (u32_le value) (u32_le ch)))))))

; The key event m holds, or none if m is not one.
(def key_event_of ((m Message)) (Option KeyEvent)
  (match (tagged_u32s m "key" 3)
    ((Some ws) (Some (KeyEvent (nth ws 0) (nth ws 1) (nth ws 2))))
    ((None) ((None KeyEvent)))))

; What asking a driver for its events did: it is sending them, from its
; pid, which is how a listener tells its events from other messages; or
; not, as there is no such driver within 5 seconds, or it is gone, or it
; did not agree.
(data Listen (Listening int) (NoDriver) (ListenRefused))

; Asks the keyboard driver to send port, which must be this process's,
; every key event from now on.
(def keyboard_listen ((port int)) Listen (input_listen "keyboard" port))

; The same, of the driver registered as name.
(def input_listen ((name (list int)) (port int)) Listen
  (match (name_wait name 5000000000)
    ((NotFound) (NoDriver))
    ((Found drv)
      (match (port_ask drv port "listen" name)
        ((Asked from r) (if (eq r "ok") (Listening from) (ListenRefused)))
        ((AskFailed why) (NoDriver))))))

; The pid a listen's driver sends from, or -1 if it is not sending.
(def listen_pid_of ((l Listen)) int
  (match l ((Listening pid) pid) ((NoDriver) -1) ((ListenRefused) -1)))

; ------------------------------------------------------------- pointer

; Where the pointer is and which buttons are down, as the pointer driver,
; user/virtio-input tablet, sends it to each port listening, once a
; movement or a press is complete: x and y from 0 to 32767 across the
; screen, whatever its size, and the buttons as bits, 1 left, 2 right, 4
; middle.
(data PointerEvent (PointerEvent int int int))

; The largest x or y a pointer driver sends: the screen's far edge.
(def pointer_max () int 32767)

; The payload a pointer event is sent as: "ptr" and its three fields,
; each a u32.
(def pointer_notice ((ev PointerEvent)) (list int)
  (match ev
    ((PointerEvent x y buttons) (append "ptr" (append (u32_le x) (append (u32_le y) (u32_le buttons)))))))

; The pointer event m holds, or none if m is not one. x and y are signed,
; since the compositor sends a window where the pointer is relative to
; it, which may be left of it or above it while a button is held.
(def pointer_event_of ((m Message)) (Option PointerEvent)
  (match (tagged_u32s m "ptr" 3)
    ((Some ws) (Some (PointerEvent (s32 (nth ws 0)) (s32 (nth ws 1)) (nth ws 2))))
    ((None) ((None PointerEvent)))))

; A turn of the scroll wheel, as the pointer driver sends it to each port
; listening, just before the PointerEvent of the report it came in: where
; the pointer is, as that says, and how many steps the wheel turned, dx across and
; dy down. dy is positive toward the end of what is shown, as a wheel
; turned toward you scrolls, and dx positive to the right. The compositor
; sends a window the same, where the pointer is relative to it.
(data WheelEvent (WheelEvent int int int int))

; The payload a wheel event is sent as: "whl" and its four fields, each a
; u32.
(def wheel_notice ((ev WheelEvent)) (list int)
  (match ev
    ((WheelEvent x y dx dy) (append "whl" (append (u32_le x) (append (u32_le y) (append (u32_le dx) (u32_le dy))))))))

; The wheel event m holds, or none if m is not one. Every field is signed.
(def wheel_event_of ((m Message)) (Option WheelEvent)
  (match (tagged_u32s m "whl" 4)
    ((Some ws) (Some (WheelEvent (s32 (nth ws 0)) (s32 (nth ws 1)) (s32 (nth ws 2)) (s32 (nth ws 3)))))
    ((None) ((None WheelEvent)))))

; What the compositor tells a window besides keys and the pointer, as
; Wayland's enter and leave do: that the pointer has left it, and that it
; has come to the front, where keys go, or gone from there.
(def leave_notice () (list int) "lve")

; The payload that says the window has come to the front, if front, or
; gone from there: "foc" and 1 or 0, a u32.
(def focus_notice ((front bool)) (list int) (append "foc" (u32_le (if front 1 0))))

; Whether m says the pointer has left the window.
(def is_leave_notice ((m Message)) bool
  (match m ((Message from payload) (eq payload (leave_notice))) ((RecvFailed) false)))

; Whether m says the window is in front, or not; none if it says neither.
(def focus_notice_of ((m Message)) (Option bool)
  (match (tagged_u32s m "foc" 1)
    ((Some ws) (Some (not (eq (head ws) 0))))
    ((None) ((None bool)))))

; The n u32s after the three-byte tag of the notice m holds, or none if m
; is not that notice: what each event's X_of reads.
(def tagged_u32s ((m Message) (tag (list int)) (n int)) (Option (list int))
  (match m
    ((Message from payload)
      (if (if (eq (length payload) (add 3 (mul 4 n))) (starts_with payload tag) false)
          (Some (u32s_at (bytes_from_list payload) 3 n (nil int)))
          ((None (list int)))))
    ((RecvFailed) ((None (list int))))))

; The n u32s of b from byte i, in order, after the reversed acc.
(def u32s_at ((b bytes) (i int) (n int) (acc (list int))) (list int)
  (if (eq n 0) (rev acc) (u32s_at b (add i 4) (sub n 1) (cons (le_u32 b i) acc))))

; Asks the pointer driver for every pointer event, as keyboard_listen does
; the keyboard's.
(def pointer_listen ((port int)) Listen (input_listen "pointer" port))

; ------------------------------------------------------------- requests

; A request that wants an answer: the port to send it to, then the body.
(def request ((reply int) (body (list int))) (list int)
  (append (u32_le reply) body))

; The reply port of a request, or -1 if it is too short to have one.
(def request_reply ((payload (list int))) int
  (if (lt (length payload) 4) -1 (le_u32 (bytes_from_list payload) 0)))

; A request without its reply port: what the server is asked.
(def request_body ((payload (list int))) (list int)
  (drop_n payload 4))

; What asking a server came to: its answer, and who sent it, the
; server's pid; or why there is none, in words.
(data Asked (Asked int (list int)) (AskFailed (list int)))

; body asked of the server at port, its answer to rp, which must be this
; process's; noun names the server in why not, as "the disk".
(def port_ask ((port int) (rp int) (body (list int)) (noun (list int))) Asked
  (match (port_send port (request rp body))
    ((Sent)
      (match (port_receive rp)
        ((Message from payload) (Asked from payload))
        ((RecvFailed) (AskFailed (append "no reply from " noun)))))
    ((SendNoPort) (AskFailed (append noun " is gone")))
    ((SendFull) (AskFailed (append noun " did not take the request: its queue is full")))
    ((SendTooBig) (AskFailed (append "the request is too big for " noun)))))

; The answer, or error: WHY if there was none, as a reply would say it.
(def asked_reply ((a Asked)) (list int)
  (match a ((Asked from r) r) ((AskFailed why) (append "error: " why))))

; A reply as an error's reason, or empty for ok: error: WHY is WHY, and
; anything else is what noun said, as "the disk said ...".
(def reply_why ((r (list int)) (noun (list int))) (list int)
  (if (eq r "ok") "" (if (starts_with r "error: ") (drop_n r 7) (append noun (append " said " r)))))

; ------------------------------------------------------- shared memory

; n pages of new shared memory, opened to read and write: their address
; and the region; or why not, what naming them, as "a disk buffer". Each
; is a region, of which a process may open only so many, so a program
; makes one and keeps it.
(data ShmRegion (ShmRegion int IoDevice) (NoShmRegion (list int)))

; n pages of new shared memory, from shm_alloc, opened with dma_open;
; what names them in why not.
(def shm_region ((n int) (what (list int))) ShmRegion
  (match (shm_alloc n)
    ((ShmNoRoom) (NoShmRegion (append "no memory for " what)))
    ((ShmTooMany) (NoShmRegion (append what (append " of too many pages: " (digits n)))))
    ((ShmPages va)
      (match (dma_open va n)
        ((DeviceFailed fault why) (NoShmRegion why))
        ((DeviceOpened r) (ShmRegion va r))))))

; The n pages from va shared with pid: where pid sees them, or why not,
; noun naming pid, as "the compositor".
(def shm_share_to ((va int) (n int) (pid int) (noun (list int))) (Result int (list int))
  (match (shm_share va n pid)
    ((ShmShared there) ((Ok int (list int)) there))
    ((ShmShareNoProc) (shm_unshared noun (ShmShareNoProc)))
    ((ShmShareTooMany) (shm_unshared noun (ShmShareTooMany)))
    ((ShmShareFailed) (shm_unshared noun (ShmShareFailed)))))

; shm_share_to's failure: why the buffer could not be shared with noun.
(def shm_unshared ((noun (list int)) (s ShmShare)) (Result int (list int))
  ((Err int (list int)) (append "cannot share a buffer with " (append noun (append ": " (shm_share_why s))))))
