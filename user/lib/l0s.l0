; l0s.l0 -- the kernel's own calls, for programs built with --target proc
; to run under l0s. Link it, and common/abi.l0, common/initramfs.l0, and
; common/queue.l0, into every user program.
; Under any other host there is no kernel to call: the calls give -3, and
; receiving gives (RecvFailed).

(def l0s_yield () int (supervisor_call (call_yield) 0 0 0))
(def l0s_pid () int (supervisor_call (call_pid) 0 0 0))

; A new port, which only this process may receive on.
(def port_new () int (supervisor_call (call_port_new) 0 0 0))

; Sends payload to port: 0, or err_no_port, err_full, or err_too_big.
(def port_send ((port int) (payload (list int))) int
  (let b (bytes_from_list payload)
    (supervisor_send (call_send) port b 0 (bytes_len b))))

; A message received: the pid that sent it, 0 for the kernel, and its
; payload; or (RecvFailed) if port is not this process's.
(data Message (Message int (list int)) (RecvFailed))

; The next message on port, waiting for one.
(def port_receive ((port int)) Message
  (message_of (supervisor_receive (call_receive) port (add (max_message) (header_len)))))

; The next message on port, or (RecvFailed) at once if none is waiting.
(def port_try_receive ((port int)) Message
  (message_of (supervisor_receive (call_try_receive) port (add (max_message) (header_len)))))

(def message_of ((b bytes)) Message
  (if (lt (bytes_len b) (header_len))
      (RecvFailed)
      (Message (le_u32 b 0) (bytes_range b (header_len) (bytes_len b)))))

; Registers port under name: 0, err_no_port if port is not this
; process's, or err_taken.
(def name_register ((port int) (name (list int))) int
  (let b (bytes_from_list name)
    (supervisor_send (call_register) port b 0 (bytes_len b))))

; The port registered as name, or err_no_port.
(def name_lookup ((name (list int))) int
  (let b (bytes_from_list name)
    (supervisor_send (call_lookup) 0 b 0 (bytes_len b))))

; The port registered as name, yielding until it is, at most tries times;
; err_no_port if it never was.
(def name_await ((name (list int)) (tries int)) int
  (let port (name_lookup name)
    (if (if (ge port 0) true (le tries 0))
        port
        (let y (l0s_yield) (name_await name (sub tries 1))))))

; Starts the program that is entry e of the initramfs, with the arguments
; the inittab gives it: its pid, or err_no_port if there is no entry e,
; err_denied if it is not a program, err_fault if no process can be made.
(def spawn_entry ((e int)) int (supervisor_call (call_spawn) e 0 0))

; The same, with args in place of the inittab's; or err_too_big if they
; are over max_message bytes encoded.
(def spawn_entry_with ((e int) (args (list (list int)))) int
  (let b (bytes_from_list (encode_args args))
    (supervisor_send (call_spawn_args) e b 0 (bytes_len b))))

; Waits for pid to exit: its status, or err_no_port.
(def wait_pid ((pid int)) int (supervisor_call (call_wait) pid 0 0))

; Waits until clock_ns reaches t.
(def sleep_until ((t int)) int (supervisor_call (call_sleep_until) t 0 0))

(def sleep_ns ((ns int)) int (sleep_until (add (clock_ns) ns)))

; Has each interrupt irq sent to port, from pid 0, as irq_notice says.
; Only a program the inittab names in a dev line may.
(def irq_bind ((irq int) (port int)) int (supervisor_call (call_irq_bind) irq port 0))

; Ends interrupt irq, once its device no longer raises it.
(def irq_ack ((irq int)) int (supervisor_call (call_irq_ack) irq 0 0))

; n zeroed pages of memory a device can read and write itself, by DMA,
; at consecutive addresses of this process: the first one's address, or
; err_denied if the program may not drive devices, err_too_big for n
; below 1 or over dma_limit, err_fault if memory has run out. Only a
; program the inittab names in a dev line may. They last until the
; system stops.
(def dma_alloc ((n int)) int (supervisor_call (call_dma_alloc) n 0 0))

; Where a device reaches the DMA page holding va, to write into its
; registers: page aligned, and not the address this process reaches it
; at. Pages next to each other here need not be next to each other
; there. err_no_port if no DMA page holds va.
(def dma_address ((va int)) int (supervisor_call (call_dma_address) va 0 0))

; n zeroed pages of memory to share with other processes, at consecutive
; addresses of this one: the first one's address, or err_too_big for n
; below 1 or over dma_limit, err_fault if memory has run out. Any
; process may. dma_open reaches them, as it does DMA pages.
(def shm_alloc ((n int)) int (supervisor_call (call_shm_alloc) n 0 0))

; This process's n shared or DMA pages from va mapped into pid's too, the
; same memory: the address pid reaches them at, to tell it, or
; err_no_port if there is no such process, err_fault if they are not
; this process's or pid has no room.
(def shm_share ((va int) (n int) (pid int)) int (supervisor_call (call_shm_share) va n pid))

; This process's n shared or DMA pages from va given up: unmapped, and
; their memory freed once no process maps it. 0, or err_too_big for n
; below 1 or over dma_limit, err_fault if they are not this process's.
; Touching them afterwards ends the process, and a region over them
; (dma_open) must not be used again.
(def shm_unmap ((va int) (n int)) int (supervisor_call (call_shm_unmap) va n 0))

; This process's n shared pages from va taken back from pid, which may
; have been given them by shm_share: how many of pid's mappings went, or
; err_denied if pid is this process or drives devices, err_no_port if
; there is no such process, err_fault if they are not this process's.
(def shm_revoke ((va int) (n int) (pid int)) int (supervisor_call (call_shm_revoke) va n pid))

; The n pages dma_alloc gave at va, to read and write with device_read32
; and the rest, at offsets from va.
(def dma_open ((va int) (n int)) DeviceOpened
  (open_device va (mul n (page_size))))

; The path of entry e of the initramfs, such as "/bin/sh", or "/etc/" for
; a directory, or the empty list if there is no entry e. Entries are
; numbered from 0 with no gaps.
(def entry_path_of ((e int)) (list int)
  (bytes_to_list (supervisor_receive (call_module_name) e (path_limit))))

; The entry of the program what names, among paths, as entry_paths gives
; them, or -1: a path if what holds a /, and otherwise /bin/what.
(def program_entry ((what (list int)) (paths (list (list int)))) int
  (index_of (program_path what) paths))

(def program_path ((what (list int))) (list int)
  (if (any_eq 47 what) (normal_path what) (append "/bin/" what)))

; Every entry's path, in order: entry_path_of from 0 until it gives none.
; A directory's path ends with a /.
(def entry_paths () (list (list int))
  (entry_paths_from 0 (nil (list int))))

(def entry_paths_from ((e int) (acc (list (list int)))) (list (list int))
  (let path (entry_path_of e)
    (if (is_empty path) (rev acc) (entry_paths_from (add e 1) (cons path acc)))))

; Ends pid, any process but this one, with killed_status: 0, or
; err_no_port if there is no such process, err_denied if it is a driver,
; a program with a dev line.
(def proc_kill ((pid int)) int (supervisor_call (call_kill) pid 0 0))

; Has the kernel send port, which must be this process's, an exit notice
; when pid exits, or at once if it has.
(def proc_watch ((pid int) (port int)) int (supervisor_call (call_watch) pid port 0))

; What proc_info says of a process: its state, one of state_running to
; state_exited; its parent's pid; the entry of its program; and a detail,
; as the state says.
(data ProcInfo (ProcInfo int int int int))

; What the kernel says of pid, or none if no process has it now: none has
; had it, or its slot of the process table has been given to another. A
; pid is never reused, but slots are, so to list every process, ask
; proc_slot for the pid in each slot, 1 to max_procs.
(def proc_info ((pid int)) (Option ProcInfo)
  (proc_info_of (supervisor_receive (call_proc_info) pid (proc_record_len))))

; The pid slot i of the process table holds, live or exited, or last
; held; 0 if it has held none; -1 if there is no slot i.
(def proc_slot ((i int)) int (supervisor_call (call_proc_slot) i 0 0))

(def proc_info_of ((b bytes)) (Option ProcInfo)
  (if (lt (bytes_len b) (proc_record_len))
      ((None ProcInfo))
      (Some (ProcInfo (le_u32 b 0) (le_u32 b 4) (s32 (le_u32 b 8)) (s32 (le_u32 b 12))))))

; What an exit notice says: the pid and its status; or that m is not one.
(data Exit (Exited int int) (NotExit))

(def exit_of ((m Message)) Exit
  (match m
    ((Message from payload)
      (if (if (eq from 0) (if (eq (length payload) 12) (starts_with payload "exit") false) false)
          (let b (bytes_from_list payload)
            (Exited (le_u32 b 4) (s32 (le_u32 b 8))))
          (NotExit)))
    ((RecvFailed) (NotExit))))

(def is_irq_notice ((m Message) (irq int)) bool
  (match m
    ((Message from payload) (if (eq from 0) (eq payload (irq_notice irq)) false))
    ((RecvFailed) false)))

; -------------------------------------------------------------- console

; The console driver's port, or a negative number if no console is
; running: err_no_port under l0s, -3 with no kernel at all.
(def console_port () int (name_lookup "console"))

; A line typed at the console, with its newline, or empty once input has
; ended. With a terminal (tty_get), that is standard input, which the
; kernel reads from it; without one, it is from the console driver if one
; is running, as user/uart is, and otherwise from standard input. Each
; call to the console driver makes a port, which lasts until the process
; exits, so a program that reads many lines makes one and calls
; console_line_on.
(def console_line () (list int)
  (if (gt (tty_get) 0)
      (read_line)
      (let console (console_port)
        (if (lt console 0) (read_line) (console_line_on console (port_new))))))

; ------------------------------------------------------------ terminals

; Makes port, a terminal as user/lib/tty.l0 says, this process's standard
; input, output, and error, and those of every process it starts from now
; on: 0, or err_no_port if there is no such port. 0 for port gives back
; the kernel's own: the serial line, and the inittab's stdin file.
(def tty_set ((port int)) int (supervisor_call (call_tty_set) port 0 0))

; This process's terminal's port, or 0 for the kernel's own; -3 with no
; kernel at all.
(def tty_get () int (supervisor_call (call_tty_get) 0 0 0))

; A line from the console driver at console, its reply sent to port,
; which must be this process's.
(def console_line_on ((console int) (port int)) (list int)
  (if (not (eq (port_send console (request port "r")) 0))
      (nil int)
      (match (port_receive port)
        ((Message from payload) payload)
        ((RecvFailed) (nil int)))))

; The port registered as name, waiting up to ns nanoseconds for a server
; to register it, sleeping 10 ms between lookups; or err_no_port if it
; never does, and -3 at once with no kernel at all.
(def name_wait ((name (list int)) (ns int)) int
  (name_wait_until name (add (clock_ns) ns)))

(def name_wait_until ((name (list int)) (deadline int)) int
  (let port (name_lookup name)
    (if (if (ge port 0) true (eq port -3))
        port
        (if (gt (clock_ns) deadline)
            port
            (let s (sleep_ns 10000000) (name_wait_until name deadline))))))

; ------------------------------------------------------------- keyboard

; A key event, as the keyboard driver, user/virtio-input, sends one to each port
; listening: the key's Linux code; 1 when pressed, 0 released, 2
; repeated as it is held; and the character it typed, with shift and
; caps lock, or 0 for none and for every release.
(data KeyEvent (KeyEvent int int int))

(def key_notice ((ev KeyEvent)) (list int)
  (match ev
    ((KeyEvent code value ch) (append "key" (append (u32_le code) (append (u32_le value) (u32_le ch)))))))

; The key event m holds, or none if m is not one.
(def key_event_of ((m Message)) (Option KeyEvent)
  (match m
    ((Message from payload)
      (if (if (eq (length payload) 15) (starts_with payload "key") false)
          (let b (bytes_from_list payload)
            (Some (KeyEvent (le_u32 b 3) (le_u32 b 7) (le_u32 b 11))))
          ((None KeyEvent))))
    ((RecvFailed) ((None KeyEvent)))))

; Asks the keyboard driver to send port, which must be this process's,
; every key event from now on: 0, or a negative code if there is no
; keyboard driver within 5 seconds, or it did not agree.
(def keyboard_listen ((port int)) int (input_listen "keyboard" port))

; The same, of the driver registered as name.
(def input_listen ((name (list int)) (port int)) int
  (let drv (name_wait name 5000000000)
    (if (lt drv 0)
        drv
        (if (not (eq (port_send drv (request port "listen")) 0))
            (err_no_port)
            (match (port_receive port)
              ((Message from payload) (if (eq payload "ok") 0 (err_denied)))
              ((RecvFailed) (err_no_port)))))))

; ------------------------------------------------------------- pointer

; Where the pointer is and which buttons are down, as the pointer driver,
; user/virtio-input tablet, sends it to each port listening, once a
; movement or a press is complete: x and y from 0 to 32767 across the
; screen, whatever its size, and the buttons as bits, 1 left, 2 right, 4
; middle.
(data PointerEvent (PointerEvent int int int))

(def pointer_max () int 32767)

(def pointer_notice ((ev PointerEvent)) (list int)
  (match ev
    ((PointerEvent x y buttons) (append "ptr" (append (u32_le x) (append (u32_le y) (u32_le buttons)))))))

; The pointer event m holds, or none if m is not one. x and y are signed,
; since the compositor sends a window where the pointer is relative to
; it, which may be left of it or above it while a button is held.
(def pointer_event_of ((m Message)) (Option PointerEvent)
  (match m
    ((Message from payload)
      (if (if (eq (length payload) 15) (starts_with payload "ptr") false)
          (let b (bytes_from_list payload)
            (Some (PointerEvent (s32 (le_u32 b 3)) (s32 (le_u32 b 7)) (le_u32 b 11))))
          ((None PointerEvent))))
    ((RecvFailed) ((None PointerEvent)))))

; What the compositor tells a window besides keys and the pointer, as
; Wayland's enter and leave do: that the pointer has left it, and that it
; has come to the front, where keys go, or gone from there.
(def leave_notice () (list int) "lve")

(def focus_notice ((front bool)) (list int) (append "foc" (u32_le (if front 1 0))))

(def is_leave_notice ((m Message)) bool
  (match m ((Message from payload) (eq payload (leave_notice))) ((RecvFailed) false)))

; Whether m says the window is in front, or not; none if it says neither.
(def focus_notice_of ((m Message)) (Option bool)
  (match m
    ((Message from payload)
      (if (if (eq (length payload) 7) (starts_with payload "foc") false)
          (Some (not (eq (le_u32 (bytes_from_list payload) 3) 0)))
          ((None bool))))
    ((RecvFailed) ((None bool)))))

; Asks the pointer driver for every pointer event, as keyboard_listen does
; the keyboard's.
(def pointer_listen ((port int)) int (input_listen "pointer" port))

; ------------------------------------------------------------- requests

; A request that wants an answer: the port to send it to, then the body.
(def request ((reply int) (body (list int))) (list int)
  (append (u32_le reply) body))

; The reply port of a request, or -1 if it is too short to have one.
(def request_reply ((payload (list int))) int
  (if (lt (length payload) 4) -1 (le_u32 (bytes_from_list payload) 0)))

(def request_body ((payload (list int))) (list int)
  (drop_n payload 4))
