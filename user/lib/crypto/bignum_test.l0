; bignum_test.l0 -- tests of bignum.l0, against numbers Python's own
; big integers give.

; The number the hex digits s spell, any count of them.
(def bn_t ((s (list int))) (array int)
  (bn_of_bytes (bn_hex (if (eq (mod (length s) 2) 1) (cons 48 s) s))))

; 0 if a is the number s spells, and 1 otherwise.
(def bn_check ((name (list int)) (a (array int)) (s (list int))) int
  (check_int name (bn_compare a (bn_t s)) 0))

(def test_bn_bytes_round () int
  (let b (bn_hex "0001020304fffefd80")
    (add (check_true "round" (eq (bn_to_bytes (bn_of_bytes b) 9) b))
         (check_true "shorter" (eq (bn_to_bytes (bn_of_bytes b) 4) (bn_hex "fffefd80"))))))

(def test_bn_of_bytes () int
  (let a (bn_of_bytes (bn_hex "0102030405060708"))
    (add (check_int "limb 0" (array_get a 0) (bit_and 72623859790382856 (bn_mask)))
         (check_int "limbs" (array_len a) 3))))

(def test_bn_of_int () int
  (check_true "of int" (eq (bn_to_bytes (bn_of_int 1234567890123) 8) (bn_hex "0000011f71fb04cb"))))

(def test_bn_bits () int
  (add (check_int "zero" (bn_bits (bn_of_int 0)) 0)
       (add (check_int "one" (bn_bits (bn_of_int 1)) 1)
            (check_int "2^40" (bn_bits (bn_of_int 1099511627776)) 41))))

(def test_bn_compare () int
  (add (check_int "less" (bn_compare (bn_t "ffff") (bn_t "010000")) -1)
       (add (check_int "more" (bn_compare (bn_t "010000") (bn_t "ffff")) 1)
            (check_int "same, other lengths" (bn_compare (bn_resize (bn_t "1234") 7) (bn_t "1234")) 0))))

(def bn_a () (list int) "5ed64ac5db9d707107e855c384429e821a4c74803e31ba1621582283d15a9ec0806705fca16")

(def bn_c () (list int) "b44efbc8d60b21fbac78255d6807923986bb968a437d5c8dfc")

(def test_bn_add () int
  (bn_check "add" (bn_add (bn_t (bn_a)) (bn_t (bn_c))) "5ed64ac5db9d707107e855c38f878e3ea7ad269ff8f93c6bf7d89ba769c65829249edbc5812"))

(def test_bn_sub () int
  (bn_check "sub" (bn_sub (bn_t (bn_a)) (bn_t (bn_c))) "5ed64ac5db9d707107e855c378fdaec58cebc260836a37c04ad7a96038eee557dc2f3033c1a"))

(def test_bn_mod () int
  (bn_check "mod" (bn_mod (bn_t (bn_a)) (bn_t (bn_c))) "548f264128d90003334ae07b1a857c13310532e4fd0181074a"))

(def test_bn_shr () int
  (bn_check "shr 77" (bn_shr (bn_t (bn_a)) 77) "2f6b2562edceb83883f42ae1c2214f410d263a401f18dd0b10ac1141"))

(def test_bn_mod_exp_small () int
  (let m (bn_mont_new (bn_of_int 1000000007))
    (check_int "3^200" (bn_compare (bn_mod_exp m (bn_of_int 3) (bn_of_int 200)) (bn_of_int 136318165)) 0)))

(def test_bn_mod_exp_zero () int
  (let m (bn_mont_new (bn_of_int 1000000007))
    (check_int "x^0" (bn_compare (bn_mod_exp m (bn_of_int 3) (bn_of_int 0)) (bn_of_int 1)) 0)))

; A base past the modulus is reduced first.
(def test_bn_mod_exp_big_base () int
  (let m (bn_mont_new (bn_of_int 1000000007))
    (check_int "(3 + 2n)^200" (bn_compare (bn_mod_exp m (bn_of_int 2000000017) (bn_of_int 200)) (bn_of_int 136318165)) 0)))

(def bn_n2048 () (list int)
  (append "ad45f23d3b1a11df587fd2803bab6c398d88348a7eed8d14f06d3fef701966a0c381e88f38c0c8fd8712b8bc076f3787b9d179e06c0fd4f5f8130c4237730edfafbd67f9619699cfe1988ad9f06c144a025b413f8a9a021ea648a7dd06839eb905b6e6e307d4bedc51431193e6c3f3391a2b8f1ff1fd42a29755d4c13a902931cd"
          "447e35b8b6d8fe442e3d437204e52db2221a58008a05a6c4647159c324c9859b810e766ec9d28663ca828dd5f4b3b2e4b06ce60741c7a87ce42c8218072e8c35bf992dc9e9c616612e7696a6cecc1b78e510617311d8a3c2ce6f447ed4d57b1e2feb89414c343c1027c4d1c386bbc4cd613e30d8f16adf91b7584a2265b1f5"))

(def bn_b2048 () (list int)
  (append "bcfbb0acab1a6bc69d4bd8b3fa7aa7e1fab9d78c7e134f5dfbd3d12c4a3698aa2ca1af6a107b75677f6cbdcc22af58be6521cc3e2434e37af027bc08d6af57da71144896c8da1964b2d2bc815a47c5f0dfb4a5d8a064df7fd63116e1ea24c4f9341c68966baea148beab134da98f1d3099fdf5ab99254ae901e35cd47d380d"
          "81f9c1f66c0f3459f79b17aeefba91fc803468b6b610a9f7f9270f4eb8b333a8e5446dd4552b82f6be3edc0a1ef2a4f04be03db0dc2574bdb94067edfe175330a11d459a2f978d8719999e3fa46d6753ec148cb48e73ca47ea90a8f0d66b829e6a8ac4ba05805975ed2f89d94a2f20aaf3c64af775a89294c2cd789a380208a9"))

(def bn_r2048 () (list int)
  (append "15925b400c9429fd9503523bdbb6157fd9552ddf62a3d47b14758fecae23657441ee21c7e8b42c41a2c830fc7e37bf08688ad6f1205d40a03dde79e20dfe616525f5f469192b2e423835a3967db3edc4cfa600bc1e9563823c537bb5b0e7d3e3d7f997561f05622a66528a2a14d241742819c55c847faa11b3fb7e62a4d04f3c"
          "b84894ecf2cc6509ec91eed4222ed531d67d3c55bf76b7ae435e2ddb2976691a8ea880646d14e93c8ff1f56fbcfc462f5702663781cb5cfdee5995c086ba11a19c4a256c50df406a62507edf9656f86505527457dcfc50d8a632298f91f209a72e43a179f9648af4d19a9401db6b8927a688713414c0bc92b1459e057aa9e9a2"))

(def test_bn_mod_exp_2048 () int
  (let m (bn_mont_new (bn_t (bn_n2048)))
    (bn_check "2048-bit power" (bn_mod_exp m (bn_t (bn_b2048)) (bn_t "1622bd795fec898f")) (bn_r2048))))

; The Montgomery form goes in and comes out unchanged.
(def test_bn_mont_round () int
  (let (m (bn_mont_new (bn_t (bn_n2048)))
        b (bn_t (bn_b2048)))
    (check_int "round" (bn_compare (bn_from_mont m (bn_to_mont m b)) b) 0)))

(def bn_p25519 () (list int) "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed")

(def test_bn_mod_inv () int
  (let m (bn_mont_new (bn_t (bn_p25519)))
    (bn_check "inverse" (bn_mod_inv m (bn_t "ab54a98ceb1f0ad2")) "7a570346a51a615e14aaf9c181394b068f99f645deb18df082f56851ae8aea6c")))

; p - 3 and 16: their sum is 13 past p, and 16 less p - 3 is 19 less p.
(def test_bn_mod_add_sub () int
  (let (m (bn_mont_new (bn_t (bn_p25519)))
        a (bn_resize (bn_t "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffea") (.k m))
        b (bn_resize (bn_t "10") (.k m)))
    (add (bn_check "wraps up" (bn_mod_add m a b) "d")
         (bn_check "wraps down" (bn_mod_sub m b a) "13"))))
