; sshkey_test.l0 -- tests of sshkey.l0, against keys ssh-keygen made
; (an Ed25519 key unencrypted and one under a passphrase, and an ECDSA
; P-256 key) with the fingerprints ssh-keygen -l printed, and signatures
; of "l0s signs this" that Python's cryptography made by the ECDSA key,
; by a 2048-bit RSA key in both RSA algorithms, and by the Ed25519 key.

; The bytes base64 text s spells, or none.
(def sk_b64 ((s (list int))) bytes
  (let b (bytes_from_list s)
    (match (base64_decode b 0 (bytes_len b)) ((Some d) d) ((None) (bytes_from_list "")))))

; What is signed.
(def sk_data () bytes (bytes_from_list "l0s signs this"))

; The text of a private key file of the base64 lines ls, in its armor.
(def sk_armor ((ls (list (list int)))) (list int)
  (append "-----BEGIN OPENSSH PRIVATE KEY-----\n"
    (append (join_with "\n" ls) "\n-----END OPENSSH PRIVATE KEY-----\n")))

; The Ed25519 key's file, and its public blob and signature.
(def sk_user_file () (list int)
  (sk_armor (split_spaces "b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW QyNTUxOQAAACACaTvKTlHHmYSX04Lf49xc3V+1/O7hqec3uHYjqRmN7AAAAJDx2z5P8ds+ TwAAAAtzc2gtZWQyNTUxOQAAACACaTvKTlHHmYSX04Lf49xc3V+1/O7hqec3uHYjqRmN7A AAAEC74UnSdiiQqtcbfr2afuIt8SFUy+a8f6LGReTYp/XYegJpO8pOUceZhJfTgt/j3Fzd X7X87uGp5ze4diOpGY3sAAAACGwwcyB0ZXN0AQIDBAU=")))
(def sk_user_pub () (list int) "AAAAC3NzaC1lZDI1NTE5AAAAIAJpO8pOUceZhJfTgt/j3FzdX7X87uGp5ze4diOpGY3s")
(def sk_user_sig () (list int) "AAAAC3NzaC1lZDI1NTE5AAAAQO6AOJpCHhyVFTphWNGWOekNfYLFTgqO9Pf4xlJWbhmTO1sX925BTNn2GPgtEIFZczQjsnmJ3ML+UnN8hD43fAg=")

; The same kind of key under the passphrase pw.
(def sk_enc_file () (list int)
  (sk_armor (split_spaces "b3BlbnNzaC1rZXktdjEAAAAACmFlczI1Ni1jdHIAAAAGYmNyeXB0AAAAGAAAABAR+jAAc9 heC5y15dCkt7GlAAAAIAAAAAEAAAAzAAAAC3NzaC1lZDI1NTE5AAAAIFtqRBxzsMBDr0vb wvpa1mOxsPVKupqtsUIN+xXTPDHmAAAAkGjQr8V/CeBE8Q6cUhAYLuDvKX/NSGOKOZkgRg HN/yxaBk4xrgNXJowPrqdiKX9LyeIfBJgjC/pivvA2iSmWJTwADHZljcCrqPl7am8dJIlr ZAg4sdCL+peWj4ZvGRmPlzfSjUmoYJ/Wh4wuZmmyiGsAzgMvX+K4jvqFWuHdm6FXVThyfa OdkD/+AmrfhU/Suw==")))

; The ECDSA key's public blob and signature.
(def sk_ec_pub () (list int) "AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBMuIpSoFsYs4pjR0uLMNcG/K3/qKbzeVnLShbkoMhHe/U+TYzWs6yT4e62B8sK7J1TLOsQKrPA8Yw6WKREkTbqE=")
(def sk_ec_sig () (list int) "AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAABIAAAAIDSSWEsbl75GK1HbKySu3IsZ5NnMrSe6Sz1LzeqZJh4LAAAAIC6rMgB53UWn5ME2mYH737/kkRVsIhjDvrUfjJaVSxlM")

; The RSA key's public blob and its two signatures.
(def sk_rsa_pub () (list int) "")
(def sk_rsa256_sig () (list int) "")
(def sk_rsa512_sig () (list int) "")

; Whether the blob pub's key signed sk_data with sig by alg.
(def sk_signed ((pub (list int)) (alg (list int)) (sig (list int))) bool
  (match (ssh_pub_of (sk_b64 pub))
    ((None) false)
    ((Some k) (ssh_sig_ok k alg (sk_b64 sig) (sk_data)))))

; ------------------------------------------------------------- fingerprints

; As ssh-keygen -lf printed them.
(def test_ssh_fingerprints () int
  (add (check_str "ed25519" (ssh_fingerprint (sk_b64 (sk_user_pub))) "SHA256:FOr/xHUg3J714CcSTd/iYonSAG5kxD85bAWjhhKPBNg")
       (check_str "ecdsa" (ssh_fingerprint (sk_b64 (sk_ec_pub))) "SHA256:2Q14QuB97QyeFKx3njGh/U0W0brpmHqvyk8WuC+85rg")))

; ------------------------------------------------------------- signatures

(def test_ssh_sig_ed25519 () int
  (check_true "ed25519" (sk_signed (sk_user_pub) "ssh-ed25519" (sk_user_sig))))

(def test_ssh_sig_ecdsa () int
  (check_true "ecdsa" (sk_signed (sk_ec_pub) "ecdsa-sha2-nistp256" (sk_ec_sig))))

(def test_ssh_sig_rsa () int
  (add (check_true "rsa-sha2-256" (sk_signed (sk_rsa_pub) "rsa-sha2-256" (sk_rsa256_sig)))
       (check_true "rsa-sha2-512" (sk_signed (sk_rsa_pub) "rsa-sha2-512" (sk_rsa512_sig)))))

; A signature by one algorithm is not taken for another's, nor by
; another key.
(def test_ssh_sig_refused () int
  (add (check_bool "256 as 512" (sk_signed (sk_rsa_pub) "rsa-sha2-512" (sk_rsa256_sig)) false)
       (add (check_bool "ecdsa's by ed25519" (sk_signed (sk_user_pub) "ssh-ed25519" (sk_ec_sig)) false)
            (check_bool "ssh-rsa" (sk_signed (sk_rsa_pub) "ssh-rsa" (sk_rsa256_sig)) false))))

; Of other data, a signature does not check.
(def test_ssh_sig_other_data () int
  (match (ssh_pub_of (sk_b64 (sk_ec_pub)))
    ((None) (fail_because "pub" "refused"))
    ((Some k) (check_bool "other" (ssh_sig_ok k "ecdsa-sha2-nistp256" (sk_b64 (sk_ec_sig)) (bytes_from_list "l0s signs that")) false))))

; ------------------------------------------------------------- private keys

; The file's key: its public half is the .pub's, its comment the one
; given, and it signs as Python's library did.
(def test_ssh_key_read () int
  (match (ssh_key_of_text (sk_user_file))
    ((Err why) (fail_because "key" why))
    ((Ok k)
      (add (check_true "blob" (eq (ssh_key_blob k) (sk_b64 (sk_user_pub))))
           (add (check_str "comment" (.comment k) "l0s test")
                (check_true "sig" (eq (ssh_key_sign k (sk_data)) (sk_b64 (sk_user_sig)))))))))

(def test_ssh_key_encrypted () int
  (match (ssh_key_of_text (sk_enc_file))
    ((Err why) (check_str "why" why "the key is encrypted with a passphrase, which ssh cannot read"))
    ((Ok k) (fail_because "refused" "read"))))

(def test_ssh_key_not_one () int
  (match (ssh_key_of_text "ssh-ed25519 AAAA")
    ((Err why) (check_str "why" why "not an OpenSSH private key"))
    ((Ok k) (fail_because "refused" "read"))))

; ------------------------------------------------------------- known hosts

(def test_ssh_host_name () int
  (add (check_str "22" (ssh_host_name "example.com" 22) "example.com")
       (check_str "2222" (ssh_host_name "10.0.2.2" 2222) "[10.0.2.2]:2222")))

; A file of a line for another host, the host among a comma list, a
; marker line and a hashed one.
(def sk_known () (list int)
  (append "other.example ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFtqRBxzsMBDr0vbwvpa1mOxsPVKupqtsUIN+xXTPDHm\n"
    (append "@revoked * ssh-ed25519 AAAA\n"
      (append "|1|abc=|def= ssh-ed25519 AAAA\n"
        (append "alias,[10.0.2.2]:2222 ssh-ed25519 " (append (sk_user_pub) " a comment\n"))))))

(def test_ssh_known_known () int
  (check_true "known"
    (eq (ssh_known_check (sk_known) "[10.0.2.2]:2222" (sk_b64 (sk_user_pub))) (SshHostKnown))))

; The other host's line is for another Ed25519 key: changed.
(def test_ssh_known_changed () int
  (check_true "changed"
    (eq (ssh_known_check (sk_known) "other.example" (sk_b64 (sk_user_pub))) (SshHostChanged))))

; No line for the host, or none of the key's type: unknown.
(def test_ssh_known_unknown () int
  (add (check_true "no host" (eq (ssh_known_check (sk_known) "new.example" (sk_b64 (sk_user_pub))) (SshHostUnknown)))
       (check_true "other type" (eq (ssh_known_check (sk_known) "alias" (sk_b64 (sk_ec_pub))) (SshHostUnknown)))))

; The line written for a host is one ssh_known_check reads back.
(def test_ssh_known_line () int
  (let l (ssh_known_line "[h]:2" (sk_b64 (sk_user_pub)))
    (add (check_str "line" l (append "[h]:2 ssh-ed25519 " (append (sk_user_pub) "\n")))
         (check_true "read" (eq (ssh_known_check l "[h]:2" (sk_b64 (sk_user_pub))) (SshHostKnown))))))
