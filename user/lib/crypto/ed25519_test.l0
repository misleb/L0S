; ed25519_test.l0 -- tests of ed25519.l0, against RFC 8032 7.1's first
; three vectors (the empty message, one byte, two), and signatures
; refused: one with a bit changed, one by another key, one whose S is L
; or more.

; The bytes the hex digits of s spell, two to a byte.
(def ed_unhex ((s (list int))) bytes
  (bytes_from_list (ed_unhex_from s (nil int))))

; The bytes of the hex digits s, after the reversed acc.
(def ed_unhex_from ((s (list int)) (acc (list int))) (list int)
  (if (or (is_empty s) (is_empty (tail s)))
      (rev acc)
      (ed_unhex_from (tail (tail s)) (cons (add (mul 16 (hex_val (head s))) (hex_val (head (tail s)))) acc))))

; The bytes of b in lowercase hex.
(def ed_hex ((b bytes)) (list int)
  (ed_hex_from b 0 (nil int)))

; The bytes of b from i on in hex, after the reversed acc.
(def ed_hex_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b))
      (rev acc)
      (ed_hex_from b (add i 1) (push (hex_digits (bytes_get b i) 2) acc))))

; The first vector's secret, public key and signature of the empty message.
(def ed_sk1 () (list int) "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
(def ed_pk1 () (list int) "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
(def ed_sig1 () (list int) "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")

; The second's, of the one byte 72.
(def ed_sk2 () (list int) "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
(def ed_pk2 () (list int) "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
(def ed_sig2 () (list int) "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")

; The third's, of the two bytes af 82.
(def ed_sk3 () (list int) "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
(def ed_pk3 () (list int) "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025")
(def ed_sig3 () (list int) "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a")

; ------------------------------------------------------------- keys

(def test_ed25519_public_1 () int
  (check_str "public 1" (ed_hex (ed25519_public (ed_unhex (ed_sk1)))) (ed_pk1)))

(def test_ed25519_public_3 () int
  (check_str "public 3" (ed_hex (ed25519_public (ed_unhex (ed_sk3)))) (ed_pk3)))

; The base point encodes as it decoded.
(def test_ed25519_base_round_trip () int
  (check_str "B" (ed_hex (ed25519_encode (ed25519_base)))
    "5866666666666666666666666666666666666666666666666666666666666666"))

; -1's square root squares to -1.
(def test_ed25519_sqrt_m1 () int
  (check_true "I^2 = -1"
    (ed25519_feq (x25519_fsq (ed25519_sqrt_m1)) (ed25519_fneg (x25519_small 1)))))

; ------------------------------------------------------------- signing

(def test_ed25519_sign_1 () int
  (check_str "sign 1"
    (ed_hex (ed25519_sign (ed_unhex (ed_sk1)) (ed_unhex (ed_pk1)) (ed_unhex "")))
    (ed_sig1)))

(def test_ed25519_sign_2 () int
  (check_str "sign 2"
    (ed_hex (ed25519_sign (ed_unhex (ed_sk2)) (ed_unhex (ed_pk2)) (ed_unhex "72")))
    (ed_sig2)))

(def test_ed25519_sign_3 () int
  (check_str "sign 3"
    (ed_hex (ed25519_sign (ed_unhex (ed_sk3)) (ed_unhex (ed_pk3)) (ed_unhex "af82")))
    (ed_sig3)))

; ------------------------------------------------------------- checking

(def test_ed25519_verify_1 () int
  (check_true "verify 1" (ed25519_verify (ed_unhex (ed_pk1)) (ed_unhex "") (ed_unhex (ed_sig1)))))

(def test_ed25519_verify_3 () int
  (check_true "verify 3" (ed25519_verify (ed_unhex (ed_pk3)) (ed_unhex "af82") (ed_unhex (ed_sig3)))))

; The second's signature, of 72, is not one of 73.
(def test_ed25519_refuses_other_message () int
  (check_bool "73" (ed25519_verify (ed_unhex (ed_pk2)) (ed_unhex "73") (ed_unhex (ed_sig2))) false))

; Nor is it the first key's.
(def test_ed25519_refuses_other_key () int
  (check_bool "pk1" (ed25519_verify (ed_unhex (ed_pk1)) (ed_unhex "72") (ed_unhex (ed_sig2))) false))

; An S of L plus the true S is refused, though the equation holds mod L.
(def test_ed25519_refuses_big_s () int
  (let (sig (ed_unhex (ed_sig1))
        s (bn_of_bytes (ed25519_rev (bytes_slice sig 32 64)))
        big (ed25519_rev (bn_to_bytes (bn_add s (ed25519_l)) 32))
        forged (bytes_concat (cons (bytes_slice sig 0 32) (cons big (nil bytes)))))
    (check_bool "S + L" (ed25519_verify (ed_unhex (ed_pk1)) (ed_unhex "") forged) false)))

; A signature of the wrong length is refused.
(def test_ed25519_refuses_short () int
  (check_bool "63 bytes" (ed25519_verify (ed_unhex (ed_pk1)) (ed_unhex "") (bytes_slice (ed_unhex (ed_sig1)) 0 63)) false))
