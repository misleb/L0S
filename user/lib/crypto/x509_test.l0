; x509_test.l0 -- tests of x509.l0 against real certificates: ISRG
; Root X1 and X2 as Mozilla's bundle has them, and an intermediate, a
; leaf and a self-signed P-384 certificate made with openssl for these
; tests; each field read, as openssl x509 -text and asn1parse show it;
; malformed input refused; and host names matched as RFC 6125 says.

; ISRG Root X1, Let's Encrypt's RSA 4096 root, as Mozilla's bundle has it.
(def x509_t_x1 () (list int)
  "")

; ISRG Root X2, Let's Encrypt's P-384 root, signed by itself with ecdsa-with-SHA384.
(def x509_t_x2 () (list int)
  "")

; An intermediate made with openssl: RSA 2048, CA with pathlen 0, signed by a test root with RSASSA-PSS, SHA-256 and a salt of 32.
(def x509_t_int () (list int)
  "")

; A leaf made with openssl, signed by x509_t_int with sha256WithRSAEncryption: a P-256 key, a SAN of www.example.test, *.example.test, Mail.Example.ORG, 192.0.2.7 and 2001:db8::1.
(def x509_t_leaf () (list int)
  "")

; A self-signed P-384 certificate made with openssl, ecdsa-with-SHA384, no SAN, CN cn.example.test, and a critical extension 1.2.3.4 of no known kind.
(def x509_t_ec384 () (list int)
  "")

; ------------------------------------------------------------ helpers

; The DER the base64 s stands for, empty if it does not decode.
(def x509_t_der ((s (list int))) bytes
  (let b (bytes_from_list s)
    (match (base64_decode b 0 (bytes_len b))
      ((None) (bytes_from_list ""))
      ((Some d) d))))

; What show makes of the certificate whose base64 is s, or why it does
; not parse, after "error: ".
(def x509_t_show ((s (list int)) (show (fn (X509) (list int)))) (list int)
  (match (x509_parse (x509_t_der s))
    ((Err why) (append "error: " why))
    ((Ok c) (show c))))

; The certificate whose base64 is s, the test knowing it parses.
(def x509_t_cert ((s (list int))) X509
  (match (x509_parse (x509_t_der s))
    ((Err why) (x509_t_blank))
    ((Ok c) c)))

; A certificate with nothing in it, for a parse that failed.
(def x509_t_blank () X509
  (let e (bytes_from_list "")
    (X509 e 0 0 (X509SigOther) e 1 e e e 0 0 (X509KeyOther) false -1 false 0 true false (nil (list int)) (nil bytes) (nil int) e e false)))

; The bytes of b in hex.
(def x509_t_hex ((b bytes)) (list int)
  (x509_t_hex_from b 0 (nil int)))

; x509_t_hex's loop, from i, after the reversed acc.
(def x509_t_hex_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b))
      (rev acc)
      (x509_t_hex_from b (add i 1) (push (hex_digits (bytes_get b i) 2) acc))))

; The ints ns as words.
(def x509_t_ints ((ns (list int))) (list int)
  (unwords (numbers_words ns)))

; The signature algorithm in words.
(def x509_t_alg ((c X509)) (list int)
  (match (.sig_alg c)
    ((X509RsaSha256) "rsa-sha256")
    ((X509RsaSha384) "rsa-sha384")
    ((X509RsaSha512) "rsa-sha512")
    ((X509RsaPss h s) (append "pss " (x509_t_ints (cons h (cons s (nil int))))))
    ((X509EcdsaSha256) "ecdsa-sha256")
    ((X509EcdsaSha384) "ecdsa-sha384")
    ((X509EcdsaSha512) "ecdsa-sha512")
    ((X509SigOther) "other")))

; The key in words: its kind, curve, length in bytes, and the first
; bytes in hex.
(def x509_t_key ((c X509)) (list int)
  (match (.key c)
    ((X509Rsa n e) (unwords (cons "rsa" (cons (digits (bytes_len n)) (cons (x509_t_hex (bytes_slice n 0 4)) (cons (x509_t_hex e) (nil (list int))))))))
    ((X509Ec cv p)
      (unwords (cons "ec" (cons (match cv ((X509P256) "p256") ((X509P384) "p384") ((X509CurveOther) "other"))
                            (cons (digits (bytes_len p)) (cons (x509_t_hex (bytes_slice p 0 3)) (nil (list int))))))))
    ((X509KeyOther) "other")))

; Where the TBSCertificate is, and the signature's length.
(def x509_t_tbs ((c X509)) (list int)
  (x509_t_ints (cons (.tbs_start c) (cons (.tbs_end c) (cons (bytes_len (.sig c)) (nil int))))))

; The validity, from and to.
(def x509_t_validity ((c X509)) (list int)
  (x509_t_ints (cons (.not_before c) (cons (.not_after c) (nil int)))))

; The version and serial number.
(def x509_t_serial ((c X509)) (list int)
  (append (digits (.version c)) (append " " (x509_t_hex (.serial c)))))

; basicConstraints and keyUsage: CA or not, the path length, and the
; key usage bits, - if none.
(def x509_t_ca ((c X509)) (list int)
  (unwords (cons (if (.is_ca c) "ca" "leaf")
             (cons (digits (.path_len c))
               (cons (if (.has_key_usage c) (digits (.key_usage c)) "-") (nil (list int)))))))

; The subjectAltName: "-" if none, else its dNSNames and its addresses
; in hex.
(def x509_t_san ((c X509)) (list int)
  (if (not (.has_san c))
      "-"
      (unwords (append (.dns_names c) (x509_t_hexes (.ip_addrs c))))))

; Each of bs in hex.
(def x509_t_hexes ((bs (list bytes))) (list (list int))
  (if (is_empty bs) (nil (list int)) (cons (x509_t_hex (head bs)) (x509_t_hexes (tail bs)))))

; The commonName.
(def x509_t_cn ((c X509)) (list int) (.common_name c))

; The key identifiers, subject's then authority's, in hex.
(def x509_t_ids ((c X509)) (list int)
  (append (x509_t_hex (.subject_key_id c)) (append " " (x509_t_hex (.authority_key_id c)))))

; Whether it is self-issued, it allows a TLS server, and it carries an
; unknown critical extension.
(def x509_t_flags ((c X509)) (list int)
  (unwords (cons (if (eq (.issuer c) (.subject c)) "self" "issued")
             (cons (if (.server_auth c) "server" "no-server")
               (cons (if (.unknown_critical c) "unknown-critical" "known") (nil (list int)))))))

; ------------------------------------------------------- ISRG Root X1

; asn1parse: the TBSCertificate is 851 bytes from 4, with a 4-byte
; header, and the signature 512 bytes, RSA 4096.
(def test_x509_x1_tbs () int
  (check_str "tbs" (x509_t_show (x509_t_x1) x509_t_tbs) "4 859 512"))

(def test_x509_x1_alg () int
  (check_str "alg" (x509_t_show (x509_t_x1) x509_t_alg) "rsa-sha256"))

; Modulus=ADE82473..., 512 bytes, exponent 65537.
(def test_x509_x1_key () int
  (check_str "key" (x509_t_show (x509_t_x1) x509_t_key) "rsa 512 ade82473 010001"))

; date -d 'Jun  4 11:04:38 2015 GMT' +%s, and 2035.
(def test_x509_x1_validity () int
  (check_str "validity" (x509_t_show (x509_t_x1) x509_t_validity) "1433415878 2064567878"))

(def test_x509_x1_serial () int
  (check_str "serial" (x509_t_show (x509_t_x1) x509_t_serial) "3 008210cfb0d240e3594463e0bb63828b00"))

; CA:TRUE, critical, no path length; keyCertSign and cRLSign.
(def test_x509_x1_ca () int
  (check_str "ca" (x509_t_show (x509_t_x1) x509_t_ca) "ca -1 96"))

(def test_x509_x1_names () int
  (add (check_str "cn" (x509_t_show (x509_t_x1) x509_t_cn) "ISRG Root X1")
       (check_str "san" (x509_t_show (x509_t_x1) x509_t_san) "-")))

(def test_x509_x1_flags () int
  (check_str "flags" (x509_t_show (x509_t_x1) x509_t_flags) "self server known"))

; The issuer is the Name's whole TLV: 81 bytes from 47.
(def test_x509_x1_issuer_bytes () int
  (let (c (x509_t_cert (x509_t_x1))
        d (x509_t_der (x509_t_x1)))
    (check_bool "issuer" (eq (.issuer c) (bytes_slice d 47 128)) true)))

(def test_x509_x1_der_kept () int
  (let c (x509_t_cert (x509_t_x1))
    (check_int "der" (bytes_len (.der c)) 1391)))

; ------------------------------------------------------- ISRG Root X2

(def test_x509_x2_alg () int
  (check_str "alg" (x509_t_show (x509_t_x2) x509_t_alg) "ecdsa-sha384"))

(def test_x509_x2_key () int
  (check_str "key" (x509_t_show (x509_t_x2) x509_t_key) "ec p384 97 04cd9b"))

; date -d 'Sep  4 00:00:00 2020 GMT' +%s, and Sep 17 16:00:00 2040.
(def test_x509_x2_validity () int
  (check_str "validity" (x509_t_show (x509_t_x2) x509_t_validity) "1599177600 2231510400"))

(def test_x509_x2_ca () int
  (add (check_str "ca" (x509_t_show (x509_t_x2) x509_t_ca) "ca -1 96")
       (check_str "skid" (x509_t_show (x509_t_x2) x509_t_ids) "7c4296aede4b483bfa92f89e8ccf6d8ba9723795 ")))

; -------------------------------------------- the intermediate, PSS

(def test_x509_int_pss () int
  (check_str "alg" (x509_t_show (x509_t_int) x509_t_alg) "pss 256 32"))

(def test_x509_int_ca () int
  (check_str "ca" (x509_t_show (x509_t_int) x509_t_ca) "ca 0 97"))

(def test_x509_int_key () int
  (check_str "key" (x509_t_show (x509_t_int) x509_t_key) "rsa 256 ba7766f9 010001"))

(def test_x509_int_names () int
  (add (check_str "cn" (x509_t_show (x509_t_int) x509_t_cn) "L0S Test Intermediate")
       (check_str "flags" (x509_t_show (x509_t_int) x509_t_flags) "issued server known")))

; ------------------------------------------------------------ the leaf

(def test_x509_leaf_tbs () int
  (add (check_str "tbs" (x509_t_show (x509_t_leaf) x509_t_tbs) "4 449 256")
       (check_str "alg" (x509_t_show (x509_t_leaf) x509_t_alg) "rsa-sha256")))

(def test_x509_leaf_key () int
  (check_str "key" (x509_t_show (x509_t_leaf) x509_t_key) "ec p256 65 04e827"))

(def test_x509_leaf_validity () int
  (check_str "validity" (x509_t_show (x509_t_leaf) x509_t_validity) "1793897065 1801673065"))

(def test_x509_leaf_san () int
  (check_str "san" (x509_t_show (x509_t_leaf) x509_t_san)
    "www.example.test *.example.test Mail.Example.ORG c0000207 20010db8000000000000000000000001"))

; CA:FALSE; digitalSignature only; serverAuth.
(def test_x509_leaf_ca () int
  (add (check_str "ca" (x509_t_show (x509_t_leaf) x509_t_ca) "leaf -1 1")
       (check_str "flags" (x509_t_show (x509_t_leaf) x509_t_flags) "issued server known")))

(def test_x509_leaf_serial () int
  (check_str "serial" (x509_t_show (x509_t_leaf) x509_t_serial) "3 03"))

; The leaf's issuer is the intermediate's subject, and its authority
; key identifier the intermediate's subject key identifier.
(def test_x509_leaf_chain_links () int
  (let (l (x509_t_cert (x509_t_leaf))
        i (x509_t_cert (x509_t_int)))
    (add (check_bool "issuer" (eq (.issuer l) (.subject i)) true)
         (check_bool "akid" (eq (.authority_key_id l) (.subject_key_id i)) true))))

; The TBS range is the bytes asn1parse shows at 4, 445 of them after
; a 4-byte header.
(def test_x509_leaf_tbs_bytes () int
  (let c (x509_t_cert (x509_t_leaf))
    (add (check_int "tag" (bytes_get (.der c) (.tbs_start c)) 48)
         (check_int "length" (sub (.tbs_end c) (.tbs_start c)) 445))))

; ---------------------------------------------- the P-384, self-signed

(def test_x509_ec384 () int
  (add (check_str "alg" (x509_t_show (x509_t_ec384) x509_t_alg) "ecdsa-sha384")
       (check_str "key" (x509_t_show (x509_t_ec384) x509_t_key) "ec p384 97 048b6c")))

(def test_x509_ec384_critical () int
  (check_str "flags" (x509_t_show (x509_t_ec384) x509_t_flags) "self server unknown-critical"))

; ----------------------------------------------------------- malformed

(def test_x509_truncated () int
  (let d (x509_t_der (x509_t_x1))
    (check_true "truncated" (x509_t_err (x509_parse (bytes_slice d 0 1000))))))

(def test_x509_trailing () int
  (let d (x509_t_der (x509_t_leaf))
    (check_true "a byte after" (x509_t_err (x509_parse (bytes_concat (cons d (cons (bytes_from_list "x") (nil bytes)))))))))

; The outer length made one more than there is.
(def test_x509_length_past_end () int
  (let (d (x509_t_der (x509_t_leaf))
        n (bytes_len d)
        bad (bytes_concat (cons (bytes_slice d 0 3) (cons (bytes_from_list (cons 210 (nil int))) (cons (bytes_slice d 4 n) (nil bytes))))))
    (check_true "length past the end" (x509_t_err (x509_parse bad)))))

(def test_x509_empty () int
  (add (check_true "empty" (x509_t_err (x509_parse (bytes_from_list ""))))
       (check_true "junk" (x509_t_err (x509_parse (bytes_from_list "hello world"))))))

; How many of the prefixes of d shorter than n, from k, parse.
(def x509_t_prefixes ((d bytes) (k int) (n int) (parsed int)) int
  (if (ge k n)
      parsed
      (x509_t_prefixes d (add k 1) n (if (x509_t_err (x509_parse (bytes_slice d 0 k))) parsed (add parsed 1)))))

(def test_x509_every_prefix () int
  (let d (x509_t_der (x509_t_leaf))
    (check_int "prefixes that parse" (x509_t_prefixes d 0 (bytes_len d) 0) 0)))

; d with byte k made v.
(def x509_t_set ((d bytes) (k int) (v int)) bytes
  (bytes_concat (cons (bytes_slice d 0 k) (cons (bytes_from_list (cons v (nil int))) (cons (bytes_slice d (add k 1) (bytes_len d)) (nil bytes))))))

; How many of d with each byte from k changed to a pseudo-random one
; parse; each must return rather than fail.
(def x509_t_flips ((d bytes) (k int) (s int) (parsed int)) int
  (if (ge k (bytes_len d))
      parsed
      (let s2 (rand_next s)
        (x509_t_flips d (add k 1) s2
          (if (x509_t_err (x509_parse (x509_t_set d k (bit_xor (bytes_get d k) (add 1 (mod s2 255)))))) parsed (add parsed 1))))))

; Changing any byte of the header bytes must not make a parse fail
; other than by Err; how many parse is not pinned, only that it
; returns.
(def test_x509_every_byte_changed () int
  (let d (x509_t_der (x509_t_leaf))
    (check_true "returns" (ge (x509_t_flips d 0 7 0) 0))))

; The signature algorithm inside the TBS changed, sha256 to sha384:
; it no longer matches the outer one.
(def test_x509_tbs_alg_mismatch () int
  (let d (x509_t_der (x509_t_leaf))
    (check_true "mismatch" (x509_t_err (x509_parse (x509_t_set d 28 12))))))


; --------------------------------------------------------------- hosts

(def test_x509_host_exact () int
  (let c (x509_t_cert (x509_t_leaf))
    (add (check_bool "exact" (x509_host_ok c "www.example.test") true)
         (check_bool "case" (x509_host_ok c "WWW.Example.TEST") true))))

(def test_x509_host_san_case () int
  (let c (x509_t_cert (x509_t_leaf))
    (check_bool "pattern in capitals" (x509_host_ok c "mail.example.org") true)))

(def test_x509_host_wildcard () int
  (let c (x509_t_cert (x509_t_leaf))
    (add (check_bool "one label" (x509_host_ok c "a.example.test") true)
         (add (check_bool "no label" (x509_host_ok c "example.test") false)
              (check_bool "two labels" (x509_host_ok c "a.b.example.test") false)))))

(def test_x509_host_other () int
  (let c (x509_t_cert (x509_t_leaf))
    (add (check_bool "other" (x509_host_ok c "example.org") false)
         (check_bool "empty" (x509_host_ok c "") false))))

(def test_x509_host_trailing_dot () int
  (let c (x509_t_cert (x509_t_leaf))
    (check_bool "fqdn" (x509_host_ok c "www.example.test.") true)))

(def test_x509_host_star_host () int
  (let c (x509_t_cert (x509_t_leaf))
    (check_bool "host of *" (x509_host_ok c "*.example.test") false)))

(def test_x509_host_ip () int
  (let c (x509_t_cert (x509_t_leaf))
    (add (check_bool "listed" (x509_host_ok c "192.0.2.7") true)
         (check_bool "not listed" (x509_host_ok c "192.0.2.8") false))))

(def test_x509_host_ip_bad () int
  (let c (x509_t_cert (x509_t_leaf))
    (add (check_bool "octet over 255" (x509_host_ok c "192.0.2.700") false)
         (check_bool "three parts" (x509_host_ok c "192.0.2") false))))

; An address never matches a dNSName or the commonName.
(def test_x509_host_ip_not_by_name () int
  (let c (.has_san (.common_name (x509_t_cert (x509_t_leaf)) "192.0.2.9") false)
    (check_bool "cn of an address" (x509_host_ok c "192.0.2.9") false)))

; With no subjectAltName the commonName is the name.
(def test_x509_host_cn () int
  (let c (x509_t_cert (x509_t_ec384))
    (add (check_bool "cn" (x509_host_ok c "cn.example.test") true)
         (check_bool "not cn" (x509_host_ok c "www.example.test") false))))

; With one the commonName is not looked at.
(def test_x509_host_cn_ignored () int
  (let c (.common_name (x509_t_cert (x509_t_leaf)) "other.test")
    (add (check_bool "with a SAN" (x509_host_ok c "other.test") false)
         (check_bool "without" (x509_host_ok (.has_san c false) "other.test") true))))

(def test_x509_host_wildcard_too_wide () int
  (let c (.dns_names (x509_t_cert (x509_t_leaf)) (cons "*.test" (nil (list int))))
    (check_bool "*.test" (x509_host_ok c "a.test") false)))

(def test_x509_host_partial_wildcard () int
  (let c (.dns_names (x509_t_cert (x509_t_leaf)) (cons "w*.example.test" (nil (list int))))
    (check_bool "w*" (x509_host_ok c "www.example.test") false)))

; ----------------------------------------------------------------- PEM

; s as a PEM block: a comment, the BEGIN line, s in lines of 64 ending
; in CR LF, and the END line.
(def x509_t_pem ((s (list int))) (list int)
  (append "# a root\n-----BEGIN CERTIFICATE-----\n"
    (append (x509_t_lines s (nil int)) "-----END CERTIFICATE-----\n")))

; x509_t_pem's lines of s, after the reversed acc.
(def x509_t_lines ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (x509_t_lines (drop s 64) (push "\r\n" (push (take s 64) acc)))))

(def test_x509_pem_two () int
  (let (text (bytes_from_list (append (x509_t_pem (x509_t_x2)) (x509_t_pem (x509_t_leaf))))
        certs (x509_pem_certs text))
    (add (check_int "count" (length certs) 2)
         (check_bool "first" (eq (head certs) (x509_t_der (x509_t_x2))) true))))

(def test_x509_pem_skips_bad () int
  (let (text (bytes_from_list (append (x509_t_pem "not!base64") (append (x509_t_pem (x509_t_leaf)) "trailing\n")))
        certs (x509_pem_certs text))
    (add (check_int "count" (length certs) 1)
         (check_bool "leaf" (eq (head certs) (x509_t_der (x509_t_leaf))) true))))

(def test_x509_pem_none () int
  (add (check_int "empty" (length (x509_pem_certs (bytes_from_list ""))) 0)
       (check_int "unended" (length (x509_pem_certs (bytes_from_list "-----BEGIN CERTIFICATE-----\nMIIB"))) 0)))

; Whether r is an Err.
(def x509_t_err ((r (Result X509 (list int)))) bool
  (match r ((Err w) true) ((Ok c) false)))
