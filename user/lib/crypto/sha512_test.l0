; sha512_test.l0 -- tests of sha512.l0, against FIPS 180-4's examples:
; "abc", the empty message and the 896-bit two-block one, for SHA-512
; and SHA-384, and the same in pieces.

; The bytes of d as lowercase hex.
(def sha512_hex_of ((d bytes)) (list int)
  (sha512_hex_from d 0 (nil int)))

; The bytes of d from i on in hex, after the reversed acc.
(def sha512_hex_from ((d bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len d))
      (rev acc)
      (sha512_hex_from d (add i 1) (push (hex_digits (bytes_get d i) 2) acc))))

; The SHA-512 of s, in hex.
(def sha512_of ((s (list int))) (list int)
  (let b (bytes_from_list s) (sha512_hex_of (sha512 b 0 (bytes_len b)))))

; The SHA-384 of s, in hex.
(def sha384_of ((s (list int))) (list int)
  (let b (bytes_from_list s) (sha512_hex_of (sha384 b 0 (bytes_len b)))))

; FIPS 180-4's 896-bit message: 112 bytes, so its padding takes a
; second block.
(def sha512_msg896 () (list int)
  "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")

(def test_sha512_abc () int
  (check_str "abc" (sha512_of "abc")
    "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"))

(def test_sha512_empty () int
  (check_str "empty" (sha512_of "")
    "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"))

(def test_sha512_two_blocks () int
  (check_str "896 bits" (sha512_of (sha512_msg896))
    "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"))

(def test_sha384_abc () int
  (check_str "abc" (sha384_of "abc")
    "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"))

(def test_sha384_empty () int
  (check_str "empty" (sha384_of "")
    "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"))

(def test_sha384_two_blocks () int
  (check_str "896 bits" (sha384_of (sha512_msg896))
    "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"))

(def test_sha512_lengths () int
  (let b (bytes_from_list "abc")
    (add (check_int "512" (bytes_len (sha512 b 0 3)) 64)
         (check_int "384" (bytes_len (sha384 b 0 3)) 48))))

; A range of a larger value: only its bytes count.
(def test_sha512_range () int
  (let b (bytes_from_list "xxabcyy")
    (check_str "range" (sha512_hex_of (sha512 b 2 5)) (sha512_of "abc"))))

; One changed byte changes the hash.
(def test_sha512_tampered () int
  (check_bool "abd" (eq (sha512_of "abd") (sha512_of "abc")) false))

; s given the bytes of b from i on, k at a time.
(def sha512_fed ((s Sha512) (b bytes) (i int) (k int)) Sha512
  (if (ge i (bytes_len b))
      s
      (let j (min (add i k) (bytes_len b))
        (sha512_fed (sha512_more s b i j) b j k))))

(def test_sha512_pieces_empty () int
  (add (check_str "512" (sha512_hex_of (sha512_done (sha512_new))) (sha512_of ""))
       (check_str "384" (sha512_hex_of (sha512_done (sha384_new))) (sha384_of ""))))

(def test_sha512_pieces () int
  (let b (bytes_from_list (sha512_msg896))
    (add (check_str "1" (sha512_hex_of (sha512_done (sha512_fed (sha512_new) b 0 1))) (sha512_of (sha512_msg896)))
         (check_str "13" (sha512_hex_of (sha512_done (sha512_fed (sha512_new) b 0 13))) (sha512_of (sha512_msg896))))))

(def test_sha384_pieces () int
  (let b (bytes_from_list (sha512_msg896))
    (check_str "7" (sha512_hex_of (sha512_done (sha512_fed (sha384_new) b 0 7))) (sha384_of (sha512_msg896)))))

; A state stays usable after done: hashing "ab", then "c" more, gives
; the hashes of "ab" and of "abc".
(def test_sha512_done_keeps () int
  (let (b (bytes_from_list "abc")
        s (sha512_more (sha512_new) b 0 2)
        d1 (sha512_done s)
        d2 (sha512_done (sha512_more s b 2 3)))
    (add (check_str "ab" (sha512_hex_of d1) (sha512_of "ab"))
         (check_str "abc" (sha512_hex_of d2) (sha512_of "abc")))))

; Every length from 100 to 140 and 220 to 260, about the one- and
; two-block padding boundaries, in pieces of 5 and 37: the same hash as
; at once, for both.
(def test_sha512_pieces_lengths () int
  (add (sha512_lengths_from 100 140 0) (sha512_lengths_from 220 260 0)))

; The lengths from n up to m, the failures so far.
(def sha512_lengths_from ((n int) (m int) (failed int)) int
  (if (ge n m)
      failed
      (let (b (bytes_from_list (rand_bytes n n))
            whole (sha512 b 0 n)
            half (sha384 b 0 n)
            ok (and (eq (sha512_done (sha512_fed (sha512_new) b 0 5)) whole)
                    (and (eq (sha512_done (sha512_fed (sha512_new) b 0 37)) whole)
                         (eq (sha512_done (sha512_fed (sha384_new) b 0 37)) half))))
        (sha512_lengths_from (add n 1) m (if ok failed (add failed (fail_because "pieces" (digits n))))))))
