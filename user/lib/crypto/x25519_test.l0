; x25519_test.l0 -- tests of x25519.l0, against RFC 7748's vectors:
; section 5.2's two, its iterated test after 1 and 1000 iterations, and
; section 6.1's Alice and Bob.

; The bytes the hex digits of s spell, two to a byte.
(def x25519_unhex ((s (list int))) bytes
  (bytes_from_list (x25519_unhex_from s (nil int))))

; The bytes of the hex digits s, after the reversed acc.
(def x25519_unhex_from ((s (list int)) (acc (list int))) (list int)
  (if (or (is_empty s) (is_empty (tail s)))
      (rev acc)
      (x25519_unhex_from (tail (tail s)) (cons (add (mul 16 (hex_val (head s))) (hex_val (head (tail s)))) acc))))

; The bytes of b in lowercase hex.
(def x25519_hex ((b bytes)) (list int)
  (x25519_hex_from b 0 (nil int)))

; The bytes of b from i on in hex, after the reversed acc.
(def x25519_hex_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b))
      (rev acc)
      (x25519_hex_from b (add i 1) (push (hex_digits (bytes_get b i) 2) acc))))

; X25519 of the hex k and u, in hex.
(def x25519_of ((k (list int)) (u (list int))) (list int)
  (x25519_hex (x25519 (x25519_unhex k) (x25519_unhex u))))

; ------------------------------------------------------ section 5.2

(def test_x25519_vector_1 () int
  (check_str "5.2 first"
    (x25519_of "a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4"
               "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")
    "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552"))

; The second's u has its top bit set, which X25519 masks.
(def test_x25519_vector_2 () int
  (check_str "5.2 second"
    (x25519_of "4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d"
               "e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493")
    "95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957"))

; ------------------------------------------------- iterated (5.2)

; k and u after n rounds of k, u = X25519(k, u), k, from k = u = 9: k.
(def x25519_iterate ((k bytes) (u bytes) (n int)) bytes
  (if (le n 0)
      k
      (let r (x25519 k u)
        (x25519_iterate r k (sub n 1)))))

(def test_x25519_iterated_1 () int
  (let nine (x25519_base_point)
    (check_str "1 iteration" (x25519_hex (x25519_iterate nine nine 1))
      "422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079")))

; About 3 seconds on the host.
(def test_x25519_iterated_1000 () int
  (let nine (x25519_base_point)
    (check_str "1000 iterations" (x25519_hex (x25519_iterate nine nine 1000))
      "684cf59ba83309552800ef566f2f4d3c1c3887c49360e3875f2eb94d99532c51")))

; -------------------------------------------------- section 6.1

; Alice's private key (RFC 7748, 6.1).
(def x25519_alice_private () (list int)
  "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")

; Bob's private key (RFC 7748, 6.1).
(def x25519_bob_private () (list int)
  "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")

(def test_x25519_alice_public () int
  (check_str "Alice's public key" (x25519_hex (x25519_base (x25519_unhex (x25519_alice_private))))
    "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"))

(def test_x25519_bob_public () int
  (check_str "Bob's public key" (x25519_hex (x25519_base (x25519_unhex (x25519_bob_private))))
    "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"))

; Each side's private key times the other's public key: the same secret.
(def test_x25519_shared () int
  (let (a (x25519_unhex (x25519_alice_private))
        b (x25519_unhex (x25519_bob_private))
        secret "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
    (add (check_str "Alice's side" (x25519_hex (x25519 a (x25519_base b))) secret)
         (check_str "Bob's side" (x25519_hex (x25519 b (x25519_base a))) secret))))

; A different private key gives a different secret.
(def test_x25519_shared_tampered () int
  (let (a (x25519_unhex "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2b")
        b (x25519_unhex (x25519_bob_private)))
    (check_bool "tampered key" (eq (x25519_hex (x25519 a (x25519_base b)))
                                 "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")
      false)))

; ------------------------------------------------------ zero secrets

; u = 0 is a point of small order: every scalar gives 0, which TLS
; refuses.
(def test_x25519_zero_u () int
  (let s (x25519 (x25519_unhex (x25519_alice_private)) (bytes_from_list (x25519_zeros 32 (nil int))))
    (add (check_str "zero secret" (x25519_hex s) (x25519_hex (bytes_from_list (x25519_zeros 32 (nil int)))))
         (check_bool "spotted" (x25519_is_zero s) true))))

; u = 1 has order 4, which the clamped scalar, a multiple of 8, takes to
; the point at infinity: its secret is 0 too.
(def test_x25519_one_u () int
  (let u (bytes_from_list (cons 1 (x25519_zeros 31 (nil int))))
    (check_bool "u = 1" (x25519_is_zero (x25519 (x25519_unhex (x25519_alice_private)) u)) true)))

(def test_x25519_is_zero_not () int
  (add (check_bool "a real secret" (x25519_is_zero (x25519_unhex "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")) false)
       (check_bool "one byte set" (x25519_is_zero (bytes_from_list (x25519_zeros 31 (cons 1 (nil int))))) false)))

; u = p + 9, not reduced, is the same point as 9 (RFC 7748, 5: values of
; p or more are accepted, mod p).
(def test_x25519_unreduced_u () int
  (let (k (x25519_unhex (x25519_alice_private))
        u (x25519_unhex "f6ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff7f"))
    (check_str "p + 9" (x25519_hex (x25519 k u)) (x25519_hex (x25519_base k)))))
