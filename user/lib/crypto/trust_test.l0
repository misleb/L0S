; trust_test.l0 -- tests of trust.l0: real servers' chains, as they
; were served on 2026-11-05, checked to roots from the Mozilla bundle at
; that date: ECDSA P-256 and P-384 throughout, RSA where a root
; cross-signs, a wildcard name; and each way a chain fails.

; ---------------------------------------------------------------- helpers

; The bytes the hex digits s spell, two a byte.
(def unhex ((s (list int))) bytes (bytes_from_list (unhex_onto s (nil int))))
(def unhex_onto ((s (list int)) (acc (list int))) (list int)
  (if (or (is_empty s) (is_empty (tail s)))
      (rev acc)
      (unhex_onto (tail (tail s)) (cons (add (mul (hex_val (head s)) 16) (hex_val (head (tail s)))) acc))))

; The day the chains were served, 2026-11-05.
(def day () int 1793836800)

; bs as a list.
(def l1 ((a bytes)) (list bytes) (cons a (nil bytes)))
(def l2 ((a bytes) (b bytes)) (list bytes) (cons a (l1 b)))
(def l3 ((a bytes) (b bytes) (c bytes)) (list bytes) (cons a (l2 b c)))
(def l4 ((a bytes) (b bytes) (c bytes) (d bytes)) (list bytes) (cons a (l3 b c d)))

; The roots of one certificate.
(def one_root ((r bytes)) TrustRoots (trust_roots_of (l1 r)))

; A chain's check as text: ok and the server's name, or why not.
(def checked ((r (Result X509 (list int)))) (list int)
  (match r
    ((Err why) (append "no: " why))
    ((Ok c) (append "ok " (.common_name c)))))

; b with byte i flipped.
(def flipped ((b bytes) (i int)) bytes
  (bytes_concat (cons (bytes_slice b 0 i) (cons (bytes_from_list (cons (bit_xor (bytes_get b i) 1) (nil int))) (l1 (bytes_slice b (add i 1) (bytes_len b)))))))

; GTS Root R4, from the Mozilla bundle.
(def c_root_gts () bytes (unhex ""))

; ISRG Root X1, from the Mozilla bundle.
(def c_root_x1 () bytes (unhex ""))

; ISRG Root X2, from the Mozilla bundle.
(def c_root_x2 () bytes (unhex ""))

; SSL.com TLS ECC Root CA 2022, from the Mozilla bundle.
(def c_root_sslcom () bytes (unhex ""))

; api.anthropic.com's chain as served on 2026-11-05, certificate 1.
(def c_api_1 () bytes (unhex ""))

; api.anthropic.com's chain as served on 2026-11-05, certificate 2.
(def c_api_2 () bytes (unhex ""))

; api.anthropic.com's chain as served on 2026-11-05, certificate 3.
(def c_api_3 () bytes (unhex ""))

; letsencrypt.org's chain as served on 2026-11-05, certificate 1.
(def c_le_1 () bytes (unhex ""))

; letsencrypt.org's chain as served on 2026-11-05, certificate 2.
(def c_le_2 () bytes (unhex ""))

; letsencrypt.org's chain as served on 2026-11-05, certificate 3.
(def c_le_3 () bytes (unhex ""))

; letsencrypt.org's chain as served on 2026-11-05, certificate 4.
(def c_le_4 () bytes (unhex ""))

; www.wikipedia.org's chain as served on 2026-11-05, certificate 1.
(def c_wp_1 () bytes (unhex ""))

; www.wikipedia.org's chain as served on 2026-11-05, certificate 2.
(def c_wp_2 () bytes (unhex ""))

; www.wikipedia.org's chain as served on 2026-11-05, certificate 3.
(def c_wp_3 () bytes (unhex ""))

; www.wikipedia.org's chain as served on 2026-11-05, certificate 4.
(def c_wp_4 () bytes (unhex ""))

; example.com's chain as served on 2026-11-05, certificate 1.
(def c_ex_1 () bytes (unhex ""))

; example.com's chain as served on 2026-11-05, certificate 2.
(def c_ex_2 () bytes (unhex ""))

; example.com's chain as served on 2026-11-05, certificate 3.
(def c_ex_3 () bytes (unhex ""))

; ----------------------------------------------------------------- chains

; api.anthropic.com: a P-256 leaf, a P-256 intermediate, to GTS Root R4,
; P-384; with GTS Root R4's own cross-signed certificate served too.
(def test_api () int
  (add (check_str "served" (checked (trust_chain (one_root (c_root_gts)) (l3 (c_api_1) (c_api_2) (c_api_3)) "api.anthropic.com" (day))) "ok api.anthropic.com")
       (check_str "short" (checked (trust_chain (one_root (c_root_gts)) (l2 (c_api_1) (c_api_2)) "api.anthropic.com" (day))) "ok api.anthropic.com")))

; letsencrypt.org to ISRG Root X2, or to X1 through X2's certificate
; X1 signed, RSA-4096; in any order the chain comes.
(def test_letsencrypt () int
  (add (check_str "X2" (checked (trust_chain (one_root (c_root_x2)) (l4 (c_le_1) (c_le_2) (c_le_3) (c_le_4)) "letsencrypt.org" (day))) "ok letsencrypt.org")
       (add (check_str "X1" (checked (trust_chain (one_root (c_root_x1)) (l4 (c_le_1) (c_le_2) (c_le_3) (c_le_4)) "letsencrypt.org" (day))) "ok letsencrypt.org")
            (check_str "shuffled" (checked (trust_chain (one_root (c_root_x1)) (l4 (c_le_1) (c_le_4) (c_le_2) (c_le_3)) "letsencrypt.org" (day))) "ok letsencrypt.org"))))

; *.wikipedia.org serves www.wikipedia.org, not a name two labels down.
(def test_wildcard () int
  (add (check_str "www" (checked (trust_chain (one_root (c_root_x2)) (l3 (c_wp_1) (c_wp_2) (c_wp_3)) "www.wikipedia.org" (day))) "ok *.wikipedia.org")
       (check_str "two down" (checked (trust_chain (one_root (c_root_x2)) (l3 (c_wp_1) (c_wp_2) (c_wp_3)) "a.b.wikipedia.org" (day))) "no: it does not name a.b.wikipedia.org")))

; example.com, three P-384-signed links to SSL.com's root.
(def test_example () int
  (check_str "ok" (checked (trust_chain (one_root (c_root_sslcom)) (l3 (c_ex_1) (c_ex_2) (c_ex_3)) "example.com" (day))) "ok example.com"))

; ---------------------------------------------------------------- refused

; With no root it trusts, or the root another, a chain is refused.
(def test_no_root () int
  (add (check_str "none" (checked (trust_chain (trust_roots_of (nil bytes)) (l2 (c_api_1) (c_api_2)) "api.anthropic.com" (day))) "no: it is not signed by a root this board trusts")
       (check_str "another" (checked (trust_chain (one_root (c_root_x1)) (l2 (c_api_1) (c_api_2)) "api.anthropic.com" (day))) "no: it is not signed by a root this board trusts")))

; The intermediate left out, the leaf is not signed by any root.
(def test_missing_link () int
  (check_str "leaf only" (checked (trust_chain (one_root (c_root_gts)) (l1 (c_api_1)) "api.anthropic.com" (day))) "no: it is not signed by a root this board trusts"))

; Another name, and dates either side of the leaf's.
(def test_name_and_dates () int
  (add (check_str "name" (checked (trust_chain (one_root (c_root_gts)) (l2 (c_api_1) (c_api_2)) "anthropic.com" (day))) "no: it does not name anthropic.com")
       (add (check_str "after" (checked (trust_chain (one_root (c_root_gts)) (l2 (c_api_1) (c_api_2)) "api.anthropic.com" 1798761600)) "no: it has expired")
            (check_str "before" (checked (trust_chain (one_root (c_root_gts)) (l2 (c_api_1) (c_api_2)) "api.anthropic.com" 1767225600)) "no: it is not valid yet"))))

; A byte of the leaf's signature changed: not signed by the next.
(def test_bad_signature () int
  (let leaf (c_le_1)
    (check_str "flipped" (checked (trust_chain (one_root (c_root_x2)) (l3 (flipped leaf (sub (bytes_len leaf) 5)) (c_le_2) (c_le_3)) "letsencrypt.org" (day)))
               "no: a certificate in its chain is not signed by the next")))

; Bytes that are not a certificate are refused, saying so.
(def test_not_a_certificate () int
  (check_bool "refused" (starts_with (checked (trust_chain (one_root (c_root_gts)) (l1 (bytes_from_list "hello")) "a" (day))) "no: a certificate does not read") true))

; A leaf the store holds is trusted as it is.
(def test_held () int
  (check_str "held" (checked (trust_chain (one_root (c_api_1)) (l1 (c_api_1)) "api.anthropic.com" (day))) "ok api.anthropic.com"))

; ------------------------------------------------------------------ roots

; The roots of a PEM text, and a block that is not one passed over.
(def test_roots_of_pem () int
  (check_int "count" (trust_roots_count (trust_roots_of (l3 (c_root_x1) (bytes_from_list "junk") (c_root_x2)))) 2))

; trust_signed knows the schemes TLS 1.3 names, and no other.
(def test_scheme_unknown () int
  (match (x509_parse (c_api_1))
    ((Err why) (fail_because "parse" why))
    ((Ok c) (check_bool "ed25519" (trust_signed (.key c) 2055 (bytes_from_list "m") (bytes_from_list "s")) false))))
