; hkdf_test.l0 -- tests of hkdf.l0: RFC 4231's HMAC test cases 1, 2,
; 4, 6 and 7 for SHA-256, -384 and -512; RFC 5869's HKDF test cases 1
; to 3; and RFC 8448's early and derived secrets of a simple 1-RTT
; handshake.

; The bytes of d as lowercase hex.
(def hkdf_hex ((d bytes)) (list int)
  (hkdf_hex_from d 0 (nil int)))

; The bytes of d from i on in hex, after the reversed acc.
(def hkdf_hex_from ((d bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len d))
      (rev acc)
      (hkdf_hex_from d (add i 1) (push (hex_digits (bytes_get d i) 2) acc))))

; The bytes s spells, two hex digits each.
(def hkdf_unhex ((s (list int))) bytes
  (bytes_from_list (hkdf_unhex_onto s (nil int))))

; The bytes the digits s spell, after the reversed acc.
(def hkdf_unhex_onto ((s (list int)) (acc (list int))) (list int)
  (if (or (is_empty s) (is_empty (tail s)))
      (rev acc)
      (hkdf_unhex_onto (tail (tail s)) (cons (add (mul 16 (hex_val (head s))) (hex_val (head (tail s)))) acc))))

; n bytes, each x.
(def hkdf_rep ((n int) (x int)) bytes
  (bytes_from_list (hkdf_rep_onto n x (nil int))))

; n of x before acc.
(def hkdf_rep_onto ((n int) (x int) (acc (list int))) (list int)
  (if (le n 0) acc (hkdf_rep_onto (sub n 1) x (cons x acc))))

; The bytes lo up to hi, in order.
(def hkdf_range ((lo int) (hi int)) bytes
  (bytes_from_list (hkdf_range_onto lo (sub hi 1) (nil int))))

; The bytes lo to i before acc.
(def hkdf_range_onto ((lo int) (i int) (acc (list int))) (list int)
  (if (lt i lo) acc (hkdf_range_onto lo (sub i 1) (cons i acc))))

; The HMAC with a of msg under key, against want in hex.
(def hkdf_hmac_is ((name (list int)) (a HashAlg) (key bytes) (msg (list int)) (want (list int))) int
  (check_str name (hkdf_hex (hmac a key (bytes_from_list msg))) want))

; ---------------------------------------------------- RFC 4231's HMAC

(def test_hmac_case1 () int
  (add (hkdf_hmac_is "256" (HashSha256) (hkdf_rep 20 11) "Hi There" "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
       (add (hkdf_hmac_is "384" (HashSha384) (hkdf_rep 20 11) "Hi There" "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")
            (hkdf_hmac_is "512" (HashSha512) (hkdf_rep 20 11) "Hi There" "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"))))

; A key shorter than the digest.
(def test_hmac_case2 () int
  (let k (bytes_from_list "Jefe")
    (add (hkdf_hmac_is "256" (HashSha256) k "what do ya want for nothing?" "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
         (add (hkdf_hmac_is "384" (HashSha384) k "what do ya want for nothing?" "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
              (hkdf_hmac_is "512" (HashSha512) k "what do ya want for nothing?" "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")))))

; Key 0x01 to 0x19, data 50 of 0xcd.
(def test_hmac_case4 () int
  (let (k (hkdf_range 1 26)
        m (bytes_to_list (hkdf_rep 50 205)))
    (add (hkdf_hmac_is "256" (HashSha256) k m "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
         (add (hkdf_hmac_is "384" (HashSha384) k m "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb")
              (hkdf_hmac_is "512" (HashSha512) k m "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd")))))

; A key of 131 bytes, longer than any block: hashed first.
(def test_hmac_case6 () int
  (let (k (hkdf_rep 131 170)
        m "Test Using Larger Than Block-Size Key - Hash Key First")
    (add (hkdf_hmac_is "256" (HashSha256) k m "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
         (add (hkdf_hmac_is "384" (HashSha384) k m "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952")
              (hkdf_hmac_is "512" (HashSha512) k m "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")))))

; A long key and data longer than a block.
(def test_hmac_case7 () int
  (let (k (hkdf_rep 131 170)
        m "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")
    (add (hkdf_hmac_is "256" (HashSha256) k m "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
         (add (hkdf_hmac_is "384" (HashSha384) k m "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e")
              (hkdf_hmac_is "512" (HashSha512) k m "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58")))))

; A changed message or key gives another HMAC.
(def test_hmac_tampered () int
  (let (k (hkdf_rep 20 11)
        good (hmac (HashSha256) k (bytes_from_list "Hi There")))
    (add (check_bool "message" (eq (hmac (HashSha256) k (bytes_from_list "Hi There!")) good) false)
         (check_bool "key" (eq (hmac (HashSha256) (hkdf_rep 20 12) (bytes_from_list "Hi There")) good) false))))

; ---------------------------------------------------- RFC 5869's HKDF

(def test_hkdf_case1 () int
  (let (prk (hkdf_extract (HashSha256) (hkdf_range 0 13) (hkdf_rep 22 11))
        okm (hkdf_expand (HashSha256) prk (hkdf_range 240 250) 42))
    (add (check_str "prk" (hkdf_hex prk) "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
         (check_str "okm" (hkdf_hex okm) "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"))))

; Longer inputs, and 82 bytes: three blocks, the last cut.
(def test_hkdf_case2 () int
  (let (prk (hkdf_extract (HashSha256) (hkdf_range 96 176) (hkdf_range 0 80))
        okm (hkdf_expand (HashSha256) prk (hkdf_range 176 256) 82))
    (add (check_str "prk" (hkdf_hex prk) "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244")
         (check_str "okm" (hkdf_hex okm) "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87"))))

; No salt and no info.
(def test_hkdf_case3 () int
  (let (prk (hkdf_extract (HashSha256) (bytes_from_list "") (hkdf_rep 22 11))
        okm (hkdf_expand (HashSha256) prk (bytes_from_list "") 42))
    (add (check_str "prk" (hkdf_hex prk) "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")
         (check_str "okm" (hkdf_hex okm) "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8"))))

; A shorter expansion is a prefix of a longer one.
(def test_hkdf_expand_prefix () int
  (let (prk (hkdf_rep 32 7)
        long (hkdf_expand (HashSha256) prk (bytes_from_list "x") 70)
        short (hkdf_expand (HashSha256) prk (bytes_from_list "x") 33))
    (add (check_int "length" (bytes_len short) 33)
         (check_str "prefix" (hkdf_hex short) (hkdf_hex (bytes_slice long 0 33))))))

; ------------------------------------------------- RFC 8448, 3, TLS 1.3

; The early secret: HKDF-Extract of 32 zeros, no PSK, with no salt.
(def hkdf_early () bytes
  (hkdf_extract (HashSha256) (bytes_from_list "") (hkdf_rep 32 0)))

(def test_hkdf_tls_early () int
  (check_str "early" (hkdf_hex (hkdf_early)) "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a"))

; Derive-Secret(early, "derived", the hash of no messages).
(def test_hkdf_tls_derived () int
  (let (empty (bytes_from_list "")
        d (hkdf_derive_secret (HashSha256) (hkdf_early) "derived" (hash_of (HashSha256) empty 0 0)))
    (check_str "derived" (hkdf_hex d) "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")))

; Another label gives another secret.
(def test_hkdf_tls_label_matters () int
  (let (empty (bytes_from_list "")
        h (hash_of (HashSha256) empty 0 0)
        d (hkdf_derive_secret (HashSha256) (hkdf_early) "derivee" h))
    (check_bool "label" (eq (hkdf_hex d) "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba") false)))

; Expand-Label is Expand with RFC 8446's HkdfLabel as info: length 16,
; "tls13 key", no context.
(def test_hkdf_expand_label_info () int
  (let (s (hkdf_rep 32 1)
        info (bytes_concat (cons (hkdf_unhex "0010") (cons (bytes_from_list (cons 9 "tls13 key")) (cons (hkdf_unhex "00") (nil bytes))))))
    (check_str "key" (hkdf_hex (hkdf_expand_label (HashSha256) s "key" (bytes_from_list "") 16))
      (hkdf_hex (hkdf_expand (HashSha256) s info 16)))))

; ------------------------------------------------------ the hash itself

(def test_hash_sizes () int
  (add (check_int "256" (add (mul 1000 (hash_len (HashSha256))) (hash_block (HashSha256))) 32064)
       (add (check_int "384" (add (mul 1000 (hash_len (HashSha384))) (hash_block (HashSha384))) 48128)
            (check_int "512" (add (mul 1000 (hash_len (HashSha512))) (hash_block (HashSha512))) 64128))))

(def test_hash_of () int
  (let b (bytes_from_list "abc")
    (add (check_str "256" (hkdf_hex (hash_of (HashSha256) b 0 3)) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
         (check_str "384" (hkdf_hex (hash_of (HashSha384) b 0 3)) "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"))))

(def test_hash_alg () int
  (add (check_bool "256" (eq (hash_alg (hash_new (HashSha256))) (HashSha256)) true)
       (add (check_bool "384" (eq (hash_alg (hash_new (HashSha384))) (HashSha384)) true)
            (check_bool "512" (eq (hash_alg (hash_new (HashSha512))) (HashSha512)) true))))

; A transcript peeked at after "ab" goes on to "abc", for each hash.
(def test_hash_peek_goes_on () int
  (add (hkdf_peek_ok (HashSha256)) (add (hkdf_peek_ok (HashSha384)) (hkdf_peek_ok (HashSha512)))))

; Whether a's transcript peeked at after "ab" and then given "c" hashes
; to what hash_of says of each, as a failure count.
(def hkdf_peek_ok ((a HashAlg)) int
  (let (b (bytes_from_list "abc")
        c (hash_more (hash_new a) b 0 2)
        d1 (hash_peek c)
        d2 (hash_peek (hash_more c b 2 3)))
    (add (check_str "ab" (hkdf_hex d1) (hkdf_hex (hash_of a b 0 2)))
         (check_str "abc" (hkdf_hex d2) (hkdf_hex (hash_of a b 0 3))))))
