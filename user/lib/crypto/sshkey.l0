; sshkey.l0 -- SSH's keys: public key blobs (RFC 4253 6.6) of
; ssh-ed25519 (RFC 8709), ecdsa-sha2-nistp256 (RFC 5656) and ssh-rsa,
; their signatures checked, rsa-sha2-256 and -512 for RSA (RFC 8332);
; OpenSSH's private key file, openssh-key-v1, for an Ed25519 key not
; encrypted, and signing with it; a key's SHA256 fingerprint as
; ssh-keygen -l prints it; and known_hosts, the keys a client has seen
; for each host. Pure; needs sshwire.l0, base64.l0, the hashes, and
; ed25519.l0, ecdsa.l0 and rsa.l0.

; A public key: Ed25519's 32 bytes; a P-256 point, 04 X Y; or RSA's
; exponent and modulus, big-endian.
(data SshPub (SshEd25519 bytes) (SshEcdsa256 bytes) (SshRsa bytes bytes))

; A private key: Ed25519's 32-byte seed, its public key, and the comment
; the file gives it.
(data SshKey (SshKey (seed bytes) (public bytes) (comment (list int))))

; What known_hosts says of a host's key: that it is the one known; that
; the host is known by another key of the same type; or that it is not
; known by any of that type.
(data SshHostCheck (SshHostKnown) (SshHostChanged) (SshHostUnknown))

; ------------------------------------------------------------- public keys

; The key a public key blob holds, or none if it is not one of the three
; types or does not read.
(def ssh_pub_of ((b bytes)) (Option SshPub)
  (let n (bytes_len b)
    (match (ssh_string_at b 0 n)
      ((None) ((None SshPub)))
      ((Some t)
        (if (ssh_field_is b t "ssh-ed25519") (ssh_ed25519_of b (.next t) n)
            (ssh_field_is b t "ecdsa-sha2-nistp256") (ssh_ecdsa_of b (.next t) n)
            (ssh_field_is b t "ssh-rsa") (ssh_rsa_of b (.next t) n)
            ((None SshPub)))))))

; An Ed25519 key's 32 bytes, at i.
(def ssh_ed25519_of ((b bytes) (i int) (n int)) (Option SshPub)
  (match (ssh_string_at b i n)
    ((None) ((None SshPub)))
    ((Some k) (if (eq (sub (.end k) (.start k)) 32) (Some (SshEd25519 (ssh_field_bytes b k))) ((None SshPub))))))

; A P-256 key, its curve's name then its point, at i.
(def ssh_ecdsa_of ((b bytes) (i int) (n int)) (Option SshPub)
  (match (ssh_string_at b i n)
    ((None) ((None SshPub)))
    ((Some c)
      (match (ssh_string_at b (.next c) n)
        ((None) ((None SshPub)))
        ((Some q)
          (if (and (ssh_field_is b c "nistp256") (eq (sub (.end q) (.start q)) 65))
              (Some (SshEcdsa256 (ssh_field_bytes b q)))
              ((None SshPub))))))))

; An RSA key, its exponent then its modulus as mpints, at i.
(def ssh_rsa_of ((b bytes) (i int) (n int)) (Option SshPub)
  (match (ssh_string_at b i n)
    ((None) ((None SshPub)))
    ((Some e)
      (match (ssh_string_at b (.next e) n)
        ((None) ((None SshPub)))
        ((Some m) (Some (SshRsa (ssh_field_bytes b e) (ssh_field_bytes b m))))))))

; The type a public key blob names, as its first string, or empty.
(def ssh_blob_type ((b bytes)) (list int)
  (match (ssh_string_at b 0 (bytes_len b))
    ((None) (nil int))
    ((Some t) (ssh_field_text b t))))

; ------------------------------------------------------------- signatures

; Whether sig, a signature blob (its algorithm's name, then the
; signature), is k's signature of msg by the algorithm alg, which the
; blob must name: ssh-ed25519 for an Ed25519 key, ecdsa-sha2-nistp256
; for P-256, rsa-sha2-256 or rsa-sha2-512 for RSA.
(def ssh_sig_ok ((k SshPub) (alg (list int)) (sig bytes) (msg bytes)) bool
  (let n (bytes_len sig)
    (match (ssh_string_at sig 0 n)
      ((None) false)
      ((Some a)
        (match (ssh_string_at sig (.next a) n)
          ((None) false)
          ((Some s)
            (and (ssh_field_is sig a alg)
                 (ssh_sig_body_ok k alg (ssh_field_bytes sig s) msg))))))))

; Whether s, the signature itself, is k's of msg by alg.
(def ssh_sig_body_ok ((k SshPub) (alg (list int)) (s bytes) (msg bytes)) bool
  (match k
    ((SshEd25519 pk) (and (eq alg "ssh-ed25519") (ed25519_verify pk msg s)))
    ((SshEcdsa256 q) (and (eq alg "ecdsa-sha2-nistp256") (ssh_ecdsa_ok q s msg)))
    ((SshRsa e m)
      (if (eq alg "rsa-sha2-256")
          (rsa_pkcs1_verify m e (ssh_rsa_padded m s) (rsa_digest_info 256 (sha256 msg 0 (bytes_len msg))))
          (eq alg "rsa-sha2-512")
          (rsa_pkcs1_verify m e (ssh_rsa_padded m s) (rsa_digest_info 512 (sha512 msg 0 (bytes_len msg))))
          false))))

; An ECDSA signature, two mpints r and s, checked on P-256 over SHA-256.
(def ssh_ecdsa_ok ((q bytes) (s bytes) (msg bytes)) bool
  (let n (bytes_len s)
    (match (ssh_string_at s 0 n)
      ((None) false)
      ((Some r)
        (match (ssh_string_at s (.next r) n)
          ((None) false)
          ((Some ss)
            (ecdsa_verify (EcP256) q (ssh_field_bytes s r) (ssh_field_bytes s ss) (sha256 msg 0 (bytes_len msg)))))))))

; An RSA signature s with zeros put before it to the modulus m's length,
; as a signer that dropped its leading zeros left it short.
(def ssh_rsa_padded ((m bytes) (s bytes)) bytes
  (let short (sub (rsa_len m) (bytes_len s))
    (if (le short 0)
        s
        (bytes_concat (cons (bytes_from_list (rsa_repeat 0 short (nil int))) (cons s (nil bytes)))))))

; ------------------------------------------------------------- fingerprints

; The SHA256 fingerprint of a public key blob, as ssh-keygen -l prints
; it: SHA256: and the hash in base64 without its padding.
(def ssh_fingerprint ((blob bytes)) (list int)
  (let h (sha256 blob 0 (bytes_len blob))
    (append "SHA256:" (ssh_unpadded (base64_encode h 0 32)))))

; s without the = at its end.
(def ssh_unpadded ((s (list int))) (list int)
  (rev (ssh_drop_eq (rev s))))

; s without the = at its front.
(def ssh_drop_eq ((s (list int))) (list int)
  (if (and (not (is_empty s)) (eq (head s) 61)) (ssh_drop_eq (tail s)) s))

; ------------------------------------------------------------- private keys

; The armor of OpenSSH's private key file.
(def ssh_key_begin () (list int) "-----BEGIN OPENSSH PRIVATE KEY-----")
(def ssh_key_end () (list int) "-----END OPENSSH PRIVATE KEY-----")

; The key the text of an OpenSSH private key file holds, or why there
; is none: it is not one, it is encrypted, or it is not Ed25519.
(def ssh_key_of_text ((text (list int))) (Result SshKey (list int))
  (let body (ssh_armored (lines text) false (nil (list int)))
    (if (is_empty body)
        ((Err SshKey (list int)) "not an OpenSSH private key")
        (let b64 (bytes_from_list (join_with "" body))
          (match (base64_decode b64 0 (bytes_len b64))
            ((None) ((Err SshKey (list int)) "its base64 does not read"))
            ((Some b) (ssh_key_of b)))))))

; The lines between the armor's BEGIN and END, each without spaces,
; after the reversed acc; empty if there is no END after a BEGIN. The
; armor's own lines are matched without their spaces too.
(def ssh_armored ((ls (list (list int))) (inside bool) (acc (list (list int)))) (list (list int))
  (if (is_empty ls)
      (nil (list int))
      (let l (ssh_trimmed (head ls))
        (if (and (not inside) (eq l (ssh_trimmed (ssh_key_begin)))) (ssh_armored (tail ls) true acc)
            (and inside (eq l (ssh_trimmed (ssh_key_end)))) (rev acc)
            inside (ssh_armored (tail ls) true (cons l acc))
            (ssh_armored (tail ls) false acc)))))

; s without spaces, tabs or carriage returns.
(def ssh_trimmed ((s (list int))) (list int)
  (ssh_trimmed_from s (nil int)))

; The rest of ssh_trimmed, after the reversed acc.
(def ssh_trimmed_from ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (let c (head s)
        (ssh_trimmed_from (tail s) (if (any_eq c (cons 32 (cons 9 (cons 13 (nil int))))) acc (cons c acc))))))

; The key the decoded file b holds: its magic, cipher, KDF and its
; options, one key's public blob, then the private section.
(def ssh_key_of ((b bytes)) (Result SshKey (list int))
  (let n (bytes_len b)
    (if (not (bytes_is_at b 0 "openssh-key-v1"))
        ((Err SshKey (list int)) "not an openssh-key-v1 key")
        (match (ssh_string_at b 15 n)
          ((None) ((Err SshKey (list int)) "cut short"))
          ((Some cipher)
            (if (not (ssh_field_is b cipher "none"))
                ((Err SshKey (list int)) "the key is encrypted with a passphrase, which ssh cannot read")
                (match (ssh_key_skip b (.next cipher) n 2)
                  ((None) ((Err SshKey (list int)) "cut short"))
                  ((Some i) (ssh_key_section b i n)))))))))

; Where the field after the next k strings from i begins, if they read.
(def ssh_key_skip ((b bytes) (i int) (n int) (k int)) (Option int)
  (if (eq k 0)
      (Some i)
      (match (ssh_string_at b i n)
        ((None) ((None int)))
        ((Some f) (ssh_key_skip b (.next f) n (sub k 1))))))

; The key count at i, which must be 1, the public blob, and the private
; section, read.
(def ssh_key_section ((b bytes) (i int) (n int)) (Result SshKey (list int))
  (match (ssh_u32_at b i n)
    ((None) ((Err SshKey (list int)) "cut short"))
    ((Some count)
      (if (not (eq (.value count) 1))
          ((Err SshKey (list int)) "the file holds more than one key")
          (match (ssh_key_skip b (.next count) n 1)
            ((None) ((Err SshKey (list int)) "cut short"))
            ((Some p)
              (match (ssh_string_at b p n)
                ((None) ((Err SshKey (list int)) "cut short"))
                ((Some priv) (ssh_key_private b (.start priv) (.end priv))))))))))

; The private section from i to n: two equal check words, the key's
; type, its public key, its secret (the seed and the public key again),
; and its comment.
(def ssh_key_private ((b bytes) (i int) (n int)) (Result SshKey (list int))
  (if (or (gt (add i 8) n) (not (eq (ssh_u32 b i) (ssh_u32 b (add i 4)))))
      ((Err SshKey (list int)) "its check words differ")
      (match (ssh_string_at b (add i 8) n)
        ((None) ((Err SshKey (list int)) "cut short"))
        ((Some t)
          (if (not (ssh_field_is b t "ssh-ed25519"))
              ((Err SshKey (list int)) (append "a key of type " (append (ssh_field_text b t) ", where ssh reads only ssh-ed25519")))
              (ssh_key_ed25519 b (.next t) n))))))

; An Ed25519 key's public key, secret and comment, from i.
(def ssh_key_ed25519 ((b bytes) (i int) (n int)) (Result SshKey (list int))
  (match (ssh_string_at b i n)
    ((None) ((Err SshKey (list int)) "cut short"))
    ((Some pk)
      (match (ssh_string_at b (.next pk) n)
        ((None) ((Err SshKey (list int)) "cut short"))
        ((Some sk)
          (match (ssh_string_at b (.next sk) n)
            ((None) ((Err SshKey (list int)) "cut short"))
            ((Some c)
              (if (or (not (eq (sub (.end pk) (.start pk)) 32)) (not (eq (sub (.end sk) (.start sk)) 64)))
                  ((Err SshKey (list int)) "its Ed25519 key is not 32 bytes")
                  ((Ok SshKey (list int))
                    (SshKey (bytes_slice b (.start sk) (add (.start sk) 32))
                            (ssh_field_bytes b pk)
                            (ssh_field_text b c)))))))))))

; A private key's public blob, as a server is told it.
(def ssh_key_blob ((k SshKey)) bytes
  (ssh_join (cons (ssh_w_text "ssh-ed25519") (cons (ssh_w_string (.public k)) (nil bytes)))))

; A private key's signature blob of msg.
(def ssh_key_sign ((k SshKey) (msg bytes)) bytes
  (ssh_join (cons (ssh_w_text "ssh-ed25519")
                  (cons (ssh_w_string (ed25519_sign (.seed k) (.public k) msg)) (nil bytes)))))

; ------------------------------------------------------------- known hosts

; The name known_hosts knows a host by: the host, or [host]:port for any
; port but 22.
(def ssh_host_name ((host (list int)) (port int)) (list int)
  (if (eq port 22) host (append "[" (append host (append "]:" (digits port))))))

; What the known_hosts text says of the host called name and its key's
; blob. A line is hosts (a comma list), type and base64 key, a comment
; after; a line of @ markers, hashed (|1|) hosts or patterns matches
; none.
(def ssh_known_check ((text (list int)) (name (list int)) (blob bytes)) SshHostCheck
  (ssh_known_lines (lines text) name (ssh_blob_type blob) blob (SshHostUnknown)))

; The rest of ssh_known_check, from the lines ls on, what was found so
; far being found.
(def ssh_known_lines ((ls (list (list int))) (name (list int)) (t (list int)) (blob bytes) (found SshHostCheck)) SshHostCheck
  (if (is_empty ls)
      found
      (let ws (split_spaces (head ls))
        (if (or (lt (length ws) 3)
                (or (not (any_eq name (split_on 44 (head ws))))
                    (not (eq (nth ws 1) t))))
            (ssh_known_lines (tail ls) name t blob found)
            (let b64 (bytes_from_list (nth ws 2))
              (match (base64_decode b64 0 (bytes_len b64))
                ((None) (ssh_known_lines (tail ls) name t blob found))
                ((Some k)
                  (if (eq k blob)
                      (SshHostKnown)
                      (ssh_known_lines (tail ls) name t blob (SshHostChanged))))))))))

; The known_hosts line that knows the host called name by blob.
(def ssh_known_line ((name (list int)) (blob bytes)) (list int)
  (append name (append " " (append (ssh_blob_type blob) (append " " (append (base64_encode blob 0 (bytes_len blob)) "\n"))))))
