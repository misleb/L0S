; rsa_test.l0 -- tests of rsa.l0: signatures openssl made with 2048-
; and 4096-bit keys, PKCS #1 v1.5 and PSS over SHA-256, which verify and
; fail once tampered with, and ISRG Root X1's signature of itself.
; Links user/lib/format/sha256.l0.

; The SHA-256 of all of b, the hash PSS is given.
(def rsa_t_sha256 ((b bytes)) bytes
  (sha256 b 0 (bytes_len b)))

; 65537, as a certificate gives it.
(def rsa_t_e () bytes
  (bn_hex "010001"))

; b with its byte i xored with 1.
(def rsa_t_flip ((b bytes) (i int)) bytes
  (bytes_concat (cons (bytes_slice b 0 i) (cons (bytes_from_list (cons (bit_xor (bytes_get b i) 1) (nil int))) (cons (bytes_slice b (add i 1) (bytes_len b)) (nil bytes))))))

; Whether the PKCS #1 v1.5 signature sig of digest verifies under n.
(def rsa_t_p1 ((n (list int)) (sig bytes) (digest bytes)) bool
  (rsa_pkcs1_verify (bn_hex n) (rsa_t_e) sig (rsa_digest_info 256 digest)))

; Whether the PSS signature sig of digest verifies under n, salt slen.
(def rsa_t_pss ((n (list int)) (sig bytes) (digest bytes) (slen int)) bool
  (rsa_pss_verify (bn_hex n) (rsa_t_e) sig digest rsa_t_sha256 slen))

; The SHA-256 of "The quick brown fox jumps over the lazy dog", the message signed.
(def rsa_t_digest () (list int)
  "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592")

; The modulus of a 2048-bit key openssl genpkey made; its exponent is 65537.
(def rsa_t_n2048 () (list int)
  "")

; openssl dgst -sha256 -sign with that key: PKCS #1 v1.5.
(def rsa_t_p1_2048 () (list int)
  "")

; The same with -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32.
(def rsa_t_pss_2048 () (list int)
  "")

; The modulus of a 4096-bit key openssl genpkey made; its exponent is 65537.
(def rsa_t_n4096 () (list int)
  "")

; openssl dgst -sha256 -sign with that key: PKCS #1 v1.5.
(def rsa_t_p1_4096 () (list int)
  "")

; The same with -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:32.
(def rsa_t_pss_4096 () (list int)
  "")

; ISRG Root X1's modulus, from /etc/ssl/certs.
(def rsa_t_isrg_n () (list int)
  "")

; Its signature of itself, sha256WithRSAEncryption.
(def rsa_t_isrg_sig () (list int)
  "")

; The SHA-256 of its TBSCertificate, bytes 4 to 859 of its DER.
(def rsa_t_isrg_digest () (list int)
  "3f0411ede9c4477057d57e57883b1f205b20cdc0f3263129b1ee0269a2678f63")

(def test_rsa_digest_info () int
  (let d (rsa_digest_info 256 (bn_hex (rsa_t_digest)))
    (add (check_int "length" (bytes_len d) 51)
         (check_int "unknown hash" (bytes_len (rsa_digest_info 1 (bn_hex (rsa_t_digest)))) 0))))

(def test_rsa_pkcs1_2048 () int
  (add (check_true "verifies" (rsa_t_p1 (rsa_t_n2048) (bn_hex (rsa_t_p1_2048)) (bn_hex (rsa_t_digest))))
       (check_bool "with a 4096-bit key's digest info" (rsa_pkcs1_verify (bn_hex (rsa_t_n2048)) (rsa_t_e) (bn_hex (rsa_t_p1_2048)) (rsa_digest_info 384 (bn_hex (rsa_t_digest)))) false)))

(def test_rsa_pkcs1_2048_tampered () int
  (add (check_bool "signature" (rsa_t_p1 (rsa_t_n2048) (rsa_t_flip (bn_hex (rsa_t_p1_2048)) 100) (bn_hex (rsa_t_digest))) false)
       (check_bool "digest" (rsa_t_p1 (rsa_t_n2048) (bn_hex (rsa_t_p1_2048)) (rsa_t_flip (bn_hex (rsa_t_digest)) 31)) false)))

(def test_rsa_pkcs1_4096 () int
  (add (check_true "verifies" (rsa_t_p1 (rsa_t_n4096) (bn_hex (rsa_t_p1_4096)) (bn_hex (rsa_t_digest))))
       (check_bool "tampered" (rsa_t_p1 (rsa_t_n4096) (rsa_t_flip (bn_hex (rsa_t_p1_4096)) 0) (bn_hex (rsa_t_digest))) false)))

; Under the other key, it is no signature.
(def test_rsa_pkcs1_wrong_key () int
  (check_bool "wrong key" (rsa_t_p1 (rsa_t_n4096) (bn_hex (rsa_t_p1_2048)) (bn_hex (rsa_t_digest))) false))

; n with a leading 0 byte, as a certificate's INTEGER has it, is the same n.
(def test_rsa_leading_zero () int
  (check_true "00 n" (rsa_t_p1 (cons 48 (cons 48 (rsa_t_n2048))) (bn_hex (rsa_t_p1_2048)) (bn_hex (rsa_t_digest)))))

; A signature a byte longer, even of the same value, or not below n.
(def test_rsa_refused_lengths () int
  (let sig (bn_hex (rsa_t_p1_2048))
    (add (check_bool "longer" (rsa_t_p1 (rsa_t_n2048) (bytes_concat (cons (bn_hex "00") (cons sig (nil bytes)))) (bn_hex (rsa_t_digest))) false)
         (add (check_bool "shorter" (rsa_t_p1 (rsa_t_n2048) (bytes_slice sig 1 256) (bn_hex (rsa_t_digest))) false)
              (check_bool "n itself" (rsa_t_p1 (rsa_t_n2048) (bn_hex (rsa_t_n2048)) (bn_hex (rsa_t_digest))) false)))))

(def test_rsa_pss_2048 () int
  (add (check_true "verifies" (rsa_t_pss (rsa_t_n2048) (bn_hex (rsa_t_pss_2048)) (bn_hex (rsa_t_digest)) 32))
       (check_bool "as PKCS #1 v1.5" (rsa_t_p1 (rsa_t_n2048) (bn_hex (rsa_t_pss_2048)) (bn_hex (rsa_t_digest))) false)))

(def test_rsa_pss_2048_tampered () int
  (add (check_bool "signature" (rsa_t_pss (rsa_t_n2048) (rsa_t_flip (bn_hex (rsa_t_pss_2048)) 200) (bn_hex (rsa_t_digest)) 32) false)
       (add (check_bool "digest" (rsa_t_pss (rsa_t_n2048) (bn_hex (rsa_t_pss_2048)) (rsa_t_flip (bn_hex (rsa_t_digest)) 0) 32) false)
            (check_bool "salt length" (rsa_t_pss (rsa_t_n2048) (bn_hex (rsa_t_pss_2048)) (bn_hex (rsa_t_digest)) 20) false))))

(def test_rsa_pss_4096 () int
  (add (check_true "verifies" (rsa_t_pss (rsa_t_n4096) (bn_hex (rsa_t_pss_4096)) (bn_hex (rsa_t_digest)) 32))
       (check_bool "tampered" (rsa_t_pss (rsa_t_n4096) (rsa_t_flip (bn_hex (rsa_t_pss_4096)) 511) (bn_hex (rsa_t_digest)) 32) false)))

(def test_rsa_pkcs1_as_pss () int
  (check_bool "PKCS #1 v1.5 as PSS" (rsa_t_pss (rsa_t_n2048) (bn_hex (rsa_t_p1_2048)) (bn_hex (rsa_t_digest)) 32) false))

(def test_rsa_isrg_root () int
  (add (check_true "verifies" (rsa_t_p1 (rsa_t_isrg_n) (bn_hex (rsa_t_isrg_sig)) (bn_hex (rsa_t_isrg_digest))))
       (check_bool "tampered" (rsa_t_p1 (rsa_t_isrg_n) (bn_hex (rsa_t_isrg_sig)) (rsa_t_flip (bn_hex (rsa_t_isrg_digest)) 5)) false)))

; The MGF1 of "abc" over SHA-256, 40 bytes: the hash of abc 00000000,
; then the first 8 of that of abc 00000001.
(def test_rsa_mgf1 () int
  (let (seed (bytes_from_list "abc")
        m (rsa_mgf1 rsa_t_sha256 seed 40)
        h0 (rsa_t_sha256 (bytes_from_list "abc\x00\x00\x00\x00"))
        h1 (rsa_t_sha256 (bytes_from_list "abc\x00\x00\x00\x01")))
    (check_true "mgf1" (eq m (bytes_concat (cons h0 (cons (bytes_slice h1 0 8) (nil bytes))))))))
