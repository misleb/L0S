; ecdsa_test.l0 -- tests of ecdsa.l0, against RFC 6979's A.2.5 (P-256)
; and A.2.6 (P-384): its keys' signatures of "sample" verify, and fail
; once the digest, r, s or the point is changed; and DER signatures read
; strictly. Links user/lib/format/sha256.l0.

; The SHA-256 of "sample".
(def ec_t_sha256 () bytes
  (let b (bytes_from_list "sample") (sha256 b 0 6)))

; The SHA-384 of "sample", as openssl dgst -sha384 gives it.
(def ec_t_sha384 () bytes
  (bn_hex "9a9083505bc92276aec4be312696ef7bf3bf603f4bbd381196a029f340585312313bca4a9b5b890efee42c77b1ee25fe"))

; A.2.5's public key, 04 Ux Uy.
(def ec_t_p256_key () bytes
  (bn_hex "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299"))

; A.2.6's public key, 04 Ux Uy.
(def ec_t_p384_key () bytes
  (bn_hex "04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc138015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720"))

; P-256, SHA-256, "sample": r and s.
(def ec_t_r256 () bytes
  (bn_hex "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716"))

(def ec_t_s256 () bytes
  (bn_hex "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8"))

; P-256, SHA-384, "sample": the digest is cut to its first 256 bits.
(def ec_t_r256_384 () bytes
  (bn_hex "0eafea039b20e9b42309fb1d89e213057cbf973dc0cfc8f129edddc800ef7719"))

(def ec_t_s256_384 () bytes
  (bn_hex "4861f0491e6998b9455193e34e7b0d284ddd7149a74b95b9261f13abde940954"))

; P-384, SHA-384, "sample".
(def ec_t_r384 () bytes
  (bn_hex "94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46"))

(def ec_t_s384 () bytes
  (bn_hex "99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8"))

; P-384, SHA-256, "sample": a digest shorter than n, used whole.
(def ec_t_r384_256 () bytes
  (bn_hex "21b13d1e013c7fa1392d03c5f99af8b30c570c6f98d4ea8e354b63a21d3daa33bde1e888e63355d92fa2b3c36d8fb2cd"))

(def ec_t_s384_256 () bytes
  (bn_hex "f3aa443fb107745bf4bd77cb3891674632068a10ca67e3d45db2266fa7d1feebefdc63eccd1ac42ec0cb8668a4fa0ab0"))

; b with its byte i xored with 1.
(def ec_t_flip ((b bytes) (i int)) bytes
  (bytes_concat (cons (bytes_slice b 0 i) (cons (bytes_from_list (cons (bit_xor (bytes_get b i) 1) (nil int))) (cons (bytes_slice b (add i 1) (bytes_len b)) (nil bytes))))))

; a then b.
(def ec_t_cat ((a bytes) (b bytes)) bytes
  (bytes_concat (cons a (cons b (nil bytes)))))

(def test_ecdsa_p256_sha256 () int
  (check_true "verifies" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_r256) (ec_t_s256) (ec_t_sha256))))

(def test_ecdsa_p256_sha384 () int
  (check_true "a longer digest, cut" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_r256_384) (ec_t_s256_384) (ec_t_sha384))))

(def test_ecdsa_p256_tampered () int
  (add (check_bool "digest" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_r256) (ec_t_s256) (ec_t_flip (ec_t_sha256) 31)) false)
       (add (check_bool "r" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_flip (ec_t_r256) 0) (ec_t_s256) (ec_t_sha256)) false)
            (check_bool "s" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_r256) (ec_t_flip (ec_t_s256) 10) (ec_t_sha256)) false))))

; The signature of the other digest, or under the other curve.
(def test_ecdsa_p256_mixed () int
  (add (check_bool "other digest" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_r256) (ec_t_s256) (ec_t_sha384)) false)
       (check_bool "other curve" (ecdsa_verify (EcP384) (ec_t_p256_key) (ec_t_r256) (ec_t_s256) (ec_t_sha256)) false)))

(def test_ecdsa_p256_off_curve () int
  (add (check_bool "y changed" (ecdsa_verify (EcP256) (ec_t_flip (ec_t_p256_key) 64) (ec_t_r256) (ec_t_s256) (ec_t_sha256)) false)
       (check_bool "compressed prefix" (ecdsa_verify (EcP256) (ec_t_flip (ec_t_p256_key) 0) (ec_t_r256) (ec_t_s256) (ec_t_sha256)) false)))

; Leading zeros on r and s change nothing.
(def test_ecdsa_leading_zeros () int
  (let z (bn_hex "0000")
    (check_true "00 00 r, s" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_cat z (ec_t_r256)) (ec_t_cat z (ec_t_s256)) (ec_t_sha256)))))

; r of 0, and r or s of n, n plus the signature's own r: refused.
(def test_ecdsa_range () int
  (let n (bn_hex "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    (add (check_bool "r 0" (ecdsa_verify (EcP256) (ec_t_p256_key) (bn_hex "00") (ec_t_s256) (ec_t_sha256)) false)
         (add (check_bool "r n" (ecdsa_verify (EcP256) (ec_t_p256_key) n (ec_t_s256) (ec_t_sha256)) false)
              (check_bool "s + n" (ecdsa_verify (EcP256) (ec_t_p256_key) (ec_t_r256) (bn_to_bytes (bn_add (bn_of_bytes (ec_t_s256)) (bn_of_bytes n)) 33) (ec_t_sha256)) false)))))

(def test_ecdsa_p384_sha384 () int
  (check_true "verifies" (ecdsa_verify (EcP384) (ec_t_p384_key) (ec_t_r384) (ec_t_s384) (ec_t_sha384))))

(def test_ecdsa_p384_sha256 () int
  (check_true "a shorter digest" (ecdsa_verify (EcP384) (ec_t_p384_key) (ec_t_r384_256) (ec_t_s384_256) (ec_t_sha256))))

(def test_ecdsa_p384_tampered () int
  (add (check_bool "digest" (ecdsa_verify (EcP384) (ec_t_p384_key) (ec_t_r384) (ec_t_s384) (ec_t_flip (ec_t_sha384) 47)) false)
       (add (check_bool "r" (ecdsa_verify (EcP384) (ec_t_p384_key) (ec_t_flip (ec_t_r384) 47) (ec_t_s384) (ec_t_sha384)) false)
            (check_bool "s" (ecdsa_verify (EcP384) (ec_t_p384_key) (ec_t_r384) (ec_t_flip (ec_t_s384) 20) (ec_t_sha384)) false))))

(def test_ecdsa_p384_off_curve () int
  (check_bool "x changed" (ecdsa_verify (EcP384) (ec_t_flip (ec_t_p384_key) 5) (ec_t_r384) (ec_t_s384) (ec_t_sha384)) false))

; ---------------------------------------------------------------- DER

; A.2.5's SHA-256 signature in DER: r and s each start with a byte from
; 0x80, so each INTEGER is 33 bytes, a 00 first, and the SEQUENCE 70.
(def ec_t_der () bytes
  (bn_hex "3046022100efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716022100f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8"))

; What a signature read gives, as "r-hex s-hex", or "none".
(def ec_t_show ((o (Option EcdsaSig))) (list int)
  (match o
    ((None) "none")
    ((Some sig) (append (sha256_digest_hex (.r sig)) (append " " (sha256_digest_hex (.s sig)))))))

(def test_ecdsa_der () int
  (check_str "read" (ec_t_show (ecdsa_sig_of_der (ec_t_der)))
    "00efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716 00f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8"))

; What was read verifies.
(def test_ecdsa_der_verifies () int
  (match (ecdsa_sig_of_der (ec_t_der))
    ((None) (fail_because "der" "not read"))
    ((Some sig) (check_true "verifies" (ecdsa_verify (EcP256) (ec_t_p256_key) (.r sig) (.s sig) (ec_t_sha256))))))

(def test_ecdsa_der_small () int
  (check_str "small" (ec_t_show (ecdsa_sig_of_der (bn_hex "3007020101020200ff"))) "01 00ff"))

(def test_ecdsa_der_lengths () int
  (add (check_str "a byte after" (ec_t_show (ecdsa_sig_of_der (ec_t_cat (ec_t_der) (bn_hex "00")))) "none")
       (add (check_str "cut short" (ec_t_show (ecdsa_sig_of_der (bytes_slice (ec_t_der) 0 71))) "none")
            (check_str "sequence too long" (ec_t_show (ecdsa_sig_of_der (bn_hex "3008020101020200ff"))) "none"))))

(def test_ecdsa_der_integers () int
  (add (check_str "negative" (ec_t_show (ecdsa_sig_of_der (bn_hex "30070201ff020200ff"))) "none")
       (add (check_str "not minimal" (ec_t_show (ecdsa_sig_of_der (bn_hex "300802020001020200ff"))) "none")
            (check_str "empty" (ec_t_show (ecdsa_sig_of_der (bn_hex "30060200020200ff"))) "none"))))

; Long-form lengths only from 128; a third INTEGER refused.
(def test_ecdsa_der_forms () int
  (add (check_str "long form below 128" (ec_t_show (ecdsa_sig_of_der (bn_hex "308107020101020200ff"))) "none")
       (check_str "a third integer" (ec_t_show (ecdsa_sig_of_der (bn_hex "300a020101020200ff020101"))) "none")))
