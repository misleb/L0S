; wav_test.l0 -- tests of wav.l0.

; A WAV file of chans channels at rate whose samples are the bytes s,
; with the chunk extra between its fmt and data chunks.
(def wav_with ((rate int) (chans int) (extra (list int)) (s (list int))) bytes
  (let h (wav_header rate chans (length s))
    (bytes_from_list (append (take h 36) (append extra (append (drop h 36) s))))))

(def wav_text ((w Wav)) (list int)
  (match w
    ((Wav r c s e) (append (digits r) (append " " (append (digits c) (append " " (append (digits s) (append "-" (digits e))))))))
    ((WavBad why) why)))

(def test_wav_stereo () int
  (check_str "parsed" (wav_text (parse_wav (wav_with 48000 2 "" "abcdefgh"))) "48000 2 44-52"))

(def test_wav_mono_frames () int
  (check_int "frames" (wav_frames (parse_wav (wav_with 44100 1 "" "abcdef"))) 3))

(def test_wav_skips_chunks () int
  (check_str "parsed" (wav_text (parse_wav (wav_with 32000 2 (append "LIST" (append (u32_le 3) "abc ")) "abcd")))
    "32000 2 56-60"))

(def test_wav_cut_to_frames () int
  (check_str "parsed" (wav_text (parse_wav (bytes_from_list (append (wav_header 48000 2 8) "abcdef"))))
    "48000 2 44-48"))

(def test_wav_not_riff () int
  (check_str "refused" (wav_text (parse_wav (bytes_from_list "RIFX....WAVE"))) "not a WAV file: no RIFF WAVE"))

(def test_wav_no_data () int
  (check_str "refused" (wav_text (parse_wav (bytes_from_list (take (wav_header 48000 2 0) 36))))
    "WAV file with no data chunk"))

(def test_wav_8_bit () int
  (let h (wav_header 8000 1 2)
    (check_str "refused" (wav_text (parse_wav (bytes_from_list (append (take h 34) (append (le16 8) (drop h 36))))))
      "WAV file of 8-bit samples; 16 are played")))

(def test_wav_not_pcm () int
  (let h (wav_header 8000 1 2)
    (check_str "refused" (wav_text (parse_wav (bytes_from_list (append (take h 20) (append (le16 3) (drop h 22))))))
      "WAV file not PCM")))
