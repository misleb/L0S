; ppm.l0 -- binary PPM images, P6 with a maxval of 255, as bytes: reading
; one's header and pixels, and writing one; and colors as 0xRRGGBB, their
; channels apart and together. Pure, so the host tools that draw images,
; mksplash and mkicon, link it too, as does render.l0.

; ---------------------------------------------------------------- colors

; The color of channels r, g and b, 0 to 255 each, as 0xRRGGBB.
(def rgb ((r int) (g int) (b int)) int
  (bit_or (bit_shl r 16) (bit_or (bit_shl g 8) b)))

; Each channel of c, 0 to 255.
(def rgb_red ((c int)) int (bit_and (bit_shr c 16) 255))
(def rgb_green ((c int)) int (bit_and (bit_shr c 8) 255))
(def rgb_blue ((c int)) int (bit_and c 255))

; ---------------------------------------------------------------- reading

; A binary PPM's width, height, and where its pixels start; or why not.
(data Ppm (Ppm int int int) (PpmBad (list int)))

(def parse_ppm ((b bytes)) Ppm
  (if (not (if (has b 0 2) (if (eq (bytes_get b 0) 80) (eq (bytes_get b 1) 54) false) false))   ; "P6"
      (PpmBad "not a binary PPM: no P6")
      (ppm_fields b 2 (nil int))))

; The header's numbers from i, collected until there are three.
(def ppm_fields ((b bytes) (i int) (got (list int))) Ppm
  (if (eq (length got) 3)
      (ppm_checked b i (rev got))
      (let j (ppm_skip_blank b i)
        (if (not (if (has b j 1) (is_digit (bytes_get b j)) false))
            (PpmBad "PPM header cut short")
            (let k (ppm_digits_end b j)
              (ppm_fields b k (cons (int_prefix (bytes_range b j k) 0) got)))))))

; Past spaces, newlines, tabs, and comments from # to the end of a line.
(def ppm_skip_blank ((b bytes) (i int)) int
  (if (not (has b i 1))
      i
      (if (is_space (bytes_get b i))
          (ppm_skip_blank b (add i 1))
          (if (eq (bytes_get b i) 35) (ppm_skip_blank b (ppm_line_end b i)) i))))

(def ppm_line_end ((b bytes) (i int)) int
  (if (not (has b i 1)) i (if (eq (bytes_get b i) 10) (add i 1) (ppm_line_end b (add i 1)))))

(def ppm_digits_end ((b bytes) (i int)) int
  (if (if (has b i 1) (is_digit (bytes_get b i)) false) (ppm_digits_end b (add i 1)) i))

; One whitespace byte ends the header; then width * height pixels of 3.
(def ppm_checked ((b bytes) (i int) (nums (list int))) Ppm
  (let w (head nums)
    (let h (head (tail nums))
      (if (not (eq (head (tail (tail nums))) 255))
          (PpmBad "PPM maxval is not 255")
          (if (if (lt w 1) true (lt h 1))
              (PpmBad "PPM has no pixels")
              (if (not (has b (add i 1) (mul (mul w h) 3)))
                  (PpmBad "PPM pixels cut short")
                  (Ppm w h (add i 1))))))))

; The pixel at x, y of an image w wide whose pixels start at off, as the
; scanout keeps one: b, then g, then r, least significant first.
(def pixel_at ((b bytes) (off int) (w int) (x int) (y int)) int
  (let i (add off (mul (add (mul y w) x) 3))
    (rgb (bytes_get b i) (bytes_get b (add i 1)) (bytes_get b (add i 2)))))

; ---------------------------------------------------------------- writing

; The header of a w by h image, its pixels to follow.
(def ppm_header ((w int) (h int)) (list int)
  (append "P6\n" (append (digits w) (append " " (append (digits h) " 255\n")))))

; acc, reversed, with color c's pixel after it: its red, green, then blue.
(def ppm_push_rgb ((c int) (acc (list int))) (list int)
  (cons (rgb_blue c) (cons (rgb_green c) (cons (rgb_red c) acc))))
