; pcm.l0 -- PCM samples, as bytes, purely: frames of any rate, channels
; and sample size converted to 16-bit samples at another rate and
; channels, a piece at a time as they come, with what one piece leaves
; for the next kept (PcmConv, pcm_convert), which is how the audio
; server (sound.md) takes any client's stream and gives any listener
; the format it asked; and pieces of frames mixed at volumes (pcm_mix).
; 48 kHz brought down to 16 kHz, as Whistle hears (speech.md), goes
; through a low-pass filter, so that nothing above 8 kHz folds down
; into what is kept (PcmDown, pcm_down); any other ratio is linear
; interpolation between the two frames each new one falls between.
; Linked as PCM in the Makefile, by the audio server, usb-audio and
; the tests.

; The low-pass filter: 63 taps of a sinc cut off at 7 kHz at 48 kHz,
; under a Hamming window, summing to 65536. It passes all to 6 kHz, half
; at 7 kHz, and 31 dB less at 8 kHz, half of 16 kHz, and 58 dB less
; from 9 kHz on. Each third of it sums to about 65536 / 3, so taken up
; by 3 the samples keep their loudness.
(def pcm_taps () (array int)
  (array_from (concat (cons (pcm_row "-7 40 64 38 -35 -107 -107 0 160 236 113 -176 -413 -348 75 583")
                      (cons (pcm_row "723 235 -639 -1215 -856 422 1757 1932 345 -2253 -3892 -2507 2601 9966 16487 19092")
                      (cons (pcm_row "16487 9966 2601 -2507 -3892 -2253 345 1932 1757 422 -856 -1215 -639 235 723 583")
                      (cons (pcm_row "75 -348 -413 -176 113 236 160 0 -107 -107 -35 38 64 40 -7") (nil (list int)))))))
              0))

; The numbers of a row of the taps, negative ones among them.
(def pcm_row ((s (list int))) (list int) (pcm_numbers (split_spaces s) (nil int)))
(def pcm_numbers ((ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws)
      (rev acc)
      (let w (head ws)
        (pcm_numbers (tail ws) (cons (if (starts_with w "-") (neg (int_prefix (tail w) 0)) (int_prefix w 0)) acc)))))

; How many taps the filter has, and how many samples before the newest
; it reads: 63 and 62.
(def pcm_tap_count () int 63)
(def pcm_reach () int 62)

; The factor between the rates: 48 kHz is three times 16 kHz.
(def pcm_factor () int 3)

; A 16-bit sample kept in its range.
(def pcm_clamp16 ((v int)) int (max -32768 (min 32767 v)))

; The sample of size bytes at byte i of b, signed, least significant
; first, as 16 bits: its top two bytes, so 24 bits lose the 8 lowest.
(def pcm_sample16_at ((b bytes) (i int) (size int)) int
  (let u (bit_or (bytes_get b (add i (sub size 2))) (bit_shl (bytes_get b (add i (sub size 1))) 8))
    (if (ge u 32768) (sub u 65536) u)))

; The frame at byte i of b, chans samples of size bytes each, as one
; 16-bit sample: their mean.
(def pcm_mono_at ((b bytes) (i int) (chans int) (size int)) int
  (div (pcm_sum_at b i chans size 0 0) (max chans 1)))
(def pcm_sum_at ((b bytes) (i int) (chans int) (size int) (k int) (acc int)) int
  (if (ge k chans) acc (pcm_sum_at b (add i size) chans size (add k 1) (add acc (pcm_sample16_at b i size)))))

; v as a 16-bit sample's two bytes, least significant first, pushed
; onto the reversed acc.
(def pcm_push16 ((v int) (acc (list int))) (list int)
  (let u (bit_and (pcm_clamp16 v) 65535)
    (cons (bit_shr u 8) (cons (bit_and u 255) acc))))

; ------------------------------------------------------------------- down

; Bringing 48 kHz down to 16 kHz as pieces come: the last 62 samples of
; the pieces so far, oldest first, which the filter still reads, and how
; many samples of the next piece to pass before the next kept.
(data PcmDown (PcmDown (hist (array int)) (skip int)))

; Before the first piece: silence before it, and its first sample's
; filtered value the first kept.
(def pcm_down_new () PcmDown (PcmDown (array_new (pcm_reach) 0) 0))

; What one piece gives: the state for the next, and its samples at 16
; kHz, one channel of 16 bits.
(data PcmDowned (PcmDowned (st PcmDown) (out bytes)))

; The frames of b from byte i up to j, chans samples of size bytes each
; at 48 kHz, after st: each made one 16-bit sample, filtered, and every
; third kept. A part of a frame at the end is passed over.
(def pcm_down ((st PcmDown) (b bytes) (i int) (j int) (chans int) (size int)) PcmDowned
  (let (fb (max (mul chans size) 1)
        n (div (max (sub j i) 0) fb)
        x (pcm_mono_into (pcm_hist_into (array_new (add (pcm_reach) n) 0) (.hist st) 0) b i fb chans size 0 n)
        len (array_len x)
        out (pcm_kept x (pcm_taps) (add (pcm_reach) (.skip st)) len (nil int))
        next (pcm_next_kept (add (pcm_reach) (.skip st)) len))
    (PcmDowned (PcmDown (pcm_tail_of x (pcm_reach)) (sub next len)) (bytes_from_list (rev out)))))

; x with h's samples from k on at the same places.
(def pcm_hist_into ((x (array int)) (h (array int)) (k int)) (array int)
  (if (ge k (array_len h)) x (pcm_hist_into (array_set x k (array_get h k)) h (add k 1))))

; x with frame k of n, from byte i + k fb of b, as one sample at 62 + k.
(def pcm_mono_into ((x (array int)) (b bytes) (i int) (fb int) (chans int) (size int) (k int) (n int)) (array int)
  (if (ge k n)
      x
      (pcm_mono_into (array_set x (add (pcm_reach) k) (pcm_mono_at b (add i (mul k fb)) chans size)) b i fb chans size (add k 1) n)))

; The filter's value at each kept place of x from p, every third below
; len, as 16-bit samples pushed onto the reversed acc.
(def pcm_kept ((x (array int)) (taps (array int)) (p int) (len int) (acc (list int))) (list int)
  (if (ge p len)
      acc
      (pcm_kept x taps (add p (pcm_factor)) len (pcm_push16 (div (pcm_dot x (sub p (pcm_reach)) taps 0 0) 65536) acc))))

; The first kept place at or past len, from p by threes.
(def pcm_next_kept ((p int) (len int)) int
  (if (ge p len) p (add p (mul (pcm_factor) (div (add (sub len p) (sub (pcm_factor) 1)) (pcm_factor))))))

; The sum of each tap from k on times x's sample from base + k.
(def pcm_dot ((x (array int)) (base int) (taps (array int)) (k int) (acc int)) int
  (if (ge k (pcm_tap_count)) acc (pcm_dot x base taps (add k 1) (add acc (mul (array_get taps k) (array_get x (add base k)))))))

; The last n of x, oldest first.
(def pcm_tail_of ((x (array int)) (n int)) (array int)
  (pcm_copied (array_new n 0) x (sub (array_len x) n) 0 n))
(def pcm_copied ((y (array int)) (x (array int)) (from int) (k int) (n int)) (array int)
  (if (ge k n) y (pcm_copied (array_set y k (array_get x (add from k))) x from (add k 1) n)))

; ---------------------------------------------------------------- formats

; A format of PCM frames: the rate in Hz, the channels, and the bytes a
; sample, 2 or more, signed, least significant first; a frame is a
; sample of each channel.
(data PcmFormat (PcmFormat (rate int) (chans int) (size int)))

; The format every conversion gives: 16-bit samples at rate of chans.
(def pcm_format16 ((rate int) (chans int)) PcmFormat (PcmFormat rate chans 2))

; A frame's bytes in f.
(def pcm_frame_bytes ((f PcmFormat)) int (mul (.chans f) (.size f)))

; Whether f is one a conversion takes: a rate of 8000 to 192000 Hz, 1
; to 8 channels, 2 to 4 bytes a sample.
(def pcm_format_ok ((f PcmFormat)) bool
  (and (and (ge (.rate f) 8000) (le (.rate f) 192000))
       (and (and (ge (.chans f) 1) (le (.chans f) 8)) (and (ge (.size f) 2) (le (.size f) 4)))))

; Sample c of the frame at byte i of b, in f, as 16 bits.
(def pcm_sample_of ((b bytes) (i int) (f PcmFormat) (c int)) int
  (pcm_sample16_at b (add i (mul c (.size f))) (.size f)))

; Channel c of chans of the frame at byte i of b, in f: its own if f has
; as many channels, the mean of f's for one channel, f's first for one
; f lacks.
(def pcm_chan_of ((b bytes) (i int) (f PcmFormat) (chans int) (c int)) int
  (if (eq (.chans f) chans) (pcm_sample_of b i f c)
      (eq chans 1) (pcm_mono_at b i (.chans f) (.size f))
      (lt c (.chans f)) (pcm_sample_of b i f c)
      (pcm_sample_of b i f 0)))

; ------------------------------------------------------------- converting

; A conversion going, from one format to 16-bit samples of another rate
; and channels, a piece at a time: the last input frame, a sample of
; each output channel, silence before the first; where the next output
; frame falls, in input frames from that one, times the output rate;
; and, from 48 kHz to 16 kHz, the filter's state.
(data PcmConv (PcmConv (from PcmFormat) (to PcmFormat) (last (array int)) (at int) (down PcmDown)))

; A conversion from from to to, before its first piece: the first output
; frame falls on the first input frame.
(def pcm_conv_new ((from PcmFormat) (to PcmFormat)) PcmConv
  (PcmConv from to (array_new (.chans to) 0) (.rate to) (pcm_down_new)))

; Whether a conversion from from to to goes through the filter: 48 kHz
; brought down to 16 kHz.
(def pcm_conv_filtered ((from PcmFormat) (to PcmFormat)) bool
  (and (eq (.rate from) 48000) (eq (.rate to) 16000)))

; What one piece gives: the conversion for the next, and its frames, of
; 16-bit samples in the output format.
(data PcmConverted (PcmConverted (st PcmConv) (out bytes)))

; The frames of b from byte i up to j, in st's input format, converted
; after st: through the filter from 48 to 16 kHz, else each output frame
; between the two input frames it falls on, each channel as pcm_chan_of
; gives it. A part of a frame at the end is passed over.
(def pcm_convert ((st PcmConv) (b bytes) (i int) (j int)) PcmConverted
  (match st
    ((PcmConv from to last at down)
      (if (pcm_conv_filtered from to)
          (match (pcm_down down b i j (.chans from) (.size from))
            ((PcmDowned d2 out) (PcmConverted (PcmConv from to last at d2) (pcm_widened out (.chans to)))))
          (pcm_interpolated from to last at down b i j)))))

; Mono 16-bit samples b as frames of chans channels, the one sample in
; each.
(def pcm_widened ((b bytes) (chans int)) bytes
  (if (eq chans 1) b (bytes_from_list (rev (pcm_widen_onto b 0 (div (bytes_len b) 2) chans (nil int))))))
(def pcm_widen_onto ((b bytes) (k int) (n int) (chans int) (acc (list int))) (list int)
  (if (ge k n) acc (pcm_widen_onto b (add k 1) n chans (pcm_push_each (pcm_sample16_at b (mul 2 k) 2) chans acc))))
(def pcm_push_each ((v int) (n int) (acc (list int))) (list int)
  (if (le n 0) acc (pcm_push_each v (sub n 1) (pcm_push16 v acc))))

; pcm_convert's rest, by interpolation: the input frames in b from i up
; to j, after the last one, as an array x of to's channels a frame,
; frame 0 the last; each output frame at at, in input frames times the
; output rate, between frames at / rate and the next, as long as both
; are in x; then the last frame kept and at counted from it.
(def pcm_interpolated ((from PcmFormat) (to PcmFormat) (last (array int)) (at int) (down PcmDown) (b bytes) (i int) (j int)) PcmConverted
  (let (tc (.chans to)
        n (div (max (sub j i) 0) (pcm_frame_bytes from))
        x (pcm_frames_into (pcm_hist_into (array_new (mul (add n 1) tc) 0) last 0) b i from tc 1 n)
        out (pcm_lerp x tc n (.rate from) (.rate to) at (nil int))
        at2 (pcm_lerp_end n (.rate from) (.rate to) at))
    (PcmConverted (PcmConv from to (pcm_tail_of x tc) (sub at2 (mul n (.rate to))) down) (bytes_from_list (rev out)))))

; x with frames k up to n of b, from byte i in f, each as tc channels at
; k * tc; frame k of n is at byte i + (k - 1) * frame bytes.
(def pcm_frames_into ((x (array int)) (b bytes) (i int) (f PcmFormat) (tc int) (k int) (n int)) (array int)
  (if (gt k n)
      x
      (pcm_frames_into (pcm_chans_into x b (add i (mul (sub k 1) (pcm_frame_bytes f))) f tc (mul k tc) 0) b i f tc (add k 1) n)))

; x with the frame at byte i of b in f as tc channels from base.
(def pcm_chans_into ((x (array int)) (b bytes) (i int) (f PcmFormat) (tc int) (base int) (c int)) (array int)
  (if (ge c tc) x (pcm_chans_into (array_set x (add base c) (pcm_chan_of b i f tc c)) b i f tc base (add c 1))))

; Each output frame from at on, while the frame it falls on is among
; x's n + 1, and the next too if it falls between them, its tc channels
; pushed onto the reversed acc.
(def pcm_lerp ((x (array int)) (tc int) (n int) (from int) (to int) (at int) (acc (list int))) (list int)
  (if (pcm_lerp_past n to at)
      acc
      (pcm_lerp x tc n from to (add at from) (pcm_lerp_frame x tc (mul (div at to) tc) (mod at to) to 0 acc))))

; Whether an output frame at at needs a frame past n: it falls past the
; last, or between the last and the one after it.
(def pcm_lerp_past ((n int) (to int) (at int)) bool
  (let k (div at to)
    (or (gt k n) (and (eq k n) (not (eq (mod at to) 0))))))

; Where at ends up once every output frame x's n + 1 give is made.
(def pcm_lerp_end ((n int) (from int) (to int) (at int)) int
  (if (pcm_lerp_past n to at) at (pcm_lerp_end n from to (add at from))))

; Each channel from c of the frame at base of x, frac / to of the way to
; the next, pushed onto the reversed acc.
(def pcm_lerp_frame ((x (array int)) (tc int) (base int) (frac int) (to int) (c int) (acc (list int))) (list int)
  (if (ge c tc)
      acc
      (let (a (array_get x (add base c)) b (if (eq frac 0) 0 (array_get x (add (add base tc) c))))
        (pcm_lerp_frame x tc base frac to (add c 1) (pcm_push16 (if (eq frac 0) a (add a (div (mul (sub b a) frac) to))) acc)))))

; ------------------------------------------------------------------- mixing

; n samples of 16 bits: the sum of the first n of each of srcs, each at
; its volume of vols, in percent, a source short of n as silence past
; its end, each sum clamped. A frame is as many samples as channels.
(def pcm_mix ((srcs (list bytes)) (vols (list int)) (n int)) bytes
  (bytes_from_list (rev (pcm_mix_out (pcm_mix_into (array_new n 0) srcs vols) 0 (nil int)))))

; acc with each source of srcs added at its volume.
(def pcm_mix_into ((acc (array int)) (srcs (list bytes)) (vols (list int))) (array int)
  (if (is_empty srcs)
      acc
      (pcm_mix_into (pcm_mix_one acc (head srcs) (if (is_empty vols) 100 (head vols)) 0) (tail srcs) (if (is_empty vols) vols (tail vols)))))

; acc with b's samples from k on added at vol percent, as many as both
; hold.
(def pcm_mix_one ((acc (array int)) (b bytes) (vol int) (k int)) (array int)
  (if (or (ge k (array_len acc)) (gt (mul 2 (add k 1)) (bytes_len b)))
      acc
      (pcm_mix_one (array_set acc k (add (array_get acc k) (div (mul (pcm_sample16_at b (mul 2 k) 2) vol) 100))) b vol (add k 1))))

; acc's sums from k on, clamped, pushed onto the reversed out.
(def pcm_mix_out ((acc (array int)) (k int) (out (list int))) (list int)
  (if (ge k (array_len acc)) out (pcm_mix_out acc (add k 1) (pcm_push16 (array_get acc k) out))))

