; xml_test.l0 -- tests of the XML reader: elements, attributes,
; children, what is skipped, entities, and errors with their lines.

; A document read from a string, or its error as the root's name.
(def doc ((s (list int))) XmlEl
  (match (xml_parse (bytes_from_list s))
    ((Ok e) e)
    ((Err why) (XmlEl why (nil XmlAttr) (nil XmlEl)))))

; An element as text: its name, its attributes as name=value, and its
; children in brackets.
(def shown ((e XmlEl)) (list int)
  (append (xml_name e) (append (shown_attrs (xml_attrs e)) (shown_kids (xml_children e)))))

(def shown_attrs ((as (list XmlAttr))) (list int)
  (if (is_empty as)
      ""
      (match (head as) ((XmlAttr n v) (append " " (append n (append "=" (append v (shown_attrs (tail as))))))))))

(def shown_kids ((cs (list XmlEl))) (list int)
  (if (is_empty cs) "" (append " [" (append (shown (head cs)) (append "]" (shown_kids (tail cs)))))))

(def test_empty_element () int
  (check_str "svg" (shown (doc "<svg/>")) "svg"))

(def test_attributes () int
  (check_str "both quotes" (shown (doc "<svg width=\"16\" height='16'></svg>")) "svg width=16 height=16"))

(def test_children () int
  (check_str "nested" (shown (doc "<svg><g id=\"a\"><path d=\"M 0 0\"/></g><rect/></svg>"))
             "svg [g id=a [path d=M 0 0]] [rect]"))

; The prolog, a doctype with a subset, comments, text and CDATA go.
(def test_skipped () int
  (check_str "only elements"
    (shown (doc "<?xml version=\"1.0\"?>\n<!DOCTYPE svg [ <!ENTITY x \"y\"> ]>\n<!-- hi -->\n<svg>text<![CDATA[<no/>]]><!-- <no/> --><g/></svg>\n"))
    "svg [g]"))

(def test_spaces () int
  (check_str "around =" (shown (doc "<svg\n  a = \"1\"\n  b=\"2\" >\n</svg >")) "svg a=1 b=2"))

(def test_entities () int
  (check_str "replaced" (shown (doc "<t v=\"&lt;&amp;&gt;&quot;&apos;&#65;&#x42;&nope\"/>")) "t v=<&>\"'AB&nope"))

; A reference past ASCII is UTF-8: é is c3 a9.
(def test_utf8 () int
  (match (xml_attr (doc "<t v=\"&#233;\"/>") "v")
    ((Some v) (check_true "c3 a9" (eq v (cons 195 (cons 169 (nil int))))))
    ((None) (fail_because "v" "missing"))))

(def test_attr_lookup () int
  (add (check_true "has" (eq (xml_attr (doc "<t xlink:href=\"#a\"/>") "xlink:href") (Some "#a")))
       (check_true "has not" (eq (xml_attr (doc "<t/>") "href") ((None (list int)))))))

(def test_mismatched () int
  (check_str "why" (xml_name (doc "<svg>\n<g>\n</svg>")) "line 3: g ended by svg"))

(def test_unterminated () int
  (check_str "why" (xml_name (doc "<svg><g/>")) "line 1: no end to svg"))

(def test_no_quotes () int
  (check_str "why" (xml_name (doc "<svg a=1/>")) "line 1: a value with no quotes"))

(def test_trailing () int
  (check_str "why" (xml_name (doc "<a/><b/>")) "line 1: more after the root element"))
