; uac_test.l0 -- USB Audio Class 1.0's descriptors, read from a real
; device's: a Blue Yeti Nano's (Logitech 046d:0acf), its microphone and
; its speaker, as Linux's sysfs gave them.

; The bytes decimal words give.
(def nums ((s (list int))) (list int)
  (match (word_numbers (split_spaces s)) ((Some ns) ns) ((None) (nil int))))

; The Yeti Nano's configuration, all 232 bytes: an audio control
; interface (its microphone, 1, through feature unit 5 to USB streaming,
; 3; USB streaming, 2, through feature unit 6 to its speaker, 4), a
; streaming interface out, 1, and in, 2, each 2 channels of 24 bits in 3
; bytes at 44100 or 48000 Hz, and a HID interface, 3.
(def yeti () bytes
  (bytes_from_list (nums "9 2 232 0 4 1 0 192 49 9 4 0 0 0 1 1 0 0 10 36 1 0 1 72 0 2 1 2 12 36 2 2 1 1 0 2 3 0 0 0 10 36 6 6 2 1 3 0 0 0 9 36 3 4 1 3 0 6 0 12 36 2 1 1 2 0 2 3 0 0 0 10 36 6 5 1 1 3 0 0 0 9 36 3 3 1 1 0 5 0 9 4 1 0 0 1 2 0 0 9 4 1 1 1 1 2 0 0 7 36 1 2 1 1 0 14 36 2 1 2 3 24 2 68 172 0 128 187 0 9 5 1 1 32 1 1 0 0 7 37 1 1 0 0 0 9 4 2 0 0 1 2 0 0 9 4 2 1 1 1 2 0 0 7 36 1 3 1 1 0 14 36 2 1 2 3 24 2 68 172 0 128 187 0 9 5 130 1 38 1 1 0 0 7 37 1 1 0 0 0 9 4 3 0 2 3 0 0 0 9 33 17 1 0 1 34 172 0 7 5 131 3 64 0 10 7 5 3 3 64 0 10")))

; A unit as text: ID TYPE SOURCE.
(def unit_text ((u UacUnit)) (list int) (unwords (numbers_words (cons (.id u) (cons (.type u) (cons (.source u) (nil int)))))))

(def units_text ((us (list UacUnit))) (list int)
  (if (is_empty us) "" (append (unit_text (head us)) (if (is_empty (tail us)) "" (append "; " (units_text (tail us)))))))

; Its four terminals and two units, in order: microphone 1 (0x0201),
; feature 6 from 2, speaker 4 (0x0301) from 6, USB streaming 2 (0x0101),
; feature 5 from 1, USB streaming 3 from 5.
(def test_units () int
  (check_str "units" (units_text (.units (uac_of (yeti))))
    "2 257 -1; 6 0 2; 4 769 6; 1 513 -1; 5 0 1; 3 257 5"))

; A stream's numbers as text: interface, setting, endpoint, packet,
; link, channels, bytes and bits.
(def stream_text ((s UacStream)) (list int)
  (match s
    ((UacStream i a e m l c z b r)
      (unwords (numbers_words (cons i (cons a (cons e (cons m (cons l (cons c (cons z (cons b (nil int))))))))))))))

; Two streams, each a setting 1: out on interface 1, endpoint 0x01 of
; 288 bytes, linked to terminal 2; in on interface 2, endpoint 0x82 of
; 294, linked to terminal 3.
(def test_streams () int
  (let ss (.streams (uac_of (yeti)))
    (add (check_int "two" (length ss) 2)
         (add (check_str "out" (stream_text (head ss)) "1 1 1 288 2 2 3 24")
              (check_str "in" (stream_text (nth ss 1)) "2 1 130 294 3 2 3 24")))))

; What each is, by the terminal at its far end, as usb-audio lists it.
(def test_stream_text () int
  (let f (uac_of (yeti))
    (add (check_str "speaker" (uac_stream_text f (head (.streams f))) "out speaker 2 24 44100,48000")
         (check_str "microphone" (uac_stream_text f (nth (.streams f) 1)) "in microphone 2 24 44100,48000"))))

; A rate it takes is asked as it is; any other, its highest.
(def test_rate_for () int
  (let s (nth (.streams (uac_of (yeti))) 1)
    (add (check_int "48000" (uac_rate_for s 48000) 48000)
         (check_int "16000" (uac_rate_for s 16000) 48000))))

; SET_INTERFACE and SET_CUR's setups and the rate's bytes: 48000 is
; 0x00BB80.
(def test_requests () int
  (add (check_str "interface" (unwords (numbers_words (uac_set_interface 2 1))) "1 11 1 0 2 0 0 0")
       (add (check_str "rate" (unwords (numbers_words (uac_set_rate 130))) "34 1 0 1 130 0 3 0")
            (check_str "bytes" (unwords (numbers_words (uac_rate_bytes 48000))) "128 187 0"))))

; A configuration with no audio has no streams; a short one, nothing.
(def test_none () int
  (add (check_int "keyboard" (length (.streams (uac_of (bytes_from_list (nums "9 2 25 0 1 1 0 160 50 9 4 0 0 1 3 1 1 0 7 5 129 3 8 0 7"))))) 0)
       (check_int "short" (length (.units (uac_of (bytes_from_list (nums "9 2"))))) 0)))
