; json.l0 -- JSON (RFC 8259): values read in place from bytes, and
; written as bytes. A number that fits an int is JInt, any other (a
; fraction, an exponent, too big) JNum, its text as read, which
; json_float reads. A string is its bytes, UTF-8, escapes replaced. An
; object keeps its fields in the order read, so it is written back as it
; came; json_get finds a field by name, the first of that name. Reading
; refuses what RFC 8259 does not allow: a trailing comma, a leading zero,
; a single quote, a string with a control character in it or bytes that
; are not UTF-8, a lone surrogate, and nesting past json_depth_max.
; Writing is compact, with no spaces, and escapes in strings only what
; RFC 8259 requires: the quote, the backslash, and control characters.
; Pure, for the board and host tools alike.

; A value: null, true or false, a number that fits an int, any other
; number as its text, a string's bytes, an array's values, or an
; object's fields in order.
(data Json (JNull) (JBool bool) (JInt int) (JNum (list int)) (JStr bytes) (JArr (list Json)) (JObj (list JField)))

; An object's field: its name, as bytes, and its value.
(data JField (JField bytes Json))

; A value read, and the index in the bytes just after it.
(data JsonAt (JsonAt Json int))

; How deep arrays and objects may nest, one in another.
(def json_depth_max () int 64)

; ---------------------------------------------------------------- helpers

; The field of object o named name, the first if there are several; none
; if there is none, or o is not an object.
(def json_get ((o Json) (name (list int))) (Option Json)
  (match o
    ((JObj fs) (json_field_in fs name))
    ((JNull) ((None Json)))
    ((JBool x) ((None Json)))
    ((JInt n) ((None Json)))
    ((JNum t) ((None Json)))
    ((JStr s) ((None Json)))
    ((JArr xs) ((None Json)))))

; json_get's loop, through fs.
(def json_field_in ((fs (list JField)) (name (list int))) (Option Json)
  (if (is_empty fs)
      ((None Json))
      (match (head fs)
        ((JField k v)
          (if (if (eq (bytes_len k) (length name)) (bytes_is_at k 0 name) false)
              (Some v)
              (json_field_in (tail fs) name))))))

; Value i of array a, 0 the first; none past its end, or if a is not an
; array.
(def json_at ((a Json) (i int)) (Option Json)
  (let xs (json_items a)
    (if (if (lt i 0) true (ge i (length xs))) ((None Json)) (Some (nth xs i)))))

; An array's values; none if v is not an array.
(def json_items ((v Json)) (list Json)
  (match v
    ((JArr xs) xs)
    ((JNull) (nil Json))
    ((JBool x) (nil Json))
    ((JInt n) (nil Json))
    ((JNum t) (nil Json))
    ((JStr s) (nil Json))
    ((JObj fs) (nil Json))))

; An object's fields; none if v is not an object.
(def json_fields ((v Json)) (list JField)
  (match v
    ((JObj fs) fs)
    ((JNull) (nil JField))
    ((JBool x) (nil JField))
    ((JInt n) (nil JField))
    ((JNum t) (nil JField))
    ((JStr s) (nil JField))
    ((JArr xs) (nil JField))))

; A string's bytes; none if v is not a string.
(def json_text ((v Json)) (Option bytes)
  (match v
    ((JStr s) (Some s))
    ((JNull) ((None bytes)))
    ((JBool x) ((None bytes)))
    ((JInt n) ((None bytes)))
    ((JNum t) ((None bytes)))
    ((JArr xs) ((None bytes)))
    ((JObj fs) ((None bytes)))))

; A number that fits an int; none for any other value.
(def json_int ((v Json)) (Option int)
  (match v
    ((JInt n) (Some n))
    ((JNull) ((None int)))
    ((JBool x) ((None int)))
    ((JNum t) ((None int)))
    ((JStr s) ((None int)))
    ((JArr xs) ((None int)))
    ((JObj fs) ((None int)))))

; A boolean's value; none for any other value.
(def json_bool ((v Json)) (Option bool)
  (match v
    ((JBool x) (Some x))
    ((JNull) ((None bool)))
    ((JInt n) ((None bool)))
    ((JNum t) ((None bool)))
    ((JStr s) ((None bool)))
    ((JArr xs) ((None bool)))
    ((JObj fs) ((None bool)))))

; Any number as a float: a JNum's text read as json_number_float reads
; it; none for a value that is not a number.
(def json_float ((v Json)) (Option float)
  (match v
    ((JInt n) (Some (float_from_int n)))
    ((JNum t) (Some (json_number_float t)))
    ((JNull) ((None float)))
    ((JBool x) ((None float)))
    ((JStr s) ((None float)))
    ((JArr xs) ((None float)))
    ((JObj fs) ((None float)))))

; An object of fields, for writing: JObj, under a name that reads as
; what it is for.
(def json_obj ((fs (list JField))) Json (JObj fs))

; A field named name, a string literal, of value v.
(def json_field ((name (list int)) (v Json)) JField (JField (bytes_from_list name) v))

; A string value of the text s.
(def json_str ((s (list int))) Json (JStr (bytes_from_list s)))

; ---------------------------------------------------------------- numbers

; The float a number's text t gives: its significant digits, the first
; 19 of them, as an int, scaled by its power of ten through floats. It
; is the nearest float, or within an ulp or two of it when the scaling
; is not exact (more than 19 digits, or a power past 22).
(def json_number_float ((t (list int))) float
  (let neg (if (is_empty t) false (eq (head t) 45))
    (let r (if neg (tail t) t)
      (let m (json_mantissa r 0 0 0 false)
        (match m
          ((JMant v exp rest)
            (let e (add exp (json_exponent rest))
              (let f (json_scale (float_from_int v) e)
                (if neg (float_neg f) f)))))))))

; What json_mantissa reads: the digits' value, the power of ten it is
; to be scaled by so far, and the text after the digits (the exponent).
(data JMant (JMant int int (list int)))

; The digits of t, before and after a point, as an int of at most 19 of
; them, kept n; exp the power of ten for those dropped or after the point;
; frac whether the point has been passed.
(def json_mantissa ((t (list int)) (v int) (n int) (exp int) (frac bool)) JMant
  (if (is_empty t)
      (JMant v exp t)
      (let c (head t)
        (if (eq c 46)
            (json_mantissa (tail t) v n exp true)
            (if (if (ge c 48) (le c 57) false)
                (if (ge n 19)
                    (json_mantissa (tail t) v n (if frac exp (add exp 1)) frac)
                    (json_mantissa (tail t) (add (mul v 10) (sub c 48)) (if (eq v 0) (if (eq c 48) n (add n 1)) (add n 1)) (if frac (sub exp 1) exp) frac))
                (JMant v exp t))))))

; The exponent text e (as e, E, then a sign and digits) gives, 0 if none;
; bounded to plus or minus 9999, which is past any float.
(def json_exponent ((e (list int))) int
  (if (is_empty e)
      0
      (let r (tail e)
        (let neg (if (is_empty r) false (eq (head r) 45))
          (let ds (if (is_empty r) r (if (any_eq (head r) "+-") (tail r) r))
            (let x (json_exp_digits ds 0)
              (if neg (neg x) x)))))))

; The value of the digits ds, after acc, at most 9999.
(def json_exp_digits ((ds (list int)) (acc int)) int
  (if (is_empty ds) acc (json_exp_digits (tail ds) (min 9999 (add (mul acc 10) (sub (head ds) 48))))))

; x times ten to the e: by exact powers of ten up to 10^22 at a time.
(def json_scale ((x float) (e int)) float
  (if (eq e 0)
      x
      (if (gt e 0)
          (let k (min e 22) (json_scale (float_mul x (json_pow10 k)) (sub e k)))
          (let k (min (neg e) 22) (json_scale (float_div x (json_pow10 k)) (add e k))))))

; Ten to the k, k from 0 to 22, exactly.
(def json_pow10 ((k int)) float
  (if (eq k 0) 1.0 (float_mul 10.0 (json_pow10 (sub k 1)))))

; ---------------------------------------------------------------- reading

; How far a step of the reader got: a value and the index after it, or
; why not and where.
(data JStep (JGot Json int) (JBad (list int) int))

; A string read: its bytes and the index after its closing quote, or why
; not and where.
(data JStrStep (JSGot bytes int) (JSBad (list int) int))

; The value in the bytes of b from i up to j, after any white space: the
; value and the index just after it; or why not, as "at N: WHY", N
; counted from i.
(def json_read ((b bytes) (i int) (j int)) (Result JsonAt (list int))
  (match (json_value b (json_ws b i j) j 0)
    ((JGot v k) ((Ok JsonAt (list int)) (JsonAt v k)))
    ((JBad why at) ((Err JsonAt (list int)) (json_why i why at)))))

; The value the bytes of b from i up to j hold, white space around it,
; and nothing else; or why not, as json_read says it.
(def json_whole ((b bytes) (i int) (j int)) (Result Json (list int))
  (match (json_value b (json_ws b i j) j 0)
    ((JGot v k)
      (let e (json_ws b k j)
        (if (lt e j)
            ((Err Json (list int)) (json_why i "more after the value" e))
            ((Ok Json (list int)) v))))
    ((JBad why at) ((Err Json (list int)) (json_why i why at)))))

; why, at at, counted from i.
(def json_why ((i int) (why (list int)) (at int)) (list int)
  (append "at " (append (digits (sub at i)) (append ": " why))))

; Past white space (space, tab, newline, return) from i, up to j.
(def json_ws ((b bytes) (i int) (j int)) int
  (if (ge i j)
      i
      (let c (bytes_get b i)
        (if (if (eq c 32) true (if (eq c 10) true (if (eq c 13) true (eq c 9))))
            (json_ws b (add i 1) j)
            i))))

; The value at i, nested d deep.
(def json_value ((b bytes) (i int) (j int) (d int)) JStep
  (if (ge i j)
      (JBad "no value" i)
      (let c (bytes_get b i)
        (if (eq c 123) (json_object b i j d)
        (if (eq c 91) (json_array b i j d)
        (if (eq c 34) (json_str_value b i j)
        (if (eq c 116) (json_lit b i j "true" (JBool true))
        (if (eq c 102) (json_lit b i j "false" (JBool false))
        (if (eq c 110) (json_lit b i j "null" (JNull))
        (if (if (eq c 45) true (if (ge c 48) (le c 57) false)) (json_number b i j)
        (JBad "not a value" i)))))))))))

; The literal word at i, which is v.
(def json_lit ((b bytes) (i int) (j int) (word (list int)) (v Json)) JStep
  (if (if (le (add i (length word)) j) (bytes_is_at b i word) false)
      (JGot v (add i (length word)))
      (JBad "not a value" i)))

; A string at i, as a value.
(def json_str_value ((b bytes) (i int) (j int)) JStep
  (match (json_string b i j)
    ((JSGot s k) (JGot (JStr s) k))
    ((JSBad why at) (JBad why at))))

; ----------------------------------------------------------- arrays, objects

; The array at i, its [ there, nested d deep.
(def json_array ((b bytes) (i int) (j int) (d int)) JStep
  (if (ge d (json_depth_max))
      (JBad "nested too deep" i)
      (let k (json_ws b (add i 1) j)
        (if (if (lt k j) (eq (bytes_get b k) 93) false)
            (JGot (JArr (nil Json)) (add k 1))
            (json_items_from b k j (add d 1) (nil Json))))))

; The array's values from i, after acc, reversed.
(def json_items_from ((b bytes) (i int) (j int) (d int) (acc (list Json))) JStep
  (match (json_value b i j d)
    ((JBad why at) (JBad why at))
    ((JGot v k)
      (let e (json_ws b k j)
        (if (ge e j)
            (JBad "an array not closed" e)
            (let c (bytes_get b e)
              (if (eq c 44)
                  (json_items_from b (json_ws b (add e 1) j) j d (cons v acc))
                  (if (eq c 93)
                      (JGot (JArr (rev (cons v acc))) (add e 1))
                      (JBad "expected , or ] in an array" e)))))))))

; The object at i, its { there, nested d deep.
(def json_object ((b bytes) (i int) (j int) (d int)) JStep
  (if (ge d (json_depth_max))
      (JBad "nested too deep" i)
      (let k (json_ws b (add i 1) j)
        (if (if (lt k j) (eq (bytes_get b k) 125) false)
            (JGot (JObj (nil JField)) (add k 1))
            (json_fields_from b k j (add d 1) (nil JField))))))

; The object's fields from i, after acc, reversed.
(def json_fields_from ((b bytes) (i int) (j int) (d int) (acc (list JField))) JStep
  (if (if (lt i j) (not (eq (bytes_get b i) 34)) true)
      (JBad "expected a field's name" i)
      (match (json_string b i j)
        ((JSBad why at) (JBad why at))
        ((JSGot name k)
          (let c (json_ws b k j)
            (if (if (lt c j) (eq (bytes_get b c) 58) false)
                (match (json_value b (json_ws b (add c 1) j) j d)
                  ((JBad why at) (JBad why at))
                  ((JGot v m) (json_field_next b (json_ws b m j) j d (cons (JField name v) acc))))
                (JBad "expected : after a field's name" c)))))))

; After a field, at e: another, or the object's end.
(def json_field_next ((b bytes) (e int) (j int) (d int) (acc (list JField))) JStep
  (if (ge e j)
      (JBad "an object not closed" e)
      (let c (bytes_get b e)
        (if (eq c 44)
            (json_fields_from b (json_ws b (add e 1) j) j d acc)
            (if (eq c 125)
                (JGot (JObj (rev acc)) (add e 1))
                (JBad "expected , or } in an object" e))))))

; ------------------------------------------------------------------ strings

; The string at i, its quote there: its bytes, copied from b as they are
; if it has no escape, and otherwise made once from what they mean.
(def json_string ((b bytes) (i int) (j int)) JStrStep
  (json_str_plain b i (add i 1) j))

; The string begun at i, scanned from k while it has no escape.
(def json_str_plain ((b bytes) (i int) (k int) (j int)) JStrStep
  (if (ge k j)
      (JSBad "a string not closed" i)
      (let c (bytes_get b k)
        (if (eq c 34)
            (JSGot (bytes_slice b (add i 1) k) (add k 1))
            (if (eq c 92)
                (json_str_slow b i (add i 1) j (nil int))
                (let n (json_char_len b k j)
                  (if (gt n 0) (json_str_plain b i (add k n) j) (json_char_bad b k))))))))

; Why the character at k may not be in a string.
(def json_char_bad ((b bytes) (k int)) JStrStep
  (if (lt (bytes_get b k) 32)
      (JSBad "a control character in a string" k)
      (JSBad "not UTF-8" k)))

; How many bytes the character at k is, if it may be in a string as it
; is: 1 for one of ASCII but a control character, 2 to 4 for UTF-8's
; well-formed sequences (RFC 3629: no overlong form, no surrogate, none
; past U+10FFFF); 0 if it may not.
(def json_char_len ((b bytes) (k int) (j int)) int
  (let c (bytes_get b k)
    (if (lt c 32) 0
    (if (lt c 128) 1
    (if (lt c 194) 0
    (if (le c 223) (json_u8 b k j 128 191 2)
    (if (eq c 224) (json_u8 b k j 160 191 3)
    (if (eq c 237) (json_u8 b k j 128 159 3)
    (if (le c 239) (json_u8 b k j 128 191 3)
    (if (eq c 240) (json_u8 b k j 144 191 4)
    (if (le c 243) (json_u8 b k j 128 191 4)
    (if (eq c 244) (json_u8 b k j 128 143 4)
    0))))))))))))

; n, if the sequence of n bytes at k fits before j, its second byte is
; from lo to hi, and the rest are continuation bytes; 0 if not.
(def json_u8 ((b bytes) (k int) (j int) (lo int) (hi int) (n int)) int
  (if (gt (add k n) j)
      0
      (let s (bytes_get b (add k 1))
        (if (if (ge s lo) (le s hi) false)
            (if (json_conts b (add k 2) (add k n)) n 0)
            0))))

; Whether the bytes from k up to e are each 0x80 to 0xBF.
(def json_conts ((b bytes) (k int) (e int)) bool
  (if (ge k e)
      true
      (let c (bytes_get b k)
        (if (if (ge c 128) (le c 191) false) (json_conts b (add k 1) e) false))))

; The string begun at i, read from k into acc, reversed, escapes
; replaced; made bytes once at its end.
(def json_str_slow ((b bytes) (i int) (k int) (j int) (acc (list int))) JStrStep
  (if (ge k j)
      (JSBad "a string not closed" i)
      (let c (bytes_get b k)
        (if (eq c 34)
            (JSGot (bytes_from_list (rev acc)) (add k 1))
            (if (eq c 92)
                (json_escape b i k j acc)
                (let n (json_char_len b k j)
                  (if (gt n 0)
                      (json_str_slow b i (add k n) j (rev_onto (bytes_range b k (add k n)) acc))
                      (json_char_bad b k))))))))

; The escape at k, its backslash there, onto acc.
(def json_escape ((b bytes) (i int) (k int) (j int) (acc (list int))) JStrStep
  (if (ge (add k 1) j)
      (JSBad "a string not closed" i)
      (let e (bytes_get b (add k 1))
        (if (eq e 117)
            (json_unicode b i k j acc)
            (let r (json_escaped e)
              (if (lt r 0)
                  (JSBad "not an escape" k)
                  (json_str_slow b i (add k 2) j (cons r acc))))))))

; The byte the escape \e stands for, or -1 if it is not one: \" \\ \/ \b
; \f \n \r \t.
(def json_escaped ((e int)) int
  (if (eq e 34) 34
  (if (eq e 92) 92
  (if (eq e 47) 47
  (if (eq e 98) 8
  (if (eq e 102) 12
  (if (eq e 110) 10
  (if (eq e 114) 13
  (if (eq e 116) 9
  -1)))))))))

; The four hex digits at k as a number, or -1 if they are not.
(def json_hex4 ((b bytes) (k int) (j int)) int
  (if (gt (add k 4) j)
      -1
      (let a (hex_val (bytes_get b k))
        (let c (hex_val (bytes_get b (add k 1)))
          (let d (hex_val (bytes_get b (add k 2)))
            (let e (hex_val (bytes_get b (add k 3)))
              (if (lt (min (min a c) (min d e)) 0)
                  -1
                  (bit_or (bit_shl a 12) (bit_or (bit_shl c 8) (bit_or (bit_shl d 4) e))))))))))

; The escape \uXXXX at k: a character, or a surrogate pair's two
; escapes, as UTF-8 onto acc. A surrogate alone is refused.
(def json_unicode ((b bytes) (i int) (k int) (j int) (acc (list int))) JStrStep
  (let u (json_hex4 b (add k 2) j)
    (if (lt u 0)
        (JSBad "not four hex digits after \\u" k)
        (if (if (ge u 56320) (le u 57343) false)
            (JSBad "a lone surrogate" k)
            (if (if (ge u 55296) (le u 56319) false)
                (json_pair b i k j acc u)
                (json_str_slow b i (add k 6) j (rev_onto (json_utf8 u) acc)))))))

; The high surrogate hi at k, which the escape of a low one must follow.
(def json_pair ((b bytes) (i int) (k int) (j int) (acc (list int)) (hi int)) JStrStep
  (let lo (if (bytes_is_at b (add k 6) "\\u") (json_hex4 b (add k 8) j) -1)
    (if (if (ge lo 56320) (le lo 57343) false)
        (json_str_slow b i (add k 12) j
          (rev_onto (json_utf8 (add 65536 (bit_or (bit_shl (sub hi 55296) 10) (sub lo 56320)))) acc))
        (JSBad "a lone surrogate" k))))

; Code point u as UTF-8's bytes.
(def json_utf8 ((u int)) (list int)
  (if (lt u 128)
      (cons u (nil int))
      (if (lt u 2048)
          (cons (bit_or 192 (bit_shr u 6)) (cons (bit_or 128 (bit_and u 63)) (nil int)))
          (if (lt u 65536)
              (cons (bit_or 224 (bit_shr u 12)) (cons (bit_or 128 (bit_and (bit_shr u 6) 63)) (cons (bit_or 128 (bit_and u 63)) (nil int))))
              (cons (bit_or 240 (bit_shr u 18)) (cons (bit_or 128 (bit_and (bit_shr u 12) 63))
                (cons (bit_or 128 (bit_and (bit_shr u 6) 63)) (cons (bit_or 128 (bit_and u 63)) (nil int)))))))))

; ------------------------------------------------------------------ numbers

; The number at i: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?,
; a JInt if it is whole and fits, a JNum of its text if not.
(def json_number ((b bytes) (i int) (j int)) JStep
  (let s (if (eq (bytes_get b i) 45) (add i 1) i)
    (if (if (ge s j) true (not (json_digit b s)))
        (JBad "not a number" i)
        (let w (if (eq (bytes_get b s) 48) (add s 1) (json_digits_end b s j))
          (if (if (lt w j) (json_digit b w) false)
              (JBad "a number with a leading zero" i)
              (let f (json_frac_end b w j)
                (if (lt f 0)
                    (JBad "no digits after a number's point" w)
                    (let e (json_exp_end b f j)
                      (if (lt e 0)
                          (JBad "no digits in a number's exponent" f)
                          (JGot (json_num_of b i s w e) e))))))))))

; Whether byte k is a digit.
(def json_digit ((b bytes) (k int)) bool
  (let c (bytes_get b k) (if (ge c 48) (le c 57) false)))

; Past the digits from k, up to j.
(def json_digits_end ((b bytes) (k int) (j int)) int
  (if (if (lt k j) (json_digit b k) false) (json_digits_end b (add k 1) j) k))

; Past a fraction at k, if there is one; -1 if its point has no digits.
(def json_frac_end ((b bytes) (k int) (j int)) int
  (if (if (lt k j) (eq (bytes_get b k) 46) false)
      (let d (json_digits_end b (add k 1) j)
        (if (eq d (add k 1)) -1 d))
      k))

; Past an exponent at k, if there is one; -1 if it has no digits.
(def json_exp_end ((b bytes) (k int) (j int)) int
  (if (if (lt k j) (any_eq (bytes_get b k) "eE") false)
      (let s (if (if (lt (add k 1) j) (any_eq (bytes_get b (add k 1)) "+-") false) (add k 2) (add k 1))
        (let d (json_digits_end b s j)
          (if (eq d s) -1 d)))
      k))

; The number from i to e, its digits from s and its whole part ending at
; w: an int if it is whole (e is w) and fits, its text otherwise.
(def json_num_of ((b bytes) (i int) (s int) (w int) (e int)) Json
  (let neg (not (eq s i))
    (if (if (eq e w) (json_fits b s w neg) false)
        (JInt (json_whole_value b s w neg 0))
        (JNum (bytes_range b i e)))))

; Whether the digits from s to w fit an int, negative if neg: fewer than
; 19, or 19 no more than 9223372036854775807 (or ...808 below zero).
(def json_fits ((b bytes) (s int) (w int) (neg bool)) bool
  (let n (sub w s)
    (if (lt n 19)
        true
        (if (gt n 19)
            false
            (le (compare (bytes_range b s w) (if neg "9223372036854775808" "9223372036854775807")) 0)))))

; The value of the digits from k to w, counted below zero in acc so that
; the least int fits, and negated unless neg.
(def json_whole_value ((b bytes) (k int) (w int) (neg bool) (acc int)) int
  (if (ge k w)
      (if neg acc (neg acc))
      (json_whole_value b (add k 1) w neg (sub (mul acc 10) (sub (bytes_get b k) 48)))))

; ------------------------------------------------------------------ writing

; v as JSON's bytes, compact: built as pieces, reversed, and joined once.
(def json_bytes ((v Json)) bytes
  (bytes_concat (rev (json_put v (nil bytes)))))

; v's pieces onto acc, reversed.
(def json_put ((v Json) (acc (list bytes))) (list bytes)
  (match v
    ((JNull) (cons (bytes_from_list "null") acc))
    ((JBool x) (cons (bytes_from_list (if x "true" "false")) acc))
    ((JInt n) (cons (bytes_from_list (digits n)) acc))
    ((JNum t) (cons (bytes_from_list t) acc))
    ((JStr s) (json_put_str s acc))
    ((JArr xs) (cons (bytes_from_list "]") (json_put_items xs (cons (bytes_from_list "[") acc) true)))
    ((JObj fs) (cons (bytes_from_list "}") (json_put_fields fs (cons (bytes_from_list "{") acc) true)))))

; Each of xs onto acc, commas between; first if none is written yet.
(def json_put_items ((xs (list Json)) (acc (list bytes)) (first bool)) (list bytes)
  (if (is_empty xs)
      acc
      (let a (if first acc (cons (bytes_from_list ",") acc))
        (json_put_items (tail xs) (json_put (head xs) a) false))))

; Each of fs onto acc, "name":value, commas between.
(def json_put_fields ((fs (list JField)) (acc (list bytes)) (first bool)) (list bytes)
  (if (is_empty fs)
      acc
      (let a (if first acc (cons (bytes_from_list ",") acc))
        (match (head fs)
          ((JField k v)
            (json_put_fields (tail fs) (json_put v (cons (bytes_from_list ":") (json_put_str k a))) false))))))

; The string s, quoted, escaped, onto acc: s itself if it needs no
; escape, and otherwise its runs between escapes, with each escape.
(def json_put_str ((s bytes) (acc (list bytes))) (list bytes)
  (cons (bytes_from_list "\"") (json_str_runs s 0 0 (cons (bytes_from_list "\"") acc))))

; The run of s from start to k and on, onto acc: each byte that must be
; escaped ends a run.
(def json_str_runs ((s bytes) (start int) (k int) (acc (list bytes))) (list bytes)
  (if (ge k (bytes_len s))
      (if (eq start 0)
          (cons s acc)
          (if (lt start k) (cons (bytes_slice s start k) acc) acc))
      (let c (bytes_get s k)
        (if (if (lt c 32) true (if (eq c 34) true (eq c 92)))
            (let a (if (lt start k) (cons (bytes_slice s start k) acc) acc)
              (json_str_runs s (add k 1) (add k 1) (cons (bytes_from_list (json_escape_of c)) a)))
            (json_str_runs s start (add k 1) acc)))))

; The escape that writes byte c in a string: \" \\ \b \f \n \r \t, and
; \u00XX for any other control character.
(def json_escape_of ((c int)) (list int)
  (if (eq c 34) "\\\""
  (if (eq c 92) "\\\\"
  (if (eq c 8) "\\b"
  (if (eq c 12) "\\f"
  (if (eq c 10) "\\n"
  (if (eq c 13) "\\r"
  (if (eq c 9) "\\t"
  (append "\\u00" (hex_digits c 2))))))))))
