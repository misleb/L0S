(def bytes_text ((bs (list int))) (list int)
  (if (is_empty bs) "" (append (digits (head bs)) (append " " (bytes_text (tail bs))))))

(def sample () Uuid
  (match (uuid_of_text "C12A7328-F81F-11D2-BA4B-00A0C93EC93B") ((Some u) u) ((None) (uuid_nil))))

; ------------------------------------------------------------------- text

(def test_text_round_trip () int
  (add (check_str "lower case, dashed" (uuid_text (sample)) "c12a7328-f81f-11d2-ba4b-00a0c93ec93b")
       (check_str "nil" (uuid_text (uuid_nil)) "00000000-0000-0000-0000-000000000000")))

(def test_text_refused () int
  (add (check_bool "short" (eq (uuid_of_text "c12a7328-f81f-11d2-ba4b") ((None Uuid))) true)
       (add (check_bool "a dash out of place" (eq (uuid_of_text "c12a7328f-81f-11d2-ba4b-00a0c93ec93b") ((None Uuid))) true)
            (check_bool "not hex" (eq (uuid_of_text "g12a7328-f81f-11d2-ba4b-00a0c93ec93b") ((None Uuid))) true))))

(def test_fields () int
  (add (check_int "version 1, the EFI system partition's" (uuid_version (sample)) 1)
       (check_int "RFC 9562's variant" (uuid_variant (sample)) 2)))

; ------------------------------------------------------------------ GUIDs

; The EFI system partition's type, as GPT keeps it: 28 73 2A C1, 1F F8,
; D2 11, then BA 4B 00 A0 C9 3E C9 3B.
(def test_guid_order () int
  (check_str "the first three fields turned"
    (bytes_text (uuid_guid_bytes (sample)))
    "40 115 42 193 31 248 210 17 186 75 0 160 201 62 201 59 "))

(def test_guid_round_trip () int
  (check_bool "read back from its GPT bytes"
    (eq (uuid_of_guid (bytes_from_list (append (cons 9 (nil int)) (uuid_guid_bytes (sample)))) 1) (sample)) true))

; -------------------------------------------------------------- version 7

(def made () Uuid (uuid_v7 1760000000123 (uuid_noise 5 10)))

(def test_v7_fields () int
  (add (check_int "version 7" (uuid_version (made)) 7)
       (add (check_int "RFC 9562's variant" (uuid_variant (made)) 2)
            (check_int "its time" (uuid_v7_ms (made)) 1760000000123))))

; 1760000000123 is 0199 C82C C07B: the first six bytes.
(def test_v7_time_first () int
  (check_str "milliseconds, most significant first" (take (uuid_text (made)) 13) "0199c82c-c07b"))

; Made in order of time, they sort in it too, by their bytes.
(def test_v7_sorts () int
  (check_bool "earlier first"
    (lt (compare (uuid_bytes (uuid_v7 1000 (uuid_noise 9 10))) (uuid_bytes (uuid_v7 1001 (uuid_noise 1 10)))) 0) true))

; ------------------------------------------------------------------ noise

; splitmix64 from 0: its first number is e220a8397b1dcdaf.
(def test_noise_known () int
  (check_str "the first eight" (bytes_text (uuid_noise 0 8)) "226 32 168 57 123 29 205 175 "))

(def test_noise_repeats () int
  (add (check_bool "the same seed" (eq (uuid_noise 42 10) (uuid_noise 42 10)) true)
       (add (check_bool "another" (eq (uuid_noise 42 10) (uuid_noise 43 10)) false)
            (check_int "as many as asked" (length (uuid_noise 7 10)) 10))))

; Two made at once, with different salts, differ.
(def test_new_differ () int
  (check_bool "two" (eq (uuid_new 1760000000000 1) (uuid_new 1760000000000 2)) false))
