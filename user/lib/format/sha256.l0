; sha256.l0 -- SHA-256, as FIPS 180-4 defines it, over a range of bytes:
; the Pi 5's bootloader checks an EEPROM update by it (eeprom). Pure,
; linked by the Makefile's SHA256.

; The first 32 bits of the fractional parts of the square roots of the
; first 8 primes: the hash's start (FIPS 180-4, 5.3.3).
(def sha256_start () (array int)
  (sha256_words "1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225"))

; The first 32 bits of the fractional parts of the cube roots of the
; first 64 primes: the rounds' constants (FIPS 180-4, 4.2.2).
(def sha256_k () (array int)
  (sha256_words (append "1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 "
                            "666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298")))

; The numbers of s, decimal words, as an array.
(def sha256_words ((s (list int))) (array int)
  (match (word_numbers (split_spaces s))
    ((None) (array_new 0 0))
    ((Some ns) (array_from ns 0))))

; x kept to 32 bits.
(def sha256_32 ((x int)) int (bit_and x 4294967295))

; x, 32 bits, rotated right by n.
(def sha256_rotr ((x int) (n int)) int
  (sha256_32 (bit_or (bit_shr x n) (bit_shl x (sub 32 n)))))

; The 32-bit word at byte i of b, most significant byte first.
(def sha256_be32 ((b bytes) (i int)) int
  (bit_or (bit_shl (bytes_get b i) 24)
    (bit_or (bit_shl (bytes_get b (add i 1)) 16)
      (bit_or (bit_shl (bytes_get b (add i 2)) 8) (bytes_get b (add i 3))))))

; ------------------------------------------------------------- hashing

; The SHA-256 of the bytes of b from i up to j, its 32 bytes.
(def sha256 ((b bytes) (i int) (j int)) bytes
  (let (n (sub j i)
        full (add i (mul (div n 64) 64))
        h (sha256_blocks (sha256_k) (array_new 64 0) (sha256_start) b i full)
        last (sha256_last b full j n))
    (sha256_digest (sha256_blocks (sha256_k) (array_new 64 0) h last 0 (bytes_len last)))))

; The SHA-256 of the bytes of b from i up to j, as 64 lowercase hex
; digits.
(def sha256_hex ((b bytes) (i int) (j int)) (list int)
  (let d (sha256 b i j)
    (sha256_hex_from d 0 (nil int))))

; The bytes of d from i on in hex, after the reversed acc.
(def sha256_hex_from ((d bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len d))
      (rev acc)
      (sha256_hex_from d (add i 1) (push (hex_digits (bytes_get d i) 2) acc))))

; The last one or two blocks: the bytes of b from i up to j, fewer than
; 64, then 0x80, zeros, and the message's length n in bits as 8 bytes,
; most significant first, to a multiple of 64 bytes.
(def sha256_last ((b bytes) (i int) (j int) (n int)) bytes
  (let (k (sub j i)
        total (if (lt k 56) 64 128)
        tail (bytes_to_list (bytes_slice b i j))
        zeros (sub total (add k 9)))
    (bytes_from_list (append tail (cons 128 (append (sha256_zeros zeros (nil int)) (sha256_length (mul n 8) 8 (nil int))))))))

; n zeros, after acc.
(def sha256_zeros ((n int) (acc (list int))) (list int)
  (if (le n 0) acc (sha256_zeros (sub n 1) (cons 0 acc))))

; The low k bytes of x, most significant first, before acc.
(def sha256_length ((x int) (k int) (acc (list int))) (list int)
  (if (le k 0) acc (sha256_length (bit_shr x 8) (sub k 1) (cons (bit_and x 255) acc))))

; h, the hash so far, after the 64-byte blocks of b from i up to j; w is
; the message schedule's room, kt the constants.
(def sha256_blocks ((kt (array int)) (w (array int)) (h (array int)) (b bytes) (i int) (j int)) (array int)
  (if (ge i j)
      h
      (let (w1 (sha256_schedule (sha256_load w b i 0) 16)
            h1 (sha256_block kt w1 h))
        (sha256_blocks kt w1 h1 b (add i 64) j))))

; w with its first 16 words the block at byte i of b, from word t on.
(def sha256_load ((w (array int)) (b bytes) (i int) (t int)) (array int)
  (if (ge t 16)
      w
      (sha256_load (array_set w t (sha256_be32 b (add i (mul t 4)))) b i (add t 1))))

; w with its words from t up to 64 made from those before (FIPS 180-4,
; 6.2.2, step 1).
(def sha256_schedule ((w (array int)) (t int)) (array int)
  (if (ge t 64)
      w
      (let (a (array_get w (sub t 2))
            c (array_get w (sub t 7))
            d (array_get w (sub t 15))
            e (array_get w (sub t 16))
            s1 (bit_xor (sha256_rotr a 17) (bit_xor (sha256_rotr a 19) (bit_shr a 10)))
            s0 (bit_xor (sha256_rotr d 7) (bit_xor (sha256_rotr d 18) (bit_shr d 3))))
        (sha256_schedule (array_set w t (sha256_32 (add (add s1 c) (add s0 e)))) (add t 1)))))

; h after one block, whose schedule is w.
(def sha256_block ((kt (array int)) (w (array int)) (h (array int))) (array int)
  (let (a (array_get h 0)
        b (array_get h 1)
        c (array_get h 2)
        d (array_get h 3)
        e (array_get h 4)
        f (array_get h 5)
        g (array_get h 6)
        hh (array_get h 7))
    (sha256_rounds kt w h 0 a b c d e f g hh)))

; The rounds from t on, the working variables a to hh; at the end, each
; added into h.
(def sha256_rounds ((kt (array int)) (w (array int)) (h (array int)) (t int)
                    (a int) (b int) (c int) (d int) (e int) (f int) (g int) (hh int)) (array int)
  (if (ge t 64)
      (sha256_added h a b c d e f g hh)
      (let (s1 (bit_xor (sha256_rotr e 6) (bit_xor (sha256_rotr e 11) (sha256_rotr e 25)))
            ch (bit_xor (bit_and e f) (bit_and (bit_xor e 4294967295) g))
            t1 (sha256_32 (add (add hh s1) (add ch (add (array_get kt t) (array_get w t)))))
            s0 (bit_xor (sha256_rotr a 2) (bit_xor (sha256_rotr a 13) (sha256_rotr a 22)))
            maj (bit_xor (bit_and a b) (bit_xor (bit_and a c) (bit_and b c)))
            t2 (sha256_32 (add s0 maj)))
        (sha256_rounds kt w h (add t 1) (sha256_32 (add t1 t2)) a b c (sha256_32 (add d t1)) e f g))))

; h with a to hh added to its words, each kept to 32 bits.
(def sha256_added ((h (array int)) (a int) (b int) (c int) (d int) (e int) (f int) (g int) (hh int)) (array int)
  (let v (array_from (cons a (cons b (cons c (cons d (cons e (cons f (cons g (cons hh (nil int))))))))) 0)
    (sha256_add_from h v 0)))

; h with v's words from i on added to its own.
(def sha256_add_from ((h (array int)) (v (array int)) (i int)) (array int)
  (if (ge i 8)
      h
      (let x (array_get h i)
        (sha256_add_from (array_set h i (sha256_32 (add x (array_get v i)))) v (add i 1)))))

; The 32 bytes of h's eight words, each most significant byte first.
(def sha256_digest ((h (array int))) bytes
  (bytes_from_list (sha256_digest_from h 7 (nil int))))

; The bytes of h's words up to i, before acc.
(def sha256_digest_from ((h (array int)) (i int) (acc (list int))) (list int)
  (if (lt i 0)
      acc
      (sha256_digest_from h (sub i 1) (sha256_length (array_get h i) 4 acc))))
