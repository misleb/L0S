; crc32.l0 -- CRC-32, as zlib, PNG and GPT reckon it: the reflected
; polynomial EDB88320, from all ones, turned over at the end. GPT checks
; its header and its entries by it.

; The table of the CRC of each byte alone, made once a call.
(def crc32_table () (array int)
  (crc32_fill (array_new 256 0) 0))

; t with each byte's CRC from n on.
(def crc32_fill ((t (array int)) (n int)) (array int)
  (if (eq n 256) t (crc32_fill (array_set t n (crc32_bits n 8)) (add n 1))))

; c shifted k times, the polynomial in wherever a 1 falls out.
(def crc32_bits ((c int) (k int)) int
  (if (eq k 0)
      c
      (crc32_bits (if (eq (bit_and c 1) 1) (bit_xor (bit_shr c 1) 3988292384) (bit_shr c 1)) (sub k 1))))

; The CRC-32 of the bytes of b from i up to j.
(def crc32 ((b bytes) (i int) (j int)) int
  (bit_xor (crc32_from (crc32_table) b i j 4294967295) 4294967295))

; c, the CRC so far, after the bytes of b from i up to j.
(def crc32_from ((t (array int)) (b bytes) (i int) (j int) (c int)) int
  (if (ge i j)
      c
      (crc32_from t b (add i 1) j
                  (bit_xor (array_get t (bit_and (bit_xor c (bytes_get b i)) 255)) (bit_shr c 8)))))

; The CRC-32 of the bytes of b from i up to j, the n from z on taken as
; zeros: as a header that holds its own CRC is checked, the CRC's place
; zeroed, without copying the header to zero it.
(def crc32_zeroed ((b bytes) (i int) (j int) (z int) (n int)) int
  (bit_xor (crc32_zeroed_from (crc32_table) b i j z (add z n) 4294967295) 4294967295))

; crc32_from, with the bytes from z up to ze taken as zeros.
(def crc32_zeroed_from ((t (array int)) (b bytes) (i int) (j int) (z int) (ze int) (c int)) int
  (if (ge i j)
      c
      (let x (if (and (ge i z) (lt i ze)) 0 (bytes_get b i))
        (crc32_zeroed_from t b (add i 1) j z ze
                           (bit_xor (array_get t (bit_and (bit_xor c x) 255)) (bit_shr c 8))))))

; The CRC-32 of a list of bytes.
(def crc32_list ((xs (list int))) int
  (let b (bytes_from_list xs) (crc32 b 0 (bytes_len b))))
