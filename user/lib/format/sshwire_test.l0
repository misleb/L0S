; sshwire_test.l0 -- SSH's data types: RFC 4251 5's mpint examples, and
; strings, numbers and name-lists read back from what was built, and
; refused when they run past their end.

; The bytes of b in lowercase hex.
(def sw_hex ((b bytes)) (list int)
  (sw_hex_from b 0 (nil int)))

; The bytes of b from i on in hex, after the reversed acc.
(def sw_hex_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b))
      (rev acc)
      (sw_hex_from b (add i 1) (push (hex_digits (bytes_get b i) 2) acc))))

; The bytes listed.
(def sw_bytes ((xs (list int))) bytes (bytes_from_list xs))

; ------------------------------------------------------------- building

; RFC 4251 5: 0 is the empty string; 9a378f9b2e332a7 as is; 80 with a
; zero before it.
(def test_ssh_mpint_examples () int
  (add (check_str "0" (sw_hex (ssh_w_mpint (sw_bytes (cons 0 (nil int))))) "00000000")
       (add (check_str "9a37..." (sw_hex (ssh_w_mpint (bn_hex "09a378f9b2e332a7"))) "0000000809a378f9b2e332a7")
            (check_str "80" (sw_hex (ssh_w_mpint (sw_bytes (cons 128 (nil int))))) "000000020080"))))

; Leading zeros are dropped before the sign is looked at.
(def test_ssh_mpint_leading_zeros () int
  (check_str "00 00 7f" (sw_hex (ssh_w_mpint (sw_bytes (cons 0 (cons 0 (cons 127 (nil int))))))) "000000017f"))

(def test_ssh_string_and_names () int
  (add (check_str "string" (sw_hex (ssh_w_text "ssh")) "00000003737368")
       (check_str "names" (sw_hex (ssh_w_names (cons "a" (cons "bc" (nil (list int)))))) "00000004612c6263")))

(def test_ssh_u64 () int
  (check_str "u64" (sw_hex (ssh_w_u64 4294967298)) "0000000100000002"))

; ------------------------------------------------------------- reading

; A string and a uint32 after it, read back in place.
(def test_ssh_read_back () int
  (let b (ssh_join (cons (ssh_w_text "hello") (cons (ssh_w_u32 3000000000) (nil bytes))))
    (match (ssh_string_at b 0 (bytes_len b))
      ((None) (fail_because "string" "refused"))
      ((Some f)
        (add (check_str "text" (ssh_field_text b f) "hello")
             (match (ssh_u32_at b (.next f) (bytes_len b))
               ((None) (fail_because "u32" "refused"))
               ((Some n) (check_int "u32" (.value n) 3000000000))))))))

; A string whose length runs past the end is refused.
(def test_ssh_string_too_long () int
  (let b (ssh_w_text "hello")
    (match (ssh_string_at b 0 8)
      ((None) (pass "refused"))
      ((Some f) (fail_because "refused" "read past its end")))))

; A name-list read as names; an empty one is none.
(def test_ssh_names_read () int
  (let b (ssh_join (cons (ssh_w_names (cons "x" (cons "y" (nil (list int))))) (cons (ssh_w_text "") (nil bytes))))
    (match (ssh_string_at b 0 (bytes_len b))
      ((None) (fail_because "names" "refused"))
      ((Some f)
        (add (check_strs "names" (ssh_field_names b f) (cons "x" (cons "y" (nil (list int)))))
             (match (ssh_string_at b (.next f) (bytes_len b))
               ((None) (fail_because "empty" "refused"))
               ((Some g) (check_int "empty" (length (ssh_field_names b g)) 0))))))))

(def test_ssh_field_is () int
  (let b (ssh_w_text "none")
    (match (ssh_string_at b 0 (bytes_len b))
      ((None) (fail_because "is" "refused"))
      ((Some f) (add (check_true "none" (ssh_field_is b f "none")) (check_bool "non" (ssh_field_is b f "non") false))))))
