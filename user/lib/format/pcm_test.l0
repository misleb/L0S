; pcm_test.l0 -- the filter, a microphone's frames brought down to 16
; kHz, and 16 kHz taken up to 48 kHz.

; The taps: 63 of them, summing to 65536, the same read both ways.
(def test_taps () int
  (let t (pcm_taps)
    (add (check_int "63" (array_len t) 63)
         (add (check_int "sum" (pcm_sum (array_to_list t) 0) 65536)
              (check_int "symmetric" (array_get t 3) (array_get t 59))))))

(def pcm_sum ((xs (list int)) (acc int)) int (if (is_empty xs) acc (pcm_sum (tail xs) (add acc (head xs)))))

; A 24-bit sample's top two bytes: 0x7FFFFF is 32767, 0x800000 -32768,
; 0x000100 1; a 16-bit one as it is, 0xFFFE -2.
(def test_sample16 () int
  (add (check_int "24 top" (pcm_sample16_at (bytes_from_list (cons 255 (cons 255 (cons 127 (nil int))))) 0 3) 32767)
       (add (check_int "24 bottom" (pcm_sample16_at (bytes_from_list (cons 0 (cons 0 (cons 128 (nil int))))) 0 3) -32768)
            (add (check_int "24 one" (pcm_sample16_at (bytes_from_list (cons 0 (cons 1 (cons 0 (nil int))))) 0 3) 1)
                 (check_int "16" (pcm_sample16_at (bytes_from_list (cons 254 (cons 255 (nil int)))) 0 2) -2)))))

; A stereo frame of 24 bits, 100 and 300 in its top bytes: 200.
(def test_mono () int
  (check_int "mean" (pcm_mono_at (frames24 (cons 100 (cons 300 (nil int)))) 0 2 3) 200))

; The samples xs, each as 24 bits with v in its top two bytes.
(def frames24 ((xs (list int))) bytes (bytes_from_list (rev (frames24_onto xs (nil int)))))
(def frames24_onto ((xs (list int)) (acc (list int))) (list int)
  (if (is_empty xs)
      acc
      (let u (bit_and (head xs) 65535)
        (frames24_onto (tail xs) (cons (bit_shr u 8) (cons (bit_and u 255) (cons 0 acc)))))))

; The 16-bit samples of b, from byte i, as a list.
(def samples16 ((b bytes)) (list int) (samples16_from b (sub (bytes_len b) 2) (nil int)))
(def samples16_from ((b bytes) (i int) (acc (list int))) (list int)
  (if (lt i 0) acc (samples16_from b (sub i 2) (cons (pcm_sample16_at b i 2) acc))))

; n copies of x.
(def copies ((n int) (x int)) (list int) (repeat n x))

; 300 stereo frames of 1000 are 100 samples at 16 kHz; once the filter
; has passed the silence before them, 21 samples in, each 1000.
(def test_down_level () int
  (let (d (pcm_down (pcm_down_new) (frames24 (copies 600 1000)) 0 1800 2 3)
        xs (samples16 (.out d)))
    (add (check_int "100" (length xs) 100)
         (add (check_int "settled" (nth xs 50) 1000)
              (check_int "last" (nth xs 99) 1000)))))

; The first sample kept is the filter centred 31 samples before the
; first: of 1000s after silence, that is the sum of the newest tap
; alone, -7 / 65536 of 1000, 0.
(def test_down_first () int
  (check_int "first" (head (samples16 (.out (pcm_down (pcm_down_new) (frames24 (copies 6 1000)) 0 18 2 3)))) 0))

; A tone of amplitude 10000 at freq Hz, n frames of one channel at 48
; kHz, as 16-bit samples.
(def tone16 ((freq int) (n int)) bytes (bytes_from_list (rev (tone_onto freq 0 n (nil int)))))
(def tone_onto ((freq int) (k int) (n int) (acc (list int))) (list int)
  (if (ge k n)
      acc
      (tone_onto freq (add k 1) n (pcm_push16 (tone_at freq k) acc))))
(def tone_at ((freq int) (k int)) int
  (float_to_int (float_mul 10000.0 (float_sin (float_div (float_mul 6.283185307179586 (float_from_int (mul freq k))) 48000.0)))))

; The largest magnitude among xs from the 30th on, past the filter's
; start.
(def peak ((xs (list int))) int (peak_of (drop xs 30) 0))
(def peak_of ((xs (list int)) (m int)) int (if (is_empty xs) m (peak_of (tail xs) (max m (max (head xs) (neg (head xs)))))))

; 1 kHz passes whole: its peak 9750 to 10100, since samples at 16 kHz,
; 22.5 degrees of it apart, may each miss its top by up to 11.25
; degrees, 2%.
(def test_down_passes () int
  (let p (peak (samples16 (.out (pcm_down (pcm_down_new) (tone16 1000 4800) 0 9600 1 2))))
    (check_true "1 kHz kept" (and (gt p 9750) (lt p 10100)))))

; 12 kHz, past 8 kHz, would fold to 4 kHz: the filter leaves under 0.2%
; of it (58 dB less from 9 kHz).
(def test_down_stops () int
  (let p (peak (samples16 (.out (pcm_down (pcm_down_new) (tone16 12000 4800) 0 9600 1 2))))
    (check_true "12 kHz gone" (lt p 20))))

; Pieces give what the whole gives: the frames cut at seeded places, each
; piece brought down after the last, their samples joined.
(def test_down_pieces () int
  (let b (tone16 1000 3001)
    (check_int "same" (pieces_differ b 1 20) 0)))

; How many of n seeded cuttings of b differ from the whole, from seed s.
(def pieces_differ ((b bytes) (s int) (n int)) int
  (if (eq n 0)
      0
      (let (whole (.out (pcm_down (pcm_down_new) b 0 (bytes_len b) 1 2))
            cut (in_pieces b (pcm_down_new) 0 s (nil bytes)))
        (add (if (eq (bytes_to_list whole) (bytes_to_list cut)) 0 1) (pieces_differ b (rand_next (rand_next s)) (sub n 1))))))

; b from byte i in pieces of 1 to 400 frames, seeded by s, after st.
(def in_pieces ((b bytes) (st PcmDown) (i int) (s int) (acc (list bytes))) bytes
  (if (ge i (bytes_len b))
      (bytes_concat (rev acc))
      (let (j (min (bytes_len b) (add i (mul 2 (add 1 (rand_below s 400)))))
            d (pcm_down st b i j 1 2))
        (in_pieces b (.st d) j (rand_next s) (cons (.out d) acc)))))

; ------------------------------------------------------------- converting

; n 16-bit samples of v, as bytes.
(def level16 ((n int) (v int)) bytes (bytes_from_list (rev (level_onto n v (nil int)))))
(def level_onto ((n int) (v int) (acc (list int))) (list int) (if (eq n 0) acc (level_onto (sub n 1) v (pcm_push16 v acc))))

; The samples of b from byte i up to j converted whole, from one format
; to another, as a list.
(def converted ((from PcmFormat) (to PcmFormat) (b bytes)) (list int)
  (samples16 (.out (pcm_convert (pcm_conv_new from to) b 0 (bytes_len b)))))

; A format of 1 to 8 channels, 2 to 4 bytes, 8 to 192 kHz; not 7 kHz,
; 9 channels, 8-bit samples.
(def test_format_ok () int
  (add (check_bool "yeti" (pcm_format_ok (PcmFormat 48000 2 3)) true)
       (add (check_bool "7 kHz" (pcm_format_ok (PcmFormat 7000 1 2)) false)
            (check_bool "8 bits" (pcm_format_ok (PcmFormat 48000 1 1)) false))))

; The same rate and channels: the frames as they are, 24 bits as their
; top 16.
(def test_convert_same () int
  (check_strs "same" (numbers_words (converted (PcmFormat 48000 2 3) (pcm_format16 48000 2) (frames24 (cons 100 (cons 300 (cons -5 (cons 7 (nil int))))))))
              (split_spaces "100 300 -5 7")))

; Stereo to mono is each frame's mean; mono to stereo its sample twice.
(def test_convert_channels () int
  (add (check_strs "mono" (numbers_words (converted (PcmFormat 48000 2 3) (pcm_format16 48000 1) (frames24 (cons 100 (cons 300 (nil int)))))) (split_spaces "200"))
       (check_strs "stereo" (numbers_words (converted (PcmFormat 16000 1 2) (pcm_format16 16000 2) (level16 2 9))) (split_spaces "9 9 9 9"))))

; 16 kHz to 48 kHz: three frames an input frame, each a third of the way
; to the next: 0 to 300 gives 0, 100, 200, 300, and the two between 300
; and the frame after it wait for the next piece.
(def test_convert_up () int
  (let b (bytes_from_list (rev (pcm_push16 300 (pcm_push16 0 (nil int)))))
    (check_strs "lerp" (numbers_words (converted (PcmFormat 16000 1 2) (pcm_format16 48000 1) b)) (split_spaces "0 100 200 300"))))

; 22,050 Hz to 44,100: every input frame and its mean with the next, as
; speak doubled its voice: 4 frames give 7 samples, the mean after the
; last waiting for the next piece.
(def test_convert_double () int
  (let b (bytes_from_list (rev (pcm_push16 40 (pcm_push16 30 (pcm_push16 20 (pcm_push16 10 (nil int)))))))
    (check_strs "doubled" (numbers_words (converted (PcmFormat 22050 1 2) (pcm_format16 44100 1) b)) (split_spaces "10 15 20 25 30 35 40"))))

; In pieces, the frames between come with the next piece: 0 and 300,
; then 600, give 0, 100, 200, 300, then 400, 500, 600.
(def test_convert_up_pieces () int
  (let (c (pcm_convert (pcm_conv_new (PcmFormat 16000 1 2) (pcm_format16 48000 1)) (level16 2 0) 0 4)
        d (pcm_convert (.st c) (level16 1 600) 0 2))
    (check_strs "next" (numbers_words (samples16 (.out d))) (split_spaces "200 400 600"))))

; 48 kHz to 16 kHz goes through the filter: 300 frames of 1000, as
; pcm_down gives them, 100 samples settling at 1000.
(def test_convert_filtered () int
  (let xs (converted (PcmFormat 48000 2 3) (pcm_format16 16000 1) (frames24 (copies 600 1000)))
    (add (check_int "100" (length xs) 100) (check_int "settled" (nth xs 50) 1000))))

; Pieces give what the whole gives, by interpolation: a 1 kHz tone at
; 48 kHz to 44.1 kHz, cut at seeded places.
(def test_convert_pieces () int
  (let b (tone16 1000 3001)
    (check_int "same" (conv_pieces_differ b 1 20) 0)))

; How many of n seeded cuttings of b differ from the whole, from seed s.
(def conv_pieces_differ ((b bytes) (s int) (n int)) int
  (if (eq n 0)
      0
      (let (whole (.out (pcm_convert (conv48_44) b 0 (bytes_len b)))
            cut (conv_in_pieces b (conv48_44) 0 s (nil bytes)))
        (add (if (eq (bytes_to_list whole) (bytes_to_list cut)) 0 1) (conv_pieces_differ b (rand_next (rand_next s)) (sub n 1))))))
(def conv48_44 () PcmConv (pcm_conv_new (PcmFormat 48000 1 2) (pcm_format16 44100 1)))

; b from byte i in pieces of 1 to 400 frames, seeded by s, after st.
(def conv_in_pieces ((b bytes) (st PcmConv) (i int) (s int) (acc (list bytes))) bytes
  (if (ge i (bytes_len b))
      (bytes_concat (rev acc))
      (let (j (min (bytes_len b) (add i (mul 2 (add 1 (rand_below s 400)))))
            d (pcm_convert st b i j))
        (conv_in_pieces b (.st d) j (rand_next s) (cons (.out d) acc)))))

; 4800 frames at 48 kHz are 4410 at 44.1 kHz: each falls 48000 / 44100
; input frames after the last, from the first, and the 4411th would
; fall past the last frame given.
(def test_convert_count () int
  (check_int "frames" (length (converted (PcmFormat 48000 1 2) (pcm_format16 44100 1) (tone16 1000 4800))) 4410))

; ----------------------------------------------------------------- mixing

; Two sources at full volume sum, clamped; one at half is halved; a
; short source is silence past its end.
(def test_mix () int
  (let (a (level16 3 1000)
        b (level16 2 500)
        m (samples16 (pcm_mix (cons a (cons b (nil bytes))) (cons 100 (cons 50 (nil int))) 3)))
    (check_strs "mixed" (numbers_words m) (split_spaces "1250 1250 1000"))))

(def test_mix_clamps () int
  (let m (samples16 (pcm_mix (cons (level16 1 30000) (cons (level16 1 30000) (nil bytes))) (nil int) 1))
    (check_strs "clamped" (numbers_words m) (split_spaces "32767"))))

(def test_mix_nothing () int
  (check_strs "silence" (numbers_words (samples16 (pcm_mix (nil bytes) (nil int) 2))) (split_spaces "0 0")))
