; ttf.l0 -- reads a TrueType font, as bytes: its glyphs' outlines, by
; character, as the rasterizer's segments (raster.l0). Only what drawing
; ASCII needs: the tables head, maxp, hhea, hmtx, cmap's format 4, loca
; and glyf, and glyphs simple and composite, the latter with offsets and
; any of their three kinds of scale. No hinting: a glyph is drawn as its
; outline says. And GPOS's pair adjustments, its kerning, read where they
; are. Numbers in a font are big-endian.

; ---------------------------------------------------------------- numbers

; The byte, u16 and u32 at i, big-endian, 0 for any byte past the end.
(def ttf_u8((b bytes) (i int)) int (if (and (ge i 0) (lt i (bytes_len b))) (bytes_get b i) 0))
(def ttf_u16 ((b bytes) (i int)) int (bit_or (bit_shl (ttf_u8 b i) 8) (ttf_u8 b (add i 1))))
(def ttf_u32 ((b bytes) (i int)) int (bit_or (bit_shl (ttf_u16 b i) 16) (ttf_u16 b (add i 2))))

; A u16 as signed, and a byte as signed.
(def ttf_i16 ((b bytes) (i int)) int (let v (ttf_u16 b i) (if (ge v 32768) (sub v 65536) v)))
(def ttf_i8 ((b bytes) (i int)) int (let v (ttf_u8 b i) (if (ge v 128) (sub v 256) v)))

; ----------------------------------------------------------------- tables

; A font: its bytes; units per em, what its outlines' coordinates are
; in; whether loca's offsets are long; how many glyphs; how many have
; their own advance; and where cmap's format 4 subtable, loca, glyf and
; hmtx are.
(data Ttf (Ttf (bytes bytes) (upm int) (long bool) (n int) (nh int) (cm int) (loca int) (glyf int) (hmtx int)))

; Where the table tag is, or -1 if the font has none.
(def ttf_table ((b bytes) (tag (list int))) int
  (ttf_table_at b tag 0 (ttf_u16 b 4)))

; ttf_table's loop: the n records of the table directory from i.
(def ttf_table_at((b bytes) (tag (list int)) (i int) (n int)) int
  (if (ge i n)
      -1
      (let rec (add 12 (mul 16 i))
        (if (eq (ttf_tag b rec) tag)
            (ttf_u32 b (add rec 8))
            (ttf_table_at b tag (add i 1) n)))))

; The four bytes from i, 0 for any past the end.
(def ttf_tag ((b bytes) (i int)) (list int)
  (cons (ttf_u8 b i) (cons (ttf_u8 b (add i 1)) (cons (ttf_u8 b (add i 2)) (cons (ttf_u8 b (add i 3)) (nil int))))))

; The font in b, or why it is not one this reads.
(def ttf_read ((b bytes)) (Result Ttf (list int))
  (let (head (ttf_table b "head")
        maxp (ttf_table b "maxp")
        hhea (ttf_table b "hhea")
        cmap (ttf_table b "cmap"))
    (if (lt (bytes_len b) 12)
        ((Err Ttf (list int)) "too short to be a font")
        (lt (min head (min maxp (min hhea cmap))) 0)
        ((Err Ttf (list int)) "no head, maxp, hhea or cmap: not a TrueType font")
        (ttf_with_cmap b head maxp hhea (ttf_cmap4 b cmap)))))

; ttf_read's rest, its tables found: the font, or why not.
(def ttf_with_cmap((b bytes) (head int) (maxp int) (hhea int) (cmap4 int)) (Result Ttf (list int))
  (let (loca (ttf_table b "loca") glyf (ttf_table b "glyf"))
    (if (lt (min loca glyf) 0)
        ((Err Ttf (list int)) "no glyf: the outlines are not TrueType's")
        (lt cmap4 0)
        ((Err Ttf (list int)) "no Unicode cmap of format 4")
        ((Ok Ttf (list int))
          (Ttf b (ttf_u16 b (add head 18)) (eq (ttf_i16 b (add head 50)) 1) (ttf_u16 b (add maxp 4))
               (ttf_u16 b (add hhea 34)) cmap4 loca glyf (ttf_table b "hmtx"))))))

; Where cmap's Unicode subtable of format 4 is, Windows' (3, 1) or
; Unicode's own (0, 3), or -1.
(def ttf_cmap4 ((b bytes) (cmap int)) int
  (ttf_cmap4_at b cmap 0 (ttf_u16 b (add cmap 2))))

; ttf_cmap4's loop: cmap's n encoding records from i.
(def ttf_cmap4_at((b bytes) (cmap int) (i int) (n int)) int
  (if (ge i n)
      -1
      (let (rec (add cmap (add 4 (mul 8 i)))
            at (add cmap (ttf_u32 b (add rec 4))))
        (if (and (ttf_unicode (ttf_u16 b rec) (ttf_u16 b (add rec 2))) (eq (ttf_u16 b at) 4))
            at
            (ttf_cmap4_at b cmap (add i 1) n)))))

; Whether an encoding record is Unicode's BMP: Windows' (3, 1) or
; Unicode's own (0, 3).
(def ttf_unicode ((platform int) (encoding int)) bool
  (or (and (eq platform 3) (eq encoding 1)) (and (eq platform 0) (eq encoding 3))))

; ----------------------------------------------------------------- glyphs

; The glyph of character c: its index, 0 if the font has none.
(def ttf_glyph_index ((f Ttf) (c int)) int
  (match f
    ((Ttf b upm long n nh cm loca glyf hmtx)
      (ttf_seg_glyph b cm c 0 (div (ttf_u16 b (add cm 6)) 2)))))

; Format 4: segments of characters, each with its end, start, delta and
; range offset in four arrays one after another.
(def ttf_seg_glyph ((b bytes) (cm int) (c int) (i int) (segs int)) int
  (if (ge i segs)
      0
      (let (ends (add cm 14)
            starts (add ends (add (mul 2 segs) 2))
            deltas (add starts (mul 2 segs))
            ranges (add deltas (mul 2 segs)))
        (if (gt c (ttf_u16 b (add ends (mul 2 i))))
            (ttf_seg_glyph b cm c (add i 1) segs)
            (ttf_seg_lookup b c (ttf_u16 b (add starts (mul 2 i))) (ttf_u16 b (add deltas (mul 2 i)))
                            (add ranges (mul 2 i)))))))

; The glyph of c in the segment starting at start: c plus delta, or the
; glyph the segment's range offset names, plus delta; 0 if c is before
; the segment or names none.
(def ttf_seg_lookup((b bytes) (c int) (start int) (delta int) (range_at int)) int
  (if (lt c start)
      0
      (let ro (ttf_u16 b range_at)
        (if (eq ro 0)
            (bit_and (add c delta) 65535)
            (let g (ttf_u16 b (add range_at (add ro (mul 2 (sub c start)))))
              (if (eq g 0) 0 (bit_and (add g delta) 65535)))))))

; How far glyph g moves the pen, in font units.
(def ttf_advance ((f Ttf) (g int)) int
  (match f
    ((Ttf b upm long n nh cm loca glyf hmtx)
      (if (lt hmtx 0) upm (ttf_u16 b (add hmtx (mul 4 (min g (sub nh 1)))))))))

; Where glyph g's outline starts in the font, and where it ends.
(def ttf_glyph_at ((f Ttf) (g int)) int
  (match f ((Ttf b upm long n nh cm loca glyf hmtx) (add glyf (ttf_loca b loca long g)))))

; How many bytes glyph g's outline takes; 0 for a glyph with none.
(def ttf_glyph_len ((f Ttf) (g int)) int
  (match f ((Ttf b upm long n nh cm loca glyf hmtx) (sub (ttf_loca b loca long (add g 1)) (ttf_loca b loca long g)))))

; Where glyph g's outline is in glyf, from loca, whose offsets are long
; or halved shorts.
(def ttf_loca((b bytes) (loca int) (long bool) (g int)) int
  (if long (ttf_u32 b (add loca (mul 4 g))) (mul 2 (ttf_u16 b (add loca (mul 2 g))))))

; A point of an outline, in font units, y up, and whether it is on the
; curve or a quadratic curve's control point.
(data TtfPt (TtfPt int int bool))

; Glyph g's contours, those of its parts too if it is composite, each
; as its points. A glyph with no outline, as a space, has none.
(def ttf_contours ((f Ttf) (g int)) (list (list TtfPt))
  (ttf_contours_deep f g 0))

; Composites nest, but not deeper than 4, so a font that loops is still
; read.
(def ttf_contours_deep ((f Ttf) (g int) (depth int)) (list (list TtfPt))
  (match f
    ((Ttf b upm long n nh cm loca glyf hmtx)
      (if (or (ge g n) (or (gt depth 4) (le (ttf_glyph_len f g) 0)))
          (nil (list TtfPt))
          (let (o (ttf_glyph_at f g) nc (ttf_i16 b o))
            (if (ge nc 0)
                (ttf_simple b o nc)
                (ttf_composite f b (add o 10) depth (nil (list TtfPt)))))))))

; ---------------------------------------------------------- simple glyphs

; A simple glyph's nc contours: their last points' numbers, its flags,
; then its xs and ys, each a delta from the one before.
(def ttf_simple ((b bytes) (o int) (nc int)) (list (list TtfPt))
  (if (eq nc 0)
      (nil (list TtfPt))
      (let (np (add 1 (ttf_u16 b (add o (add 10 (mul 2 (sub nc 1))))))
            ins (ttf_u16 b (add o (add 10 (mul 2 nc))))
            fl_at (add o (add 12 (add (mul 2 nc) ins))))
        (match (ttf_flags b fl_at np (nil int))
          ((TtfFlags flags xs_at)
            (match (ttf_coords b xs_at flags 2 16 0 (nil int))
              ((TtfCoords xs ys_at)
                (match (ttf_coords b ys_at flags 4 32 0 (nil int))
                  ((TtfCoords ys after)
                    (ttf_split b o nc (ttf_points flags xs ys (nil TtfPt))))))))))))

; The flags, one a point, and where the xs begin. A flag with bit 8 set
; is followed by how many times more it repeats.
(data TtfFlags (TtfFlags (list int) int))

; The flags of left points from at, onto acc reversed.
(def ttf_flags((b bytes) (at int) (left int) (acc (list int))) TtfFlags
  (if (le left 0)
      (TtfFlags (rev acc) at)
      (let fl (ttf_u8 b at)
        (if (eq (bit_and fl 8) 0)
            (ttf_flags b (add at 1) (sub left 1) (cons fl acc))
            (let r (min (ttf_u8 b (add at 1)) (sub left 1))
              (ttf_flags b (add at 2) (sub left (add r 1)) (ttf_repeat fl (add r 1) acc)))))))

; Flag fl n times onto acc.
(def ttf_repeat((fl int) (n int) (acc (list int))) (list int)
  (if (le n 0) acc (ttf_repeat fl (sub n 1) (cons fl acc))))

; One axis's coordinates, from at, each point's flag saying how its delta
; is kept: short is the bit for a byte, same the bit that then says it is
; positive, and otherwise that it is 0, not a 16-bit delta.
(data TtfCoords (TtfCoords (list int) int))

; The coordinates of the points flags are of, from at, each the one
; before, v, moved by its delta; onto acc reversed.
(def ttf_coords((b bytes) (at int) (flags (list int)) (short int) (same int) (v int) (acc (list int))) TtfCoords
  (if (is_empty flags)
      (TtfCoords (rev acc) at)
      (let fl (head flags)
        (if (not (eq (bit_and fl short) 0))
            (let (d (ttf_u8 b at)
                  nv (if (eq (bit_and fl same) 0) (sub v d) (add v d)))
              (ttf_coords b (add at 1) (tail flags) short same nv (cons nv acc)))
            (not (eq (bit_and fl same) 0))
            (ttf_coords b at (tail flags) short same v (cons v acc))
            (let nv (add v (ttf_i16 b at))
              (ttf_coords b (add at 2) (tail flags) short same nv (cons nv acc)))))))

; The points, each its x, its y and whether its flag puts it on the
; curve, as an array; as many as the shortest of the three lists.
(def ttf_points((flags (list int)) (xs (list int)) (ys (list int)) (acc (list TtfPt))) (array TtfPt)
  (if (or (is_empty flags) (or (is_empty xs) (is_empty ys)))
      (array_from (rev acc) (TtfPt 0 0 true))
      (ttf_points (tail flags) (tail xs) (tail ys)
                  (cons (TtfPt (head xs) (head ys) (not (eq (bit_and (head flags) 1) 0))) acc))))

; The points cut into contours at each contour's last point.
(def ttf_split ((b bytes) (o int) (nc int) (pts (array TtfPt))) (list (list TtfPt))
  (ttf_split_at b o nc pts 0 0 (nil (list TtfPt))))

; ttf_split's loop: contours k on, the next starting at point from.
(def ttf_split_at((b bytes) (o int) (nc int) (pts (array TtfPt)) (k int) (from int) (acc (list (list TtfPt)))) (list (list TtfPt))
  (if (ge k nc)
      (rev acc)
      (let last (ttf_u16 b (add o (add 10 (mul 2 k))))
        (ttf_split_at b o nc pts (add k 1) (add last 1) (cons (ttf_slice pts from (add last 1) (nil TtfPt)) acc)))))

; Points i up to j, as a list; those past the end left out.
(def ttf_slice((pts (array TtfPt)) (i int) (j int) (acc (list TtfPt))) (list TtfPt)
  (if (or (ge i j) (ge i (array_len pts)))
      (rev acc)
      (ttf_slice pts (add i 1) j (cons (array_get pts i) acc))))

; ------------------------------------------------------- composite glyphs

; A composite glyph's parts, from at: each a flag word, a glyph, its
; offset, and perhaps a scale, as F2Dot14s (1 is 16384); more follow
; while bit 32 of the flags is set.
(def ttf_composite ((f Ttf) (b bytes) (at int) (depth int) (acc (list (list TtfPt)))) (list (list TtfPt))
  (let (fl (ttf_u16 b at)
        g (ttf_u16 b (add at 2))
        words (not (eq (bit_and fl 1) 0))
        dx (if words (ttf_i16 b (add at 4)) (ttf_i8 b (add at 4)))
        dy (if words (ttf_i16 b (add at 6)) (ttf_i8 b (add at 5)))
        sat (add at (if words 8 6)))
    (ttf_part f b fl g dx dy sat depth acc)))

; One part, glyph g, flags fl: its contours scaled as the flags say, by
; the scale at sat, and moved by dx, dy, after acc; then the parts after
; it, while the flags say more follow.
(def ttf_part((f Ttf) (b bytes) (fl int) (g int) (dx int) (dy int) (sat int) (depth int) (acc (list (list TtfPt)))) (list (list TtfPt))
  (let (one (not (eq (bit_and fl 8) 0))
        two (not (eq (bit_and fl 64) 0))
        four (not (eq (bit_and fl 128) 0))
        m (if four (TtfMatrix (ttf_i16 b sat) (ttf_i16 b (add sat 2)) (ttf_i16 b (add sat 4)) (ttf_i16 b (add sat 6)))
              two (TtfMatrix (ttf_i16 b sat) 0 0 (ttf_i16 b (add sat 2)))
              one (TtfMatrix (ttf_i16 b sat) 0 0 (ttf_i16 b sat))
              (TtfMatrix 16384 0 0 16384))
        next (add sat (if four 8 two 4 one 2 0))
        parts (ttf_moved (ttf_contours_deep f g (add depth 1)) m dx dy (rev acc)))
    (if (eq (bit_and fl 32) 0)
        parts
        (ttf_composite f b next depth (rev parts)))))

; A part's 2 by 2 transform, a b c d as F2Dot14s: x' = a x + c y,
; y' = b x + d y.
(data TtfMatrix (TtfMatrix int int int int))

; Each contour of cs transformed by m and moved by dx, dy, after acc.
(def ttf_moved ((cs (list (list TtfPt))) (m TtfMatrix) (dx int) (dy int) (acc (list (list TtfPt)))) (list (list TtfPt))
  (if (is_empty cs)
      (rev acc)
      (ttf_moved (tail cs) m dx dy (cons (ttf_moved_pts (head cs) m dx dy (nil TtfPt)) acc))))

; One contour's points transformed by m and moved by dx, dy.
(def ttf_moved_pts((ps (list TtfPt)) (m TtfMatrix) (dx int) (dy int) (acc (list TtfPt))) (list TtfPt)
  (if (is_empty ps)
      (rev acc)
      (match (head ps)
        ((TtfPt x y on)
          (match m
            ((TtfMatrix a b c d)
              (ttf_moved_pts (tail ps) m dx dy
                (cons (TtfPt (add (ttf_f2dot14 (add (mul a x) (mul c y))) dx) (add (ttf_f2dot14 (add (mul b x) (mul d y))) dy) on) acc))))))))

; A sum of F2Dot14 products, as whole font units, rounded to nearest.
(def ttf_f2dot14 ((v int)) int (float_round (float_div (float_of v) 16384.0)))

; ----------------------------------------------------------- to segments

; How font units become the rasterizer's: x · num / den + ox, and y, which
; goes up in a font but down on a screen, oy − y · num / den.
(data TtfPlace (TtfPlace int int int int))

; v · num / den, rounded to nearest.
(def ttf_scaled ((v int) (num int) (den int)) int
  (float_round (float_div (float_of (mul v num)) (float_of den))))

; A point's x and y, placed.
(def ttf_x((p TtfPlace) (x int)) int (match p ((TtfPlace num den ox oy) (add ox (ttf_scaled x num den)))))
(def ttf_y ((p TtfPlace) (y int)) int (match p ((TtfPlace num den ox oy) (sub oy (ttf_scaled y num den)))))

; Contours as segments: each from a point on its curve, a line to each
; next on it, a quadratic curve through each control point, and between
; two control points in a row the point midway between them, which
; TrueType leaves implied.
(def ttf_segs ((cs (list (list TtfPt))) (p TtfPlace)) (list RastSeg)
  (rev (ttf_segs_onto cs p (nil RastSeg))))

; ttf_segs' loop: each contour's segments onto acc, reversed; an empty
; contour none.
(def ttf_segs_onto((cs (list (list TtfPt))) (p TtfPlace) (acc (list RastSeg))) (list RastSeg)
  (if (is_empty cs)
      acc
      (ttf_segs_onto (tail cs) p (if (is_empty (head cs)) acc (ttf_contour (ttf_from_on (head cs)) p acc)))))

; A contour turned to begin on its curve: at its first point on it, or,
; if none is, at the point midway between its last and first.
(def ttf_from_on ((ps (list TtfPt))) (list TtfPt)
  (ttf_rotate ps (nil TtfPt) ps))

; ttf_from_on's loop: rest, from the next point, before the points
; passed, reversed; all the contour.
(def ttf_rotate((rest (list TtfPt)) (before (list TtfPt)) (all (list TtfPt))) (list TtfPt)
  (if (is_empty rest)
      (cons (ttf_mid (head (rev all)) (head all)) all)
      (match (head rest)
        ((TtfPt x y on)
          (if on
              (append rest (rev before))
              (ttf_rotate (tail rest) (cons (head rest) before) all))))))

; The point midway between a and b, on the curve.
(def ttf_mid((a TtfPt) (b TtfPt)) TtfPt
  (match a ((TtfPt ax ay aon) (match b ((TtfPt bx by bon) (TtfPt (float_round (float_div (float_of (add ax bx)) 2.0)) (float_round (float_div (float_of (add ay by)) 2.0)) true))))))

; One contour, starting on its curve, as segments onto acc, reversed: a
; move to its first point, the walk round, and a close.
(def ttf_contour((ps (list TtfPt)) (p TtfPlace) (acc (list RastSeg))) (list RastSeg)
  (match (head ps)
    ((TtfPt x y on)
      (cons (RastClose) (ttf_walk (tail ps) (head ps) ((None TtfPt)) p (cons (RastMove (ttf_x p x) (ttf_y p y)) acc))))))

; Through ps, with a control point pending or none, then back to start.
(def ttf_walk ((ps (list TtfPt)) (start TtfPt) (ctrl (Option TtfPt)) (p TtfPlace) (acc (list RastSeg))) (list RastSeg)
  (if (is_empty ps)
      (ttf_to ctrl start p acc)
      (match (head ps)
        ((TtfPt x y on)
          (if on
              (ttf_walk (tail ps) start ((None TtfPt)) p (ttf_to ctrl (head ps) p acc))
              (match ctrl
                ((None) (ttf_walk (tail ps) start (Some (head ps)) p acc))
                ((Some c) (ttf_walk (tail ps) start (Some (head ps)) p (ttf_to ctrl (ttf_mid c (head ps)) p acc)))))))))

; To point to, on the curve: a line, or a curve through ctrl.
(def ttf_to ((ctrl (Option TtfPt)) (to TtfPt) (p TtfPlace) (acc (list RastSeg))) (list RastSeg)
  (match to
    ((TtfPt x y on)
      (match ctrl
        ((None) (cons (RastLine (ttf_x p x) (ttf_y p y)) acc))
        ((Some c) (match c ((TtfPt cx cy con) (cons (RastQuad (ttf_x p cx) (ttf_y p cy) (ttf_x p x) (ttf_y p y)) acc))))))))

; ---------------------------------------------------------------- kerning

; How much further the pen moves after glyph l when glyph r follows it,
; in font units, by the GPOS lookups kern (ttf_kern_lookups): each
; lookup's adjustment of the pair, summed; 0 for a font with none.
(def ttf_kern ((f Ttf) (kern (list int)) (l int) (r int)) int
  (match f
    ((Ttf b upm long n nh cm loca glyf hmtx)
      (let gpos (ttf_table b "GPOS")
        (if (lt gpos 0) 0 (ttf_kern_sum b gpos kern l r 0))))))

; The lookups of the kern feature of GPOS's default script's default
; language system, DFLT's, or latn's if it has none, each once, in the
; lookup list's order; none if the font has no GPOS, or no kern there.
(def ttf_kern_lookups ((f Ttf)) (list int)
  (match f
    ((Ttf b upm long n nh cm loca glyf hmtx)
      (let gpos (ttf_table b "GPOS")
        (if (lt gpos 0)
            (nil int)
            (let ls (ttf_default_langsys b gpos)
              (if (lt ls 0)
                  (nil int)
                  (sort (ttf_once (ttf_langsys_kern b gpos ls 0 (ttf_u16 b (add ls 4)) (nil int)))))))))))

; Where the default language system of the default script is, in GPOS
; at gpos: DFLT's, or else latn's; -1 if neither has one.
(def ttf_default_langsys ((b bytes) (gpos int)) int
  (let (sl (add gpos (ttf_u16 b (add gpos 4)))
        d (ttf_script_at b sl "DFLT" 0 (ttf_u16 b sl)))
    (if (ge d 0) d (ttf_script_at b sl "latn" 0 (ttf_u16 b sl)))))

; The default language system of script tag in the script list at sl,
; from its n records from i; -1 if it has no such script, or the script
; none.
(def ttf_script_at ((b bytes) (sl int) (tag (list int)) (i int) (n int)) int
  (if (ge i n)
      -1
      (let rec (add sl (add 2 (mul 6 i)))
        (if (eq (ttf_tag b rec) tag)
            (let (s (add sl (ttf_u16 b (add rec 4))) d (ttf_u16 b s))
              (if (eq d 0) -1 (add s d)))
            (ttf_script_at b sl tag (add i 1) n)))))

; The lookups of each of the language system at ls's features, i up to
; n, whose tag is kern, onto acc.
(def ttf_langsys_kern ((b bytes) (gpos int) (ls int) (i int) (n int) (acc (list int))) (list int)
  (if (ge i n)
      acc
      (let (fl (add gpos (ttf_u16 b (add gpos 6)))
            rec (add fl (add 2 (mul 6 (ttf_u16 b (add ls (add 6 (mul 2 i))))))))
        (if (eq (ttf_tag b rec) "kern")
            (let ft (add fl (ttf_u16 b (add rec 4)))
              (ttf_langsys_kern b gpos ls (add i 1) n (ttf_u16s b (add ft 4) (ttf_u16 b (add ft 2)) acc)))
            (ttf_langsys_kern b gpos ls (add i 1) n acc)))))

; The n u16s from at, onto acc.
(def ttf_u16s ((b bytes) (at int) (n int) (acc (list int))) (list int)
  (if (le n 0) acc (ttf_u16s b (add at 2) (sub n 1) (cons (ttf_u16 b at) acc))))

; xs with each value once.
(def ttf_once ((xs (list int))) (list int)
  (if (is_empty xs) xs (any_eq (head xs) (tail xs)) (ttf_once (tail xs)) (cons (head xs) (ttf_once (tail xs)))))

; Each of lookups' adjustment of the pair l, r, summed onto acc.
(def ttf_kern_sum ((b bytes) (gpos int) (lookups (list int)) (l int) (r int) (acc int)) int
  (if (is_empty lookups)
      acc
      (let (ll (add gpos (ttf_u16 b (add gpos 8)))
            lk (add ll (ttf_u16 b (add ll (add 2 (mul 2 (head lookups)))))))
        (ttf_kern_sum b gpos (tail lookups) l r
          (add acc (ttf_lookup_pair b lk (ttf_u16 b lk) 0 (ttf_u16 b (add lk 4)) l r))))))

; A lookup at lk's adjustment of the pair: its subtables i up to n tried
; in order, the first that covers the pair giving it, an extension's
; (type 9) as the subtable it points to; 0 if none does, or the lookup
; is not of pairs (type 2).
(def ttf_lookup_pair ((b bytes) (lk int) (kind int) (i int) (n int) (l int) (r int)) int
  (if (ge i n)
      0
      (let (st (add lk (ttf_u16 b (add lk (add 6 (mul 2 i)))))
            at (if (eq kind 9) (add st (ttf_u32 b (add st 4))) st)
            k (if (eq kind 9) (ttf_u16 b (add st 2)) kind))
        (match (if (eq k 2) (ttf_pair_pos b at l r) ((None int)))
          ((Some v) v)
          ((None) (ttf_lookup_pair b lk kind (add i 1) n l r))))))

; The pair positioning subtable at at's x advance for the pair l, r:
; format 1's for the pair, if it lists it; format 2's for the pair's
; classes, if l is covered; None if it does not cover the pair.
(def ttf_pair_pos ((b bytes) (at int) (l int) (r int)) (Option int)
  (let ci (ttf_coverage b (add at (ttf_u16 b (add at 2))) l)
    (if (lt ci 0)
        ((None int))
        (let (vf1 (ttf_u16 b (add at 4)) vf2 (ttf_u16 b (add at 6)))
          (if (eq (ttf_u16 b at) 1)
              (let ps (add at (ttf_u16 b (add at (add 10 (mul 2 ci)))))
                (ttf_pair_set b ps vf1 vf2 r 0 (ttf_u16 b ps)))
              (eq (ttf_u16 b at) 2)
              (Some (ttf_class_pair b at vf1 vf2 l r))
              ((None int)))))))

; Format 2's x advance for the classes of l and r, its records a row a
; class of l, each a value pair a class of r.
(def ttf_class_pair ((b bytes) (at int) (vf1 int) (vf2 int) (l int) (r int)) int
  (let (c1 (ttf_class b (add at (ttf_u16 b (add at 8))) l)
        c2 (ttf_class b (add at (ttf_u16 b (add at 10))) r)
        n2 (ttf_u16 b (add at 14)))
    (if (or (ge c1 (ttf_u16 b (add at 12))) (ge c2 n2))
        0
        (ttf_x_advance b (add at (add 16 (mul (add (mul c1 n2) c2) (add (ttf_vr_len vf1) (ttf_vr_len vf2))))) vf1))))

; Format 1's pair set at ps: the record of second glyph r, of i up to
; n, its first value's x advance; None if it has none.
(def ttf_pair_set ((b bytes) (ps int) (vf1 int) (vf2 int) (r int) (i int) (n int)) (Option int)
  (if (ge i n)
      ((None int))
      (let rec (add ps (add 2 (mul i (add 2 (add (ttf_vr_len vf1) (ttf_vr_len vf2))))))
        (if (eq (ttf_u16 b rec) r)
            (Some (ttf_x_advance b (add rec 2) vf1))
            (ttf_pair_set b ps vf1 vf2 r (add i 1) n)))))

; How long a value record of format vf is: 2 bytes a field it has.
(def ttf_vr_len ((vf int)) int (mul 2 (bit_count (bit_and vf 255))))

; A value record's x advance, at rec, of format vf: the field after any
; x and y placement; 0 if it has none.
(def ttf_x_advance ((b bytes) (rec int) (vf int)) int
  (if (eq (bit_and vf 4) 0) 0 (ttf_i16 b (add rec (mul 2 (bit_count (bit_and vf 3)))))))

; Glyph g's index in the coverage table at at, -1 if it is not in it.
(def ttf_coverage ((b bytes) (at int) (g int)) int
  (if (eq (ttf_u16 b at) 1) (ttf_cov1 b at g 0 (ttf_u16 b (add at 2)))
      (eq (ttf_u16 b at) 2) (ttf_cov2 b at g 0 (ttf_u16 b (add at 2)))
      -1))

; Format 1, a sorted list of glyphs: g's place among those from lo up
; to hi, by halving.
(def ttf_cov1 ((b bytes) (at int) (g int) (lo int) (hi int)) int
  (if (ge lo hi)
      -1
      (let (mid (div (add lo hi) 2)
            v (ttf_u16 b (add at (add 4 (mul 2 mid)))))
        (if (eq v g) mid (lt v g) (ttf_cov1 b at g (add mid 1) hi) (ttf_cov1 b at g lo mid)))))

; Format 2, ranges of glyphs, each its first's coverage index: g's, in
; the range of i up to n that holds it.
(def ttf_cov2 ((b bytes) (at int) (g int) (i int) (n int)) int
  (if (ge i n)
      -1
      (let rec (add at (add 4 (mul 6 i)))
        (if (and (ge g (ttf_u16 b rec)) (le g (ttf_u16 b (add rec 2))))
            (add (ttf_u16 b (add rec 4)) (sub g (ttf_u16 b rec)))
            (ttf_cov2 b at g (add i 1) n)))))

; Glyph g's class in the class definition at at, 0 if it gives none.
(def ttf_class ((b bytes) (at int) (g int)) int
  (if (eq (ttf_u16 b at) 1)
      (let first (ttf_u16 b (add at 2))
        (if (and (ge g first) (lt g (add first (ttf_u16 b (add at 4)))))
            (ttf_u16 b (add at (add 6 (mul 2 (sub g first)))))
            0))
      (eq (ttf_u16 b at) 2)
      (ttf_class2 b at g 0 (ttf_u16 b (add at 2)))
      0))

; Format 2's ranges, i up to n: the class of the one that holds g.
(def ttf_class2 ((b bytes) (at int) (g int) (i int) (n int)) int
  (if (ge i n)
      0
      (let rec (add at (add 4 (mul 6 i)))
        (if (and (ge g (ttf_u16 b rec)) (le g (ttf_u16 b (add rec 2))))
            (ttf_u16 b (add rec 4))
            (ttf_class2 b at g (add i 1) n)))))
