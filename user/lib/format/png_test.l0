; The bytes of b as lowercase hex, two digits each.
(def hex_of ((b bytes)) (list int)
  (rev (hex_onto b 0 (nil int))))

; hex_of's loop: the bytes from i on, onto acc, reversed.
(def hex_onto ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b))
      acc
      (hex_onto b (add i 1) (push (hex_digits (bytes_get b i) 2) acc))))

; One red pixel, as Python's zlib and struct write it (zlib.adler32,
; zlib.crc32, a stored block of 4 bytes: the filter's 0 and ff 00 00).
(def test_one_red_pixel () int
  (check_str "1 by 1"
    (hex_of (png_bytes 1 1 (cons (png_row (cons 16711680 (nil int))) (nil bytes))))
    "89504e470d0a1a0a0000000d4948445200000001000000010802000000907753de0000000f494441547801010400fbff00ff0000030101008d1de5820000000049454e44ae426082"))

; Two rows of two: red, green; blue, white.
(def test_two_by_two () int
  (check_str "2 by 2"
    (hex_of (png_bytes 2 2 (cons (png_row (cons 16711680 (cons 65280 (nil int))))
                                 (cons (png_row (cons 255 (cons 16777215 (nil int)))) (nil bytes)))))
    "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a7300000019494441547801010e00f1ff00ff000000ff00000000ffffffff1fee05fbdeddec2b0000000049454e44ae426082"))

; A color's channels, red first.
(def test_row () int
  (check_str "two pixels" (hex_of (png_row (cons 1193046 (cons 11259375 (nil int))))) "123456abcdef"))

; Adler-32 of "Wikipedia", as its article works it out: 0x11E60398.
(def test_adler32 () int
  (let b (bytes_from_list "Wikipedia")
    (check_int "Wikipedia" (png_adler32 b 0 (bytes_len b) 1 0) 300286872)))

; 70000 bytes are two stored blocks: 65535, not the last (0, ff ff, 00
; 00), then 4465, the last (1, 71 11, 8e ee); the block's bytes between.
(def test_blocks_split () int
  (let z (png_zlib (bytes_from_list (repeat 70000 7)))
    (add (check_str "the first's header" (hex_of (bytes_slice z 2 7)) "00ffff0000")
         (add (check_str "the second's" (hex_of (bytes_slice z 65542 65547)) "0171118eee")
              (check_int "all of it" (bytes_len z) (add 2 (add 5 (add 65535 (add 5 (add 4465 4))))))))))

; No bytes at all are still one block, the last, empty.
(def test_empty_stream () int
  (check_str "none" (hex_of (png_zlib (bytes_from_list (nil int)))) "7801010000ffff00000001"))
