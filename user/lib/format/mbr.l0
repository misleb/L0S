; mbr.l0 -- the master boot record's partition table, as bytes, read
; only: what a disk partitioned before GPT, or by Raspberry Pi's Imager,
; has in its sector 0. Pure: it decodes the four primary entries, tells a
; GPT's protective MBR from a table of its own, and gives each partition
; a UUID, which MBR has none of, for fs to mount its volume with.
;
;   bytes 0-439     boot code, not read
;   bytes 440-443   the disk's signature, a u32
;   bytes 446-509   four entries of 16 bytes: the type at 4, the first
;                   sector at 8 and the sectors at 12, u32s
;   bytes 510-511   55 AA
;
; Extended partitions (05, 0F) are not followed. L0S never makes an MBR
; but GPT's protective one (gpt.l0); of one made elsewhere it changes
; only a partition's type byte, when mkfs makes a volume there
; (mbr_with_type). Linked with common/abi.l0 and user/lib/format/uuid.l0.

; Where the signature and the entries are, and how many entries.
(def mbr_sig_at () int 440)
(def mbr_entries_at () int 446)
(def mbr_entry_count () int 4)

; The type of a GPT's protective MBR's one entry, EE.
(def mbr_protective_type () int 238)

; The types of a FAT32 partition: 0B, CHS; 0C, LBA; and EF, an EFI
; system partition.
(def mbr_fat_types () (list int) (cons 11 (cons 12 (cons 239 (nil int)))))

; The types mkfs gives a partition it makes a volume on: FAT32's 0C,
; LBA; and L0FS's 7F, the type set aside for an operating system of
; one's own, which no other system mounts.
(def mbr_fat_lba_type () int 12)
(def mbr_l0fs_type () int 127)

; A partition: its number in the table, from 1; its type; its first
; sector; and its sectors.
(data MbrPart (MbrPart (number int) (type int) (start int) (sectors int)))

; A table: the disk's signature and its partitions, those with a type
; and sectors, in the table's order.
(data MbrDisk (MbrDisk (sig int) (parts (list MbrPart))))

; What sector 0 holds: a table; GPT's protective MBR, so that the GPT is
; the table; or no MBR, no 55 AA at its end.
(data MbrRead (MbrGot MbrDisk) (MbrProtective) (MbrNone))

; The table in sector 0, b. A table with an entry of type EE is GPT's.
(def mbr_of ((b bytes)) MbrRead
  (if (lt (bytes_len b) 512)
      (MbrNone)
      (not (and (eq (bytes_get b 510) 85) (eq (bytes_get b 511) 170)))
      (MbrNone)
      (let ps (mbr_entries b (sub (mbr_entry_count) 1) (nil MbrPart))
        (if (mbr_any_type ps (mbr_protective_type))
            (MbrProtective)
            (MbrGot (MbrDisk (le_u32 b (mbr_sig_at)) ps))))))

; Entries 0 to i of b that have a type and sectors, onto acc.
(def mbr_entries ((b bytes) (i int) (acc (list MbrPart))) (list MbrPart)
  (if (lt i 0)
      acc
      (let (at (add (mbr_entries_at) (mul i 16))
            ty (bytes_get b (add at 4))
            count (le_u32 b (add at 12)))
        (mbr_entries b (sub i 1)
          (if (or (eq ty 0) (eq count 0))
              acc
              (cons (MbrPart (add i 1) ty (le_u32 b (add at 8)) count) acc))))))

; Whether any of ps is of type ty.
(def mbr_any_type ((ps (list MbrPart)) (ty int)) bool
  (if (is_empty ps)
      false
      (eq (.type (head ps)) ty) true
      (mbr_any_type (tail ps) ty)))

; Whether p may hold a FAT32 volume, by its type.
(def mbr_is_fat ((p MbrPart)) bool
  (any_eq (.type p) (mbr_fat_types)))

; The partitions of ps that may hold FAT32, in order.
(def mbr_fat_parts ((ps (list MbrPart))) (list MbrPart)
  (if (is_empty ps)
      (nil MbrPart)
      (mbr_is_fat (head ps)) (cons (head ps) (mbr_fat_parts (tail ps)))
      (mbr_fat_parts (tail ps))))

; The partitions of ps of type ty, in order.
(def mbr_typed ((ps (list MbrPart)) (ty int)) (list MbrPart)
  (if (is_empty ps)
      (nil MbrPart)
      (eq (.type (head ps)) ty) (cons (head ps) (mbr_typed (tail ps) ty))
      (mbr_typed (tail ps) ty)))

; The partition of ps, of a disk whose signature is sig, known by u, as
; mbr_part_uuid makes it; None if none is.
(def mbr_part_of ((ps (list MbrPart)) (sig int) (u Uuid)) (Option MbrPart)
  (if (is_empty ps)
      ((None MbrPart))
      (eq (mbr_part_uuid sig (.number (head ps))) u) (Some (head ps))
      (mbr_part_of (tail ps) sig u)))

; Sector 0, b, with partition k's type ty, every other byte as it was:
; the boot code, the signature, and the other entries kept.
(def mbr_with_type ((b bytes) (k int) (ty int)) bytes
  (let at (add (mbr_entries_at) (add (mul (sub k 1) 16) 4))
    (bytes_concat (cons (bytes_slice b 0 at)
                    (cons (bytes_from_list (cons ty (nil int)))
                      (cons (bytes_slice b (add at 1) (bytes_len b)) (nil bytes)))))))

; The UUID a partition of a disk whose signature is sig, number k, is
; known by: the signature's four bytes, most significant first, then
; zeros, and k in the last byte, as SSSSSSSS-0000-0000-0000-0000000000KK.
; Two disks of one signature give the same UUIDs, as Linux's PARTUUIDs
; of them would be the same.
(def mbr_part_uuid ((sig int) (k int)) Uuid
  (Uuid (append (cons (bit_and (bit_shr sig 24) 255)
                  (cons (bit_and (bit_shr sig 16) 255)
                    (cons (bit_and (bit_shr sig 8) 255)
                      (cons (bit_and sig 255) (nil int)))))
                (append (zeros 11) (cons (bit_and k 255) (nil int))))))

; The name of a partition's type, for Disks: FAT32's, EFI's and L0FS's
; in words, any other in hexadecimal.
(def mbr_type_text ((ty int)) (list int)
  (if (any_eq ty (cons 11 (cons 12 (nil int))))
      (append "FAT32 (0x" (append (hex_digits ty 2) ")"))
      (eq ty 239) "EFI system (0xEF)"
      (eq ty (mbr_l0fs_type)) "L0FS (0x7f)"
      (append "MBR type 0x" (hex_digits ty 2))))
