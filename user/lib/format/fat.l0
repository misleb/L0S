; fat.l0 -- FAT32, as bytes: the file system a Raspberry Pi boots from,
; and that every other system reads, on a GPT partition of the basic
; data or EFI type, or an MBR partition of type 0B, 0C or EF. Pure: it
; encodes and decodes the boot sector, FSInfo, the FAT and directories,
; walks paths, plans which clusters a read or a write touches and which
; sectors a change dirties; user/sbin/fs serves volumes with it,
; tools/mkfs makes them.
;
;   sector 0          the boot sector: the BPB, its label, 55 AA
;   sector 1          FSInfo: how many clusters are free, and a hint
;   sector 6, 7       the boot sector's and FSInfo's backups
;   reserved on       the FATs, two copies, a u32 a cluster, of which
;                     the low 28 bits count: 0 free, 0FFFFFF8 on a
;                     chain's last, 0FFFFFF7 bad, else the next
;   data on           clusters 2 on, of 1 to 64 sectors; the root
;                     directory a chain from the BPB's root cluster
;
; A directory is a chain of 32-byte slots: a short entry, its 8.3 name,
; attributes, times, first cluster and size; before it, the slots of
; its long name, 13 UCS-2 characters each, last first; E5 a free slot,
; 00 the first of the free ones that end it. A name of 8.3 in one case
; has a short entry only, its case in the NT byte; any other has a long
; name and a short alias, NAME~N.EXT. Names are found ignoring ASCII
; case. FAT has no programs: no file is one.
;
; Only 512-byte sectors, clusters up to 32 KB, and at most
; fat_max_clusters; FAT12, FAT16 and exFAT are not read. The volume is
; kept in memory, as l0fs.l0's is: the FAT as an array of arrays, a
; sector's 128 marks each, so that a change copies at most a sector's;
; every directory as its slots' bytes, so that what is not understood,
; a name L0S cannot spell, is kept as it was. A change records the
; sectors it dirties, which fat_pieces gives back, merged, to be
; written. Linked with common/abi.l0, common/text.l0 and l0fs.l0, whose
; VolRef, VolEntry, VolPlace, VolSpan and VolAt it gives fs.

; ------------------------------------------------------------------ sizes

; A sector's bytes; a slot's; and how many slots a sector holds.
(def fat_sector () int 512)
(def fat_slot_size () int 32)
(def fat_slots_per_sector () int 16)

; How many marks a sector of the FAT holds.
(def fat_marks () int 128)

; The fewest clusters FAT32 has, by its definition; and the most read
; here, 2M, a 64 GB volume of 32 KB clusters.
(def fat_min_clusters () int 65525)
(def fat_max_clusters () int 2097152)

; Marks: the low 28 bits; the least that ends a chain, the one mkfs
; writes, and a bad cluster's.
(def fat_mask () int 268435455)      ; 0FFFFFFF
(def fat_eoc () int 268435448)       ; 0FFFFFF8
(def fat_end () int 268435455)       ; 0FFFFFFF
(def fat_bad () int 268435447)       ; 0FFFFFF7

; Attributes: read only, hidden, system, a volume's label, a directory,
; archive; and a long name's slot, all four of the first.
(def fat_attr_label () int 8)
(def fat_attr_dir () int 16)
(def fat_attr_archive () int 32)
(def fat_attr_lfn () int 15)

; The NT byte's bits: the base, and the extension, in lowercase.
(def fat_nt_base () int 8)
(def fat_nt_ext () int 16)

; The longest name, and the longest label.
(def fat_name_max () int 255)
(def fat_label_max () int 11)

; ---------------------------------------------------------------- bytes

; b with v's low 16 or 32 bits at i, least significant first, as new
; bytes: the slices around it joined once.
(def fat_put16 ((b bytes) (i int) (v int)) bytes
  (fat_put b i (le16 v)))
(def fat_put32 ((b bytes) (i int) (v int)) bytes
  (fat_put b i (u32_le v)))

; b with xs in place of its bytes from i.
(def fat_put ((b bytes) (i int) (xs (list int))) bytes
  (bytes_concat (cons (bytes_slice b 0 i)
                  (cons (bytes_from_list xs)
                    (cons (bytes_slice b (add i (length xs)) (bytes_len b)) (nil bytes))))))

; s, then spaces up to n bytes, cut to n.
(def fat_space_pad ((s (list int)) (n int)) (list int)
  (take (append s (spaces n)) n))

; s without the spaces at its end.
(def fat_trim ((s (list int))) (list int)
  (rev (fat_drop_spaces (rev s))))

; s without the spaces at its start.
(def fat_drop_spaces ((s (list int))) (list int)
  (if (is_empty s) s (eq (head s) 32) (fat_drop_spaces (tail s)) s))

; c in uppercase, and in lowercase, if it is an ASCII letter.
(def fat_up ((c int)) int (if (and (ge c 97) (le c 122)) (sub c 32) c))
(def fat_down ((c int)) int (if (and (ge c 65) (le c 90)) (add c 32) c))

; s in uppercase, and in lowercase.
(def fat_upper ((s (list int))) (list int)
  (if (is_empty s) s (cons (fat_up (head s)) (fat_upper (tail s)))))
(def fat_lower ((s (list int))) (list int)
  (if (is_empty s) s (cons (fat_down (head s)) (fat_lower (tail s)))))

; Whether s has a lowercase letter, and an uppercase one.
(def fat_has_lower ((s (list int))) bool
  (if (is_empty s) false (and (ge (head s) 97) (le (head s) 122)) true (fat_has_lower (tail s))))
(def fat_has_upper ((s (list int))) bool
  (if (is_empty s) false (and (ge (head s) 65) (le (head s) 90)) true (fat_has_upper (tail s))))

; ------------------------------------------------------------------ names

; Whether s may name a file on FAT: as l0fs.l0's vol_name_ok, printable
; with no space or /, but up to 255 bytes, none of FAT's "*:<>?\|, and
; not ending in a dot.
(def fat_name_ok ((s (list int))) bool
  (if (or (is_empty s) (gt (length s) (fat_name_max))) false
      (any_eq s (split_spaces ". ..")) false
      (eq (last s) 46) false
      (and (vol_name_chars s) (fat_name_chars s))))

; Whether no byte of s is one FAT forbids: " * : < > ? \ |
(def fat_name_chars ((s (list int))) bool
  (if (is_empty s)
      true
      (any_eq (head s) (cons 34 (cons 42 (cons 58 (cons 60 (cons 62 (cons 63 (cons 92 (cons 124 (nil int))))))))))
      false
      (fat_name_chars (tail s))))

; Whether c may be in a short name, once uppercased: a letter, a digit,
; or one of ! # $ % & ' ( ) - @ ^ _ ` { } ~
(def fat_short_char ((c int)) bool
  (or (and (ge c 65) (le c 90))
      (or (is_digit c) (any_eq c "!#$%&'()-@^_`{}~"))))

; Whether every byte of s may be in a short name.
(def fat_short_chars ((s (list int))) bool
  (if (is_empty s) true (fat_short_char (fat_up (head s))) (fat_short_chars (tail s)) false))

; A name's base and extension: before its last dot, and after it; the
; extension is empty with no dot.
(data FatSplit (FatSplit (list int) (list int)))

; name's base and extension, at its last dot.
(def fat_split ((name (list int))) FatSplit
  (let k (fat_last_dot name 0 -1)
    (if (lt k 0)
        (FatSplit name (nil int))
        (FatSplit (take name k) (drop name (add k 1))))))

; Where the last dot of s is, from i, or best.
(def fat_last_dot ((s (list int)) (i int) (best int)) int
  (if (is_empty s) best (fat_last_dot (tail s) (add i 1) (if (eq (head s) 46) i best))))

; Whether s has no letters of two cases: what the NT byte can say.
(def fat_one_case ((s (list int))) bool
  (not (and (fat_has_lower s) (fat_has_upper s))))

; Whether name is 8.3 that a short entry alone can hold: a base of 1 to
; 8 and an extension of up to 3 of short names' bytes, one dot at most,
; and each part in one case.
(def fat_fits_short ((name (list int))) bool
  (match (fat_split name)
    ((FatSplit base ext)
      (if (or (is_empty base) (gt (length base) 8)) false
          (gt (length ext) 3) false
          (and (and (fat_short_chars base) (fat_short_chars ext))
               (and (fat_one_case base) (fat_one_case ext)))))))

; The 11 bytes of the short name name is, uppercased, which
; fat_fits_short says it may be.
(def fat_short_of ((name (list int))) (list int)
  (match (fat_split name)
    ((FatSplit base ext) (append (fat_space_pad (fat_upper base) 8) (fat_space_pad (fat_upper ext) 3)))))

; The NT byte for name, which fat_fits_short says may be short: its
; lowercase parts.
(def fat_nt_of ((name (list int))) int
  (match (fat_split name)
    ((FatSplit base ext)
      (bit_or (if (fat_has_lower base) (fat_nt_base) 0) (if (fat_has_lower ext) (fat_nt_ext) 0)))))

; The short name's checksum, which each of its long name's slots holds:
; over its 11 bytes, a rotate right and an add each.
(def fat_checksum ((s (list int))) int
  (fat_checksum_onto s 0))

; fat_checksum's loop: sum, and the bytes of s after it.
(def fat_checksum_onto ((s (list int)) (sum int)) int
  (if (is_empty s)
      sum
      (fat_checksum_onto (tail s)
        (bit_and (add (add (bit_shl (bit_and sum 1) 7) (bit_shr sum 1)) (head s)) 255))))

; A long name's own bytes kept for an alias: uppercased, those a short
; name may not hold made _, spaces and dots dropped.
(def fat_alias_chars ((s (list int))) (list int)
  (if (is_empty s)
      s
      (let c (fat_up (head s))
        (if (any_eq c " .")
            (fat_alias_chars (tail s))
            (cons (if (fat_short_char c) c 95) (fat_alias_chars (tail s)))))))

; The alias of name with tail ~n: its base's first bytes, as many as
; leave room for ~n in 8, and its extension's first 3.
(def fat_alias ((name (list int)) (n int)) (list int)
  (match (fat_split name)
    ((FatSplit base ext)
      (let (t (cons 126 (digits n)) b (fat_alias_chars base))
        (append (fat_space_pad (append (take (if (is_empty b) "_" b) (sub 8 (length t))) t) 8)
                (fat_space_pad (take (fat_alias_chars ext) 3) 3))))))

; The first alias of name, from ~n, that none of taken is.
(def fat_alias_free ((name (list int)) (n int) (taken (list (list int)))) (list int)
  (let a (fat_alias name n)
    (if (and (ge (index_of a taken) 0) (lt n 999999))
        (fat_alias_free name (add n 1) taken)
        a)))

; The name a short entry's 11 bytes s spell, with the NT byte nt: the
; base and the extension trimmed, joined by a dot if there is one, each
; in lowercase if nt says; a first byte of 05 is E5.
(def fat_short_name ((s (list int)) (nt int)) (list int)
  (let (s2 (if (eq (head s) 5) (cons 229 (tail s)) s)
        base (fat_trim (take s2 8))
        ext (fat_trim (drop s2 8))
        b (if (eq (bit_and nt (fat_nt_base)) 0) base (fat_lower base))
        e (if (eq (bit_and nt (fat_nt_ext)) 0) ext (fat_lower ext)))
    (if (is_empty e) b (append b (cons 46 e)))))

; How many slots name's long name takes: none for a short one.
(def fat_lfn_count ((name (list int))) int
  (if (fat_fits_short name) 0 (ceil_div (length name) 13)))

; --------------------------------------------------------------- the time

; The FAT date and time of Unix time ms, in UTC: a date's year from
; 1980, its month and day; a time's hours, minutes and two seconds. Any
; time before 1980 is its first moment.
(data FatTime (FatTime int int))

; The date of ms and its time.
(def fat_time_of ((ms int)) FatTime
  (let secs (div ms 1000)
    (if (lt secs 315532800)
        (FatTime 33 0)
        (let (days (div secs 86400) rem (mod secs 86400))
          (FatTime (fat_date_of_days days)
                   (bit_or (bit_shl (div rem 3600) 11)
                           (bit_or (bit_shl (div (mod rem 3600) 60) 5) (div (mod rem 60) 2))))))))

; The FAT date of the day days after 1970-01-01, as Howard Hinnant's
; civil_from_days reckons the year, month and day.
(def fat_date_of_days ((days int)) int
  (let (z (add days 719468)
        era (div z 146097)
        doe (sub z (mul era 146097))
        yoe (div (sub (add (sub doe (div doe 1460)) (div doe 36524)) (div doe 146096)) 365)
        doy (sub doe (sub (add (mul 365 yoe) (div yoe 4)) (div yoe 100)))
        mp (div (add (mul 5 doy) 2) 153)
        d (add (sub doy (div (add (mul 153 mp) 2) 5)) 1)
        m (if (lt mp 10) (add mp 3) (sub mp 9))
        y (add (add yoe (mul era 400)) (if (le m 2) 1 0)))
    (bit_or (bit_shl (sub y 1980) 9) (bit_or (bit_shl m 5) d))))

; ----------------------------------------------------------------- layout

; Where a volume keeps things: its sectors, sectors a cluster, reserved
; sectors, FATs, sectors a FAT, the root directory's first cluster, its
; clusters of data, its serial number, and where FSInfo and the boot
; sector's backup are (0 for none).
(data FatGeom (FatGeom (sectors int) (spc int) (reserved int) (nfats int) (fatsz int) (root int) (clusters int) (serial int) (fsinfo_at int) (backup_at int)))

; A cluster's bytes; the first sector of the data; and the sector, of
; the volume, cluster c begins at.
(def fat_cluster_bytes ((g FatGeom)) int (mul (.spc g) (fat_sector)))
(def fat_data_at ((g FatGeom)) int (add (.reserved g) (mul (.nfats g) (.fatsz g))))
(def fat_cluster_at ((g FatGeom) (c int)) int (add (fat_data_at g) (mul (sub c 2) (.spc g))))

; How many slots a cluster of a directory holds.
(def fat_dir_slots ((g FatGeom)) int (div (fat_cluster_bytes g) (fat_slot_size)))

; The geometry mkfs gives a volume of n sectors, serial ser: sectors a
; cluster as mkfs.fat picks them, by its size; 32 reserved, more if
; that aligns the data to a cluster; two FATs as long as the clusters
; need; the root at cluster 2.
(def fat_layout ((n int) (ser int)) FatGeom
  (let (spc (fat_spc_for n)
        fs (ceil_div (mul (add (div (sub n 32) spc) 2) 4) (fat_sector))
        r (add 32 (mod (sub spc (mod (add 32 (mul 2 fs)) spc)) spc)))
    (FatGeom n spc r 2 fs 2 (div (sub (sub n r) (mul 2 fs)) spc) ser 1 6)))

; Sectors a cluster for a volume of n sectors: 1 below 260 MB, 8 below
; 8 GB, 16 below 16 GB, 32 below 32 GB, else 64.
(def fat_spc_for ((n int)) int
  (if (lt n 532480) 1 (lt n 16777216) 8 (lt n 33554432) 16 (lt n 67108864) 32 64))

; Whether a layout can be a FAT32 volume: clusters enough to be one,
; not more than are read here, and a FAT long enough for them.
(def fat_layout_ok ((g FatGeom)) bool
  (if (lt (.clusters g) (fat_min_clusters)) false
      (gt (.clusters g) (fat_max_clusters)) false
      (ge (mul (.fatsz g) (fat_marks)) (add (.clusters g) 2))))

; Why a layout cannot be one, which fat_layout_ok says it cannot.
(def fat_layout_why ((g FatGeom)) (list int)
  (if (lt (.clusters g) (fat_min_clusters))
      "too small for FAT32, which needs at least 33 MB"
      "too large: FAT32 volumes of up to 2M clusters are read here"))

; ------------------------------------------------------------ boot sector

; The boot sector of a new volume, its partition from sector start,
; labelled label: a jump past the BPB to a halt, the BPB, and 55 AA.
(def fat_boot_new ((g FatGeom) (start int) (label (list int))) bytes
  (match g
    ((FatGeom n spc r nf fs root c ser fi bk)
      (bytes_from_list
        (concat
          (cons (cons 235 (cons 88 (cons 144 (nil int))))
          (cons "L0S     "
          (cons (le16 (fat_sector))
          (cons (cons spc (nil int))
          (cons (le16 r)
          (cons (cons nf (cons 0 (cons 0 (cons 0 (cons 0 (cons 248 (cons 0 (cons 0 (nil int)))))))))
          (cons (le16 32)
          (cons (le16 64)
          (cons (u32_le start)
          (cons (u32_le n)
          (cons (u32_le fs)
          (cons (zeros 4)
          (cons (u32_le root)
          (cons (le16 fi)
          (cons (le16 bk)
          (cons (zeros 12)
          (cons (cons 128 (cons 0 (cons 41 (nil int))))
          (cons (u32_le ser)
          (cons (fat_space_pad label 11)
          (cons "FAT32   "
          (cons (cons 244 (cons 235 (cons 253 (nil int))))
          (cons (zeros 417)
          (cons (cons 85 (cons 170 (nil int)))
                (nil (list int))))))))))))))))))))))))))))))

; A boot sector read: its geometry and label, the BPB's, empty for none;
; or why it is no FAT32 volume's.
(data FatBoot (FatBoot FatGeom (list int)) (FatNotBoot (list int)))

; The volume whose boot sector is b.
(def fat_boot_of ((b bytes)) FatBoot
  (if (lt (bytes_len b) (fat_sector))
      (FatNotBoot "a boot sector is a sector")
      (bytes_is_at b 3 "EXFAT   ") (FatNotBoot "exFAT, not FAT32")
      (bytes_is_at b 3 "NTFS    ") (FatNotBoot "NTFS, not FAT32")
      (not (and (eq (bytes_get b 510) 85) (eq (bytes_get b 511) 170))) (FatNotBoot "no FAT32 volume")
      (fat_boot_bpb b)))

; fat_boot_of past the signature: sectors of 512 bytes, a power of two
; of them a cluster, no root entries and a FAT's sectors in 32 bits, as
; FAT32's BPB has.
(def fat_boot_bpb ((b bytes)) FatBoot
  (let spc (bytes_get b 13)
    (if (not (eq (le_u16_at b 11) (fat_sector)))
        (FatNotBoot "a FAT volume of sectors other than 512 bytes")
        (not (any_eq spc (cons 1 (cons 2 (cons 4 (cons 8 (cons 16 (cons 32 (cons 64 (nil int))))))))))
        (FatNotBoot "a FAT volume whose clusters are not 512 bytes to 32 KB")
        (or (not (eq (le_u16_at b 17) 0)) (not (eq (le_u16_at b 22) 0)))
        (FatNotBoot "FAT12 or FAT16, not FAT32")
        (fat_boot_geom b spc))))

; fat_boot_bpb's rest: the geometry its fields give, if it is one.
(def fat_boot_geom ((b bytes) (spc int)) FatBoot
  (let (n (if (eq (le_u16_at b 19) 0) (le_u32 b 32) (le_u16_at b 19))
        r (le_u16_at b 14)
        nf (bytes_get b 16)
        fs (le_u32 b 36)
        c (div (sub (sub n r) (mul nf fs)) spc)
        g (FatGeom n spc r nf fs (le_u32 b 44) c (le_u32 b 67) (le_u16_at b 48) (le_u16_at b 50)))
    (if (or (lt r 1) (or (lt nf 1) (gt nf 2))) (FatNotBoot "a FAT volume of a bad layout")
        (lt c (fat_min_clusters)) (FatNotBoot "FAT12 or FAT16, not FAT32")
        (not (fat_layout_ok g)) (FatNotBoot (fat_layout_why g))
        (not (and (ge (.root g) 2) (lt (.root g) (add c 2)))) (FatNotBoot "a FAT32 volume with no root directory")
        (FatBoot g (if (eq (bytes_get b 66) 41) (fat_label_text (bytes_range b 71 82)) "")))))

; The label 11 bytes spell: trimmed, empty for NO NAME.
(def fat_label_text ((s (list int))) (list int)
  (let t (fat_trim s)
    (if (eq t "NO NAME") "" t)))

; The label a volume is mounted at, of label as read and the serial: a
; byte label_ok refuses made _, or FAT-XXXXXXXX, of the serial, if it is
; empty.
(def fat_mount_label ((label (list int)) (ser int)) (list int)
  (if (is_empty label)
      (append "FAT-" (fat_upper (hex_digits ser 8)))
      (fat_label_safe label)))

; s with every byte label_ok refuses made _.
(def fat_label_safe ((s (list int))) (list int)
  (if (is_empty s)
      s
      (cons (if (label_chars (cons (head s) (nil int))) (head s) 95) (fat_label_safe (tail s)))))

; FSInfo, as its sector holds it: its signatures, free clusters, and the
; hint of where to look for one.
(def fat_fsinfo ((free int) (next int)) bytes
  (bytes_from_list
    (append (u32_le 1096897106)                ; RRaA
      (append (zeros 480)
        (append (u32_le 1631679090)            ; rrAa
          (append (u32_le free)
            (append (u32_le next)
              (append (zeros 12) (u32_le 2857697280)))))))))   ; 00 00 55 AA

; ------------------------------------------------------------------ table

; The FAT, a sector's marks an array, as many sectors as the clusters,
; 0 and 1 too, take.
(def fat_tab_new ((g FatGeom)) (array (array int))
  (array_new (ceil_div (add (.clusters g) 2) (fat_marks)) (array_new (fat_marks) 0)))

; Cluster c's mark.
(def fat_get ((t (array (array int))) (c int)) int
  (array_get (array_get t (div c (fat_marks))) (mod c (fat_marks))))

; t with cluster c's mark x.
(def fat_set ((t (array (array int))) (c int) (x int)) (array (array int))
  (let k (div c (fat_marks))
    (array_set t k (array_set (array_get t k) (mod c (fat_marks)) x))))

; The table whose first copy's sectors are b: every mark, its low 28
; bits.
(def fat_tab_of ((g FatGeom) (b bytes)) (array (array int))
  (fat_tab_read b (fat_tab_new g) 0))

; fat_tab_of's loop: t with the sectors from k read from b.
(def fat_tab_read ((b bytes) (t (array (array int))) (k int)) (array (array int))
  (if (ge k (array_len t))
      t
      (fat_tab_read b (array_set t k (fat_chunk_of b (mul k (fat_sector)) (array_new (fat_marks) 0) 0)) (add k 1))))

; The marks of the sector of the FAT at byte at of b, into a from i.
(def fat_chunk_of ((b bytes) (at int) (a (array int)) (i int)) (array int)
  (if (ge i (fat_marks))
      a
      (fat_chunk_of b at (array_set a i (bit_and (le_u32 b (add at (mul i 4))) (fat_mask))) (add i 1))))

; Sector k of the FAT, as bytes.
(def fat_tab_sector ((t (array (array int))) (k int)) bytes
  (bytes_from_list (rev (fat_chunk_push (array_get t k) 0 (nil int)))))

; The marks of a from i, onto acc.
(def fat_chunk_push ((a (array int)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len a)) acc (fat_chunk_push a (add i 1) (push (u32_le (array_get a i)) acc))))

; Whether c is a data cluster of g's: from 2, up to its clusters.
(def fat_is_data ((g FatGeom) (c int)) bool
  (and (ge c 2) (lt c (add (.clusters g) 2))))

; The clusters of the chain from first, in order, at most as many as
; there are: it stops at a mark that is no data cluster.
(def fat_chain ((g FatGeom) (t (array (array int))) (first int)) (list int)
  (rev (fat_chain_onto g t first (.clusters g) (nil int))))

; fat_chain's loop: c and those after it, at most left, onto acc.
(def fat_chain_onto ((g FatGeom) (t (array (array int))) (c int) (left int) (acc (list int))) (list int)
  (if (or (not (fat_is_data g c)) (le left 0))
      acc
      (fat_chain_onto g t (fat_get t c) (sub left 1) (cons c acc))))

; How many clusters are free.
(def fat_count_free ((g FatGeom) (t (array (array int)))) int
  (fat_free_from t 2 (add (.clusters g) 2) 0))

; n, and the free clusters from c up to e.
(def fat_free_from ((t (array (array int))) (c int) (e int) (n int)) int
  (if (ge c e) n (fat_free_from t (add c 1) e (if (eq (fat_get t c) 0) (add n 1) n))))

; ----------------------------------------------------------------- volume

; What a change dirtied, to be written: the FAT's sectors by their place
; in a copy, the directories' slots, and whether the boot sector did.
(data FatDirty (FatDirty (list int) (list VolRef) bool))

; Nothing dirtied.
(def fat_clean_dirty () FatDirty (FatDirty (nil int) (nil VolRef) false))

; A volume, as memory holds it: its label, its geometry, the FAT, each
; directory's slots by its first cluster, the free clusters and where
; to look for one first, what is dirty, its boot sector's bytes, and the
; Unix time, in ms, of clock_ns 0, for fs to date changes by.
(data FatVol (FatVol (label (list int)) (geom FatGeom) (tab (array (array int))) (dirs (Map int (array bytes))) (free int) (hint int) (dirty FatDirty) (bt bytes) (epoch int)))

; v with nothing dirty: once what was is written.
(def fat_cleaned ((v FatVol)) FatVol
  (.dirty v (fat_clean_dirty)))

; The root directory's first cluster; a cluster's bytes.
(def fat_root ((v FatVol)) int (.root (.geom v)))
(def fat_csize ((v FatVol)) int (fat_cluster_bytes (.geom v)))

; The slots of directory dc; none if it is no directory of v's.
(def fat_dir ((v FatVol) (dc int)) (array bytes)
  (match (map_get (.dirs v) dc)
    ((Some d) d)
    ((None) (array_new 0 (bytes_from_list (nil int))))))

; Whether dc is one of v's directories.
(def fat_is_dir ((v FatVol) (dc int)) bool
  (map_has (.dirs v) dc))

; A free slot's bytes.
(def fat_zero_slot () bytes (bytes_from_list (zeros 32)))

; A new directory's slots: a cluster of free ones, ".", its own cluster
; c, and "..", its parent's, 0 for the root, first unless it is the root.
(def fat_dir_new ((g FatGeom) (c int) (parent int) (tm FatTime)) (array bytes)
  (let d (array_new (fat_dir_slots g) (fat_zero_slot))
    (if (lt parent 0)
        d
        (array_set (array_set d 0 (fat_short_slot (fat_space_pad "." 11) 0 (fat_attr_dir) c 0 tm))
                   1 (fat_short_slot (fat_space_pad ".." 11) 0 (fat_attr_dir) parent 0 tm)))))

; A new, empty volume of g on a partition from start, labelled label,
; at Unix time ms: the root directory, cluster 2, holding the label.
(def fat_new ((g FatGeom) (start int) (label (list int)) (ms int)) FatVol
  (let (tm (fat_time_of ms)
        t (fat_set (fat_set (fat_set (fat_tab_new g) 0 268435448) 1 (fat_end)) (.root g) (fat_end))
        root (array_set (fat_dir_new g (.root g) -1 tm) 0
                        (fat_short_slot (fat_space_pad label 11) 0 (fat_attr_label) 0 0 tm)))
    (FatVol label g t (map_put ((MapEmpty int (array bytes))) (.root g) root)
            (sub (.clusters g) 1) 3 (fat_clean_dirty) (fat_boot_new g start label) 0)))

; v emptied, its geometry, label, serial and boot sector kept.
(def fat_format ((v FatVol)) FatVol
  (match v
    ((FatVol l g t ds fr nx d bt ep)
      (let (tm (fat_time_of 0)
            t2 (fat_set (fat_set (fat_set (fat_tab_new g) 0 268435448) 1 (fat_end)) (.root g) (fat_end))
            root (array_set (fat_dir_new g (.root g) -1 tm) 0
                            (fat_short_slot (fat_space_pad l 11) 0 (fat_attr_label) 0 0 tm)))
        (FatVol l g t2 (map_put ((MapEmpty int (array bytes))) (.root g) root)
                (sub (.clusters g) 1) 3 (fat_clean_dirty) bt ep)))))

; ---------------------------------------------------------------- slots

; A short entry's slot: its 11 bytes, NT byte, attributes, first
; cluster, size, and its times, created and written, all tm.
(def fat_short_slot ((s (list int)) (nt int) (attr int) (first int) (size int) (tm FatTime)) bytes
  (match tm
    ((FatTime date time)
      (bytes_from_list
        (append s
          (append (cons attr (cons nt (cons 0 (nil int))))
            (append (le16 time)
              (append (le16 date)
                (append (le16 date)
                  (append (le16 (bit_shr first 16))
                    (append (le16 time)
                      (append (le16 date)
                        (append (le16 (bit_and first 65535)) (u32_le size))))))))))))))

; What a slot holds: the end, and every slot after it, free; a free
; slot; a long name's piece; a volume's label; . or ..; or a short
; entry.
(def fat_kind ((b bytes)) int
  (let c (bytes_get b 0)
    (if (eq c 0) 0
        (eq c 229) 1
        (let a (bytes_get b 11)
          (if (eq (bit_and a 63) (fat_attr_lfn)) 2
              (not (eq (bit_and a (fat_attr_label)) 0)) 3
              (eq c 46) 4
              5)))))

; Whether a slot is free: the end or after it, or freed.
(def fat_slot_free ((b bytes)) bool (lt (fat_kind b) 2))

; Whether a slot is a short entry, of a file or a directory.
(def fat_slot_short ((b bytes)) bool (eq (fat_kind b) 5))

; A short entry's 11 bytes, first cluster, size, and whether it is a
; directory.
(def fat_slot_name83 ((b bytes)) (list int) (bytes_range b 0 11))
(def fat_slot_first ((b bytes)) int (bit_or (bit_shl (le_u16_at b 20) 16) (le_u16_at b 26)))
(def fat_slot_size_of ((b bytes)) int (le_u32 b 28))
(def fat_slot_is_dir ((b bytes)) bool (not (eq (bit_and (bytes_get b 11) (fat_attr_dir)) 0)))

; b, a short entry, with first cluster c, size n, and written at tm.
(def fat_slot_with ((b bytes) (c int) (n int) (tm FatTime)) bytes
  (match tm
    ((FatTime date time)
      (fat_put32 (fat_put16 (fat_put16 (fat_put16 (fat_put16 b 20 (bit_shr c 16)) 22 time) 24 date) 26 (bit_and c 65535)) 28 n))))

; A long name's slot: sequence k, the last's flagged 40, the short
; name's checksum, and 13 of the name's characters from the (k-1)th
; thirteen, a 0 after its last and FFFF after that.
(def fat_lfn_slot ((name (list int)) (k int) (last bool) (sum int)) bytes
  (let cs (fat_lfn_chars (drop name (mul (sub k 1) 13)) 13 false (nil int))
    (bytes_from_list
      (append (cons (if last (bit_or k 64) k) (nil int))
        (append (take cs 10)
          (append (cons (fat_attr_lfn) (cons 0 (cons sum (nil int))))
            (append (take (drop cs 10) 12)
              (append (zeros 2) (drop cs 22)))))))))

; n characters of s as UCS-2, each byte a character: then a 0, and FFFF
; after it, onto acc.
(def fat_lfn_chars ((s (list int)) (n int) (ended bool) (acc (list int))) (list int)
  (if (eq n 0)
      (rev acc)
      (not (is_empty s)) (fat_lfn_chars (tail s) (sub n 1) false (cons 0 (cons (head s) acc)))
      ended (fat_lfn_chars s (sub n 1) true (cons 255 (cons 255 acc)))
      (fat_lfn_chars s (sub n 1) true (cons 0 (cons 0 acc)))))

; The 13 characters a long name's slot holds, at their places in it,
; their UCS-2 values: those of 5, 6 and 2 from 1, 14 and 28.
(def fat_lfn_values ((b bytes)) (list int)
  (append (fat_u16s b 1 5) (append (fat_u16s b 14 6) (fat_u16s b 28 2))))

; n u16s of b from i.
(def fat_u16s ((b bytes) (i int) (n int)) (list int)
  (if (eq n 0) (nil int) (cons (le_u16_at b i) (fat_u16s b (add i 2) (sub n 1)))))

; The long name of the short entry at slot i of d, its checksum sum: the
; slots before it, sequence 1 first, each of the checksum, up to one
; flagged last; the characters up to a 0. Or none, for no long name, or
; one whose pieces do not agree.
(data FatLong (FatLong (list int) int) (FatNoLong) (FatUnspelt int))

; The long name of slot i of d, as FatLong says: the name and its
; slots' count; none; or one of a character L0S cannot spell, only how
; many slots it takes.
(def fat_long_of ((d (array bytes)) (i int)) FatLong
  (fat_long_from d (sub i 1) 1 (fat_checksum (fat_slot_name83 (array_get d i))) (nil (list int))))

; fat_long_of's loop: slot j, the kth of the name, onto acc.
(def fat_long_from ((d (array bytes)) (j int) (k int) (sum int) (acc (list (list int)))) FatLong
  (if (or (lt j 0) (gt k 20))
      (FatNoLong)
      (let b (array_get d j)
        (if (not (and (eq (fat_kind b) 2) (and (eq (bit_and (bytes_get b 0) 31) k) (eq (bytes_get b 13) sum))))
            (FatNoLong)
            (let acc2 (cons (fat_lfn_values b) acc)
              (if (eq (bit_and (bytes_get b 0) 64) 0)
                  (fat_long_from d (sub j 1) (add k 1) sum acc2)
                  (fat_spelt (fat_upto0 (fat_concat (rev acc2))) k)))))))

; xss joined, in order.
(def fat_concat ((xss (list (list int)))) (list int)
  (if (is_empty xss) (nil int) (append (head xss) (fat_concat (tail xss)))))

; s up to its first 0.
(def fat_upto0 ((s (list int))) (list int)
  (if (is_empty s) s (eq (head s) 0) (nil int) (cons (head s) (fat_upto0 (tail s)))))

; The long name of the values s, k slots: unspelt if one is not ASCII.
(def fat_spelt ((s (list int)) (k int)) FatLong
  (if (fat_ascii s) (FatLong s k) (FatUnspelt k)))

; Whether every one of s is printable ASCII.
(def fat_ascii ((s (list int))) bool
  (if (is_empty s) true (is_printable (head s)) (fat_ascii (tail s)) false))

; How many slots before slot i of d its long name takes.
(def fat_long_count ((d (array bytes)) (i int)) int
  (match (fat_long_of d i) ((FatLong s k) k) ((FatNoLong) 0) ((FatUnspelt k) k)))

; The name of the short entry at slot i of d: its long name, or its
; short one; empty if L0S cannot spell it.
(def fat_name_at ((d (array bytes)) (i int)) (list int)
  (match (fat_long_of d i)
    ((FatLong s k) s)
    ((FatUnspelt k) (nil int))
    ((FatNoLong)
      (let (b (array_get d i) n (fat_short_name (fat_slot_name83 b) (bytes_get b 12)))
        (if (fat_ascii n) n (nil int))))))

; The entry slot i of d is, as l0fs.l0's: a file, a directory, or none
; for any other slot, or a name L0S cannot spell or path, which is kept
; but not seen.
(def fat_entry_at ((d (array bytes)) (i int)) VolEntry
  (if (or (lt i 0) (ge i (array_len d)))
      (VolNone)
      (let b (array_get d i)
        (if (not (fat_slot_short b))
            (VolNone)
            (let name (fat_name_at d i)
              (if (not (fat_name_ok name)) (VolNone)
                  (fat_slot_is_dir b) (VolDir name (fat_slot_first b))
                  (VolFile name (fat_slot_size_of b) (fat_slot_first b) false)))))))

; ---------------------------------------------------------------- entries

; The entry r is.
(def fat_entry ((v FatVol) (r VolRef)) VolEntry
  (match r ((VolRef dc i) (fat_entry_at (fat_dir v dc) i))))

; Where name is among directory dc's entries, ignoring case, or -1.
(def fat_find ((v FatVol) (dc int) (name (list int))) int
  (fat_find_from (fat_dir v dc) (fat_lower name) 0))

; fat_find's loop, from slot i.
(def fat_find_from ((d (array bytes)) (low (list int)) (i int)) int
  (if (ge i (array_len d))
      -1
      (eq (fat_kind (array_get d i)) 0) -1
      (and (fat_slot_short (array_get d i)) (eq (fat_lower (fat_name_at d i)) low)) i
      (fat_find_from d low (add i 1))))

; The directory names lead to from dc, or -1.
(def fat_dir_at ((v FatVol) (dc int) (names (list (list int)))) int
  (if (is_empty names)
      dc
      (let i (fat_find v dc (head names))
        (if (lt i 0)
            -1
            (match (fat_entry v (VolRef dc i))
              ((VolDir name first) (fat_dir_at v (if (eq first 0) (fat_root v) first) (tail names)))
              ((VolFile name size first exec) -1)
              ((VolNone) -1))))))

; Where names lead in v, from its root, as vol_place says.
(def fat_place ((v FatVol) (names (list (list int)))) VolPlace
  (if (is_empty names)
      (VolTop)
      (let dc (fat_dir_at v (fat_root v) (drop_last names))
        (if (lt dc 0) (VolNowhere) (VolIn dc (last names))))))

; The first clusters of the directories in directory dc.
(def fat_subdirs ((v FatVol) (dc int)) (list int)
  (fat_subdirs_from (fat_dir v dc) 0 (nil int)))

; fat_subdirs's loop, from slot i, onto acc: every directory's, spelt or
; not.
(def fat_subdirs_from ((d (array bytes)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len d))
      (rev acc)
      (let b (array_get d i)
        (fat_subdirs_from d (add i 1)
          (if (and (fat_slot_short b) (and (fat_slot_is_dir b) (gt (fat_slot_first b) 0)))
              (cons (fat_slot_first b) acc)
              acc)))))

; Whether directory dc of v is c or in it.
(def fat_under ((v FatVol) (c int) (dc int)) bool
  (if (eq c dc) true (fat_under_any v (fat_subdirs v c) dc)))

; Whether dc is any of cs or in one of them.
(def fat_under_any ((v FatVol) (cs (list int)) (dc int)) bool
  (if (is_empty cs) false (fat_under v (head cs) dc) true (fat_under_any v (tail cs) dc)))

; Whether directory dc has no entries but . and ..: none, spelt or not.
(def fat_dir_empty ((v FatVol) (dc int)) bool
  (fat_none_from (fat_dir v dc) 0))

; Whether no slot of d from i is a short entry.
(def fat_none_from ((d (array bytes)) (i int)) bool
  (if (ge i (array_len d)) true (fat_slot_short (array_get d i)) false (fat_none_from d (add i 1))))

; The entries of directory dc, by name.
(def fat_listing ((v FatVol) (dc int)) (list VolEntry)
  (vol_unnamed (sort (fat_named_from (fat_dir v dc) 0 (nil VolNamed)))))

; Each entry of d from slot i, by its name, onto acc.
(def fat_named_from ((d (array bytes)) (i int) (acc (list VolNamed))) (list VolNamed)
  (if (ge i (array_len d))
      acc
      (let e (fat_entry_at d i)
        (fat_named_from d (add i 1) (if (vol_entry_used e) (cons (VolNamed (vol_entry_name e) e) acc) acc)))))

; How many files v has, in every directory.
(def fat_file_count ((v FatVol)) int
  (fat_files_in (map_values (.dirs v)) 0))

; n and the files of every directory of ds.
(def fat_files_in ((ds (list (array bytes))) (n int)) int
  (if (is_empty ds) n (fat_files_in (tail ds) (fat_files_from (head ds) 0 n))))

; n and the files among the slots of d from i.
(def fat_files_from ((d (array bytes)) (i int) (n int)) int
  (if (ge i (array_len d))
      n
      (let b (array_get d i)
        (fat_files_from d (add i 1) (if (and (fat_slot_short b) (not (fat_slot_is_dir b))) (add n 1) n)))))

; The short names of directory d's entries, every one, for an alias.
(def fat_shorts ((d (array bytes)) (i int) (acc (list (list int)))) (list (list int))
  (if (ge i (array_len d))
      acc
      (fat_shorts d (add i 1) (if (fat_slot_short (array_get d i)) (cons (fat_slot_name83 (array_get d i)) acc) acc))))

; ------------------------------------------------------------- changing

; v with slot i of directory dc b, and its sector dirty.
(def fat_set_slot ((v FatVol) (dc int) (i int) (b bytes)) FatVol
  (match v
    ((FatVol l g t ds fr nx d bt ep)
      (match (map_get ds dc)
        ((None) v)
        ((Some dir)
          (match d
            ((FatDirty ks rs boot)
              (FatVol l g t (map_put ds dc (array_set dir i b)) fr nx (FatDirty ks (cons (VolRef dc i) rs) boot) bt ep))))))))

; v with cluster c's mark x, its FAT sector dirty, and the free count
; kept.
(def fat_mark ((v FatVol) (c int) (x int)) FatVol
  (match v
    ((FatVol l g t ds fr nx d bt ep)
      (let (old (fat_get t c) fr2 (add fr (sub (if (eq x 0) 1 0) (if (eq old 0) 1 0))))
        (match d
          ((FatDirty ks rs boot)
            (FatVol l g (fat_set t c x) ds fr2 nx (FatDirty (cons (div c (fat_marks)) ks) rs boot) bt ep)))))))

; cs linked in order, the last to the end.
(def fat_link ((v FatVol) (cs (list int))) FatVol
  (if (is_empty cs)
      v
      (fat_link (fat_mark v (head cs) (if (is_empty (tail cs)) (fat_end) (head (tail cs)))) (tail cs))))

; cs free again.
(def fat_unlink ((v FatVol) (cs (list int))) FatVol
  (if (is_empty cs) v (fat_unlink (fat_mark v (head cs) 0) (tail cs))))

; The chain from first freed.
(def fat_unchain ((v FatVol) (first int)) FatVol
  (fat_unlink v (fat_chain (.geom v) (.tab v) first)))

; n free clusters taken and linked: the volume and them; or none.
(data FatAlloc (FatAlloc FatVol (list int)) (FatFull))

; n free clusters of v, from its hint on, round to it, linked.
(def fat_alloc ((v FatVol) (n int)) FatAlloc
  (if (gt n (.free v))
      (FatFull)
      (match v
        ((FatVol l g t ds fr nx d bt ep)
          (let (e (add (.clusters g) 2) cs (fat_free_n t (if (fat_is_data g nx) nx 2) e n 0 (nil int)))
            (if (lt (length cs) n)
                (FatFull)
                (let nx2 (add (last cs) 1)
                  (FatAlloc (fat_link (FatVol l g t ds fr (if (lt nx2 e) nx2 2) d bt ep) cs) cs))))))))

; Up to n free clusters from c, wrapping once from e to 2, onto acc.
(def fat_free_n ((t (array (array int))) (c int) (e int) (n int) (seen int) (acc (list int))) (list int)
  (if (or (le n 0) (ge seen (sub e 2)))
      (rev acc)
      (let c2 (if (ge c e) 2 c)
        (if (eq (fat_get t c2) 0)
            (fat_free_n t (add c2 1) e (sub n 1) (add seen 1) (cons c2 acc))
            (fat_free_n t (add c2 1) e n (add seen 1) acc)))))

; Every slot of the cluster k of directory dc dirty: a slot a sector.
(def fat_dirty_cluster ((v FatVol) (dc int) (k int)) FatVol
  (fat_dirty_from v dc (mul k (fat_dir_slots (.geom v))) (fat_dir_slots (.geom v))))

; Slots from i, n more of them, a sector's at a time, dirty.
(def fat_dirty_from ((v FatVol) (dc int) (i int) (n int)) FatVol
  (if (le n 0)
      v
      (match v
        ((FatVol l g t ds fr nx d bt ep)
          (match d
            ((FatDirty ks rs boot)
              (fat_dirty_from (FatVol l g t ds fr nx (FatDirty ks (cons (VolRef dc i) rs) boot) bt ep)
                              dc (add i (fat_slots_per_sector)) (sub n (fat_slots_per_sector)))))))))

; A place made in a directory for a name: the volume and the slot of its
; short entry, after those of its long name; or no room to grow.
(data FatSlot (FatSlot FatVol VolRef) (FatNoSlot))

; Room in directory dc for name: as many free slots together as its
; long name and short entry take, before the directory's end, or from
; it; the directory grown by clusters of free slots if it has not.
(def fat_slot ((v FatVol) (dc int) (name (list int))) FatSlot
  (let (need (add (fat_lfn_count name) 1) d (fat_dir v dc) i (fat_run d 0 0 need))
    (if (ge i 0)
        (FatSlot v (VolRef dc (add i (sub need 1))))
        (let s (fat_tail_start d (fat_end_at d 0))
          (if (le (add s need) (array_len d))
              (FatSlot v (VolRef dc (add s (sub need 1))))
              (fat_grow v dc (ceil_div (sub (add s need) (array_len d)) (fat_dir_slots (.geom v))) s need))))))

; The first slot of need free ones together in d before its end, from
; slot i, run of them so far; or -1.
(def fat_run ((d (array bytes)) (i int) (run int) (need int)) int
  (if (ge run need)
      (sub i run)
      (ge i (array_len d))
      -1
      (let k (fat_kind (array_get d i))
        (if (eq k 0)
            -1
            (fat_run d (add i 1) (if (eq k 1) (add run 1) 0) need)))))

; The first slot of d that ends it, 00, from i; its length if none does.
(def fat_end_at ((d (array bytes)) (i int)) int
  (if (ge i (array_len d)) i (eq (fat_kind (array_get d i)) 0) i (fat_end_at d (add i 1))))

; The first of the free slots that run up to e, so that the end's slots
; join those freed before them.
(def fat_tail_start ((d (array bytes)) (e int)) int
  (if (le e 0) 0 (eq (fat_kind (array_get d (sub e 1))) 1) (fat_tail_start d (sub e 1)) e))

; Directory dc grown by n clusters of free slots, and the slot of a
; name's short entry, need slots from s.
(def fat_grow ((v FatVol) (dc int) (n int) (s int) (need int)) FatSlot
  (match (fat_alloc v n)
    ((FatFull) (FatNoSlot))
    ((FatAlloc v2 cs)
      (let (chain (fat_chain (.geom v2) (.tab v2) dc)
            before (length chain)
            v3 (fat_mark v2 (last chain) (head cs)))
        (match v3
          ((FatVol l g t ds fr nx d bt ep)
            (let (dir (fat_dir v3 dc)
                  v4 (FatVol l g t (map_put ds dc (array_resize dir (add (array_len dir) (mul n (fat_dir_slots g))) (fat_zero_slot))) fr nx d bt ep))
              (FatSlot (fat_dirty_new v4 dc before n) (VolRef dc (add s (sub need 1)))))))))))

; Every slot of clusters k to k + n - 1 of directory dc dirty.
(def fat_dirty_new ((v FatVol) (dc int) (k int) (n int)) FatVol
  (if (le n 0) v (fat_dirty_new (fat_dirty_cluster v dc k) dc (add k 1) (sub n 1))))

; v with name's slots written in its directory, the short entry at r,
; its long name before it: attr, first cluster, size, created at tm;
; its short name 8.3 if name is, else an alias no entry has.
(def fat_put_entry ((v FatVol) (r VolRef) (name (list int)) (attr int) (first int) (size int) (tm FatTime)) FatVol
  (match r
    ((VolRef dc i)
      (if (fat_fits_short name)
          (fat_set_slot v dc i (fat_short_slot (fat_short_of name) (fat_nt_of name) attr first size tm))
          (let s (fat_alias_free name 1 (fat_shorts (fat_dir v dc) 0 (nil (list int))))
            (fat_put_long (fat_set_slot v dc i (fat_short_slot s 0 attr first size tm))
                          dc (sub i 1) name 1 (fat_lfn_count name) (fat_checksum s)))))))

; The long name's slots, the kth at slot j, back to the first.
(def fat_put_long ((v FatVol) (dc int) (j int) (name (list int)) (k int) (n int) (sum int)) FatVol
  (if (gt k n)
      v
      (fat_put_long (fat_set_slot v dc j (fat_lfn_slot name k (eq k n) sum)) dc (sub j 1) name (add k 1) n sum)))

; v with a new, empty file name at r, made at Unix time ms.
(def fat_create ((v FatVol) (r VolRef) (name (list int)) (ms int)) FatVol
  (fat_put_entry v r name (fat_attr_archive) 0 0 (fat_time_of ms)))

; A directory made: the volume and its first cluster; or no room.
(data FatMade (FatMade FatVol int) (FatNoRoom))

; v with a new, empty directory name at r, of a cluster of its own,
; zeroed but for . and .., made at ms.
(def fat_mkdir ((v FatVol) (r VolRef) (name (list int)) (ms int)) FatMade
  (match (fat_alloc v 1)
    ((FatFull) (FatNoRoom))
    ((FatAlloc v2 cs)
      (let (c (head cs) tm (fat_time_of ms))
        (match r
          ((VolRef dc i)
            (match v2
              ((FatVol l g t ds fr nx d bt ep)
                (let v3 (FatVol l g t (map_put ds c (fat_dir_new g c (if (eq dc (.root g)) 0 dc) tm)) fr nx d bt ep)
                  (FatMade (fat_put_entry (fat_dirty_cluster v3 c 0) r name (fat_attr_dir) c 0 tm) c))))))))))

; Slots i down, n more of them, freed, E5.
(def fat_free_slots ((v FatVol) (dc int) (i int) (n int)) FatVol
  (if (le n 0)
      v
      (let b (array_get (fat_dir v dc) i)
        (fat_free_slots (fat_set_slot v dc i (fat_put b 0 (cons 229 (nil int)))) dc (sub i 1) (sub n 1)))))

; v with the entry at r gone, and its long name; its clusters freed, a
; directory's dropped.
(def fat_remove ((v FatVol) (r VolRef)) FatVol
  (match r
    ((VolRef dc i)
      (let (d (fat_dir v dc)
            b (array_get d i)
            first (fat_slot_first b)
            v2 (fat_free_slots v dc i (add 1 (fat_long_count d i))))
        (if (eq first 0)
            v2
            (let v3 (fat_unchain v2 first)
              (if (fat_slot_is_dir b)
                  (match v3 ((FatVol l g t ds fr nx dt bt ep) (FatVol l g t (map_remove ds first) fr nx dt bt ep)))
                  v3)))))))

; v with the file at r emptied, at ms: its clusters freed.
(def fat_truncate ((v FatVol) (r VolRef) (ms int)) FatVol
  (match r
    ((VolRef dc i)
      (let b (array_get (fat_dir v dc) i)
        (if (fat_slot_is_dir b)
            v
            (fat_set_slot (fat_unchain v (fat_slot_first b)) dc i (fat_slot_with b 0 0 (fat_time_of ms))))))))

; v with the entry at a moved to b, a slot fat_slot made for name: its
; attributes, times, clusters and size kept; a directory's .. made its
; new parent's.
(def fat_move ((v FatVol) (a VolRef) (b VolRef) (name (list int))) FatVol
  (match a
    ((VolRef adc ai)
      (match b
        ((VolRef bdc bi)
          (let (old (array_get (fat_dir v adc) ai)
                v2 (fat_put_entry (fat_remove_slots v a) b name (bytes_get old 11) (fat_slot_first old) (fat_slot_size_of old) (FatTime 0 0))
                v3 (fat_kept v2 b old))
            (if (and (fat_slot_is_dir old) (not (eq adc bdc)))
                (fat_reparent v3 (fat_slot_first old) bdc)
                v3)))))))

; The slots of the entry at a freed, its clusters kept.
(def fat_remove_slots ((v FatVol) (a VolRef)) FatVol
  (match a ((VolRef dc i) (fat_free_slots v dc i (add 1 (fat_long_count (fat_dir v dc) i))))))

; The short entry at b with the times and the rest of old, its 11 bytes
; and NT byte its own.
(def fat_kept ((v FatVol) (b VolRef) (old bytes)) FatVol
  (match b
    ((VolRef dc i)
      (let nb (array_get (fat_dir v dc) i)
        (fat_set_slot v dc i (bytes_concat (cons (bytes_slice nb 0 13) (cons (bytes_slice old 13 32) (nil bytes)))))))))

; Directory c's .. made dc's: 0 for the root.
(def fat_reparent ((v FatVol) (c int) (dc int)) FatVol
  (let d (fat_dir v c)
    (if (lt (array_len d) 2)
        v
        (let b (array_get d 1)
          (if (not (eq (fat_kind b) 4))
              v
              (let p (if (eq dc (fat_root v)) 0 dc)
                (fat_set_slot v c 1 (fat_put16 (fat_put16 b 20 (bit_shr p 16)) 26 (bit_and p 65535)))))))))

; v labelled label: its boot sector's, and the root's label slot, if it
; has one; the boot sector dirty.
(def fat_relabel ((v FatVol) (label (list int))) FatVol
  (match v
    ((FatVol l g t ds fr nx d bt ep)
      (match d
        ((FatDirty ks rs boot)
          (let (v2 (FatVol label g t ds fr nx (FatDirty ks rs true) (fat_put bt 71 (fat_space_pad label 11)) ep)
                i (fat_label_slot (fat_dir v2 (.root g)) 0))
            (if (lt i 0)
                v2
                (fat_set_slot v2 (.root g) i (fat_put (array_get (fat_dir v2 (.root g)) i) 0 (fat_space_pad label 11))))))))))

; The root's label slot, from slot i, or -1.
(def fat_label_slot ((d (array bytes)) (i int)) int
  (if (ge i (array_len d))
      -1
      (let k (fat_kind (array_get d i))
        (if (eq k 0) -1 (eq k 3) i (fat_label_slot d (add i 1))))))

; ------------------------------------------------------------------ plans

; The kth cluster of the chain from first, walked from hint as vol_at
; walks, at most as many links as there are clusters.
(def fat_at ((v FatVol) (first int) (hint VolAt) (k int)) VolAt
  (match hint
    ((VolAt hk hc)
      (if (and (gt hc 0) (and (ge hk 0) (le hk k)))
          (fat_walk v hc hk k (.clusters (.geom v)))
          (fat_walk v first 0 k (.clusters (.geom v)))))))

; From c, the ith cluster, on to the kth, at most left links.
(def fat_walk ((v FatVol) (c int) (i int) (k int) (left int)) VolAt
  (if (not (fat_is_data (.geom v) c))
      (VolAt k 0)
      (ge i k) (VolAt k c)
      (le left 0) (VolAt k 0)
      (fat_walk v (fat_get (.tab v) c) (add i 1) k (sub left 1))))

; Where the next bytes of the file at r are, from offset, at most n, in
; one cluster; none at its end, or for a directory.
(def fat_read_span ((v FatVol) (r VolRef) (offset int) (n int) (hint VolAt)) (Option VolSpan)
  (match (fat_entry v r)
    ((VolNone) ((None VolSpan)))
    ((VolDir name first) ((None VolSpan)))
    ((VolFile name size first exec)
      (let (cb (fat_csize v) k (min n (min (sub size offset) (sub cb (mod offset cb)))))
        (if (le k 0)
            ((None VolSpan))
            (match (fat_at v first hint (div offset cb))
              ((VolAt j c) (if (eq c 0) ((None VolSpan)) (Some (VolSpan c (mod offset cb) k))))))))))

; How many of the file at r's bytes its kth cluster holds.
(def fat_held ((v FatVol) (r VolRef) (k int)) int
  (match (fat_entry v r)
    ((VolNone) 0)
    ((VolDir name first) 0)
    ((VolFile name size first exec) (max 0 (min (fat_csize v) (sub size (mul k (fat_csize v))))))))

; A write planned: the volume after it, the spans to write, in order,
; and the clusters it took, which hold nothing yet; or no room.
(data FatWrote (FatWrote FatVol (list VolSpan) (list int)) (FatNoSpace))

; n bytes written to the file at r from offset, not past its end, at
; ms, as vol_write plans one: the clusters it touches walked from hint,
; as many more as it needs taken and joined to the chain's end.
(def fat_write ((v FatVol) (r VolRef) (offset int) (n int) (hint VolAt) (ms int)) FatWrote
  (match (fat_entry v r)
    ((VolNone) (FatNoSpace))
    ((VolDir name first) (FatNoSpace))
    ((VolFile name size first exec)
      (let (cb (fat_csize v)
            len (ceil_div size cb)
            need (sub (ceil_div (add offset n) cb) len)
            k (div offset cb)
            ks (if (and (gt need 0) (gt len 0)) (min k (sub len 1)) k)
            have (fat_touched v first hint ks (fat_touch_count cb offset n len ks)))
        (if (le need 0)
            (fat_wrote (fat_sized v r first (max size (add offset n)) ms) have ks cb offset n (nil int))
            (match (fat_alloc v need)
              ((FatFull) (FatNoSpace))
              ((FatAlloc v2 cs) (fat_grown v2 r have ks cb cs first size offset n ms))))))))

; How many of len clusters, from the ksth, a write of n from offset
; touches.
(def fat_touch_count ((cb int) (offset int) (n int) (len int) (ks int)) int
  (if (le n 0) 0 (max 0 (add (sub (min (div (sub (add offset n) 1) cb) (sub len 1)) ks) 1))))

; count clusters of the chain from first, from the ksth, found from hint.
(def fat_touched ((v FatVol) (first int) (hint VolAt) (ks int) (count int)) (list int)
  (if (le count 0)
      (nil int)
      (match (fat_at v first hint ks)
        ((VolAt j c) (fat_run_from v c count (.clusters (.geom v)) (nil int))))))

; count clusters of a chain from c, onto acc, at most left links.
(def fat_run_from ((v FatVol) (c int) (count int) (left int) (acc (list int))) (list int)
  (if (or (le count 0) (or (not (fat_is_data (.geom v) c)) (le left 0)))
      (rev acc)
      (fat_run_from v (fat_get (.tab v) c) (sub count 1) (sub left 1) (cons c acc))))

; v with the short entry at r of first cluster first and size n,
; written at ms.
(def fat_sized ((v FatVol) (r VolRef) (first int) (n int) (ms int)) FatVol
  (match r
    ((VolRef dc i) (fat_set_slot v dc i (fat_slot_with (array_get (fat_dir v dc) i) first n (fat_time_of ms))))))

; The clusters cs, linked in v, joined to the end of the file at r, its
; clusters from the ksth being have.
(def fat_grown ((v FatVol) (r VolRef) (have (list int)) (ks int) (cb int) (cs (list int)) (first int) (size int) (offset int) (n int) (ms int)) FatWrote
  (let (v2 (if (is_empty have) v (fat_mark v (last have) (head cs)))
        f (if (is_empty have) (head cs) first))
    (fat_wrote (fat_sized v2 r f (max size (add offset n)) ms) (append have cs) ks cb offset n cs)))

; The write planned on v, over chain, the file's clusters from the ksth.
(def fat_wrote ((v FatVol) (chain (list int)) (ks int) (cb int) (offset int) (n int) (fresh (list int))) FatWrote
  (FatWrote v (fat_spans chain ks cb offset n (nil VolSpan)) fresh))

; The spans of n bytes from offset over chain, onto acc.
(def fat_spans ((chain (list int)) (ks int) (cb int) (offset int) (n int) (acc (list VolSpan))) (list VolSpan)
  (if (le n 0)
      (rev acc)
      (let (at (mod offset cb) k (min n (sub cb at)))
        (fat_spans chain ks cb (add offset k) (sub n k)
                   (cons (VolSpan (nth_or chain (sub (div offset cb) ks) 0) at k) acc)))))

; Where a write of n bytes from offset, of spans, ended, as
; vol_spans_end says, of clusters of cb bytes.
(def fat_spans_end ((spans (list VolSpan)) (cb int) (offset int) (n int)) VolAt
  (if (is_empty spans)
      (vol_at_none)
      (match (last spans)
        ((VolSpan c at k) (VolAt (div (sub (add offset n) 1) cb) c)))))

; ------------------------------------------------------- what is written

; Bytes to write from a sector of the volume, whole sectors.
(data FatPiece (FatPiece int bytes))

; What v has dirtied, as pieces, merged: each FAT sector in every copy,
; and FSInfo, if any is; the boot sector and its backup, if dirty; each
; directory sector holding a dirty slot.
(def fat_pieces ((v FatVol)) (list FatPiece)
  (match (.dirty v)
    ((FatDirty ks rs boot)
      (fat_merged (sort (fat_sectors_onto v (fat_uniq (sort ks)) (fat_dir_sectors v rs (nil FatSec)) boot)) (nil FatPiece)))))

; A sector to write, by its number, and its bytes: sorted, so that
; pieces merge.
(data FatSec (FatSec int bytes))

; ks with none twice, in order.
(def fat_uniq ((ks (list int))) (list int)
  (if (is_empty ks) ks
      (and (not (is_empty (tail ks))) (eq (head ks) (head (tail ks)))) (fat_uniq (tail ks))
      (cons (head ks) (fat_uniq (tail ks)))))

; The FAT's sectors ks, in each copy, FSInfo if there are any, and the
; boot sectors if boot, onto acc.
(def fat_sectors_onto ((v FatVol) (ks (list int)) (acc (list FatSec)) (boot bool)) (list FatSec)
  (let (g (.geom v)
        a2 (if (or (is_empty ks) (eq (.fsinfo_at g) 0)) acc (cons (FatSec (.fsinfo_at g) (fat_fsinfo (.free v) (.hint v))) acc))
        a3 (if boot (fat_boot_secs v a2) a2))
    (fat_tab_secs v ks a3)))

; The boot sector, and its backup, onto acc.
(def fat_boot_secs ((v FatVol) (acc (list FatSec))) (list FatSec)
  (match v
    ((FatVol l g t ds fr nx d bt ep)
      (let a2 (cons (FatSec 0 bt) acc)
        (if (eq (.backup_at g) 0) a2 (cons (FatSec (.backup_at g) bt) a2))))))

; FAT sectors ks, each in every copy, onto acc.
(def fat_tab_secs ((v FatVol) (ks (list int)) (acc (list FatSec))) (list FatSec)
  (if (is_empty ks)
      acc
      (let (g (.geom v) b (fat_tab_sector (.tab v) (head ks)) at (add (.reserved g) (head ks)))
        (fat_tab_secs v (tail ks)
          (if (eq (.nfats g) 2)
              (cons (FatSec (add at (.fatsz g)) b) (cons (FatSec at b) acc))
              (cons (FatSec at b) acc))))))

; The sectors holding the slots rs, each with its slots, onto acc.
(def fat_dir_sectors ((v FatVol) (rs (list VolRef)) (acc (list FatSec))) (list FatSec)
  (if (is_empty rs)
      acc
      (match (head rs)
        ((VolRef dc i)
          (let (g (.geom v) c (nth_or (fat_chain g (.tab v) dc) (div i (fat_dir_slots g)) 0))
            (fat_dir_sectors v (tail rs)
              (if (eq c 0)
                  acc
                  (let j (div (mod i (fat_dir_slots g)) (fat_slots_per_sector))
                    (cons (FatSec (add (fat_cluster_at g c) j)
                                  (fat_slots_bytes (fat_dir v dc) (mul (div i (fat_slots_per_sector)) (fat_slots_per_sector))))
                          acc)))))))))

; The 16 slots of d from i, as bytes.
(def fat_slots_bytes ((d (array bytes)) (i int)) bytes
  (bytes_concat (fat_slots_from d i (add i (fat_slots_per_sector)) (nil bytes))))

; Slots i up to j of d, in order.
(def fat_slots_from ((d (array bytes)) (i int) (j int) (acc (list bytes))) (list bytes)
  (if (ge i j) (rev acc) (fat_slots_from d (add i 1) j (cons (if (lt i (array_len d)) (array_get d i) (fat_zero_slot)) acc))))

; Sorted sectors ss as pieces, one sector once, those in a row of up to
; 64 joined, onto the reversed acc.
(def fat_merged ((ss (list FatSec)) (acc (list FatPiece))) (list FatPiece)
  (if (is_empty ss)
      (rev acc)
      (match (head ss)
        ((FatSec s b)
          (fat_merged (fat_past (tail ss) s) (fat_join s b acc))))))

; ss without those at sector s, the same sector again.
(def fat_past ((ss (list FatSec)) (s int)) (list FatSec)
  (if (is_empty ss) ss (match (head ss) ((FatSec t b) (if (eq t s) (fat_past (tail ss) s) ss)))))

; Sector s, b, after the pieces acc: added to the last if it follows it
; and it is not 64 sectors yet.
(def fat_join ((s int) (b bytes) (acc (list FatPiece))) (list FatPiece)
  (if (is_empty acc)
      (cons (FatPiece s b) acc)
      (match (head acc)
        ((FatPiece p pb)
          (let n (div (bytes_len pb) (fat_sector))
            (if (and (eq (add p n) s) (lt n 64))
                (cons (FatPiece p (bytes_concat (cons pb (cons b (nil bytes))))) (tail acc))
                (cons (FatPiece s b) acc)))))))

; Everything a new volume, or one formatted, writes, in order and none
; on another: every reserved sector, the boot sectors and FSInfo among
; zeros; both FATs, whole; and every cluster of every directory, as
; tools/mkfs fills them too.
(def fat_all_pieces ((v FatVol)) (list FatPiece)
  (let (g (.geom v)
        a2 (fat_tab_all v 0 (.nfats g) (fat_merged (fat_reserved_secs v 0 (nil FatSec)) (nil FatPiece))))
    (fat_sort_pieces (fat_dirs_all v (map_keys (.dirs v)) (rev a2)))))

; The reserved sectors from s, each its bytes: the boot sector at 0 and
; at its backup, FSInfo at its place and after the backup, zeros else;
; in order.
(def fat_reserved_secs ((v FatVol) (s int) (acc (list FatSec))) (list FatSec)
  (let g (.geom v)
    (if (ge s (.reserved g))
        (rev acc)
        (let (bk (.backup_at g)
              b (if (or (eq s 0) (and (gt bk 0) (eq s bk)))
                    (match v ((FatVol l g2 t ds fr nx d bt ep) bt))
                    (or (eq s (.fsinfo_at g)) (and (gt bk 0) (eq s (add bk 1))))
                    (fat_fsinfo (.free v) (.hint v))
                    (bytes_from_list (zeros (fat_sector)))))
          (fat_reserved_secs v (add s 1) (cons (FatSec s b) acc))))))

; Pieces in order of their sectors.
(def fat_sort_pieces ((ps (list FatPiece))) (list FatPiece)
  (fat_unkeyed (sort (fat_keyed ps (nil FatSec)))))

; Each piece as a FatSec, to sort by its sector, onto acc.
(def fat_keyed ((ps (list FatPiece)) (acc (list FatSec))) (list FatSec)
  (if (is_empty ps) acc (match (head ps) ((FatPiece s b) (fat_keyed (tail ps) (cons (FatSec s b) acc))))))

; Each FatSec as a piece, in order.
(def fat_unkeyed ((ss (list FatSec))) (list FatPiece)
  (if (is_empty ss) (nil FatPiece) (match (head ss) ((FatSec s b) (cons (FatPiece s b) (fat_unkeyed (tail ss)))))))

; Every cluster of the directories dcs, a piece each, onto acc.
(def fat_dirs_all ((v FatVol) (dcs (list int)) (acc (list FatPiece))) (list FatPiece)
  (if (is_empty dcs)
      acc
      (let g (.geom v)
        (fat_dirs_all v (tail dcs)
          (fat_dir_cluster_pieces v (head dcs) (fat_chain g (.tab v) (head dcs)) 0 acc)))))

; The clusters cs of directory dc, the kth of it first, a piece each.
(def fat_dir_cluster_pieces ((v FatVol) (dc int) (cs (list int)) (k int) (acc (list FatPiece))) (list FatPiece)
  (if (is_empty cs)
      acc
      (let g (.geom v)
        (fat_dir_cluster_pieces v dc (tail cs) (add k 1)
          (cons (FatPiece (fat_cluster_at g (head cs)) (fat_slots_bytes_n (fat_dir v dc) (mul k (fat_dir_slots g)) (fat_dir_slots g))) acc)))))

; n slots of d from i, as bytes.
(def fat_slots_bytes_n ((d (array bytes)) (i int) (n int)) bytes
  (bytes_concat (fat_slots_from d i (add i n) (nil bytes))))

; Every sector of copies j on of the FAT, 64 at a time, onto acc: those
; past the marks' sectors zeros.
(def fat_tab_all ((v FatVol) (j int) (nf int) (acc (list FatPiece))) (list FatPiece)
  (if (ge j nf)
      acc
      (let g (.geom v)
        (fat_tab_all v (add j 1) nf
          (fat_tab_run v (add (.reserved g) (mul j (.fatsz g))) 0 (.fatsz g) acc)))))

; Sectors k up to e of a copy of the FAT from sector at, 64 at a time.
(def fat_tab_run ((v FatVol) (at int) (k int) (e int) (acc (list FatPiece))) (list FatPiece)
  (if (ge k e)
      acc
      (let n (min 64 (sub e k))
        (fat_tab_run v at (add k n) e (cons (FatPiece (add at k) (fat_tab_bytes (.tab v) k (add k n) (nil bytes))) acc)))))

; FAT sectors k up to e, as bytes, zeros past its marks'.
(def fat_tab_bytes ((t (array (array int))) (k int) (e int) (acc (list bytes))) bytes
  (if (ge k e)
      (bytes_concat (rev acc))
      (fat_tab_bytes t (add k 1) e
        (cons (if (lt k (array_len t)) (fat_tab_sector t k) (bytes_from_list (zeros (fat_sector)))) acc))))

; ---------------------------------------------------------------- reading

; A volume being read: the volume so far, and which clusters some chain
; has taken already.
(data FatLoad (FatLoad (vol FatVol) (seen (array bool))))

; A volume read so far, or why it cannot be served.
(data FatGot (FatGot FatLoad) (FatBad (list int)))

; The volume of geometry g, its BPB's label, its boot sector bt, whose
; first FAT's sectors are b: no directories yet but the root's chain
; taken; refused if the root has none.
(def fat_base ((g FatGeom) (label (list int)) (bt bytes) (b bytes)) FatGot
  (if (lt (bytes_len b) (mul (ceil_div (add (.clusters g) 2) (fat_marks)) 4))
      (FatBad "the FAT is cut short")
      (let (t (fat_tab_of g b)
            fr (fat_count_free g t)
            v (FatVol label g t ((MapEmpty int (array bytes))) fr 2 (fat_clean_dirty) bt 0))
        (if (not (fat_is_data g (.root g)))
            (FatBad "no root directory")
            (FatGot (FatLoad v (array_new (add (.clusters g) 2) false)))))))

; Whether the FAT says the volume was not put away cleanly: cluster 1's
; mark without its bit 27.
(def fat_unclean ((v FatVol)) bool
  (eq (bit_and (fat_get (.tab v) 1) 134217728) 0))

; The clusters directory dc's slots are in, to be read for fat_add_dir:
; its chain.
(def fat_dir_clusters ((l FatLoad) (dc int)) (list int)
  (match l ((FatLoad v seen) (fat_chain (.geom v) (.tab v) dc))))

; l with directory dc, whose clusters' bytes are b: refused if its
; chain, or a file's in it, meets a cluster another chain has, which is
; a loop or a cross link, or a file's is shorter than its size. The
; root's label slot names the volume.
(def fat_add_dir ((l FatLoad) (dc int) (b bytes)) FatGot
  (match l
    ((FatLoad v seen)
      (if (fat_is_dir v dc)
          (FatBad "a directory in itself")
          (match (fat_claim (.geom v) (.tab v) seen dc 0 (.clusters (.geom v)))
            ((None) (FatBad "a directory's clusters are another's"))
            ((Some seen2)
              (let d (fat_slots_of b (array_new (div (bytes_len b) (fat_slot_size)) (fat_zero_slot)) 0)
                (match (fat_check_dir (.geom v) (.tab v) seen2 d 0)
                  ((None) (FatBad "a file's clusters are bad, or another's"))
                  ((Some seen3)
                    (match v
                      ((FatVol lb g t ds fr nx dt bt ep)
                        (let lb2 (if (eq dc (.root g)) (fat_root_label d lb) lb)
                          (FatGot (FatLoad (FatVol lb2 g t (map_put ds dc d) fr nx dt bt ep) seen3))))))))))))))

; The slots of b, from slot i, into d.
(def fat_slots_of ((b bytes) (d (array bytes)) (i int)) (array bytes)
  (if (ge i (array_len d))
      d
      (fat_slots_of b (array_set d i (bytes_slice b (mul i 32) (add (mul i 32) 32))) (add i 1))))

; The label of the root d's label slot, or lb if it has none.
(def fat_root_label ((d (array bytes)) (lb (list int))) (list int)
  (let i (fat_label_slot d 0)
    (if (lt i 0) lb (fat_label_text (fat_slot_name83 (array_get d i))))))

; seen with the chain from c taken, the kth of it, at least need more:
; none if one is taken already, or it ends before need.
(def fat_claim ((g FatGeom) (t (array (array int))) (seen (array bool)) (c int) (need int) (left int)) (Option (array bool))
  (if (not (fat_is_data g c))
      (if (le need 0) (Some seen) ((None (array bool))))
      (or (array_get seen c) (le left 0))
      ((None (array bool)))
      (fat_claim g t (array_set seen c true) (fat_get t c) (sub need 1) (sub left 1))))

; seen with the chain of every file of d from slot i taken: none if one
; is bad. A directory's chain is taken when it is read.
(def fat_check_dir ((g FatGeom) (t (array (array int))) (seen (array bool)) (d (array bytes)) (i int)) (Option (array bool))
  (if (ge i (array_len d))
      (Some seen)
      (let b (array_get d i)
        (if (eq (fat_kind b) 0)
            (Some seen)
            (and (fat_slot_short b) (and (not (fat_slot_is_dir b)) (gt (fat_slot_first b) 0)))
            (match (fat_claim g t seen (fat_slot_first b) (ceil_div (fat_slot_size_of b) (fat_cluster_bytes g)) (.clusters g))
              ((None) ((None (array bool))))
              ((Some seen2) (fat_check_dir g t seen2 d (add i 1))))
            (and (fat_slot_short b) (and (not (fat_slot_is_dir b)) (gt (fat_slot_size_of b) 0)))
            ((None (array bool)))
            (fat_check_dir g t seen d (add i 1))))))

; The subdirectories of directory dc of a load, to read next.
(def fat_load_subdirs ((l FatLoad) (dc int)) (list int)
  (fat_subdirs (.vol l) dc))
