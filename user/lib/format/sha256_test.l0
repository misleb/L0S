; sha256_test.l0 -- tests of sha256.l0, against FIPS 180-2's examples
; and the digests sha256sum gives.

(def sha256_of ((s (list int))) (list int)
  (let b (bytes_from_list s) (sha256_hex b 0 (bytes_len b))))

(def test_sha256_empty () int
  (check_str "empty" (sha256_of "")
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))

(def test_sha256_abc () int
  (check_str "abc" (sha256_of "abc")
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))

; 56 bytes: the length no longer fits the first padding block.
(def test_sha256_two_blocks () int
  (check_str "two blocks" (sha256_of "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"))

; 64 bytes: a whole block, then a block of padding alone.
(def test_sha256_one_block () int
  (check_str "64 bytes" (sha256_of "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    "a8ae6e6ee929abea3afcfc5258c8ccd6f85273e0d4626d26c7279f3250f77c8e"))

; A range of a larger value: only its bytes count.
(def test_sha256_range () int
  (let b (bytes_from_list "xxabcyy")
    (check_str "range" (sha256_hex b 2 5)
      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")))

(def test_sha256_bytes () int
  (let (b (bytes_from_list "abc")
        d (sha256 b 0 3))
    (add (check_int "length" (bytes_len d) 32)
         (check_int "first" (bytes_get d 0) 186))))

; The hash of s given to a Sha256 in pieces of k bytes, in hex.
(def sha256_pieces_of ((s (list int)) (k int)) (list int)
  (let b (bytes_from_list s)
    (sha256_digest_hex (sha256_done (sha256_fed (sha256_new) b 0 k)))))

; s given the bytes of b from i on, k at a time.
(def sha256_fed ((s Sha256) (b bytes) (i int) (k int)) Sha256
  (if (ge i (bytes_len b))
      s
      (let j (min (add i k) (bytes_len b))
        (sha256_fed (sha256_more s b i j) b j k))))

(def test_sha256_pieces_empty () int
  (check_str "nothing given" (sha256_digest_hex (sha256_done (sha256_new)))
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))

; The two-block message in pieces of 1, 7 and 64 bytes: the same hash.
(def test_sha256_pieces () int
  (let s "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    (add (check_str "1" (sha256_pieces_of s 1) (sha256_of s))
         (add (check_str "7" (sha256_pieces_of s 7) (sha256_of s))
              (check_str "64" (sha256_pieces_of s 64) (sha256_of s))))))

; A few hundred seeded messages up to 300 bytes, in seeded pieces: the
; same hash as all at once.
(def test_sha256_pieces_random () int
  (sha256_random_from 1 0 0))

; Cases from i up to 200 with the generator at seed, the failures so far.
(def sha256_random_from ((seed int) (i int) (failed int)) int
  (if (ge i 200)
      failed
      (let (s1 (rand_next seed)
            n (rand_below s1 300)
            s2 (rand_next s1)
            b (rand_bytes s2 n)
            s3 (rand_next s2)
            k (add 1 (rand_below s3 90))
            got (sha256_digest_hex (sha256_done (sha256_fed (sha256_new) (bytes_from_list b) 0 k)))
            want (sha256_hex (bytes_from_list b) 0 n))
        (sha256_random_from s3 (add i 1) (if (eq got want) failed (add failed (check_str "random" got want)))))))
