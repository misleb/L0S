; ppm_test.l0 -- tests of ppm.l0.

; ---------------------------------------------------------------- reading

; A 2 by 1 image: red, then blue.
(def tiny_ppm ((header (list int))) bytes
  (bytes_from_list (append header (cons 255 (cons 0 (cons 0 (cons 0 (cons 0 (cons 255 (nil int))))))))))

(def ppm_text ((p Ppm)) (list int)
  (match p
    ((Ppm w h off) (append (digits w) (append "x" (append (digits h) (append " at " (digits off))))))
    ((PpmBad why) why)))

(def test_parse_ppm () int
  (check_str "parsed" (ppm_text (parse_ppm (tiny_ppm "P6\n2 1\n255\n"))) "2x1 at 11"))

(def test_parse_ppm_comment () int
  (check_str "parsed" (ppm_text (parse_ppm (tiny_ppm "P6 # made by hand\n2 1 255\n"))) "2x1 at 26"))

(def test_parse_ppm_not_p6 () int
  (check_str "refused" (ppm_text (parse_ppm (tiny_ppm "P3\n2 1\n255\n"))) "not a binary PPM: no P6"))

(def test_parse_ppm_maxval () int
  (check_str "refused" (ppm_text (parse_ppm (tiny_ppm "P6\n2 1\n65535\n"))) "PPM maxval is not 255"))

(def test_parse_ppm_short () int
  (check_str "refused" (ppm_text (parse_ppm (tiny_ppm "P6\n3 1\n255\n"))) "PPM pixels cut short"))

(def test_parse_ppm_header_short () int
  (check_str "refused" (ppm_text (parse_ppm (bytes_from_list "P6\n2"))) "PPM header cut short"))

(def test_pixel_at () int
  (let b (tiny_ppm "P6\n2 1\n255\n")
    (add (check_int "red is r in bits 16 to 23" (pixel_at b 11 2 0 0) 16711680)
         (check_int "blue is b in bits 0 to 7" (pixel_at b 11 2 1 0) 255))))

; ---------------------------------------------------------------- writing

; What is written reads back: a header, then a pixel's red, green, blue.
(def test_written_reads_back () int
  (let b (bytes_from_list (rev (ppm_push_rgb (rgb 1 2 3) (rev (ppm_header 1 1)))))
    (add (check_str "the header" (ppm_text (parse_ppm b)) "1x1 at 11")
         (check_int "the pixel" (pixel_at b 11 1 0 0) (rgb 1 2 3)))))

; 0x3584E4 is 53, 132 and 228.
(def test_channels () int
  (add (check_int "red" (rgb_red 3507428) 53)
       (add (check_int "green" (rgb_green 3507428) 132)
            (add (check_int "blue" (rgb_blue 3507428) 228)
                 (check_int "together" (rgb 53 132 228) 3507428)))))
