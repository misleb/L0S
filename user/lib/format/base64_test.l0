; base64_test.l0 -- base64 read: RFC 4648's test vectors, padding, and
; what is refused.

(def bb ((s (list int))) bytes (bytes_from_list s))

; The text s decodes to, or ! if it is refused.
(def decoded ((s (list int))) (list int)
  (let b (bb s)
    (match (base64_decode b 0 (bytes_len b)) ((None) "!") ((Some d) (bytes_to_list d)))))

; RFC 4648's vectors: "f" to "foobar", each length's padding.
(def test_vectors () int
  (add (check_str "f" (decoded "Zg==") "f")
       (add (check_str "fo" (decoded "Zm8=") "fo")
            (check_str "foobar" (decoded "Zm9vYmFy") "foobar"))))

; Nothing is nothing; the alphabet's last two, + and /, stand for 62 and
; 63: "+/+/" is fb ff bf.
(def test_alphabet () int
  (add (check_str "empty" (decoded "") "")
       (check_str "+ and /" (decoded "+/+/") (cons 251 (cons 255 (cons 191 (nil int)))))))

; A part of the bytes is read in place, between i and j.
(def test_in_place () int
  (let b (bb "scene\nZm9v")
    (check_str "foo" (match (base64_decode b 6 10) ((None) "!") ((Some d) (bytes_to_list d))) "foo")))

; Not a whole number of fours, a character outside the alphabet, and
; padding before the end are refused.
(def test_refused () int
  (add (check_str "short" (decoded "Zm9") "!")
       (add (check_str "outside" (decoded "Zm9v*mFy") "!")
            (check_str "padding early" (decoded "Zg==Zm9v") "!"))))

; RFC 4648's vectors written: each length's padding.
(def test_encode_vectors () int
  (add (check_str "f" (base64_encode (bb "f") 0 1) "Zg==")
       (add (check_str "fo" (base64_encode (bb "fo") 0 2) "Zm8=")
            (check_str "foobar" (base64_encode (bb "foobar") 0 6) "Zm9vYmFy"))))

; A range is written, and fb ff bf is "+/+/", the alphabet's last two.
(def test_encode_range () int
  (add (check_str "oob" (base64_encode (bb "foobar") 1 4) "b29i")
       (check_str "+/" (base64_encode (bytes_from_list (cons 251 (cons 255 (cons 191 (nil int))))) 0 3) "+/+/")))
