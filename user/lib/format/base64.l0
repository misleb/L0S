; base64.l0 -- base64 (RFC 4648's standard alphabet, with its padding)
; read into bytes: what a text-only stream, such as the app builder's
; server-sent events, carries a file's bytes as. The text is read in
; place, four characters at a time, and what it holds made bytes once.

; The six bits character c stands for, or -1 if it stands for none:
; A to Z 0 to 25, a to z 26 to 51, 0 to 9 52 to 61, + 62 and / 63.
(def base64_value ((c int)) int
  (if (and (ge c 65) (le c 90)) (sub c 65)
      (and (ge c 97) (le c 122)) (add (sub c 97) 26)
      (and (ge c 48) (le c 57)) (add (sub c 48) 52)
      (eq c 43) 62
      (eq c 47) 63
      -1))

; The bytes b from i up to j, base64, stand for: none if that is not a
; whole number of fours, or holds a character outside the alphabet, or
; padding, =, anywhere but in the last four's last one or two.
(def base64_decode ((b bytes) (i int) (j int)) (Option bytes)
  (if (not (eq (mod (sub j i) 4) 0))
      ((None bytes))
      (base64_quads b i j (nil int))))

; base64_decode's loop: the four at i on, each its three bytes, or
; fewer for the last if padded, onto acc reversed.
(def base64_quads ((b bytes) (i int) (j int) (acc (list int))) (Option bytes)
  (if (ge i j)
      (Some (bytes_from_list (rev acc)))
      (let (last (eq (add i 4) j)
            c2 (bytes_get b (add i 2))
            c3 (bytes_get b (add i 3))
            v0 (base64_value (bytes_get b i))
            v1 (base64_value (bytes_get b (add i 1)))
            pad3 (and last (eq c3 61))
            pad2 (and pad3 (eq c2 61))
            v2 (if pad2 0 (base64_value c2))
            v3 (if pad3 0 (base64_value c3)))
        (if (lt (min (min v0 v1) (min v2 v3)) 0)
            ((None bytes))
            (let (n (bit_or (bit_shl v0 18) (bit_or (bit_shl v1 12) (bit_or (bit_shl v2 6) v3)))
                  a1 (cons (bit_and (bit_shr n 16) 255) acc)
                  a2 (if pad2 a1 (cons (bit_and (bit_shr n 8) 255) a1))
                  a3 (if pad3 a2 (cons (bit_and n 255) a2)))
              (base64_quads b (add i 4) j a3))))))
