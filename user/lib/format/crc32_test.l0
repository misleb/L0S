; The check value every CRC-32 is known by: cbf43926.
(def test_check_value () int
  (check_int "123456789" (crc32_list "123456789") 3421780262))

(def test_empty () int
  (check_int "nothing" (crc32_list "") 0))

(def test_range () int
  (check_int "the middle of a longer run" (crc32 (bytes_from_list "xx123456789yy") 2 11) 3421780262))

; Bytes taken as zeros reckon as zeros written there would: 12345678
; with its 56 zeroed.
(def test_zeroed () int
  (check_int "as if zeroed" (crc32_zeroed (bytes_from_list "12345678") 0 8 4 2)
             (crc32_list (append "1234" (cons 0 (cons 0 "78"))))))
