; l0fs.l0 -- the file system L0S keeps on a disk, as bytes: on each
; partition of the disk's GPT (user/lib/gpt.l0) whose type is
; gpt_l0fs_type, a volume of its own format, L0FS. Pure: it encodes and
; decodes the sectors, and plans which clusters a read or a write
; touches; user/fs serves volumes with it, tools/mkfs makes them.
;
;   volume sector 0     the superblock: L0FS, version 1, the label, the layout
;   sectors 1..         the cluster table, a u16 a cluster: 0 free, FFFF a
;                       file's last, FFFE reserved, else the next
;   the next 6          the directory: 48 entries of 64 bytes, a name of up
;                       to 55 bytes, the size, the first cluster, in use
;   cluster D on        the files' data, clusters of 8 sectors, 4096 bytes
;
; The superblock, table and directory, rounded up to whole clusters, are
; the volume's metadata, its clusters below D, reserved in the table. A
; directory is flat: names hold no /. Linked into user/fs and tools/mkfs,
; with common/abi.l0 for u32_le and le_u32.

; ------------------------------------------------------------------ sizes

; A sector's bytes, a cluster's sectors and bytes.
(def vol_sector_size () int 512)
(def vol_cluster_sectors () int 8)
(def vol_cluster_size () int 4096)

; The directory: its sectors, an entry's bytes, how many entries.
(def vol_dir_sectors () int 6)
(def vol_entry_size () int 64)
(def vol_entries () int 48)

; The longest name a file has; a volume's label is abi.l0's label_ok.
(def vol_name_max () int 55)

; The table's marks: a file's last cluster, FFFF; the metadata's, FFFE.
; Clusters are numbered below FFFE, so a volume has at most 65534.
(def vol_end () int 65535)
(def vol_reserved () int 65534)
(def vol_max_clusters () int 65534)

; ---------------------------------------------------------------- helpers

; xs, then zeros up to n bytes.
(def vol_pad ((xs (list int)) (n int)) (list int)
  (append xs (zeros (sub n (length xs)))))

; The bytes of b from i up to the first zero, or up to j.
(def vol_cstr ((b bytes) (i int) (j int)) (list int)
  (vol_cstr_end b i i j))

(def vol_cstr_end ((b bytes) (i int) (k int) (j int)) (list int)
  (if (if (ge k j) true (eq (bytes_get b k) 0))
      (bytes_range b i k)
      (vol_cstr_end b i (add k 1) j)))

; ------------------------------------------------------------------ names

; Whether s is a file's name: 1 to 55 bytes, each printable and not a
; space or a /.
(def vol_name_ok ((s (list int))) bool
  (if (if (is_empty s) true (gt (length s) (vol_name_max))) false (vol_name_chars s)))

(def vol_name_chars ((s (list int))) bool
  (if (is_empty s)
      true
      (let c (head s)
        (if (if (lt c 33) true (if (gt c 126) true (eq c 47)))
            false
            (vol_name_chars (tail s))))))


; ----------------------------------------------------------------- layout

; Where a volume of some sectors keeps things: its sectors, its clusters,
; the table's sectors (from sector 1), and its first cluster of data. The
; directory follows the table.
(data VolLayout (VolLayout int int int int))

; The layout of a volume of n sectors: as many clusters as fit, at most
; vol_max_clusters, a sector of table for each 256, then the directory.
(def vol_layout ((n int)) VolLayout
  (let c (min (div n (vol_cluster_sectors)) (vol_max_clusters))
    (let t (ceil_div (mul c 2) (vol_sector_size))
      (VolLayout n c t (ceil_div (add 1 (add t (vol_dir_sectors))) (vol_cluster_sectors))))))

; Whether a layout leaves a cluster for data.
(def vol_layout_ok ((l VolLayout)) bool
  (match l ((VolLayout n c t d) (gt c d))))

; A layout's clusters, the table's sectors, and its first data cluster.
(def vol_clusters ((l VolLayout)) int (match l ((VolLayout n c t d) c)))
(def vol_table_sectors ((l VolLayout)) int (match l ((VolLayout n c t d) t)))
(def vol_first_data ((l VolLayout)) int (match l ((VolLayout n c t d) d)))

; The sector the directory starts at.
(def vol_dir_start ((l VolLayout)) int (add 1 (vol_table_sectors l)))

; The metadata's sectors: every cluster before the data.
(def vol_meta_sectors ((l VolLayout)) int (mul (vol_first_data l) (vol_cluster_sectors)))

; ------------------------------------------------------------- superblock

; The superblock: L0FS, version 1, the label in 16 bytes from 8, then
; from 24 the sectors, clusters, the table's start and sectors, the
; directory's start and sectors, the first data cluster and the entries,
; each a u32.
(def vol_super ((label (list int)) (l VolLayout)) (list int)
  (match l
    ((VolLayout n c t d)
      (vol_pad (append "L0FS" (append (cons 1 (zeros 3)) (append (vol_pad label 16) (vol_super_words l))))
               (vol_sector_size)))))

(def vol_super_words ((l VolLayout)) (list int)
  (match l
    ((VolLayout n c t d)
      (append (u32_le n) (append (u32_le c) (append (u32_le 1) (append (u32_le t)
        (append (u32_le (vol_dir_start l)) (append (u32_le (vol_dir_sectors))
          (append (u32_le d) (u32_le (vol_entries))))))))))))

; A superblock read: the label and layout, or why it is none.
(data VolSuper (VolSuper (list int) VolLayout) (VolNotSuper (list int)))

; The superblock b holds: its magic and version, a label, and the
; layout its sectors give, written as vol_super writes it.
(def vol_super_of ((b bytes)) VolSuper
  (if (lt (bytes_len b) (vol_sector_size))
      (VolNotSuper "a superblock is a sector")
      (if (not (eq (bytes_range b 0 5) (append "L0FS" (cons 1 (nil int)))))
          (VolNotSuper "no L0FS volume")
          (let label (vol_cstr b 8 24)
            (let l (vol_layout (le_u32 b 24))
              (if (not (label_ok label))
                  (VolNotSuper "a bad label")
                  (if (not (if (vol_layout_ok l) (eq (bytes_range b 24 56) (vol_super_words l)) false))
                      (VolNotSuper "a bad layout")
                      (VolSuper label l))))))))

; ------------------------------------------------------------------ table

; A new volume's table: every cluster free but the metadata's.
(def vol_table_new ((l VolLayout)) (array int)
  (vol_reserve (array_new (vol_clusters l) 0) (sub (vol_first_data l) 1)))

; Clusters 0 to i reserved.
(def vol_reserve ((t (array int)) (i int)) (array int)
  (if (lt i 0) t (vol_reserve (array_set t i (vol_reserved)) (sub i 1))))

; The table as its sectors hold it.
(def vol_table_bytes ((t (array int)) (l VolLayout)) (list int)
  (vol_pad (rev (vol_table_push t 0 (nil int))) (mul (vol_table_sectors l) (vol_sector_size))))

(def vol_table_push ((t (array int)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len t))
      acc
      (vol_table_push t (add i 1) (push (le16 (array_get t i)) acc))))

; The table of layout l, from byte at of b, which holds it.
(def vol_table_of ((b bytes) (at int) (l VolLayout)) (array int)
  (vol_table_read b at (array_new (vol_clusters l) 0) 0))

(def vol_table_read ((b bytes) (at int) (t (array int)) (i int)) (array int)
  (if (ge i (array_len t))
      t
      (vol_table_read b at (array_set t i (le_u16_at b (add at (mul i 2)))) (add i 1))))

; Whether every cluster's mark is free, the end, reserved for exactly the
; metadata, or a data cluster.
(def vol_table_ok ((t (array int)) (d int)) bool
  (vol_table_ok_from t d 0))

(def vol_table_ok_from ((t (array int)) (d int) (i int)) bool
  (if (ge i (array_len t))
      true
      (let x (array_get t i)
        (if (if (lt i d) (eq x (vol_reserved))
                (if (eq x 0) true (if (eq x (vol_end)) true (if (ge x d) (lt x (array_len t)) false))))
            (vol_table_ok_from t d (add i 1))
            false))))

; The clusters of the chain from first, in order: none from 0, and it
; stops at an end, at a mark that is not a data cluster, and after as
; many as there are, so a loop ends.
(def vol_chain ((t (array int)) (first int)) (list int)
  (rev (vol_chain_onto t first (array_len t) (nil int))))

(def vol_chain_onto ((t (array int)) (c int) (left int) (acc (list int))) (list int)
  (if (if (le c 0) true (if (ge c (array_len t)) true (le left 0)))
      acc
      (vol_chain_onto t (array_get t c) (sub left 1) (cons c acc))))

; How many clusters are free.
(def vol_free_count ((t (array int))) int
  (vol_free_from t 0 0))

(def vol_free_from ((t (array int)) (i int) (n int)) int
  (if (ge i (array_len t)) n (vol_free_from t (add i 1) (if (eq (array_get t i) 0) (add n 1) n))))

; n free clusters taken, lowest first, and linked into a chain; or none,
; if fewer are free.
(data VolAlloc (VolAlloc (array int) (list int)) (VolFull))

; t with n of its free clusters linked, and them; or VolFull.
(def vol_alloc ((t (array int)) (n int)) VolAlloc
  (let cs (vol_free_n t 0 n (nil int))
    (if (lt (length cs) n)
        (VolFull)
        (VolAlloc (vol_link t cs) cs))))

; Up to n free clusters from i, in order.
(def vol_free_n ((t (array int)) (i int) (n int) (acc (list int))) (list int)
  (if (if (le n 0) true (ge i (array_len t)))
      (rev acc)
      (if (eq (array_get t i) 0)
          (vol_free_n t (add i 1) (sub n 1) (cons i acc))
          (vol_free_n t (add i 1) n acc))))

; cs linked in order, each to the next and the last to the end.
(def vol_link ((t (array int)) (cs (list int))) (array int)
  (if (is_empty cs)
      t
      (vol_link (array_set t (head cs) (if (is_empty (tail cs)) (vol_end) (head (tail cs)))) (tail cs))))

; cs free again.
(def vol_unlink ((t (array int)) (cs (list int))) (array int)
  (if (is_empty cs) t (vol_unlink (array_set t (head cs) 0) (tail cs))))

; -------------------------------------------------------------- directory

; An entry: a file's name, size and first cluster (0 while it has none);
; or a free one.
(data VolEntry (VolFile (list int) int int) (VolNone))

; An entry as the directory holds it: the name in 56 bytes, the size at
; 56, the first cluster at 60, and 1 at 62 if it is in use.
(def vol_entry_bytes ((e VolEntry)) (list int)
  (match e
    ((VolNone) (zeros (vol_entry_size)))
    ((VolFile name size first) (append (vol_pad name 56) (append (u32_le size) (append (le16 first) (le16 1)))))))

; The entry at byte at of b.
(def vol_entry_of ((b bytes) (at int)) VolEntry
  (if (eq (bit_and (le_u16_at b (add at 62)) 1) 0)
      (VolNone)
      (VolFile (vol_cstr b at (add at 56)) (le_u32 b (add at 56)) (le_u16_at b (add at 60)))))

; An empty directory.
(def vol_dir_new () (array VolEntry)
  (array_new (vol_entries) (VolNone)))

; The directory as its sectors hold it.
(def vol_dir_bytes ((d (array VolEntry))) (list int)
  (rev (vol_dir_push d 0 (nil int))))

(def vol_dir_push ((d (array VolEntry)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len d)) acc (vol_dir_push d (add i 1) (push (vol_entry_bytes (array_get d i)) acc))))

; The directory from byte at of b.
(def vol_dir_of ((b bytes) (at int)) (array VolEntry)
  (vol_dir_read b at (vol_dir_new) 0))

(def vol_dir_read ((b bytes) (at int) (d (array VolEntry)) (i int)) (array VolEntry)
  (if (ge i (array_len d))
      d
      (vol_dir_read b at (array_set d i (vol_entry_of b (add at (mul i (vol_entry_size))))) (add i 1))))

; ----------------------------------------------------------------- volume

; A volume, as its metadata holds it: its label, layout, table and
; directory.
(data Vol (Vol (list int) VolLayout (array int) (array VolEntry)))

; A new, empty volume.
(def vol_new ((label (list int)) (l VolLayout)) Vol
  (Vol label l (vol_table_new l) (vol_dir_new)))

; A volume's label, layout, and cluster table.
(def vol_label ((v Vol)) (list int) (match v ((Vol label l t d) label)))
(def vol_layout_of ((v Vol)) VolLayout (match v ((Vol label l t d) l)))
(def vol_table ((v Vol)) (array int) (match v ((Vol label l t d) t)))

; v emptied: every file gone, its label and layout kept.
(def vol_format ((v Vol)) Vol
  (vol_new (vol_label v) (vol_layout_of v)))

; v's metadata, all of its sectors: the superblock, table and directory,
; zeros after.
(def vol_meta ((v Vol)) (list int)
  (match v
    ((Vol label l t d)
      (vol_pad (append (vol_super label l) (append (vol_table_bytes t l) (vol_dir_bytes d)))
               (mul (vol_meta_sectors l) (vol_sector_size))))))

; A volume read, or why it cannot be used.
(data VolGot (VolGot Vol) (VolBad (list int)))

; The volume whose metadata b holds, its superblock having given label
; and l: refused if its table or a file's chain is not what it should be,
; so that a damaged disk cannot lead a server astray.
(def vol_of ((label (list int)) (l VolLayout) (b bytes)) VolGot
  (if (lt (bytes_len b) (mul (vol_meta_sectors l) (vol_sector_size)))
      (VolBad "the metadata is cut short")
      (let t (vol_table_of b (vol_sector_size) l)
        (let d (vol_dir_of b (mul (vol_dir_start l) (vol_sector_size)))
          (if (not (vol_table_ok t (vol_first_data l)))
              (VolBad "a damaged cluster table")
              (if (not (vol_dir_ok t d 0))
                  (VolBad "a damaged directory")
                  (VolGot (Vol label l t d))))))))

; Whether entries i on are good: names, and chains as long as the sizes.
(def vol_dir_ok ((t (array int)) (d (array VolEntry)) (i int)) bool
  (if (ge i (array_len d))
      true
      (if (vol_entry_ok t (array_get d i)) (vol_dir_ok t d (add i 1)) false)))

(def vol_entry_ok ((t (array int)) (e VolEntry)) bool
  (match e
    ((VolNone) true)
    ((VolFile name size first)
      (if (not (vol_name_ok name))
          false
          (eq (length (vol_chain t first)) (ceil_div size (vol_cluster_size)))))))

; --------------------------------------------------------------- the files

; The entry at i of v's directory.
(def vol_entry ((v Vol) (i int)) VolEntry
  (match v ((Vol label l t d) (array_get d i))))

; Where name is in v's directory, or -1.
(def vol_find ((v Vol) (name (list int))) int
  (match v ((Vol label l t d) (vol_find_from d name 0))))

(def vol_find_from ((d (array VolEntry)) (name (list int)) (i int)) int
  (if (ge i (array_len d))
      -1
      (match (array_get d i)
        ((VolFile n size first) (if (eq n name) i (vol_find_from d name (add i 1))))
        ((VolNone) (vol_find_from d name (add i 1))))))

; A free entry of v's directory, or -1.
(def vol_free_entry ((v Vol)) int
  (match v ((Vol label l t d) (vol_free_from_entry d 0))))

(def vol_free_from_entry ((d (array VolEntry)) (i int)) int
  (if (ge i (array_len d))
      -1
      (match (array_get d i)
        ((VolFile n size first) (vol_free_from_entry d (add i 1)))
        ((VolNone) i))))

; v's files, by name.
(def vol_files ((v Vol)) (list VolEntry)
  (match v ((Vol label l t d) (sort (vol_files_from d 0 (nil VolEntry))))))

(def vol_files_from ((d (array VolEntry)) (i int) (acc (list VolEntry))) (list VolEntry)
  (if (ge i (array_len d))
      acc
      (match (array_get d i)
        ((VolFile n size first) (vol_files_from d (add i 1) (cons (array_get d i) acc)))
        ((VolNone) (vol_files_from d (add i 1) acc)))))

; How many files v has.
(def vol_file_count ((v Vol)) int (length (vol_files v)))

; v with e at i of its directory.
(def vol_set_entry ((v Vol) (i int) (e VolEntry)) Vol
  (match v ((Vol label l t d) (Vol label l t (array_set d i e)))))

; v with a new, empty file name at its free entry i.
(def vol_create ((v Vol) (i int) (name (list int))) Vol
  (vol_set_entry v i (VolFile name 0 0)))

; v with the file at i emptied, its clusters freed.
(def vol_truncate ((v Vol) (i int)) Vol
  (match (vol_entry v i)
    ((VolNone) v)
    ((VolFile name size first) (vol_set_entry (vol_unchain v first) i (VolFile name 0 0)))))

; v with the file at i gone, its clusters freed.
(def vol_remove ((v Vol) (i int)) Vol
  (match (vol_entry v i)
    ((VolNone) v)
    ((VolFile name size first) (vol_set_entry (vol_unchain v first) i (VolNone)))))

; v with the file at i named name.
(def vol_rename ((v Vol) (i int) (name (list int))) Vol
  (match (vol_entry v i)
    ((VolNone) v)
    ((VolFile n size first) (vol_set_entry v i (VolFile name size first)))))

; v with the chain from first freed.
(def vol_unchain ((v Vol) (first int)) Vol
  (match v ((Vol label l t d) (Vol label l (vol_unlink t (vol_chain t first)) d))))

; ------------------------------------------------------------------ plans

; Bytes of a cluster: the cluster, the offset in it, and how many.
(data VolSpan (VolSpan int int int))

; Where the next bytes of the file at i are, from offset, at most n: in
; one cluster, so a read moves one; none at the file's end.
(def vol_read_span ((v Vol) (i int) (offset int) (n int)) (Option VolSpan)
  (match (vol_entry v i)
    ((VolNone) ((None VolSpan)))
    ((VolFile name size first)
      (let k (min n (min (sub size offset) (sub (vol_cluster_size) (mod offset (vol_cluster_size)))))
        (if (le k 0)
            ((None VolSpan))
            (let c (nth_or (vol_chain (vol_table v) first) (div offset (vol_cluster_size)) 0)
              (if (eq c 0)
                  ((None VolSpan))
                  (Some (VolSpan c (mod offset (vol_cluster_size)) k)))))))))

; A write planned: the volume after it, with the file's new size and any
; clusters it needed, the spans to write the bytes to, in order, and the
; clusters it took, which hold nothing yet; or no room for it.
(data VolWrote (VolWrote Vol (list VolSpan) (list int)) (VolNoSpace))

; n bytes written to the file at i from offset, which is not past its end.
(def vol_write ((v Vol) (i int) (offset int) (n int)) VolWrote
  (match (vol_entry v i)
    ((VolNone) (VolNoSpace))
    ((VolFile name size first)
      (let chain (vol_chain (vol_table v) first)
        (let need (sub (ceil_div (add offset n) (vol_cluster_size)) (length chain))
          (if (le need 0)
              (vol_wrote (vol_set_entry v i (VolFile name (max size (add offset n)) first)) chain offset n (nil int))
              (match (vol_alloc (vol_table v) need)
                ((VolFull) (VolNoSpace))
                ((VolAlloc t2 cs) (vol_grown v i t2 chain cs offset n)))))))))

; v with the clusters cs, now linked in t, joined to the end of the file
; at i, whose chain was chain.
(def vol_grown ((v Vol) (i int) (t (array int)) (chain (list int)) (cs (list int)) (offset int) (n int)) VolWrote
  (match v
    ((Vol label l t0 d)
      (match (array_get d i)
        ((VolNone) (VolNoSpace))
        ((VolFile name size first)
          (let t3 (if (is_empty chain) t (array_set t (head (rev chain)) (head cs)))
            (let f (if (is_empty chain) (head cs) first)
              (vol_wrote (Vol label l t3 (array_set d i (VolFile name (max size (add offset n)) f)))
                         (append chain cs) offset n cs))))))))

; The write planned on v, over chain, the file's clusters now.
(def vol_wrote ((v Vol) (chain (list int)) (offset int) (n int) (fresh (list int))) VolWrote
  (VolWrote v (vol_spans chain offset n (nil VolSpan)) fresh))

; The spans of n bytes from offset over chain, onto acc.
(def vol_spans ((chain (list int)) (offset int) (n int) (acc (list VolSpan))) (list VolSpan)
  (if (le n 0)
      (rev acc)
      (let at (mod offset (vol_cluster_size))
        (let k (min n (sub (vol_cluster_size) at))
          (vol_spans chain (add offset k) (sub n k)
                     (cons (VolSpan (nth_or chain (div offset (vol_cluster_size)) 0) at k) acc))))))

; The sector of v's partition, from start, that cluster c begins at.
(def vol_cluster_sector ((start int) (c int)) int
  (add start (mul c (vol_cluster_sectors))))
