; ttf_test.l0 -- tests of the TrueType reader, on the fonts it is for,
; fonts/SourceCodePro-Regular.ttf and SourceSans3-Regular.ttf: what
; their tables say, the glyphs of characters, outlines simple and
; composite, and their segments. Run from the top of the project.

(def font () Ttf
  (match (read_whole "fonts/SourceCodePro-Regular.ttf")
    ((Err why) (Ttf (bytes_from_list "") 0 false 0 0 0 0 0 0))
    ((Ok b) (match (ttf_read b) ((Ok f) f) ((Err why) (Ttf b 0 false 0 0 0 0 0 0))))))

(def test_upm () int (check_int "units per em" (ttf_upm (font)) 1000))

; Python's struct, over cmap's (3, 1) subtable, gives these glyphs.
(def test_glyph_index () int
  (let f (font)
    (add (check_int "A" (ttf_glyph_index f 65) 2)
         (add (check_int "space" (ttf_glyph_index f 32) 1)
              (check_int "@" (ttf_glyph_index f 64) 998)))))

(def test_advance () int
  (let f (font) (check_int "monospaced" (ttf_advance f (ttf_glyph_index f 77)) 600)))

(def test_contours () int
  (let f (font)
    (add (check_int "O, two rings" (length (ttf_contours f (ttf_glyph_index f 79))) 2)
         (check_int "space, none" (length (ttf_contours f (ttf_glyph_index f 32))) 0))))

; i is composite: its stem and its dot, two glyphs, each a contour.
(def test_composite () int
  (let f (font) (check_true "i, a stem and a dot" (ge (length (ttf_contours f (ttf_glyph_index f 105))) 2))))

(def test_not_a_font () int
  (match (ttf_read (bytes_from_list "not a font at all"))
    ((Ok f) (fail_because "read" "took text for a font"))
    ((Err why) (check_true "a reason" (not (is_empty why))))))

(def seg_text ((s RastSeg)) (list int)
  (match s
    ((RastMove x y) (append "M" (append (digits x) (append "," (digits y)))))
    ((RastLine x y) (append "L" (append (digits x) (append "," (digits y)))))
    ((RastQuad a b x y) (append "Q" (append (digits x) (append "," (digits y)))))
    ((RastCubic a b c d x y) "C")
    ((RastClose) "Z")))

(def segs_text ((ss (list RastSeg)) (acc (list (list int)))) (list int)
  (if (is_empty ss) (unwords (rev acc)) (segs_text (tail ss) (cons (seg_text (head ss)) acc))))

; Points on the curve are lines; a control point between two on it is a
; curve; between two controls the point midway is implied. Placed by x
; · 2 / 1, and y flipped about 100.
(def test_segments () int
  (check_str "a square with a curve"
    (segs_text (ttf_segs (cons (cons (TtfPt 0 0 true) (cons (TtfPt 10 0 true) (cons (TtfPt 10 10 false)
                             (cons (TtfPt 0 10 false) (nil TtfPt))))) (nil (list TtfPt)))
                         (TtfPlace 2 1 0 100))
               (nil (list int)))
    "M0,100 L20,100 Q10,80 Q0,100 Z"))

; A contour that starts off its curve is turned to start on it.
(def test_from_on () int
  (check_true "starts on the curve"
    (match (head (ttf_from_on (cons (TtfPt 0 0 false) (cons (TtfPt 4 0 true) (nil TtfPt)))))
      ((TtfPt x y on) (if on (eq x 4) false)))))

; ------------------------------------------------------- Source Sans 3

; fonts/SourceSans3-Regular.ttf, Source Code Pro's proportional
; companion, read as the font service reads it.
(def sans () Ttf
  (match (read_whole "fonts/SourceSans3-Regular.ttf")
    ((Err why) (Ttf (bytes_from_list "") 0 false 0 0 0 0 0 0))
    ((Ok b) (match (ttf_read b) ((Ok f) f) ((Err why) (Ttf b 0 false 0 0 0 0 0 0))))))

; The first code from c to 126 the font has no glyph for, or 127 if it
; has one for each.
(def sans_missing ((f Ttf) (c int)) int
  (if (gt c 126) 127 (if (eq (ttf_glyph_index f c) 0) c (sans_missing f (add c 1)))))

(def test_sans_reads () int
  (check_int "units per em" (ttf_upm (sans)) 1000))

; ---------------------------------------------------------------- kerning

; The kern of characters l and r in f, by its kern lookups.
(def kern_of ((f Ttf) (l int) (r int)) int
  (ttf_kern f (ttf_kern_lookups f) (ttf_glyph_index f l) (ttf_glyph_index f r)))

; Source Sans 3's kern feature, under DFLT, is one lookup, 8, an
; extension of 17 pair subtables; fontTools reads the same.
(def test_kern_lookups () int
  (check_strs "lookup 8" (map_digits (ttf_kern_lookups (sans))) (cons "8" (nil (list int)))))

(def map_digits ((xs (list int))) (list (list int))
  (if (is_empty xs) (nil (list int)) (cons (digits (head xs)) (map_digits (tail xs)))))

; AV and To are kerned by classes (format 2), as fontTools reads them:
; -14 and -66 units; x then a comma by a pair of its own (format 1), 7.
(def test_kern_pairs () int
  (add (check_int "AV" (kern_of (sans) 65 86) -14)
       (add (check_int "To" (kern_of (sans) 84 111) -66)
            (check_int "x," (kern_of (sans) 120 44) 7))))

; A pair no subtable adjusts, and Source Code Pro, which kerns nothing.
(def test_kern_none () int
  (add (check_int "oo" (kern_of (sans) 111 111) 0)
       (add (check_int "mono's AV" (kern_of (font) 65 86) 0)
            (check_int "mono has no kern lookups" (length (ttf_kern_lookups (font))) 0))))

; Its cmap finds a glyph for every printable ASCII code.
(def test_sans_cmap_ascii () int
  (check_int "first code with no glyph" (sans_missing (sans) 32) 127))

; It is proportional: i is narrower than m.
(def test_sans_advances () int
  (let f (sans)
    (check_true "i narrower than m"
      (lt (ttf_advance f (ttf_glyph_index f 105)) (ttf_advance f (ttf_glyph_index f 109))))))

; A composite glyph's outline is whole: each of its parts' contours is
; there, every one with points. Its i is its stem and its dot.
(def test_sans_composite () int
  (let f (sans)
    (let o (ttf_glyph_at f (ttf_glyph_index f 105))
      (let cs (ttf_contours f (ttf_glyph_index f 105))
        (add (check_true "i is composite" (lt (ttf_i16 (sans_bytes f) o) 0))
             (add (check_int "a stem and a dot" (length cs) 2)
                  (check_true "every contour has points" (not (any_empty cs)))))))))

; The font's bytes.
(def sans_bytes ((f Ttf)) bytes (match f ((Ttf b upm long n nh cm loca glyf hmtx) b)))

; Whether any of the contours has no points.
(def any_empty ((cs (list (list TtfPt)))) bool
  (if (is_empty cs) false (if (is_empty (head cs)) true (any_empty (tail cs)))))
