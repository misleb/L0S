; Tests of deflate.l0: what it writes, read back by inflate.l0, is what
; it was given, and runs come out small.

; b deflated and inflated again, as a list, or the fault's words.
(def round_trip ((b bytes)) (list int)
  (match (inflate_zlib (zlib_deflated b) 0 (bytes_len b))
    ((Err f) (append "fault: " (inflate_why f)))
    ((Ok r) (array_part (.out r) 0 (.len r) (nil int)))))

; The first n of a from i, as a list, after the reversed acc.
(def array_part ((a (array int)) (i int) (n int) (acc (list int))) (list int)
  (if (ge i n) (rev acc) (array_part a (add i 1) n (cons (array_get a i) acc))))

; n bytes of the seeded pseudorandom sequence from seed, below most.
(def noise ((seed int) (n int) (most int) (acc (list int))) (list int)
  (if (le n 0) acc (let r (rand_next seed) (noise r (sub n 1) most (cons (mod (bit_and (bit_shr r 8) 65535) most) acc)))))

(def test_deflate_empty () int
  (check_str "back" (round_trip (bytes_from_list "")) ""))

(def test_deflate_short () int
  (check_str "back" (round_trip (bytes_from_list "ab")) "ab"))

(def test_deflate_text () int
  (let s "the cat sat on the mat; the cat sat on the hat"
    (check_str "back" (round_trip (bytes_from_list s)) s)))

; A run of 1000 zeros is a literal and matches of 258 at distance 1.
(def test_deflate_run () int
  (let z (repeat 1000 0)
    (add (check_true "back" (eq (round_trip (bytes_from_list z)) z))
         (check_true "small" (lt (bytes_len (zlib_deflated (bytes_from_list z))) 30)))))

; Every byte value, and every length and distance symbol, pass through:
; random bytes of a few values, so matches of every length are found.
(def test_deflate_noise () int
  (let (a (noise 7 5000 256 (nil int))
        b (noise 9 20000 3 (nil int)))
    (add (check_true "bytes" (eq (round_trip (bytes_from_list a)) a))
         (check_true "few values" (eq (round_trip (bytes_from_list b)) b)))))

; Past 64 KB, and matches reaching back 30000, near the window's end:
; the copies cost little past the first.
(def test_deflate_window () int
  (let (piece (noise 3 30000 256 (nil int))
        all (append piece (append piece piece)))
    (add (check_true "back" (eq (round_trip (bytes_from_list all)) all))
         (check_true "the window" (lt (bytes_len (zlib_deflated (bytes_from_list all))) 40000)))))
