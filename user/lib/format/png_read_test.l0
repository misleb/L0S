; png_read_test.l0 -- tests of png_read.l0: PNGs Python wrote (zlib at
; level 9, each row filtered as the test says, by the PNG spec's
; filters), png.l0's own read back, the refusals, and fitting.

; The bytes the hex digits s spell, two a byte.
(def unhex ((s (list int))) bytes
  (bytes_from_list (rev (unhex_onto s (nil int)))))

; unhex's loop: each pair's byte onto acc, reversed.
(def unhex_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      acc
      (unhex_onto (tail (tail s)) (cons (add (mul 16 (hex_val (head s))) (hex_val (head (tail s)))) acc))))

; An image as text: its size, then each pixel's word in hex.
(def image_text ((img PngImage)) (list int)
  (append (digits (.w img))
          (append "x" (append (digits (.h img)) (append ":" (rev (words_onto (.px img) 0 (nil int))))))))

; image_text's loop: the words from i on, onto acc, reversed.
(def words_onto ((px (array int)) (i int) (acc (list int))) (list int)
  (if (ge i (array_len px))
      acc
      (words_onto px (add i 1) (push (hex_digits (array_get px i) 8) (push " " acc)))))

; What reading the PNG of hex digits s gave, as text.
(def read_text ((s (list int))) (list int)
  (match (png_read (unhex s))
    ((Ok img) (image_text img))
    ((Err f) (append "error: " (png_read_why f)))))

; 4 by 5 RGB, its rows filtered None, Sub, Up, Average and Paeth.
(def test_rgb_filters () int
  (check_str "rgb"
    (read_text "89504e470d0a1a0a0000000d4948445200000004000000050802000000edcfda8c000000384944415478da6360b822949f71fade9f16df09b68c820e37f3a7ec842026c19ce370c4ac7448dca1e1c08186034092052a3c65a760ce7100accb1c9e670961b60000000049454e44ae426082")
    "4x5: ff00d412 ff6f68cb ffdefc84 ff4d903d ff1140d9 ff80d492 ffef684b ff5efc04 ff22aca0 ff914059 ff00d412 ff6f68cb ff331867 ffa2ac20 ff1140d9 ff80d492 ff44842e ffb318e7 ff22aca0 ff914059"))

; 3 by 2 RGBA, Paeth on the first row (Sub, as nothing is above it),
; Average on the second.
(def test_rgba () int
  (check_str "rgba"
    (read_text "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a0000001e4944415478da6361b822b42b7fcace7b20cc2c78ed42bd43c30106100600a4540c1250884f3f0000000049454e44ae426082")
    "3x2: ba00d412 986f68cb 76defc84 dc1140d9 ba80d492 98ef684b"))

; 3 by 2 gray, Sub and Paeth, its tRNS making gray 0x6f transparent.
(def test_gray_keyed () int
  (check_str "gray"
    (read_text "89504e470d0a1a0a0000000d4948445200000003000000020800000000b81f39c60000000274524e53006fab9eb1f1000000104944415478da6364c8cf671114140400054b0117f2f2a97d0000000049454e44ae426082")
    "3x2: ff000000 006f6f6f ffdedede ff111111 ff808080 ffefefef"))

; 2 by 2 gray with alpha, Average then Up.
(def test_gray_alpha () int
  (check_str "gray and alpha"
    (read_text "89504e470d0a1a0a0000000d4948445200000002000000020804000000d8bfc5af000000124944415478da6366b892ff8f49304730070011e50341ab7d232d0000000049454e44ae426082")
    "2x2: d4000000 686f6f6f 40111111 d4808080"))

; 3 by 2 of a palette of red, green and blue, red's alpha 0x80 from
; tRNS: indices 0 1 2, then 2 1 0 by Up.
(def test_palette () int
  (check_str "palette"
    (read_text "89504e470d0a1a0a0000000d4948445200000003000000020803000000aaaa962800000009504c5445ff000000ff000000ff2d4acd8a0000000174524e5380ad5e5b46000000104944415478da63606064626262f80700012401063f1815370000000049454e44ae426082")
    "3x2: 80ff0000 ff00ff00 ff0000ff ff0000ff ff00ff00 80ff0000"))

; png.l0's 2 by 2, red, green, blue and white, read back.
(def test_png_writer_round_trip () int
  (let rows (cons (png_row (cons 16711680 (cons 65280 (nil int)))) (cons (png_row (cons 255 (cons 16777215 (nil int)))) (nil bytes)))
    (match (png_read (png_bytes 2 2 rows))
      ((Ok img) (check_str "2 by 2" (image_text img) "2x2: ffff0000 ff00ff00 ff0000ff ffffffff"))
      ((Err f) (fail_because "2 by 2" (png_read_why f))))))

; png.l0's 300 by 200 of seeded colors, its rows in two stored blocks,
; read back pixel for pixel.
(def test_png_writer_large () int
  (let (colors (writer_colors 9 60000 (nil int))
        rows (writer_rows colors 300 (nil bytes)))
    (match (png_read (png_bytes 300 200 rows))
      ((Ok img) (check_bool "same" (eq (array_to_list (.px img)) (opaque colors (nil int))) true))
      ((Err f) (fail_because "300 by 200" (png_read_why f))))))

; n seeded colors from state s, onto acc.
(def writer_colors ((s int) (n int) (acc (list int))) (list int)
  (if (eq n 0) (rev acc) (let t (rand_next s) (writer_colors t (sub n 1) (cons (bit_and t 16777215) acc)))))

; colors as rows of w, each png_row's bytes, onto acc.
(def writer_rows ((colors (list int)) (w int) (acc (list bytes))) (list bytes)
  (if (is_empty colors) (rev acc) (writer_rows (drop colors w) w (cons (png_row (take colors w)) acc))))

; colors each opaque, onto acc.
(def opaque ((colors (list int)) (acc (list int))) (list int)
  (if (is_empty colors) (rev acc) (opaque (tail colors) (cons (bit_or (head colors) 4278190080) acc))))

; The header alone: 4 by 5, 8 bits, color type 2, not interlaced, even
; with its image data cut off.
(def test_header () int
  (match (png_read_header (bytes_slice (unhex "89504e470d0a1a0a0000000d4948445200000004000000050802000000edcfda8c00000038") 0 37))
    ((Ok i) (check_str "header" (unwords (cons (digits (.w i)) (cons (digits (.h i)) (cons (digits (.depth i)) (cons (digits (.color i)) (cons (digits (.interlace i)) (nil (list int))))))))
                       "4 5 8 2 0"))
    ((Err f) (fail_because "header" (png_read_why f)))))

; 16-bit samples and Adam7 are refused, saying so.
(def test_refused () int
  (add (check_str "16-bit"
         (read_text "89504e470d0a1a0a0000000d4948445200000001000000011002000000c0e78f9d0000000b4944415478da6360000300000700012122db130000000049454e44ae426082")
         "error: a PNG of 16-bit samples")
       (check_str "interlaced"
         (read_text "89504e470d0a1a0a0000000d4948445200000001000000010802000001e77063480000000c4944415478da63606060000000040001c8eaebf90000000049454e44ae426082")
         "error: a PNG of Adam7 interlacing")))

; Not a PNG; one cut before IEND; one whose image data is no zlib.
(def test_bad_files () int
  (add (check_str "not" (read_text "474946383961") "error: not a PNG")
       (add (check_str "cut" (read_text "89504e470d0a1a0a0000000d4948445200000001000000010802000000907753de0000000f4944415478") "error: the PNG ends too soon")
            (check_str "data" (read_text "89504e470d0a1a0a0000000d4948445200000001000000010802000000907753de000000024944415478009b1d4e440000000049454e44ae426082")
                       "error: bad image data: not a zlib stream of deflate"))))

; Color type 3 with no PLTE.
(def test_no_palette () int
  (check_str "no palette"
    (read_text "89504e470d0a1a0a0000000d4948445200000001000000010803000000000000000000000049454e44ae426082")
    "error: a palette image with no palette"))

; A 4 by 2 image fitted to 2 by 2 is 2 by 1, each pixel two columns'
; and both rows' mean: red and blue over two blacks make 0x40 of
; each; white at alpha 0x80 beside three opaque whites stays white, its
; alpha (128 + 3 · 255) / 4, 0xdf.
(def test_fit () int
  (let img (PngImage 4 2 (array_from (cons 4294901760 (cons 4278190335 (cons 2164260863 (cons 4294967295
                                            (cons 4278190080 (cons 4278190080 (cons 4294967295 (cons 4294967295 (nil int))))))))) 0))
    (check_str "fit" (image_text (png_fit img 2 2)) "2x1: ff400040 dfffffff")))

; An image that fits already is itself.
(def test_fit_fits () int
  (let img (PngImage 1 1 (array_new 1 4278190080))
    (check_str "fits" (image_text (png_fit img 5 5)) "1x1: ff000000")))

; A tall image is fitted by its height: 2 by 6 into 4 by 3 is 1 by 3.
(def test_fit_tall () int
  (let img (PngImage 2 6 (array_new 12 4294967295))
    (check_str "tall" (image_text (png_fit img 4 3)) "1x3: ffffffff ffffffff ffffffff")))
