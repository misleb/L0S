; ------------------------------------------------------------- placement

(def place_text ((p Place)) (list int)
  (match p
    ((Place to sx sy)
      (match to
        ((Rect dx dy cw ch)
          (append (digits dx) (append "," (append (digits dy) (append " from " (append (digits sx)
            (append "," (append (digits sy) (append " " (append (digits cw) (append "x" (digits ch))))))))))))))))

(def test_placement_smaller () int
  (check_str "centered" (place_text (placement 1280 800 640 360)) "320,220 from 0,0 640x360"))

(def test_placement_equal () int
  (check_str "whole" (place_text (placement 640 360 640 360)) "0,0 from 0,0 640x360"))

(def test_placement_larger () int
  (check_str "cut" (place_text (placement 640 360 1000 400)) "0,0 from 180,20 640x360"))

; ------------------------------------------------------------- commands

(def nums_text ((ns (list int))) (list int)
  (if (is_empty ns) "" (append " " (append (digits (head ns)) (nums_text (tail ns))))))

(def cmd_text ((c Command)) (list int)
  (match c
    ((CmdLine a b d e k) (append "line" (nums_text (cons a (cons b (cons d (cons e (cons k (nil int)))))))))
    ((CmdCircle a b r k) (append "circle" (nums_text (cons a (cons b (cons r (cons k (nil int))))))))
    ((CmdDisc a b r k) (append "disc" (nums_text (cons a (cons b (cons r (cons k (nil int))))))))
    ((CmdRect a b d e k) (append "rect" (nums_text (cons a (cons b (cons d (cons e (cons k (nil int)))))))))
    ((CmdFill a b d e k) (append "fill" (nums_text (cons a (cons b (cons d (cons e (cons k (nil int)))))))))
    ((CmdClear k) (append "clear" (nums_text (cons k (nil int)))))
    ((CmdChar a b code k) (append "char" (nums_text (cons a (cons b (cons code (cons k (nil int))))))))
    ((CmdText a b fg bg cs) (append "text" (append (nums_text (cons a (cons b (cons fg (cons bg (nil int)))))) (append " " cs))))
    ((CmdScroll dy k) (append "scroll" (nums_text (cons dy (cons k (nil int))))))
    ((CmdRestore a b d e) (append "restore" (nums_text (cons a (cons b (cons d (cons e (nil int))))))))
    ((CmdSplash p) (append "splash" (nums_text (cons p (nil int)))))
    ((CmdSize) "size")
    ((CmdFont) "font")))

(def parsed ((s (list int))) (list int)
  (match (parse_command (split_spaces s))
    ((Ok c) (cmd_text c))
    ((Err why) (append "error: " why))))

(def test_parse_line () int
  (add (check_str "white by default" (parsed "line 0 0 99 -5") "line 0 0 99 -5 16777215")
       (check_str "red" (parsed "line 1 2 3 4 red") "line 1 2 3 4 16711680")))

(def test_parse_round () int
  (add (check_str "circle" (parsed "circle 640 400 200 cyan") "circle 640 400 200 65535")
       (add (check_str "disc, hex" (parsed "disc 10 20 5 FF8800") "disc 10 20 5 16746496")
            (check_str "negative radius" (parsed "disc 10 20 -5") "error: disc's radius must not be negative"))))

(def test_parse_boxes () int
  (add (check_str "rect" (parsed "rect 1 2 30 40 green") "rect 1 2 30 40 65280")
       (check_str "fill" (parsed "fill 1 2 30 40") "fill 1 2 30 40 16777215")))

(def test_parse_bare () int
  (add (check_str "clear, black by default" (parsed "clear") "clear 0")
       (add (check_str "clear blue" (parsed "clear blue") "clear 255")
            (add (check_str "size" (parsed "size") "size")
                 (check_str "font" (parsed "font") "font")))))

(def test_parse_splash () int
  (add (check_str "full" (parsed "splash") "splash 100")
       (add (check_str "faded" (parsed "splash 30") "splash 30")
            (add (check_str "too bright" (parsed "splash 101") "error: splash's brightness must be from 0 to 100")
                 (add (check_str "not a number" (parsed "splash now") "error: splash's brightness must be from 0 to 100")
                      (check_str "two" (parsed "splash 1 2") "error: splash takes a brightness at most"))))))

(def test_parse_char () int
  (add (check_str "white by default" (parsed "char 8 16 65") "char 8 16 65 16777215")
       (add (check_str "amber" (parsed "char 0 0 95 amber") "char 0 0 95 15779920")
            (add (check_str "below the font" (parsed "char 0 0 31") "error: char's code must be from 32 to 126")
                 (check_str "above it" (parsed "char 0 0 127") "error: char's code must be from 32 to 126")))))

(def test_parse_restore () int
  (add (check_str "restore" (parsed "restore 8 16 8 16") "restore 8 16 8 16")
       (add (check_str "with a color" (parsed "restore 8 16 8 16 red") "error: restore takes 4 numbers")
            (check_str "too few" (parsed "restore 8 16") "error: restore takes 4 numbers"))))

(def test_split_commands () int
  (let cs (split_commands (split_spaces "restore 0 0 8 16 ; char 0 0 65 ; size"))
    (add (check_int "three" (length cs) 3)
         (add (check_strs "first" (head cs) (split_spaces "restore 0 0 8 16"))
              (check_strs "last" (head (rev cs)) (split_spaces "size"))))))

(def test_split_one () int
  (check_int "one" (length (split_commands (split_spaces "line 0 0 9 9"))) 1))

; --------------------------------------------------------------- font

; Every glyph blank but these, as a font file would have them.
(def blank_rows () (list int) (rows_text 16 "........\n"))

(def rows_text ((n int) (row (list int))) (list int)
  (if (eq n 0) "" (append row (rows_text (sub n 1) row))))

(def font_text ((code int) (acc (list int))) (list int)
  (if (gt code 126)
      (rev acc)
      (font_text (add code 1)
        (push (append "@ " (append (digits code) (append "\n" (if (eq code 65) (a_rows) (blank_rows))))) acc))))

; An A of sorts: row 2 #......#, the rest blank.
(def a_rows () (list int)
  (append (rows_text 2 "........\n") (append "#......#\n" (rows_text 13 "........\n"))))

(def font_error ((text (list int))) (list int)
  (match (parse_font text) ((Ok rows) "parsed") ((Err why) why)))

(def test_parse_font () int
  (match (parse_font (append "; a comment\n" (font_text 32 (nil int))))
    ((Ok rows)
      (add (check_int "95 glyphs of 16 rows" (array_len rows) 1520)
           (add (check_int "A's row 2" (glyph_row rows 65 2) 129)
                (check_int "A's row 3" (glyph_row rows 65 3) 0))))
    ((Err why) (fail_because "font" why))))

(def test_font_errors () int
  (add (check_str "a glyph short" (font_error (append "@ 32\n" (rows_text 3 "........\n"))) "glyph 32 cut short")
       (add (check_str "a bad row" (font_error (append "@ 32\n" (append "..x.....\n" (blank_rows)))) "glyph 32, row 0 is not 8 of # and .")
            (add (check_str "a long row" (font_error (append "@ 32\n" (append ".........\n" (blank_rows)))) "glyph 32, row 0 is not 8 of # and .")
                 (add (check_str "out of range" (font_error "@ 127\n") "no glyph 127")
                      (check_str "not a header" (font_error "hello\n") "not a glyph's header: hello"))))))

(def test_font_twice_and_missing () int
  (add (check_str "twice" (font_error (append "@ 32\n" (append (blank_rows) (append "@ 32\n" (blank_rows))))) "glyph 32 twice")
       (check_str "only 32" (font_error (append "@ 32\n" (blank_rows))) "no glyph 33")))

; The font the demo boots with.
(def test_the_font_file () int
  (match (open_in "fonts/l0s-8x16.txt")
    ((IoFailed fault why) (fail_because "open" why))
    ((IoOpened f)
      (match (file_read_all f)
        ((IoReadFailed code) (fail_because "read" (io_error code)))
        ((IoBytes b)
          (match (parse_font (bytes_to_list b))
            ((Ok rows)
              (add (check_int "every glyph" (array_len rows) 1520)
                   (add (check_int "a blank space" (glyph_row rows 32 6) 0)
                        (check_int "H's bar, row 6" (glyph_row rows 72 6) 254))))
            ((Err why) (fail_because "parse" why))))))))

; ------------------------------------------------------------ background

(def test_dim () int
  (add (check_int "whole" (dim 16777215 100) 16777215)
       (add (check_int "half" (dim 13158600 50) 6579300)     ; c8c8c8 to 646464
            (add (check_int "none" (dim 16777215 0) 0)
                 (check_int "each channel" (dim 1056816 30) 264462)))))   ; 102030 at 30%: 16, 32, 48 to 4, 9, 14, 04090e

; The 2 by 1 image, red then blue, on a 4 by 3 screen: at 1, 1 and 2, 1.
(def tiny_bg ((percent int)) Background
  (Background (bytes_from_list (append "P6\n2 1\n255\n" (cons 255 (cons 0 (cons 0 (cons 0 (cons 0 (cons 255 (nil int)))))))))
              2 1 11 percent))

(def test_background_at () int
  (add (check_int "the image's red" (background_at (tiny_bg 100) 4 3 1 1) 16711680)
       (add (check_int "its blue" (background_at (tiny_bg 100) 4 3 2 1) 255)
            (add (check_int "around it, the corner's red" (background_at (tiny_bg 100) 4 3 0 0) 16711680)
                 (add (check_int "faded" (background_at (tiny_bg 50) 4 3 2 1) 127)
                      (check_int "none" (background_at (NoBackground) 4 3 0 0) 0))))))

; ------------------------------------------------- drawing, on an array

; Each row of f as a line of # for pixels of color c and . for the rest.
(def canvas_art ((f Canvas) (c int)) (list (list int))
  (art_rows f c 0 (nil (list int))))

(def art_rows ((f Canvas) (c int) (y int) (acc (list (list int)))) (list (list int))
  (if (ge y (canvas_h f)) (rev acc) (art_rows f c (add y 1) (cons (art_row f c y 0 (nil int)) acc))))

(def art_row ((f Canvas) (c int) (y int) (x int) (acc (list int))) (list int)
  (if (ge x (canvas_w f)) (rev acc) (art_row f c y (add x 1) (cons (if (eq (canvas_pixel f x y) c) 35 46) acc))))

(def test_canvas_new () int
  (add (check_int "its width" (canvas_w (canvas_new 3 2 5)) 3)
       (check_int "every pixel the color" (canvas_pixel (canvas_new 3 2 5) 2 1) 5)))

; A canvas 3 wide, 4 high, a mark at each row's column 1 except the
; first: row 1, row 2 twice, row 3.
(def marked () Canvas
  (put (put (put (put (canvas_new 3 4 0) 1 1 7) 0 2 7) 2 2 7) 1 3 7))

; Rows 1 to 3 moved up 1, within columns 0 to 2 of rows 0 to 3: each row
; the one below it, the last left as it was.
(def test_copy_rows_up () int
  (check_strs "up a row" (canvas_art (canvas_copy_rows (marked) (Rect 0 0 3 4) 1) 7) (split_spaces ".#. #.# .#. .#.")))

; Moved down 1: each row the one above it, the first left as it was.
(def test_copy_rows_down () int
  (check_strs "down a row" (canvas_art (canvas_copy_rows (marked) (Rect 0 0 3 4) -1) 7) (split_spaces "... ... .#. #.#")))

; Only columns 1 and 2 of rows 1 to 3 move up: column 0 stays.
(def test_copy_rows_inside () int
  (check_strs "the area alone" (canvas_art (canvas_copy_rows (marked) (Rect 1 1 2 3) 1) 7) (split_spaces "... ..# ##. .#.")))

(def test_copy_rows_none () int
  (add (check_strs "no rows" (canvas_art (canvas_copy_rows (marked) (Rect 0 0 3 4) 0) 7) (split_spaces "... .#. #.# .#."))
       (check_strs "as many as it has" (canvas_art (canvas_copy_rows (marked) (Rect 0 0 3 4) 4) 7) (split_spaces "... .#. #.# .#."))))

(def test_put () int
  (check_strs "one pixel" (canvas_art (put (canvas_new 3 2 0) 1 1 7) 7) (split_spaces "... .#.")))

; A span cut to the row: from -2 to 1 is columns 0 and 1.
(def test_span_cut () int
  (add (check_strs "cut at the left" (canvas_art (span (canvas_new 4 1 0) 0 -2 1 7) 7) (split_spaces "##.."))
       (check_strs "off the canvas, nothing" (canvas_art (span (canvas_new 4 1 0) 1 0 3 7) 7) (split_spaces "...."))))

; A disc of radius 2: rows -2 and 2 are isqrt(0) = 0 wide each way, rows
; -1 and 1 isqrt(3) = 1, row 0 2.
(def test_disc () int
  (check_strs "rows by isqrt" (canvas_art (disc (canvas_new 5 5 0) 2 2 2 7 -2) 7)
    (split_spaces "..#.. .###. ##### .###. ..#..")))

(def test_fill_rect () int
  (check_strs "cut to the canvas" (canvas_art (fill_rect (canvas_new 4 3 0) 2 1 5 5 7) 7)
    (split_spaces ".... ..## ..##")))

(def test_outline () int
  (check_strs "its edges" (canvas_art (outline (canvas_new 4 3 0) 0 0 4 3 7) 7)
    (split_spaces "#### #..# ####")))

(def test_plot_all () int
  (check_strs "a line, off the canvas cut" (canvas_art (plot_all (canvas_new 3 3 0) (line_points -1 -1 2 2) 7) 7)
    (split_spaces "#.. .#. ..#")))

; Scrolling a row up moves the top, so row 0 shows what was row 1, and
; the new bottom row is the color given.
(def test_scrolled () int
  (let f (scrolled (fill_rect (canvas_new 2 3 0) 0 1 2 1 7) 1 9)
    (add (check_int "the top moved" (canvas_top f) 1)
         (add (check_strs "row 1 now first" (canvas_art f 7) (split_spaces "## .. .."))
              (check_strs "the new row" (canvas_art f 9) (split_spaces ".. .. ##"))))))

; The tiny background, red then blue at 1, 1 and 2, 1 of 4 by 3, red
; around it.
(def test_paint_background () int
  (let f (paint_background (canvas_new 4 3 0) (tiny_bg 100))
    (add (check_strs "the image's blue" (canvas_art f 255) (split_spaces ".... ..#. ...."))
         (check_strs "red around it" (canvas_art f 16711680) (split_spaces "#### ##.# ####")))))

(def test_restore_rect () int
  (let f (restore_rect (canvas_new 4 3 0) (tiny_bg 100) (Rect -1 0 3 2))
    (check_strs "cut to the canvas" (canvas_art f 16711680) (split_spaces "##.. ##.. ...."))))

(def test_parse_errors () int
  (add (check_str "nothing" (parsed "") "error: no command")
       (add (check_str "unknown" (parsed "blah 1 2") "error: no command blah")
            (add (check_str "too few" (parsed "line 1 2 3") "error: line takes 4 numbers and a color")
                 (add (check_str "too many" (parsed "circle 1 2 3 red 5") "error: circle takes 3 numbers and a color")
                      (check_str "bad color" (parsed "circle 10 10 5 nocolor") "error: no color nocolor"))))))

(def test_parse_numbers () int
  (add (check_str "not a number" (parsed "line 1 x 3 4") "error: line's numbers must be from -10000 to 10000")
       (add (check_str "too big" (parsed "line 1 10001 3 4") "error: line's numbers must be from -10000 to 10000")
            (add (check_str "a lone -" (parsed "line 1 - 3 4") "error: line's numbers must be from -10000 to 10000")
                 (check_str "the limit" (parsed "line -10000 10000 0 0") "line -10000 10000 0 0 16777215")))))

(def test_parse_color () int
  (add (check_int "amber" (option_or (parse_color "amber") -1) 15779920)
       (add (check_int "hex, either case" (option_or (parse_color "00aAfF") -1) 43775)
            (add (check_int "not hex" (option_or (parse_color "00aagg") -1) -1)
                 (check_int "too short" (option_or (parse_color "fff") -1) -1)))))

(def option_or ((o (Option int)) (d int)) int
  (match o ((Some v) v) ((None) d)))

; --------------------------------------------------------------- shapes

(def points_text ((ps (list Point))) (list int)
  (if (is_empty ps)
      ""
      (match (head ps)
        ((Point x y) (append (digits x) (append "," (append (digits y) (append " " (points_text (tail ps))))))))))

(def test_line_horizontal () int
  (check_str "points" (points_text (line_points 0 0 3 0)) "0,0 1,0 2,0 3,0 "))

(def test_line_vertical_up () int
  (check_str "points" (points_text (line_points 5 2 5 -1)) "5,2 5,1 5,0 5,-1 "))

(def test_line_diagonal () int
  (check_str "points" (points_text (line_points 0 0 2 2)) "0,0 1,1 2,2 "))

(def test_line_steep () int
  (check_str "points" (points_text (line_points 0 0 1 3)) "0,0 0,1 1,2 1,3 "))

(def test_line_single () int
  (check_str "points" (points_text (line_points 7 7 7 7)) "7,7 "))

(def test_line_count () int
  (add (check_int "shallow" (length (line_points 10 20 -90 -5)) 101)
       (check_int "reversed" (length (line_points 1279 799 0 0)) 1280)))

(def test_line_ends () int
  (let ps (line_points 3 9 -40 17)
    (add (check_str "first" (points_text (cons (head ps) (nil Point))) "3,9 ")
         (check_str "last" (points_text (cons (head (rev ps)) (nil Point))) "-40,17 "))))

(def has_point ((ps (list Point)) (x int) (y int)) bool
  (any_eq (Point x y) ps))

(def test_circle_extremes () int
  (let ps (circle_points 640 400 300)
    (add (check_true "right" (has_point ps 940 400))
         (add (check_true "left" (has_point ps 340 400))
              (add (check_true "bottom" (has_point ps 640 700))
                   (check_true "top" (has_point ps 640 100)))))))

(def test_circle_on_the_circle () int
  (check_true "no point far off" (all_near (circle_points 0 0 50) 50)))

; Whether every point is within one pixel of the circle of radius r.
(def all_near ((ps (list Point)) (r int)) bool
  (if (is_empty ps)
      true
      (match (head ps)
        ((Point x y)
          (let d (isqrt (add (mul x x) (mul y y)))
            (if (if (ge d (sub r 1)) (le d r) false) (all_near (tail ps) r) false))))))

(def test_circle_zero () int
  (check_true "the center" (has_point (circle_points 4 5 0) 4 5)))

(def test_isqrt () int
  (add (check_int "0" (isqrt 0) 0)
       (add (check_int "1" (isqrt 1) 1)
            (add (check_int "15" (isqrt 15) 3)
                 (add (check_int "16" (isqrt 16) 4)
                      (check_int "big" (isqrt 100000000) 10000))))))

(def cuts ((r int) (dy int) (n int)) (list int)
  (if (ge dy n) "" (append (digits (corner_cut r dy)) (append " " (cuts r (add dy 1) n)))))

(def test_corner_cut_12 () int
  (check_str "a circle's quadrant, and nothing below it" (cuts 12 0 13) "9 6 5 4 3 2 1 1 1 0 0 0 0 "))

(def test_corner_cut_small () int
  (add (check_str "radius 0 cuts nothing" (cuts 0 0 3) "0 0 0 ")
       (check_str "radius 1 cuts nothing either, radius 2 its corner pixel" (append (cuts 1 0 1) (cuts 2 0 2)) "0 1 0 ")))

(def span_text ((s Span)) (list int)
  (match s ((Span lo hi) (append (digits lo) (append "-" (digits hi)))) ((NoSpan) "none")))

(def test_clip_span () int
  (add (check_str "inside" (span_text (clip_span 2 5 10)) "2-5")
       (add (check_str "cut both ends" (span_text (clip_span -3 20 10)) "0-9")
            (add (check_str "off the left" (span_text (clip_span -9 -1 10)) "none")
                 (check_str "off the right" (span_text (clip_span 10 12 10)) "none")))))

; ------------------------------------------------------------ text, scroll

(def test_parse_text () int
  (add (check_str "on a color" (parsed "text 8 16 white 101820 6869") "text 8 16 16777215 1054752 hi")
       (add (check_str "on nothing" (parsed "text 0 0 amber none 41") "text 0 0 15779920 -1 A")
            (add (check_str "odd hex" (parsed "text 0 0 white none 686") "error: text's characters must be pairs of hex digits")
                 (check_str "too few" (parsed "text 0 0 white 6869") "error: text takes X Y COLOR BACKGROUND HEX")))))

(def test_parse_scroll () int
  (add (check_str "black" (parsed "scroll 16") "scroll 16 0")
       (add (check_str "slate" (parsed "scroll 32 101820") "scroll 32 1054752")
            (check_str "up only" (parsed "scroll -16") "error: scroll's rows must be from 0 to 10000"))))

(def test_unhex () int
  (match (unhex "48690a" (nil int))
    ((Some cs) (check_str "bytes" cs "Hi\n"))
    ((None) (fail_because "hex" "none"))))

(def test_drawable () int
  (add (check_int "itself" (drawable 65) 65)
       (check_int "a newline as ?" (drawable 10) 63)))

; Rounding is to nearest, halves up, the same either side of zero's
; truncation.
(def test_float_round () int
  (add (check_int "2.5" (float_round 2.5) 3)
       (add (check_int "-0.5" (float_round -0.5) 0)
            (add (check_int "-1.5" (float_round -1.5) -1)
                 (check_int "-1.4" (float_round -1.4) -1)))))

(def test_float_floor () int
  (add (check_int "whole" (float_floor 3.0) 3)
       (add (check_int "negative whole" (float_floor -3.0) -3)
            (check_int "negative" (float_floor -0.25) -1))))

(def test_float_abs () int
  (add (check_int "negative" (float_to_int (float_abs -7.0)) 7)
       (check_int "positive" (float_to_int (float_abs 7.0)) 7)))

(def test_row_at () int
  (add (check_int "no scroll" (row_at 0 800 5) 5)
       (add (check_int "scrolled" (row_at 16 800 5) 21)
            (check_int "around the ring" (row_at 790 800 20) 10))))

