; raster.l0 -- outlines to coverage: how much of each pixel a shape covers,
; 0 to 15. Points are integers in 1/256 pixel; the curves and the places
; edges cross samples are worked out in floats and rounded to nearest, and
; the coverage itself is summed in integers.
;
; A shape is contours of segments, lines and quadratic and cubic Bézier
; curves, in 1/256 of a pixel, y down. The curves are cut into lines, few
; enough that none strays more than an eighth of a pixel from its curve.
; Each pixel row is sampled 16 times, at the middle of each sixteenth;
; along each sample the edges that cross it are found, and the stretches
; inside the shape by the nonzero or the even-odd rule are added to the
; row exactly, in 1/256 pixel. A pixel wholly inside gets 16 · 256 =
; 4096 (rast_sums), and its level is that scaled to 0 to 15
; (rast_cover). cursors.paths' shapes are drawn one at a time and put
; together by keeping each pixel's most, so that strokes and fills of
; one pointer never cancel; svg.l0 composites the sums instead. Strokes are
; polygons too: a band along each line and a disc at each join
; (rast_stroke).
;
; tools/mkfont and the SVG library (svg.l0) share it. Points are
; render.l0's Point.

; ------------------------------------------------------------------ shapes

; A segment of a contour: a move to a point, which starts one; a line, a
; quadratic or a cubic curve from where the one before ended, its control
; points then its end; or the contour closed, back to where it began.
(data RastSeg
  (RastMove int int)
  (RastLine int int)
  (RastQuad int int int int)
  (RastCubic int int int int int int)
  (RastClose))

; One pixel, in 1/256 of a pixel.
(def rast_one () int 256)

; ------------------------------------------------------------- flattening

; The contours of segs, each as the points of the lines that make it, the
; curves cut into lines.
(def rast_polygons ((segs (list RastSeg))) (list (list Point))
  (rast_flat segs 3 0 0 (nil Point) (nil (list Point))))

; The same as lines to stroke: every contour of two points or more, as
; they run, whether closed or not.
(def rast_polylines ((segs (list RastSeg))) (list (list Point))
  (rast_flat segs 2 0 0 (nil Point) (nil (list Point))))

; Through segs, at x, y, the contour so far reversed in cur, the contours
; done reversed in acc, each kept if it has at least keep points.
(def rast_flat ((segs (list RastSeg)) (keep int) (x int) (y int) (cur (list Point)) (acc (list (list Point)))) (list (list Point))
  (if (is_empty segs)
      (rev (rast_done cur keep acc))
      (match (head segs)
        ((RastMove nx ny) (rast_flat (tail segs) keep nx ny (cons (Point nx ny) (nil Point)) (rast_done cur keep acc)))
        ((RastLine nx ny) (rast_flat (tail segs) keep nx ny (cons (Point nx ny) (rast_started cur x y)) acc))
        ((RastQuad cx cy nx ny)
          (rast_flat (tail segs) keep nx ny (rast_quad_onto x y cx cy nx ny (rast_quad_steps x y cx cy nx ny) 1 (rast_started cur x y)) acc))
        ((RastCubic ax ay bx by nx ny)
          (rast_flat (tail segs) keep nx ny
                     (rast_cubic_onto x y ax ay bx by nx ny (rast_cubic_steps x y ax ay bx by nx ny) 1 (rast_started cur x y)) acc))
        ((RastClose) (rast_flat (tail segs) keep x y (nil Point) (rast_done cur keep acc))))))

; A contour with at least its first point: x, y, where a segment with no
; move before it starts.
(def rast_started ((cur (list Point)) (x int) (y int)) (list Point)
  (if (is_empty cur) (cons (Point x y) (nil Point)) cur))

; A contour finished: kept if it has keep points or more.
(def rast_done ((cur (list Point)) (keep int) (acc (list (list Point)))) (list (list Point))
  (if (lt (length cur) keep) acc (cons (rev cur) acc)))

; v without its sign.
(def rast_abs((v int)) int (if (lt v 0) (neg v) v))

; How far a curve bends: the larger of a second difference's two parts.
(def rast_bend ((x0 int) (y0 int) (x1 int) (y1 int) (x2 int) (y2 int)) int
  (max (rast_abs (add (sub x0 (mul 2 x1)) x2)) (rast_abs (add (sub y0 (mul 2 y1)) y2))))

; How many lines a quadratic curve is cut into: n of them stray at most
; bend / 8n² from it, which is at most an eighth of a pixel, 32, once
; n² ≥ bend / 256.
(def rast_quad_steps ((x0 int) (y0 int) (cx int) (cy int) (x1 int) (y1 int)) int
  (add 1 (float_floor (float_sqrt (float_div (float_of (rast_bend x0 y0 cx cy x1 y1)) 256.0)))))

; The same for a cubic one: n lines stray at most 3 bend / 4n².
(def rast_cubic_steps ((x0 int) (y0 int) (ax int) (ay int) (bx int) (by int) (x1 int) (y1 int)) int
  (let bend (max (rast_bend x0 y0 ax ay bx by) (rast_bend ax ay bx by x1 y1))
    (add 1 (float_floor (float_sqrt (float_div (float_of (mul 3 bend)) 128.0))))))

; Points i to n of n along a quadratic curve, consed onto acc.
(def rast_quad_onto ((x0 int) (y0 int) (cx int) (cy int) (x1 int) (y1 int) (n int) (i int) (acc (list Point))) (list Point)
  (if (gt i n)
      acc
      (rast_quad_onto x0 y0 cx cy x1 y1 n (add i 1)
        (cons (Point (rast_quad_at x0 cx x1 n i) (rast_quad_at y0 cy y1 n i)) acc))))

; A quadratic curve at t = i / n, along one axis.
(def rast_quad_at ((p0 int) (c int) (p1 int) (n int) (i int)) int
  (let t (float_div (float_of i) (float_of n))
    (let u (float_sub 1.0 t)
      (let a (float_mul (float_of p0) (float_mul u u))
        (let b (float_mul (float_of (mul 2 c)) (float_mul t u))
          (float_round (float_add (float_add a b) (float_mul (float_of p1) (float_mul t t)))))))))

; Points i to n of n along a cubic curve, consed onto acc.
(def rast_cubic_onto((x0 int) (y0 int) (ax int) (ay int) (bx int) (by int) (x1 int) (y1 int) (n int) (i int) (acc (list Point))) (list Point)
  (if (gt i n)
      acc
      (rast_cubic_onto x0 y0 ax ay bx by x1 y1 n (add i 1)
        (cons (Point (rast_cubic_at x0 ax bx x1 n i) (rast_cubic_at y0 ay by y1 n i)) acc))))

; A cubic curve at t = i / n, along one axis.
(def rast_cubic_at((p0 int) (a int) (b int) (p1 int) (n int) (i int)) int
  (let t (float_div (float_of i) (float_of n))
    (let u (float_sub 1.0 t)
      (let e0 (float_mul (float_of p0) (float_mul u (float_mul u u)))
        (let e1 (float_mul (float_of (mul 3 a)) (float_mul t (float_mul u u)))
          (let e2 (float_mul (float_of (mul 3 b)) (float_mul (float_mul t t) u))
            (let e3 (float_mul (float_of p1) (float_mul t (float_mul t t)))
              (float_round (float_add (float_add e0 e1) (float_add e2 e3))))))))))

; ----------------------------------------------------------------- circles

; An angle in whole degrees, in radians.
(def rast_rad ((deg int)) float
  (float_div (float_mul (float_of deg) 3.141592653589793) 180.0))

; The point at deg on a circle at cx, cy of radius r, in pixels' 1/256,
; rounded to nearest.
(def rast_on ((cx int) (cy int) (r int) (deg int)) Point
  (let t (rast_rad deg)
    (let fr (float_of r)
      (Point (add cx (float_round (float_mul fr (float_cos t))))
             (add cy (float_round (float_mul fr (float_sin t))))))))

; Points along a circle from angle a down to b, 5 degrees apart and b
; last, whatever b is, consed onto acc: going down the angles, a shape
; winds the way every shape here that fills does.
(def rast_arc_down ((cx int) (cy int) (r int) (a int) (b int) (acc (list Point))) (list Point)
  (if (lt a b)
      acc
      (let acc2 (cons (rast_on cx cy r a) acc)
        (if (eq a b) acc2 (rast_arc_down cx cy r (max (sub a 5) b) b acc2)))))

; The same going up, from a to b: the other way round, for a hole.
(def rast_arc_up ((cx int) (cy int) (r int) (a int) (b int) (acc (list Point))) (list Point)
  (if (gt a b)
      acc
      (let acc2 (cons (rast_on cx cy r a) acc)
        (if (eq a b) acc2 (rast_arc_up cx cy r (min (add a 5) b) b acc2)))))

; A disc at cx, cy of radius r, as a polygon, winding as fills do.
(def rast_disc ((cx int) (cy int) (r int)) (list Point)
  (rev (rast_arc_down cx cy r 355 0 (nil Point))))

; The same disc wound the other way, a hole.
(def rast_disc_back ((cx int) (cy int) (r int)) (list Point)
  (rev (rast_arc_up cx cy r 0 355 (nil Point))))

; ----------------------------------------------------------------- strokes

; How a stroke's open ends are drawn, as SVG's stroke-linecap: cut off
; at the end, a half disc past it, or a half square past it.
(data RastCap (RastButt) (RastRoundCap) (RastSquare))

; Each polyline of ps stroked w wide (in 1/256), its joins round, its
; ends as cap says: a rectangle along each of its lines, and a disc at
; each join, all winding one way. A polyline that ends where it began is
; closed, and joined there too.
(def rast_stroke ((ps (list (list Point))) (w int) (cap RastCap)) (list (list Point))
  (rast_stroke_onto ps (div w 2) cap (nil (list Point))))

; rast_stroke's loop: each polyline's polygons onto acc.
(def rast_stroke_onto((ps (list (list Point))) (hw int) (cap RastCap) (acc (list (list Point)))) (list (list Point))
  (if (is_empty ps)
      acc
      (rast_stroke_onto (tail ps) hw cap (rast_polyline_onto (head ps) hw cap acc))))

; One polyline: a lone point is a dot if its cap is round; otherwise its
; ends squared out if they are, then its bands and its discs.
(def rast_polyline_onto ((pts (list Point)) (hw int) (cap RastCap) (acc (list (list Point)))) (list (list Point))
  (if (is_empty pts)
      acc
      (if (is_empty (tail pts))
          (if (eq cap (RastRoundCap))
              (match (head pts) ((Point x y) (cons (rast_disc x y hw) acc)))
              acc)
          (let closed (eq (head pts) (last pts))
            (let ends (if (if closed false (eq cap (RastSquare))) (rast_squared pts hw) pts)
              (rast_line_onto ends hw (if closed true (eq cap (RastRoundCap))) true acc))))))

; Bands along pts and a disc at each join, and at the ends if round.
(def rast_line_onto ((pts (list Point)) (hw int) (round bool) (first bool) (acc (list (list Point)))) (list (list Point))
  (if (is_empty pts)
      acc
      (match (head pts)
        ((Point x y)
          (let last (is_empty (tail pts))
            (let joined (if (if (if first true last) round true) (cons (rast_disc x y hw) acc) acc)
              (if last
                  joined
                  (rast_line_onto (tail pts) hw round false (rast_band (head pts) (head (tail pts)) hw joined)))))))))

; pts, two or more, with its first and last points moved out by hw
; along their lines.
(def rast_squared ((pts (list Point)) (hw int)) (list Point)
  (let front (rast_past (nth pts 1) (head pts) hw)
    (let r (rev pts)
      (let back (rast_past (head (tail r)) (head r) hw)
        (cons front (tail (rev (cons back (tail r)))))))))

; b moved hw further along the line from a through it.
(def rast_past ((a Point) (b Point) (hw int)) Point
  (match a
    ((Point x0 y0)
      (match b
        ((Point x1 y1)
          (let dx (float_of (sub x1 x0))
            (let dy (float_of (sub y1 y0))
              (let len (float_sqrt (float_add (float_mul dx dx) (float_mul dy dy)))
                (if (float_le len 0.0)
                    b
                    (let k (float_div (float_of hw) len)
                      (Point (add x1 (float_round (float_mul dx k))) (add y1 (float_round (float_mul dy k))))))))))))))

; The rectangle 2 hw wide along a to b.
(def rast_band ((a Point) (b Point) (hw int) (acc (list (list Point)))) (list (list Point))
  (match a
    ((Point x0 y0)
      (match b
        ((Point x1 y1)
          (let dx (float_of (sub x1 x0))
            (let dy (float_of (sub y1 y0))
            (let len (float_sqrt (float_add (float_mul dx dx) (float_mul dy dy)))
            (if (float_le len 0.0)
                acc
                (let k (float_div (float_of hw) len)
                (let nx (float_round (float_mul (float_neg dy) k))
                  (let ny (float_round (float_mul dx k))
                    (cons (cons (Point (add x0 nx) (add y0 ny)) (cons (Point (add x1 nx) (add y1 ny))
                            (cons (Point (sub x1 nx) (sub y1 ny)) (cons (Point (sub x0 nx) (sub y0 ny)) (nil Point)))))
                          acc)))))))))))))

; ------------------------------------------------------------------ edges

; An edge of a polygon, from its upper end to its lower, and +1 if it
; went down, -1 if up: horizontal ones are left out, since no sample
; along a row crosses them.
(data RastEdge (RastEdge int int int int int))

; The edges of every polygon.
(def rast_edges ((ps (list (list Point)))) (list RastEdge)
  (rast_edges_onto ps (nil RastEdge)))

; rast_edges's loop: each polygon's edges onto acc.
(def rast_edges_onto((ps (list (list Point))) (acc (list RastEdge))) (list RastEdge)
  (if (is_empty ps)
      acc
      (rast_edges_onto (tail ps) (rast_ring (head ps) (head (head ps)) acc))))

; A polygon's edges, each point to the next, the last back to first.
(def rast_ring ((pts (list Point)) (first Point) (acc (list RastEdge))) (list RastEdge)
  (if (is_empty pts)
      acc
      (let next (if (is_empty (tail pts)) first (head (tail pts)))
        (rast_ring (tail pts) first (rast_edge (head pts) next acc)))))

; The edge a to b onto acc, from its upper end; none if it is level.
(def rast_edge((a Point) (b Point) (acc (list RastEdge))) (list RastEdge)
  (match a
    ((Point x0 y0)
      (match b
        ((Point x1 y1)
          (if (eq y0 y1)
              acc
              (if (lt y0 y1)
                  (cons (RastEdge x0 y0 x1 y1 1) acc)
                  (cons (RastEdge x1 y1 x0 y0 -1) acc))))))))

; --------------------------------------------------------------- coverage

; How much of each pixel of a w by h grid the polygons cover, by the
; nonzero rule: w · h levels, row after row, each 0 to 15.
(def rast_cover ((ps (list (list Point))) (w int) (h int)) (array int)
  (rast_levels_of (rast_sums ps w h (RastNonzero))))

; Which points a shape's contours hold, as SVG's fill-rule: those they
; wind around at all, or those they wind around an odd number of times.
(data RastRule (RastNonzero) (RastEvenOdd))

; How much of each pixel of a w by h grid the polygons cover, by rule,
; exactly: w · h sums, row after row, each 0 to 4096, all of it.
(def rast_sums ((ps (list (list Point))) (w int) (h int) (rule RastRule)) (array int)
  (rast_rows (rast_edges ps) w h rule 0 (array_new (mul w h) 0)))

; Every sum as a level, 0 to 15.
(def rast_levels_of ((sums (array int))) (array int) (rast_levels_from sums 0))

; rast_levels_of's loop: sum i on made a level, in place.
(def rast_levels_from((a (array int)) (i int)) (array int)
  (if (ge i (array_len a))
      a
      (let v (rast_level (array_get a i))
        (rast_levels_from (array_set a i v) (add i 1)))))

; rast_sums's loop: row y on, each sampled 16 times, into out.
(def rast_rows((es (list RastEdge)) (w int) (h int) (rule RastRule) (y int) (out (array int))) (array int)
  (if (ge y h)
      out
      (let row (rast_samples (rast_in_row es y (nil RastEdge)) w rule (add (mul y (rast_one)) 8) 16 (array_new w 0))
        (rast_rows es w h rule (add y 1) (rast_row_into row (mul y w) 0 w out)))))

; A row's sums into out from at.
(def rast_row_into ((row (array int)) (at int) (x int) (w int) (out (array int))) (array int)
  (if (ge x w)
      out
      (rast_row_into row at (add x 1) w (array_set out (add at x) (array_get row x)))))

; The edges with some part in pixel row y.
(def rast_in_row ((es (list RastEdge)) (y int) (acc (list RastEdge))) (list RastEdge)
  (if (is_empty es)
      acc
      (match (head es)
        ((RastEdge x0 y0 x1 y1 d)
          (rast_in_row (tail es) y
            (if (if (lt y0 (mul (add y 1) (rast_one))) (gt y1 (mul y (rast_one))) false) (cons (head es) acc) acc))))))

; n samples of a row, from ys down 16 at a time, added to row.
(def rast_samples ((es (list RastEdge)) (w int) (rule RastRule) (ys int) (n int) (row (array int))) (array int)
  (if (eq n 0)
      row
      (rast_samples es w rule (add ys 16) (sub n 1)
                    (rast_spans (sort (rast_crossings es ys (nil RastCross))) rule 0 0 w row))))

; Where an edge crosses a sample, and which way it goes.
(data RastCross (RastCross int int))

; Where each edge crosses the sample at height ys, onto acc.
(def rast_crossings((es (list RastEdge)) (ys int) (acc (list RastCross))) (list RastCross)
  (if (is_empty es)
      acc
      (match (head es)
        ((RastEdge x0 y0 x1 y1 d)
          (rast_crossings (tail es) ys
            (if (if (le y0 ys) (lt ys y1) false)
                (cons (RastCross (rast_cross_x x0 y0 x1 y1 ys) d) acc)
                acc))))))

; Where the edge from x0, y0 to x1, y1 is at height ys, to the nearest
; 1/256 pixel.
(def rast_cross_x ((x0 int) (y0 int) (x1 int) (y1 int) (ys int)) int
  (let run (float_of (sub x1 x0))
    (let frac (float_div (float_of (sub ys y0)) (float_of (sub y1 y0)))
      (add x0 (float_round (float_mul run frac))))))

; Along a sample, the crossings in order: where the winding count is
; inside by rule, from the crossing before to this one, is inside.
(def rast_spans ((cs (list RastCross)) (rule RastRule) (wind int) (from int) (w int) (row (array int))) (array int)
  (if (is_empty cs)
      row
      (match (head cs)
        ((RastCross x d)
          (rast_spans (tail cs) rule (add wind d) x w
                      (if (rast_inside rule wind) (rast_add_span row from x w) row))))))

; Whether a winding count is inside, by rule.
(def rast_inside ((rule RastRule) (wind int)) bool
  (match rule
    ((RastNonzero) (not (eq wind 0)))
    ((RastEvenOdd) (eq (bit_and wind 1) 1))))

; xa up to xb, in 1/256 pixel, added to the pixels it covers, as much of
; each as it does.
(def rast_add_span ((row (array int)) (xa int) (xb int) (w int)) (array int)
  (let a (max xa 0)
    (let b (min xb (mul w (rast_one)))
      (if (le b a) row (rast_add_px row a b (div a (rast_one)))))))

; rast_add_span's loop: a to b added to pixel px and those after it.
(def rast_add_px((row (array int)) (a int) (b int) (px int)) (array int)
  (let lo (max a (mul px (rast_one)))
    (let hi (min b (mul (add px 1) (rast_one)))
      (if (le hi lo)
          row
          (rast_add_px (array_set row px (add (array_get row px) (sub hi lo))) a b (add px 1))))))

; A sum, at most 4096, as a level, 0 to 15.
(def rast_level ((sum int)) int (min 15 (div (add (mul sum 15) 2048) 4096)))

; Two coverages of one size put together: each pixel the more covered.
(def rast_union ((a (array int)) (b (array int))) (array int)
  (rast_union_from a b 0))

; rast_union's loop: pixel i on, in place in a.
(def rast_union_from((a (array int)) (b (array int)) (i int)) (array int)
  (if (ge i (array_len a))
      a
      (let v (max (array_get a i) (array_get b i))
        (rast_union_from (array_set a i v) b (add i 1)))))

; -------------------------------------------------------------- packing

; Coverage w wide as words, 16 levels to a word, the leftmost pixel in the
; highest four bits: each row as many words as its 16s, the last padded
; with 0.
(def rast_words_per_row ((w int)) int (div (add w 15) 16))

; Levels w by h packed so.
(def rast_pack((cov (array int)) (w int) (h int)) (array int)
  (let wpr (rast_words_per_row w)
    (rast_pack_at cov w wpr 0 (mul h wpr) (array_new (mul h wpr) 0))))

; rast_pack's loop: words i up to n made, into out.
(def rast_pack_at((cov (array int)) (w int) (wpr int) (i int) (n int) (out (array int))) (array int)
  (if (ge i n)
      out
      (rast_pack_at cov w wpr (add i 1) n
                    (array_set out i (rast_word cov w (div i wpr) (mul 16 (mod i wpr)) 0 0)))))

; The 16 levels from column x0 of row y as a word, k of them done.
(def rast_word ((cov (array int)) (w int) (y int) (x0 int) (k int) (acc int)) int
  (if (eq k 16)
      acc
      (let x (add x0 k)
        (rast_word cov w y x0 (add k 1)
                   (bit_or (bit_shl acc 4) (if (lt x w) (array_get cov (add (mul y w) x)) 0))))))
