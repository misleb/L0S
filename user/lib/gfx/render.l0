; render.l0 -- drawing into a canvas, a buffer of 4-byte pixels, b, g, r,
; then unused, or an array of them: shapes, the 8 by 16 font, PPM images,
; which ppm.l0 reads, and the commands that say what to draw. Shared by
; the compositor, wm, its clients, such as vt, the display drivers, and
; tools/mkicon. Linked into the programs that draw, with ppm.l0 and
; rect.l0, by the Makefile's RENDER, not into every program.

; ------------------------------------------------------------- placement

; Where an image goes on a screen, centered, cut to fit: the part of the
; screen it is copied to, and the image's x and y it starts from.
(data Place (Place Rect int int))

; Where an image iw by ih goes on a screen sw by sh: centered on it, and
; cut to the screen where it is the larger, from its middle.
(def placement ((sw int) (sh int) (iw int) (ih int)) Place
  (Place (Rect (half_gap sw iw) (half_gap sh ih) (min sw iw) (min sh ih)) (half_gap iw sw) (half_gap ih sh)))

; Half of how much bigger a is than b, or 0.
(def half_gap ((a int) (b int)) int (if (gt a b) (div (sub a b) 2) 0))

; ------------------------------------------------------------ background

; What restore puts back, the image splash last drew: its bytes, width,
; height, where its pixels start, and how bright it was drawn, in percent.
; None if it could not be read, and the screen is black then.
(data Background (Background bytes int int int int) (NoBackground))

; A background read, or why it could not be, its path first.
(data BgLoad (BgOk Background) (BgBad (list int)))

; The PPM image at path as a background drawn at percent of its
; brightness, or why it could not be read or is no PPM.
(def load_background ((path (list int)) (percent int)) BgLoad
  (match (read_whole path)
    ((Err why) (BgBad (append path (append ": " why))))
    ((Ok b)
      (match (parse_ppm b)
        ((PpmBad why) (BgBad (append path (append ": " why))))
        ((Ppm iw ih off) (BgOk (Background b iw ih off percent)))))))

; The color c, each channel percent of itself.
(def dim ((c int) (percent int)) int
  (if (ge percent 100)
      c
      (rgb (div (mul (rgb_red c) percent) 100)
           (div (mul (rgb_green c) percent) 100)
           (div (mul (rgb_blue c) percent) 100))))

; The background's pixel at x, y of a screen w by h: the image's, where
; placement puts it, and its corner's color around it, at its brightness.
(def background_at ((bg Background) (w int) (h int) (x int) (y int)) int
  (match bg
    ((NoBackground) 0)
    ((Background b iw ih off percent)
      (match (placement w h iw ih)
        ((Place to sx sy)
          (if (rect_has to x y)
              (dim (pixel_at b off iw (add sx (sub x (rect_x to))) (add sy (sub y (rect_y to)))) percent)
              (dim (pixel_at b off iw 0 0) percent)))))))

; The whole screen as the background has it.
(def paint_background ((f Canvas) (bg Background)) Canvas
  (let w (canvas_w f)
    (let h (canvas_h f)
      (match bg
        ((NoBackground) (canvas_fill f 0 0 (mul w h)))
        ((Background b iw ih off percent)
          (blit (canvas_fill f (dim (pixel_at b off iw 0 0) percent) 0 (mul w h)) b off iw percent (placement w h iw ih) 0))))))

; The background put back over r, as much of it as is on the canvas.
(def restore_rect ((f Canvas) (bg Background) (r Rect)) Canvas
  (let k (rect_clip r (Rect 0 0 (canvas_w f) (canvas_h f)))
    (if (rect_empty k) f (restore_rows f bg (rect_x k) (rect_x1 k) (rect_y k) (rect_y1 k)))))

; The background put back over columns x0 up to x1 of rows y up to y1,
; already cut to the screen.
(def restore_rows ((f Canvas) (bg Background) (x0 int) (x1 int) (y int) (y1 int)) Canvas
  (if (ge y y1)
      f
      (restore_rows (restore_row f bg x0 x1 y) bg x0 x1 (add y 1) y1)))

; restore_rows's one row y: the background's pixels put back from column
; x up to x1, a pixel at a time.
(def restore_row ((f Canvas) (bg Background) (x int) (x1 int) (y int)) Canvas
  (if (ge x x1)
      f
      (let c (background_at bg (canvas_w f) (canvas_h f) x y)
        (restore_row (put f x y c) bg (add x 1) x1 y))))

; ------------------------------------------------------------------ font

; The font: glyphs 8 wide and 16 tall for codes 32 to 126, as
; fonts/l0s-8x16.txt draws them, kept as a row's 8 bits each, the
; leftmost the highest, glyph by glyph. Empty if it could not be read.
(def font_path () (list int) "/etc/font.txt")
(def glyph_w () int 8)
(def glyph_h () int 16)
(def first_glyph () int 32)
(def glyph_count () int 95)

; The font in the file at path, as parse_font reads it; or, having said
; why on standard error, none, an empty array.
(def load_font ((path (list int))) (array int)
  (match (read_whole path)
    ((Err why) (no_font (append path (append ": " why))))
    ((Ok b)
      (match (parse_font (bytes_to_list b))
        ((Err why) (no_font (append path (append ": " why))))
        ((Ok rows) rows)))))

; No font, having said why on standard error.
(def no_font ((why (list int))) (array int)
  (let w (write_err (append why "; no text\n")) (array_new 0 0)))

; A font file refused, for why.
(def font_bad ((why (list int))) (Result (array int) (list int))
  ((Err (array int) (list int)) why))

; A font file's text as font_rows: lines starting with ; are comments, and
; a glyph is "@ CODE" then 16 rows of 8 of # and ., every code from 32
; to 126 once.
(def parse_font ((text (list int))) (Result (array int) (list int))
  (font_lines (lines text) (array_new (mul (glyph_count) (glyph_h)) 0) (array_new (glyph_count) false)))

; parse_font's loop between glyphs: comments and empty lines skipped,
; each "@ CODE" read by font_header, and at the end font_done's check
; that every code was seen. rows holds the glyphs so far, seen which
; codes they are.
(def font_lines ((ls (list (list int))) (rows (array int)) (seen (array bool))) (Result (array int) (list int))
  (if (is_empty ls)
      (font_done rows seen 0)
      (let l (head ls)
        (if (if (is_empty l) true (eq (head l) 59))      ; ;
            (font_lines (tail ls) rows seen)
            (if (not (starts_with l "@ "))
                (font_bad (append "not a glyph's header: " l))
                (font_header (tail ls) rows seen (drop_n l 2)))))))

; A glyph's header, its code's text after the "@ ": refused unless a code
; from 32 to 126 not seen before, which is then marked seen and its 16
; rows read by font_glyph from ls.
(def font_header ((ls (list (list int))) (rows (array int)) (seen (array bool)) (code_text (list int))) (Result (array int) (list int))
  (let code (if (is_number code_text) (int_prefix code_text 0) -1)
    (if (if (lt code (first_glyph)) true (ge code (add (first_glyph) (glyph_count))))
        (font_bad (append "no glyph " code_text))
        (let was (array_get seen (sub code (first_glyph)))
          (if was
              (font_bad (append "glyph " (append (digits code) " twice")))
              (font_glyph ls rows (array_set seen (sub code (first_glyph)) true) code 0))))))

; Rows r on of glyph code, from ls, each kept in rows as row_bits reads
; it; then back to font_lines. Refused if the file ends first or a row is
; not 8 of the characters # and . (a period).
(def font_glyph ((ls (list (list int))) (rows (array int)) (seen (array bool)) (code int) (r int)) (Result (array int) (list int))
  (if (eq r (glyph_h))
      (font_lines ls rows seen)
      (if (is_empty ls)
          (font_bad (append "glyph " (append (digits code) " cut short")))
          (let v (row_bits (head ls) 0 0)
            (if (lt v 0)
                (font_bad (append "glyph " (append (digits code) (append ", row " (append (digits r) " is not 8 of # and .")))))
                (font_glyph (tail ls) (array_set rows (add (mul (sub code (first_glyph)) (glyph_h)) r) v) seen code (add r 1)))))))

; A row's 8 of # and . as bits, the first the highest; or -1.
(def row_bits ((l (list int)) (n int) (acc int)) int
  (if (is_empty l)
      (if (eq n (glyph_w)) acc -1)
      (if (ge n (glyph_w))
          -1
          (if (eq (head l) 35)
              (row_bits (tail l) (add n 1) (bit_or (bit_shl acc 1) 1))
              (if (eq (head l) 46) (row_bits (tail l) (add n 1) (bit_shl acc 1)) -1)))))

; The font's rows, once every glyph from index i on was seen; else the
; first code missing, refused.
(def font_done ((rows (array int)) (seen (array bool)) (i int)) (Result (array int) (list int))
  (if (eq i (glyph_count))
      ((Ok (array int) (list int)) rows)
      (if (array_get seen i)
          (font_done rows seen (add i 1))
          (font_bad (append "no glyph " (digits (add i (first_glyph))))))))

; Row r of glyph code's bits.
(def glyph_row ((font (array int)) (code int) (r int)) int
  (array_get font (add (mul (sub code (first_glyph)) (glyph_h)) r)))

; Draws glyph code with its top left at x, y: its lit pixels only, so what
; is under the others shows through.
(def draw_glyph ((f Canvas) (font (array int)) (x int) (y int) (code int) (c int) (r int)) Canvas
  (if (eq r (glyph_h))
      f
      (draw_glyph (glyph_bits f x (add y r) (glyph_row font code r) c 0) font x y code c (add r 1))))

; One row of a glyph, its bits, at x, y: columns col on of the 8 plotted
; in color c where their bit is set, the highest bit leftmost.
(def glyph_bits ((f Canvas) (x int) (y int) (bits int) (c int) (col int)) Canvas
  (if (eq col (glyph_w))
      f
      (glyph_bits (if (eq (bit_and (bit_shr bits (sub 7 col)) 1) 1) (plot f (add x col) y c) f) x y bits c (add col 1))))

; The code glyph code draws: itself, or ? for one the font lacks.
(def drawable ((code int)) int
  (if (if (lt code (first_glyph)) true (ge code (add (first_glyph) (glyph_count)))) 63 code))

; Characters cs from x, y, one cell each, with each cell first filled
; with bg, unless bg is negative, so what is under shows through.
(def draw_text ((f Canvas) (font (array int)) (x int) (y int) (fg int) (bg int) (cs (list int))) Canvas
  (if (is_empty cs)
      f
      (let b (if (ge bg 0) (fill_rect f x y (glyph_w) (glyph_h) bg) f)
        (draw_text (draw_glyph b font x y (drawable (head cs)) fg 0) font (add x (glyph_w)) y fg bg (tail cs)))))

; ------------------------------------------------------------- requests

; The words of a request cut at each ;, into its commands.
(def split_commands ((words (list (list int)))) (list (list (list int)))
  (split_at_semis words (nil (list int)) (nil (list (list int)))))

; split_commands's loop: cmd the words of the command so far, reversed,
; and acc the commands before it, reversed.
(def split_at_semis ((ws (list (list int))) (cmd (list (list int))) (acc (list (list (list int))))) (list (list (list int)))
  (if (is_empty ws)
      (rev (cons (rev cmd) acc))
      (if (eq (head ws) ";")
          (split_at_semis (tail ws) (nil (list int)) (cons (rev cmd) acc))
          (split_at_semis (tail ws) (cons (head ws) cmd) acc))))


; ------------------------------------------------------------- commands

; One of draw's commands, read from its words by parse_command; what each
; number is, in pixels, is beside it. CmdSize and CmdFont ask the screen's
; size and the font's.
(data Command
  (CmdLine int int int int int)        ; x0, y0, x1, y1, color
  (CmdCircle int int int int)          ; cx, cy, r, color
  (CmdDisc int int int int)            ; cx, cy, r, color
  (CmdRect int int int int int)        ; x, y, w, h, color
  (CmdFill int int int int int)        ; x, y, w, h, color
  (CmdClear int)                       ; color
  (CmdChar int int int int)            ; x, y, code, color
  (CmdText int int int int (list int)) ; x, y, color, background or -1 for none, the characters
  (CmdScroll int int)                  ; rows, the new rows' color
  (CmdRestore int int int int)         ; x, y, w, h
  (CmdSplash int)                      ; brightness, in percent
  (CmdSize)
  (CmdFont))

; A command refused, for why.
(def bad ((why (list int))) (Result Command (list int))
  ((Err Command (list int)) why))

; A command read.
(def good ((cmd Command)) (Result Command (list int))
  ((Ok Command (list int)) cmd))

; The shapes, and how many numbers each takes before its color.
(def shape_ops () (list (list int)) (split_spaces "line circle disc rect fill char"))
(def shape_arity ((op (list int))) int
  (let i (index_of op (shape_ops))
    (if (lt i 0) -1 (nth (cons 4 (cons 3 (cons 3 (cons 4 (cons 4 (cons 3 (nil int))))))) i))))

; One command's words as the command they name, or why not.
(def parse_command ((words (list (list int)))) (Result Command (list int))
  (if (is_empty words)
      (bad "no command")
      (parse_op (head words) (tail words))))

; Command op with the words after it, rest: each op read by its parser,
; size and font taking nothing, and the shapes by parse_shape.
(def parse_op ((op (list int)) (rest (list (list int)))) (Result Command (list int))
  (if (eq op "clear") (parse_clear rest)
  (if (eq op "splash") (parse_splash rest)
  (if (eq op "restore") (parse_restore rest)
  (if (eq op "text") (parse_text rest)
  (if (eq op "scroll") (parse_scroll rest)
  (if (any_eq op (split_spaces "size font"))
      (if (is_empty rest) (good (if (eq op "size") (CmdSize) (CmdFont))) (bad (append op " takes nothing")))
      (if (lt (shape_arity op) 0)
          (bad (append "no command " op))
          (parse_shape op rest (shape_arity op))))))))))

; text X Y COLOR BACKGROUND HEX: the characters whose bytes HEX spells, two
; hex digits each, from X, Y, each cell filled with BACKGROUND first,
; unless it is none.
(def parse_text ((rest (list (list int)))) (Result Command (list int))
  (if (not (eq (length rest) 5))
      (bad "text takes X Y COLOR BACKGROUND HEX")
      (match (parse_ints rest 2 (nil int))
        ((None) (bad (numbers_out_of_range "text")))
        ((Some xy)
          (match (parse_color (nth rest 2))
            ((None) (bad (append "no color " (nth rest 2))))
            ((Some fg)
              (match (if (eq (nth rest 3) "none") (Some -1) (parse_color (nth rest 3)))
                ((None) (bad (append "no color " (nth rest 3))))
                ((Some bg)
                  (match (unhex (nth rest 4) (nil int))
                    ((None) (bad "text's characters must be pairs of hex digits"))
                    ((Some cs) (good (CmdText (nth xy 0) (nth xy 1) fg bg cs))))))))))))

; The bytes s spells, two hex digits each, or none.
(def unhex ((s (list int)) (acc (list int))) (Option (list int))
  (if (is_empty s)
      (Some (rev acc))
      (if (is_empty (tail s))
          ((None (list int)))
          (let hi (hex_val (head s))
            (let lo (hex_val (head (tail s)))
              (if (if (lt hi 0) true (lt lo 0))
                  ((None (list int)))
                  (unhex (tail (tail s)) (cons (bit_or (bit_shl hi 4) lo) acc))))))))

; scroll DY [COLOR]: the screen moved up DY rows, the new rows at the
; bottom COLOR, black unless given.
(def parse_scroll ((rest (list (list int)))) (Result Command (list int))
  (if (if (is_empty rest) true (gt (length rest) 2))
      (bad "scroll takes a number of rows and a color")
      (match (parse_int (head rest))
        ((None) (bad "scroll's rows must be from 0 to 10000"))
        ((Some dy)
          (if (lt dy 0)
              (bad "scroll's rows must be from 0 to 10000")
              (if (is_empty (tail rest))
                  (good (CmdScroll dy 0))
                  (match (parse_color (head (tail rest)))
                    ((None) (bad (append "no color " (head (tail rest)))))
                    ((Some c) (good (CmdScroll dy c))))))))))

; splash [PERCENT]: the image at that brightness, 100 unless given.
(def parse_splash ((rest (list (list int)))) (Result Command (list int))
  (if (is_empty rest)
      (good (CmdSplash 100))
      (if (not (is_empty (tail rest)))
          (bad "splash takes a brightness at most")
          (match (parse_int (head rest))
            ((None) (bad "splash's brightness must be from 0 to 100"))
            ((Some p) (if (if (lt p 0) true (gt p 100))
                          (bad "splash's brightness must be from 0 to 100")
                          (good (CmdSplash p))))))))

; restore X Y W H: four numbers and no color, since it puts back the
; background's own.
(def parse_restore ((rest (list (list int)))) (Result Command (list int))
  (if (not (eq (length rest) 4))
      (bad "restore takes 4 numbers")
      (match (parse_ints rest 4 (nil int))
        ((None) (bad (numbers_out_of_range "restore")))
        ((Some ns) (good (CmdRestore (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3)))))))

; clear [COLOR]: the whole screen COLOR, black unless given.
(def parse_clear ((rest (list (list int)))) (Result Command (list int))
  (if (is_empty rest)
      (good (CmdClear 0))
      (if (is_empty (tail rest))
          (match (parse_color (head rest))
            ((None) (bad (append "no color " (head rest))))
            ((Some c) (good (CmdClear c))))
          (bad "clear takes a color at most"))))

; Shape op's words, rest: its n numbers, then a color, white unless
; given.
(def parse_shape ((op (list int)) (rest (list (list int))) (n int)) (Result Command (list int))
  (let given (length rest)
    (if (if (lt given n) true (gt given (add n 1)))
        (bad (append op (append " takes " (append (digits n) " numbers and a color"))))
        (match (parse_ints rest n (nil int))
          ((None) (bad (numbers_out_of_range op)))
          ((Some nums) (with_color op nums (if (eq given n) "white" (nth rest n))))))))

; Shape op with its numbers, nums, in the color the word cw names.
(def with_color ((op (list int)) (nums (list int)) (cw (list int))) (Result Command (list int))
  (match (parse_color cw)
    ((None) (bad (append "no color " cw)))
    ((Some c) (shape_of op nums c))))

; The command shape op makes of numbers ns and color c: line, rect and
; fill as they are, char by char_of, circle and disc by round_of.
(def shape_of ((op (list int)) (ns (list int)) (c int)) (Result Command (list int))
  (if (eq op "line") (good (CmdLine (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3) c))
  (if (eq op "rect") (good (CmdRect (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3) c))
  (if (eq op "fill") (good (CmdFill (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3) c))
  (if (eq op "char") (char_of ns c)
  (round_of op ns c))))))

; char X Y CODE: refused unless CODE is one the font has, 32 to 126.
(def char_of ((ns (list int)) (c int)) (Result Command (list int))
  (let code (nth ns 2)
    (if (if (lt code (first_glyph)) true (ge code (add (first_glyph) (glyph_count))))
        (bad "char's code must be from 32 to 126")
        (good (CmdChar (nth ns 0) (nth ns 1) code c)))))

; circle or disc CX CY R, as op says: refused if R is negative.
(def round_of ((op (list int)) (ns (list int)) (c int)) (Result Command (list int))
  (if (lt (nth ns 2) 0)
      (bad (append op "'s radius must not be negative"))
      (if (eq op "circle")
          (good (CmdCircle (nth ns 0) (nth ns 1) (nth ns 2) c))
          (good (CmdDisc (nth ns 0) (nth ns 1) (nth ns 2) c)))))

; Numbers are bounded, so that no shape is too big to draw.
(def coord_limit () int 10000)

; Why command op's numbers were refused: they are out of coord_limit.
(def numbers_out_of_range ((op (list int))) (list int)
  (append op (append "'s numbers must be from -" (append (digits (coord_limit)) (append " to " (digits (coord_limit)))))))

; The first n words as numbers, or none if one is not a number in range.
(def parse_ints ((ws (list (list int))) (n int) (acc (list int))) (Option (list int))
  (if (eq n 0)
      (Some (rev acc))
      (match (parse_int (head ws))
        ((None) ((None (list int))))
        ((Some v) (parse_ints (tail ws) (sub n 1) (cons v acc))))))

; A decimal number with an optional -, within coord_limit: a word_number
; of at most 5 digits, so that none is big enough to wrap.
(def parse_int ((w (list int))) (Option int)
  (if (gt (length (if (if (is_empty w) false (eq (head w) 45)) (tail w) w)) 5)
      ((None int))
      (match (word_number w)
        ((None) ((None int)))
        ((Some v) (if (gt (abs_of v) (coord_limit)) ((None int)) (Some v))))))

; A color, by name or as six hex digits RRGGBB, as the frame keeps it.
(def color_names () (list (list int))
  (split_spaces "white black red green blue yellow cyan magenta amber gray"))

; The colors color_names names, 0xRRGGBB, in the same order.
(def color_values () (list int)
  (cons 16777215 (cons 0 (cons 16711680 (cons 65280 (cons 255 (cons 16776960
    (cons 65535 (cons 16711935 (cons 15779920 (cons 8421504 (nil int))))))))))))

; The color word w says, a name of color_names or six hex digits, as
; 0xRRGGBB; or none.
(def parse_color ((w (list int))) (Option int)
  (let i (index_of w (color_names))
    (if (ge i 0)
        (Some (nth (color_values) i))
        (if (eq (length w) 6) (hex_of w 0) ((None int))))))

; The hex digits w as a number, acc the digits before them; none if one
; is not a hex digit.
(def hex_of ((w (list int)) (acc int)) (Option int)
  (if (is_empty w)
      (Some acc)
      (let d (hex_val (head w))
        (if (lt d 0) ((None int)) (hex_of (tail w) (bit_or (bit_shl acc 4) d))))))

; --------------------------------------------------------------- shapes

; A pixel's place, x and y.
(data Point (Point int int))

; v's sign, -1, 0 or 1, and its absolute value.
(def sign ((v int)) int (if (lt v 0) -1 (if (gt v 0) 1 0)))
(def abs_of ((v int)) int (if (lt v 0) (neg v) v))

; The points of a line from x0, y0 to x1, y1, both ends included:
; Bresenham's, in any direction.
(def line_points ((x0 int) (y0 int) (x1 int) (y1 int)) (list Point)
  (let dx (abs_of (sub x1 x0))
    (let dy (neg (abs_of (sub y1 y0)))
      (rev (line_onto x0 y0 x1 y1 dx dy (sign (sub x1 x0)) (sign (sub y1 y0)) (add dx dy) (nil Point))))))

; line_points's steps: x, y and every point after it to x1, y1, onto acc
; reversed. dx and -dy are the line's spans, sx and sy its directions,
; and err Bresenham's error.
(def line_onto ((x int) (y int) (x1 int) (y1 int) (dx int) (dy int) (sx int) (sy int) (err int) (acc (list Point))) (list Point)
  (let a (cons (Point x y) acc)
    (if (if (eq x x1) (eq y y1) false)
        a
        (let e2 (mul 2 err)
          (let ex (if (ge e2 dy) (add err dy) err)
            (let nx (if (ge e2 dy) (add x sx) x)
              (if (le e2 dx)
                  (line_onto nx (add y sy) x1 y1 dx dy sx sy (add ex dx) a)
                  (line_onto nx y x1 y1 dx dy sx sy ex a))))))))

; The points of a circle's outline: the midpoint algorithm, an eighth
; at a time, mirrored.
(def circle_points ((cx int) (cy int) (r int)) (list Point)
  (circle_onto cx cy r 0 (sub 1 r) (nil Point)))

; circle_points's steps: from x, y of the first eighth, d the midpoint's
; decision, each point and its seven mirrors onto acc, until the eighth
; ends where x falls below y.
(def circle_onto ((cx int) (cy int) (x int) (y int) (d int) (acc (list Point))) (list Point)
  (if (lt x y)
      acc
      (let a (octants cx cy x y acc)
        (if (lt d 0)
            (circle_onto cx cy x (add y 1) (add d (add (mul 2 (add y 1)) 1)) a)
            (circle_onto cx cy (sub x 1) (add y 1) (add d (add (mul 2 (sub (add y 1) (sub x 1))) 1)) a)))))

; The eight points of a circle around cx, cy that x, y gives, mirrored
; in each eighth, onto acc.
(def octants ((cx int) (cy int) (x int) (y int) (acc (list Point))) (list Point)
  (cons (Point (add cx x) (add cy y)) (cons (Point (add cx y) (add cy x))
  (cons (Point (sub cx y) (add cy x)) (cons (Point (sub cx x) (add cy y))
  (cons (Point (sub cx x) (sub cy y)) (cons (Point (sub cx y) (sub cy x))
  (cons (Point (add cx y) (sub cy x)) (cons (Point (add cx x) (sub cy y)) acc)))))))))

; The greatest integer whose square is at most n, n not negative.
(def isqrt ((n int)) int
  (if (lt n 2) n (isqrt_from n n)))

; isqrt by Newton's method from the guess x, at or above the answer.
(def isqrt_from ((n int) (x int)) int
  (if (le (mul x x) n) x (isqrt_from n (div (add x (div n x)) 2))))

; n as a float: float_from_int, short enough to keep expressions shallow.
(def float_of ((n int)) float (float_from_int n))

; The absolute value of x.
(def float_abs ((x float)) float (if (float_lt x 0.0) (float_neg x) x))

; The greatest integer at most x: float_to_int truncates toward zero, so a
; negative x that is not whole is one lower.
(def float_floor ((x float)) int
  (let t (float_to_int x)
    (if (float_lt x (float_of t)) (sub t 1) t)))

; x rounded to the nearest integer, halves up: -1.5 is -1, -0.5 is 0.
(def float_round ((x float)) int (float_floor (float_add x 0.5)))

; How many pixels of row dy of a corner of radius r, counted from the
; buffer's edge inward, lie outside the corner's circle, and so are cut:
; 0 once dy reaches r. The display's shaped layers cut these (display.l0's
; shape), and the compositor counts the same, to know which pixels of a
; window are not its own. The circle is centred r pixels in from both
; edges, and a pixel is cut when its centre is outside it. Doubled, so
; that centres fall on integers: column i's centre is 2r - 2i - 1 from
; the circle's, row dy's d = 2r - 2dy - 1, and i is cut while
; (2r - 2i - 1)^2 + d^2 > 4r^2, which is i < (2r - isqrt(4r^2 - d^2)) / 2.
; A 12-pixel corner cuts 9 6 5 4 3 2 1 1 1 0 0 0, the same read down its
; edge as across it, as a circle's quadrant is.
(def corner_cut ((r int) (dy int)) int
  (if (if (lt dy 0) true (ge dy r))
      0
      (let d (sub (sub (mul 2 r) (mul 2 dy)) 1)
        (div (sub (mul 2 r) (isqrt (sub (mul 4 (mul r r)) (mul d d)))) 2))))

; Columns x0 to x1 of a row w wide, cut to the row; or none of it.
(data Span (Span int int) (NoSpan))

; Columns x0 to x1, both included, cut to a row w wide.
(def clip_span ((x0 int) (x1 int) (w int)) Span
  (let lo (max x0 0)
    (let hi (min x1 (sub w 1))
      (if (gt lo hi) (NoSpan) (Span lo hi)))))

; ------------------------------------------------------------ the canvas

; How many pages hold a w by h buffer of 4-byte pixels.
(def buffer_pages ((w int) (h int)) int (pages_for (mul (mul w h) 4)))

; A canvas, as a ring of rows: what holds its pixels, its width and
; height, and the row of it its top row is. Scrolling moves top, not
; pixels; whoever shows the canvas reads its rows from top, in order.
; Over a region, the pixels are a buffer shared with the compositor or the
; display, and drawing writes them there. Over an array, as a host tool or
; a test draws, the canvas is a value like any other. So every drawing
; function returns the canvas drawn on: over a region it is the same one,
; and over an array it is the only one holding what was drawn, so pass it
; on and keep no other.
(data Canvas (Canvas IoDevice int int int) (ArrayCanvas (array int) int int int))

; A canvas over an array, w by h, every pixel color c.
(def canvas_new ((w int) (h int) (c int)) Canvas (ArrayCanvas (array_new (mul w h) c) w h 0))

; Its width, height, and top row.
(def canvas_w ((f Canvas)) int (match f ((Canvas fb w h top) w) ((ArrayCanvas px w h top) w)))
(def canvas_h ((f Canvas)) int (match f ((Canvas fb w h top) h) ((ArrayCanvas px w h top) h)))
(def canvas_top ((f Canvas)) int (match f ((Canvas fb w h top) top) ((ArrayCanvas px w h top) top)))

; Which of the frame's rows the screen's row y is.
(def row_at ((top int) (h int) (y int)) int (mod (add y top) h))

; The index of the screen's pixel 0, y in the frame.
(def row_start ((f Canvas) (y int)) int
  (mul (row_at (canvas_top f) (canvas_h f) y) (canvas_w f)))

; Pixels i up to n of the frame, by index, all color.
(def canvas_fill ((f Canvas) (c int) (i int) (n int)) Canvas
  (match f
    ((Canvas fb w h top) (let k (fill fb c i n) f))
    ((ArrayCanvas px w h top) (ArrayCanvas (fill_cells px c i n) w h top))))

; Cells i up to n of px, all c.
(def fill_cells ((px (array int)) (c int) (i int) (n int)) (array int)
  (if (ge i n) px (fill_cells (array_set px i c) c (add i 1) n)))

; The pixel at x, y, which must be on the canvas, color c.
(def put ((f Canvas) (x int) (y int) (c int)) Canvas
  (let i (add (row_start f y) x)
    (match f
      ((Canvas fb w h top) (let k (device_write32 fb (mul i 4) c) f))
      ((ArrayCanvas px w h top) (ArrayCanvas (array_set px i c) w h top)))))

; The color of the pixel at x, y, which must be on the canvas.
(def canvas_pixel ((f Canvas) (x int) (y int)) int
  (let i (add (row_start f y) x)
    (match f
      ((Canvas fb w h top) (bit_and (device_read32 fb (mul i 4)) 16777215))
      ((ArrayCanvas px w h top) (bit_and (array_get px i) 16777215)))))

; f, its rows read from its row top.
(def canvas_from_top ((f Canvas) (top int)) Canvas
  (match f
    ((Canvas fb w h old) (Canvas fb w h top))
    ((ArrayCanvas px w h old) (ArrayCanvas px w h top))))

; The frame after scrolling dy rows up: the top dy rows gone, and dy rows
; of color new at the bottom.
(def scrolled ((f Canvas) (dy int) (c int)) Canvas
  (let w (canvas_w f)
    (let h (canvas_h f)
      (let top (row_at (canvas_top f) h dy)
        (fill_rows (canvas_from_top f top) 0 (sub w 1) (sub h dy) h c)))))

; ---------------------------------------------------------- drawing shapes

; The pixel at x, y color c, if it is on the canvas; else nothing.
(def plot ((f Canvas) (x int) (y int) (c int)) Canvas
  (if (if (lt x 0) true (if (ge x (canvas_w f)) true (if (lt y 0) true (ge y (canvas_h f)))))
      f
      (put f x y c)))

; Every point of ps plotted color c.
(def plot_all ((f Canvas) (ps (list Point)) (c int)) Canvas
  (if (is_empty ps)
      f
      (match (head ps)
        ((Point x y) (plot_all (plot f x y c) (tail ps) c)))))

; Columns x0 to x1 of row y, those on the screen.
(def span ((f Canvas) (y int) (x0 int) (x1 int) (c int)) Canvas
  (if (if (lt y 0) true (ge y (canvas_h f)))
      f
      (match (clip_span x0 x1 (canvas_w f))
        ((NoSpan) f)
        ((Span lo hi) (let at (row_start f y) (canvas_fill f c (add at lo) (add at (add hi 1))))))))

; Rows dy from -r to r of a filled circle.
(def disc ((f Canvas) (cx int) (cy int) (r int) (c int) (dy int)) Canvas
  (if (gt dy r)
      f
      (let hw (isqrt (sub (mul r r) (mul dy dy)))
        (disc (span f (add cy dy) (sub cx hw) (add cx hw) c) cx cy r c (add dy 1)))))

; The rectangle rw by rh from x, y filled color c, as much of it as is on
; the canvas; nothing if it is empty.
(def fill_rect ((f Canvas) (x int) (y int) (rw int) (rh int) (c int)) Canvas
  (if (if (lt rw 1) true (lt rh 1))
      f
      (let end (min (add y rh) (canvas_h f))
        (fill_rows f x (add x (sub rw 1)) (max y 0) end c))))

; Columns x0 to x1 of rows y up to end, color c, those on the canvas.
(def fill_rows ((f Canvas) (x0 int) (x1 int) (y int) (end int) (c int)) Canvas
  (if (ge y end)
      f
      (fill_rows (span f y x0 x1 c) x0 x1 (add y 1) end c)))

; The edge of the rectangle rw by rh from x, y, one pixel wide, color c,
; inside it; nothing if it is empty.
(def outline ((f Canvas) (x int) (y int) (rw int) (rh int) (c int)) Canvas
  (if (if (lt rw 1) true (lt rh 1))
      f
      (let x1 (add x (sub rw 1))
        (let y1 (add y (sub rh 1))
          (let a (plot_all f (line_points x y x1 y) c)
            (let b (plot_all a (line_points x y1 x1 y1) c)
              (let l (plot_all b (line_points x y x y1) c)
                (plot_all l (line_points x1 y x1 y1) c))))))))

; ---------------------------------------------------------------- drawing

; Pixels i up to n of the region fb, by index, all color: one alone first
; if i is odd, since a 64-bit write must be 8-aligned, then the rest by
; fill_even, two at a time.
(def fill ((fb IoDevice) (color int) (i int) (n int)) int
  (if (ge i n)
      0
      (if (eq (mod i 2) 1)
          (let w (device_write32 fb (mul i 4) color) (fill_even fb color (bit_or color (bit_shl color 32)) (add i 1) n))
          (fill_even fb color (bit_or color (bit_shl color 32)) i n))))

; Pixels i up to n, i even, color, two the 64 bits of a pair of them: eight
; a step while eight are left, then a pair a step, then the last alone if
; there is one. Filling is most of what painting a window costs, so each
; step does as much as it can.
(def fill_even ((fb IoDevice) (color int) (two int) (i int) (n int)) int
  (if (le (add i 8) n)
      (let o (mul i 4)
        (let a (device_write64 fb o two)
          (let b (device_write64 fb (add o 8) two)
            (let c (device_write64 fb (add o 16) two)
              (let e (device_write64 fb (add o 24) two)
                (fill_even fb color two (add i 8) n))))))
      (if (le (add i 2) n)
          (let a (device_write64 fb (mul i 4) two) (fill_even fb color two (add i 2) n))
          (if (lt i n) (device_write32 fb (mul i 4) color) 0))))

; The pixels of r in f moved dy rows up, dy below 0 down: each of r's rows
; that has one dy below it, or above it, made that row's pixels across r,
; so what a scrolled area showed moves with it rather than being painted
; again. The rows nothing moves into, dy of them at one end of r, are
; left as they were, for the caller to paint. Nothing if dy is 0 or as
; many rows as r has.
(def canvas_copy_rows ((f Canvas) (r Rect) (dy int)) Canvas
  (let rc (rect_clip r (Rect 0 0 (canvas_w f) (canvas_h f)))
    (if (if (rect_empty rc) true (if (eq dy 0) true (ge (max dy (sub 0 dy)) (rect_h rc))))
        f
        (if (gt dy 0)
            (copy_rows_up f (rect_x rc) (rect_w rc) (rect_y rc) (sub (rect_y1 rc) dy) dy)
            (copy_rows_down f (rect_x rc) (rect_w rc) (sub (rect_y1 rc) 1) (sub (rect_y rc) dy) dy)))))

; Rows y up to end, top first, each made the row dy below it, w pixels
; from column x: moving rows up, so a row is read before it is written.
(def copy_rows_up ((f Canvas) (x int) (w int) (y int) (end int) (dy int)) Canvas
  (if (ge y end) f (copy_rows_up (copy_row f x w y (add y dy)) x w (add y 1) end dy)))

; Rows y down to stop, bottom first, each made the row dy away, above it
; as dy is below 0: moving rows down, so a row is read before it is
; written.
(def copy_rows_down ((f Canvas) (x int) (w int) (y int) (stop int) (dy int)) Canvas
  (if (lt y stop) f (copy_rows_down (copy_row f x w y (add y dy)) x w (sub y 1) stop dy)))

; Row to's w pixels from column x made row from's.
(def copy_row ((f Canvas) (x int) (w int) (to int) (from int)) Canvas
  (let i (add (row_start f to) x)
    (let j (add (row_start f from) x)
      (match f
        ((Canvas fb cw ch top) (let k (copy_px fb i (add i w) (sub j i)) f))
        ((ArrayCanvas px cw ch top) (ArrayCanvas (copy_cells px i (add i w) (sub j i)) cw ch top))))))

; Pixels i up to n of the region fb, each made the pixel off past it: two
; at a time where both are 8-aligned, as they are together when off is
; even, eight a step while eight are left; else one at a time.
(def copy_px ((fb IoDevice) (i int) (n int) (off int)) int
  (if (ge i n)
      0
      (if (if (eq (mod off 2) 0) (eq (mod i 2) 1) false)
          (let w (device_write32 fb (mul i 4) (device_read32 fb (mul (add i off) 4))) (copy_px fb (add i 1) n off))
          (if (eq (mod off 2) 0)
              (copy_pairs fb i n off)
              (copy_singles fb i n off)))))

; Pixels i up to n, i and i + off even, a pair at a time, four pairs a
; step while they last, then the last alone if there is one.
(def copy_pairs ((fb IoDevice) (i int) (n int) (off int)) int
  (if (le (add i 8) n)
      (let o (mul i 4)
        (let s (mul (add i off) 4)
          (let a (device_write64 fb o (device_read64 fb s))
            (let b (device_write64 fb (add o 8) (device_read64 fb (add s 8)))
              (let c (device_write64 fb (add o 16) (device_read64 fb (add s 16)))
                (let e (device_write64 fb (add o 24) (device_read64 fb (add s 24)))
                  (copy_pairs fb (add i 8) n off)))))))
      (if (le (add i 2) n)
          (let a (device_write64 fb (mul i 4) (device_read64 fb (mul (add i off) 4))) (copy_pairs fb (add i 2) n off))
          (if (lt i n) (device_write32 fb (mul i 4) (device_read32 fb (mul (add i off) 4))) 0))))

; Pixels i up to n a pixel at a time, as when i and i + off cannot both
; be 8-aligned.
(def copy_singles ((fb IoDevice) (i int) (n int) (off int)) int
  (if (ge i n)
      0
      (let w (device_write32 fb (mul i 4) (device_read32 fb (mul (add i off) 4))) (copy_singles fb (add i 1) n off))))

; Cells i up to n of px, each made the cell off past it.
(def copy_cells ((px (array int)) (i int) (n int) (off int)) (array int)
  (if (ge i n) px (copy_cells (array_set px i (array_get px (add i off))) (add i 1) n off)))

; Rows r on of the image's part that place copies, into the frame, at
; percent of their brightness.
(def blit ((f Canvas) (b bytes) (off int) (iw int) (percent int) (p Place) (r int)) Canvas
  (match p
    ((Place to sx sy)
      (if (ge r (rect_h to))
          f
          (blit (blit_row f (rect_x to) (add (rect_y to) r) b off iw percent sx (add sy r) (rect_w to)) b off iw percent p (add r 1))))))

; cw columns of image row sy from column sx, to the frame's row y from
; column x: over a region written straight to it, over an array a pixel
; at a time.
(def blit_row ((f Canvas) (x int) (y int) (b bytes) (off int) (iw int) (percent int) (sx int) (sy int) (cw int)) Canvas
  (match f
    ((Canvas fb w h top) (let k (blit_run fb (mul (add (row_start f y) x) 4) b off iw percent sx sy 0 cw) f))
    ((ArrayCanvas px w h top) (blit_cells f x y b off iw percent sx sy 0 cw))))

; Columns c up to cw of image row y from column sx, to the region from at.
(def blit_run ((fb IoDevice) (at int) (b bytes) (off int) (iw int) (percent int) (sx int) (y int) (c int) (cw int)) int
  (if (ge c cw)
      0
      (let w (device_write32 fb (add at (mul c 4)) (dim (pixel_at b off iw (add sx c) y) percent))
        (blit_run fb at b off iw percent sx y (add c 1) cw))))

; Columns c up to cw of image row sy from column sx, to the canvas's row y
; from column x, a pixel at a time.
(def blit_cells ((f Canvas) (x int) (y int) (b bytes) (off int) (iw int) (percent int) (sx int) (sy int) (c int) (cw int)) Canvas
  (if (ge c cw)
      f
      (let p (dim (pixel_at b off iw (add sx c) sy) percent)
        (blit_cells (put f (add x c) y p) x y b off iw percent sx sy (add c 1) cw))))
