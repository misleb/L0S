(def rect_text ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def test_rect_ends () int
  (add (check_int "past the last column" (rect_x1 (Rect 3 4 5 6)) 8)
       (check_int "past the last row" (rect_y1 (Rect 3 4 5 6)) 10)))

(def test_rect_empty () int
  (add (check_bool "none" (rect_empty (rect_none)) true)
       (add (check_bool "no width" (rect_empty (Rect 3 4 0 6)) true)
            (add (check_bool "less than none" (rect_empty (Rect 3 4 5 -1)) true)
                 (check_bool "a pixel" (rect_empty (Rect 3 4 1 1)) false)))))

(def test_rect_clip () int
  (add (check_str "overlap" (rect_text (rect_clip (Rect 0 0 10 10) (Rect 5 6 10 10))) "5,6 5x4")
       (check_bool "apart" (rect_empty (rect_clip (Rect 0 0 10 10) (Rect 20 0 5 5))) true)))

(def test_rect_clip_screen () int
  (add (check_str "cut" (rect_text (rect_clip (Rect -4 790 12 16) (Rect 0 0 1280 800))) "0,790 8x10")
       (add (check_bool "off the screen" (rect_empty (rect_clip (Rect 1280 0 8 16) (Rect 0 0 1280 800))) true)
            (check_bool "less than nothing" (rect_empty (rect_clip (Rect 5 0 -2 10) (Rect 0 0 1280 800))) true))))

(def test_rect_overlaps () int
  (add (check_bool "sharing a pixel" (rect_overlaps (Rect 0 0 4 4) (Rect 3 3 4 4)) true)
       (check_bool "only touching" (rect_overlaps (Rect 0 0 2 2) (Rect 2 0 2 2)) false)))

(def test_rect_union () int
  (add (check_str "both" (rect_text (rect_union (Rect 0 0 10 10) (Rect 20 5 5 10))) "0,0 25x15")
       (add (check_str "two cells" (rect_text (rect_union (Rect 0 0 8 16) (Rect 8 0 8 16))) "0,0 16x16")
            (add (check_str "an empty one holds nothing" (rect_text (rect_union (rect_none) (Rect 3 4 5 6))) "3,4 5x6")
                 (check_bool "none" (rect_empty (rect_union (rect_none) (rect_none))) true)))))

(def rects_text ((rs (list Rect))) (list int)
  (if (is_empty rs) "" (append (rect_text (head rs)) (append " " (rects_text (tail rs))))))

; 0,0 10x10 less 3,4 2x2 in its middle: the 4 rows above, the 4 below,
; and 3 left and 5 right of it between them.
(def test_rect_minus () int
  (add (check_str "a hole" (rects_text (rect_minus (Rect 0 0 10 10) (Rect 3 4 2 2))) "0,0 10x4 0,6 10x4 0,4 3x2 5,4 5x2 ")
       (add (check_str "apart" (rects_text (rect_minus (Rect 0 0 4 4) (Rect 10 10 2 2))) "0,0 4x4 ")
            (add (check_str "all of it" (rects_text (rect_minus (Rect 2 2 4 4) (Rect 0 0 10 10))) "")
                 (check_str "a strip off the right" (rects_text (rect_minus (Rect 0 0 740 400) (Rect 0 0 640 400))) "640,0 100x400 ")))))

; A window ground grown 100 right and 60 down, less the old one: the new
; strip below, then the new strip at the right above it.
(def test_rects_minus () int
  (add (check_str "grown" (rects_text (rects_minus (cons (Rect 0 0 740 460) (nil Rect)) (cons (Rect 0 0 640 400) (nil Rect))))
                  "0,400 740x60 640,0 100x400 ")
       (check_str "less two" (rects_text (rects_minus (cons (Rect 0 0 10 2) (nil Rect)) (cons (Rect 0 0 3 2) (cons (Rect 7 0 3 2) (nil Rect))))) "3,0 4x2 ")))

(def test_rect_union_all () int
  (add (check_str "every one" (rect_text (rect_union_all (cons (Rect 0 0 2 2) (cons (Rect 10 4 2 2) (nil Rect))))) "0,0 12x6")
       (check_bool "none" (rect_empty (rect_union_all (nil Rect))) true)))

(def test_rect_merge () int
  (add (check_str "overlapping, one" (rects_text (rect_merge (cons (Rect 0 0 10 10) (cons (Rect 5 5 10 10) (nil Rect))))) "0,0 15x15 ")
       (check_str "apart, two, in order" (rects_text (rect_merge (cons (Rect 0 0 10 10) (cons (Rect 50 5 10 10) (nil Rect))))) "0,0 10x10 50,5 10x10 ")))

; 0,0 4x4 and 2,2 4x4 overlap, as one 0,0 6x6; 10,10 2x2 is apart and
; keeps its place before it; the empty one is dropped.
(def test_rect_merge_two_of_three () int
  (check_str "the two that overlap as one, the third apart"
    (rects_text (rect_merge (cons (Rect 0 0 4 4) (cons (Rect 10 10 2 2) (cons (Rect 2 2 4 4) (cons (rect_none) (nil Rect)))))))
    "10,10 2x2 0,0 6x6 "))

; 1,0 4x2 joins 0,0 2x2, and their union then overlaps 4,0 2x2, which a
; single pass would leave beside it.
(def test_rect_merge_chain () int
  (check_str "a box joining two others makes one of all three"
    (rects_text (rect_merge (cons (Rect 0 0 2 2) (cons (Rect 4 0 2 2) (cons (Rect 1 0 4 2) (nil Rect))))))
    "0,0 6x2 "))

(def test_rect_merge_touching () int
  (check_str "boxes that only touch stay apart"
    (rects_text (rect_merge (cons (Rect 0 0 2 2) (cons (Rect 2 0 2 2) (nil Rect)))))
    "0,0 2x2 2,0 2x2 "))

(def test_rect_merge_empty () int
  (check_int "empty ones dropped" (length (rect_merge (cons (rect_none) (cons (Rect 5 5 0 3) (nil Rect))))) 0))

; However they fall, no two merged overlap, and every pixel of the input
; is in one of them: checked over 300 seeded sets of four.
(def test_rect_merge_random () int
  (check_int "sets that went wrong" (merge_bad (rand_next 7) 300 0) 0))

; n more sets of four from state s, and how many went wrong.
(def merge_bad ((s int) (n int) (bad int)) int
  (if (eq n 0)
      bad
      (match (random_rects s 4 (nil Rect))
        ((Drawn rs s2)
          (let m (rect_merge rs)
            (merge_bad s2 (sub n 1) (if (if (none_overlap m) (all_covered rs m) false) bad (add bad 1))))))))

; Rectangles drawn at random, and the state after them.
(data Drawn (Drawn (list Rect) int))

; n rectangles from state s, each from 0 to 19 across and down, at most
; 8 by 8, some of them empty.
(def random_rects ((s int) (n int) (acc (list Rect))) Drawn
  (if (eq n 0)
      (Drawn acc s)
      (let s1 (rand_next s)
        (let s2 (rand_next s1)
          (let s3 (rand_next s2)
            (random_rects (rand_next s3) (sub n 1)
              (cons (Rect (rand_below s 20) (rand_below s1 20) (rand_below s2 9) (rand_below s3 9)) acc)))))))

(def none_overlap ((rs (list Rect))) bool
  (if (is_empty rs) true (if (overlaps_any (head rs) (tail rs)) false (none_overlap (tail rs)))))

(def overlaps_any ((r Rect) (rs (list Rect))) bool
  (if (is_empty rs) false (if (rect_overlaps r (head rs)) true (overlaps_any r (tail rs)))))

; Every rectangle of rs that is not empty wholly inside one of ms, as it
; is when it was merged into a union and unions are never cut.
(def all_covered ((rs (list Rect)) (ms (list Rect))) bool
  (if (is_empty rs)
      true
      (if (if (rect_empty (head rs)) true (inside_one (head rs) ms)) (all_covered (tail rs) ms) false)))

(def inside_one ((r Rect) (ms (list Rect))) bool
  (if (is_empty ms) false (if (eq (rect_clip r (head ms)) r) true (inside_one r (tail ms)))))

(def test_rect_has () int
  (add (check_bool "inside" (rect_has (Rect 10 10 5 5) 14 10) true)
       (add (check_bool "past the right" (rect_has (Rect 10 10 5 5) 15 10) false)
            (check_bool "above" (rect_has (Rect 10 10 5 5) 12 9) false))))

(def test_rect_inset () int
  (add (check_str "by 2" (rect_text (rect_inset (Rect 0 0 10 8) 2)) "2,2 6x4")
       (check_str "not below nothing" (rect_text (rect_inset (Rect 0 0 2 2) 3)) "3,3 0x0")))

(def test_rect_nums_onto () int
  (check_strs "after the id, reversed"
    (numbers_words (rev (rect_nums_onto 9 (Rect 1 2 3 4) (rect_nums_onto 8 (Rect 5 6 7 8) (nil int)))))
    (split_spaces "8 5 6 7 8 9 1 2 3 4")))

(def test_rects_nums_onto () int
  (check_strs "each after the id, in order"
    (numbers_words (rev (rects_nums_onto 3 (cons (Rect 1 2 3 4) (cons (Rect 5 6 7 8) (nil Rect))) (nil int))))
    (split_spaces "3 1 2 3 4 3 5 6 7 8")))

(def test_rect_moved () int
  (add (check_true "right and down" (eq (rect_moved (Rect 1 2 3 4) 10 20) (Rect 11 22 3 4)))
       (check_true "back" (eq (rect_moved (Rect 1 2 3 4) -1 -2) (Rect 0 0 3 4)))))

(def test_rect_scaled () int
  (add (check_true "at 2" (eq (rect_scaled (Rect 1 2 3 4) 2) (Rect 2 4 6 8)))
       (check_true "at 1, itself" (eq (rect_scaled (Rect 1 2 3 4) 1) (Rect 1 2 3 4)))))

(def test_rects_scaled () int
  (check_true "each" (eq (rects_scaled (cons (Rect 0 0 1 1) (cons (Rect 5 5 2 2) (nil Rect))) 2)
                         (cons (Rect 0 0 2 2) (cons (Rect 10 10 4 4) (nil Rect))))))
