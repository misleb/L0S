; rect.l0 -- rectangles: the one type for an area of a screen, a buffer
; or a window, as x, y, width and height, which is how the display's and
; the compositor's protocols send them, and what is done with them. A
; rectangle no wider or no taller than 0 is empty, and holds nothing.
; Linked with render.l0 by the Makefile's RENDER, and as RECT where only
; a protocol needs it.

; x, y, width, height.
(data Rect (Rect int int int int))

; Its x, y, width and height.
(def rect_x ((r Rect)) int (match r ((Rect x y w h) x)))
(def rect_y ((r Rect)) int (match r ((Rect x y w h) y)))
(def rect_w ((r Rect)) int (match r ((Rect x y w h) w)))
(def rect_h ((r Rect)) int (match r ((Rect x y w h) h)))

; The column, and the row, just past r's last.
(def rect_x1 ((r Rect)) int (match r ((Rect x y w h) (add x w))))
(def rect_y1 ((r Rect)) int (match r ((Rect x y w h) (add y h))))

; Nowhere: the empty rectangle a union starts from.
(def rect_none () Rect (Rect 0 0 0 0))

; Whether r holds nothing.
(def rect_empty ((r Rect)) bool (if (le (rect_w r) 0) true (le (rect_h r) 0)))

; Where a and b overlap: empty, 0 by 0, if they do not. A rectangle cut
; to a screen w by h is its clip with (Rect 0 0 w h).
(def rect_clip ((a Rect) (b Rect)) Rect
  (let x0 (max (rect_x a) (rect_x b))
    (let y0 (max (rect_y a) (rect_y b))
      (let x1 (min (rect_x1 a) (rect_x1 b))
        (let y1 (min (rect_y1 a) (rect_y1 b))
          (if (if (le x1 x0) true (le y1 y0)) (Rect x0 y0 0 0) (Rect x0 y0 (sub x1 x0) (sub y1 y0))))))))

; Whether a and b share a pixel; touching is not overlapping.
(def rect_overlaps ((a Rect) (b Rect)) bool (not (rect_empty (rect_clip a b))))

; The least rectangle holding both; an empty one holds nothing.
(def rect_union ((a Rect) (b Rect)) Rect
  (if (rect_empty a)
      b
      (if (rect_empty b)
          a
          (let x0 (min (rect_x a) (rect_x b))
            (let y0 (min (rect_y a) (rect_y b))
              (Rect x0 y0 (sub (max (rect_x1 a) (rect_x1 b)) x0) (sub (max (rect_y1 a) (rect_y1 b)) y0)))))))

; The least rectangle holding every one of rs; none for none.
(def rect_union_all ((rs (list Rect))) Rect (rect_union_onto rs (rect_none)))

(def rect_union_onto ((rs (list Rect)) (acc Rect)) Rect
  (if (is_empty rs) acc (rect_union_onto (tail rs) (rect_union acc (head rs)))))

; r at scale s: each of its pixels s by s, so the same place on a screen
; of s times the desktop's pixels each way; and each of rs so.
(def rect_scaled ((r Rect) (s int)) Rect
  (if (eq s 1) r (match r ((Rect x y w h) (Rect (mul x s) (mul y s) (mul w s) (mul h s))))))

(def rects_scaled ((rs (list Rect)) (s int)) (list Rect)
  (if (if (eq s 1) true (is_empty rs)) rs (cons (rect_scaled (head rs) s) (rects_scaled (tail rs) s))))

; rs with every two that overlap made one, the least rectangle holding
; both, until no two do, and the empty ones dropped: what a damage of
; them all has to show, in as few rectangles as that takes. Those that
; overlap nothing keep their order.
(def rect_merge ((rs (list Rect))) (list Rect) (rect_merge_onto rs (nil Rect)))

; acc, reversed, holds those so far, no two overlapping. A rectangle that
; overlaps one of them takes it out, and their union goes back to the
; front of rs, since it may now overlap another.
(def rect_merge_onto ((rs (list Rect)) (acc (list Rect))) (list Rect)
  (if (is_empty rs)
      (rev acc)
      (if (rect_empty (head rs))
          (rect_merge_onto (tail rs) acc)
          (let o (rect_first_overlap acc (head rs))
            (if (rect_empty o)
                (rect_merge_onto (tail rs) (cons (head rs) acc))
                (rect_merge_onto (cons (rect_union (head rs) o) (tail rs)) (rect_without acc o)))))))

; The first of rs that overlaps r, or none.
(def rect_first_overlap ((rs (list Rect)) (r Rect)) Rect
  (if (is_empty rs)
      (rect_none)
      (if (rect_overlaps (head rs) r) (head rs) (rect_first_overlap (tail rs) r))))

; rs without the first that is r.
(def rect_without ((rs (list Rect)) (r Rect)) (list Rect)
  (if (is_empty rs) rs (if (eq (head rs) r) (tail rs) (cons (head rs) (rect_without (tail rs) r)))))

; Whether the pixel at x, y is in r.
(def rect_has ((r Rect) (x int) (y int)) bool
  (if (if (ge x (rect_x r)) (lt x (rect_x1 r)) false)
      (if (ge y (rect_y r)) (lt y (rect_y1 r)) false)
      false))

; r shrunk by d on every side.
(def rect_inset ((r Rect) (d int)) Rect
  (match r ((Rect x y w h) (Rect (add x d) (add y d) (max 0 (sub w (mul 2 d))) (max 0 (sub h (mul 2 d)))))))

; id and r's x, y, width and height onto acc, reversed: how a damage
; request names a rectangle of a buffer or a window.
(def rect_nums_onto ((id int) (r Rect) (acc (list int))) (list int)
  (match r ((Rect x y w h) (cons h (cons w (cons y (cons x (cons id acc))))))))

; Each of rs, after id, onto acc, reversed, as rect_nums_onto does one.
(def rects_nums_onto ((id int) (rs (list Rect)) (acc (list int))) (list int)
  (if (is_empty rs) acc (rects_nums_onto id (tail rs) (rect_nums_onto id (head rs) acc))))
