(def test_answer () int
  (match (answer_for (Message 3 (request 9 "ping 1")))
    ((Answer port body) (add (check_int "port" port 9) (check_str "body" body "ping 1")))
    ((NoAnswer) (fail_because "answer" "none"))))

(def test_no_answer () int
  (add (match (answer_for (Message 3 "ab")) ((Answer p b) (fail_because "short" "answered")) ((NoAnswer) (pass "short")))
       (match (answer_for (RecvFailed)) ((Answer p b) (fail_because "failed" "answered")) ((NoAnswer) (pass "failed")))))
