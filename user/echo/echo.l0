; echo.l0 -- a server: registers its port as "echo", and sends the body
; of every request it receives back to the request's reply port.

; What to do with a message: send body to port, or nothing.
(data Answer (Answer int (list int)) (NoAnswer))

(def answer_for ((m Message)) Answer
  (match m
    ((Message from payload)
      (let reply (request_reply payload)
        (if (lt reply 0) (NoAnswer) (Answer reply (request_body payload)))))
    ((RecvFailed) (NoAnswer))))

(def serve ((port int)) int
  (let m (port_receive port)
    (match m
      ((RecvFailed) 1)
      ((Message from payload)
        (let s (match (answer_for m)
                 ((Answer reply body) (port_send reply body))
                 ((NoAnswer) (Sent)))
          (serve port))))))

(def echo () int
  (let port (port_new)
    (if (lt port 0)
        (let w (write_err "echo: no port\n") 1)
        (match (name_register port "echo")
          ((Registered) (serve port))
          ((RegisterTaken) (let w (write_err "echo: echo is registered already\n") 2))
          ((RegisterNoPort) (let w (write_err "echo: cannot register\n") 2))
          ((RegisterTooLong) (let w (write_err "echo: cannot register\n") 2))))))
