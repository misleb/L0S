(def test_pong_line () int
  (add (check_str "reply" (pong_line (Message 2 "ping 1")) "ping: echo (pid 2) said ping 1\n")
       (check_str "none" (pong_line (RecvFailed)) "ping: no reply\n")))

(def test_is_pong () int
  (add (check_bool "match" (is_pong (Message 2 "ping 4") 4) true)
       (check_bool "other" (is_pong (Message 2 "ping 4") 5) false)))

(def test_count () int
  (add (check_int "default" (count_of (nil (list int))) 3)
       (check_int "given" (count_of (split_spaces "12")) 12)))
