; ping.l0 -- a client of echo: finds it by name, sends it n requests, the
; number given as its argument or 3, and checks that each comes back.

(def ping_body ((i int)) (list int)
  (append "ping " (digits i)))

(def pong_line ((m Message)) (list int)
  (match m
    ((Message from payload) (append "ping: echo (pid " (append (digits from) (append ") said " (append payload "\n")))))
    ((RecvFailed) "ping: no reply\n")))

(def is_pong ((m Message) (i int)) bool
  (match m
    ((Message from payload) (eq payload (ping_body i)))
    ((RecvFailed) false)))

(def count_of ((argv (list (list int)))) int
  (if (is_empty argv) 3 (int_prefix (head argv) 0)))

; Sends request i of n through echo, and returns how many failed.
(def pings ((echo int) (reply int) (i int) (n int) (bad int)) int
  (if (gt i n)
      bad
      (match (port_send echo (request reply (ping_body i)))
        ((Sent)
          (let m (port_receive reply)
            (let w (write_str (pong_line m))
              (pings echo reply (add i 1) n (if (is_pong m i) bad (add bad 1))))))
        ((SendNoPort) (unsent echo reply i n bad (SendNoPort)))
        ((SendFull) (unsent echo reply i n bad (SendFull)))
        ((SendTooBig) (unsent echo reply i n bad (SendTooBig))))))

; Request i lost before it reached echo, as s says, and the rest sent.
(def unsent ((echo int) (reply int) (i int) (n int) (bad int) (s Sending)) int
  (let w (write_str (append "ping: not sent: " (append (sending_why s) "\n")))
    (pings echo reply (add i 1) n (add bad 1))))

(def ping () int
  (match (name_await "echo" 1000)
    ((NotFound) (let w (write_err "ping: no echo\n") 2))
    ((Found echo)
      (let reply (port_new)
        (let bad (pings echo reply 1 (count_of (args)) 0)
          (let w (write_line (if (eq bad 0) "ping: all answered" "ping: some lost"))
            (if (eq bad 0) 0 1)))))))
