(def term_text ((t Term)) (list int)
  (match t ((Term col row cols rows) (append (digits col) (append "," (digits row))))))

(def op_text ((op Op)) (list int)
  (match op
    ((OpText col row cs) (append "text " (append (digits col) (append "," (append (digits row) (append " " cs))))))
    ((OpBlank col row) (append "blank " (append (digits col) (append "," (digits row)))))
    ((OpScroll) "scroll")
    ((OpCursor col row on) (append (if on "cursor " "uncursor ") (append (digits col) (append "," (digits row)))))))

(def ops_text ((ops (list Op))) (list int)
  (if (is_empty ops) "" (if (is_empty (tail ops)) (op_text (head ops)) (append (op_text (head ops)) (append " ; " (ops_text (tail ops)))))))

(def rendered_text ((r Rendered)) (list int)
  (match r ((Rendered t ops) (append (term_text t) (append ": " (ops_text ops))))))

(def screen () Term (Term 0 0 80 24))

(def test_plain_run () int
  (check_str "one run" (rendered_text (render (screen) "hi")) "2,0: text 0,0 hi"))

(def test_newline () int
  (check_str "two rows" (rendered_text (render (screen) "a\nb")) "1,1: text 0,0 a ; text 0,1 b"))

(def test_scroll_at_the_bottom () int
  (check_str "a line up" (rendered_text (render (Term 3 23 80 24) "x\ny")) "1,23: text 3,23 x ; scroll ; text 0,23 y"))

(def test_wrap () int
  (check_str "past the last column" (rendered_text (render (Term 79 0 80 24) "ab")) "1,1: text 79,0 a ; text 0,1 b"))

(def test_backspace () int
  (check_str "back and blanked" (rendered_text (render (Term 5 2 80 24) "\x08 \x08"))
    "4,2: blank 4,2 ; text 4,2   ; blank 4,2"))

(def test_backspace_at_start () int
  (check_str "nowhere" (rendered_text (render (Term 0 2 80 24) "\x08")) "0,2: "))

(def test_tab () int
  (check_str "to column 8" (term_text (match (render (Term 3 0 80 24) "\t") ((Rendered t ops) t))) "8,0"))

(def test_carriage_return () int
  (check_str "column 0" (rendered_text (render (Term 7 1 80 24) "\rz")) "1,1: text 0,1 z"))

(def test_control_bytes_skipped () int
  (check_str "bell" (rendered_text (render (screen) "a\x07b")) "2,0: text 0,0 a ; text 1,0 b"))

(def test_cursor () int
  (check_str "erased, then drawn after"
    (match (shown_bytes (screen) "a") ((Rendered t ops) (ops_text ops)))
    "uncursor 0,0 ; text 0,0 a ; cursor 1,0"))

(def test_cursor_at_a_pending_wrap () int
  (check_str "in the last column"
    (match (shown_bytes (Term 79 0 80 24) "z") ((Rendered t ops) (ops_text ops)))
    "uncursor 79,0 ; text 79,0 z ; cursor 79,0"))

(def test_names () int
  (add (check_str "vt unless given" (vt_name (nil (list int))) "vt")
       (check_str "given" (vt_name (split_spaces "vt2")) "vt2")))

(def test_cells () int
  (add (check_str "80 by 24" (match (vt_cells (split_spaces "vt1")) ((Term c r cols rows) (append (digits cols) (append "x" (digits rows))))) "80x24")
       (check_str "given" (match (vt_cells (split_spaces "vt1 100 30")) ((Term c r cols rows) (append (digits cols) (append "x" (digits rows))))) "100x30")))

(def test_cannot_shell () int
  (add (check_str "none" (cannot_shell -1) "no /bin/sh to run")
       (check_str "refused" (cannot_shell -5) "cannot start /bin/sh: -5")))

; Under an operating system there is no font, so no terminal.
(def test_no_font () int
  (check_int "fails" (vt) 1))
