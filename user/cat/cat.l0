; cat.l0 -- writes each file its arguments name to standard output, in
; order, read from the initramfs through the ordinary open_in. A file it
; cannot read is reported on standard error, and the rest are still
; written; it exits 1 if any was, and 0 otherwise.

(def cat_error ((path (list int)) (why (list int))) (list int)
  (append "cat: " (append path (append ": " (append why "\n")))))

; Writes the file at path to out: 0, or 1 if it could not be read.
(def cat_file ((path (list int)) (out IoFile)) int
  (match (open_in path)
    ((IoFailed fault why) (let w (write_err (cat_error path why)) 1))
    ((IoOpened f)
      (match (file_read_all f)
        ((IoReadFailed code) (let c (file_close f) (let w (write_err (cat_error path (io_error code))) 1)))
        ((IoBytes b)
          (let w (file_write_bytes out b 0 (bytes_len b))
            (let c (file_close f)
              0)))))))

; Writes every file of paths to out, and returns how many could not be.
(def cat_all ((paths (list (list int))) (out IoFile) (bad int)) int
  (if (is_empty paths)
      bad
      (cat_all (tail paths) out (add bad (cat_file (head paths) out)))))

(def cat () int
  (let bad (cat_all (args) (IoFile 1) 0)
    (let f (file_flush (IoFile 1))
      (if (eq bad 0) 0 1))))
