; spin.l0 -- runs for ever and never makes a call, so the only way any
; other process runs beside it is the kernel's timer taking the processor
; back from it.

; Counts from i up to n, which for spin is never reached.
(def spin_to ((i int) (n int)) int
  (if (eq i n) i (spin_to (add i 1) n)))

(def spin () int
  (spin_to 0 -1))
