(def none () UiEvent (UiOther 0 ""))

; The app after action.
(def upd ((t Todo) (action (list int))) Todo (todo_update t action (none)))

; The app with s typed into its entry, a key at a time.
(def typed ((t Todo) (s (list int))) Todo
  (if (is_empty s)
      t
      (typed (todo_update t "new.edit" (UiKey (KeyEvent 0 1 (head s) 0))) (tail s))))

; t with s typed and added.
(def added ((t Todo) (s (list int))) Todo (upd (typed t s) "app.add"))

; Three tasks, the second done.
(def three () Todo
  (upd (added (added (added (todo_new) "Milk") "Bread") "Eggs") "task.2.toggle"))

; Each task as KEY:TEXT, a * after it if done, space between.
(def tasks_of ((t Todo)) (list int) (unwords (task_words (.tasks t))))
(def task_words ((ts (list Task))) (list (list int))
  (if (is_empty ts)
      (nil (list int))
      (cons (append (digits (.key (head ts))) (append ":" (append (.text (head ts)) (if (.done (head ts)) "*" ""))))
            (task_words (tail ts)))))

; The window laid out.
(def laid ((t Todo)) (list UiNode) (ui_laid (todo_view t) 480 520))

; What is typed is added as a task, its spaces tidied, and the entry
; emptied; Enter in the entry adds too.
(def test_added () int
  (let t (upd (typed (todo_new) "  Buy   milk ") "app.add")
    (add (check_str "the task" (tasks_of t) "1:Buy milk")
         (add (check_str "the entry emptied" (.text (.entry t)) "")
              (check_str "Enter" (tasks_of (upd (typed t "Bread") "new.activate")) "1:Buy milk 2:Bread")))))

; Nothing typed, or only spaces, adds nothing, and Add is insensitive.
(def test_nothing_added () int
  (add (check_str "spaces" (tasks_of (upd (typed (todo_new) "   ") "app.add")) "")
       (check_bool "no Add" (ui_has_target (laid (todo_new)) "app.add") false)))

; A click on a task, or on its check box, marks it done, and again not.
(def test_toggled () int
  (let t (upd (upd (typed (todo_new) "a") "app.add") "items.select.1")
    (add (check_str "by the row" (tasks_of t) "1:a*")
         (check_str "by the check" (tasks_of (upd t "task.1.toggle")) "1:a"))))

; Its delete button deletes it alone.
(def test_deleted () int
  (let t (upd (typed (upd (typed (todo_new) "a") "app.add") "b") "app.add")
    (check_str "the first gone" (tasks_of (upd t "app.delete.1")) "2:b")))

; Clear Completed asks first; Cancel keeps them, Clear deletes the done.
(def test_cleared () int
  (let t (upd (three) "app.clear")
    (add (check_bool "asking" (.asking t) true)
         (add (check_str "cancelled" (tasks_of (upd t "dialog.cancel")) (tasks_of (three)))
              (check_str "cleared" (tasks_of (upd t "dialog.clear")) "1:Milk 3:Eggs")))))

; With nothing done, Clear Completed is insensitive, and asks nothing.
(def test_nothing_to_clear () int
  (let t (upd (typed (todo_new) "a") "app.add")
    (add (check_bool "insensitive" (ui_has_target (laid t) "app.clear") false)
         (check_bool "no dialog" (.asking (upd t "app.clear")) false))))

; The foot says how many are left.
(def test_footer () int
  (add (check_str "none" (todo_footer (todo_new)) "No tasks")
       (add (check_str "two of three" (todo_footer (three)) "2 tasks left")
            (check_str "all done" (todo_footer (upd (upd (three) "task.1.toggle") "task.3.toggle")) "All done"))))

; Empty, a page says what to do; with tasks, each row's text, Done under
; the done one, and its check box and delete button targets.
(def test_view () int
  (let ns (laid (three))
    (add (check_bool "empty" (ui_has_text (laid (todo_new)) "Nothing to Do") true)
         (add (check_bool "the done one" (contains (ui_texts ns) "Bread|Done|") true)
              (add (check_bool "its check" (ui_has_target ns "task.2.toggle") true)
                   (check_bool "its delete" (ui_has_target ns "app.delete.2") true))))))

; Asking, the dialog says how many it will delete, and nothing beneath
; it is a target.
(def test_view_asking () int
  (let ns (laid (upd (three) "app.clear"))
    (add (check_bool "what it says" (ui_has_text ns "1 done task will be deleted.") true)
         (check_bool "nothing beneath" (ui_has_target ns "app.add") false))))

; Where tests/todo.sh finds things, a task added: the entry, 6 in and
; down, 16 characters wide; the first task's row, 12 in under the
; toolbar, and its check box 12 in from the row's start; Clear
; Completed at the toolbar's end once a task is done; and the dialog's
; Clear.
(def test_placed () int
  (let (one (added (todo_new) "Milk")
        done (upd one "task.1.toggle")
        ns (laid one))
    (add (check_str "the entry" (ui_target_at ns "new.entry") "6 6 200 34")
         (add (check_str "the row" (ui_target_at ns "items.select.1") "12 59 456 50")
              (add (check_str "its check box" (ui_target_at ns "task.1.toggle") "24 76 16 16")
                   (add (check_str "Clear Completed" (ui_target_at (laid done) "app.clear") "361 6 113 34")
                        (check_str "the dialog's Clear" (ui_target_at (laid (upd done "app.clear")) "dialog.clear") "288 280 49 34")))))))

; The entry is focused as the window opens.
(def test_focus_asked () int
  (check_str "the entry's name" (append (todo_entry) ".entry") "new.entry"))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (todo) 1))
