; preview.l0 -- To Do's scenes for make preview APP=todo: as it opens,
; with three tasks and one done, and asking before it clears.
(def main () int
  (ui_preview (cons (UiShot "empty" 480 520 (todo_view (todo_new)))
                    (cons (UiShot "tasks" 480 520 (todo_view (sample)))
                          (cons (UiShot "clearing" 480 520 (todo_view (todo_update (sample) "app.clear" (UiOther 0 ""))))
                                (nil UiShot))))))

; Three tasks, the second done, and a fourth being typed.
(def sample () Todo
  (let t (add_task (add_task (add_task (todo_new) "Buy milk") "Water the plants") "Call the plumber")
    (.entry (todo_update t "task.2.toggle" (UiOther 0 "")) (UiEntryText "Pay rent" 8))))

; t with text added as a task.
(def add_task ((t Todo) (text (list int))) Todo
  (todo_update (.entry t (UiEntryText text (length text))) "app.add" (UiOther 0 "")))
