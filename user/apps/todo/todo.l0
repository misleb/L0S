; todo.l0 -- To Do, a list of things to do, as GNOME's Endeavour keeps
; one: an entry and Add over a boxed list of the tasks, each a check box
; at its start and a delete button at its end, and along the foot how
; many are left. A click on a task, or on its check box, marks it done
; or not; Clear Completed, once something is done, asks before it
; deletes the done ones. Kept in memory only, for as long as it runs.
;
; It is the toolkit's worked example of an app made from a description
; (roadmap 0065, the l0s-ui skill's apps.md): its state a record, its
; view composed of page.l0's toolbar page and footer, list.l0's list and
; controls.l0's check boxes, its update a chain of tests on the action,
; and ui_run its loop.
;
;   todo          its window, until it is closed

; ----------------------------------------------------------------- state

; A task: its key, what it says, and whether it is done.
(data Task (Task (key int) (text (list int)) (done bool)))

; The app: the tasks, newest last; the key the next one gets; the
; entry's text; the list's first row shown; and whether Clear Completed
; is asking first.
(data Todo (Todo (tasks (list Task)) (next int) (entry UiEntryText) (first int) (asking bool)))

; No tasks yet.
(def todo_new () Todo (Todo (nil Task) 1 (UiEntryText "" 0) 0 false))

; The entry's name: its actions are new.entry, new.edit, new.activate.
(def todo_entry () (list int) "new")

; The list's prefix: a click on task K sets off items.select.K.
(def todo_items () (list int) "items")

; How many tasks are done, and how many are left.
(def todo_done_count ((ts (list Task))) int
  (if (is_empty ts) 0 (add (if (.done (head ts)) 1 0) (todo_done_count (tail ts)))))
(def todo_left ((t Todo)) int (sub (length (.tasks t)) (todo_done_count (.tasks t))))

; What the entry holds as a task's text: its words, one space between.
(def todo_typed ((t Todo)) (list int) (unwords (split_spaces (.text (.entry t)))))

; ------------------------------------------------------------------ view

; The window: a toolbar of the entry and Add, and Clear Completed at its
; end, over the tasks, how many are left along the foot; and over it
; all, while it asks, the dialog that asks whether to clear.
(def todo_view ((t Todo)) UiWidget
  (let page (ui_with_footer
              (ui_toolbar_page (cons (UiEntry (todo_entry) (.entry t) "What needs doing?" (ui_entry_w 16))
                                     (cons (UiButton "app.add" "list-add" "Add" (UiBtnSuggested) (not (is_empty (todo_typed t)))) (nil UiWidget)))
                               ""
                               (cons (UiButton "app.clear" "" "Clear Completed" (UiBtnRegular) (gt (todo_done_count (.tasks t)) 0)) (nil UiWidget))
                               (todo_body t))
              (todo_footer t))
    (if (.asking t) (UiModal page (todo_clear_alert t)) page)))

; The tasks, on the view's ground, 12 in; or, with none, a page saying
; what to do.
(def todo_body ((t Todo)) UiWidget
  (if (is_empty (.tasks t))
      (UiStatusPage "object-select" "Nothing to Do" "Type a task above, then press Enter")
      (UiPad (ui_space_m) (ui_space_m) (UiList (UiListData (todo_items) (todo_rows (.tasks t) (nil UiListRow)) (.first t))))))

; Each task a row: its check box, its text, Done under it once it is,
; and its delete button.
(def todo_rows ((ts (list Task)) (acc (list UiListRow))) (list UiListRow)
  (if (is_empty ts)
      (rev acc)
      (let (k (digits (.key (head ts)))
            done (.done (head ts))
            row (ui_list_row k (.text (head ts)) (if done "Done" "")))
        (todo_rows (tail ts)
                   (cons (.end (.start row (UiCheck (append "task." k) done "")) (UiButton (append "app.delete." k) "user-trash" "" (UiBtnFlat) true))
                         acc)))))

; The foot's line: how many are left.
(def todo_footer ((t Todo)) (list int)
  (let n (todo_left t)
    (if (is_empty (.tasks t)) "No tasks"
        (eq n 0) "All done"
        (eq n 1) "1 task left"
        (append (digits n) " tasks left"))))

; The dialog asking whether to delete the done tasks.
(def todo_clear_alert ((t Todo)) UiWidget
  (let n (todo_done_count (.tasks t))
    (ui_confirm "Clear Completed?"
                (cons (append (if (eq n 1) "1 done task" (append (digits n) " done tasks")) " will be deleted.") (nil (list int)))
                "dialog.clear" "Clear" true)))

; ---------------------------------------------------------------- update

; The app after action, set off with ev: a task added from the entry
; (Add, or Enter in it); the entry typed in; a task marked done or not,
; by a click on it or its check box; deleted; the done ones cleared,
; once asked and answered; the list scrolled.
(def todo_update ((t Todo) (action (list int)) (ev UiEvent)) Todo
  (let (sel (ui_select_key (todo_items) action)
        task (if (starts_with action "task.") (up_to 46 (drop_n action 5)) ""))
    (if (or (eq action "app.add") (eq action "new.activate")) (todo_added t)
        (starts_with action "new.") (.entry t (ui_entry_update (todo_entry) (.entry t) action ev))
        (not (is_empty sel)) (todo_toggled t sel)
        (not (is_empty task)) (todo_toggled t task)
        (starts_with action "app.delete.") (todo_deleted t (drop_n action 11))
        (eq action "app.clear") (.asking t (gt (todo_done_count (.tasks t)) 0))
        (eq action "dialog.clear") (todo_cleared t)
        (eq action (ui_cancel_action)) (.asking t false)
        (.first t (ui_list_first (.first t) (todo_items) action)))))

; The entry's text added as a task, not done, and the entry emptied; or
; t as it is, if it holds nothing but spaces.
(def todo_added ((t Todo)) Todo
  (let (text (todo_typed t)
        n (.next t))
    (if (is_empty text)
        t
        (.entry (.next (.tasks t (append (.tasks t) (cons (Task n text false) (nil Task)))) (add n 1)) (UiEntryText "" 0)))))

; Task k marked done if it was not, and not if it was.
(def todo_toggled ((t Todo) (k (list int))) Todo
  (.tasks t (todo_toggled_in (.tasks t) k (nil Task))))

; todo_toggled's loop, onto acc, reversed.
(def todo_toggled_in ((ts (list Task)) (k (list int)) (acc (list Task))) (list Task)
  (if (is_empty ts)
      (rev acc)
      (let x (head ts)
        (todo_toggled_in (tail ts) k (cons (if (eq (digits (.key x)) k) (.done x (not (.done x))) x) acc)))))

; Task k deleted.
(def todo_deleted ((t Todo) (k (list int))) Todo
  (.tasks t (ui_without todo_key k (.tasks t))))

; A task's key as its rows and actions name it.
(def todo_key ((x Task)) (list int) (digits (.key x)))

; The done tasks deleted, and the dialog gone.
(def todo_cleared ((t Todo)) Todo
  (.asking (.first (.tasks t (todo_undone (.tasks t) (nil Task))) 0) false))

; The tasks not done, in order.
(def todo_undone ((ts (list Task)) (acc (list Task))) (list Task)
  (if (is_empty ts) (rev acc) (todo_undone (tail ts) (if (.done (head ts)) acc (cons (head ts) acc)))))

; ------------------------------------------------------------------ loop

; A step of the window: the app updated; the entry given the focus as
; the window opens and after a task is added, so typing goes there.
(def todo_step ((t Todo) (action (list int)) (ev UiEvent) (w UiWin)) (UiStepped Todo)
  (let refocus (any_eq action (cons (ui_start_action) (cons "app.add" (cons "new.activate" (nil (list int))))))
    (UiStepped (if refocus (ui_win_focusing w (append (todo_entry) ".entry")) w) (todo_update t action ev))))

; Its window, until it is closed.
(def todo () int
  (ui_run "todo" "To Do" 480 520 (todo_new) todo_view todo_step))
