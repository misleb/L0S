(def none () UiEvent (UiOther 0 ""))

; The calculator after the actions in turn.
(def pressed ((s Calc) (actions (list (list int)))) Calc
  (if (is_empty actions) s (pressed (calc_update s (head actions) (none)) (tail actions))))

; The display after the actions in turn, from the start.
(def shown_after ((actions (list (list int)))) (list int)
  (calc_shown (pressed (calc_new) actions)))

; A key with the character ch and the code code, pressed.
(def typed ((code int) (ch int)) UiEvent (UiKey (KeyEvent code 1 ch 0)))

(def test_opens_at_zero () int
  (check_str "zero" (calc_shown (calc_new)) "0"))

(def test_digits () int
  (check_str "12.5" (shown_after (split_spaces "app.digit.1 app.digit.2 app.point app.digit.5")) "12.5"))

(def test_add () int
  (check_str "7+5" (shown_after (split_spaces "app.digit.7 app.op.add app.digit.5 app.equals")) "12"))

(def test_chain () int
  (check_str "2+3x4" (shown_after (split_spaces "app.digit.2 app.op.add app.digit.3 app.op.mul app.digit.4 app.equals")) "20"))

(def test_divide () int
  (check_str "1/3" (shown_after (split_spaces "app.digit.1 app.op.div app.digit.3 app.equals")) "0.3333333333"))

(def test_tenths () int
  (check_str "0.1+0.2" (shown_after (split_spaces "app.point app.digit.1 app.op.add app.point app.digit.2 app.equals")) "0.3"))

(def test_divide_by_zero () int
  (let s (pressed (calc_new) (split_spaces "app.digit.8 app.op.div app.digit.0 app.equals"))
    (add (check_str "error" (calc_shown s) "Error")
         (check_str "a digit after" (calc_shown (calc_update s "app.digit.4" (none))) "4"))))

(def test_sum_line () int
  (check_str "the sum" (.expr (pressed (calc_new) (split_spaces "app.digit.9 app.op.sub app.digit.4 app.equals"))) "9 - 4 ="))

(def test_back_and_clear () int
  (add (check_str "back" (shown_after (split_spaces "app.digit.4 app.digit.2 app.back")) "4")
       (check_str "clear" (shown_after (split_spaces "app.digit.4 app.op.add app.digit.2 app.clear")) "0")))

(def test_negate_percent () int
  (add (check_str "negate" (shown_after (split_spaces "app.digit.5 app.negate")) "-5")
       (check_str "percent" (shown_after (split_spaces "app.digit.5 app.digit.0 app.op.add app.digit.1 app.digit.0 app.percent")) "5")))

(def test_large () int
  (check_str "a big product" (shown_after (split_spaces "app.digit.9 app.digit.9 app.digit.9 app.digit.9 app.digit.9 app.digit.9 app.op.mul app.equals app.op.mul app.equals")) "9.99996e23"))

(def test_keys () int
  (let s (calc_update (calc_update (calc_update (calc_update (calc_new) "" (typed 3 50)) "" (typed 13 43)) "" (typed 4 51)) "" (typed (ui_key_enter) 0))
    (add (check_str "2+3 typed" (calc_shown s) "5")
         (check_str "escape" (calc_shown (calc_update s "" (typed (ui_key_esc) 0))) "0"))))

(def test_view () int
  (let ns (ui_laid (calc_view (calc_new)) 320 440)
    (add (check_bool "equals" (ui_has_target ns "app.equals") true)
         (check_bool "seven" (ui_has_target ns "app.digit.7") true))))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (calc) 1))
