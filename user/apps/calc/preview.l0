; preview.l0 -- Calculator's scenes, each the view of a state, painted on
; the host as the board paints them: as it opens, mid-sum, a result, a
; long number and Error.
(def pv_none () UiEvent (UiOther 0 ""))

(def pv_after ((actions (list (list int)))) Calc
  (if (is_empty actions) (calc_new) (pv_on (calc_new) actions)))

(def pv_on ((s Calc) (actions (list (list int)))) Calc
  (if (is_empty actions) s (pv_on (calc_update s (head actions) (pv_none)) (tail actions))))

(def pv_shot ((name (list int)) (actions (list int))) UiShot
  (UiShot name (calc_w) (calc_h) (calc_view (pv_after (split_spaces actions)))))

(def main () int
  (ui_preview
    (cons (pv_shot "main" "")
      (cons (pv_shot "typing" "app.digit.1 app.digit.2 app.op.mul app.digit.3 app.point app.digit.5")
        (cons (pv_shot "result" "app.digit.1 app.op.div app.digit.7 app.equals")
          (cons (pv_shot "long" "app.digit.9 app.digit.8 app.digit.7 app.digit.6 app.digit.5 app.digit.4 app.digit.3 app.digit.2 app.digit.1 app.digit.0 app.digit.9 app.point app.digit.8 app.negate")
            (cons (pv_shot "big" "app.digit.9 app.digit.9 app.digit.9 app.digit.9 app.digit.9 app.digit.9 app.op.mul app.equals app.op.mul app.equals")
              (cons (pv_shot "error" "app.digit.8 app.op.div app.digit.0 app.equals")
                (nil UiShot)))))))))
