; installer_test.l0 -- tests of the Installer: its state at first, the
; arguments install is run with, what it says before it runs, and
; install's output taken a write at a time.

; Volumes as fs_volumes gives them.
(def pi_volumes () (list (list int)) (split_spaces "/Volumes/bootfs /Volumes/System /Volumes/data"))

; A Pi 5 netbooted, / the initramfs: a fresh install onto System, bootfs
; its boot volume, the boot order set.
(def test_new_netbooted () int
  (let s (in_new (pi_volumes) "" "pi5")
    (add (check_strs "args" (in_args s) (split_spaces "--net fresh --boot bootfs --boot-order sd,net --progress System"))
         (check_strs "labels" (.vols s) (split_spaces "bootfs System data")))))

; Booted from System on QEMU: an update of it, no boot volume.
(def test_new_booted () int
  (let s (in_new (split_spaces "/Volumes/System /Volumes/data") "/Volumes/System" "virt")
    (check_strs "args" (in_args s) (split_spaces "--net update --progress System"))))

; Choosing update leaves the boot order; choosing a boot volume of none,
; and another system.
(def test_update_choices () int
  (let (s (in_new (pi_volumes) "" "pi5")
        s1 (in_update (in_update (in_update s "mode.select.update") "boot.select.-") "sys.select.data"))
    (check_strs "args" (in_args s1) (split_spaces "--net update --progress data"))))

(def test_order_choice () int
  (let s (in_update (in_new (pi_volumes) "" "pi5") "order.select.off")
    (check_bool "off" (.order s) false)))

; Under an operating system no volume is mounted: the data volume's
; absence is why it cannot run, and Install does nothing.
(def test_why () int
  (let s (in_new (pi_volumes) "" "pi5")
    (add (check_str "why" (in_why s) "/Volumes/data: no such volume is mounted; make one labelled data in Disks, for the agent's home and the speech model")
         (check_bool "not started" (match (.run (in_update s "app.install")) ((InIdle) true) ((InGoing p pid part said pr) false) ((InEnded st said) false)) true))))

(def test_no_system () int
  (check_str "why" (in_why (in_new (split_spaces "/Volumes/bootfs") "" "pi5")) "choose the system volume"))

(def test_erases () int
  (add (check_str "fresh" (in_erases (in_new (pi_volumes) "" "pi5")) "formatting /Volumes/System and /Volumes/bootfs: everything on them is erased")
       (check_str "update" (in_erases (in_new (pi_volumes) "/Volumes/System" "pi5")) "updates /Volumes/System; the agent's files on /Volumes/data are kept")))

; ----------------------------------------------------------- what it says

; A run going, as install is started.
(def going () InRun (InGoing 9 12 "" (nil (list int)) ""))

; A run as text: its progress, then its lines, | between, and the part
; not ended.
(def run_text ((r InRun)) (list int)
  (match r
    ((InIdle) "idle")
    ((InGoing port pid part said progress) (append progress (append "|" (append (join_with "|" said) (append "|" part)))))
    ((InEnded status said) (append (digits status) (append "|" (join_with "|" said))))))

; Lines come whole or in pieces; progress lines go to the progress.
(def test_wrote () int
  (let r (in_wrote (in_wrote (going) "install: 7 files to fetch\ninstall: file 1 of 7, 0 bytes") " of 230 bytes: system/bin/sh\ninstall: kep")
    (check_str "run" (run_text r) "file 1 of 7, 0 bytes of 230 bytes: system/bin/sh|7 files to fetch|install: kep")))

; At its exit, the part not ended is a line too.
(def test_exited () int
  (let r (in_exited (in_wrote (going) "install: 7 files to fetch\ninstall: the proxy said nothing") 1)
    (check_str "run" (run_text r) "1|7 files to fetch|the proxy said nothing")))

; Back, once it is done.
(def test_again () int
  (let s (.run (in_new (pi_volumes) "" "pi5") (InEnded 0 (nil (list int))))
    (check_str "idle" (run_text (.run (in_update s "app.again"))) "idle")))

; Only a run going waits on a port.
(def test_ports () int
  (let s (in_new (pi_volumes) "" "pi5")
    (add (check_int "idle" (length (in_ports s)) 0)
         (check_int "going" (head (in_ports (.run s (going)))) 9))))

; Under an operating system there is no window to open.
(def test_installer_no_window () int
  (check_int "status" (installer) 1))
