; preview.l0 -- Installer's scenes, each the view of a state, painted on
; the host as the board paints them: a Pi 5 netbooted, its fresh install
; ready and its list open, empty; an update on QEMU; install running;
; and install stopped.

; Volumes as fs_volumes gives them on a Pi 5.
(def pv_pi () (list (list int)) (split_spaces "/Volumes/bootfs /Volumes/System /Volumes/data"))

(def pv_said () (list (list int)) (cons "7 files to fetch" (cons "formatting /Volumes/System" (nil (list int)))))

(def main () int
  (let (fresh (in_new (pv_pi) "" "pi5")
        update (in_new (split_spaces "/Volumes/System /Volumes/data") "/Volumes/System" "virt"))
    (ui_preview (cons (UiShot "fresh" 640 560 (in_view fresh))
                      (cons (UiShot "update" 640 560 (in_view update))
                            (cons (UiShot "running" 640 560 (in_view (.run fresh (InGoing 9 12 "" (pv_said) "file 3 of 7, 120 of 230 bytes: system/bin/sh"))))
                                  (cons (UiShot "stopped" 640 560 (in_view (.run fresh (InEnded 1 (append (pv_said) (cons "the proxy said nothing" (nil (list int))))))))
                                        (nil UiShot))))))))
