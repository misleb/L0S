; disks.l0 -- Disks, as GNOME Disks is: a window showing the disks, their
; partitions and the volumes on them. A sidebar of drives, every disk
; registered (disk0, disk1, ...); the selected drive's name, size and
; partitioning; a bar of its partitions and the free space between them,
; each as wide as its share of the disk; and the selected one's size,
; usage, contents, type and place.
;
; It reads the partition table and each partition's first sector itself,
; through the disk protocol (user/lib/disk.l0), so a partition no server
; serves still shows; and asks the file server (user/lib/fs.l0) how full
; each mounted volume is. Refresh has the file server read the disks
; again and mount what is new, as it does at the start, and takes on any
; disk registered since; Format Volume empties a volume, once a dialog
; has asked. It keeps one buffer shared with each disk's driver, for as
; long as it runs. Every request, a sector's read, a volume's df, a
; change, is asked and never waited on (ui_win_ask), one out at a time,
; the next asked as each answer comes (DkWait, DkRead); meanwhile the
; window answers, shows the drive as it was, or that it is being read,
; and says what it waits for.
;
; A volume is L0S's own, L0FS, or FAT32 (user/lib/format/fat.l0), which
; Format... makes either of, as its dialog's toggle says. A disk with no
; GPT but an MBR, as Raspberry Pi's Imager writes, shows its partitions
; and their volumes; L0S makes no partitions in an MBR, so its free
; space offers nothing, but a partition no volume is served on, as
; Raspberry Pi OS's ext4 rootfs, offers Format... as on a GPT.

; ------------------------------------------------------------------ model

; What a partition holds: a volume, mounted, with its label, clusters of
; data, those free, files, a cluster's bytes, and whether it is FAT32;
; one no server serves, with its label and whether it is FAT32; or
; anything else, and why it is no volume.
(data DkContent (DkVolume (list int) int int int int bool) (DkUnmounted (list int) bool) (DkUnknown (list int)))

; A part of the disk: a partition, its number in the table from 1, first
; sector, sectors, its entry in the table, and what it holds; or free
; space, its first sector and sectors.
(data DkSeg (DkPart int int int GptPart DkContent) (DkFree int int))

; The drive: its sectors, its partition table, dk_gpt, dk_mbr or none,
; 0, and its parts in order; or why there is none.
(data DkDrive (DkDrive int int (list DkSeg)) (DkNoDrive (list int)))

; A drive's tables: GPT's, and MBR's.
(def dk_gpt () int 1)
(def dk_mbr () int 2)

; A dialog over the window: none; asking whether to format a mounted
; volume, by its label; asking how much of the free space from a sector,
; of so many, a new partition is to have, the size typed so far; or
; asking what a new volume on partition N, of a UUID, is to be called,
; the label it had if it held a volume no server serves, the name typed
; so far, and whether it is to be FAT32; or asking whether to format the
; whole drive, a new, empty GPT in place of all it holds.
(data DkDialog (DkNoDialog) (DkConfirm (list int)) (DkCreate int int UiEntryText) (DkMkfs int Uuid (list int) UiEntryText bool) (DkErase))

; What can be done with the selected part: free space made a partition,
; from its first sector, of its sectors; a mounted volume formatted, by
; its label; a partition with no volume served given one, by its number,
; its UUID and the label of any volume it held; or nothing.
(data DkAct (DkActCreate int int) (DkActFormat (list int)) (DkActMkfs int Uuid (list int)) (DkActNone))

; The window's state: the drive, the selected part's key, the dialog, and
; a line saying what was last done.
(data Disks (Disks DkDrive (list int) DkDialog (list int)))

; A sector's bytes.
(def dk_sector () int 512)

; The prefixes of the sidebar's and the bar's actions.
(def dk_side () (list int) "side")
(def dk_vols () (list int) "vols")

; A part's key in the bar: its number, or free and its first sector.
(def dk_key ((s DkSeg)) (list int)
  (match s
    ((DkPart n start count ty c) (digits n))
    ((DkFree start count) (append "free." (digits start)))))

; ------------------------------------------------------------------ parts

; The parts of a disk of sectors whose table lists parts, each with what
; contents says it holds, in order: gpt.l0's layout, free space wherever
; no partition is, in the sectors the GPT leaves partitions.
(def dk_segments ((sectors int) (parts (list GptPart)) (contents (list DkContent))) (list DkSeg)
  (dk_segs_of (gpt_layout sectors parts) contents (nil DkSeg)))

(def dk_segs_of ((spans (list GptSpan)) (contents (list DkContent)) (acc (list DkSeg))) (list DkSeg)
  (if (is_empty spans)
      (rev acc)
      (dk_segs_of (tail spans) contents (cons (dk_seg_of (head spans) contents) acc))))

; A span as a part, partition n holding what contents says, unknown if
; it was not read.
(def dk_seg_of ((s GptSpan) (contents (list DkContent))) DkSeg
  (match s
    ((GptUsed n p) (DkPart n (gpt_part_start p) (gpt_part_sectors p) p (nth_or contents (sub n 1) (DkUnknown "not read"))))
    ((GptUnused start count) (DkFree start count))))

; What a partition's first sector, read as bs, says it holds, mounted if
; space is the answer of df: a volume of L0FS or FAT32, or not. A FAT32
; volume's label is the one fs mounts it at, of its boot sector's.
(def dk_content_of ((bs bytes) (space FsSpace)) DkContent
  (match (vol_super_of bs)
    ((VolSuper label l) (dk_content_with label (vol_cluster_size) false space))
    ((VolNotSuper why)
      (match (fat_boot_of bs)
        ((FatBoot g label) (dk_content_with (fat_mount_label label (fat_serial g)) (vol_cluster_size) true space))
        ((FatNotBoot why2) (DkUnknown (if (eq why2 "no FAT32 volume") why why2)))))))

; A volume labelled label, of clusters of cb bytes, FAT32's if fat:
; mounted if space says how full it is.
(def dk_content_with ((label (list int)) (cb int) (fat bool) (space FsSpace)) DkContent
  (match space
    ((FsSpace sectors clusters free files) (DkVolume label clusters free files cb fat))
    ((FsSpaceRefused code) (DkUnmounted label fat))))

; The label a volume whose first sector is bs is mounted at, if it is
; one: L0FS's superblock's, or FAT32's as fs makes it; else empty.
(def dk_label_of ((bs bytes)) (list int)
  (match (vol_super_of bs)
    ((VolSuper label l) label)
    ((VolNotSuper why)
      (match (fat_boot_of bs)
        ((FatBoot g label) (fat_mount_label label (fat_serial g)))
        ((FatNotBoot why2) "")))))

; ------------------------------------------------------------------- text

; A size, and its bytes, a comma every three digits: 1.0 MB (1,048,576
; bytes).
(def dk_size_long ((bytes int)) (list int)
  (if (lt bytes 1000)
      (format_size bytes)
      (append (format_size bytes) (append " (" (append (dk_grouped bytes) " bytes)")))))

; n in digits, a comma before every three from the end.
(def dk_grouped ((n int)) (list int)
  (if (lt n 1000)
      (digits n)
      (append (dk_grouped (div n 1000)) (append "," (dk_three (mod n 1000))))))

; n, below 1000, in three digits.
(def dk_three ((n int)) (list int)
  (if (lt n 10) (append "00" (digits n)) (if (lt n 100) (append "0" (digits n)) (digits n))))

; What a partition's type is called: L0FS's, Microsoft's basic data,
; EFI's, an MBR's by its byte as dk_mbr_type keeps it, or its UUID.
(def dk_type_text ((ty Uuid)) (list int)
  (if (eq ty (gpt_l0fs_type))
      "L0FS"
      (if (eq ty (gpt_basic_type))
          "Microsoft Basic Data"
          (if (eq ty (gpt_esp_type))
              "EFI System"
              (if (starts_with (uuid_bytes ty) "MBR")
                  (mbr_type_text (last (uuid_bytes ty)))
                  (uuid_text ty))))))

; An MBR partition's type byte ty, kept where a GPT partition's type
; goes: MBR, zeros, then ty.
(def dk_mbr_type ((ty int)) Uuid (Uuid (append "MBR" (append (zeros 12) (cons ty (nil int))))))

; The name of a volume's format.
(def dk_format_name ((fat bool)) (list int) (if fat "FAT32" "L0FS"))

; The bytes of sectors.
(def dk_bytes ((sectors int)) int (mul sectors (dk_sector)))

; A part's title and line in the bar.
(def dk_seg_title ((s DkSeg)) (list int)
  (match s
    ((DkFree start count) "Free Space")
    ((DkPart n start count ty c)
      (match c
        ((DkVolume label cl fr fi cb fat) label)
        ((DkUnmounted label fat) label)
        ((DkUnknown why) (append "Partition " (digits n)))))))

; A part's line: its size, and what it holds.
(def dk_seg_line ((s DkSeg)) (list int)
  (match s
    ((DkFree start count) (format_size (dk_bytes count)))
    ((DkPart n start count ty c)
      (append (format_size (dk_bytes count))
              (match c
                ((DkVolume l a b e cb fat) (cons 32 (dk_format_name fat)))
                ((DkUnmounted l fat) (cons 32 (dk_format_name fat)))
                ((DkUnknown why) " Unknown"))))))

; What a partition holds, in words.
(def dk_contents_text ((c DkContent)) (list int)
  (match c
    ((DkVolume label cl fr fi cb fat) (append (dk_format_long fat) (append " - Mounted at /Volumes/" label)))
    ((DkUnmounted label fat) (append (dk_format_long fat) " - Not Mounted"))
    ((DkUnknown why) (append "Unknown - " why))))

; A volume's format as Contents names it.
(def dk_format_long ((fat bool)) (list int) (if fat "FAT32" "L0FS version 2"))

; How full a volume of clusters of cb bytes is: used, then free.
(def dk_usage_text ((clusters int) (free int) (cb int)) (list int)
  (append (format_size (mul (sub clusters free) cb))
          (append " used, " (append (format_size (mul free cb)) " free"))))

; How much of a volume is used, in percent: at least 1 if any is, so
; that the level bar shows it.
(def dk_used_pct ((clusters int) (free int)) int
  (if (le clusters 0)
      0
      (let used (sub clusters free)
        (if (le used 0) 0 (max 1 (div (mul used 100) clusters))))))

; ------------------------------------------------------------------ state

; The window's first state: the drive, its first volume selected.
(def dk_new ((d DkDrive)) Disks (Disks d (dk_first_key d) (DkNoDialog) ""))

; The key of the drive's first volume, or of its first part.
(def dk_first_key ((d DkDrive)) (list int)
  (match d
    ((DkNoDrive why) "")
    ((DkDrive n gpt segs) (dk_first_part segs (if (is_empty segs) "" (dk_key (head segs)))))))

; The key of the first partition among segs, or fallback.
(def dk_first_part ((segs (list DkSeg)) (fallback (list int))) (list int)
  (if (is_empty segs)
      fallback
      (match (head segs)
        ((DkPart n start count ty c) (dk_key (head segs)))
        ((DkFree start count) (dk_first_part (tail segs) fallback)))))

; The drive's parts, none if there is no drive; and the selected key.
(def dk_segs ((m Disks)) (list DkSeg)
  (match m ((Disks d sel dlg st) (match d ((DkDrive n gpt segs) segs) ((DkNoDrive why) (nil DkSeg))))))

(def dk_selected ((m Disks)) (list int) (match m ((Disks d sel dlg st) sel)))

; The selected part, if there is one by that key.
(def dk_selected_seg ((m Disks)) (Option DkSeg)
  (dk_seg_keyed (dk_segs m) (dk_selected m)))

; The part of segs whose key is key, if one is.
(def dk_seg_keyed ((segs (list DkSeg)) (key (list int))) (Option DkSeg)
  (if (is_empty segs) ((None DkSeg)) (if (eq (dk_key (head segs)) key) (Some (head segs)) (dk_seg_keyed (tail segs) key))))

; The drive's table: dk_gpt, dk_mbr, or 0 for none.
(def dk_scheme ((m Disks)) int
  (match m ((Disks d sel dlg st) (match d ((DkDrive n gpt segs) gpt) ((DkNoDrive why) 0)))))

; What can be done with the selected part: a partition made in free
; space, but not in an MBR, which L0S makes no partitions in; a mounted
; volume formatted; any other partition given a volume, in an MBR too,
; where fs changes only its type byte.
(def dk_act ((m Disks)) DkAct
  (match (dk_selected_seg m)
    ((None) (DkActNone))
    ((Some s)
      (match s
        ((DkFree start count) (if (eq (dk_scheme m) (dk_mbr)) (DkActNone) (DkActCreate start count)))
        ((DkPart n start count p c)
          (match c
            ((DkVolume label a b e cb fat) (DkActFormat label))
            ((DkUnmounted label fat) (DkActMkfs n (gpt_part_uuid p) label))
            ((DkUnknown why) (DkActMkfs n (gpt_part_uuid p) ""))))))))

; The label of the selected part, if it is a mounted volume, which only
; can be emptied by Format Volume; else empty.
(def dk_formattable ((m Disks)) (list int)
  (match (dk_act m) ((DkActFormat label) label) ((DkActCreate s c) "") ((DkActMkfs n u h) "") ((DkActNone) "")))

; The key of the part that is the partition whose UUID is u, or "".
(def dk_uuid_key ((segs (list DkSeg)) (u Uuid)) (list int)
  (if (is_empty segs)
      ""
      (match (head segs)
        ((DkPart n start count p c) (if (eq (gpt_part_uuid p) u) (dk_key (head segs)) (dk_uuid_key (tail segs) u)))
        ((DkFree start count) (dk_uuid_key (tail segs) u)))))

; The state with the partition whose UUID is u selected, if there is one.
(def dk_with_uuid ((m Disks) (u Uuid)) Disks
  (match m
    ((Disks d sel dlg st)
      (let k (dk_uuid_key (dk_segs m) u) (if (is_empty k) m (Disks d k dlg st))))))

; ------------------------------------------------------------------ sizes

; The bytes a size in kB, of 1000 bytes, says: N, or N and up to three
; decimals; -1 if it is not one.
(def dk_kb_bytes ((s (list int))) int
  (let whole (dk_digit_run s 0)
    (if (if (eq whole 0) true (gt whole 9))
        -1
        (let rest (drop_n s whole)
          (let w (mul (int_prefix s 0) 1000)
            (if (is_empty rest)
                w
                (if (eq (head rest) 46) (dk_kb_frac w (tail rest)) -1)))))))

; w and the decimals fr after it, of 1 to 3 digits; -1 if they are not.
(def dk_kb_frac ((w int) (fr (list int))) int
  (let n (dk_digit_run fr 0)
    (if (if (ge n 1) (if (le n 3) (eq n (length fr)) false) false)
        (add w (mul (int_prefix fr 0) (if (eq n 1) 100 (if (eq n 2) 10 1))))
        -1)))

; How many digits s starts with, onto n.
(def dk_digit_run ((s (list int)) (n int)) int
  (if (is_empty s) n (if (is_digit (head s)) (dk_digit_run (tail s) (add n 1)) n)))

; The sectors a size in kB comes to, to the nearest: 0 if it is not a
; size, or not 1 to count of them.
(def dk_size_sectors ((s (list int)) (count int)) int
  (let bytes (dk_kb_bytes s)
    (if (lt bytes 0)
        0
        (let n (div (add bytes (div (dk_sector) 2)) (dk_sector))
          (if (if (ge n 1) (le n count) false) n 0)))))

; count sectors in kB, to the nearest tenth: what a size is filled in
; with, which comes back to count, being within 50 bytes of it.
(def dk_kb_text ((count int)) (list int)
  (let t (div (add (mul (dk_bytes count) 10) 500) 1000)
    (append (digits (div t 10)) (append "." (digits (mod t 10))))))

; The window's state with the drive read again: its selection kept if
; the part is still there, and a line saying what happened.
(def dk_rescanned ((m Disks) (d DkDrive) (status (list int))) Disks
  (match m
    ((Disks old sel dlg st)
      (let m2 (Disks d sel (DkNoDialog) status)
        (match (dk_selected_seg m2)
          ((Some s) m2)
          ((None) (Disks d (dk_first_key d) (DkNoDialog) status)))))))

; ----------------------------------------------------------------- update

; The state after an action, or a key, that needs nothing read or written:
; selecting, opening a dialog, typing in it and closing it. Refreshing,
; formatting, and making partitions and volumes are done by the loop,
; which reads and writes the disk.
(def dk_update ((m Disks) (action (list int)) (ev UiEvent)) Disks
  (match m
    ((Disks d sel dlg st)
      (let vk (ui_select_key (dk_vols) action)
        (if (not (is_empty vk))
            (Disks d vk dlg st)
            (if (any_eq action (split_spaces "app.format app.create app.mkfs"))
                (Disks d sel (dk_opened (dk_act m) action dlg) st)
                (if (eq action "app.erase")
                    (Disks d sel (match d ((DkDrive n gpt segs) (DkErase)) ((DkNoDrive why) dlg)) st)
                (if (eq action "dialog.cancel")
                    (Disks d sel (DkNoDialog) st)
                    (dk_keyed (Disks d sel (dk_edited dlg action ev) st) ev)))))))))

; The dialog an action opens for what can be done, if they go together;
; else dlg as it was. A size starts as all the free space, and a name as
; the label the partition's volume had.
(def dk_opened ((a DkAct) (action (list int)) (dlg DkDialog)) DkDialog
  (match a
    ((DkActFormat label) (if (eq action "app.format") (DkConfirm label) dlg))
    ((DkActCreate start count) (if (eq action "app.create") (DkCreate start count (ui_entry_new (dk_kb_text count))) dlg))
    ((DkActMkfs n u had) (if (eq action "app.mkfs") (DkMkfs n u had (ui_entry_new had) false) dlg))
    ((DkActNone) dlg)))

; The entries' names in the dialogs.
(def dk_size_entry () (list int) "size")
(def dk_label_entry () (list int) "label")

; The prefix of the format dialog's toggles, and their keys.
(def dk_fmt () (list int) "fmt")
(def dk_fmt_l0fs () (list int) "l0fs")
(def dk_fmt_fat () (list int) "fat32")

; The dialog with what action typed in its entry, if it has one, or the
; format its toggle chose. A name is kept to the 15 characters a label
; may have, or FAT32's 11.
(def dk_edited ((dlg DkDialog) (action (list int)) (ev UiEvent)) DkDialog
  (match dlg
    ((DkNoDialog) dlg)
    ((DkConfirm label) dlg)
    ((DkErase) dlg)
    ((DkCreate start count t) (DkCreate start count (ui_entry_update (dk_size_entry) t action ev)))
    ((DkMkfs n u had t fat)
      (let fk (ui_select_key (dk_fmt) action)
        (if (not (is_empty fk))
            (DkMkfs n u had t (eq fk (dk_fmt_fat)))
            (let t2 (ui_entry_update (dk_label_entry) t action ev)
              (DkMkfs n u had (if (gt (length (ui_entry_text t2)) (dk_label_max fat)) t t2) fat)))))))

; The longest label a volume may have: FAT32's 11, or 15.
(def dk_label_max ((fat bool)) int (if fat (fat_label_max) (label_max)))

; Whether label may be a new volume's, FAT32's if fat.
(def dk_label_fits ((label (list int)) (fat bool)) bool
  (if (label_ok label) (le (length label) (dk_label_max fat)) false))

; The action of the entry a dialog has, for the focus to go to as it
; opens; "" for one with none.
(def dk_dialog_entry ((dlg DkDialog)) (list int)
  (match dlg
    ((DkNoDialog) "")
    ((DkConfirm label) "")
    ((DkErase) "")
    ((DkCreate start count t) (ui_entry_action (dk_size_entry)))
    ((DkMkfs n u had t fat) (ui_entry_action (dk_label_entry)))))

; The dialog open, if any.
(def dk_dialog ((m Disks)) DkDialog (match m ((Disks d sel dlg st) dlg)))

; A key: Esc closes a dialog; Left and Right move along the bar while
; there is none.
(def dk_keyed ((m Disks) (ev UiEvent)) Disks
  (match m
    ((Disks d sel dlg st)
      (let code (ui_key_pressed ev)
        (if (lt code 0)
            m
            (match dlg
              ((DkNoDialog) (Disks d (ui_segbar_key (dk_segments_of m) sel code) dlg st))
              ((DkConfirm label) (dk_escaped m code))
              ((DkErase) (dk_escaped m code))
              ((DkCreate start count t) (dk_escaped m code))
              ((DkMkfs n u had t fat) (dk_escaped m code))))))))

; The dialog closed if code is Esc.
(def dk_escaped ((m Disks) (code int)) Disks
  (match m ((Disks d sel dlg st) (if (eq code (ui_key_esc)) (Disks d sel (DkNoDialog) st) m))))

; ------------------------------------------------------------------- view

; The window of one drive, disk0, as its sidebar's only row, its icon
; the symbolic one, waiting for nothing.
(def dk_view ((m Disks)) UiWidget
  (match m ((Disks d sel dlg st) (dk_view_of m (dk_side_rows d (ui_images_none)) "0" (disk_name 0) ""))))

; The window: the sidebar of rows, the row sel selected, a line, and the
; pane of the drive m shows, named name; under the dialog, if one is
; open. While the window waits for an answer, busy says what for, and
; shows in place of the line at the foot, with Refresh and the part's
; button insensitive, as GNOME Disks greys them while it works; with no
; drive read yet, as the pane's page.
(def dk_view_of ((m Disks) (rows (list UiSideRow)) (sel_row (list int)) (name (list int)) (busy (list int))) UiWidget
  (match m
    ((Disks d sel dlg st)
      (let page (UiBox (UiH) 0 (cons (UiSidebar (ui_sidebar_w) rows (dk_side) sel_row)
                                     (cons (UiSeparator (UiV))
                                           (cons (UiExpand (dk_pane m name busy)) (nil UiWidget)))))
        (match dlg
          ((DkNoDialog) page)
          ((DkConfirm label) (UiModal page (dk_alert label)))
          ((DkErase) (UiModal page (dk_erase_alert name (match d ((DkDrive n gpt segs) n) ((DkNoDrive why) 0)))))
          ((DkCreate start count t) (UiModal page (dk_create_alert count t)))
          ((DkMkfs n u had t fat) (UiModal page (dk_mkfs_alert n had t fat))))))))

; The dialog asking whether to format label.
(def dk_alert ((label (list int))) UiWidget
  (ui_alert "Format Volume?" (cons (append "Every file on " (append label " will be lost.")) (nil (list int)))
            (cons (dk_cancel)
                  (cons (UiButton "dialog.format" "" "Format" (UiBtnDestructive) true) (nil UiWidget)))))

; The dialog asking whether to format the drive name, of sectors, whole,
; as GNOME Disks's Format Disk asks.
(def dk_erase_alert ((name (list int)) (sectors int)) UiWidget
  (ui_alert "Format Disk?"
            (cons (append "Every partition on the " (append (dk_drive_title sectors) (append ", " (append name ", and every file on them, will be lost."))))
                  (cons "It will have a new GUID Partition Table, with no partitions." (nil (list int))))
            (cons (dk_cancel)
                  (cons (UiButton "dialog.erase" "" "Format" (UiBtnDestructive) true) (nil UiWidget)))))

; A dialog's Cancel.
(def dk_cancel () UiWidget (UiButton "dialog.cancel" "" "Cancel" (UiBtnRegular) true))

; The dialog asking how much of count free sectors a new partition is to
; have, t typed so far, in kB, as GNOME Disks asks: the space left after
; it said as it is typed, and Create only for a size that fits.
(def dk_create_alert ((count int) (t UiEntryText)) UiWidget
  (let n (dk_size_sectors (ui_entry_text t) count)
    (ui_alert_form "Create Partition" (cons (append "Free space: " (format_size (dk_bytes count))) (nil (list int)))
      (cons (UiProps (cons (UiProp "Size" (UiBox (UiH) (ui_space_s) (cons (UiEntry (dk_size_entry) t "" 120) (cons (dk_value "kB") (nil UiWidget)))))
                           (cons (UiProp "Free Space Following" (dk_value (if (eq n 0) "-" (format_size (dk_bytes (sub count n))))))
                                 (nil UiProp))))
            (nil UiWidget))
      (cons (dk_cancel) (cons (UiButton "dialog.create" "" "Create" (UiBtnSuggested) (gt n 0)) (nil UiWidget))))))

; The dialog asking what a new volume on partition n is to be called, t
; typed so far, and of which format, FAT32 if fat, as its toggles say:
; where it will be mounted said as it is typed, and Format only for a
; label the volume may have. Red, and saying so, if the partition held a
; volume, had.
(def dk_mkfs_alert ((n int) (had (list int)) (t UiEntryText) (fat bool)) UiWidget
  (let label (ui_entry_text t)
    (ui_alert_form (append "Format Partition " (digits n))
      (cons (if fat "A new, empty FAT32 volume, which a Raspberry Pi boots from." "A new, empty L0FS volume.")
            (if (is_empty had) (nil (list int)) (cons (append "Every file on " (append had " will be lost.")) (nil (list int)))))
      (cons (UiProps (cons (UiProp "Type" (UiToggleGroup (dk_fmt) (dk_fmt_toggles) (if fat (dk_fmt_fat) (dk_fmt_l0fs))))
                     (cons (UiProp "Volume Name" (UiEntry (dk_label_entry) t "" (dk_label_entry_w)))
                           (cons (UiProp "Mounted At" (dk_at_least (add (ui_text_w "/Volumes/" (ui_text_font) false 1) (ui_chars_w (label_max) (ui_text_font) false))
                                                                   (dk_value (if (dk_label_fits label fat) (append "/Volumes/" label) "-"))))
                                 (nil UiProp)))))
            (nil UiWidget))
      (cons (dk_cancel)
            (cons (UiButton "dialog.mkfs" "" "Format" (if (is_empty had) (UiBtnSuggested) (UiBtnDestructive)) (dk_label_fits label fat))
                  (nil UiWidget))))))

; The format dialog's toggles: L0FS, L0S's own, and FAT32.
(def dk_fmt_toggles () (list UiToggle)
  (cons (UiToggle (dk_fmt_l0fs) "" "L0FS") (cons (UiToggle (dk_fmt_fat) "" "FAT32") (nil UiToggle))))

; w at least w wide, so that a dialog keeps its width as what is in it is
; typed.
(def dk_at_least ((w int) (wd UiWidget)) UiWidget
  (UiBox (UiV) 0 (cons (UiSpace w 0) (cons wd (nil UiWidget)))))

; A label's entry: as wide as the longest label of the face's widest
; characters, and its edges.
(def dk_label_entry_w () int (add (ui_chars_w (label_max) (ui_text_font) false) (add (mul 2 (ui_entry_pad)) (ui_entry_cursor_w))))

; The sidebar's rows of one drive, disk0: the drive, if there is one,
; its icon from im.
(def dk_side_rows ((d DkDrive) (im UiImages)) (list UiSideRow)
  (match d
    ((DkNoDrive why) (nil UiSideRow))
    ((DkDrive n gpt segs) (cons (dk_side_row 0 (disk_name 0) n im) (nil UiSideRow)))))

; The row of drive i, the disk name of sectors: a drive's full-color
; icon from im, as GNOME Disks shows one, or its symbolic one if im has
; not that; its size as its title, and its name under it.
(def dk_side_row ((i int) (name (list int)) (sectors int) (im UiImages)) UiSideRow
  (UiSideRow (digits i) "drive-harddisk" (dk_drive_title sectors) name (ui_image im "drive-harddisk")))

; A drive's name, as GNOME Disks makes one: its size, and Disk.
(def dk_drive_title ((sectors int)) (list int) (append (format_size (dk_bytes sectors)) " Disk"))

; The drive's pane, 18 in: its name and Refresh; its properties; the bar
; of its parts and the button for what can be done with the selected
; one; its properties; and the line saying what was done, or what the
; window waits for, busy, while it does. A status page if there is no
; drive: the drive's name and busy while it is being read, No Disks
; otherwise.
(def dk_pane ((m Disks) (name (list int)) (busy (list int))) UiWidget
  (match m
    ((Disks d sel dlg st)
      (match d
        ((DkNoDrive why) (if (is_empty busy) (UiStatusPage "drive-harddisk" "No Disks" why) (UiStatusPage "drive-harddisk" name busy)))
        ((DkDrive n gpt segs)
          (UiPad (ui_space_l) (ui_space_l)
            (UiBox (UiV) (ui_space_m)
              (cons (dk_heading n (is_empty busy))
              (cons (UiProps (dk_drive_props n gpt name))
              (cons (UiLabel "Volumes" (UiHeading) (UiStart))
              (cons (UiSegmentBar (dk_vols) (dk_ui_segments segs (nil UiSegment)) sel (ui_segbar_h))
              (cons (UiBox (UiH) (ui_space_s)
                      (cons (dk_act_button (dk_act m) (is_empty busy)) (nil UiWidget)))
              (cons (UiProps (dk_seg_props (dk_selected_seg m)))
              (cons (UiExpand (UiSpace 0 0))
              (cons (UiLabel (if (is_empty busy) st busy) (UiDimmed) (UiStart)) (nil UiWidget))))))))))))))))

; The button under the bar: Create Partition... on free space, Format
; Volume... on a mounted volume, Format... on any other partition, as
; GNOME Disks has them; Format Volume..., insensitive, with nothing
; selected; any of them insensitive while the window waits, not live.
(def dk_act_button ((a DkAct) (live bool)) UiWidget
  (match a
    ((DkActCreate start count) (UiButton "app.create" "" "Create Partition..." (UiBtnRegular) live))
    ((DkActFormat label) (UiButton "app.format" "" "Format Volume..." (UiBtnRegular) live))
    ((DkActMkfs n u had) (UiButton "app.mkfs" "" "Format..." (UiBtnRegular) live))
    ((DkActNone) (UiButton "app.format" "" "Format Volume..." (UiBtnRegular) false))))

; The drive's name, large, and at the row's end Format Disk..., which
; asks before it gives the drive a new, empty GPT, and Refresh, both
; insensitive while the window waits, not live.
(def dk_heading ((n int) (live bool)) UiWidget
  (UiBox (UiH) (ui_space_s)
    (cons (UiLabel (dk_drive_title n) (UiLarge) (UiStart))
          (cons (UiExpand (UiSpace 0 0))
                (cons (UiButton "app.erase" "" "Format Disk..." (UiBtnRegular) live)
                      (cons (UiButton "app.refresh" "view-refresh" "Refresh" (UiBtnFlat) live) (nil UiWidget)))))))

; The drive's properties: the disk's name, as its driver registered it,
; its size, and its partitioning, its table: GPT's, MBR's, or none.
(def dk_drive_props ((n int) (gpt int) (name (list int))) (list UiProp)
  (cons (UiProp "Device" (dk_value name))
        (cons (UiProp "Size" (dk_value (dk_size_long (dk_bytes n))))
              (cons (UiProp "Partitioning" (dk_value (if (eq gpt (dk_gpt)) "GUID Partition Table" (if (eq gpt (dk_mbr)) "Master Boot Record" "None"))))
                    (nil UiProp)))))

; A property's value: text.
(def dk_value ((s (list int))) UiWidget (UiLabel s (UiBody) (UiStart)))

; The parts as the bar shows them, each as wide as its sectors: a
; partition plain, free space muted, as GNOME Disks has them.
(def dk_ui_segments ((segs (list DkSeg)) (acc (list UiSegment))) (list UiSegment)
  (if (is_empty segs)
      (rev acc)
      (let s (head segs)
        (dk_ui_segments (tail segs)
          (cons (UiSegment (dk_key s) (match s ((DkPart n st c t x) c) ((DkFree st c) c)) (dk_seg_title s) (dk_seg_line s)
                           (match s ((DkPart n st c t x) (UiSegPlain)) ((DkFree st c) (UiSegMuted))))
                acc)))))

; The selected part's properties.
(def dk_seg_props ((s (Option DkSeg))) (list UiProp)
  (match s
    ((None) (nil UiProp))
    ((Some seg)
      (match seg
        ((DkFree start count)
          (cons (UiProp "Size" (dk_value (dk_size_long (dk_bytes count))))
                (cons (UiProp "Contents" (dk_value "Unallocated Space"))
                      (cons (UiProp "Location" (dk_value (dk_location start count))) (nil UiProp)))))
        ((DkPart n start count ty c)
          (cons (UiProp "Size" (dk_value (dk_size_long (dk_bytes count))))
                (append (dk_usage_props c)
                        (cons (UiProp "Contents" (dk_value (dk_contents_text c)))
                              (cons (UiProp "Partition Type" (dk_value (dk_type_text (gpt_part_type ty))))
                                    (cons (UiProp "Partition UUID" (dk_value (uuid_text (gpt_part_uuid ty))))
                                          (cons (UiProp "Device" (dk_value (append "Partition " (digits n))))
                                                (cons (UiProp "Location" (dk_value (dk_location start count))) (nil UiProp)))))))))))))

; How full a mounted volume is, and its files; nothing for any other.
(def dk_usage_props ((c DkContent)) (list UiProp)
  (match c
    ((DkVolume label clusters free files cb fat)
      (cons (UiProp "Usage" (UiBox (UiH) (ui_space_m)
                              (cons (UiLevel (dk_used_pct clusters free) 160)
                                    (cons (dk_value (dk_usage_text clusters free cb)) (nil UiWidget)))))
            (cons (UiProp "Files" (dk_value (digits files))) (nil UiProp))))
    ((DkUnmounted label fat) (nil UiProp))
    ((DkUnknown why) (nil UiProp))))

; Where a part is: its first and last sectors.
(def dk_location ((start int) (count int)) (list int)
  (append "Sectors " (append (digits start) (append "-" (digits (sub (add start count) 1))))))

; The bar's parts, as the view has them, for the keys that move along it.
(def dk_segments_of ((m Disks)) (list UiSegment) (dk_ui_segments (dk_segs m) (nil UiSegment)))

; --------------------------------------------------------------- the disk

; What the window reads through: the disk, and a buffer shared with its
; driver; or why there is none.
(data DkIo (DkIo Disk DiskBuf) (DkNoIo (list int)))

; A disk opened and its buffer made, once each, since a process can
; open only so many regions.
(def dk_io_of ((d Disk)) DkIo
  (match d
    ((NoDisk why) (DkNoIo why))
    ((Disk name port rp pid n)
      (match (disk_buffer (Disk name port rp pid n) (gpt_entry_sectors))
        ((NoDiskBuf why) (DkNoIo why))
        ((DiskBuf va pages there r) (DkIo (Disk name port rp pid n) (DiskBuf va pages there r)))))))

; Every disk there is, each opened: disk0 waited for if none is there
; yet, and why, if none comes.
(def dk_ios () (list DkIo)
  (let names (disk_names)
    (if (is_empty names)
        (cons (dk_io_of (disk_open)) (nil DkIo))
        (dk_ios_more (nil DkIo) names))))

; ios with each disk of names that none of them is, opened, after them;
; those that cannot be opened left out, as a drive with no disk is.
(def dk_ios_more ((ios (list DkIo)) (names (list (list int)))) (list DkIo)
  (if (is_empty names)
      ios
      (dk_ios_more
        (if (dk_has_disk ios (head names))
            ios
            (match (dk_io_of (disk_open_named (head names)))
              ((DkNoIo why) ios)
              ((DkIo d b) (append (dk_drives_only ios) (cons (DkIo d b) (nil DkIo))))))
        (tail names))))

; Whether one of ios is the disk name's.
(def dk_has_disk ((ios (list DkIo)) (name (list int))) bool
  (if (is_empty ios) false (if (eq (dk_io_name (head ios)) name) true (dk_has_disk (tail ios) name))))

; ios without any that is no disk, as the one that said why none came.
(def dk_drives_only ((ios (list DkIo))) (list DkIo)
  (if (is_empty ios)
      ios
      (match (head ios)
        ((DkNoIo why) (dk_drives_only (tail ios)))
        ((DkIo d b) (cons (head ios) (dk_drives_only (tail ios)))))))

; Its disk's name, empty for none; and its sectors, 0 for none.
(def dk_io_name ((io DkIo)) (list int) (match io ((DkIo d b) (disk_name_of d)) ((DkNoIo why) "")))
(def dk_io_sectors ((io DkIo)) int (match io ((DkIo d b) (disk_sectors d)) ((DkNoIo why) 0)))

; The sidebar's rows: a drive for each disk of ios, from i, its icon
; from im.
(def dk_rows ((ios (list DkIo)) (i int) (im UiImages) (acc (list UiSideRow))) (list UiSideRow)
  (if (is_empty ios)
      (rev acc)
      (dk_rows (tail ios) (add i 1) im
        (match (head ios)
          ((DkNoIo why) acc)
          ((DkIo d b) (cons (dk_side_row i (disk_name_of d) (disk_sectors d) im) acc))))))

; An MBR's partitions as GPT's, for the bar: each's type kept as
; dk_mbr_type has it, its UUID the one fs mounts it by, and no name.
(def dk_mbr_parts ((sig int) (ps (list MbrPart))) (list GptPart)
  (if (is_empty ps)
      (nil GptPart)
      (match (head ps)
        ((MbrPart k ty start count)
          (cons (GptPart (dk_mbr_type ty) (mbr_part_uuid sig k) start count "") (dk_mbr_parts sig (tail ps)))))))

; ---------------------------------------------------------------- reading

; What Disks asks for, a request at a time, never waited on
; (ui_win_ask): count sectors from sector of the disk, read into its
; buffer; a request of a volume's server, the volume and the body; or a
; request of the server registered as fs, its body.
(data DkAsk (DkAskDisk int int) (DkAskVolume (list int) (list int)) (DkAskFs (list int)))

; Where a read of the drive is, between a reply and the next ask: the
; GPT's header asked, sector 1; its entries asked, the header kept;
; sector 0 asked, for an MBR, there being no good GPT; a partition's
; first sector asked, with the table's scheme (dk_gpt, dk_mbr or 0),
; every partition, those after it still to read, and what the ones read
; hold, reversed; or that sector read, bs, and the volume on it asked
; how full it is.
(data DkRead (DkReadHeader) (DkReadEntries GptHeader) (DkReadMbr)
             (DkReadPart int (list GptPart) (list GptPart) (list DkContent))
             (DkReadDf int (list GptPart) (list GptPart) (list DkContent) bytes))

; What a read of the drive does next: ask, from where it then is; or
; nothing more, the drive read.
(data DkNext (DkNextAsk DkRead DkAsk) (DkNextDone DkDrive))

; A read of the drive begun: its GPT's header asked, sector 1.
(def dk_read_begin () DkNext (DkNextAsk (DkReadHeader) (DkAskDisk 1 1)))

; The read r of a drive of sectors sectors gone on from the disk's
; reply to the sectors it asked: why the read failed, empty if it did
; not, and bs the sectors as the buffer has them. A GPT not there, or
; bad, has the MBR read instead; a disk with neither, or a bad GPT, is
; all free space; a partition's first sector read says what it holds,
; and a volume's is asked how full it is.
(def dk_read_sectors ((r DkRead) (sectors int) (why (list int)) (bs bytes)) DkNext
  (match r
    ((DkReadHeader)
      (if (not (is_empty why))
          (dk_read_mbr)
          (match (gpt_header_of bs)
            ((GptNone) (dk_read_mbr))
            ((GptNotHeader w) (dk_read_mbr))
            ((GptHeader du at count ecrc)
              (DkNextAsk (DkReadEntries (GptHeader du at count ecrc)) (DkAskDisk at (gpt_entries_sectors count)))))))
    ((DkReadEntries h)
      (if (not (is_empty why))
          (dk_read_mbr)
          (match (gpt_disk_of h bs)
            ((GptBad w) (dk_read_mbr))
            ((GptGot t) (dk_read_parts (dk_gpt) (gpt_parts t) sectors)))))
    ((DkReadMbr)
      (if (not (is_empty why))
          (dk_read_parts 0 (nil GptPart) sectors)
          (match (mbr_of bs)
            ((MbrGot t) (dk_read_parts (dk_mbr) (dk_mbr_parts (mbr_sig t) (mbr_parts t)) sectors))
            ((MbrProtective) (dk_read_parts 0 (nil GptPart) sectors))
            ((MbrNone) (dk_read_parts 0 (nil GptPart) sectors)))))
    ((DkReadPart scheme parts left acc)
      (if (not (is_empty why))
          (dk_read_more scheme parts left (cons (DkUnknown why) acc) sectors)
          (let label (dk_label_of bs)
            (if (is_empty label)
                (dk_read_more scheme parts left (cons (dk_content_of bs (FsSpaceRefused -3)) acc) sectors)
                (DkNextAsk (DkReadDf scheme parts left acc bs)
                           (DkAskVolume (append "/Volumes/" label) (fs_df_body (append "/Volumes/" label))))))))
    ((DkReadDf scheme parts left acc bs0)
      (dk_read_more scheme parts left (cons (dk_content_of bs0 (FsSpaceRefused -5)) acc) sectors))))

; The read r gone on from the reply to a volume's df, space: what its
; partition holds, and the next asked. A read waiting for sectors, not
; a df, is begun again.
(def dk_read_space ((r DkRead) (sectors int) (space FsSpace)) DkNext
  (match r
    ((DkReadDf scheme parts left acc bs) (dk_read_more scheme parts left (cons (dk_content_of bs space) acc) sectors))
    ((DkReadHeader) (dk_read_begin))
    ((DkReadEntries h) (dk_read_begin))
    ((DkReadMbr) (dk_read_begin))
    ((DkReadPart scheme parts left acc) (dk_read_begin))))

; The MBR asked, sector 0, the GPT being none or bad.
(def dk_read_mbr () DkNext (DkNextAsk (DkReadMbr) (DkAskDisk 0 1)))

; The partitions parts of a table of scheme read in turn, the first's
; first sector asked; the drive at once, if there are none.
(def dk_read_parts ((scheme int) (parts (list GptPart)) (sectors int)) DkNext
  (dk_read_more scheme parts parts (nil DkContent) sectors))

; The first of left's first sector asked, after what the partitions
; before it hold, acc reversed; the drive, once none is left.
(def dk_read_more ((scheme int) (parts (list GptPart)) (left (list GptPart)) (acc (list DkContent)) (sectors int)) DkNext
  (if (is_empty left)
      (DkNextDone (DkDrive sectors scheme (dk_segments sectors parts (rev acc))))
      (DkNextAsk (DkReadPart scheme parts (tail left) acc) (DkAskDisk (gpt_part_start (head left)) 1))))

; ---------------------------------------------------------------- waiting

; What the window has asked and waits for, one request out at a time,
; each reply told from an older ask's by its tag: nothing; a read of the
; drive, where it is, the ask out, and what to say once it is read; a
; change asked of the file server; or a rescan asked of it, before the
; drive is read again, and what to say then.
(data DkWait (DkIdle) (DkReading int DkRead DkAsk DkAfter) (DkChanging int DkChange) (DkRescanning int DkAfter))

; What is said once the drive is read again: a line, and the partition
; to select by its UUID, if any; or what the rescan itself says.
(data DkAfter (DkAfterSay (list int) (list Uuid)) (DkAfterRescan))

; A change asked of the file server: a volume formatted, by its label;
; the drive given a new, empty GPT; a partition of so many sectors
; created; a volume made.
(data DkChange (DkChgFormat (list int)) (DkChgErase) (DkChgCreate int) (DkChgMkfs))

; What an action starts: nothing; the drive read; a rescan, then the
; read; or a change, its ask, then a rescan and the read.
(data DkStart (DkStartNone) (DkStartRead) (DkStartRescan) (DkStartChange DkChange DkAsk))

; Whether the window waits for a change or a rescan, during which no
; other drive is chosen and nothing else is started: a read in flight is
; let go for a newer one, its replies told by their tag.
(def dk_locked ((wait DkWait)) bool
  (match wait ((DkIdle) false) ((DkReading t r a after) false) ((DkChanging t c) true) ((DkRescanning t after) true)))

; What the window waits for, as the pane says it of the drive named
; name; empty for nothing.
(def dk_wait_text ((wait DkWait) (name (list int))) (list int)
  (match wait
    ((DkIdle) "")
    ((DkReading t r a after) (append "Reading " (append name "...")))
    ((DkChanging t c)
      (match c
        ((DkChgFormat label) (append "Formatting " (append label "...")))
        ((DkChgErase) "Formatting the disk...")
        ((DkChgCreate n) "Creating the partition...")
        ((DkChgMkfs) "Formatting the partition...")))
    ((DkRescanning t after) "Refreshing...")))

; The wait and the ask a start begins: the wait as it was and no ask
; for none.
(data DkStarted (DkStarted DkWait (list DkAsk)))

; What start begins, its chain tagged tag, in place of wait; nothing
; leaves wait as it is.
(def dk_started ((start DkStart) (wait DkWait) (tag int)) DkStarted
  (match start
    ((DkStartNone) (DkStarted wait (nil DkAsk)))
    ((DkStartRead)
      (match (dk_read_begin)
        ((DkNextAsk r a) (DkStarted (DkReading tag r a (DkAfterSay "" (nil Uuid))) (cons a (nil DkAsk))))
        ((DkNextDone d) (DkStarted wait (nil DkAsk)))))
    ((DkStartRescan) (DkStarted (DkRescanning tag (DkAfterRescan)) (cons (DkAskFs (fs_rescan_body)) (nil DkAsk))))
    ((DkStartChange c a) (DkStarted (DkChanging tag c) (cons a (nil DkAsk))))))

; The state, the wait and the ask to send after a reply.
(data DkReplied (DkReplied Disks DkWait (list DkAsk)))

; What the reply tagged tag, msg, does to the window of io, state m,
; waiting wait: a reply of an older ask, by its tag, nothing. The read
; goes on from it (dk_read_sectors, dk_read_space), the drive shown once
; it is read, with what there was to say; a change's reply says what it
; came to, and a rescan is asked; a rescan's reply, what it said, if
; nothing else is to be said, and the drive is read again.
(def dk_reply ((io DkIo) (m Disks) (wait DkWait) (tag int) (msg Message)) DkReplied
  (match wait
    ((DkIdle) (DkReplied m wait (nil DkAsk)))
    ((DkReading t r a after)
      (if (not (eq t tag))
          (DkReplied m wait (nil DkAsk))
          (match (dk_read_replied io r a msg)
            ((DkNextAsk r2 a2) (DkReplied m (DkReading t r2 a2 after) (cons a2 (nil DkAsk))))
            ((DkNextDone d) (DkReplied (dk_read_done m d after) (DkIdle) (nil DkAsk))))))
    ((DkChanging t c)
      (if (not (eq t tag))
          (DkReplied m wait (nil DkAsk))
          (DkReplied m (DkRescanning t (dk_change_said c (dk_fs_reply msg))) (cons (DkAskFs (fs_rescan_body)) (nil DkAsk)))))
    ((DkRescanning t after)
      (if (not (eq t tag))
          (DkReplied m wait (nil DkAsk))
          (let after2 (match after
                        ((DkAfterRescan) (DkAfterSay (dk_rescan_text (fs_rescan_of (dk_fs_reply msg))) (nil Uuid)))
                        ((DkAfterSay s us) after))
            (match (dk_read_begin)
              ((DkNextAsk r a) (DkReplied m (DkReading t r a after2) (cons a (nil DkAsk))))
              ((DkNextDone d) (DkReplied (dk_read_done m d after2) (DkIdle) (nil DkAsk)))))))))

; The read r gone on from the reply msg to its ask a: the sectors asked
; of the disk, as its buffer has them, or the df asked of a volume.
(def dk_read_replied ((io DkIo) (r DkRead) (a DkAsk) (msg Message)) DkNext
  (match a
    ((DkAskDisk sector count) (dk_read_sectors r (dk_io_sectors io) (disk_reply_why msg) (dk_io_bytes io count)))
    ((DkAskVolume vol body) (dk_read_space r (dk_io_sectors io) (fs_df_of (dk_fs_reply msg))))
    ((DkAskFs body) (dk_read_space r (dk_io_sectors io) (fs_df_of (dk_fs_reply msg))))))

; The first count sectors of io's buffer, as bytes; none with no disk.
(def dk_io_bytes ((io DkIo) (count int)) bytes
  (match io
    ((DkNoIo why) (bytes_from_list (nil int)))
    ((DkIo d b) (disk_get_bytes b (mul count (dk_sector))))))

; A file server's reply as a message: none, as to a request no server
; was there to take, is -3, no file server.
(def dk_fs_reply ((msg Message)) FsReply
  (match msg ((RecvFailed) (FsReply -3 (nil int))) ((Message from b) (fs_reply_of b))))

; The window's state once the drive is read again, d: its selection
; kept if the part is still there, the line saying what after says, and
; the partition after names selected, if it does.
(def dk_read_done ((m Disks) (d DkDrive) (after DkAfter)) Disks
  (match after
    ((DkAfterRescan) (dk_rescanned m d ""))
    ((DkAfterSay s us)
      (let m2 (dk_rescanned m d s)
        (if (is_empty us) m2 (dk_with_uuid m2 (head us)))))))

; What a change's reply, r, says of it, and the partition to select.
(def dk_change_said ((c DkChange) (r FsReply)) DkAfter
  (match c
    ((DkChgFormat label)
      (match r
        ((FsReply w rest)
          (DkAfterSay (if (eq w 0) (append "Formatted " label) (append "Could not format " (append label (append ": " (dk_why w rest))))) (nil Uuid)))))
    ((DkChgErase) (DkAfterSay (dk_erased_text (fs_erase_of r)) (nil Uuid)))
    ((DkChgCreate n)
      (match (fs_partition_of r)
        ((FsPartitioned u) (DkAfterSay (dk_created_text (FsPartitioned u) n) (cons u (nil Uuid))))
        ((FsPartitionRefused w why) (DkAfterSay (dk_created_text (FsPartitionRefused w why) n) (nil Uuid)))))
    ((DkChgMkfs) (DkAfterSay (dk_made_text (fs_mkfs_of r)) (nil Uuid)))))

; What a rescan came to, in words.
(def dk_rescan_text ((r FsRescan)) (list int)
  (match r
    ((FsRescanned labels) (append "Refreshed: " (append (digits (length labels)) (if (eq (length labels) 1) " volume" " volumes"))))
    ((FsRescanRefused code) (append "The disk was read again; the file server would not: " (dk_fs_why code)))))

; What formatting the drive came to, in words.
(def dk_erased_text ((done FsErase)) (list int)
  (match done
    ((FsErased) "Formatted the disk: a new GUID Partition Table, with no partitions")
    ((FsEraseRefused code why) (append "Could not format the disk: " (dk_why code why)))))

; What making a partition of n sectors came to, in words.
(def dk_created_text ((made FsPartition) (n int)) (list int)
  (match made
    ((FsPartitioned u) (append "Created a partition of " (format_size (dk_bytes n))))
    ((FsPartitionRefused code why) (append "Could not create the partition: " (dk_why code why)))))

; What making a volume came to, in words.
(def dk_made_text ((made FsMkfs)) (list int)
  (match made
    ((FsMade label) (append "New volume " (append label (append ", mounted at /Volumes/" label))))
    ((FsMkfsRefused code why) (append "Could not format the partition: " (dk_why code why)))))

; Why a file server refused: in its own words if it gave any.
(def dk_why ((code int) (why (list int))) (list int)
  (if (is_empty why) (dk_fs_why code) why))

; What a file server's code says.
(def dk_fs_why ((code int)) (list int)
  (if (eq code -4) "a file on it is open"
  (if (eq code -3) "no file server serves it"
  (append "error " (digits code)))))

; ---------------------------------------------------------------- changes

; The state after an action, and what it starts.
(data DkActed (DkActed Disks DkStart))

; A dialog's button: its change asked of the file server, the dialog
; closed, the drive read again once it is done; Enter in a dialog's
; entry is its button. The rest is dk_update.
(def dk_acted ((io DkIo) (m Disks) (action (list int)) (ev UiEvent)) DkActed
  (if (eq action "dialog.format")
      (dk_formatted m)
      (if (eq action "dialog.erase")
          (dk_erased io m)
          (if (any_eq action (cons "dialog.create" (cons (ui_entry_activate_action (dk_size_entry)) (nil (list int)))))
              (dk_created io m)
              (if (any_eq action (cons "dialog.mkfs" (cons (ui_entry_activate_action (dk_label_entry)) (nil (list int)))))
                  (dk_made io m)
                  (DkActed (dk_update m action ev) (DkStartNone)))))))

; m with its dialog closed.
(def dk_closed ((m Disks)) Disks
  (match m ((Disks d sel dlg st) (Disks d sel (DkNoDialog) st))))

; The dialog's volume formatted, asked of its server.
(def dk_formatted ((m Disks)) DkActed
  (match (dk_dialog m)
    ((DkConfirm label)
      (let vol (append "/Volumes/" label)
        (DkActed (dk_closed m) (DkStartChange (DkChgFormat label) (DkAskVolume vol (fs_format_body vol))))))
    ((DkNoDialog) (DkActed m (DkStartNone)))
    ((DkErase) (DkActed m (DkStartNone)))
    ((DkCreate start count t) (DkActed m (DkStartNone)))
    ((DkMkfs n u had t fat) (DkActed m (DkStartNone)))))

; The drive given a new, empty GPT by the file server, every volume on
; it unmounted first, if the dialog asked.
(def dk_erased ((io DkIo) (m Disks)) DkActed
  (match (dk_dialog m)
    ((DkErase) (DkActed (dk_closed m) (DkStartChange (DkChgErase) (DkAskFs (fs_erase_body (dk_io_name io))))))
    ((DkNoDialog) (DkActed m (DkStartNone)))
    ((DkConfirm label) (DkActed m (DkStartNone)))
    ((DkCreate start count t) (DkActed m (DkStartNone)))
    ((DkMkfs n u had t fat) (DkActed m (DkStartNone)))))

; The dialog's partition made by the file server, if its size fits; the
; new partition is selected once the disk is read again.
(def dk_created ((io DkIo) (m Disks)) DkActed
  (match (dk_dialog m)
    ((DkCreate start count t)
      (let n (dk_size_sectors (ui_entry_text t) count)
        (if (eq n 0)
            (DkActed m (DkStartNone))
            (DkActed (dk_closed m) (DkStartChange (DkChgCreate n) (DkAskFs (fs_partition_body (dk_io_name io) n start)))))))
    ((DkNoDialog) (DkActed m (DkStartNone)))
    ((DkErase) (DkActed m (DkStartNone)))
    ((DkConfirm label) (DkActed m (DkStartNone)))
    ((DkMkfs n u had t fat) (DkActed m (DkStartNone)))))

; The dialog's volume made by the file server, of the format its toggle
; chose, if its label is one.
(def dk_made ((io DkIo) (m Disks)) DkActed
  (match (dk_dialog m)
    ((DkMkfs n u had t fat)
      (let label (ui_entry_text t)
        (if (not (dk_label_fits label fat))
            (DkActed m (DkStartNone))
            (DkActed (dk_closed m) (DkStartChange (DkChgMkfs) (DkAskFs (fs_mkfs_body u label fat)))))))
    ((DkNoDialog) (DkActed m (DkStartNone)))
    ((DkErase) (DkActed m (DkStartNone)))
    ((DkConfirm label) (DkActed m (DkStartNone)))
    ((DkCreate start count t) (DkActed m (DkStartNone)))))

; ------------------------------------------------------------------- loop

; why said on standard error, and a failure.
(def dk_complain ((why (list int))) int (complain_as "disks" why))

; The window opened, a drive's full-color icon loaded, the disks found,
; and the window shown at once, the first drive being read, and served
; until it is closed.
(def disks () int
  (match (ui_open "Disks" 880 520)
    ((UiOpenFailed why) (dk_complain why))
    ((UiOpenedWin w)
      (let im (ui_images_load (cons "drive-harddisk" (nil (list int))) (ui_win_scale w))
        (let ios (dk_ios)
          (match (dk_fresh (head ios))
            ((DkFresh m start) (dk_begun w ios 0 m im (DkIdle) 1 start))))))))

; A drive's first state, and what it starts: a disk's, with no drive
; yet, its read; no disk's, saying why, nothing.
(data DkFresh (DkFresh Disks DkStart))

; The first state of io's drive, and what it starts.
(def dk_fresh ((io DkIo)) DkFresh
  (match io
    ((DkNoIo why) (DkFresh (dk_new (DkNoDrive why)) (DkStartNone)))
    ((DkIo d b) (DkFresh (dk_new (DkNoDrive "")) (DkStartRead)))))

; The window of m, drive i of ios, the drives' icons from im, what it
; waits for said as busy.
(def dk_view_in ((ios (list DkIo)) (i int) (m Disks) (im UiImages) (busy (list int))) UiWidget
  (dk_view_of m (dk_rows ios 0 im (nil UiSideRow)) (digits i) (dk_io_name (nth ios i)) busy))

; The window with asks sent, if there is one, to io's disk or the
; file server, tagged tag, its answer to come as UiReply tag
; (ui_win_ask); one that cannot be sent is answered at once, as failed.
(def dk_asked ((w UiWin) (io DkIo) (asks (list DkAsk)) (tag int)) UiWin
  (if (is_empty asks)
      w
      (match (head asks)
        ((DkAskDisk sector count)
          (match io
            ((DkNoIo why) (ui_win_ask w tag 0 ""))
            ((DkIo d b) (ui_win_ask w tag (disk_port d) (disk_read_body d b sector count)))))
        ((DkAskVolume vol body) (ui_win_ask w tag (fs_port_of vol) body))
        ((DkAskFs body) (ui_win_ask w tag (fs_main_port) body)))))

; The window presented showing m, and served on, after start: nothing
; started, as it waits; else the start's first ask sent, tagged n, a
; tag of its own, and the wait made the start's.
(def dk_begun ((w UiWin) (ios (list DkIo)) (i int) (m Disks) (im UiImages) (wait DkWait) (n int) (start DkStart)) int
  (match (dk_started start wait n)
    ((DkStarted wait2 asks)
      (dk_loop (ui_present (dk_asked w (nth ios i) asks n) (dk_view_in ios i m im (dk_wait_text wait2 (dk_io_name (nth ios i)))))
               ios i m im wait2 (if (is_empty asks) n (add n 1))))))

; Each event routed, the state changed, and the window repainted: ios
; the drives, i the one shown, m its state, im the icons, wait what the
; window waits for, and n the next ask's tag. A reply goes on with what
; is waited for (dk_reply), its next ask sent under the same tag.
(def dk_loop ((w0 UiWin) (ios (list DkIo)) (i int) (m Disks) (im UiImages) (wait DkWait) (n int)) int
  (match (ui_win_next w0)
    ((UiWinNext w ev)
      (if (ui_event_lost ev)
        (dk_complain "lost its port")
        (match (ui_reply_of ev)
          ((UiReplyTo tag msg)
            (match (dk_reply (nth ios i) m wait tag msg)
              ((DkReplied m2 wait2 asks)
                (dk_loop (ui_present (dk_asked w (nth ios i) asks tag) (dk_view_in ios i m2 im (dk_wait_text wait2 (dk_io_name (nth ios i)))))
                         ios i m2 im wait2 n))))
          ((UiNoReply)
            (match (ui_route w ev)
              ((UiRouted w2 action)
                (match (dk_stepped ios i m action ev (dk_locked wait))
                  ((DkStepped ios2 i2 m2 start)
                    (dk_begun (dk_focused w2 m m2) ios2 i2 m2 im wait n start)))))))))))

; The drives, the one shown, its state, and what starts, after an
; action.
(data DkStepped (DkStepped (list DkIo) int Disks DkStart))

; An action: a drive chosen in the sidebar, to be read, unless the
; window is locked waiting for a change; Refresh, which takes on any disk
; registered since too, then has the file server rescan; else the shown
; drive's, dk_acted; locked, only dk_update's.
(def dk_stepped ((ios (list DkIo)) (i int) (m Disks) (action (list int)) (ev UiEvent) (locked bool)) DkStepped
  (let sk (ui_select_key (dk_side) action)
    (if (not (is_empty sk))
        (let j (int_prefix sk 0)
          (if (if (eq j i) true (if (ge j (length ios)) true locked))
              (DkStepped ios i m (DkStartNone))
              (match (dk_fresh (nth ios j)) ((DkFresh m2 start) (DkStepped ios j m2 start)))))
        (if locked
            (DkStepped ios i (dk_update m action ev) (DkStartNone))
            (if (eq action "app.refresh")
                (DkStepped (dk_ios_more ios (disk_names)) i m (DkStartRescan))
                (match (dk_acted (nth ios i) m action ev)
                  ((DkActed m2 start) (DkStepped ios i m2 start))))))))

; The window with the focus on the entry of a dialog that has just
; opened, so that typing goes to it at once; else as it was.
(def dk_focused ((w UiWin) (m Disks) (m2 Disks)) UiWin
  (let e (dk_dialog_entry (dk_dialog m2))
    (if (if (is_empty e) true (eq (dk_dialog_entry (dk_dialog m)) e)) w (ui_win_focusing w e))))
