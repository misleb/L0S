; The demo's disk, as tools/mkdisk makes it: 2048 sectors, a GPT, data
; at 40 for 1496, scratch at 1536 for 479, to the last usable sector;
; data mounted with 190 clusters, 160 of them free, and 2 files; scratch
; not mounted.
(def demo_parts () (list GptPart)
  (cons (gp 1 40 1496 "data") (cons (gp 2 1536 479 "scratch") (nil GptPart))))

; A partition of L0FS's type from start, of count sectors, its UUID of
; version 7 the same each run.
(def gp ((n int) (start int) (count int) (name (list int))) GptPart
  (GptPart (gpt_l0fs_type) (uuid_v7 1760000000000 (uuid_noise n 10)) start count name))

(def demo_contents () (list DkContent)
  (cons (DkVolume "data" 190 160 2 4096 false) (cons (DkUnmounted "scratch" false) (nil DkContent))))

(def demo_drive () DkDrive (DkDrive 2048 1 (dk_segments 2048 (demo_parts) (demo_contents))))

(def demo () Disks (dk_new (demo_drive)))

(def seg_text ((s DkSeg)) (list int)
  (match s
    ((DkFree start count) (append "free " (append (digits start) (append "+" (digits count)))))
    ((DkPart n start count ty c) (append (digits n) (append " " (append (digits start) (append "+" (digits count))))))))

(def segs_text ((ss (list DkSeg))) (list int)
  (if (is_empty ss) "" (append (seg_text (head ss)) (append ", " (segs_text (tail ss))))))

; ----------------------------------------------------------------- parts

; Sectors 0 to 33 are the table; 34 to 39 are no partition's; the last
; 33, the backup, are not shown.
(def test_demo_segments () int
  (check_str "the gap, then the two" (segs_text (dk_segments 2048 (demo_parts) (demo_contents)))
             "free 34+6, 1 40+1496, 2 1536+479, "))

; Out of order in the table, with room between and after them, to the
; last usable sector of 1000, 966.
(def test_gaps () int
  (check_str "sorted, with every gap"
    (segs_text (dk_segments 1000 (cons (gp 1 500 100 "a") (cons (gp 2 34 66 "b") (nil GptPart))) (nil DkContent)))
    "2 34+66, free 100+400, 1 500+100, free 600+367, "))

(def test_empty_disk () int
  (check_str "all free" (segs_text (dk_segments 2048 (nil GptPart) (nil DkContent))) "free 34+1981, "))

(def test_keys () int
  (add (check_str "a partition" (dk_key (DkPart 2 1536 479 (gp 2 1536 479 "s") (DkUnmounted "s" false))) "2")
       (check_str "free space" (dk_key (DkFree 34 6)) "free.34")))

; A sector that is no volume's.
(def test_content_unknown () int
  (match (dk_content_of (bytes_from_list (zeros 512)) (FsSpaceRefused -3))
    ((DkUnknown why) (pass "unknown"))
    ((DkVolume l a b c cb fat) (fail_because "zeros" "a volume"))
    ((DkUnmounted l fat) (fail_because "zeros" "a volume"))))

(def test_content_volume () int
  (add (match (dk_content_of (bytes_from_list (vol_super "data" (vol_layout 1528))) (FsSpace 1528 190 160 2))
         ((DkVolume l a b c cb fat) (check_str "mounted" l "data"))
         ((DkUnmounted l fat) (fail_because "data" "not mounted"))
         ((DkUnknown why) (fail_because "data" why)))
       (match (dk_content_of (bytes_from_list (vol_super "scratch" (vol_layout 512))) (FsSpaceRefused -3))
         ((DkUnmounted l fat) (check_str "not mounted" l "scratch"))
         ((DkVolume l a b c cb fat) (fail_because "scratch" "mounted"))
         ((DkUnknown why) (fail_because "scratch" why)))))

; ------------------------------------------------------------------ text

(def test_size_long () int
  (add (check_str "grouped" (dk_size_long 1048576) "1.0 MB (1,048,576 bytes)")
       (add (check_str "zeros kept" (dk_size_long 1002003) "1.0 MB (1,002,003 bytes)")
            (check_str "small" (dk_size_long 512) "512 bytes"))))

(def test_titles () int
  (add (check_str "a volume" (dk_seg_title (DkPart 1 40 1496 (gp 1 40 1496 "data") (DkVolume "data" 190 160 2 4096 false))) "data")
       (add (check_str "unknown" (dk_seg_title (DkPart 3 40 10 (gp 3 40 10 "") (DkUnknown "no"))) "Partition 3")
            (add (check_str "its line" (dk_seg_line (DkPart 1 40 1496 (gp 1 40 1496 "data") (DkVolume "data" 190 160 2 4096 false))) "766.0 kB L0FS")
                 (check_str "free" (dk_seg_line (DkFree 34 6)) "3.1 kB")))))

; L0FS's type by its name; any other's by its UUID.
(def test_types () int
  (add (check_str "L0FS's" (dk_type_text (gpt_l0fs_type)) "L0FS")
       (check_str "another" (dk_type_text (uuid_nil)) "00000000-0000-0000-0000-000000000000")))

; 30 clusters of 4096 used, 160 free.
(def test_usage () int
  (add (check_str "used, free" (dk_usage_text 190 160 4096) "122.9 kB used, 655.4 kB free")
       (add (check_int "percent" (dk_used_pct 190 160) 15)
            (add (check_int "a cluster shows" (dk_used_pct 190 189) 1)
                 (add (check_int "empty" (dk_used_pct 190 190) 0)
                      (check_int "none" (dk_used_pct 0 0) 0))))))

; ------------------------------------------------------------------ state

(def test_first_selected () int
  (add (check_str "the first volume, past the gap" (.selected (demo)) "1")
       (check_str "free space if that is all" (.selected (dk_new (DkDrive 2048 0 (dk_segments 2048 (nil GptPart) (nil DkContent))))) "free.34")))

(def none () UiEvent (UiLeave))

(def key ((code int)) UiEvent (UiKey (KeyEvent code 1 0 0)))

(def test_select () int
  (add (check_str "clicked" (.selected (dk_update (demo) "vols.select.2" (none))) "2")
       (add (check_str "left" (.selected (dk_update (demo) "" (key (ui_key_left)))) "free.34")
            (check_str "right" (.selected (dk_update (demo) "" (key (ui_key_right)))) "2"))))

(def entry_of ((t UiEntryText)) (list int)
  (append (.text t) (append "|" (digits (.cursor t)))))

(def dialog_of ((m Disks)) (list int)
  (match m
    ((Disks d sel dlg st)
      (match dlg
        ((DkNoDialog) "none")
        ((DkConfirm l) l)
        ((DkErase) "erase")
        ((DkCreate start count t) (append "create " (append (digits start) (append "+" (append (digits count) (append " " (entry_of t)))))))
        ((DkMkfs n u had t fat) (append (if fat "mkfs fat32 " "mkfs ") (append (digits n) (append " " (append had (append " " (entry_of t)))))))))))

(def test_format_dialog () int
  (let m (dk_update (demo) "app.format" (none))
    (add (check_str "asks of data" (dialog_of m) "data")
         (add (check_str "cancelled" (dialog_of (dk_update m "dialog.cancel" (none))) "none")
              (add (check_str "Esc" (dialog_of (dk_update m "" (key (ui_key_esc)))) "none")
                   (check_str "no moving along the bar under it" (.selected (dk_update m "" (key (ui_key_right)))) "1"))))))

; Format Disk... asks first, saying what is lost and what the drive gets,
; whatever part is selected; Cancel and Esc close it.
(def test_erase_dialog () int
  (let m (dk_update (demo) "app.erase" (none))
    (add (check_str "asks" (dialog_of m) "erase")
         (add (check_bool "says so" (has_text (texts (laid m)) "a new GUID Partition Table, with no partitions") true)
              (add (check_str "cancelled" (dialog_of (dk_update m "dialog.cancel" (none))) "none")
                   (check_str "Esc" (dialog_of (dk_update m "" (key (ui_key_esc)))) "none"))))))

; The drive's heading has the button; with no drive there is nothing to
; format.
(def test_erase_button () int
  (add (check_bool "shown" (has_text (texts (laid (demo))) "Format Disk...") true)
       (check_str "no drive" (dialog_of (dk_update (dk_new (DkNoDrive "none")) "app.erase" (none))) "none")))

; Only a mounted volume can be formatted.
(def test_formattable () int
  (add (check_str "data" (dk_formattable (demo)) "data")
       (add (check_str "scratch, not mounted" (dk_formattable (dk_update (demo) "vols.select.2" (none))) "")
            (add (check_str "free space" (dk_formattable (dk_update (demo) "vols.select.free.34" (none))) "")
                 (check_str "no dialog for it" (dialog_of (dk_update (dk_update (demo) "vols.select.2" (none)) "app.format" (none))) "none")))))

(def test_rescanned_keeps () int
  (add (check_str "still there" (.selected (dk_rescanned (dk_update (demo) "vols.select.2" (none)) (demo_drive) "ok")) "2")
       (check_str "gone: the first" (.selected (dk_rescanned (dk_update (demo) "vols.select.2" (none))
                                                              (DkDrive 2048 0 (dk_segments 2048 (nil GptPart) (nil DkContent))) "ok")) "free.34")))

; ------------------------------------------------------------------- view

; Every text painted.
(def texts ((ns (list UiNode))) (list int)
  (if (is_empty ns) "" (match (head ns) ((UiNode r ops a f) (append (op_texts ops) (texts (tail ns)))))))

(def op_texts ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPText r s a c f b sc) (append s "|"))
                ((UiPFill r c) "") ((UiPRound r rad c u) "") ((UiPIcon x y n c sc) "") ((UiPImage x y n d ts) ""))
              (op_texts (tail ops)))))

(def laid ((m Disks)) (list UiNode) (ui_layout_window (dk_view m) 880 520 (ui_state_new (UiLight))))

(def has_target ((ns (list UiNode)) (action (list int))) bool
  (if (is_empty ns) false (eq (.action (head ns)) action) true (has_target (tail ns) action)))

(def has_text ((s (list int)) (t (list int))) bool
  (if (is_empty s) false (starts_with s t) true (has_text (tail s) t)))

(def test_view_drive () int
  (let t (texts (laid (demo)))
    (add (check_bool "its title" (has_text t "1.0 MB Disk|") true)
         (add (check_bool "its size" (has_text t "1.0 MB (1,048,576 bytes)|") true)
              (check_bool "its table" (has_text t "Partitioning|GUID Partition Table|") true)))))

(def test_view_no_table () int
  (check_bool "none" (has_text (texts (laid (dk_new (DkDrive 2048 0 (dk_segments 2048 (nil GptPart) (nil DkContent))))))
                               "Partitioning|None|") true))

(def test_view_volume () int
  (let t (texts (laid (demo)))
    (add (check_bool "contents" (has_text t "L0FS version 2 - Mounted at /Volumes/data|") true)
         (add (check_bool "usage" (has_text t "122.9 kB used, 655.4 kB free|") true)
              (add (check_bool "type" (has_text t "Partition Type|L0FS|") true)
                   (add (check_bool "its UUID" (has_text t (append "Partition UUID|" (append (uuid_text (.uuid (gp 1 40 1496 "data"))) "|"))) true)
                        (check_bool "where" (has_text t "Sectors 40-1535|") true)))))))

(def test_view_targets () int
  (let ns (laid (demo))
    (add (check_bool "the drive" (has_target ns "side.select.0") true)
         (add (check_bool "each part" (has_target ns "vols.select.free.34") true)
              (add (check_bool "refresh" (has_target ns "app.refresh") true)
                   (check_bool "format, for data" (has_target ns "app.format") true))))))

(def test_view_format_insensitive () int
  (check_bool "not for free space" (has_target (laid (dk_update (demo) "vols.select.free.34" (none))) "app.format") false))

; One button under the bar, for what the selected part can have done.
(def test_view_act_button () int
  (add (check_bool "free space, create" (has_target (laid (dk_update (demo) "vols.select.free.34" (none))) "app.create") true)
       (add (check_bool "scratch, not served, format" (has_target (laid (dk_update (demo) "vols.select.2" (none))) "app.mkfs") true)
            (check_bool "data, mounted, no other" (has_target (laid (demo)) "app.mkfs") false))))

(def test_view_dialog () int
  (let ns (laid (dk_update (demo) "app.format" (none)))
    (add (check_bool "the dialog's button" (has_target ns "dialog.format") true)
         (add (check_bool "nothing beneath it" (has_target ns "app.refresh") false)
              (check_bool "what it asks" (has_text (texts ns) "Every file on data will be lost.|") true)))))

(def test_view_no_disk () int
  (check_bool "a status page" (has_text (texts (laid (dk_new (DkNoDrive "no disk; is virtio-blk running?")))) "No Disks|") true))

; ------------------------------------------------- partitions and volumes

; A disk as tests/disks-create.sh makes it: data at 40 for 1000, then 496
; sectors free from 1040, then scratch at 1536 for 479.
(def gapped () Disks
  (dk_new (DkDrive 2048 1 (dk_segments 2048 (cons (gp 1 40 1000 "data") (cons (gp 2 1536 479 "scratch") (nil GptPart)))
                                          (demo_contents)))))

(def creating () Disks (dk_update (dk_update (gapped) "vols.select.free.1040" (none)) "app.create" (none)))

(def keych ((code int) (ch int)) UiEvent (UiKey (KeyEvent code 1 ch 0)))

; 496 sectors are 253,952 bytes, 254.0 kB to the tenth.
(def test_create_dialog () int
  (add (check_str "all the free space" (dialog_of (creating)) "create 1040+496 254.0|5")
       (check_str "its entry focused as it opens" (dk_dialog_entry (.dialog (creating))) "size.entry")))

(def test_create_not_on_a_volume () int
  (check_str "no dialog" (dialog_of (dk_update (gapped) "app.create" (none))) "none"))

(def test_create_typing () int
  (let m (dk_update (creating) "size.edit" (keych (ui_key_backspace) 8))
    (add (check_str "backspace" (dialog_of m) "create 1040+496 254.|4")
         (add (check_str "Home" (dialog_of (dk_update m "size.edit" (keych (ui_key_home) 0))) "create 1040+496 254.|0")
              (check_str "placed" (dialog_of (dk_update m "size.place.1" (UiPress 0 0 1))) "create 1040+496 254.|1")))))

; Keys in the dialog's entry move nothing along the bar, and Esc closes
; it.
(def test_create_keys () int
  (add (check_str "Left" (.selected (dk_update (creating) "size.edit" (keych (ui_key_left) 0))) "free.1040")
       (check_str "Esc" (dialog_of (dk_update (creating) "" (key (ui_key_esc)))) "none")))

; A size in kB, to the nearest sector of 512 bytes: 254.0 is 254,000
; bytes, 496.1 sectors, all of them; 127 is 248.0; 254.3 is 496.7, 497,
; one too many; 1.5 is 2.9, 3; 12.345 is 24.1, 24.
(def test_size_sectors () int
  (add (check_int "all" (dk_size_sectors "254.0" 496) 496)
       (add (check_int "half" (dk_size_sectors "127" 496) 248)
            (add (check_int "too big" (dk_size_sectors "254.3" 496) 0)
                 (add (check_int "a tenth" (dk_size_sectors "1.5" 496) 3)
                      (check_int "a thousandth" (dk_size_sectors "12.345" 496) 24))))))

(def test_size_not_sizes () int
  (add (check_int "none" (dk_size_sectors "0" 496) 0)
       (add (check_int "empty" (dk_size_sectors "" 496) 0)
            (add (check_int "words" (dk_size_sectors "12kB" 496) 0)
                 (add (check_int "four decimals" (dk_size_sectors "1.2345" 496) 0)
                      (add (check_int "a dot alone" (dk_size_sectors "1." 496) 0)
                           (check_int "no whole" (dk_size_sectors ".5" 496) 0)))))))

; 6 sectors are 3,072 bytes, 3.1 kB; the text always comes back to them.
(def test_kb_text () int
  (add (check_str "the gap before data" (dk_kb_text 6) "3.1")
       (add (check_int "back to 6" (dk_size_sectors (dk_kb_text 6) 6) 6)
            (check_int "back to 479" (dk_size_sectors (dk_kb_text 479) 479) 479))))

(def with_size ((s (list int))) Disks
  (match (creating) ((Disks d sel dlg st) (Disks d sel (DkCreate 1040 496 (ui_entry_new s)) st))))

; Half, 248 sectors, leaves 248, 126,976 bytes.
(def test_view_create () int
  (let t (texts (laid (with_size "127")))
    (add (check_bool "the free space" (has_text t "Free space: 254.0 kB|") true)
         (add (check_bool "the size typed" (has_text t "Size|127|kB|") true)
              (check_bool "what is left" (has_text t "Free Space Following|127.0 kB|") true)))))

(def test_view_create_insensitive () int
  (add (check_bool "a size that fits" (has_target (laid (with_size "127")) "dialog.create") true)
       (add (check_bool "one too big" (has_target (laid (with_size "300")) "dialog.create") false)
            (check_bool "the entry" (has_target (laid (with_size "300")) "size.entry") true))))

; scratch, partition 2, holds a volume fs does not serve.
(def mkfs_of ((m Disks)) Disks (dk_update (dk_update m "vols.select.2" (none)) "app.mkfs" (none)))

(def test_mkfs_dialog () int
  (add (check_str "the label it had" (dialog_of (mkfs_of (demo))) "mkfs 2 scratch scratch|7")
       (check_str "its entry focused as it opens" (dk_dialog_entry (.dialog (mkfs_of (demo)))) "label.entry")))

(def with_label ((had (list int)) (s (list int))) Disks
  (match (mkfs_of (demo)) ((Disks d sel dlg st) (Disks d sel (DkMkfs 2 (.uuid (gp 2 1536 479 "scratch")) had (ui_entry_new s) false) st))))

(def test_mkfs_typing () int
  (add (check_str "typed" (dialog_of (dk_update (with_label "" "mad") "label.edit" (keych 18 101))) "mkfs 2  made|4")
       (check_str "not past 15" (dialog_of (dk_update (with_label "" "abcdefghijklmno") "label.edit" (keych 45 120)))
                  "mkfs 2  abcdefghijklmno|15")))

(def test_view_mkfs () int
  (let t (texts (laid (with_label "scratch" "made")))
    (add (check_bool "the partition" (has_text t "Format Partition 2|") true)
         (add (check_bool "what is lost" (has_text t "Every file on scratch will be lost.|") true)
              (check_bool "where it goes" (has_text t "Mounted At|/Volumes/made|") true)))))

; The card as wide whatever is typed: "Volume Name", 5842 units of
; Source Sans 3, advances and kerning, 77.89 pixels, so 78; 12; then
; "/Volumes/", 4285 units, 58, and 15 of the face's widest, @, 847 units
; each, 170: 228; 24 either side: 366.
(def test_view_mkfs_width () int
  (add (check_int "empty" (.sw (ui_measure (dk_mkfs_alert 3 "" (ui_entry_new "") false))) 366)
       (check_int "the longest" (.sw (ui_measure (dk_mkfs_alert 3 "" (ui_entry_new "WWWWWWWWWWWWWWW") false))) 366)))

(def test_view_mkfs_insensitive () int
  (add (check_bool "a label" (has_target (laid (with_label "" "made")) "dialog.mkfs") true)
       (add (check_bool "none" (has_target (laid (with_label "" "")) "dialog.mkfs") false)
            (check_bool "not a label" (has_target (laid (with_label "" "a b")) "dialog.mkfs") false))))

; ------------------------------------------------------------------ FAT32

; The FAT32 toggle chosen, the label kept to its 11 letters.
(def test_mkfs_fat_toggle () int
  (let m (dk_update (with_label "" "abcdefghijk") "fmt.select.fat32" (none))
    (add (check_str "chosen" (dialog_of m) "mkfs fat32 2  abcdefghijk|11")
         (add (check_str "not past 11" (dialog_of (dk_update m "label.edit" (keych 45 120))) "mkfs fat32 2  abcdefghijk|11")
              (check_str "back to L0FS" (dialog_of (dk_update m "fmt.select.l0fs" (none))) "mkfs 2  abcdefghijk|11")))))

(def test_view_mkfs_fat () int
  (let t (texts (laid (dk_update (with_label "" "BOOT") "fmt.select.fat32" (none))))
    (add (check_bool "the toggles" (has_text t "L0FS|FAT32|") true)
         (check_bool "what it makes" (has_text t "A new, empty FAT32 volume, which a Raspberry Pi boots from.|") true))))

; A 12-letter label is no FAT32 volume's: Format is insensitive.
(def test_view_mkfs_fat_label () int
  (match (with_label "" "abcdefghijkl")
    ((Disks d sel dlg st)
      (check_bool "too long" (has_target (laid (Disks d sel (DkMkfs 2 (.uuid (gp 2 1536 479 "scratch")) "" (ui_entry_new "abcdefghijkl") true) st)) "dialog.mkfs") false))))

(def test_content_fat () int
  (match (dk_content_of (fat_boot_new (fat_layout 1048576 1) 2048 "bootfs") (FsSpace 1048576 130812 130000 3))
    ((DkVolume l a b c cb fat)
      (add (check_str "label" l "bootfs")
           (add (check_int "a cluster" cb 4096)
                (check_bool "FAT32" fat true))))
    ((DkUnmounted l fat) (fail_because "bootfs" "not mounted"))
    ((DkUnknown why) (fail_because "bootfs" why))))

(def test_content_fat_line () int
  (check_str "its line" (dk_seg_line (DkPart 1 2048 1048576 (gp 1 2048 1048576 "b") (DkUnmounted "bootfs" true))) "536.9 MB FAT32"))

(def test_types_fat () int
  (add (check_str "basic data" (dk_type_text (gpt_basic_type)) "Microsoft Basic Data")
       (add (check_str "EFI" (dk_type_text (gpt_esp_type)) "EFI System")
            (check_str "an MBR's" (dk_type_text (dk_mbr_type 12)) "FAT32 (0x0c)"))))

; An MBR's disk: its free space offers nothing; its mounted volume,
; Format Volume; a partition with no volume fs serves, as an ext4
; rootfs, Format..., by the UUID fs knows it by.
(def mbr_drive () Disks
  (dk_new (DkDrive 2048 2 (dk_segments 2048 (dk_mbr_parts 1 (cons (MbrPart 1 12 40 1000) (cons (MbrPart 2 12 1100 500) (nil MbrPart))))
                                       (cons (DkVolume "bootfs" 100 50 1 512 true) (cons (DkUnknown "no") (nil DkContent)))))))

(def test_mbr_acts () int
  (add (check_str "the volume" (dk_formattable (mbr_drive)) "bootfs")
       (add (check_bool "free space" (eq (dk_act (dk_update (mbr_drive) "vols.select.free.1040" (none))) (DkActNone)) true)
            (check_bool "unformatted" (eq (dk_act (dk_update (mbr_drive) "vols.select.2" (none))) (DkActMkfs 2 (mbr_part_uuid 1 2) "")) true))))

(def test_mbr_props () int
  (check_bool "partitioning" (has_text (texts (laid (mbr_drive))) "Master Boot Record|") true))

(def test_with_uuid () int
  (add (check_str "scratch's" (.selected (dk_with_uuid (gapped) (.uuid (gp 2 1536 479 "scratch")))) "2")
       (check_str "none has it: kept" (.selected (dk_with_uuid (gapped) (.uuid (gp 7 0 1 "x")))) "1")))

; A new partition, with nothing on it yet, is to be formatted.
(def test_new_partition_formats () int
  (let m (dk_new (DkDrive 2048 1 (dk_segments 2048 (cons (gp 1 40 1000 "data") (nil GptPart)) (cons (DkUnknown "no volume") (nil DkContent)))))
    (check_str "no label to keep" (dialog_of (dk_update m "app.mkfs" (none))) "mkfs 1  |0")))

(def test_created_text () int
  (add (check_str "made" (dk_created_text (FsPartitioned (.uuid (gp 3 1040 496 ""))) 496) "Created a partition of 254.0 kB")
       (add (check_str "in its words" (dk_created_text (FsPartitionRefused -6 "no room for it") 496) "Could not create the partition: no room for it")
            (check_str "by its code" (dk_created_text (FsPartitionRefused -4 "") 496) "Could not create the partition: a file on it is open"))))

(def test_made_text () int
  (add (check_str "made" (dk_made_text (FsMade "made")) "New volume made, mounted at /Volumes/made")
       (check_str "refused" (dk_made_text (FsMkfsRefused -4 "that label is served already")) "Could not format the partition: that label is served already")))

; A disk of 2048 sectors, disk0, with no buffer, to name requests of.
(def io0 () DkIo (DkIo (Disk "disk0" 7 8 9 2048) (NoDiskBuf "none")))

; What a start asks, as text.
(def start_text ((s DkStart)) (list int)
  (match s
    ((DkStartNone) "none")
    ((DkStartRead) "read")
    ((DkStartRescan) "rescan")
    ((DkStartChange c a) (append "change: " (ask_text a)))))

(def ask_text ((a DkAsk)) (list int)
  (match a
    ((DkAskDisk sector count) (append "disk " (append (digits sector) (append "+" (digits count)))))
    ((DkAskVolume vol body) (append "volume " (append vol (append ": " body))))
    ((DkAskFs body) (append "fs: " body))))

; Create asks fs for the partition, the dialog closed; one that does not
; fit is not asked at all, the dialog kept.
(def test_created_asks () int
  (match (dk_created (io0) (creating))
    ((DkActed m s)
      (add (check_str "closed" (dialog_of m) "none")
           (add (check_str "asked" (start_text s) "change: fs: partition disk0 496 1040")
                (match (dk_created (io0) (with_size "300"))
                  ((DkActed m2 s2) (add (check_str "too big, not asked" (dialog_of m2) "create 1040+496 300|3")
                                        (check_str "nothing" (start_text s2) "none")))))))))

; Format... asks fs for the volume, by the partition's UUID.
(def test_made_asks () int
  (match (dk_made (io0) (with_label "" "made"))
    ((DkActed m s)
      (add (check_str "closed" (dialog_of m) "none")
           (check_str "asked" (start_text s) (append "change: fs: mkfs " (append (uuid_text (.uuid (gp 2 1536 479 "scratch"))) " made")))))))

; Format Volume... asks the volume's own server; Format Disk... asks fs
; to erase the disk.
(def test_format_asks () int
  (add (match (dk_acted (io0) (dk_update (demo) "app.format" (none)) "dialog.format" (none))
         ((DkActed m s) (check_str "format" (start_text s) "change: volume /Volumes/data: format /Volumes/data")))
       (match (dk_acted (io0) (dk_update (demo) "app.erase" (none)) "dialog.erase" (none))
         ((DkActed m s) (check_str "erase" (start_text s) "change: fs: erase disk0")))))

; --------------------------------------------------------------- reading

; What a read does next, as text: its ask, or the drive's parts.
(def next_text ((n DkNext)) (list int)
  (match n
    ((DkNextAsk r a) (append "ask " (ask_text a)))
    ((DkNextDone d) (match d ((DkDrive s gpt segs) (append (digits gpt) (append ": " (segs_text segs)))) ((DkNoDrive why) why)))))

; A read begins with the GPT's header, sector 1.
(def test_read_begins () int
  (check_str "sector 1" (next_text (dk_read_begin)) "ask disk 1+1"))

; A sector that cannot be read: no GPT, so the MBR is asked; none
; either, so the disk is all free space, with no table.
(def test_read_no_table () int
  (match (dk_read_sectors (DkReadHeader) 2048 "past the end" (bytes_from_list (nil int)))
    ((DkNextAsk r a)
      (add (check_str "the MBR" (ask_text a) "disk 0+1")
           (check_str "all free" (next_text (dk_read_sectors r 2048 "past the end" (bytes_from_list (nil int)))) "0: free 34+1981, ")))
    ((DkNextDone d) (fail_because "the MBR" "done at once"))))

; The demo's GPT, as gpt.l0 writes it: its header at 1, its entries at 2.
(def gpt_piece ((sector int)) bytes
  (piece_of (gpt_pieces 2048 (GptDisk (uuid_v7 1760000000000 (uuid_noise 9 10)) (demo_parts))) sector))

(def piece_of ((ps (list GptPiece)) (sector int)) bytes
  (if (is_empty ps)
      (bytes_from_list (nil int))
      (match (head ps) ((GptPiece s b) (if (eq s sector) (bytes_from_list b) (piece_of (tail ps) sector))))))

; A whole read of the demo's disk, a reply at a time: the header read
; asks the entries, 32 sectors from 2; they ask data's first sector;
; its superblock asks df of /Volumes/data; the space asks scratch's
; first sector; its superblock asks its df; refused, the drive is read,
; the demo's.
(def test_read_gpt () int
  (match (dk_read_sectors (DkReadHeader) 2048 "" (gpt_piece 1))
    ((DkNextDone d) (fail_because "entries" "done at once"))
    ((DkNextAsk r1 a1)
      (add (check_str "the entries" (ask_text a1) "disk 2+32")
           (match (dk_read_sectors r1 2048 "" (gpt_piece 2))
             ((DkNextDone d) (fail_because "data" "done at once"))
             ((DkNextAsk r2 a2)
               (add (check_str "data's first sector" (ask_text a2) "disk 40+1")
                    (read_data r2))))))))

(def read_data ((r DkRead)) int
  (match (dk_read_sectors r 2048 "" (bytes_from_list (vol_super "data" (vol_layout 1496))))
    ((DkNextDone d) (fail_because "df" "done at once"))
    ((DkNextAsk r3 a3)
      (add (check_str "its df" (ask_text a3) "volume /Volumes/data: df /Volumes/data")
           (match (dk_read_space r3 2048 (FsSpace 1528 190 160 2))
             ((DkNextDone d) (fail_because "scratch" "done at once"))
             ((DkNextAsk r4 a4)
               (add (check_str "scratch's first sector" (ask_text a4) "disk 1536+1")
                    (read_scratch r4))))))))

(def read_scratch ((r DkRead)) int
  (match (dk_read_sectors r 2048 "" (bytes_from_list (vol_super "scratch" (vol_layout 479))))
    ((DkNextDone d) (fail_because "df" "done at once"))
    ((DkNextAsk r5 a5)
      (add (check_str "its df" (ask_text a5) "volume /Volumes/scratch: df /Volumes/scratch")
           (match (dk_read_space r5 2048 (FsSpaceRefused -3))
             ((DkNextAsk r6 a6) (fail_because "done" (ask_text a6)))
             ((DkNextDone d) (check_true "the demo's drive" (eq d (demo_drive)))))))))

; An MBR's sector: one partition of type 83 from 2048 for 1000, the
; disk's signature 7, 55 AA at its end.
(def mbr_sector () bytes
  (bytes_from_list
    (append (zeros 440) (append (u32_le 7) (append (zeros 2)
      (append (cons 0 (cons 0 (cons 0 (cons 0 (cons 131 (cons 0 (cons 0 (cons 0 (nil int)))))))))
        (append (u32_le 2048) (append (u32_le 1000) (append (zeros 48) (cons 85 (cons 170 (nil int))))))))))))

; With no GPT and an MBR: its partition's first sector is asked, and
; read as unknown, the drive has the MBR's table.
(def test_read_mbr () int
  (match (dk_read_sectors (DkReadMbr) 4096 "" (mbr_sector))
    ((DkNextDone d) (fail_because "the partition" "done at once"))
    ((DkNextAsk r a)
      (add (check_str "its first sector" (ask_text a) "disk 2048+1")
           (check_str "the table" (next_text (dk_read_sectors r 4096 "" (bytes_from_list (zeros 512)))) "2: free 34+2014, 1 2048+1000, free 3048+1015, ")))))

; --------------------------------------------------------------- waiting

; A start: the read's first ask, tagged; a rescan's; a change's; none
; leaves the wait as it is.
(def test_started () int
  (add (match (dk_started (DkStartRead) (DkIdle) 5)
         ((DkStarted w asks) (add (check_str "reads" (wait_text w) "reading 5") (check_str "sector 1" (asks_text asks) "disk 1+1"))))
       (add (match (dk_started (DkStartRescan) (DkIdle) 6)
              ((DkStarted w asks) (add (check_str "rescans" (wait_text w) "rescanning 6") (check_str "of fs" (asks_text asks) "fs: rescan"))))
            (match (dk_started (DkStartNone) (DkRescanning 6 (DkAfterRescan)) 7)
              ((DkStarted w asks) (add (check_str "as it was" (wait_text w) "rescanning 6") (check_str "nothing" (asks_text asks) "")))))))

(def wait_text ((w DkWait)) (list int)
  (match w
    ((DkIdle) "idle")
    ((DkReading t r a after) (append "reading " (digits t)))
    ((DkChanging t c) (append "changing " (digits t)))
    ((DkRescanning t after) (append "rescanning " (digits t)))))

(def asks_text ((asks (list DkAsk))) (list int)
  (if (is_empty asks) "" (ask_text (head asks))))

; A change's reply says what it came to, and a rescan is asked; the
; rescan's reply begins the read; with no disk, the read fails at once,
; and the drive is shown with the change's line.
(def test_reply_change () int
  (match (dk_reply (DkNoIo "none") (demo) (DkChanging 3 (DkChgFormat "data")) 3 (message_new 2 (fs_reply_bytes 0 "")))
    ((DkReplied m w asks)
      (add (check_str "rescans" (wait_text w) "rescanning 3")
           (add (check_str "of fs" (asks_text asks) "fs: rescan")
                (match (dk_reply (DkNoIo "none") m w 3 (message_new 2 (fs_reply_bytes 2 "data\nscratch\n")))
                  ((DkReplied m2 w2 asks2)
                    (add (check_str "reads" (wait_text w2) "reading 3")
                         (reply_read m2 w2)))))))))

(def reply_read ((m Disks) (w DkWait)) int
  (match (dk_reply (DkNoIo "none") m w 3 (RecvFailed))
    ((DkReplied m2 w2 asks)
      (add (check_str "the MBR" (asks_text asks) "disk 0+1")
           (match (dk_reply (DkNoIo "none") m2 w2 3 (RecvFailed))
             ((DkReplied m3 w3 asks3)
               (add (check_str "done" (wait_text w3) "idle")
                    (check_str "said" (match m3 ((Disks d sel dlg st) st)) "Formatted data"))))))))

; A reply of an older ask, by its tag, changes nothing.
(def test_reply_stale () int
  (match (dk_reply (DkNoIo "none") (demo) (DkRescanning 3 (DkAfterRescan)) 2 (message_new 2 (fs_reply_bytes 0 "")))
    ((DkReplied m w asks) (add (check_str "still" (wait_text w) "rescanning 3") (check_str "nothing asked" (asks_text asks) "")))))

; A refusal is said, in fs's words or by its code; a created partition
; is selected once read.
(def test_change_said () int
  (add (check_str "refused" (said_text (dk_change_said (DkChgFormat "data") (FsReply -4 ""))) "Could not format data: a file on it is open")
       (add (check_str "no server" (said_text (dk_change_said (DkChgCreate 496) (FsReply -3 ""))) "Could not create the partition: no file server serves it")
            (match (dk_change_said (DkChgCreate 496) (FsReply 0 (uuid_text (.uuid (gp 3 1040 496 "")))))
              ((DkAfterSay s us) (add (check_str "made" s "Created a partition of 254.0 kB") (check_int "to select" (length us) 1)))
              ((DkAfterRescan) (fail_because "made" "the rescan's"))))))

(def said_text ((a DkAfter)) (list int)
  (match a ((DkAfterSay s us) s) ((DkAfterRescan) "rescan")))

; What the window says it waits for; a change or a rescan locks it.
(def test_wait_text () int
  (add (check_str "reading" (dk_wait_text (DkReading 1 (DkReadHeader) (DkAskDisk 1 1) (DkAfterRescan)) "disk1") "Reading disk1...")
       (add (check_str "formatting" (dk_wait_text (DkChanging 1 (DkChgFormat "data")) "disk1") "Formatting data...")
            (add (check_str "nothing" (dk_wait_text (DkIdle) "disk1") "")
                 (add (check_bool "a read is not locked" (dk_locked (DkReading 1 (DkReadHeader) (DkAskDisk 1 1) (DkAfterRescan))) false)
                      (check_bool "a change is" (dk_locked (DkChanging 1 (DkChgErase))) true))))))

; While the window waits, Refresh and the part's button are no targets
; and the line says what for; with no drive yet, the page says it.
(def test_view_busy () int
  (let ns (ui_layout_window (dk_view_of (demo) (nil UiSideRow) "0" "disk0" "Reading disk0...") 880 520 (ui_state_new (UiLight)))
    (add (check_bool "no refresh" (has_target ns "app.refresh") false)
         (add (check_bool "no format" (has_target ns "app.format") false)
              (add (check_bool "says so" (has_text (texts ns) "Reading disk0...|") true)
                   (check_bool "no drive yet" (has_text (texts (ui_layout_window (dk_view_of (dk_new (DkNoDrive "")) (nil UiSideRow) "0" "disk1" "Reading disk1...") 880 520 (ui_state_new (UiLight)))) "disk1|") true))))))

; A disk's first state has no drive yet and reads it; no disk's says
; why and reads nothing.
(def test_fresh () int
  (add (match (dk_fresh (io0)) ((DkFresh m s) (check_str "reads" (start_text s) "read")))
       (match (dk_fresh (DkNoIo "no disk")) ((DkFresh m s) (add (check_str "nothing" (start_text s) "none") (check_bool "why" (has_text (texts (laid m)) "no disk|") true))))))

; A drive chosen is read; locked, the window keeps the one shown.
(def test_choose_reads () int
  (add (match (dk_stepped (cons (DkNoIo "no disk") (cons (io0) (nil DkIo))) 0 (dk_new (demo_drive)) "side.select.1" (none) false)
         ((DkStepped ios i m s) (add (check_int "disk0" i 1) (check_str "read" (start_text s) "read"))))
       (match (dk_stepped (cons (DkNoIo "no disk") (cons (io0) (nil DkIo))) 0 (dk_new (demo_drive)) "side.select.1" (none) true)
         ((DkStepped ios i m s) (check_int "still 0" i 0)))))

; ----------------------------------------------------------------- drives

; A drive's row: its size, and the disk's name under it.
(def test_side_row () int
  (match (dk_side_row 1 "disk1" 2048 (ui_images_none))
    ((UiSideRow key icon title sub ts)
      (add (check_str "key" key "1") (add (check_str "title" title "1.0 MB Disk") (check_str "name" sub "disk1"))))))

; A drive's row carries the drive's full-color icon, if it was loaded,
; and else none, for the symbolic one.
(def test_side_row_image () int
  (let ts (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov))
    (add (match (dk_side_row 0 "disk0" 2048 (ui_images_with (ui_images_none) "drive-harddisk" ts))
           ((UiSideRow key icon title sub ts2) (check_true "image" (eq ts2 ts))))
         (match (dk_side_row 0 "disk0" 2048 (ui_images_none))
           ((UiSideRow key icon title sub ts2) (check_str "symbolic" icon "drive-harddisk"))))))

; A disk that could not be opened has no row.
(def test_rows_skip_none () int
  (check_int "none" (length (dk_rows (cons (DkNoIo "no disk") (nil DkIo)) 0 (ui_images_none) (nil UiSideRow))) 0))

; With no disks registered, as under l0 test, there are none more.
(def test_ios_more_none () int
  (check_int "the same" (length (dk_ios_more (cons (DkNoIo "no disk") (nil DkIo)) (disk_names))) 1))

; A drive chosen that there is not leaves the one shown.
(def test_choose_past () int
  (match (dk_stepped (cons (DkNoIo "no disk") (nil DkIo)) 0 (dk_new (demo_drive)) "side.select.3" (none) false)
    ((DkStepped ios i m s) (check_int "still 0" i 0))))

; The drive's name is its Device.
(def test_view_device () int
  (check_bool "disk0" (has_text (texts (laid (dk_new (demo_drive)))) "disk0") true))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (disks) 1))
