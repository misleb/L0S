; fontview.l0 -- Fonts, as GNOME's Fonts (gnome-font-viewer) is: every
; face the font service names, as a grid of cards, each its name and
; "Aa" in the face; a click on one opens it, its name, its file, and a
; pangram and the codes 32 to 126 at each of the heights it is shown at,
; 12 to 64, kerned as the interface's text is, with a back button in the
; header bar. The faces are asked of font (its faces request), so a font
; added to /etc/fonts shows here with no change; text in a face at a
; height of the program's own is the toolkit's UiFontAt, its strikes
; asked of font as each is first shown.
;
;   fontview       its window, until its close button is pressed

; The faces, the one open or "" for the grid, and the grid's state.
(data Fv (Fv (list (list int)) (list int) UiIconState))

; A view of faces, the grid shown.
(def fv_new ((faces (list (list int)))) Fv (Fv faces "" (ui_icon_state_new)))

; The face open, "" for none.
(def fv_open ((m Fv)) (list int) (match m ((Fv fs o is) o)))

; The heights a face is shown at, in the desktop's pixels.
(def fv_heights () (list int) (cons 12 (cons 16 (cons 24 (cons 32 (cons 48 (cons 64 (nil int))))))))

; The pangram each height shows: one whose m and i come early enough to
; be seen at 64 in Source Code Pro, as a monospace's cells are wide.
(def fv_pangram () (list int) "Jackdaws love my big sphinx of quartz")

; The codes 32 to 126, as text.
(def fv_codes () (list int) (fv_codes_from 126 (nil int)))

; fv_codes's loop: codes down from c onto acc.
(def fv_codes_from ((c int) (acc (list int))) (list int)
  (if (lt c 32) acc (fv_codes_from (sub c 1) (cons c acc))))

; The name a face is shown by: its family's and weight's, for the faces
; L0S comes with; any other by the name font gives it.
(def fv_title ((face (list int))) (list int)
  (if (eq face "code") "Source Code Pro"
  (if (eq face "code-bold") "Source Code Pro Bold"
  (if (eq face "sans") "Source Sans 3"
  (if (eq face "sans-bold") "Source Sans 3 Bold"
      face)))))

; Where the face's file is: the one the font protocol names for it, or
; /etc/fonts for one it does not know.
(def fv_file ((face (list int))) (list int)
  (let p (font_file face) (if (is_empty p) (font_dir) p)))

; ----------------------------------------------------------------- the view

; The grid's prefix, and the window's width and height.
(def fv_grid () (list int) "faces")
(def fv_w () int 860)
(def fv_h () int 680)

; How tall "Aa" is on a card, a tile's icon high.
(def fv_card_h () int (ui_tile_icon))

; A card: "Aa" in the face, in the middle of a tile's icon, in the text's
; color, and the face's name under it.
(def fv_card ((face (list int))) UiTile
  (UiTileDrawn face
    (cons (UiPText (Rect 0 0 (ui_tile_icon) (ui_tile_icon)) "Aa" (UiCenter) (ui_fg (ui_style)) (UiFontAt face (fv_card_h)) false 1) (nil UiPaint))
    (fv_title face)))

; Each face's card.
(def fv_cards ((faces (list (list int)))) (list UiTile)
  (if (is_empty faces) (nil UiTile) (cons (fv_card (head faces)) (fv_cards (tail faces)))))

; The window: the grid of cards under its header bar, or the face open.
(def fv_view ((m Fv)) UiWidget
  (match m
    ((Fv fs o is)
      (if (is_empty o)
          (UiBox (UiV) 0
            (cons (UiCsdBar (nil UiWidget) (UiLabel "Fonts" (UiHeading) (UiCenter)) (nil UiWidget) true)
                  (cons (UiExpand (UiIconView (UiIconData (fv_grid) (fv_cards fs) is))) (nil UiWidget))))
          (UiBox (UiV) 0
            (cons (UiCsdBar (cons (UiButton "app.back" "go-previous" "" (UiBtnFlat) true) (nil UiWidget))
                            (UiLabel (fv_title o) (UiHeading) (UiCenter)) (nil UiWidget) true)
                  (cons (UiExpand (UiView (UiPad (ui_space_l) (ui_space_m) (fv_face_page o)))) (nil UiWidget))))))))

; A face's page: its name, large, its file, a line, then at each height
; the pangram and the codes, each a line, cut short with "..." where it
; is wider than the window, as Fonts' previews are cut at its edge.
(def fv_face_page ((face (list int))) UiWidget
  (UiBox (UiV) (ui_space_s)
    (cons (UiLabel (fv_title face) (UiLarge) (UiStart))
    (cons (UiLabel (fv_file face) (UiDimmed) (UiStart))
    (cons (UiSeparator (UiH))
          (fv_samples face (fv_heights)))))))

; The samples at each of hs: the pangram, then the codes.
(def fv_samples ((face (list int)) (hs (list int))) (list UiWidget)
  (if (is_empty hs)
      (nil UiWidget)
      (let f (UiFontAt face (head hs))
        (cons (UiText (fv_pangram) f (UiStart))
              (cons (UiText (fv_codes) f (UiStart)) (fv_samples face (tail hs)))))))

; ------------------------------------------------------------------- update

; The state after action: a card's open; Back goes to the grid; the
; grid's own actions move its selection and scrolling.
(def fv_update ((m Fv) (action (list int))) Fv
  (match m
    ((Fv fs o is)
      (if (eq action "app.back")
          (Fv fs "" is)
          (let key (ui_select_key (fv_grid) action)
            (if (if (is_empty o) (not (is_empty key)) false)
                (Fv fs key (ui_icon_action is (fv_grid) action))
                (if (is_empty o) (Fv fs o (ui_icon_action is (fv_grid) action)) m)))))))

; ------------------------------------------------------------------- running

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "fontview" why))

; The faces font names, or why it does not.
(def fv_faces () (Result (list (list int)) (list int))
  (match (font_open (ui_font_wait_ns))
    ((NoFontPort why) ((Err (list (list int)) (list int)) why))
    ((FontPort port rp) (font_faces_of (font_ask (FontPort port rp) "faces")))))

; Its window, decorated by itself, served until its close button is
; pressed.
(def fontview () int
  (match (ui_open_csd "Fonts" (fv_w) (fv_h))
    ((UiOpenFailed why) (complain why))
    ((UiOpenedWin w)
      (match (fv_faces)
        ((Err why) (let c (ui_close w) (complain why)))
        ((Ok fs) (let m (fv_new fs) (fv_loop (ui_present w (fv_view m)) m)))))))

; The window's events, one at a time.
(def fv_loop ((w UiWin) (m Fv)) int
  (match (port_receive (ui_win_port w))
    ((RecvFailed) (complain "lost its port"))
    ((Message from b)
      (match (ui_route w (ui_event_of w (Message from b)))
        ((UiRouted w2 action)
          (if (eq action (ui_close_action))
              (ui_close w2)
              (let m2 (fv_update m action)
                (fv_loop (ui_present w2 (fv_view m2)) m2))))))))
