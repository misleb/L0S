; fontview_test.l0 -- tests of Fonts: its cards, its pages laid out, the
; codes cut into lines, and what its actions do.

(def four () (list (list int)) (split_spaces "code code-bold sans sans-bold"))

(def fv_rect ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; The actions of the nodes that have one, and where each is.
(def fv_targets ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns)
        ((UiNode r ops a f)
          (if (is_empty a) (fv_targets (tail ns)) (append a (append "@" (append (fv_rect r) (append " " (fv_targets (tail ns)))))))))))

; The texts of the nodes, each with its face's name and height, and where.
(def fv_texts ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      ""
      (match (head ns) ((UiNode r ops a f) (append (fv_op_texts ops) (fv_texts (tail ns)))))))

(def fv_op_texts ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPText r s a c f b sc)
                  (match f
                    ((UiFontAt n h) (append "[" (append (take s 6) (append "] " (append n (append " " (append (digits h) (append "@" (append (fv_rect r) " ")))))))))
                    ((UiMono) "") ((UiSans) "")))
                ((UiPFill r c) "") ((UiPRound r rd c u) "") ((UiPIcon x y n c sc) "") ((UiPImage x y n d ts) ""))
              (fv_op_texts (tail ops)))))

(def fv_laid ((m Fv)) (list UiNode) (ui_layout_window (fv_view m) (fv_w) (fv_h) (ui_state_new (UiDark))))

; The grid: a card a face, in the order font names them, each its key
; the face, its "Aa" in the face at a tile's icon's 48, and the face's
; name under it.
(def test_cards () int
  (let ts (fv_cards (four))
    (add (check_int "four" (length ts) 4)
         (add (check_str "keyed by the face" (ui_tile_key (head (tail ts))) "code-bold")
              (check_str "named" (ui_tile_label (nth_tile ts 2)) "Source Sans 3")))))

(def nth_tile ((ts (list UiTile)) (i int)) UiTile (if (eq i 0) (head ts) (nth_tile (tail ts) (sub i 1))))

; Laid out, the four cards are four targets in a row, and "Aa" each in
; its face at 48.
(def test_grid_laid () int
  (let ns (fv_laid (fv_new (four)))
    (add (check_true "a card" (contains (fv_targets ns) "faces.select.sans@"))
         (check_true "Aa in sans at 48" (contains (fv_texts ns) "[Aa] sans 48@")))))

; A face nobody named shows by the name font gives it.
(def test_title () int
  (add (check_str "known" (fv_title "code") "Source Code Pro")
       (check_str "another" (fv_title "serif") "serif")))

(def test_file () int
  (add (check_str "known" (fv_file "sans") "/etc/fonts/SourceSans3-Regular.ttf")
       (check_str "another" (fv_file "serif") "/etc/fonts/")))

; A click on a card opens its face; Back shows the grid again.
(def test_open_and_back () int
  (let m (fv_update (fv_new (four)) "faces.select.sans")
    (add (check_str "open" (.open m) "sans")
         (check_str "back" (.open (fv_update m "app.back")) ""))))

; An open face's page is not the grid: a card's action does nothing there.
(def test_open_ignores_grid () int
  (check_str "still sans" (.open (fv_update (fv_update (fv_new (four)) "faces.select.sans") "faces.select.code")) "sans"))

(def test_codes () int
  (add (check_int "95" (length (fv_codes)) 95)
       (check_str "from space" (take (fv_codes) 3) " !\"")))

; A face's page: its pangram and codes at each of the six heights, in
; the face, under its name, its file and a line: the window's 680 less
; its header bar's 46 and 12 above, so from 58, the name 32 high, then
; 6, the file 16, 6, the line, 6, the rows from 125, each its height
; and 6, so the pangram at 64 from 125 + 2 (12 + 16 + 24 + 32 + 48) + 60
; = 449, 18 in.
(def test_page () int
  (let t (fv_texts (fv_laid (fv_update (fv_new (four)) "faces.select.sans")))
    (add (check_true "at 12" (contains t "[Jackda] sans 12@18,125 824x12 "))
         (add (check_true "the codes at 12" (contains t "[ !\"#$%] sans 12@18,143 824x12 "))
              (check_true "at 64" (contains t "[Jackda] sans 64@18,449 824x64 "))))))

; All of it fits in the window: the codes at 64 end by its foot.
(def test_page_fits () int
  (check_true "at 64, by 680" (contains (fv_texts (fv_laid (fv_update (fv_new (four)) "faces.select.code"))) "[ !\"#$%] code 64@18,519 824x64 ")))

; The page's back button is a target in its header bar.
(def test_page_back () int
  (check_true "back" (contains (fv_targets (fv_laid (fv_update (fv_new (four)) "faces.select.code"))) "app.back@")))

; Under an operating system there is no compositor.
(def test_no_window () int
  (check_int "fails" (fontview) 1))
