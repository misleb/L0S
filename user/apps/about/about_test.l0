; about_test.l0 -- About's words.

(def test_cpu () int
  (add (check_str "aarch64" (about_cpu 1) "aarch64")
       (add (check_str "riscv64" (about_cpu 2) "riscv64")
            (check_str "under an operating system" (about_cpu 0) "unknown"))))

; 1000 of 4000 pages of 4096: 4.1 MB of 16.4 MB.
(def test_memory () int
  (add (check_str "given" (about_memory (Some (MemInfo 4000 1000))) "4.1 MB of 16.4 MB")
       (check_str "no kernel" (about_memory ((None MemInfo))) "unknown")))

; 3725 s is 1 h, 2 min, 5 s.
(def test_uptime () int
  (add (check_str "hms" (about_uptime 3725000000000) "1 h 2 min 5 s")
       (check_str "just booted" (about_uptime 0) "0 h 0 min 0 s")))

(def test_rows () int
  (check_int "four" (length (about_rows 1 ((None MemInfo)) 3 0)) 4))

; Under an operating system there is no window.
(def test_about_no_window () int (check_int "fails" (about) 1))
