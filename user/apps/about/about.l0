; about.l0 -- About L0S, the window the logo menu opens: what this machine
; is. Its name, the CPU it runs on, the memory the kernel gives out, the
; processes there are, and how long it has been up.
;
;   about          its window, until its close button is pressed

; The CPU (machine) numbers, as the spec's section 6.13 says: 1 aarch64,
; 2 riscv64; and anything else, an operating system's.
(def about_cpu ((m int)) (list int)
  (if (eq m 1) "aarch64" (eq m 2) "riscv64" "unknown"))

; Memory as the kernel says it: the pages in all and those given out, in
; the words of format_size; or "unknown", with no kernel to say.
(def about_memory ((mi (Option MemInfo))) (list int)
  (match mi
    ((None) "unknown")
    ((Some m)
      (match m
        ((MemInfo total used)
          (append (format_size (mul used (page_bytes)))
            (append " of " (format_size (mul total (page_bytes))))))))))

; A page, 4096 bytes.
(def page_bytes () int 4096)

; A time since boot, in nanoseconds, as hours, minutes and seconds.
(def about_uptime ((ns int)) (list int)
  (let s (div ns 1000000000)
    (append (digits (div s 3600)) (append " h "
      (append (digits (mod (div s 60) 60)) (append " min "
        (append (digits (mod s 60)) " s")))))))

; The rows, name and value, as properties show them.
(def about_rows ((cpu int) (mi (Option MemInfo)) (procs int) (up int)) (list UiProp)
  (cons (UiProp "Architecture" (UiLabel (about_cpu cpu) (UiBody) (UiStart)))
  (cons (UiProp "Memory in use" (UiLabel (about_memory mi) (UiBody) (UiStart)))
  (cons (UiProp "Processes" (UiLabel (digits procs) (UiBody) (UiStart)))
  (cons (UiProp "Uptime" (UiLabel (about_uptime up) (UiBody) (UiStart))) (nil UiProp))))))

; How many processes live: every slot of the process table that holds
; one not yet exited.
(def about_procs () int (about_count 1 0))

; about_procs's loop: n more from slot i on.
(def about_count ((i int) (n int)) int
  (if (gt i (max_procs))
      n
      (about_count (add i 1)
        (match (proc_slot i)
          ((SlotHeld pid) (match (proc_info pid) ((Some info) (add n 1)) ((None) n)))
          ((SlotUnused) n)
          ((NoSlot) n)))))

; The window's page: the name, a line under it, and the rows.
(def about_view ((cpu int) (mi (Option MemInfo)) (procs int) (up int)) UiWidget
  (UiPad (ui_space_l) (ui_space_l)
    (UiBox (UiV) (ui_space_m)
      (cons (UiLabel "L0S" (UiLarge) (UiStart))
      (cons (UiLabel "A microkernel and its programs, in L0" (UiDimmed) (UiStart))
      (cons (UiSeparator (UiH))
      (cons (UiProps (about_rows cpu mi procs up)) (nil UiWidget))))))))

; The page for the machine now.
(def about_now () UiWidget
  (about_view (machine) (mem_info) (about_procs) (clock_ns)))

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "about" why))

; Its window, shown again on every event, until it is closed.
(def about () int
  (match (ui_open "About L0S" 420 260)
    ((UiOpenFailed why) (complain why))
    ((UiOpenedWin w) (about_loop (ui_present w (about_now))))))

; The window's events, one at a time.
(def about_loop ((w0 UiWin)) int
  (match (ui_win_next w0)
    ((UiWinNext w ev)
      (if (ui_event_lost ev)
          (complain "lost its port")
          (match (ui_route w ev)
            ((UiRouted w2 action) (about_loop (ui_present w2 (about_now)))))))))
