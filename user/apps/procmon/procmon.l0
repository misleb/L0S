; procmon.l0 -- a process monitor, in a window of the toolkit's
; (user/lib/ui): the system's processes, from the kernel's process table,
; in a data grid under a toolbar. Each row is a live process: its pid, its
; program's name, its state, as ps words it, split into the state and its
; detail, its % of one CPU since the grid was last read (over its life,
; the first time) and the CPU it is on or last ran on, its parent, its
; memory: its own pages, and those it shares or a device reaches, which
; other processes may map too, and the names it provides, those its ports
; are registered as. Under the grid, the memory processes are given: how
; much there is, how much is used, with a level bar, and how much is
; available; and under that each CPU's % busy since the last read, as a
; level bar, CPU 0's the kernel's, and the load averages.
;
; The grid is read again every second, and when Refresh is pressed. A
; column's title sorts by it, and again the other way; a press on a row,
; or the arrow keys, select one; the wheel, and the scrollbar's slider,
; scroll the rows when there are more than fit; End Process, red, is sensitive only
; then, and ends it, as sh's kill does, saying what came of it. A driver
; cannot be ended, and procmon does not end itself.
;
;   procmon          its window, until its close button is pressed

; The grid's state, the rows it shows, the line the toolbar shows, what
; the kernel last said of its memory, if it said anything, and what it
; last said of the CPUs.
(data Monitor (Monitor (grid UiGridState) (rows (list UiRow)) (status (list int)) (mem (Option MemInfo)) (cv CpuView)))

; What the kernel said of the CPUs when the grid was read, and the time
; before: each process's CPU time, and the CPUs' use then and before.
(data CpuView (CpuView CpuSeen (Option CpuUsage) (Option CpuUsage)))

; Nothing seen of the CPUs yet.
(def cpu_view_none () CpuView (CpuView (CpuSeen 0 ((MapEmpty int int))) ((None CpuUsage)) ((None CpuUsage))))

(def monitor_new ((rows (list UiRow)) (mem (Option MemInfo))) Monitor
  (Monitor (UiGridState 0 false "" 0 0) rows "Select a process" mem (cpu_view_none)))

(def monitor_prefix () (list int) "procs")

(def monitor_columns () (list UiColumn)
  (cons (UiColumn "PID" 70 (UiEnd) true)
  (cons (UiColumn "Name" 120 (UiStart) true)
  (cons (UiColumn "State" 120 (UiStart) true)
  (cons (UiColumn "% CPU" 70 (UiEnd) true)
  (cons (UiColumn "CPU" 50 (UiEnd) true)
  (cons (UiColumn "Parent" 70 (UiEnd) true)
  (cons (UiColumn "Memory" 100 (UiEnd) true)
  (cons (UiColumn "Shared" 100 (UiEnd) true)
  (cons (UiColumn "Provides" 120 (UiStart) true)
  (cons (UiColumn "Detail" 0 (UiStart) true) (nil UiColumn))))))))))))

; The window's size: the columns with 260 for the detail, and ten rows
; under the toolbar, with the memory's line and the CPUs' beneath them.
(def monitor_w () int 1080)
(def monitor_h () int 457)

; How often the grid is read again: the window's alarm rings that often.
(def refresh_ns () int 1000000000)

; -------------------------------------------------------------- the rows

; Running and ready green, waiting on another blue, sleeping gray, and a
; state procmon does not know amber.
(def state_tone ((st int)) UiTone
  (if (any_eq st (cons (state_running) (cons (state_ready) (nil int)))) (UiGood)
      (any_eq st (cons (state_receiving) (cons (state_receiving_set) (cons (state_waiting) (cons (state_writing) (cons (state_reading) (cons (state_filing) (nil int)))))))) (UiAccentTone)
      (any_eq st (cons (state_sleeping) (cons (state_exited) (nil int)))) (UiNeutral)
      (UiWarn)))

; The row of process pid, whose program is called name, using tenths of
; a percent of one CPU, on CPU cpu, and providing names, as serves_text
; says them.
(def proc_row ((pid int) (info ProcInfo) (name (list int)) (tenths int) (cpu int) (names (list int))) UiRow
  (match info
    ((ProcInfo st parent m detail own shared)
      (UiRow (digits pid)
        (cons (UiCellNum pid "")
        (cons (UiCellText name)
        (cons (UiCellStatus (state_tone st) (state_word st))
        (cons (UiCellNum (div tenths 10) "")
        (cons (UiCellText (cpu_text cpu))
        (cons (UiCellNum parent "")
        (cons (UiCellSize (mul own (page_size)))
        (cons (UiCellSize (mul shared (page_size)))
        (cons (UiCellText names)
        (cons (UiCellText (state_detail st detail)) (nil UiCell)))))))))))))))

; What a read of the table gives: the rows, and what was seen of the CPUs.
(data Read (Read (list UiRow) CpuView))

; Every live process's row, procs.l0's procs_live, in the table's order,
; its % CPU since before was seen; and what was seen now.
(def read_now ((before CpuView)) Read
  (match before
    ((CpuView seen was cur)
      (let (ps (procs_live)
            after (cpu_seen ps)
            rows (live_rows ps seen after (names_registered) (nil UiRow)))
        (Read rows (CpuView after cur (cpu_usage)))))))

; Every live process's row, nothing seen before.
(def rows_now () (list UiRow) (match (read_now (cpu_view_none)) ((Read rows cv) rows)))

; The rows of ps, after the reversed acc, each one's % CPU from before to
; after, and the names among names it provides.
(def live_rows ((ps (list ProcLive)) (before CpuSeen) (after CpuSeen) (names (list NameEntry)) (acc (list UiRow))) (list UiRow)
  (if (is_empty ps)
      (rev acc)
      (match (head ps)
        ((ProcLive pid info)
          (match (proc_cpu pid)
            ((None) (live_rows (tail ps) before after names (cons (proc_row pid info (program_name pid) 0 -1 (serves_text (names_of_pid names pid))) acc)))
            ((Some c)
              (match c
                ((ProcCpu t cpu age)
                  (live_rows (tail ps) before after names
                    (cons (proc_row pid info (program_name pid) (pid_tenths before after pid age) cpu (serves_text (names_of_pid names pid))) acc))))))))))

(def has_row ((rows (list UiRow)) (key (list int))) bool
  (if (is_empty rows) false (eq (.key (head rows)) key) true (has_row (tail rows) key)))

; The monitor showing rows, mem, and cv, and its selection kept only if
; its process is still among them.
(def monitor_rows ((m Monitor) (rows (list UiRow)) (mem (Option MemInfo)) (cv CpuView)) Monitor
  (match m
    ((Monitor gs old status was cv0)
      (match gs
        ((UiGridState col desc sel first left)
          (Monitor (UiGridState col desc (if (has_row rows sel) sel "") first left) rows status mem cv))))))

; The monitor with the table, the memory and the CPUs read again.
(def monitor_read ((m Monitor)) Monitor
  (match m
    ((Monitor gs rows status mem cv)
      (match (read_now cv)
        ((Read rows2 cv2) (monitor_rows (Monitor gs rows status mem cv) rows2 (mem_info) cv2))))))

; ---------------------------------------------------------------- memory

; How much of the memory is used, in percent, rounded down: none of no
; memory.
(def mem_percent ((used int) (total int)) int
  (if (le total 0) 0 (div (mul used 100) total)))

; What the memory's line says of mem: how much there is, how much of it
; is used, and how much is available, as GNOME says sizes. The pages the
; kernel's page tables take are among the available, unseen.
(def mem_text ((mem (Option MemInfo))) (list int)
  (match mem
    ((None) "Memory not known")
    ((Some mi)
      (match mi
        ((MemInfo total used)
          (let avail (max 0 (sub total used))
            (append (format_size (mul used (page_size)))
            (append " used of "
            (append (format_size (mul total (page_size)))
            (append " (" (append (digits (mem_percent used total))
            (append "%), " (append (format_size (mul avail (page_size))) " available")))))))))))))

; How much of the memory is used, in percent, rounded up, so that any use
; at all shows on the level bar: a pool of about 1.9 GB has a desktop's
; few MB under 1%. None of no memory.
(def mem_percent_up ((used int) (total int)) int
  (if (le total 0) 0 (div (add (mul used 100) (sub total 1)) total)))

; How much of mem is used, in percent, for its level bar, rounded up: none
; if the kernel said nothing.
(def mem_used_percent ((mem (Option MemInfo))) int
  (match mem
    ((None) 0)
    ((Some mi) (match mi ((MemInfo total used) (mem_percent_up used total))))))

; The memory's line, under the grid: its title, a level bar of how much is
; used, and mem_text.
(def mem_line ((mem (Option MemInfo))) UiWidget
  (UiPad (ui_space_m) (ui_space_s)
    (UiBox (UiH) (ui_space_m)
      (cons (UiLabel "Memory" (UiHeading) (UiStart))
      (cons (UiLevel (mem_used_percent mem) 160)
      (cons (UiExpand (UiLabel (mem_text mem) (UiDimmed) (UiStart)))
            (nil UiWidget)))))))

; ------------------------------------------------------------------ CPUs

; Each CPU's % busy from a to b, in whole percent, rounded up so that any
; use shows: CPU 0's everything but its waiting, the kernel's and its
; turns running processes; the others' their processes'.
(def cpus_percent ((a CpuUsage) (b CpuUsage)) (list int)
  (match a
    ((CpuUsage up0 w0 x0 y0 z0 busy0)
      (match b
        ((CpuUsage up1 w1 x1 y1 z1 busy1)
          (let all (sub up1 up0)
            (cons (percent_up (sub all (sub w1 w0)) all)
                  (others_percent (drop busy0 1) (drop busy1 1) all (nil int)))))))))

; The CPUs' after the first, from their busy times before and after, onto
; the reversed acc.
(def others_percent ((before (list int)) (after (list int)) (all int) (acc (list int))) (list int)
  (if (is_empty after)
      (rev acc)
      (others_percent (drop before 1) (tail after) all
        (cons (percent_up (sub (head after) (nth_or before 0 0)) all) acc))))

; used of all in whole percent, rounded up, at most 100; 0 of nothing.
(def percent_up ((used int) (all int)) int
  (if (le all 0) 0 (min 100 (max 0 (div (add (mul used 100) (sub all 1)) all)))))

; What cv says of each CPU's % busy: since the read before, or since boot
; at the first read; none if the kernel said nothing.
(def cv_percents ((cv CpuView)) (list int)
  (match cv
    ((CpuView seen was cur)
      (match cur
        ((None) (nil int))
        ((Some b)
          (match was
            ((None) (cpus_percent (CpuUsage 0 0 0 0 0 (nil int)) b))
            ((Some a) (cpus_percent a b))))))))

; The load averages cv's last read says, as uptime does; empty if none.
(def cv_load ((cv CpuView)) (list int)
  (match cv
    ((CpuView seen was cur)
      (match cur
        ((None) "")
        ((Some b)
          (match b
            ((CpuUsage up waited l1 l5 l15 busy)
              (append "Load " (join_with ", " (cons (load_text l1) (cons (load_text l5) (cons (load_text l15) (nil (list int))))))))))))))

; The CPUs' line, under the memory's: its title, each CPU's name and a
; level bar of how busy it is, CPU 0 named the kernel's, and the load.
(def cpus_line ((cv CpuView)) UiWidget
  (UiPad (ui_space_m) (ui_space_s)
    (UiBox (UiH) (ui_space_m)
      (cons (UiLabel "CPUs" (UiHeading) (UiStart))
        (cpu_bars (cv_percents cv) 0 (cons (UiExpand (UiLabel (cv_load cv) (UiDimmed) (UiStart))) (nil UiWidget)))))))

; The labels and bars of the CPUs from i on, of their percents ps, before
; rest.
(def cpu_bars ((ps (list int)) (i int) (rest (list UiWidget))) (list UiWidget)
  (if (is_empty ps)
      rest
      (cons (UiLabel (cpu_name i) (UiDimmed) (UiStart))
        (cons (UiLevel (head ps) 80) (cpu_bars (tail ps) (add i 1) rest)))))

; CPU i's name on its bar: CPU 0 is the kernel's.
(def cpu_name ((i int)) (list int)
  (if (eq i 0) "0 (kernel)" (digits i)))

; --------------------------------------------------------- ending one

; What came of ending pid, as proc_kill answered r.
(def kill_text ((pid int) (r Kill)) (list int)
  (let p (digits pid)
    (match r
      ((Killed) (append "Ended process " p))
      ((KillDenied) (append "Process " (append p " is a driver, and cannot be ended")))
      ((KillNoProc) (append "No process " (append p ": it has exited"))))))

; Ends pid, unless it is me, and says what came of it.
(def end_text ((pid int) (me int)) (list int)
  (if (eq pid me)
      (append "Process " (append (digits pid) " is procmon itself"))
      (kill_text pid (proc_kill pid))))

; ------------------------------------------------------------------ view

(def monitor_view ((m Monitor)) UiWidget
  (match m
    ((Monitor gs rows status mem cv)
      (UiBox (UiV) 0
        (cons (UiExpand (ui_grid_page status (UiGridView (monitor_prefix) (monitor_columns) rows gs)))
        (cons (UiSeparator (UiH))
        (cons (mem_line mem)
        (cons (cpus_line cv) (nil UiWidget)))))))))

; ---------------------------------------------------------------- update

; The monitor after an action, or a key the grid takes, with the grid
; scrolled as sc says: Refresh reads the table again, and End Process
; ends the selected process and reads it. The grid's own actions select,
; sort, and scroll it.
(def monitor_update ((m Monitor) (action (list int)) (ev UiEvent) (sc UiScroller)) Monitor
  (match m
    ((Monitor gs rows status mem cv)
      (if (eq action "app.refresh")
          (match (read_now cv)
            ((Read now cv2)
              (monitor_rows (Monitor gs rows (append "Refreshed: " (append (digits (length now)) " processes")) mem cv) now (mem_info) cv2)))
          (eq action "app.end") (monitor_end m)
          (starts_with action (append (monitor_prefix) "."))
              (selected (Monitor (ui_grid_action gs (monitor_prefix) action) rows status mem cv))
          (monitor_key m ev sc)))))

(def monitor_end ((m Monitor)) Monitor
  (match m
    ((Monitor gs rows status mem cv)
      (if (is_empty (.selected gs))
          m
          (let said (end_text (int_prefix (.selected gs) 0) (l0s_pid))
            (monitor_read (Monitor gs rows said mem cv)))))))

(def monitor_key ((m Monitor) (ev UiEvent) (sc UiScroller)) Monitor
  (match m
    ((Monitor gs rows status mem cv)
      (let code (ui_key_pressed ev)
        (if (lt code 0)
            m
            (selected (Monitor (ui_grid_key (UiGridView (monitor_prefix) (monitor_columns) rows gs) code sc) rows status mem cv)))))))

; The monitor with its line saying what is selected, if anything is.
(def selected ((m Monitor)) Monitor
  (.status m (ui_selected_line (.grid m) (.status m))))

; ------------------------------------------------------------------ loop

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "procmon" why))

(def procmon () int
  (match (ui_open "Processes" (monitor_w) (monitor_h))
    ((UiOpenFailed why) (complain why))
    ((UiOpenedWin w)
      (let m (monitor_read (monitor_new (nil UiRow) ((None MemInfo))))
        (monitor_loop (ui_win_alarm (ui_present w (monitor_view m)) (add (clock_ns) (refresh_ns))) m)))))

; Each event answered as the toolkit's loop puts it together
; (ui_win_next), and the table read again when the window's alarm rings,
; every refresh_ns, the next alarm then asked: the loop waits for either,
; never polls.
(def monitor_loop ((w0 UiWin) (m Monitor)) int
  (match (ui_win_next w0)
    ((UiWinNext w ev)
      (if (ui_event_lost ev) (complain "lost its port")
          (ui_is_alarm ev)
              (let m2 (monitor_read m)
                (monitor_loop (ui_win_alarm (ui_present w (monitor_view m2)) (add (clock_ns) (refresh_ns))) m2))
          (match (ui_route w ev)
            ((UiRouted w2 action)
              (let m2 (monitor_update m action ev (ui_win_scroller w2 (monitor_prefix)))
                (monitor_loop (ui_present w2 (monitor_view m2)) m2))))))))
