(def none () UiEvent (UiOther 0 ""))

; The monitor after an action or event, before its window is laid out.
(def upd ((m Monitor) (action (list int)) (ev UiEvent)) Monitor (monitor_update m action ev (ui_no_scroller)))

(def status_of ((m Monitor)) (list int) (match m ((Monitor gs rows s mem) s)))
(def grid_of ((m Monitor)) UiGridState (match m ((Monitor gs rows s mem) gs)))
(def rows_of ((m Monitor)) (list UiRow) (match m ((Monitor gs rows s mem) rows)))
(def mem_of ((m Monitor)) (Option MemInfo) (match m ((Monitor gs rows s mem) mem)))

; A table as the demo's might be: the shell, two drivers, the
; compositor, and procmon, run from the shell, each with pages of its
; own, and the screen's driver and the compositor sharing a screen.
(def sample_rows () (list UiRow)
  (cons (proc_row 1 (ProcInfo (state_reading) 0 12 4 30 0) "sh")
  (cons (proc_row 2 (ProcInfo (state_receiving) 1 15 3 20 1) "uart")
  (cons (proc_row 3 (ProcInfo (state_receiving) 1 17 5 40 1000) "virtio-gpu")
  (cons (proc_row 6 (ProcInfo (state_receiving) 1 20 9 60 1000) "wm")
  (cons (proc_row 7 (ProcInfo (state_running) 1 11 0 50 0) "procmon") (nil UiRow)))))))

; 1,200 pages of the 98,304 used.
(def sample_mem () (Option MemInfo) (Some (MemInfo 98304 1200)))

(def sample () Monitor (monitor_new (sample_rows) (sample_mem)))

; A state's words are procs.l0's, tested there.
(def test_filing_tone () int
  (check_bool "blue" (eq (state_tone (state_filing)) (UiAccentTone)) true))

; Waiting on a set of ports is waiting on another, as on one port.
(def test_receiving_set_tone () int
  (check_bool "blue" (eq (state_tone (state_receiving_set)) (UiAccentTone)) true))

(def test_tones () int
  (add (check_bool "running" (eq (state_tone (state_running)) (UiGood)) true)
  (add (check_bool "receiving" (eq (state_tone (state_receiving)) (UiAccentTone)) true)
       (check_bool "unknown" (eq (state_tone 42) (UiWarn)) true))))

(def test_proc_row () int
  (match (proc_row 2 (ProcInfo (state_receiving) 1 15 3 20 1) "uart")
    ((UiRow key cells)
      (add (check_str "keyed by pid" key "2")
           (check_bool "cells" (eq cells (cons (UiCellNum 2 "")
                                         (cons (UiCellText "uart")
                                         (cons (UiCellStatus (UiAccentTone) "waiting")
                                         (cons (UiCellNum 1 "")
                                         (cons (UiCellSize 81920)
                                         (cons (UiCellSize 4096)
                                         (cons (UiCellText "for a message on port 3") (nil UiCell)))))))))
                       true)))))

; By its own memory, most first: wm's 60 pages, procmon's 50, virtio-gpu's 40.
(def test_sort_by_memory () int
  (let m (upd (upd (sample) "procs.sort.4" (none)) "procs.sort.4" (none))
    (check_str "most first" (unwords (keys_in (ui_grid_shown (rows_of m) (grid_of m)))) "6 7 3 1 2")))

(def keys_in ((rows (list UiRow))) (list (list int))
  (if (is_empty rows) (nil (list int)) (cons (ui_row_key (head rows)) (keys_in (tail rows)))))

; 1,200 pages are 4,915,200 bytes, 1% of 402,653,184, and 97,104 are
; left.
(def test_mem_text () int
  (add (check_str "used, of, available" (mem_text (sample_mem)) "4.9 MB used of 402.7 MB (1%), 397.7 MB available")
       (check_str "none" (mem_text ((None MemInfo))) "Memory not known")))

(def test_mem_percent () int
  (add (check_int "half" (mem_percent 49152 98304) 50)
       (add (check_int "rounded down" (mem_percent 1200 98304) 1)
            (check_int "no memory" (mem_percent 0 0) 0))))

; 3,840 pages, 15 MB, of 503,552, 1,967 MB, are 0.76%: 0 down, 1 up, so
; the bar shows them; a whole percent stays as it is.
(def test_mem_percent_up () int
  (add (check_int "under 1%" (mem_percent_up 3840 503552) 1)
       (add (check_int "half, exactly" (mem_percent_up 49152 98304) 50)
            (check_int "none used" (mem_percent_up 0 98304) 0))))

; The level bar's share of a pool of 1,967 MB with 15 MB used: 1, not 0.
(def test_mem_used_percent () int
  (add (check_int "rounded up" (mem_used_percent (Some (MemInfo 503552 3840))) 1)
       (check_int "not known" (mem_used_percent ((None MemInfo))) 0)))

; More used than the pool, as cannot be, leaves none available.
(def test_mem_text_over () int
  (check_str "none left" (mem_text (Some (MemInfo 10 12))) "49.2 kB used of 41.0 kB (120%), 0 bytes available"))

; Under an operating system there is no initramfs, and no process table.
(def test_no_kernel () int
  (add (check_str "no process" (program_name 3) "?")
  (add (check_str "no pid -1" (program_name -1) "?")
       (check_int "no rows" (length (rows_now)) 0))))

(def test_kill_text () int
  (add (check_str "ended" (kill_text 9 (Killed)) "Ended process 9")
  (add (check_str "driver" (kill_text 2 (KillDenied)) "Process 2 is a driver, and cannot be ended")
       (check_str "gone" (kill_text 9 (KillNoProc)) "No process 9: it has exited"))))

(def test_not_itself () int
  (check_str "refused" (end_text 7 7) "Process 7 is procmon itself"))

(def test_select_row () int
  (let m (upd (sample) "procs.select.6" (none))
    (add (check_str "selected" (ui_gs_selected (grid_of m)) "6")
         (check_str "said" (status_of m) "Process 6 selected"))))

(def test_selection_kept () int
  (let m (upd (sample) "procs.select.6" (none))
    (check_str "still there" (ui_gs_selected (grid_of (monitor_rows m (sample_rows) (sample_mem)))) "6")))

(def test_selection_dropped () int
  (let m (upd (sample) "procs.select.1" (none))
    (check_str "gone with its process" (ui_gs_selected (grid_of (monitor_rows m (tail (sample_rows)) (sample_mem)))) "")))

; Under an operating system the kernel answers no call: the end fails,
; and the table read again is empty.
(def test_end_process () int
  (let m (upd (upd(sample) "procs.select.6" (none)) "app.end" (none))
    (add (check_str "said, with no kernel to end it" (status_of m) "No process 6: it has exited")
         (check_str "selection gone" (ui_gs_selected (grid_of m)) ""))))

(def test_end_nothing () int
  (check_str "nothing selected, nothing said" (status_of (upd (sample) "app.end" (none))) "Select a process"))

(def test_refresh () int
  (let m (upd (sample) "app.refresh" (none))
    (add (check_str "counted" (status_of m) "Refreshed: 0 processes")
         (add (check_int "read again" (length (rows_of m)) 0)
              (check_str "the memory too, which no kernel tells" (mem_text (mem_of m)) "Memory not known")))))

(def test_sort () int
  (match (grid_of (upd (sample) "procs.sort.6" (none)))
    ((UiGridState col desc sel first) (add (check_int "by detail" col 6) (check_bool "ascending" desc false)))))

(def test_arrow_key () int
  (check_str "down from none, the first by pid"
    (ui_gs_selected (grid_of (upd (sample) "" (UiKey (KeyEvent (ui_key_down) 1 0)))))
    "1"))

; The wheel and the scrollbar scroll the grid by its own action, which
; window.l0 sets off; the wheel's event itself does nothing more.
(def test_scrolled () int
  (match (grid_of (upd (sample) "procs.scrollto.2" (UiScroll 10 100 0 1)))
    ((UiGridState col desc sel first) (check_int "the third row first" first 2))))

; Down from pid 6 to 7, the fifth row of five, with four shown from the
; first, as the window's scroller says: scrolled a row, so 7 shows.
(def test_key_scrolls () int
  (match (grid_of (monitor_update (upd (sample) "procs.select.6" (none)) "" (UiKey (KeyEvent (ui_key_down) 1 0)) (UiScroller 0 1 4)))
    ((UiGridState col desc sel first) (add (check_str "the last" sel "7") (check_int "scrolled a row" first 1)))))

(def has_target ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (if (eq (ui_node_action (head ns)) a) true (has_target (tail ns) a))))

(def laid ((m Monitor)) (list UiNode) (ui_layout_window (monitor_view m) (monitor_w) (monitor_h) (ui_state_new (UiLight))))

(def test_end_insensitive () int
  (add (check_bool "not without a selection" (has_target (laid (sample)) "app.end") false)
       (check_bool "with one" (has_target (laid (upd (sample) "procs.select.3" (none))) "app.end") true)))

; The rows' area, as its scroller names it: from 79, under the toolbar's
; 46, its line and the header's 32, and 321 high, ten rows of 30, above
; the memory's line, 29 with its own line: as tests/procmon.sh counts.
(def rows_area ((ns (list UiNode))) (list int)
  (if (is_empty ns)
      "none"
      (if (starts_with (ui_node_action (head ns)) "procs.scroll.")
          (match (ui_node_rect (head ns)) ((Rect x y w h) (unwords (numbers_words (cons x (cons y (cons w (cons h (nil int)))))))))
          (rows_area (tail ns)))))

(def test_rows_area () int
  (check_str "ten rows, the window's width" (rows_area (laid (sample))) "0 79 840 321"))

(def test_rows_shown () int
  (add (check_bool "the first" (has_target (laid (sample)) "procs.select.1") true)
       (check_bool "the last" (has_target (laid (sample)) "procs.select.7") true)))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (procmon) 1))
