(def none () UiEvent (UiOther 0 ""))

; The monitor after an action or event, before its window is laid out.
(def upd ((m Monitor) (action (list int)) (ev UiEvent)) Monitor (monitor_update m action ev (ui_no_scroller)))

(def status_of ((m Monitor)) (list int) (match m ((Monitor gs rows s) s)))
(def grid_of ((m Monitor)) UiGridState (match m ((Monitor gs rows s) gs)))
(def rows_of ((m Monitor)) (list UiRow) (match m ((Monitor gs rows s) rows)))

; A table as the demo's might be: the shell, two drivers, the
; compositor, and procmon, run from the shell.
(def sample_rows () (list UiRow)
  (cons (proc_row 1 (ProcInfo (state_reading) 0 12 4) "sh")
  (cons (proc_row 2 (ProcInfo (state_receiving) 1 15 3) "uart")
  (cons (proc_row 3 (ProcInfo (state_receiving) 1 17 5) "virtio-gpu")
  (cons (proc_row 6 (ProcInfo (state_receiving) 1 20 9) "wm")
  (cons (proc_row 7 (ProcInfo (state_running) 1 11 0) "procmon") (nil UiRow)))))))

(def sample () Monitor (monitor_new (sample_rows)))

; A state's words are procs.l0's, tested there.
(def test_filing_tone () int
  (check_bool "blue" (eq (state_tone (state_filing)) (UiAccentTone)) true))

(def test_tones () int
  (add (check_bool "running" (eq (state_tone (state_running)) (UiGood)) true)
  (add (check_bool "receiving" (eq (state_tone (state_receiving)) (UiAccentTone)) true)
       (check_bool "unknown" (eq (state_tone 42) (UiWarn)) true))))

(def test_proc_row () int
  (match (proc_row 2 (ProcInfo (state_receiving) 1 15 3) "uart")
    ((UiRow key cells)
      (add (check_str "keyed by pid" key "2")
           (check_bool "cells" (eq cells (cons (UiCellNum 2 "")
                                         (cons (UiCellText "uart")
                                         (cons (UiCellStatus (UiAccentTone) "waiting")
                                         (cons (UiCellNum 1 "")
                                         (cons (UiCellText "for a message on port 3") (nil UiCell)))))))
                       true)))))

; Under an operating system there is no initramfs, and no process table.
(def test_no_kernel () int
  (add (check_str "no entry" (program_name 3) "?")
  (add (check_str "no entry -1" (program_name -1) "?")
       (check_int "no rows" (length (rows_now)) 0))))

(def test_kill_text () int
  (add (check_str "ended" (kill_text 9 (Killed)) "Ended process 9")
  (add (check_str "driver" (kill_text 2 (KillDenied)) "Process 2 is a driver, and cannot be ended")
       (check_str "gone" (kill_text 9 (KillNoProc)) "No process 9: it has exited"))))

(def test_not_itself () int
  (check_str "refused" (end_text 7 7) "Process 7 is procmon itself"))

(def test_select_row () int
  (let m (upd (sample) "procs.select.6" (none))
    (add (check_str "selected" (ui_gs_selected (grid_of m)) "6")
         (check_str "said" (status_of m) "Process 6 selected"))))

(def test_selection_kept () int
  (let m (upd (sample) "procs.select.6" (none))
    (check_str "still there" (ui_gs_selected (grid_of (monitor_rows m (sample_rows)))) "6")))

(def test_selection_dropped () int
  (let m (upd (sample) "procs.select.1" (none))
    (check_str "gone with its process" (ui_gs_selected (grid_of (monitor_rows m (tail (sample_rows))))) "")))

; Under an operating system the kernel answers no call: the end fails,
; and the table read again is empty.
(def test_end_process () int
  (let m (upd (upd(sample) "procs.select.6" (none)) "app.end" (none))
    (add (check_str "said, with no kernel to end it" (status_of m) "No process 6: it has exited")
         (check_str "selection gone" (ui_gs_selected (grid_of m)) ""))))

(def test_end_nothing () int
  (check_str "nothing selected, nothing said" (status_of (upd (sample) "app.end" (none))) "Select a process"))

(def test_refresh () int
  (let m (upd (sample) "app.refresh" (none))
    (add (check_str "counted" (status_of m) "Refreshed: 0 processes")
         (check_int "read again" (length (rows_of m)) 0))))

(def test_sort () int
  (match (grid_of (upd (sample) "procs.sort.4" (none)))
    ((UiGridState col desc sel first) (add (check_int "by detail" col 4) (check_bool "ascending" desc false)))))

(def test_arrow_key () int
  (check_str "down from none, the first by pid"
    (ui_gs_selected (grid_of (upd (sample) "" (UiKey (KeyEvent (ui_key_down) 1 0)))))
    "1"))

; The wheel and the scrollbar scroll the grid by its own action, which
; window.l0 sets off; the wheel's event itself does nothing more.
(def test_scrolled () int
  (match (grid_of (upd (sample) "procs.scrollto.2" (UiScroll 10 100 0 1)))
    ((UiGridState col desc sel first) (check_int "the third row first" first 2))))

; Down from pid 6 to 7, the fifth row of five, with four shown from the
; first, as the window's scroller says: scrolled a row, so 7 shows.
(def test_key_scrolls () int
  (match (grid_of (monitor_update (upd (sample) "procs.select.6" (none)) "" (UiKey (KeyEvent (ui_key_down) 1 0)) (UiScroller 0 1 4)))
    ((UiGridState col desc sel first) (add (check_str "the last" sel "7") (check_int "scrolled a row" first 1)))))

(def has_target ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (if (eq (ui_node_action (head ns)) a) true (has_target (tail ns) a))))

(def laid ((m Monitor)) (list UiNode) (ui_layout_window (monitor_view m) 640 400 (ui_state_new (UiLight))))

(def test_end_insensitive () int
  (add (check_bool "not without a selection" (has_target (laid (sample)) "app.end") false)
       (check_bool "with one" (has_target (laid (upd (sample) "procs.select.3" (none))) "app.end") true)))

(def test_rows_shown () int
  (add (check_bool "the first" (has_target (laid (sample)) "procs.select.1") true)
       (check_bool "the last" (has_target (laid (sample)) "procs.select.7") true)))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (procmon) 1))
