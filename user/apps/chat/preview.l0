; preview.l0 -- Agent's scenes for make preview APP=chat: with no
; agentd, opening the conversation, a turn done with a line being
; typed, a turn running with a tool's row open, and a long transcript.
(def main () int
  (ui_preview (cons (UiShot "unlinked" 960 560 (chat_view (.link (chat_new) (Unlinked (no_agentd)))))
                    (cons (UiShot "opening" 960 560 (chat_view (chat_new)))
                          (cons (UiShot "talk" 960 560 (chat_view (talked)))
                                (cons (UiShot "running" 960 560 (chat_view (running)))
                                      (cons (UiShot "long" 960 560 (chat_view (long_talk)))
                                            (cons (UiShot "typing" 960 560 (chat_view (.entry (talked) (ui_entry_new (long_line)))))
                                                  (cons (UiShot "no-images" 960 560 (chat_view (.pane (talked) (pane_images))))
                                                        (cons (UiShot "images" 960 560 (chat_view (with_images (talked))))
                                                              (nil UiShot)))))))))))

; c on the Images pane, three images come, the newest read from To
; Do's own preview, as agentd would show a build's, and the others not
; yet read and not a PNG.
(def with_images ((c Chat)) Chat
  (let (path "/home/apps/todo/preview/tasks.png"
        c2 (shot_added (shot_added (shot_added (.pane c (pane_images)) "/home/notes.txt") "/home/apps/todo/preview/empty.png") path))
    (.shots c2 (shots_with (.shots (shots_with_why c2 "/home/notes.txt")) path (preview_pic) ""))))

; c with the text file refused, as png_read says of it.
(def shots_with_why ((c Chat) (path (list int))) Chat
  (.shots c (shots_with (.shots c) path ((None UiCov)) "Not an image shown here: not a PNG.")))

; To Do's tasks scene as the pane holds it: read from this build's
; previews, decoded and fitted as the app does; a plain one if it is not
; there.
(def preview_pic () (Option UiCov)
  (match (open_in "build/preview/todo/tasks.png")
    ((IoFailed e why) (Some (UiCov 1 1 (array_new 1 (ui_hex "ff3584e4")))))
    ((IoOpened f)
      (match (file_read_all f)
        ((IoReadFailed n) ((None UiCov)))
        ((IoBytes b)
          (match (png_read b)
            ((Ok img) (Some (pic_of (png_fit img (image_box_w) (image_box_h)))))
            ((Err why) ((None UiCov)))))))))

; A line typed long enough to wrap the entry onto a few rows.
(def long_line () (list int)
  "Now build me a clock app that shows the time in large digits, with the date under it, and a button that switches between twelve and twenty-four hour time, and keep it small enough to sit in a corner of the desktop.")

; No event: what the scenes' updates are set off with.
(def none () UiEvent (UiOther 0 ""))

; c with each of es heard, in order.
(def told ((c Chat) (es (list AgentEvent))) Chat
  (if (is_empty es) c (told (heard c (head es)) (tail es))))

; Linked, with one turn done: said, a tool run, and the answer.
(def talked () Chat
  (.entry (told (.link (chat_new) (Linked))
                (cons (AgentSaid "app" (bytes_from_list "What is in /etc?"))
                      (cons (AgentText (bytes_from_list "Let me look."))
                            (cons (AgentTool "list_dir" (bytes_from_list "{\"path\":\"/etc\"}"))
                                  (cons (AgentResult "list_dir" false (bytes_from_list "agent\nicons\nimages\ninittab"))
                                        (cons (AgentText (bytes_from_list "/etc holds four entries: agent, icons, images and inittab."))
                                              (cons (AgentDone "end_turn") (nil AgentEvent))))))))
          (UiEntryText "And what is in /etc/agent?" 26)))

; A second turn said through the entry, still running: text streaming
; and a build going, its row open on its progress.
(def running () Chat
  (let c (chat_update (.entry (talked) (UiEntryText "Build me a clock app" 20)) "app.send" (none))
    (chat_update (told c (cons (AgentSaid "app" (bytes_from_list "Build me a clock app"))
                               (cons (AgentText (bytes_from_list "I will build it now."))
                                     (cons (AgentTool "build_app" (bytes_from_list "{\"name\":\"clock\",\"title\":\"Clock\"}"))
                                           (cons (AgentProgress "build_app" (bytes_from_list "Bash l0s-app-build clock")) (nil AgentEvent))))))
                 "tools.tool.1" (none))))

; Many turns, some from elsewhere, a failed tool and an error, more than
; the panes hold, both following their ends.
(def long_talk () Chat
  (told (talked)
        (append (turns 6 (nil AgentEvent))
                (cons (AgentSaid "speech" (bytes_from_list "what time is it"))
                      (cons (AgentTool "run" (bytes_from_list "{\"cmd\":\"date\"}"))
                            (cons (AgentResult "run" true (bytes_from_list "no such program: date"))
                                  (cons (AgentError (bytes_from_list "The model is overloaded; try again in a minute."))
                                        (cons (AgentDone "end_turn") (nil AgentEvent)))))))))

; n turns, each said, a tool, and an answer of several long lines,
; onto acc.
(def turns ((n int) (acc (list AgentEvent))) (list AgentEvent)
  (if (le n 0)
      acc
      (turns (sub n 1)
             (cons (AgentSaid "app" (bytes_from_list (append "Tell me about part " (digits n))))
                   (cons (AgentTool "read_file" (bytes_from_list (append "{\"path\":\"/spec/part" (append (digits n) ".md\"}"))))
                         (cons (AgentResult "read_file" false (bytes_from_list "read 2048 bytes"))
                               (cons (AgentText (bytes_from_list "Part one of the answer runs long enough that it has to wrap across more than one row of the transcript's pane.\nAnd a second line after it."))
                                     (cons (AgentDone "end_turn") acc))))))))
