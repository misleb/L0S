; chat_test.l0 -- Agent's transcript and tools' log: notices heard into
; items, the paragraphs each pane shows, a tool's row opened, the
; answers to its asks, and when it may say.

(def bb ((s (list int))) bytes (bytes_from_list s))

; Each of es heard, in order.
(def heard_all ((c Chat) (es (list AgentEvent))) Chat
  (if (is_empty es) c (heard_all (heard c (head es)) (tail es))))

; Paragraphs as text: each its text, after > for an icon's, ! for an
; error's, ~ for a dimmed one, * for bold, [ for an incoming bubble and
; ] for an outgoing one, joined by |.
(def paras_text ((ps (list UiPara))) (list int)
  (if (is_empty ps)
      ""
      (let p (head ps)
        (append (append (if (is_empty (.icon p)) "" (append (.icon p) ">"))
                        (match (.kind p) ((UiLinePlain) "") ((UiLineStrong) "*") ((UiLineDim) "~") ((UiLineBad) "!") ((UiLineIncoming) "[") ((UiLineOutgoing) "]")))
                (append (.text p) (if (is_empty (tail ps)) "" (cons 124 (paras_text (tail ps)))))))))

; A turn told as agentd tells it: said, two pieces of text, a tool and
; its result, the rest of the text, and done.
(def a_turn () (list AgentEvent)
  (cons (AgentSaid "app" (bb "make a note"))
    (cons (AgentText (bb "Making"))
      (cons (AgentText (bb " it."))
        (cons (AgentTool "write_file" (bb "{\"path\":\"n\"}"))
          (cons (AgentResult "write_file" false (bb "wrote 3 bytes"))
            (cons (AgentText (bb "Done.\nIt is n."))
              (cons (AgentDone "end_turn") (nil AgentEvent)))))))))

; What was said is an outgoing bubble; the pieces join in an incoming
; one, the tool shows nothing but parts the text after it into a
; bubble of its own, its lines kept; the turn over.
(def test_turn () int
  (let c (heard_all (chat_new) (a_turn))
    (add (check_str "paras" (paras_text (chat_paras (.items c)))
           "]make a note|[Making it.|[Done.\nIt is n.")
         (check_bool "idle" (.busy c) false))))

; The log: what was said, dimmed, and the tool a closed row under it.
(def test_log () int
  (check_str "paras" (paras_text (log_paras (.log (heard_all (chat_new) (a_turn)))))
    "|~> make a note|go-next>~write_file  {\"path\":\"n\"}"))

; Tools show nothing in the conversation, only the text between them.
(def test_ran () int
  (let c (heard_all (chat_new) (cons (AgentTool "sh" (bb "{}")) (cons (AgentTool "run" (bb "{}")) (cons (AgentText (bb "So.")) (cons (AgentTool "time" (bb "{}")) (nil AgentEvent))))))
    (check_str "paras" (paras_text (chat_paras (.items c))) "[So.")))

; The model's text is a bubble without blank lines at its ends, and
; text of nothing but them is none.
(def test_text_trimmed () int
  (add (check_str "trimmed" (paras_text (chat_paras (.items (heard (chat_new) (AgentText (bb "\n\nHi.\n")))))) "[Hi.")
       (check_str "none" (paras_text (chat_paras (.items (heard (chat_new) (AgentText (bb "\n")))))) "")))

; Said from elsewhere, the transcript shows a bubble as for any; the
; log's line says where, and is its first line, cut.
(def test_said_from () int
  (let c (heard (chat_new) (AgentSaid "speech" (bb "what time is it\nnow")))
    (add (check_str "transcript" (paras_text (chat_paras (.items c))) "]what time is it\nnow")
         (check_str "log" (paras_text (log_paras (.log c))) "|~speech> what time is it..."))))

; Said begins a turn, which runs until done.
(def test_busy () int
  (add (check_bool "said" (.busy (heard (chat_new) (AgentSaid "app" (bb "hi")))) true)
       (check_bool "opened busy" (.busy (heard (chat_new) (AgentOpened true))) true)))

; Opened, the row shows its input and result; opened again, it closes.
(def test_tool_open () int
  (let (c (heard_all (chat_new) (a_turn))
        o (.log c (toggled (.log c) 0)))
    (add (check_str "open" (paras_text (log_paras (.log o)))
           "|~> make a note|pan-down>~write_file  {\"path\":\"n\"}|~Input:|~{\"path\":\"n\"}|~Result:|~wrote 3 bytes")
         (check_str "closed" (paras_text (log_paras (toggled (.log o) 0))) (paras_text (log_paras (.log c)))))))

; A failed run's row is red; one not ended yet says it runs.
(def test_tool_failed_running () int
  (let (f (heard_all (chat_new) (cons (AgentTool "run" (bb "{}")) (cons (AgentResult "run" true (bb "no x")) (nil AgentEvent))))
        r (heard (chat_new) (AgentTool "sh" (bb "{}"))))
    (add (check_str "failed" (paras_text (log_paras (.log f))) "go-next>!run failed  {}")
         (check_str "running" (paras_text (log_paras (toggled (.log r) 0))) "pan-down>~sh  {}|~Input:|~{}|~Running..."))))

; A build's progress shows in its open row, the latest line in place of
; Running..., and its result after it.
(def test_tool_progress () int
  (let (g (heard_all (chat_new) (cons (AgentTool "build_app" (bb "{}")) (cons (AgentProgress "build_app" (bb "Read widgets.l0")) (cons (AgentProgress "build_app" (bb "Bash l0s-app-build clock")) (nil AgentEvent)))))
        d (heard g (AgentResult "build_app" false (bb "built clock"))))
    (add (check_str "going" (paras_text (log_paras (toggled (.log g) 0))) "pan-down>~build_app  {}|~Input:|~{}|~Running:|~Bash l0s-app-build clock")
         (check_str "done" (paras_text (log_paras (toggled (.log d) 0))) "pan-down>~build_app  {}|~Input:|~{}|~Result:|~built clock"))))

; A result goes to the newest run of its tool that awaits one.
(def test_result_to_its_run () int
  (let c (heard_all (chat_new) (cons (AgentTool "sh" (bb "1")) (cons (AgentTool "run" (bb "2")) (cons (AgentResult "sh" true (bb "x")) (nil AgentEvent)))))
    (check_str "sh failed" (paras_text (log_paras (.log c))) "go-next>!sh failed  1|go-next>~run  2")))

; A long input is cut on its row.
(def test_tool_brief () int
  (let p (tool_row 0 "sh" (bytes_from_list (append (cons 34 (nil int)) (many 97 70 (nil int)))) ((None ToolEnd)) false)
    (check_int "cut" (length (.text p)) (add (length "sh  ") (add (input_brief) 3)))))

(def many ((c int) (n int) (acc (list int))) (list int) (if (le n 0) acc (many c (sub n 1) (cons c acc))))

; Errors red, a compaction and a stop dimmed notes.
(def test_notes () int
  (let c (heard_all (chat_new) (cons (AgentError (bb "Overloaded")) (cons (AgentCompacted 9 1) (cons (AgentDone "stopped") (nil AgentEvent)))))
    (check_str "notes" (paras_text (chat_paras (.items c))) "!Overloaded|~The conversation was compacted.|~Stopped.")))

; A reply message from agentd, pid 7.
(def reply ((s (list int))) Message (message_new 7 s))

; Open's ok links; its refusal says why; no answer at all unlinks.
(def test_answered_open () int
  (add (check_bool "ok" (match (.link (answered (chat_new) (tag_open) (reply "ok"))) ((Linked) true) ((Linking) false) ((Unlinked w) false)) true)
       (add (check_str "refused" (match (.link (answered (chat_new) (tag_open) (reply "error: no port 0"))) ((Unlinked w) w) ((Linked) "") ((Linking) "")) "no port 0")
            (check_bool "gone" (match (.link (answered (chat_new) (tag_say) (RecvFailed))) ((Unlinked w) true) ((Linked) false) ((Linking) false)) true))))

; A say refused, busy, ends the turn it would have begun, noted.
(def test_answered_busy () int
  (let c (answered (.busy (chat_new) true) (tag_say) (reply "error: busy"))
    (add (check_bool "idle" (.busy c) false)
         (check_str "noted" (paras_text (chat_paras (.items c))) "!busy"))))

; It may say only linked, idle, with words in the entry.
(def test_can_send () int
  (let c (.entry (.link (chat_new) (Linked)) (UiEntryText " hi " 4))
    (add (check_bool "yes" (can_send c) true)
         (add (check_bool "busy" (can_send (.busy c true)) false)
              (add (check_bool "blank" (can_send (.entry c (UiEntryText "  " 2))) false)
                   (check_str "trimmed" (said_text c) "hi"))))))

; ----------------------------------------------------------------- images

; Where reading the images is, as text.
(def fetch_text ((f Fetch)) (list int)
  (match f
    ((FetchNone) "none")
    ((FetchOpen p) (append "open " p))
    ((FetchRead p h ps n) (append "read " (append p (append " " (append (digits h) (append " " (digits n)))))))
    ((FetchDecode p b) (append "decode " (append p (cons 32 (bytes_to_list b)))))))

; The images as text, newest first: each path, then * once read, or why
; not.
(def shots_text ((ss (list Shot))) (list int)
  (if (is_empty ss)
      ""
      (let s (head ss)
        (append (.path s) (append (match (.pic s) ((Some p) "*") ((None) (if (is_empty (.why s)) "" (append ": " (.why s)))))
                                  (if (is_empty (tail ss)) "" (cons 124 (shots_text (tail ss)))))))))

; An image's notice shows it, newest; the same path again moves it to
; the front, to be read again.
(def test_image_heard () int
  (let c (heard_all (chat_new) (cons (AgentImage (bb "/a.png")) (cons (AgentImage (bb "/b.png")) (cons (AgentImage (bb "/a.png")) (nil AgentEvent)))))
    (add (check_str "order" (shots_text (.shots c)) "/a.png|/b.png")
         (check_str "shown" (.shown c) "/a.png"))))

; Older and newer move the one shown, and stop at either end.
(def test_image_moved () int
  (let c (heard_all (chat_new) (cons (AgentImage (bb "/a.png")) (cons (AgentImage (bb "/b.png")) (nil AgentEvent))))
    (add (check_str "older" (.shown (chat_update c "app.image.older" (UiOther 0 ""))) "/a.png")
         (add (check_str "no older" (.shown (shot_moved (shot_moved c -1) -1)) "/a.png")
              (check_str "no newer" (.shown (chat_update c "app.image.newer" (UiOther 0 ""))) "/b.png")))))

; The pane's toggles choose what it shows.
(def test_pane_toggled () int
  (add (check_str "images" (.pane (chat_update (chat_new) "pane.select.Images" (UiOther 0 ""))) "Images")
       (check_str "at first" (.pane (chat_new)) "Tools")))

; Opened, the handle read; each piece kept, the next asked; the end the
; whole left to decode, the handle closed.
(def test_image_read () int
  (let (c0 (.fetch (heard (chat_new) (AgentImage (bb "/a.png"))) (FetchOpen "/a.png"))
        c1 (answered c0 (tag_file) (message_new 30 (fs_reply_bytes 7 "")))
        c2 (answered c1 (tag_file) (message_new 30 (fs_reply_bytes 3 "abc")))
        c3 (answered c2 (tag_file) (message_new 30 (fs_reply_bytes 0 ""))))
    (add (check_str "opened" (fetch_text (.fetch c1)) "read /a.png 7 0")
         (add (check_str "a piece" (fetch_text (.fetch c2)) "read /a.png 7 3")
              (check_str "whole" (fetch_text (.fetch c3)) "decode /a.png abc")))))

; A file that will not open, and bytes that are no PNG, are said, and
; nothing more is read of them.
(def test_image_failed () int
  (let (c0 (.fetch (heard (chat_new) (AgentImage (bb "/a.png"))) (FetchOpen "/a.png"))
        gone (answered c0 (tag_file) (message_new 30 (fs_reply_bytes -2 "")))
        junk (decoded (.fetch c0 (FetchDecode "/a.png" (bb "abc")))))
    (add (check_str "no file" (shots_text (.shots gone)) "/a.png: No such file.")
         (add (check_bool "not a png" (starts_with (shots_text (.shots junk)) "/a.png: Not an image shown here: ") true)
              (check_str "nothing read" (fetch_text (.fetch junk)) "none")))))

; Where each image op of ns is drawn and how wide, as "X Y N".
(def pic_places ((ns (list UiNode))) (list int)
  (if (is_empty ns) "" (append (pic_ops_places (.ops (head ns))) (pic_places (tail ns)))))
(def pic_ops_places ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPImage x y n d ts) (append (digits x) (append " " (append (digits y) (append " " (append (digits n) " "))))))
                ((UiPFill r c) "") ((UiPRound r rad c u) "") ((UiPText r t a c f b s) "") ((UiPIcon x y nm c s) ""))
              (pic_ops_places (tail ops)))))

; The agent_build case's preview, as the pane holds it: 32 by 16, one
; blue.
(def case_pic () UiCov (UiCov 32 16 (array_new 512 (ui_hex "ff3584e4"))))

; Where tests/agent.sh clicks and looks, in the window as it opens, 960
; by 560: the Images toggle, the side pane's second, after Tools, 6
; down; and the case's preview, drawn as it is in the middle of the
; pane's room, 455 by 384 from 493, 58: its middle 720, 250.
(def test_placed () int
  (let (c (.pane (.shots (.shown (chat_new) "/p.png") (cons (Shot "/p.png" (Some (case_pic)) "") (nil Shot))) (pane_images))
        ns (ui_laid (chat_view c) 960 560))
    (add (check_str "the Images toggle" (ui_target_at ns "pane.select.Images") "536 6 61 34")
         (check_str "the picture" (pic_places ns) "704 242 32 "))))

; Each rounded op of ns that ends at x1, as "Y H" of its rectangle.
(def rounds_ending ((ns (list UiNode)) (x1 int)) (list int)
  (if (is_empty ns) "" (append (rounds_in (.ops (head ns)) x1) (rounds_ending (tail ns) x1))))
(def rounds_in ((ops (list UiPaint)) (x1 int)) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPRound r rad c u) (if (eq (rect_x1 r) x1) (append (digits (.y r)) (append " " (append (digits (.h r)) " "))) ""))
                ((UiPFill r c) "") ((UiPText r t a c f b s) "") ((UiPIcon x y nm c s) "") ((UiPImage x y n d ts) ""))
              (rounds_in (tail ops) x1))))

; What the person said first is a bubble at the conversation's end, 12
; in from its half's 480: one row, its ground from 20, 32 high, after
; the blank row; tests/agent.sh looks at it 4 in from that end.
(def test_said_placed () int
  (let ns (ui_laid (chat_view (heard (.link (chat_new) (Linked)) (AgentSaid "console" (bb "build me an app that says hello")))) 960 560)
    (check_str "its ground" (rounds_ending ns 467) "20 32 ")))

; speech's notices, each the line it leaves.
(def voice_after ((es (list SpeechEvent))) (list int) (voice_steps "" es))
(def voice_steps ((v (list int)) (es (list SpeechEvent))) (list int)
  (if (is_empty es) v (voice_steps (voice_line v (head es)) (tail es))))

(def test_voice_states () int
  (add (check_str "idle" (voice_after (cons (SpeechState "idle") (nil SpeechEvent))) "Hold F12 to talk to the agent.")
       (check_str "listening" (voice_after (cons (SpeechState "listening") (nil SpeechEvent))) "Listening...")))

(def test_voice_heard_then_held () int
  (check_str "held" (voice_after (cons (SpeechHeard (bb "hi")) (cons (SpeechState "held") (nil SpeechEvent))))
    "Heard: hi (said once this turn ends)"))

(def test_voice_error () int
  (check_str "error" (voice_after (cons (SpeechError (bb "no microphone")) (nil SpeechEvent))) "Speech: no microphone"))

; With no speech the entry's row is all there is under the panes; with
; it, its line is over the entry.
(def test_voice_shown () int
  (let (c (.link (chat_new) (Linked))
        quiet (length (ui_laid (chat_view c) 960 560))
        heard (length (ui_laid (chat_view (.voice c "Listening...")) 960 560)))
    (check_bool "one more" (gt heard quiet) true)))

; speech refusing open leaves no line.
(def test_speech_refused () int
  (check_str "none" (.voice (answered (.voice (chat_new) "Listening...") (tag_speech) (reply "error: no"))) ""))

; Under an operating system there is no window server.
(def test_entry () int
  (check_int "fails" (chat) 1))
