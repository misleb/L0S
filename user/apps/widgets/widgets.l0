; widgets.l0 -- the toolkit's gallery (user/lib/ui), as GTK's widget
; factory is GTK's: a window of the toolkit's widgets, and the start of a
; process monitor. A toolbar, Refresh and End Process, over a data grid of
; processes, sample ones, not the system's: their pid, name, state,
; parent, and CPU.
;
; A column's title sorts by it, and again the other way; a press on a
; row, or the arrow keys, select one; End Process, red, is sensitive only
; then, and only says what it would end. Tab moves the keyboard's focus
; between the buttons, and Enter or Space presses the one it is on.
; Along its foot, a tab bar of three tabs: a click on one selects it,
; and its close button closes it, but for the last.
;
;   widgets          its window, until its close button is pressed

; The grid's state, the line the toolbar shows, the tab bar's tabs, and
; the selected one's key.
(data Gallery (Gallery UiGridState (list int) (list UiTab) (list int)))

(def gallery_new () Gallery (Gallery (UiGridState 0 false "" 0) "Select a process from the list" (gallery_tabs) "1"))

; The tab bar's tabs at first.
(def gallery_tabs () (list UiTab)
  (cons (UiTab "1" "Processes") (cons (UiTab "2" "Files") (cons (UiTab "3" "Disks") (nil UiTab)))))

(def gallery_prefix () (list int) "procs")

(def gallery_columns () (list UiColumn)
  (cons (UiColumn "PID" 70 (UiEnd) true)
  (cons (UiColumn "Name" 0 (UiStart) true)
  (cons (UiColumn "State" 140 (UiStart) true)
  (cons (UiColumn "Parent" 80 (UiEnd) true)
  (cons (UiColumn "CPU" 120 (UiStart) true) (nil UiColumn)))))))

; A sample process: pid, name, state, parent, and CPU in percent.
(def sample_row ((pid int) (name (list int)) (state (list int)) (parent int) (cpu int)) UiRow
  (UiRow (digits pid)
    (cons (UiCellNum pid "")
    (cons (UiCellText name)
    (cons (UiCellStatus (state_tone state) state)
    (cons (UiCellNum parent "")
    (cons (UiCellLevel cpu) (nil UiCell))))))))

; Running green, waiting blue, the rest gray.
(def state_tone ((state (list int))) UiTone
  (if (eq state "running") (UiGood) (if (eq state "waiting") (UiAccentTone) (UiNeutral))))

; The demo's processes, as ps shows them, give or take.
(def gallery_rows () (list UiRow)
  (cons (sample_row 1 "sh" "waiting" 0 2)
  (cons (sample_row 2 "uart" "waiting" 1 1)
  (cons (sample_row 3 "virtio-gpu" "waiting" 1 4)
  (cons (sample_row 4 "virtio-input" "waiting" 1 1)
  (cons (sample_row 5 "virtio-input" "waiting" 1 0)
  (cons (sample_row 6 "wm" "waiting" 1 9)
  (cons (sample_row 7 "vt" "waiting" 1 3)
  (cons (sample_row 8 "vt" "waiting" 1 2)
  (cons (sample_row 9 "sh" "reading" 7 0)
  (cons (sample_row 10 "sh" "reading" 8 0)
  (cons (sample_row 11 "widgets" "running" 9 12)
  (cons (sample_row 12 "nap" "sleeping" 10 0)
  (cons (sample_row 13 "spin" "ready" 10 61)
  (cons (sample_row 14 "rtc" "sleeping" 9 0) (nil UiRow))))))))))))))))

; ------------------------------------------------------------------ view

; The grid's page, and the tab bar under it.
(def gallery_view ((g Gallery)) UiWidget
  (match g
    ((Gallery gs status ts sel)
      (UiBox (UiV) 0
        (cons (UiExpand (ui_grid_page status (UiGridView (gallery_prefix) (gallery_columns) (gallery_rows) gs)))
              (cons (UiTabBar "tabs" ts sel) (nil UiWidget)))))))

; ---------------------------------------------------------------- update

; The gallery after an action, or a key the grid takes, with the grid
; scrolled as sc says.
(def gallery_update ((g Gallery) (action (list int)) (ev UiEvent) (sc UiScroller)) Gallery
  (match g
    ((Gallery gs status ts sel)
      (if (eq action "app.refresh")
          (Gallery gs (append "Refreshed: " (append (digits (length (gallery_rows))) " processes")) ts sel)
          (if (eq action "app.end")
              (Gallery gs (append "Would end process " (ui_gs_selected gs)) ts sel)
              (if (starts_with action (append (gallery_prefix) "."))
                  (selected (ui_grid_action gs (gallery_prefix) action) g)
                  (if (starts_with action "tabs.")
                      (tabbed g action)
                      (let code (ui_key_pressed ev)
                        (if (lt code 0)
                            g
                            (selected (ui_grid_key (UiGridView (gallery_prefix) (gallery_columns) (gallery_rows) gs) code sc) g))))))))))

; The grid's new state, and the line saying what is selected.
(def selected ((gs UiGridState) (g Gallery)) Gallery
  (match g ((Gallery old status ts sel) (Gallery gs (ui_selected_line gs status) ts sel))))

; The gallery after a tab bar's action: a tab selected, or closed, unless
; it is the last, the one after it selected if it was.
(def tabbed ((g Gallery) (action (list int))) Gallery
  (match g
    ((Gallery gs status ts sel)
      (let k (ui_select_key "tabs" action)
        (if (not (is_empty k))
            (Gallery gs status ts k)
            (let c (ui_tab_close_key "tabs" action)
              (if (if (is_empty c) true (le (length ts) 1))
                  g
                  (Gallery gs status (tabs_without c ts) (if (eq c sel) (tab_next c ts) sel)))))))))

; ts without the tab keyed k.
(def tabs_without ((k (list int)) (ts (list UiTab))) (list UiTab)
  (if (is_empty ts)
      ts
      (match (head ts) ((UiTab key t) (if (eq key k) (tail ts) (cons (head ts) (tabs_without k (tail ts))))))))

; The key of the tab after the one keyed k in ts, or of the first if it
; is the last.
(def tab_next ((k (list int)) (ts (list UiTab))) (list int)
  (tab_next_from k ts (match (head ts) ((UiTab key t) key))))

; tab_next's loop: first, the first tab's key, for when k's is last.
(def tab_next_from ((k (list int)) (ts (list UiTab)) (first (list int))) (list int)
  (if (is_empty ts)
      first
      (match (head ts)
        ((UiTab key t)
          (if (eq key k)
              (if (is_empty (tail ts)) first (match (head (tail ts)) ((UiTab k2 t2) k2)))
              (tab_next_from k (tail ts) first))))))

; ------------------------------------------------------------------ loop

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "widgets" why))

(def widgets () int
  (match (ui_open "Widgets" 640 440)
    ((UiOpenFailed why) (complain why))
    ((UiOpenedWin w) (gallery_loop (ui_present w (gallery_view (gallery_new))) (gallery_new)))))

(def gallery_loop ((w UiWin) (g Gallery)) int
  (match (port_receive (ui_win_port w))
    ((RecvFailed) (complain "lost its port"))
    ((Message from b)
      (let ev (ui_event_of w (Message from b))
        (match (ui_route w ev)
          ((UiRouted w2 action)
            (let g2 (gallery_update g action ev (ui_win_scroller w2 (gallery_prefix)))
              (gallery_loop (ui_present w2 (gallery_view g2)) g2))))))))
