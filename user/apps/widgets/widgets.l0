; widgets.l0 -- the toolkit's gallery (user/lib/ui), as GTK's widget
; factory is GTK's: a window of the toolkit's widgets, a page a tab.
;
; Processes: the start of a process monitor. A toolbar, Refresh and End
; Process, over a data grid of processes, sample ones, not the system's:
; their pid, name, state, parent, and CPU. A column's title sorts by it,
; and again the other way; a press on a row, or the arrow keys, select
; one; End Process, red, is sensitive only then, and only says what it
; would end. Tab moves the keyboard's focus between the buttons, and
; Enter or Space presses the one it is on.
;
; Controls: a switch, a check box, a slider with its value beside it,
; and a spinner, turning while the page shows.
;
; Rows: a boxed list of a dozen rows, icons and subtitles, the first
; with a switch at its end, that scrolls; the row clicked said along the
; page's foot.
;
; Along its foot, a tab bar of the three: a click on one selects it, and
; its close button closes it, but for the last.
;
;   widgets          its window, until its close button is pressed

; The grid's state, the line the toolbar shows, the tab bar's tabs, the
; selected one's key; the switch, the check box, the slider and the
; spinner; the list's first row, and the row last clicked.
(data Gallery
  (Gallery (grid UiGridState) (status (list int)) (ts (list UiTab)) (sel (list int))
           (wifi bool) (dark bool) (vol int) (phase int) (first int) (clicked (list int))))

(def gallery_new () Gallery
  (Gallery (UiGridState 0 false "" 0 0) "Select a process from the list" (gallery_tabs) "1" true true 40 0 0 ""))

; The tab bar's tabs at first: the pages.
(def gallery_tabs () (list UiTab)
  (cons (UiTab "1" "Processes") (cons (UiTab "2" "Controls") (cons (UiTab "3" "Rows") (nil UiTab)))))

(def gallery_prefix () (list int) "procs")

(def gallery_columns () (list UiColumn)
  (cons (UiColumn "PID" 70 (UiEnd) true)
  (cons (UiColumn "Name" 0 (UiStart) true)
  (cons (UiColumn "State" 140 (UiStart) true)
  (cons (UiColumn "Parent" 80 (UiEnd) true)
  (cons (UiColumn "CPU" 120 (UiStart) true) (nil UiColumn)))))))

; A sample process: pid, name, state, parent, and CPU in percent.
(def sample_row ((pid int) (name (list int)) (state (list int)) (parent int) (cpu int)) UiRow
  (UiRow (digits pid)
    (cons (UiCellNum pid "")
    (cons (UiCellText name)
    (cons (UiCellStatus (state_tone state) state)
    (cons (UiCellNum parent "")
    (cons (UiCellLevel cpu) (nil UiCell))))))))

; Running green, waiting blue, the rest gray.
(def state_tone ((state (list int))) UiTone
  (if (eq state "running") (UiGood) (eq state "waiting") (UiAccentTone) (UiNeutral)))

; The demo's processes, as ps shows them, give or take.
(def gallery_rows () (list UiRow)
  (cons (sample_row 1 "sh" "waiting" 0 2)
  (cons (sample_row 2 "uart" "waiting" 1 1)
  (cons (sample_row 3 "virtio-gpu" "waiting" 1 4)
  (cons (sample_row 4 "virtio-input" "waiting" 1 1)
  (cons (sample_row 5 "virtio-input" "waiting" 1 0)
  (cons (sample_row 6 "wm" "waiting" 1 9)
  (cons (sample_row 7 "vt" "waiting" 1 3)
  (cons (sample_row 8 "vt" "waiting" 1 2)
  (cons (sample_row 9 "sh" "reading" 7 0)
  (cons (sample_row 10 "sh" "reading" 8 0)
  (cons (sample_row 11 "widgets" "running" 9 12)
  (cons (sample_row 12 "nap" "sleeping" 10 0)
  (cons (sample_row 13 "spin" "ready" 10 61)
  (cons (sample_row 14 "rtc" "sleeping" 9 0) (nil UiRow))))))))))))))))

; ------------------------------------------------------------------ view

; The page of the selected tab, and the tab bar under it.
(def gallery_view ((g Gallery)) UiWidget
  (UiBox (UiV) 0 (cons (UiExpand (gallery_page g)) (cons (UiTabBar "tabs" (.ts g) (.sel g)) (nil UiWidget)))))

; The selected tab's page.
(def gallery_page ((g Gallery)) UiWidget
  (if (eq (.sel g) "2") (controls_page g)
      (eq (.sel g) "3") (rows_page g)
      (ui_grid_page (.status g) (UiGridView (gallery_prefix) (gallery_columns) (gallery_rows) (.grid g)))))

; The controls, each beside its name: the switch, the check box, the
; slider and its value, and the spinner.
(def controls_page ((g Gallery)) UiWidget
  (ui_page "Controls" "As libadwaita draws them"
           (cons (UiProps (cons (UiProp "Wi-Fi" (UiSwitch "wifi" (.wifi g)))
                                (cons (UiProp "Style" (UiCheck "dark" (.dark g) "Dark"))
                                      (cons (UiProp "Volume" (UiBox (UiH) (ui_space_m) (cons (UiScale "vol" (.vol g) 0 100 240)
                                                                                           (cons (ui_value (append (digits (.vol g)) "%")) (nil UiWidget)))))
                                            (cons (UiProp "Working" (UiSpinner (.phase g) 16)) (nil UiProp))))))
                 (nil UiWidget))))

; The list, given the page's room, and the row last clicked along its
; foot.
(def rows_page ((g Gallery)) UiWidget
  (ui_with_footer (ui_page "Rows" "" (cons (UiExpand (UiList (UiListData "rows" (gallery_list g) (.first g)))) (nil UiWidget)))
                  (if (is_empty (.clicked g)) "Click a row" (append "Clicked " (.clicked g)))))

; The list's rows: an icon, a title and a subtitle each, the first with
; the Wi-Fi switch at its end.
(def gallery_list ((g Gallery)) (list UiListRow)
  (cons (.icon (.end (ui_list_row "wifi" "Wi-Fi" (if (.wifi g) "Connected" "Off")) (UiSwitch "wifi" (.wifi g))) "computer")
        (gallery_list_rows (split_on 59 "folder:Documents:12 files;text-x-generic:Notes.txt:4 KB;drive-harddisk:Disk:1.0 GB;utilities-terminal:Terminal:;system-search:Search:Files and apps;view-grid:Apps:9 installed;open-menu:Menu:;view-refresh:Updates:None waiting;tab-new:Tabs:2 open;list-add:New:;user-trash:Trash:Empty")
                           (nil UiListRow))))

; Each of specs, ICON:TITLE:SUBTITLE, a row keyed by its title.
(def gallery_list_rows ((specs (list (list int))) (acc (list UiListRow))) (list UiListRow)
  (if (is_empty specs)
      (rev acc)
      (let parts (split_on 58 (head specs))
        (gallery_list_rows (tail specs) (cons (.icon (ui_list_row (nth parts 1) (nth parts 1) (nth parts 2)) (nth parts 0)) acc)))))

; ---------------------------------------------------------------- update

; The gallery after an action, or a key the grid takes while its page
; shows, with the grid scrolled as sc says.
(def gallery_update ((g Gallery) (action (list int)) (ev UiEvent) (sc UiScroller)) Gallery
  (if (eq action "app.refresh") (.status g (append "Refreshed: " (append (digits (length (gallery_rows))) " processes")))
      (eq action "app.end") (let s (.selected (.grid g)) (.status g (append "Would end process " s)))
      (starts_with action (append (gallery_prefix) ".")) (selected (ui_grid_action (.grid g) (gallery_prefix) action) g)
      (starts_with action "tabs.") (tabbed g action)
      (starts_with action "rows.") (listed g action)
      (any_eq (up_to 46 action) (split_spaces "wifi dark vol")) (controlled g action)
      (let code (ui_key_pressed ev)
        (if (or (lt code 0) (not (eq (.sel g) "1")))
            g
            (selected (ui_grid_key (UiGridView (gallery_prefix) (gallery_columns) (gallery_rows) (.grid g)) code sc) g)))))

; The controls after action: the switch or check box turned over, the
; slider set or stepped. Each read first, then the gallery replaced.
(def controlled ((g Gallery) (action (list int))) Gallery
  (let (wifi (ui_toggled "wifi" (.wifi g) action)
        dark (ui_toggled "dark" (.dark g) action)
        vol (ui_scale_value "vol" (.vol g) 0 100 action))
    (.vol (.dark (.wifi g wifi) dark) vol)))

; The list after action: a row clicked said, or the list scrolled.
(def listed ((g Gallery) (action (list int))) Gallery
  (let k (ui_select_key "rows" action)
    (if (is_empty k) (.first g (ui_list_first (.first g) "rows" action)) (.clicked g k))))

; The grid's new state, and the line saying what is selected.
(def selected ((gs UiGridState) (g Gallery)) Gallery
  (let line (ui_selected_line gs (.status g))
    (.status (.grid g gs) line)))

; The gallery after a tab bar's action: a tab selected, or closed, unless
; it is the last, the one after it selected if it was, or the one
; before it if it was the last.
(def tabbed ((g Gallery) (action (list int))) Gallery
  (let (k (ui_select_key "tabs" action)
        c (ui_tab_close_key "tabs" action)
        ts (.ts g)
        sel (.sel g))
    (if (not (is_empty k)) (.sel g k)
        (or (is_empty c) (le (length ts) 1)) g
        (.sel (.ts g (ui_without ui_tab_key c ts)) (if (eq c sel) (ui_key_after ui_tab_key c ts sel) sel)))))

; ------------------------------------------------------------------ loop

; A step of the window: the gallery updated, the grid scrolled as the
; window shows it; and while the controls show, the spinner turned on
; the window's alarm, every ui_spinner_ns, the first asked as they come
; to show.
(def gallery_step ((g Gallery) (action (list int)) (ev UiEvent) (w UiWin)) (UiStepped Gallery)
  (let (was (.sel g)
        g2 (gallery_update g action ev (ui_win_scroller w (gallery_prefix)))
        showing (eq (.sel g2) "2"))
    (if (and showing (ui_is_alarm ev))
        (UiStepped (ui_win_alarm w (add (clock_ns) (ui_spinner_ns))) (.phase g2 (ui_spinner_next (.phase g2))))
        (and showing (not (eq was "2")))
        (UiStepped (ui_win_alarm w (add (clock_ns) (ui_spinner_ns))) g2)
        (UiStepped w g2))))

; Its window, until it is closed.
(def widgets () int
  (ui_run "widgets" "Widgets" 640 440 (gallery_new) gallery_view gallery_step))
