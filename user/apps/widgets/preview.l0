; preview.l0 -- the gallery's scenes for make preview APP=widgets: as it
; opens; with a process selected, End Process awake; the controls, and
; them changed; the rows, and them scrolled with one clicked.
(def main () int
  (ui_preview (cons (UiShot "main" 640 440 (gallery_view (gallery_new)))
                    (cons (UiShot "selected" 640 440 (gallery_view (upd (gallery_new) "procs.select.6")))
                          (cons (UiShot "controls" 640 440 (gallery_view (upd (gallery_new) "tabs.select.2")))
                                (cons (UiShot "controls-changed" 640 440
                                              (gallery_view (upd (upd (upd (upd (gallery_new) "tabs.select.2") "wifi.toggle") "dark.toggle") "vol.set.85")))
                                      (cons (UiShot "rows" 640 440 (gallery_view (upd (gallery_new) "tabs.select.3")))
                                            (cons (UiShot "rows-scrolled" 640 440 (gallery_view (upd (upd (upd (gallery_new) "tabs.select.3") "rows.scrollto.4") "rows.select.Terminal")))
                                                  (nil UiShot)))))))))

; The gallery after action, before its window is laid out.
(def upd ((g Gallery) (action (list int))) Gallery (gallery_update g action (UiOther 0 "") (ui_no_scroller)))
