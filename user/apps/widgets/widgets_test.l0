(def none () UiEvent (UiOther 0 ""))

; The gallery after an action or event, before its window is laid out.
(def upd ((g Gallery) (action (list int)) (ev UiEvent)) Gallery (gallery_update g action ev (ui_no_scroller)))

; The tabs' keys, the selected one's after a *.
(def tabs_of ((g Gallery)) (list int)
  (match g ((Gallery gs s ts sel) (append (tab_keys ts) (append "*" sel)))))
(def tab_keys ((ts (list UiTab))) (list int)
  (if (is_empty ts) "" (match (head ts) ((UiTab k t) (append k (tab_keys (tail ts)))))))

(def test_tab_selected () int
  (add (check_str "the first at first" (tabs_of (gallery_new)) "123*1")
       (check_str "a click on the third" (tabs_of (upd (gallery_new) "tabs.select.3" (none))) "123*3")))

; Closing the selected tab selects the one after it, or the first after
; the last; closing another keeps the selection; the last stays.
(def test_tab_closed () int
  (add (check_str "the first, selected" (tabs_of (upd (gallery_new) "tabs.close.1" (none))) "23*2")
       (add (check_str "the last, selected" (tabs_of (upd (upd (gallery_new) "tabs.select.3" (none)) "tabs.close.3" (none))) "12*1")
            (check_str "another" (tabs_of (upd (gallery_new) "tabs.close.2" (none))) "13*1"))))

(def test_last_tab_stays () int
  (check_str "one left" (tabs_of (upd (upd (upd (gallery_new) "tabs.close.1" (none)) "tabs.close.2" (none)) "tabs.close.3" (none))) "3*3"))

; The tab bar is along the window's foot, its last 40 rows, under the
; grid's page.
(def test_tab_bar_at_the_foot () int
  (check_bool "its first tab" (has_target_at (laid (gallery_new)) "tabs.select.1" 403) true))

; Whether a node with action a starts at row y.
(def has_target_at ((ns (list UiNode)) (a (list int)) (y int)) bool
  (if (is_empty ns) false
      (and (eq (.action (head ns)) a) (eq (.y (.rect (head ns))) y)) true
      (has_target_at (tail ns) a y)))

(def test_select_row () int
  (let g (upd (gallery_new) "procs.select.6" (none))
    (add (check_str "selected" (.selected (.grid g)) "6")
         (check_str "said" (.status g) "Process 6 selected"))))

(def test_end_process () int
  (check_str "says what it would end"
    (.status (upd (upd (gallery_new) "procs.select.6" (none)) "app.end" (none)))
    "Would end process 6"))

(def test_refresh () int
  (check_str "counted" (.status (upd (gallery_new) "app.refresh" (none))) "Refreshed: 14 processes"))

(def test_sort () int
  (match (.grid (upd (gallery_new) "procs.sort.4" (none)))
    ((UiGridState col desc sel first left) (add (check_int "by CPU" col 4) (check_bool "ascending" desc false)))))

(def test_arrow_key () int
  (check_str "down from none, the first by pid"
    (.selected (.grid (upd (gallery_new) "" (UiKey (KeyEvent (ui_key_down) 1 0 0)))))
    "1"))

; Nothing selected, End Process has no target: Refresh and the titles
; and the rows do.
(def has_target ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (eq (.action (head ns)) a) true (has_target (tail ns) a)))

(def laid ((g Gallery)) (list UiNode) (ui_layout_window (gallery_view g) 640 440 (ui_state_new (UiLight))))

(def test_end_insensitive () int
  (add (check_bool "not without a selection" (has_target (laid (gallery_new)) "app.end") false)
       (check_bool "with one" (has_target (laid (upd (gallery_new) "procs.select.3" (none))) "app.end") true)))

(def test_rows_shown () int
  (add (check_bool "the first" (has_target (laid (gallery_new)) "procs.select.1") true)
       (check_bool "not the last, below the fold" (has_target (laid (gallery_new)) "procs.select.14") false)))

; What tests/widgets.sh reads of the toolbar's line: its text, 159
; wide in Source Sans 3, and the pens of from's m and the space after
; it, of list's i and the s after it, from its start.
(def test_status_line () int
  (add (check_str "the line" (.status (gallery_new)) "Select a process from the list")
       (add (check_int "its width" (ui_text_w (.status (gallery_new)) (UiSans) false 1) 159)
            (check_str "the pens" (unwords (cons (digits (ui_text_pen (.status (gallery_new)) (UiSans) false 20))
                                          (cons (digits (ui_text_pen (.status (gallery_new)) (UiSans) false 21))
                                          (cons (digits (ui_text_pen (.status (gallery_new)) (UiSans) false 27))
                                          (cons (digits (ui_text_pen (.status (gallery_new)) (UiSans) false 28)) (nil (list int)))))))
                       "107 118 145 149"))))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (widgets) 1))
