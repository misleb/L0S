; fsview.l0 -- what Files shows of a directory, and what it does to the
; files in it: the entries of a directory, the initramfs's listed from
; its entries, a file server's and /Volumes' from what Files asked and
; was answered (files.l0's jobs); what each thing is, a folder, a
; volume, an app's bundle, a program or any other file; the paths a path
; bar shows; why a place cannot be changed; and opening and starting,
; each saying in words why if it cannot. What is pure is kept apart
; from the calls, to be tested.

; What a thing in a directory is: a folder; a volume, in /Volumes; an
; app's bundle, a folder NAME.app, with its icon; a program; or any
; other file.
(data FvKind (FvDir) (FvVolume) (FvApp FvAppIcon) (FvProgram) (FvText))

; An app's icon: its images, from its icon.face, which mkicon draws from
; its icon.svg; or the drawing commands of its icon.draw, none if it has
; neither.
(data FvAppIcon (FvImage (list UiCov)) (FvDrawn (list UiDraw)))

; A thing in a directory: its name, with no final /, what it is, and its
; size: a file's bytes, a volume's, or how many things a folder or a
; bundle holds; -1 if it is not known.
(data FvEntry (FvEntry (name (list int)) (kind FvKind) (size int)))

; A directory listed, or why not.
(data FvListing (FvListed (list FvEntry)) (FvNotListed (list int)))

; Whether a thing is one to go into: a folder or a volume. An app's
; bundle is a folder too, but opening it starts the app.
(def fv_is_place ((k FvKind)) bool
  (match k ((FvDir) true) ((FvVolume) true) ((FvApp ds) false) ((FvProgram) false) ((FvText) false)))

; Whether a thing's size is how many things it holds: a folder's or a
; bundle's.
(def fv_is_holder ((k FvKind)) bool
  (match k ((FvDir) true) ((FvVolume) false) ((FvApp ds) true) ((FvProgram) false) ((FvText) false)))

; ------------------------------------------------------------------ paths

; The path of name in directory dir.
(def fv_join ((dir (list int)) (name (list int))) (list int)
  (if (eq dir "/") (cons 47 name) (append dir (cons 47 name))))

; The directory path is in: / for /bin, /bin for /bin/sh.
(def fv_parent ((path (list int))) (list int)
  (let up (rev (drop_n (drop_while_not_slash (rev path)) 1))
    (if (is_empty up) "/" up)))

; s from its first / on.
(def drop_while_not_slash ((s (list int))) (list int)
  (if (or (is_empty s) (eq (head s) 47)) s (drop_while_not_slash (tail s))))

; The names along path, / first as Computer, as the path bar shows them:
; Computer, Volumes, data for /Volumes/data.
(def fv_crumbs ((path (list int))) (list (list int))
  (cons "Computer" (fv_parts path)))

; The names along path, none for /.
(def fv_parts ((path (list int))) (list (list int))
  (fv_nonempty (split_on 47 path)))

; ws without the empty ones.
(def fv_nonempty ((ws (list (list int)))) (list (list int))
  (if (is_empty ws) ws
      (is_empty (head ws)) (fv_nonempty (tail ws))
      (cons (head ws) (fv_nonempty (tail ws)))))

; The path of the path bar's part n of path: / for 0, the first n names
; after it for any other, all of path past its end.
(def fv_at_depth ((path (list int)) (n int)) (list int)
  (if (le n 0) "/" (fv_from_parts (take (fv_parts path) n))))

; The path of names from /.
(def fv_from_parts ((ns (list (list int)))) (list int)
  (if (is_empty ns) "/" (append "/" (join_with "/" ns))))

; path once the volume old has become new: the same place on it, under
; /Volumes/new; any other path as it is.
(def fv_relabelled ((path (list int)) (old (list int)) (new (list int))) (list int)
  (let from (append "/Volumes/" old)
    (if (eq path from) (append "/Volumes/" new)
        (starts_with path (append from "/")) (append (append "/Volumes/" new) (drop_n path (length from)))
        path)))

; Each of paths as fv_relabelled makes it.
(def fv_all_relabelled ((paths (list (list int))) (old (list int)) (new (list int))) (list (list int))
  (if (is_empty paths) paths (cons (fv_relabelled (head paths) old new) (fv_all_relabelled (tail paths) old new))))

; Whether path is where volumes are, or one of them: /Volumes, or
; /Volumes/LABEL, which a rename relabels.
(def fv_is_volumes ((path (list int))) bool (eq path "/Volumes"))
(def fv_is_volume ((path (list int))) bool
  (and (starts_with path "/Volumes/") (not (any_eq 47 (drop_n path 9)))))

; Whether a name is one a file or folder may have: not empty, no /, and
; neither . nor ..
(def fv_name_ok ((name (list int))) bool
  (if (is_empty name) false (any_eq 47 name) false (not (any_eq name (split_spaces ". ..")))))

; ---------------------------------------------------------------- listing

; What a name in a listing is, its final / saying a folder, and NAME.app/
; an app's bundle; prog, whether a file is a program.
(def fv_kind_of ((name (list int)) (prog bool)) FvKind
  (if (ends_with name ".app/") (FvApp (FvDrawn (nil UiDraw)))
      (ends_with name "/") (FvDir)
      prog (FvProgram)
      (FvText)))

; A name as a listing gives it, without its final /.
(def fv_bare ((name (list int))) (list int)
  (if (ends_with name "/") (drop_last name) name))

; The entries, sorted: folders and volumes first, then the rest, each by
; name, as Nautilus sorts them.
(def fv_sorted ((es (list FvEntry))) (list FvEntry)
  (fv_unranked (sort (fv_ranked es (nil FvRanked))) (nil FvEntry)))

; An entry with what it sorts by: 0 for a place, 1 for the rest, then its
; name.
(data FvRanked (FvRanked int (list int) FvEntry))

; Each of es with what it sorts by, onto acc.
(def fv_ranked ((es (list FvEntry)) (acc (list FvRanked))) (list FvRanked)
  (if (is_empty es)
      acc
      (fv_ranked (tail es) (cons (FvRanked (if (fv_is_place (.kind (head es))) 0 1) (.name (head es)) (head es)) acc))))

; The entries of rs, in order, without what they sorted by.
(def fv_unranked ((rs (list FvRanked)) (acc (list FvEntry))) (list FvEntry)
  (if (is_empty rs) (rev acc) (match (head rs) ((FvRanked r n e) (fv_unranked (tail rs) (cons e acc))))))

; The entries of directory dir of the initramfs, whose paths are names,
; as entry_paths gives them, programs those of progs, and sizes their
; sizes, a size each in the same order; in / the volumes' directory too,
; as ls shows it. A folder's size is how many things are in it, from
; names; the volumes' is not known here.
(def fv_root_entries ((names (list (list int))) (progs (list (list int))) (sizes (list int)) (dir (list int))) (list FvEntry)
  (let kids (entry_children names dir)
    (fv_sorted (fv_root_onto (if (eq dir "/") (cons "Volumes/" kids) kids) names progs sizes dir (nil FvEntry)))))

; fv_root_entries's loop: an entry for each of kids, onto acc.
(def fv_root_onto ((kids (list (list int))) (names (list (list int))) (progs (list (list int))) (sizes (list int))
                   (dir (list int)) (acc (list FvEntry))) (list FvEntry)
  (if (is_empty kids)
      acc
      (let n (head kids)
        (fv_root_onto (tail kids) names progs sizes dir
                      (cons (FvEntry (fv_bare n) (fv_kind_of n (any_eq (fv_join dir n) progs)) (fv_root_size names sizes (fv_join dir n))) acc)))))

; How big the initramfs's thing at path is, as fv_root_entries says: its
; listed path's size, a folder's things, or -1 if it is not listed.
(def fv_root_size ((names (list (list int))) (sizes (list int)) (path (list int))) int
  (if (ends_with path "/")
      (if (any_eq path names) (length (entry_children names (drop_last path))) -1)
      (let i (index_of path names) (if (lt i 0) -1 (nth_or sizes i -1)))))

; The entries of /Volumes: each volume of vols, /Volumes/LABEL, its size
; the one of sizes beside it, -1 if there is none.
(def fv_volume_entries ((vols (list (list int))) (sizes (list int))) (list FvEntry)
  (fv_sorted (fv_volumes_onto vols sizes (nil FvEntry))))

; fv_volume_entries's loop: an entry for each of vols, onto acc.
(def fv_volumes_onto ((vols (list (list int))) (sizes (list int)) (acc (list FvEntry))) (list FvEntry)
  (if (is_empty vols)
      acc
      (fv_volumes_onto (tail vols) (if (is_empty sizes) sizes (tail sizes))
                       (cons (FvEntry (base_name (head vols)) (FvVolume) (if (is_empty sizes) -1 (head sizes))) acc))))

; The entries of a directory a file server listed as stats, programs
; those named in progs: a file's size its own, a folder's not known yet.
(def fv_stat_entries ((stats (list FsStat)) (progs (list (list int)))) (list FvEntry)
  (fv_sorted (fv_stats_onto stats progs (nil FvEntry))))

; fv_stat_entries's loop: an entry for each of stats, onto acc.
(def fv_stats_onto ((stats (list FsStat)) (progs (list (list int))) (acc (list FvEntry))) (list FvEntry)
  (if (is_empty stats)
      acc
      (match (head stats)
        ((FsStat name size)
          (fv_stats_onto (tail stats) progs (cons (FvEntry (fv_bare name) (fv_kind_of name (any_eq name progs)) (if (ends_with name "/") -1 size)) acc))))))

; The initramfs's directory dir listed, from its entries, the kernel's,
; and each app's icon read (fv_filled), its bundle's files the
; initramfs's too; or why not, if it is no directory there. Nothing
; below dir is listed. A directory a file server lists, and /Volumes,
; are Files' own jobs, asked and never waited on (files.l0).
(def fv_list ((dir (list int))) FvListing
  (match (fv_list_root dir)
    ((FvNotListed why) (FvNotListed why))
    ((FvListed es) (FvListed (fv_filled dir es)))))

; The initramfs's directory dir, if it is one.
(def fv_list_root ((dir (list int))) FvListing
  (let names (entry_paths)
    (if (or (eq dir "/") (any_eq (append dir "/") names))
        (FvListed (fv_root_entries names (fv_entry_programs names 0 (nil (list int))) (fv_entry_sizes 0 (length names)) dir))
        (FvNotListed (io_error -9)))))

; The paths of names, from entry i, that are programs, onto acc.
(def fv_entry_programs ((names (list (list int))) (i int) (acc (list (list int)))) (list (list int))
  (if (is_empty names)
      acc
      (fv_entry_programs (tail names) (add i 1) (if (entry_is_program i) (cons (head names) acc) acc))))

; The sizes of entries i up to n, as the kernel says them.
(def fv_entry_sizes ((i int) (n int)) (list int)
  (if (ge i n) (nil int) (cons (entry_size_of i) (fv_entry_sizes (add i 1) n))))

; es of dir with each app's icon, from its bundle. A folder's size stays
; what listing dir said, unknown on a volume, since counting it would
; list every folder in dir, however big.
(def fv_filled ((dir (list int)) (es (list FvEntry))) (list FvEntry)
  (if (is_empty es)
      es
      (match (head es)
        ((FvEntry n k s)
          (cons (FvEntry n (match k ((FvApp ds) (FvApp (fv_app_icon (fv_join dir n)))) ((FvDir) k) ((FvVolume) k) ((FvProgram) k) ((FvText) k)) s)
                (fv_filled dir (tail es)))))))

; The icon of the app whose bundle is at path: the images of its
; icon.face if it has one, else its icon.draw's commands, if any.
(def fv_app_icon ((path (list int))) FvAppIcon
  (match (read_whole (append path "/icon.face"))
    ((Ok b) (FvImage (ui_images_of b (ui_image_sizes))))
    ((Err why) (FvDrawn (fv_app_draws path)))))

; The drawing commands of the app whose bundle is at path, from its
; icon.draw; none if it has none.
(def fv_app_draws ((path (list int))) (list UiDraw)
  (match (read_whole (append path "/icon.draw"))
    ((Err why) (nil UiDraw))
    ((Ok b) (fv_draws_of (bytes_to_list b)))))

; The commands of an icon.draw's text, as tools/mkicon reads them: a
; line each, blank lines and # comments left out, as are lines that are
; no command.
(def fv_draws_of ((text (list int))) (list UiDraw)
  (fv_draws_onto (lines text) (nil UiDraw)))

; fv_draws_of's loop: the command of each of ls that is one, onto acc.
(def fv_draws_onto ((ls (list (list int))) (acc (list UiDraw))) (list UiDraw)
  (if (is_empty ls)
      (rev acc)
      (let ws (split_spaces (head ls))
        (if (or (is_empty ws) (starts_with (head ws) "#"))
            (fv_draws_onto (tail ls) acc)
            (match (ui_parse_draw ws)
              ((Ok d) (fv_draws_onto (tail ls) (cons d acc)))
              ((Err why) (fv_draws_onto (tail ls) acc)))))))

; ------------------------------------------------------------- changing

; Why the files of dir cannot be changed, or "": the initramfs's cannot
; be, nor can /Volumes be added to or taken from, only its volumes
; relabelled. The changes themselves, a folder made, a thing renamed or
; deleted, a volume relabelled, are asked of the file server by Files
; (files.l0's FlChange).
(def fv_fixed_why ((dir (list int))) (list int)
  (if (fv_is_volumes dir) "volumes are made in Disks"
      (on_initramfs dir) "the system's files cannot be changed"
      ""))

; ---------------------------------------------------------------- opening

; What opening a thing does: goes into a folder; starts an app or a
; program, saying so; has a file read, by its path, to show its lines
; (files.l0's FlForText); or cannot, saying why.
(data FvOpen (FvGo (list int)) (FvStarted (list int)) (FvRead (list int)) (FvNotOpened (list int)))

; How much of a file is shown, and how many of its lines and of each's
; characters.
(def fv_preview_max () int 65536)
(def fv_preview_lines () int 2000)
(def fv_preview_cols () int 240)

; Opening name, kind k, in dir.
(def fv_open ((dir (list int)) (name (list int)) (k FvKind)) FvOpen
  (let path (fv_join dir name)
    (match k
      ((FvDir) (FvGo path))
      ((FvVolume) (FvGo path))
      ((FvApp ds)
        (match (app_read path)
          ((Err why) (FvNotOpened why))
          ((Ok a) (fv_started (.name a) (spawn_path (.exec a) ((None (list (list int)))))))))
      ((FvProgram) (fv_started name (spawn_path path ((None (list (list int)))))))
      ((FvText) (FvRead path)))))

; What starting what came to.
(def fv_started ((what (list int)) (s Spawn)) FvOpen
  (match s
    ((Spawned pid) (FvStarted (append "Started " what)))
    ((SpawnNoEntry) (FvNotOpened (append "no program " what)))
    ((SpawnNotProgram) (FvNotOpened (spawn_why s)))
    ((SpawnTooBig) (FvNotOpened (spawn_why s)))
    ((SpawnNoRoom) (FvNotOpened (spawn_why s)))))

; A file's bytes as the lines to show: split at each newline, a tab as
; spaces to the next stop of 8, anything else not printable as a dot, as
; the font has only ASCII's; at most fv_preview_lines of at most
; fv_preview_cols each.
(def fv_text_lines ((bs (list int))) (list (list int))
  (fv_lines_onto bs (nil int) 0 (nil (list int))))

; fv_text_lines's loop: line the one being made, reversed, of n lines so
; far, acc, reversed.
(def fv_lines_onto ((bs (list int)) (line (list int)) (n int) (acc (list (list int)))) (list (list int))
  (if (ge n (fv_preview_lines)) (rev acc)
      (is_empty bs) (rev (if (is_empty line) acc (cons (take (rev line) (fv_preview_cols)) acc)))
      (let c (head bs)
        (if (eq c 10)
            (fv_lines_onto (tail bs) (nil int) (add n 1) (cons (take (rev line) (fv_preview_cols)) acc))
            (fv_lines_onto (tail bs) (fv_char_onto c line) n acc)))))

; Character c added to line, reversed: a tab as spaces to its stop, a
; carriage return dropped, any other not printable a dot.
(def fv_char_onto ((c int) (line (list int))) (list int)
  (if (eq c 9) (fv_spaces (sub 8 (mod (length line) 8)) line)
      (eq c 13) line
      (cons (if (and (ge c 32) (lt c 127)) c 46) line)))

; n spaces onto line.
(def fv_spaces ((n int) (line (list int))) (list int)
  (if (le n 0) line (fv_spaces (sub n 1) (cons 32 line))))
