; fsview_test.l0 -- tests of what Files lists and the paths it shows.

; An entry as text: its name, a letter for what it is, and its size.
(def entry_text ((e FvEntry)) (list int)
  (match e
    ((FvEntry n k s)
      (append n (append ":" (append (match k ((FvDir) "d") ((FvVolume) "v") ((FvApp ds) "a") ((FvProgram) "x") ((FvText) "f"))
                                    (if (lt s 0) "" (append ":" (digits s)))))))))

(def entries_text ((es (list FvEntry))) (list int)
  (if (is_empty es) "" (append (entry_text (head es)) (append " " (entries_text (tail es))))))

; Paths as entry_paths gives an initramfs's, and those that are
; programs.
(def root_names () (list (list int))
  (split_spaces "/Applications/ /Applications/Files.app/ /Applications/Files.app/files /bin/ /bin/sh /etc/ /etc/motd /etc/inittab"))
(def root_progs () (list (list int)) (split_spaces "/bin/sh /Applications/Files.app/files"))

; Their sizes, as the kernel says them, in the same order: 0 for each
; directory.
(def root_sizes () (list int) (cons 0 (cons 0 (cons 900 (cons 0 (cons 500 (cons 0 (cons 20 (cons 30 (nil int))))))))))

(def root_of ((dir (list int))) (list int) (entries_text (fv_root_entries (root_names) (root_progs) (root_sizes) dir)))

; /: its folders, the volumes' among them, sorted, each with how many
; things are in it; the volumes' not known here; no file there.
(def test_root_entries () int
  (check_str "/" (root_of "/") "Applications:d:1 Volumes:d bin:d:1 etc:d:2 "))

; A bundle is an app, holding one thing; a program is one, a file
; another, each its size.
(def test_root_kinds () int
  (add (check_str "a bundle" (root_of "/Applications") "Files.app:a:1 ")
       (add (check_str "a program" (root_of "/Applications/Files.app") "files:x:900 ")
            (check_str "files, by name" (root_of "/etc") "inittab:f:30 motd:f:20 "))))

; A path not listed has no size known.
(def test_root_size_missing () int
  (check_int "none" (fv_root_size (root_names) (root_sizes) "/etc/nope") -1))

; A volume's listing: folders first, then files by name, with sizes; a
; folder's, how many things it holds, not known until it is listed.
(def test_stat_entries () int
  (check_str "sorted"
    (entries_text (fv_stat_entries (cons (FsStat "notes" 10) (cons (FsStat "b/" 0) (cons (FsStat "a.app/" 0) (cons (FsStat "run" 99) (nil FsStat)))))
                                   (cons "run" (nil (list int)))))
    "b:d a.app:a notes:f:10 run:x:99 "))

; Each volume with its size beside it, sorted by name.
(def test_volume_entries () int
  (check_str "each a volume"
    (entries_text (fv_volume_entries (split_spaces "/Volumes/scratch /Volumes/data") (cons 100 (cons 200 (nil int)))))
    "data:v:200 scratch:v:100 "))

; An icon.draw's commands: a comment and a blank line left out, and a
; line that is no command; the square and the icon kept.
(def test_draws_of () int
  (let ds (fv_draws_of "# Files' icon\nround 0 0 48 48 10 blue_3\n\nnope 1 2\nicon 8 8 folder 2 white\n")
    (add (check_int "two" (length ds) 2)
         (check_bool "the square first" (match (head ds) ((UiDrawRound x y w h r c) (eq w 48)) ((UiDrawIcon x y n sc c) false)
                                          ((UiDrawButton x y k l) false) ((UiDrawBasic cmd) false)) true))))

(def test_join_parent () int
  (add (check_str "in /" (fv_join "/" "bin") "/bin")
       (add (check_str "deeper" (fv_join "/Volumes/data" "a") "/Volumes/data/a")
            (add (check_str "up from /bin" (fv_parent "/bin") "/")
                 (check_str "up from a volume" (fv_parent "/Volumes/data") "/Volumes")))))

; The path bar's parts, and where each goes.
(def test_crumbs () int
  (add (check_strs "/" (fv_crumbs "/") (split_spaces "Computer"))
       (add (check_strs "a volume's folder" (fv_crumbs "/Volumes/data/a") (split_spaces "Computer Volumes data a"))
            (add (check_str "part 0" (fv_at_depth "/Volumes/data/a" 0) "/")
                 (add (check_str "part 2" (fv_at_depth "/Volumes/data/a" 2) "/Volumes/data")
                      (check_str "past the end" (fv_at_depth "/Volumes/data" 9) "/Volumes/data"))))))

; Renamed data notes: its paths are notes's; the like-named datum's are
; not.
(def test_relabelled () int
  (add (check_str "the volume" (fv_relabelled "/Volumes/data" "data" "notes") "/Volumes/notes")
       (add (check_str "in it" (fv_relabelled "/Volumes/data/a/b" "data" "notes") "/Volumes/notes/a/b")
            (add (check_str "another" (fv_relabelled "/Volumes/datum" "data" "notes") "/Volumes/datum")
                 (check_str "not a volume's" (fv_relabelled "/etc" "data" "notes") "/etc")))))

(def test_name_ok () int
  (add (check_bool "a name" (fv_name_ok "notes.txt") true)
       (add (check_bool "empty" (fv_name_ok "") false)
            (add (check_bool "a slash" (fv_name_ok "a/b") false)
                 (check_bool "dot dot" (fv_name_ok "..") false)))))

(def test_is_volume () int
  (add (check_bool "a volume" (fv_is_volume "/Volumes/data") true)
       (add (check_bool "in one" (fv_is_volume "/Volumes/data/a") false)
            (check_bool "the volumes" (fv_is_volume "/Volumes") false))))

; Lines: a tab to the next stop of 8, a carriage return dropped, a byte
; past ASCII a dot, the last line without its newline.
(def test_text_lines () int
  (check_strs "two"
    (fv_text_lines (append "a\tb\r\n" (cons 200 (cons 99 (nil int)))))
    (cons "a       b" (cons ".c" (nil (list int))))))

; The initramfs and /Volumes cannot be changed; under l0 test there is
; no system volume, so / is the initramfs.
(def test_fixed () int
  (add (check_str "the initramfs" (fv_fixed_why "/etc") "the system's files cannot be changed")
       (add (check_str "the volumes" (fv_fixed_why "/Volumes") "volumes are made in Disks")
            (check_str "a volume's" (fv_fixed_why "/Volumes/data") ""))))
