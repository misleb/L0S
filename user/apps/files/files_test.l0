; files_test.l0 -- tests of Files' state, as its actions change it, and
; of what it shows.

(def none () UiEvent (UiOther 0 ""))

; / as an initramfs lists it: three folders, and a file.
(def root () (list FvEntry)
  (cons (FvEntry "bin" (FvDir) -1) (cons (FvEntry "etc" (FvDir) -1) (cons (FvEntry "Volumes" (FvDir) -1) (cons (FvEntry "motd" (FvText) -1) (nil FvEntry))))))

(def start () Files (fl_new (root) (fl_place_rows (split_spaces "/Volumes/data") (split_spaces "1.0 MB free") (no_images)) (no_images)))

; No full-color icons, as on this host, where there is no /etc/images.
(def no_images () UiImages (ui_images_none))

; One image, a 1 by 1 table; and full-color icons of a folder and a
; drive, both that image.
(def one_image () (list UiCov) (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov)))
(def images () UiImages (ui_images_with (ui_images_with (ui_images_none) "folder" (one_image)) "drive-harddisk" (one_image)))

(def after_all ((m Files) (actions (list (list int)))) Files
  (if (is_empty actions) m (after_all (fl_update m (head actions) (none)) (tail actions))))

(def test_new () int
  (add (check_str "at /" (fl_dir (start)) "/")
       (check_str "its line" (fl_status (start)) "4 items")))

; Selected by a click, in both views; and the line says so.
(def test_select () int
  (let m (fl_update (start) "files.select.etc" (none))
    (add (check_str "selected" (fl_selected m) "etc")
         (add (check_str "the line" (fl_status m) "\"etc\" selected")
              (check_str "the list's too" (ui_gs_selected (match m ((Files d es v is gs bk fw ov mn st pl ic wk) gs))) "etc")))))

; A press between the tiles selects nothing.
(def test_deselect () int
  (check_str "none" (fl_selected (after_all (start) (split_spaces "files.select.etc files.scroll.0.0.3.96"))) ""))

(def view_name ((m Files)) (list int) (match (fl_view_of m) ((FlGrid) "grid") ((FlList) "list")))

; The toggle shows the list, and the menu's item the other again.
(def test_toggle () int
  (add (check_str "the list" (view_name (fl_update (start) "view.select.list" (none))) "list")
       (check_str "back by the menu" (view_name (after_all (start) (split_spaces "view.select.list app.view"))) "grid")))

(def menu_name ((m Files)) (list int)
  (match (fl_menu_of m) ((FlNoMenu) "none") ((FlMainMenu) "main") ((FlContext x y k) (append "context " k))))

; The menu button opens and closes the menu; a press outside it closes
; it.
(def test_main_menu () int
  (add (check_str "open" (menu_name (fl_update (start) "app.menu" (none))) "main")
       (add (check_str "closed again" (menu_name (after_all (start) (split_spaces "app.menu app.menu"))) "none")
            (check_str "dismissed" (menu_name (after_all (start) (split_spaces "app.menu menu.dismiss"))) "none"))))

; A right click on a tile selects it and opens its menu there; on the
; ground, the place's; on a volume's row, the volume's; on a button,
; none.
(def test_context () int
  (add (check_str "a tile" (menu_name (fl_update (start) (ui_context_action 30 40 "files.select.etc") (none))) "context etc")
       (add (check_str "selected" (fl_selected (fl_update (start) (ui_context_action 30 40 "files.select.etc") (none))) "etc")
            (add (check_str "the ground" (menu_name (fl_update (start) (ui_context_action 30 40 "files.scroll.0.0.3.96") (none))) "context ")
                 (add (check_str "a volume" (menu_name (fl_update (start) (ui_context_action 30 40 "side.select./Volumes/data") (none))) "context /Volumes/data")
                      (check_str "a button" (menu_name (fl_update (start) (ui_context_action 30 40 "app.back") (none))) "none"))))))

; A dialog's entry takes what is typed: a, then b.
(def test_typed () int
  (let m (fl_with_over (start) (FlNewFolder (UiEntryText "" 0)))
    (let m2 (fl_update (fl_update m "name.edit" (UiKey (KeyEvent 30 1 97 0))) "name.edit" (UiKey (KeyEvent 48 1 98 0)))
      (match (fl_over m2)
        ((FlNewFolder t) (check_str "typed" (ui_entry_text t) "ab"))
        ((FlNone) (fail_because "typed" "no dialog")) ((FlRename o t) (fail_because "typed" "rename"))
        ((FlDelete n) (fail_because "typed" "delete")) ((FlPreview n l p) (fail_because "typed" "preview"))
        ((FlListing d b f t got) (fail_because "typed" "listing"))))))

; A folder on a volume is listed by asking its file server: the state
; waits for the reply, the place as it was; one of the initramfs is
; listed at once.
(def test_go_asks () int
  (add (check_bool "a volume's" (fl_by_server "/Volumes/data/docs") true)
       (add (check_bool "/Volumes" (fl_by_server "/Volumes") false)
            (check_str "waiting" (match (fl_over (fl_go (start) "/Volumes/data" (nil (list int)) (nil (list int))))
                                   ((FlListing d b f t got) d) ((FlNone) "none") ((FlNewFolder e) "dialog") ((FlRename o e) "dialog")
                                   ((FlDelete n) "dialog") ((FlPreview n l p) "preview"))
                       "/Volumes/data"))))

; The request of a listing, from the start and from entry 40.
(def test_list_body () int
  (add (check_str "first" (fl_list_body "/Volumes/data/docs" 0) "list /Volumes/data/docs")
       (check_str "more" (fl_list_body "/Volumes/data/docs" 40) "list /Volumes/data/docs 40")))

; A tag says its window; two tags of a window differ by their count.
(def test_tag () int
  (check_int "window 3" (fl_tag_window (fl_tag 3)) 3))

; A reply to a listing: the entries, a folder, a document and an app,
; shown, the document and the app still to look at, a piece of idle
; work each, the folder not.
(def listing () Files (fl_with_over (start) (FlListing "/Volumes/data" (nil (list int)) (nil (list int)) 77 (nil FsStat))))

(def test_listing_reply () int
  (match (fl_listing_reply (files_app) (listing) 77 (message_new 30 (fs_reply_bytes 3 "docs/ 0\nnotes 12\nTerm.app/ 0\n")))
    ((FlAsked a m)
      (add (check_str "shown" (fl_dir m) "/Volumes/data")
           (add (check_int "three things" (length (fl_entries m)) 3)
                (check_bool "work to do" (fl_has_work m) true))))))

; A reply of another listing's tag changes nothing.
(def test_listing_reply_stale () int
  (match (fl_listing_reply (files_app) (listing) 78 (message_new 30 (fs_reply_bytes 1 "x 1\n")))
    ((FlAsked a m) (check_str "still /" (fl_dir m) "/"))))

; An app of no windows, for the replies.
(def files_app () UiApp (UiApp (Compositor 1 2 9 1) 4 (ui_face_none) ((MapEmpty int UiWin)) true (ui_loop_new)))

; A name may be anything but its own, and in /Volumes only a label.
(def test_rename_ok () int
  (add (check_bool "a new name" (fl_rename_ok (start) "motd" "message") true)
       (add (check_bool "its own" (fl_rename_ok (start) "motd" "motd") false)
            (add (check_bool "a label in /Volumes" (fl_rename_ok (fl_at (start) "/Volumes" (nil FvEntry) (nil (list int)) (nil (list int))) "data" "notes") true)
                 (check_bool "not a label" (fl_rename_ok (fl_at (start) "/Volumes" (nil FvEntry) (nil (list int)) (nil (list int))) "data" "a.b") false)))))

; The sidebar: the computer, the volumes, and each volume, its line how
; much is free; the place of a path in it.
(def test_places () int
  (let rows (fl_place_rows (split_spaces "/Volumes/data") (split_spaces "1.0 MB") (no_images))
    (add (check_int "three" (length rows) 3)
         (add (check_str "a volume's place" (fl_place_of "/Volumes/data/a") "/Volumes/data")
              (add (check_str "the volumes'" (fl_place_of "/Volumes") "/Volumes")
                   (check_str "the computer's" (fl_place_of "/etc") "/"))))))

(def test_count_text () int
  (add (check_str "one" (fl_count_text (cons (FvEntry "a" (FvText) 1) (nil FvEntry)) "") "1 item")
       (check_str "none" (fl_count_text (nil FvEntry) "") "0 items")))

; An empty folder shows its page, not tiles; a full one, its tiles.
(def test_empty_page () int
  (add (check_bool "empty" (eq (fl_body (fl_at (start) "/Volumes/data" (nil FvEntry) (nil (list int)) (nil (list int))))
                               (UiView (UiStatusPage "folder" "Folder is Empty" "")))
                   true)
       (check_bool "full, keyed by what it shows" (eq (fl_body (start)) (UiKeyed (fl_items_key (start)) (UiIconView (fl_icon_data (start))))) true)))

; A window of nothing laid out, for what a key does.
(def key_win () UiWin
  (UiWin (Compositor 1 2 9 1) 3 (Canvas (IoDevice 0) 100 34 0) 4 (ui_face_none) (ui_state_new (UiLight)) (nil UiNode)
         0 0 (ui_click_none) (UiMem 0 1 100 34 (UiNoSwap) (ui_db_new 0)) false false (ui_loop_new)))

; What key code with the modifiers mods does in Files at /, as text: its
; action, or "moved".
(def keyed_text ((code int) (mods int)) (list int)
  (match (fl_keyed (start) code mods (key_win)) ((FlKeyAction a) a) ((FlKeyMoved m) "moved")))

; Alt-Left (105) and Alt-Right (106) go back and forward, as the header
; bar's buttons; Left alone moves the selection; Alt-Down nothing but
; stays.
(def test_alt_arrows () int
  (add (check_str "alt-left" (keyed_text (ui_key_left) (key_mod_alt)) "app.back")
       (add (check_str "alt-right" (keyed_text (ui_key_right) (key_mod_alt)) "app.forward")
            (add (check_str "left" (keyed_text (ui_key_left) 0) "moved")
                 (check_str "alt-down" (keyed_text (ui_key_down) (key_mod_alt)) "moved")))))

; Backspace alone goes back too, but not with Ctrl; Enter opens.
(def test_backspace_back () int
  (add (check_str "backspace" (keyed_text 14 0) "app.back")
       (add (check_bool "ctrl-backspace does not" (fl_goes_back 14 (key_mod_ctrl)) false)
            (add (check_bool "alt-left does" (fl_goes_back (ui_key_left) (key_mod_alt)) true)
                 (check_str "enter" (keyed_text (ui_key_enter) 0) "app.open")))))

; The items' key changes with what they show: the same state the same
; key, the same things in another folder another.
(def test_items_key () int
  (let m (start)
    (add (check_str "the same" (fl_items_key m) (fl_items_key (start)))
         (check_true "another folder" (not (eq (fl_items_key m) (fl_items_key (fl_at m "/bin" (fl_entries m) (nil (list int)) (nil (list int))))))))))

; Laid out 880 by 560, the window's two header bars drag it, and the
; place's closes it; the path bar's Computer is where it is, no target.
(def test_view_targets () int
  (let ns (ui_layout_window (fl_view (start)) 880 560 (ui_state_new (UiLight)))
    (add (check_str "the sidebar's bar drags" (ui_hit ns 100 20) "win.move")
         (add (check_str "the place's too" (ui_hit ns 300 5) "win.move")
              (add (check_str "its close button" (ui_hit ns 860 22) "win.close")
                   (check_str "a tile" (ui_hit ns 300 120) "files.select.bin"))))))

; dark_3, Terminal's square's color.
(def dark_3 () int (match (ui_color_named "dark_3") ((Some c) c) ((None) -1)))

; Terminal's icon.draw, as its bundle holds it.
(def terminal_app () FvKind (FvApp (FvDrawn (fv_draws_of "round 0 0 48 48 10 dark_3\nicon 8 8 utilities-terminal 2 white\n"))))

; An app whose icon.face holds one image, a 1 by 1 table.
(def image_app () FvKind (FvApp (FvImage (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov)))))

; An app with images is drawn from them: its tile 48 square, its row's
; icon 16 beside its name.
(def test_app_image () int
  (add (check_bool "tile" (eq (fl_tile "Files.app" (image_app) (no_images))
                              (UiTileDrawn "Files.app" (cons (UiPImage 0 0 48 false (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov))) (nil UiPaint)) "Files.app"))
                   true)
       (check_bool "cell" (eq (fl_cell_icon "Files.app" (image_app) (no_images)) (UiCellImage (cons (UiCov 1 1 (array_new 1 0)) (nil UiCov)) "Files.app")) true)))

; With full-color icons, a folder's tile and row are its image, as
; Nautilus shows one; a file whose icon was not loaded, its symbolic.
(def test_thing_images () int
  (add (check_bool "folder tile" (eq (fl_tile "a" (FvDir) (images)) (UiTileDrawn "a" (cons (UiPImage 0 0 48 false (one_image)) (nil UiPaint)) "a")) true)
       (add (check_bool "folder row" (eq (fl_cell_icon "a" (FvDir) (images)) (UiCellImage (one_image) "a")) true)
            (check_bool "text" (eq (fl_cell_icon "t" (FvText) (images)) (UiCellIcon "text-x-generic" "t")) true))))

; The sidebar's rows carry their icons' images: a volume a drive's;
; the computer none, as it was not loaded.
(def side_images ((rows (list UiSideRow))) (list int)
  (if (is_empty rows)
      ""
      (match (head rows)
        ((UiSideRow k i t s ts) (append (digits (length ts)) (side_images (tail rows)))))))

(def test_place_images () int
  (check_str "computer, volumes, data" (side_images (fl_place_rows (split_spaces "/Volumes/data") (split_spaces "1.0 MB") (images))) "001"))

; An app's tile is its own drawing, its square then its icon; one with no
; icon.draw, and a folder, a symbolic icon.
(def test_app_tile () int
  (add (check_bool "drawn" (eq (fl_tile "Terminal.app" (terminal_app) (no_images))
                               (UiTileDrawn "Terminal.app" (cons (UiPRound (Rect 0 0 48 48) 10 (dark_3) -1)
                                                                 (cons (UiPIcon 8 8 "utilities-terminal" (ui_white) 2) (nil UiPaint)))
                                            "Terminal.app"))
                   true)
       (add (check_bool "no icon.draw" (eq (fl_tile "X.app" (FvApp (FvDrawn (nil UiDraw))) (images)) (UiTile "X.app" "view-app-grid" "X.app" (UiNeutral))) true)
            (check_bool "a folder" (eq (fl_tile "a" (FvDir) (no_images)) (UiTile "a" "folder" "a" (UiAccentTone))) true))))

; In the list, an app is its icon in its square's color.
(def test_app_cell () int
  (check_bool "tinted" (eq (fl_cell_icon "Terminal.app" (terminal_app) (no_images)) (UiCellTinted "utilities-terminal" (dark_3) "Terminal.app")) true))

; System Monitor's light square would not show on white: its pulse is in
; its own green.
(def test_light_app_cell () int
  (let k (FvApp (FvDrawn (fv_draws_of "round 0 0 48 48 10 light_2\nicon 8 8 utilities-system-monitor 2 green_5\n")))
    (check_bool "green" (eq (fl_cell_icon "Monitor.app" k (no_images))
                            (UiCellTinted "utilities-system-monitor" (match (ui_color_named "green_5") ((Some c) c) ((None) -1)) "Monitor.app"))
                true)))

; Sizes: a file's bytes, a folder's things, one or many, and none known.
(def test_size_cell () int
  (add (check_bool "bytes" (eq (fl_size_cell (FvText) 1500) (UiCellSize 1500)) true)
       (add (check_bool "things" (eq (fl_size_cell (FvDir) 3) (UiCellNum 3 " items")) true)
            (add (check_bool "one" (eq (fl_size_cell (FvDir) 1) (UiCellNum 1 " item")) true)
                 (check_bool "unknown" (eq (fl_size_cell (FvText) -1) (UiCellText "")) true)))))

; The menu button's items' actions, separators as -.
(def item_actions ((items (list UiMenuItem))) (list int)
  (if (is_empty items)
      ""
      (append (match (head items) ((UiItem a l s) a) ((UiItemSep) "-")) (append " " (item_actions (tail items))))))

; New Window beside New Folder..., before the line.
(def test_main_items_new_window () int
  (check_str "the menu" (item_actions (fl_main_items (start))) "app.newfolder app.newwindow - app.refresh app.view "))

; A new window's state is at the place the other shows, with its view,
; but nothing selected, no menu open, and no Back.
(def test_twin () int
  (let m (fl_with_menu (fl_viewed (fl_update (fl_go_test) "files.select.a" (none)) (FlList)) (FlMainMenu))
    (let n (fl_twin m)
      (add (check_str "the place" (fl_dir n) "/etc")
           (add (check_str "its view" (view_name n) "list")
                (add (check_str "nothing selected" (fl_selected n) "")
                     (check_bool "no menu, no Back" (if (eq (fl_menu_of n) (FlNoMenu)) (no_back n) false) true)))))))

; A state at /etc, gone there from /, so it has a Back.
(def fl_go_test () Files
  (fl_at (start) "/etc" (cons (FvEntry "a" (FvText) 3) (nil FvEntry)) (cons "/" (nil (list int))) (nil (list int))))

; Whether m has no place to go Back to.
(def no_back ((m Files)) bool (match m ((Files d es v is gs bk fw ov mn st pl ic wk) (is_empty bk))))

; Whether an open's arguments name a folder: none, a URL and a file do
; not, so the window opens at /.
(def opens_at ((argv (list (list int)))) (list int)
  (match (fl_open_at argv) ((FlOpenAt dir es) dir) ((FlOpenListing dir) (append "ask " dir)) ((FlOpenNowhere) "-")))

(def test_open_at_nowhere () int
  (add (check_str "no argument" (opens_at (nil (list int))) "-")
       (check_str "a URL" (opens_at (split_spaces "http://example.com")) "-")))

; A folder on a volume an open names is asked of its file server, not
; listed in the step.
(def test_open_at_volume () int
  (check_str "asked" (opens_at (split_spaces "/Volumes/data/many")) "ask /Volumes/data/many"))

; An open that names no folder leaves the state where it is.
(def test_placed_nowhere () int
  (check_str "the place" (fl_dir (fl_placed (fl_go_test) (nil (list int)))) "/etc"))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (files) 1))
