; files.l0 -- Files, as GNOME's Nautilus is in GNOME 45: a window that
; draws its own header bars (ui_open_csd). A sidebar of places, under a
; header bar of its own titled Files: the computer, /, the volumes, and
; each volume with how much of it is free. Beside it, the place shown,
; under a header bar holding Back and Forward, a path bar of where it is,
; a toggle between a grid of icons and a list, the menu, and the window's
; close button; and a line of what was last done at its foot.
;
; A click selects a thing, a double click or Enter opens it: a folder or
; a volume is gone into, an app's bundle or a program started, and any
; other file shown, its text, as a page over the place, until Back or
; Esc. A right click opens a menu of what can be done with what it is
; on, Open, Rename... and Delete, or with the place, New Folder...; the
; menu button's has New Folder..., New Window, Refresh and the other
; view. New Window opens another window at the same place, which then
; goes its own way; each window's state is kept by its id, all of them
; on one port (uiapp.l0), and Files ends as its last closes. F2
; renames, Delete deletes, Backspace goes back. Renaming a volume in
; /Volumes relabels it (fsview.l0's fv_rename), and what is shown under
; its old name is shown under its new. Each change is made by the file
; calls, or by the file server, and the place listed again after it.

; ------------------------------------------------------------------ model

; How the place shows what is in it: tiles in a grid, or rows of a list.
(data FlView (FlGrid) (FlList))

; What is over the place: nothing; a dialog asking a new folder's name,
; typed so far; one asking a new name for the thing named, typed so far;
; one asking whether to delete it; or a file's lines shown, its name, and
; the state of the grid they are rows of.
(data FlOver (FlNone) (FlNewFolder UiEntryText) (FlRename (list int) UiEntryText) (FlDelete (list int))
             (FlPreview (list int) (list (list int)) UiGridState))

; Which menu is open: none; the menu button's; or a right click's, where
; it was, for the thing named, "" for the place itself.
(data FlMenu (FlNoMenu) (FlMainMenu) (FlContext int int (list int)))

; The window's state: the place shown, what is in it, how it is shown,
; the icon view's and the list's states, which share the selected
; thing's name; the places Back and Forward go to, the nearest first;
; what is over it, the menu, the line of what was last done, the
; sidebar's rows, the full-color icons things are shown with; the
; things still to be looked at, by name, after a listing: whether each
; file is a program, each app's icon, a piece of idle work each; and
; its jobs, what it has asked its file server and waits for (FlJobs).
(data Files (Files (list int) (list FvEntry) FlView UiIconState UiGridState (list (list int)) (list (list int))
                   FlOver FlMenu (list int) (list UiSideRow) UiImages (list (list int)) FlJobs))

; The prefixes of the place's views, the sidebar's rows, the path bar's
; parts, the view's toggles, the menus and the dialog's entry.
(def fl_items () (list int) "files")
(def fl_side () (list int) "side")
(def fl_path () (list int) "path")
(def fl_toggle () (list int) "view")
(def fl_menu () (list int) "menu")
(def fl_entry () (list int) "name")
(def fl_preview () (list int) "preview")

; The place shown, what is in it, what is over it, the line, and the
; view.
(def fl_dir((m Files)) (list int) (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) d)))
(def fl_entries ((m Files)) (list FvEntry) (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) es)))
(def fl_over ((m Files)) FlOver (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) ov)))
(def fl_status ((m Files)) (list int) (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) st)))
(def fl_view_of ((m Files)) FlView (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) v)))

; The selected thing's name, "" for none.
(def fl_selected ((m Files)) (list int) (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (ui_is_selected is))))

; m with another line of what was last done.
(def fl_said ((m Files) (s (list int))) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (Files d es v is gs bk fw ov mn s pl ic wk jb))))

; m with another thing over it, and no menu.
(def fl_with_over ((m Files) (o FlOver)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (Files d es v is gs bk fw o (FlNoMenu) st pl ic wk jb))))

; m with another menu.
(def fl_with_menu ((m Files) (n FlMenu)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (Files d es v is gs bk fw ov n st pl ic wk jb))))

; m with name selected, in both views.
(def fl_selecting ((m Files) (name (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (match is
        ((UiIconState s f)
          (match gs
            ((UiGridState c desc s2 f2 l2) (Files d es v (UiIconState name f) (UiGridState c desc name f2 l2) bk fw ov mn st pl ic wk jb))))))))

; The entry named name, if one is.
(def fl_entry_named ((es (list FvEntry)) (name (list int))) (Option FvEntry)
  (if (is_empty es) ((None FvEntry)) (if (eq (fv_name (head es)) name) (Some (head es)) (fl_entry_named (tail es) name))))

; What the line says of a place's entries: how many, or the one
; selected.
(def fl_count_text ((es (list FvEntry)) (sel (list int))) (list int)
  (if (not (is_empty sel))
      (append "\"" (append sel "\" selected"))
      (let n (length es) (append (digits n) (if (eq n 1) " item" " items")))))

; A state showing dir, its entries es, as view shows them, after the one
; before, m, of which it keeps the view, Back, Forward and the sidebar.
(def fl_at ((m Files) (dir (list int)) (es (list FvEntry)) (back (list (list int))) (fwd (list (list int)))) Files
  (match m
    ((Files d old v is gs bk fw ov mn st pl ic wk jb)
      (Files dir es v (ui_icon_state_new) (ui_grid_state_new) back fwd (FlNone) (FlNoMenu) (fl_count_text es "") pl ic (nil (list int)) jb))))

; The first state: / shown, as listed, with the sidebar's rows, and
; the full-color icons im.
(def fl_new ((es (list FvEntry)) (rows (list UiSideRow)) (im UiImages)) Files
  (Files "/" es (FlGrid) (ui_icon_state_new) (ui_grid_state_new) (nil (list int)) (nil (list int)) (FlNone) (FlNoMenu)
         (fl_count_text es "") rows im (nil (list int)) (fl_jobs_none)))

; ---------------------------------------------------------------- places

; The sidebar's rows: the computer, /; the volumes; and each of vols,
; /Volumes/LABEL, with frees its line, how much of it is free; each
; with its full-color icon from im, if it has it.
(def fl_place_rows ((vols (list (list int))) (frees (list (list int))) (im UiImages)) (list UiSideRow)
  (cons (UiSideRow "/" "computer" "Computer" "The system's files" (ui_image im "computer"))
        (cons (UiSideRow "/Volumes" "drive-harddisk" "Volumes" (append (digits (length vols)) (if (eq (length vols) 1) " volume" " volumes"))
                         (ui_image im "drive-multidisk"))
              (fl_volume_rows vols frees im))))

; A row of each of vols, its line the one of frees beside it.
(def fl_volume_rows ((vols (list (list int))) (frees (list (list int))) (im UiImages)) (list UiSideRow)
  (if (is_empty vols)
      (nil UiSideRow)
      (cons (UiSideRow (head vols) "drive-harddisk" (base_name (head vols)) (if (is_empty frees) "" (head frees)) (ui_image im "drive-harddisk"))
            (fl_volume_rows (tail vols) (if (is_empty frees) frees (tail frees)) im))))

; The place of the sidebar dir is in: its volume's, /Volumes's, or the
; computer's.
(def fl_place_of ((dir (list int))) (list int)
  (if (fv_is_volumes dir) dir (if (starts_with dir "/Volumes/") (append "/Volumes/" (up_to 47 (drop_n dir 9))) "/")))

; How much of volume vol is free, as its line says: kB of its clusters.
(def fl_free_text ((space FsSpace)) (list int)
  (match space
    ((FsSpace sectors clusters free files) (append (format_size (mul free 4096)) " free"))
    ((FsSpaceRefused code) "")))

; ---------------------------------------------------------------- update

; The state after action, set off with ev, that needs no file calls: the
; selection, the views, the menus and the dialogs' entries. Opening,
; going places and changing files are fl_acted's.
(def fl_update ((m Files) (action (list int)) (ev UiEvent)) Files
  (match (ui_context_of action)
    ((Some c) (fl_context m c))
    ((None)
      (let sk (ui_select_key (fl_items) action)
        (if (not (is_empty sk))
            (fl_said (fl_with_menu (fl_selecting m sk) (FlNoMenu)) (fl_count_text (fl_entries m) sk))
            (fl_update_more m action ev))))))

; More of fl_update: the view toggled, the menus opened and closed.
(def fl_update_more ((m Files) (action (list int)) (ev UiEvent)) Files
  (let tk (ui_select_key (fl_toggle) action)
    (if (not (is_empty tk))
        (fl_viewed m (if (eq tk "list") (FlList) (FlGrid)))
        (if (eq action "app.menu")
            (fl_with_menu m (match (fl_menu_of m) ((FlMainMenu) (FlNoMenu)) ((FlNoMenu) (FlMainMenu)) ((FlContext x y k) (FlMainMenu))))
            (if (eq action (ui_menu_dismiss_action (fl_menu)))
                (fl_with_menu m (FlNoMenu))
                (if (eq action "app.view")
                    (fl_with_menu (fl_viewed m (match (fl_view_of m) ((FlGrid) (FlList)) ((FlList) (FlGrid)))) (FlNoMenu))
                    (fl_update_dialog m action ev)))))))

; The menu open.
(def fl_menu_of ((m Files)) FlMenu (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) mn)))

; m shown as view v.
(def fl_viewed ((m Files) (v FlView)) Files
  (match m ((Files d es old is gs bk fw ov mn st pl ic wk jb) (Files d es v is gs bk fw ov mn st pl ic wk jb))))

; A right click: on a thing in the place, it selected and its menu
; there; on the place's ground, or on nothing that does anything, as an
; empty folder's page, the place's menu; on a volume's row in the
; sidebar, that volume's; elsewhere, as on a button, nothing.
(def fl_context ((m Files) (c UiContextAt)) Files
  (match c
    ((UiContextAt x y t)
      (let sk (ui_select_key (fl_items) t)
        (if (not (is_empty sk))
            (fl_said (fl_with_menu (fl_selecting m sk) (FlContext x y sk)) (fl_count_text (fl_entries m) sk))
            (let side (ui_select_key (fl_side) t)
              (if (fv_is_volume side)
                  (fl_with_menu m (FlContext x y side))
                  (if (is_empty t)
                      (fl_with_menu m (FlContext x y ""))
                      (match (ui_scroll_of t)
                    ((UiScrollArea name f mo sh st) (if (eq name (fl_items)) (fl_with_menu m (FlContext x y "")) m))
                    ((UiScrollBar name f mo sp sl) m)
                    ((UiNoScroll) m))))))))))

; Typing in a dialog's entry, and the views' own actions: the icon
; view's and the list's selection and scrolling, the list's sorting, and
; the preview's scrolling.
(def fl_update_dialog ((m Files) (action (list int)) (ev UiEvent)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (match ov
        ((FlNewFolder t) (Files d es v is gs bk fw (FlNewFolder (ui_entry_update (fl_entry) t action ev)) mn st pl ic wk jb))
        ((FlRename old t) (Files d es v is gs bk fw (FlRename old (ui_entry_update (fl_entry) t action ev)) mn st pl ic wk jb))
        ((FlPreview name lines pg) (Files d es v is gs bk fw (FlPreview name lines (ui_grid_action pg (fl_preview) action)) mn st pl ic wk jb))
        ((FlDelete name) m)
        ((FlNone)
          (let is2 (ui_icon_action is (fl_items) action)
            (let gs2 (ui_grid_action gs (fl_items) action)
              (match v
                ((FlGrid) (fl_synced (Files d es v is2 gs bk fw ov mn st pl ic wk jb) (ui_is_selected is2)))
                ((FlList) (fl_synced (Files d es v is gs2 bk fw ov mn st pl ic wk jb) (ui_gs_selected gs2)))))))))))

; m with sel the selection of both views, and the line saying so if it
; changed.
(def fl_synced ((m Files) (sel (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (match is
        ((UiIconState s f)
          (match gs
            ((UiGridState c desc s2 f2 l2)
              (Files d es v (UiIconState sel f) (UiGridState c desc sel f2 l2) bk fw ov mn
                     (if (eq sel (ui_is_selected is)) st (fl_count_text es sel)) pl ic wk jb))))))))

; ------------------------------------------------------------------ keys

; Linux's codes for F2 and Backspace.
(def fl_key_f2 () int 60)
(def fl_key_backspace () int 14)

; What a key does with nothing over the place and no menu: Enter opens
; the selection, F2 renames it, Delete deletes it, Backspace and
; Alt-Left go back, Alt-Right forward, as Nautilus's do; the arrows,
; Home, End, Page Up and Page Down move it, scrolled into view as the
; window w shows the view. Its action, or "" and the state it moved to.
(data FlKeyed (FlKeyAction (list int)) (FlKeyMoved Files))

; What key code with the modifiers mods does in m, shown in w: with Alt
; held, only Left and Right do anything.
(def fl_keyed ((m Files) (code int) (mods int) (w UiWin)) FlKeyed
  (if (key_mods_are mods (key_mod_alt))
      (if (eq code (ui_key_left)) (FlKeyAction "app.back")
      (if (eq code (ui_key_right)) (FlKeyAction "app.forward")
      (FlKeyMoved m)))
      (fl_keyed_plain m code w)))

; Whether key code with the modifiers mods goes back: Backspace alone,
; or Alt-Left.
(def fl_goes_back ((code int) (mods int)) bool
  (if (key_mods_are mods (key_mod_alt))
      (eq code (ui_key_left))
      (if (key_mods_are mods 0) (eq code (fl_key_backspace)) false)))

; What key code does in m, shown in w, with no Alt held.
(def fl_keyed_plain ((m Files) (code int) (w UiWin)) FlKeyed
  (if (eq code (ui_key_enter)) (FlKeyAction "app.open")
  (if (eq code (fl_key_f2)) (FlKeyAction "app.rename")
  (if (eq code (ui_key_delete)) (FlKeyAction "app.delete")
  (if (eq code (fl_key_backspace)) (FlKeyAction "app.back")
  (FlKeyMoved (fl_moved m code w)))))))

; The selection moved by a key, in whichever view is shown.
(def fl_moved ((m Files) (code int) (w UiWin)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (match v
        ((FlGrid)
          (let is2 (ui_icon_key (fl_icon_data m) code (ui_win_scroller w (fl_items)) (ui_win_icon_cols w (fl_items)))
            (fl_synced (Files d es v is2 gs bk fw ov mn st pl ic wk jb) (ui_is_selected is2))))
        ((FlList)
          (let gs2 (ui_grid_key (fl_grid_view m) code (ui_win_scroller w (fl_items)))
            (fl_synced (Files d es v is gs2 bk fw ov mn st pl ic wk jb) (ui_gs_selected gs2))))))))

; ----------------------------------------------------------------- view

; The window: the sidebar's pane, a line, and the place's; under the
; menu, if one is open, or the dialog, if one is.
(def fl_view ((m Files)) UiWidget
  (let page (UiBox (UiH) 0 (cons (fl_side_pane m) (cons (UiSeparator (UiV)) (cons (UiExpand (fl_place_pane m)) (nil UiWidget)))))
    (match (fl_over m)
      ((FlNewFolder t) (UiModal page (fl_name_alert "New Folder" "Create" t (fv_name_ok (ui_entry_text t)))))
      ((FlRename old t) (UiModal page (fl_name_alert (append "Rename \"" (append old "\"")) "Rename" t (fl_rename_ok m old (ui_entry_text t)))))
      ((FlDelete name) (UiModal page (fl_delete_alert name)))
      ((FlPreview name lines pg) (fl_with_popover m page))
      ((FlNone) (fl_with_popover m page)))))

; page under the menu that is open, if one is.
(def fl_with_popover ((m Files) (page UiWidget)) UiWidget
  (match (fl_menu_of m)
    ((FlNoMenu) page)
    ((FlMainMenu) (UiPopover page (UiMenu (fl_menu) (UiBelow "app.menu") (fl_main_items m))))
    ((FlContext x y k) (UiPopover page (UiMenu (fl_menu) (UiAt x y) (fl_context_items m k))))))

; The menu button's: New Folder..., New Window, Refresh, and the view not
; shown.
(def fl_main_items ((m Files)) (list UiMenuItem)
  (cons (UiItem "app.newfolder" "New Folder..." (is_empty (fv_fixed_why (fl_dir m))))
        (cons (UiItem "app.newwindow" "New Window" true)
        (cons (UiItemSep)
              (cons (UiItem "app.refresh" "Refresh" true)
                    (cons (UiItem "app.view" (match (fl_view_of m) ((FlGrid) "Show as List") ((FlList) "Show as Grid")) true)
                          (nil UiMenuItem)))))))

; A right click's, for the thing named k, or the place for "": Open,
; Rename... and Delete, each only where it can be done; or New Folder...
; A volume's row in the sidebar has Open and Rename...
(def fl_context_items ((m Files) (k (list int))) (list UiMenuItem)
  (if (is_empty k)
      (cons (UiItem "app.newfolder" "New Folder..." (is_empty (fv_fixed_why (fl_dir m)))) (nil UiMenuItem))
      (if (starts_with k "/")
          (cons (UiItem (ui_select_action "go" k) "Open" true)
                (cons (UiItem (ui_select_action "relabel" k) "Rename..." true) (nil UiMenuItem)))
          (let fixed (not (is_empty (fv_fixed_why (fl_dir m))))
            (cons (UiItem "app.open" "Open" true)
                  (cons (UiItemSep)
                        (cons (UiItem "app.rename" "Rename..." (if fixed (fv_is_volumes (fl_dir m)) true))
                              (cons (UiItem "app.delete" "Delete" (not fixed)) (nil UiMenuItem)))))))))

; A dialog asking for a name, titled title, its button labelled verb,
; live if ok.
(def fl_name_alert ((title (list int)) (verb (list int)) (t UiEntryText) (ok bool)) UiWidget
  (ui_alert_form title (nil (list int))
    (cons (UiProps (cons (UiProp "Name" (UiEntry (fl_entry) t "" (fl_entry_w))) (nil UiProp))) (nil UiWidget))
    (cons (fl_cancel) (cons (UiButton "dialog.ok" "" verb (UiBtnSuggested) ok) (nil UiWidget)))))

; How wide a name's entry is: 24 of the face's widest characters, and
; its edges.
(def fl_entry_w () int (add (ui_chars_w 24 (ui_text_font) false) (add (mul 2 (ui_entry_pad)) (ui_entry_cursor_w))))

; Whether old may be renamed new where m is: a name, or in /Volumes a
; label, other than the one it has.
(def fl_rename_ok ((m Files) (old (list int)) (new (list int))) bool
  (if (eq old new) false (if (fv_is_volumes (fl_dir m)) (label_ok new) (fv_name_ok new))))

; The dialog asking whether to delete name.
(def fl_delete_alert ((name (list int))) UiWidget
  (ui_alert (append "Delete \"" (append name "\"?")) (cons "It will be gone for good." (nil (list int)))
            (cons (fl_cancel) (cons (UiButton "dialog.ok" "" "Delete" (UiBtnDestructive) true) (nil UiWidget)))))

; A dialog's Cancel.
(def fl_cancel () UiWidget (UiButton "dialog.cancel" "" "Cancel" (UiBtnRegular) true))

; The sidebar's pane: its header bar, titled Files, and the places, the
; one the place shown is in selected.
(def fl_side_pane ((m Files)) UiWidget
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (UiBox (UiV) 0
        (cons (UiCsdBar (nil UiWidget) (UiLabel "Files" (UiHeading) (UiCenter)) (nil UiWidget) false)
              (cons (UiExpand (UiSidebar (ui_sidebar_w) pl (fl_side) (fl_place_of d))) (nil UiWidget)))))))

; The place's pane: its header bar, then what is in the place, or the
; file shown, then the line of what was done.
(def fl_place_pane ((m Files)) UiWidget
  (UiBox (UiV) 0
    (cons (fl_header m)
          (cons (UiExpand (fl_body m))
                (cons (UiSeparator (UiH))
                      (cons (UiPad (ui_space_m) (ui_space_s) (UiLabel (fl_status m) (UiDimmed) (UiStart))) (nil UiWidget)))))))

; The place's header bar: Back and Forward, the path bar, the toggle of
; the views, the menu button, and the window's close button.
(def fl_header ((m Files)) UiWidget
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (let preview (match ov ((FlPreview n l p) true) ((FlNone) false) ((FlNewFolder t) false) ((FlRename o t) false) ((FlDelete n) false))
        (UiCsdBar (cons (UiButton "app.back" "go-previous" "" (UiBtnFlat) (if preview true (not (is_empty bk))))
                        (cons (UiButton "app.forward" "go-next" "" (UiBtnFlat) (if preview false (not (is_empty fw)))) (nil UiWidget)))
                  (UiPathBar (fl_path) (if preview (append (fv_crumbs d) (cons (fl_preview_name ov) (nil (list int)))) (fv_crumbs d)))
                  (cons (UiToggleGroup (fl_toggle) (fl_toggles) (match v ((FlGrid) "grid") ((FlList) "list")))
                        (cons (UiButton "app.menu" "open-menu" "" (UiBtnFlat) true) (nil UiWidget)))
                  true)))))

; The name of the file shown, if one is.
(def fl_preview_name ((ov FlOver)) (list int)
  (match ov ((FlPreview n l p) n) ((FlNone) "") ((FlNewFolder t) "") ((FlRename o t) "") ((FlDelete n) "")))

; The view's toggles: the grid, and the list.
(def fl_toggles () (list UiToggle)
  (cons (UiToggle "grid" "view-grid" "") (cons (UiToggle "list" "view-list" "") (nil UiToggle))))

; What is in the place: its file shown, a page of an empty folder, its
; tiles, or its rows.
(def fl_body ((m Files)) UiWidget
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (match ov
        ((FlPreview name lines pg) (UiGrid (fl_preview_view name lines pg)))
        ((FlNone) (fl_place_body m))
        ((FlNewFolder t) (fl_place_body m))
        ((FlRename o t) (fl_place_body m))
        ((FlDelete n) (fl_place_body m))))))

; What is in the place itself: its tiles or its rows, keyed by what
; they show (fl_items_key), so a hover over the header bar or the
; sidebar lays them out no more.
(def fl_place_body ((m Files)) UiWidget
  (if (is_empty (fl_entries m))
      (UiView (UiStatusPage "folder" "Folder is Empty" ""))
      (UiKeyed (fl_items_key m)
        (match (fl_view_of m)
          ((FlGrid) (UiIconView (fl_icon_data m)))
          ((FlList) (UiGrid (fl_grid_view m)))))))

; What the place's tiles or rows show, as a key: its folder, each entry's
; name, kind and size, how they are viewed, and the icon view's and the
; grid's state; not the icons, whose pixels a hash would read whole.
(def fl_items_key ((m Files)) (list int)
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (append "items." (digits (hash (FlItemsKey d (fl_entry_keys es (nil (list int))) (fl_view_of m) is gs)))))))

; What fl_items_key hashes.
(data FlItemsKey (FlItemsKey (list int) (list (list int)) FlView UiIconState UiGridState))

; Each of es as its name, its kind's number and its size, onto the
; reversed acc.
(def fl_entry_keys ((es (list FvEntry)) (acc (list (list int)))) (list (list int))
  (if (is_empty es)
      (rev acc)
      (match (head es)
        ((FvEntry n k s)
          (fl_entry_keys (tail es) (cons (append n (append "/" (append (digits (fl_kind_n k)) (append "/" (digits s))))) acc))))))

; A kind as a number, for a key.
(def fl_kind_n ((k FvKind)) int
  (match k ((FvDir) 0) ((FvVolume) 1) ((FvApp a) 2) ((FvProgram) 3) ((FvText) 4)))

; The tiles of m's entries.
(def fl_icon_data ((m Files)) UiIconData
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (UiIconData (fl_items) (fl_tiles es ic) is))))

; A tile of each of es, its icon from im: a thing's full-color icon, as
; Nautilus shows it; an app's its own, as the launcher shows it.
(def fl_tiles ((es (list FvEntry)) (im UiImages)) (list UiTile)
  (if (is_empty es)
      (nil UiTile)
      (match (head es)
        ((FvEntry n k s) (cons (fl_tile n k im) (fl_tiles (tail es) im))))))

; The tile of name, of kind k: its icon drawn, or, with none, the
; symbolic one, a place's in the accent, as Adwaita's folders are blue.
(def fl_tile ((name (list int)) (k FvKind) (im UiImages)) UiTile
  (let ops (fl_icon_ops k im)
    (if (is_empty ops)
        (UiTile name (fl_icon k) name (if (fv_is_place k) (UiAccentTone) (UiNeutral)))
        (UiTileDrawn name ops name))))

; What a thing's icon paints, 48 square from 0, 0: an app's image, or
; its drawing commands' ops; anything else's full-color icon from im;
; none for an app with no icon, or an icon im has not.
(def fl_icon_ops ((k FvKind) (im UiImages)) (list UiPaint)
  (match k
    ((FvApp i)
      (match i
        ((FvImage ts) (fl_image_ops ts))
        ((FvDrawn ds) (fl_draws_ops ds))))
    ((FvDir) (fl_image_ops (ui_image im (fl_icon k)))) ((FvVolume) (fl_image_ops (ui_image im (fl_icon k))))
    ((FvProgram) (fl_image_ops (ui_image im (fl_icon k)))) ((FvText) (fl_image_ops (ui_image im (fl_icon k))))))

; Images ts painted 48 square from 0, 0; nothing for none.
(def fl_image_ops ((ts (list UiCov))) (list UiPaint)
  (if (is_empty ts) (nil UiPaint) (cons (UiPImage 0 0 (ui_tile_icon) false ts) (nil UiPaint))))

; What each of ds paints, in order.
(def fl_draws_ops ((ds (list UiDraw))) (list UiPaint)
  (if (is_empty ds) (nil UiPaint) (append (ui_draw_ops (head ds)) (fl_draws_ops (tail ds)))))

; An app's icon in a list, 16 square: its image; or the symbolic icon
; its icon.draw puts on its square, in the square's color, as the square
; cannot be drawn that small with the icon on it, or in its own color if
; the square is too light to show on the list's ground; the generic app
; icon if it has none. Anything else's full-color icon from im, or its
; symbolic one if im has not that.
(def fl_cell_icon ((name (list int)) (k FvKind) (im UiImages)) UiCell
  (match k
    ((FvApp i)
      (match i
        ((FvImage ts) (fl_cell_image name (fl_icon k) ts))
        ((FvDrawn ds) (fl_cell_drawn name k ds))))
    ((FvDir) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))
    ((FvVolume) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))
    ((FvProgram) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))
    ((FvText) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))))

; A cell of name beside images ts, or symbolic icon if there are none.
(def fl_cell_image ((name (list int)) (icon (list int)) (ts (list UiCov))) UiCell
  (if (is_empty ts) (UiCellIcon icon name) (UiCellImage ts name)))

; An app's icon in a list from its icon.draw's commands ds.
(def fl_cell_drawn ((name (list int)) (k FvKind) (ds (list UiDraw))) UiCell
  (let glyph (fl_draws_glyph ds)
    (if (is_empty glyph)
        (UiCellIcon (fl_icon k) name)
        (let sq (fl_draws_color ds (ui_accent_bg))
          (UiCellTinted glyph (if (fl_is_light sq) (fl_draws_glyph_color ds sq) sq) name)))))

; The first icon ds draw, "" for none; and the color of the first square,
; or c.
(def fl_draws_glyph ((ds (list UiDraw))) (list int)
  (if (is_empty ds)
      ""
      (match (head ds)
        ((UiDrawIcon x y name sc c) name)
        ((UiDrawRound x y w h r c) (fl_draws_glyph (tail ds)))
        ((UiDrawButton x y k l) (fl_draws_glyph (tail ds)))
        ((UiDrawBasic cmd) (fl_draws_glyph (tail ds))))))
(def fl_draws_color ((ds (list UiDraw)) (c int)) int
  (if (is_empty ds)
      c
      (match (head ds)
        ((UiDrawRound x y w h r col) col)
        ((UiDrawIcon x y name sc col) (fl_draws_color (tail ds) c))
        ((UiDrawButton x y k l) (fl_draws_color (tail ds) c))
        ((UiDrawBasic cmd) (fl_draws_color (tail ds) c)))))

; The color of the first icon ds draw, or c.
(def fl_draws_glyph_color ((ds (list UiDraw)) (c int)) int
  (if (is_empty ds)
      c
      (match (head ds)
        ((UiDrawIcon x y name sc col) col)
        ((UiDrawRound x y w h r col) (fl_draws_glyph_color (tail ds) c))
        ((UiDrawButton x y k l) (fl_draws_glyph_color (tail ds) c))
        ((UiDrawBasic cmd) (fl_draws_glyph_color (tail ds) c)))))

; Whether c is light: its luma, ITU-R 601's, over 200 of 255, as Adwaita's
; light_ colors are and its darker ones not.
(def fl_is_light ((c int)) bool
  (gt (div (add (mul (rgb_red c) 299) (add (mul (rgb_green c) 587) (mul (rgb_blue c) 114))) 1000) 200))

; A thing's icon, and the word for what it is.
(def fl_icon ((k FvKind)) (list int)
  (match k ((FvDir) "folder") ((FvVolume) "drive-harddisk") ((FvApp ds) "view-app-grid") ((FvProgram) "application-x-executable") ((FvText) "text-x-generic")))
(def fl_kind_word ((k FvKind)) (list int)
  (match k ((FvDir) "Folder") ((FvVolume) "Volume") ((FvApp ds) "App") ((FvProgram) "Program") ((FvText) "Document")))

; What a thing's size says in the list: a file's or a volume's bytes, as
; format_size says them; how many things a folder or a bundle holds;
; nothing if it is not known.
(def fl_size_cell ((k FvKind) (s int)) UiCell
  (if (lt s 0)
      (UiCellText "")
      (if (fv_is_holder k) (UiCellNum s (if (eq s 1) " item" " items")) (UiCellSize s))))

; The list of m's entries: Name, its icon beside it, Size and Kind.
(def fl_grid_view ((m Files)) UiGridView
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (UiGridView (fl_items)
                  (cons (UiColumn "Name" 0 (UiStart) true) (cons (UiColumn "Size" 100 (UiEnd) true) (cons (UiColumn "Kind" 120 (UiStart) true) (nil UiColumn))))
                  (fl_rows es ic) gs))))

; A row of each of es, keyed by its name: its icon, from im, and name,
; its size as fl_size_cell says it, and what it is.
(def fl_rows ((es (list FvEntry)) (im UiImages)) (list UiRow)
  (if (is_empty es)
      (nil UiRow)
      (match (head es)
        ((FvEntry n k s)
          (cons (UiRow n (cons (fl_cell_icon n k im) (cons (fl_size_cell k s) (cons (UiCellText (fl_kind_word k)) (nil UiCell)))))
                (fl_rows (tail es) im))))))

; A file's lines as the rows of a list of one column, titled its name,
; as wide as its widest line or its title, so that a long line is
; scrolled across to, not cut short.
(def fl_preview_view ((name (list int)) (lines (list (list int))) (pg UiGridState)) UiGridView
  (UiGridView (fl_preview) (cons (UiColumn name (fl_preview_w name lines) (UiStart) false) (nil UiColumn)) (fl_line_rows lines 0 (nil UiRow)) pg))

; How wide the preview's column is: the widest of its title, bold, and
; its lines, in the grid's face, with a cell's pads either side.
(def fl_preview_w ((name (list int)) (lines (list (list int)))) int
  (add (mul 2 (ui_cell_pad)) (fl_widest lines (ui_text_w name (ui_text_font) true 1))))

; The widest of lines, as the grid's text, and w.
(def fl_widest ((lines (list (list int))) (w int)) int
  (if (is_empty lines) w (fl_widest (tail lines) (max w (ui_text_w (head lines) (ui_text_font) false 1)))))

; A row of each of lines, keyed by its number from i, onto acc.
(def fl_line_rows ((lines (list (list int))) (i int) (acc (list UiRow))) (list UiRow)
  (if (is_empty lines)
      (rev acc)
      (fl_line_rows (tail lines) (add i 1) (cons (UiRow (digits i) (cons (UiCellText (head lines)) (nil UiCell))) acc))))

; ------------------------------------------------------------------ jobs

; What a window asks of a file server, one request out at a time, each
; answered as it comes (ui_app_ask, UiReply), a reply told from an older
; ask's by its tag, so that no step waits: a folder on a volume listed,
; the folder, where Back and Forward go, what came so far, and what
; then; /Volumes listed, each volume asked its size: the volumes, those
; still to ask, the sizes so far reversed, Back and Forward, and what
; then; the sidebar's volumes asked how much of each is free: the
; volumes, those still to ask, the lines so far reversed; a change, one
; request; a file read, for the preview or an app's icon: what for, its
; path, its handle, 0 until its open is answered, the pieces read so far
; reversed, and their bytes; or a document asked whether it is a
; program, in a folder, by name.
(data FlJob (FlJobList (list int) (list (list int)) (list (list int)) (list FsStat) FlThen)
            (FlJobVolumes (list (list int)) (list (list int)) (list int) (list (list int)) (list (list int)) FlThen)
            (FlJobSizes (list (list int)) (list (list int)) (list (list int)))
            (FlJobChange FlChange)
            (FlJobRead FlFile (list int) int (list bytes) int)
            (FlJobStat (list int) (list int)))

; What a listing is for: a place gone to, shown anew; or the place shown
; again, the thing named kept selected if it is still there, the line
; given said, and the sidebar refreshed after.
(data FlThen (FlShow) (FlKeep (list int) (list int)))

; A change asked: a folder made, by name; a thing renamed, old and new;
; a volume relabelled, old and new; or a thing deleted, by name.
(data FlChange (FlMkdir (list int)) (FlRenaming (list int) (list int)) (FlRelabel (list int) (list int)) (FlRemove (list int)))

; What a file is read for: its text shown, the file by name; an app's
; icon.face, the app by name in a folder; or its icon.draw, the same.
(data FlFile (FlForText (list int)) (FlForFace (list int) (list int)) (FlForDraw (list int) (list int)))

; A window's jobs: the tag of the ask out, 0 for none yet, and the jobs
; in order, the first the one the ask is of; none for nothing to do.
(data FlJobs (FlJobs int (list FlJob)))

; No jobs, nothing out.
(def fl_jobs_none () FlJobs (FlJobs 0 (nil FlJob)))

; The window's jobs, and m with others.
(def fl_jobs ((m Files)) FlJobs (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) jb)))
(def fl_with_jobs ((m Files) (jb FlJobs)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb0) (Files d es v is gs bk fw ov mn st pl ic wk jb))))

; m with job as what it does now, in place of its jobs, whose replies
; are then told apart by their tags and let go; a file being read is
; let finish first, so its handle is closed, job coming after it.
(def fl_jobbed ((m Files) (job FlJob)) Files
  (match (fl_jobs m)
    ((FlJobs tag jobs)
      (if (if (is_empty jobs) false (if (gt tag 0) (fl_is_read (head jobs)) false))
          (fl_with_jobs m (FlJobs tag (cons (head jobs) (cons job (nil FlJob)))))
          (fl_with_jobs m (FlJobs 0 (cons job (nil FlJob))))))))

; m with job after its jobs.
(def fl_queued ((m Files) (job FlJob)) Files
  (match (fl_jobs m) ((FlJobs tag jobs) (fl_with_jobs m (FlJobs tag (append jobs (cons job (nil FlJob))))))))

; Whether a job is a file being read.
(def fl_is_read ((j FlJob)) bool
  (match j
    ((FlJobRead what path h pieces n) true)
    ((FlJobList dir b f got then) false) ((FlJobVolumes vols left sizes b f then) false)
    ((FlJobSizes vols left frees) false) ((FlJobChange c) false) ((FlJobStat dir name) false)))

; Whether m has nothing out and nothing to do.
(def fl_jobs_done ((m Files)) bool (match (fl_jobs m) ((FlJobs tag jobs) (is_empty jobs))))

; The sidebar's volumes asked how much of each is free, a job.
(def fl_sizes_job () FlJob
  (let vols (fs_volumes) (FlJobSizes vols vols (nil (list int)))))

; The tag of window id's ask of its file server: the id, and a count of
; clock_ns, so a job's replies are told from an older one's.
(def fl_tag ((id int)) int (add (mul id 65536) (add 1 (mod (div (clock_ns) 1000) 65535))))

; The window a tag is of.
(def fl_tag_window ((tag int)) int (div tag 65536))

; Whether dir is listed by a file server: a folder on a volume, or on
; / when / is a volume; not /Volumes, which the mount table lists.
(def fl_by_server ((dir (list int))) bool
  (if (fv_is_volumes dir) false (not (is_empty (fs_volume_of (fs_server_path (path_abs dir)))))))

; Whether dir is listed by a job, asking: a file server's folder, or
; /Volumes, each volume asked its size.
(def fl_by_job ((dir (list int))) bool
  (if (fv_is_volumes dir) true (fl_by_server dir)))

; ---------------------------------------------------------------- asking

; What a job asks, or what it comes to with nothing to ask: the port
; and the body; or the state after it, and the jobs that follow it.
(data FlAsk (FlAsk int (list int)) (FlNoAsk Files (list FlJob)))

; The ask job makes next of the window in state m: a listing, from
; where it got to; a volume's size or free space, the first still to
; ask; a change; a file's open, then a read of its handle; a stat. One
; with nothing left to ask comes to what it listed, or the sidebar's
; rows; a folder no server serves says so.
(def fl_job_ask ((m Files) (job FlJob)) FlAsk
  (match job
    ((FlJobList dir b f got then)
      (let port (fs_path_port dir)
        (if (eq port 0)
            (FlNoAsk (fl_said m (append dir ": no file server serves it")) (nil FlJob))
            (FlAsk port (fs_list_body dir (length got))))))
    ((FlJobVolumes vols left sizes b f then)
      (if (is_empty left)
          (fl_listed_then m "/Volumes" (fv_volume_entries vols (rev sizes)) b f then)
          (FlAsk (fs_port_of (head left)) (fs_df_body (head left)))))
    ((FlJobSizes vols left frees)
      (if (is_empty left)
          (FlNoAsk (fl_with_rows m (fl_place_rows vols (rev frees) (fl_images m))) (nil FlJob))
          (FlAsk (fs_port_of (head left)) (fs_df_body (head left)))))
    ((FlJobChange c)
      (let port (fl_change_port m c)
        (if (eq port 0)
            (FlNoAsk (fl_said m (append (fl_dir m) ": no file server serves it")) (nil FlJob))
            (FlAsk port (fl_change_body m c)))))
    ((FlJobRead what path h pieces n)
      (FlAsk (fs_path_port path) (if (eq h 0) (fs_open_body path) (fs_read_body h (fs_read_most)))))
    ((FlJobStat dir name) (FlAsk (fs_path_port dir) (fs_stat_body (fv_join dir name))))))

; m with other sidebar rows; and its full-color icons.
(def fl_with_rows ((m Files) (rows (list UiSideRow))) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (Files d es v is gs bk fw ov mn st rows ic wk jb))))
(def fl_images ((m Files)) UiImages (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) ic)))

; The port a change is asked of: the place's server, or the volume's
; own for a relabel; 0 if none serves it.
(def fl_change_port ((m Files) (c FlChange)) int
  (match c
    ((FlMkdir name) (fs_path_port (fl_dir m)))
    ((FlRenaming old new) (fs_path_port (fl_dir m)))
    ((FlRelabel old new) (fs_port_of (append "/Volumes/" old)))
    ((FlRemove name) (fs_path_port (fl_dir m)))))

; A change's request.
(def fl_change_body ((m Files) (c FlChange)) (list int)
  (match c
    ((FlMkdir name) (fs_mkdir_body (fv_join (fl_dir m) name)))
    ((FlRenaming old new) (fs_rename_body (fv_join (fl_dir m) old) (fv_join (fl_dir m) new)))
    ((FlRelabel old new) (fs_relabel_body (append "/Volumes/" old) new))
    ((FlRemove name) (fs_remove_body (fv_join (fl_dir m) name)))))

; The app and a window's state after a job was asked or answered.
(data FlAsked (FlAsked UiApp Files))

; a after window id's state m was stepped: its first job's ask sent, if
; none is out, tagged for the window, the state then waiting for the
; reply by its tag; a job with nothing to ask done at once and the next
; asked, until one asks or none is left.
(def fl_asking ((a UiApp) (id int) (m Files)) FlAsked
  (match (fl_jobs m)
    ((FlJobs tag jobs)
      (if (if (is_empty jobs) true (gt tag 0))
          (FlAsked a m)
          (match (fl_job_ask m (head jobs))
            ((FlAsk port body)
              (let t (fl_tag id)
                (FlAsked (ui_app_ask a t port body) (fl_with_jobs m (FlJobs t jobs)))))
            ((FlNoAsk m2 next) (fl_asking a id (fl_with_jobs m2 (FlJobs 0 (append next (tail jobs)))))))))))

; -------------------------------------------------------------- replies

; The state after a job's reply, and the jobs that go on from it: the
; same job, from where it got to, or those after it, before the rest.
(data FlJobbed (FlJobbed Files (list FlJob)))

; What a reply to window state m's ask, tagged tag, its message msg,
; does: nothing, for one not of the ask out, an older one's; else its
; job goes on from it (fl_job_reply), and the next ask is made by the
; loop (fl_asking).
(def fl_replied_to ((m Files) (tag int) (msg Message)) Files
  (match (fl_jobs m)
    ((FlJobs t jobs)
      (if (if (is_empty jobs) true (not (eq t tag)))
          m
          (match (fl_job_reply m (head jobs) msg)
            ((FlJobbed m2 next) (fl_with_jobs m2 (FlJobs 0 (append next (tail jobs))))))))))

; What a job's reply does.
(def fl_job_reply ((m Files) (job FlJob) (msg Message)) FlJobbed
  (match job
    ((FlJobList dir b f got then) (fl_list_reply m dir b f got then (fs_reply_msg msg)))
    ((FlJobVolumes vols left sizes b f then)
      (FlJobbed m (cons (FlJobVolumes vols (if (is_empty left) left (tail left)) (cons (fl_size_of (fs_df_of (fs_reply_msg msg))) sizes) b f then) (nil FlJob))))
    ((FlJobSizes vols left frees)
      (FlJobbed m (cons (FlJobSizes vols (if (is_empty left) left (tail left)) (cons (fl_free_text (fs_df_of (fs_reply_msg msg))) frees)) (nil FlJob))))
    ((FlJobChange c) (fl_change_reply m c (fs_reply_msg msg)))
    ((FlJobRead what path h pieces n) (fl_read_reply m what path h pieces n msg))
    ((FlJobStat dir name)
      (match (fs_reply_msg msg)
        ((FsReply w rest)
          (FlJobbed (if (if (lt w 0) true (not (eq dir (fl_dir m)))) m (fl_marked m name (fl_stat_kind rest))) (nil FlJob)))))))

; A volume's size in bytes, as df says it, its clusters of 4 KB; -1 if
; it did not say.
(def fl_size_of ((space FsSpace)) int
  (match space ((FsSpace sectors clusters free files) (mul clusters 4096)) ((FsSpaceRefused code) -1)))

; What a document is, by its stat: a program if marked one, else a
; document.
(def fl_stat_kind ((rest (list int))) FvKind
  (match (fs_kind_of rest) ((FsIsFile sz exec) (if exec (FvProgram) (FvText))) ((FsIsDir) (FvText)) ((FsNoKind code) (FvText))))

; What a listing's reply, r, does: the folder's entries so far after it;
; more asked for, from as many as came, until the server's count is
; reached or a reply brings none; then the place shown. A refusal is
; said, and the listing dropped.
(def fl_list_reply ((m Files) (dir (list int)) (b (list (list int))) (f (list (list int))) (got (list FsStat)) (then FlThen) (r FsReply)) FlJobbed
  (match r
    ((FsReply w rest)
      (if (lt w 0)
          (FlJobbed (fl_said m (append dir (append ": " (if (eq w -5) "the file server did not answer" (io_error w))))) (nil FlJob))
          (let got2 (fs_stats_onto (lines rest) got)
            (if (if (le (length got2) (length got)) true (ge (length got2) w))
                (match (fl_listed_then m dir (fl_stat_entries dir (rev got2)) b f then)
                  ((FlNoAsk m2 next) (FlJobbed m2 next))
                  ((FlAsk port body) (FlJobbed m (nil FlJob))))
                (FlJobbed m (cons (FlJobList dir b f got2 then) (nil FlJob)))))))))

; The entries of dir as its server listed them, stats: each a folder, an
; app or a document by its name for now, / with its Volumes.
(def fl_stat_entries ((dir (list int)) (stats (list FsStat))) (list FvEntry)
  (let es (fv_stat_entries stats (nil (list int)))
    (if (eq dir "/") (fv_sorted (cons (FvEntry "Volumes" (FvDir) -1) es)) es)))

; m showing dir, its entries es, as then says: anew, Back and Forward
; going to b and f, or kept as it was, the sidebar then refreshed, a
; job after; and which files are programs, and each app's icon, to be
; looked at as idle work (fl_look_started), a thing a piece.
(def fl_listed_then ((m Files) (dir (list int)) (es (list FvEntry)) (b (list (list int))) (f (list (list int))) (then FlThen)) FlAsk
  (match then
    ((FlShow) (FlNoAsk (fl_looking (fl_at m dir es b f) (fl_to_look es (nil (list int)))) (nil FlJob)))
    ((FlKeep sel said) (FlNoAsk (fl_looking (fl_kept m es sel said) (fl_to_look es (nil (list int)))) (cons (fl_sizes_job) (nil FlJob))))))

; m's place shown again as es, the thing sel kept selected if it is
; still there, its line saying said, or how many things there are.
(def fl_kept ((m Files) (es2 (list FvEntry)) (sel (list int)) (said (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (let keep (match (fl_entry_named es2 sel) ((Some e) sel) ((None) ""))
        (fl_selecting (Files d es2 v (UiIconState "" (match is ((UiIconState s f) f))) (match gs ((UiGridState c desc s f l) (UiGridState c desc "" f l))) bk fw (FlNone) (FlNoMenu)
                             (if (is_empty said) (fl_count_text es2 "") said) pl ic wk jb)
                      keep)))))

; The names of es to look at, onto the reversed acc: each document,
; which may be a program, and each app, whose icon is to be read.
(def fl_to_look ((es (list FvEntry)) (acc (list (list int)))) (list (list int))
  (if (is_empty es)
      (rev acc)
      (match (head es)
        ((FvEntry n k s)
          (fl_to_look (tail es) (match k ((FvText) (cons n acc)) ((FvApp i) (cons n acc)) ((FvDir) acc) ((FvVolume) acc) ((FvProgram) acc)))))))

; m with names still to look at.
(def fl_looking ((m Files) (names (list (list int)))) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (Files d es v is gs bk fw ov mn st pl ic names jb))))

; Whether m has things still to look at, and no job out or to do: idle
; work's turn looks at one.
(def fl_has_work ((m Files)) bool
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (if (is_empty wk) false (fl_jobs_done m)))))

; m after a piece of idle work begun: the first thing still to look at
; asked of its file server, a job: a document whether it is a program,
; an app's icon.face read from its bundle.
(def fl_look_started ((m Files)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (if (is_empty wk)
          m
          (let m2 (Files d es v is gs bk fw ov mn st pl ic (tail wk) jb)
            (match (fl_entry_named es (head wk))
              ((None) m2)
              ((Some e)
                (match (fv_kind e)
                  ((FvApp i) (fl_queued m2 (fl_read_job (FlForFace d (head wk)) (append (fv_join d (head wk)) "/icon.face"))))
                  ((FvText) (fl_queued m2 (FlJobStat d (head wk))))
                  ((FvDir) m2) ((FvVolume) m2) ((FvProgram) m2)))))))))

; A file read, for what, from its start.
(def fl_read_job ((what FlFile) (path (list int))) FlJob
  (FlJobRead what path 0 (nil bytes) 0))

; m with the thing named name, in the place shown, of kind k now.
(def fl_marked ((m Files) (name (list int)) (k FvKind)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (Files d (fl_entry_marked es name k (nil FvEntry)) v is gs bk fw ov mn st pl ic wk jb))))

; es with the entry named name of kind k, onto the reversed acc.
(def fl_entry_marked ((es (list FvEntry)) (name (list int)) (k FvKind) (acc (list FvEntry))) (list FvEntry)
  (if (is_empty es)
      (rev acc)
      (match (head es)
        ((FvEntry n k0 s)
          (if (not (eq n name))
              (fl_entry_marked (tail es) name k (cons (head es) acc))
              (rev_onto acc (cons (FvEntry n k s) (tail es))))))))

; What a file read's reply does: its open answered with the handle, the
; first read asked; a read's bytes kept, and more asked while a reply
; brings any and the whole is under fl_read_most; then the handle
; closed, told, and the file come to (fl_read_done). A refusal, told
; the close if a handle is open, is what the file comes to with none
; (fl_read_failed).
(def fl_read_reply ((m Files) (what FlFile) (path (list int)) (h int) (pieces (list bytes)) (n int) (msg Message)) FlJobbed
  (if (eq h 0)
      (match (fs_reply_msg msg)
        ((FsReply w rest)
          (if (lt w 0)
              (fl_read_failed m what path w)
              (FlJobbed m (cons (FlJobRead what path w pieces n) (nil FlJob))))))
      (match (fs_read_of msg)
        ((FsRead w b i j)
          (if (lt w 0)
              (let c (fs_close_told (fs_path_port path) h) (fl_read_failed m what path w))
              (if (if (eq w 0) true (ge (add n w) (fl_read_most what)))
                  (let c (fs_close_told (fs_path_port path) h)
                    (fl_read_done m what (bytes_concat (rev (cons (fs_read_piece (FsRead w b i j)) pieces)))))
                  (FlJobbed m (cons (FlJobRead what path h (cons (fs_read_piece (FsRead w b i j)) pieces) (add n w)) (nil FlJob)))))))))

; How much of a file is read: a preview's first fv_preview_max, an
; icon's at most the 256 KB an icon.face of every size would take.
(def fl_read_most ((what FlFile)) int
  (match what ((FlForText name) (fv_preview_max)) ((FlForFace dir name) 262144) ((FlForDraw dir name) 262144)))

; What a file read whole, b, comes to: its text shown, as a page over
; the place; an app's icon.face its images; its icon.draw its commands.
(def fl_read_done ((m Files) (what FlFile) (b bytes)) FlJobbed
  (match what
    ((FlForText name)
      (FlJobbed (fl_said (fl_with_over m (FlPreview name (fv_text_lines (bytes_to_list b)) (ui_grid_state_new))) (append "\"" (append name "\" shown"))) (nil FlJob)))
    ((FlForFace dir name) (FlJobbed (fl_marked_in m dir name (FvApp (FvImage (ui_images_of b (ui_image_sizes))))) (nil FlJob)))
    ((FlForDraw dir name) (FlJobbed (fl_marked_in m dir name (FvApp (FvDrawn (fv_draws_of (bytes_to_list b))))) (nil FlJob)))))

; What a file that could not be read, code w, comes to: a document's
; refusal said; an app with no icon.face has its icon.draw read instead;
; one with neither has no icon.
(def fl_read_failed ((m Files) (what FlFile) (path (list int)) (w int)) FlJobbed
  (match what
    ((FlForText name) (FlJobbed (fl_said m (append name (append ": " (io_error w)))) (nil FlJob)))
    ((FlForFace dir name) (FlJobbed m (cons (fl_read_job (FlForDraw dir name) (append (fv_join dir name) "/icon.draw")) (nil FlJob))))
    ((FlForDraw dir name) (FlJobbed (fl_marked_in m dir name (FvApp (FvDrawn (nil UiDraw)))) (nil FlJob)))))

; m with the thing named name of kind k, if dir is still the place
; shown; as it was if the place has changed meanwhile.
(def fl_marked_in ((m Files) (dir (list int)) (name (list int)) (k FvKind)) Files
  (if (eq dir (fl_dir m)) (fl_marked m name k) m))

; What a change's reply, r, does: done, the place listed again, saying
; so, with the thing made or renamed selected; a volume relabelled, the
; places and paths under its old name made its new; refused, why said,
; in the server's words if it gave any.
(def fl_change_reply ((m Files) (c FlChange) (r FsReply)) FlJobbed
  (match r
    ((FsReply w rest)
      (if (lt w 0)
          (FlJobbed (fl_said m (fl_change_why c w rest)) (nil FlJob))
          (match c
            ((FlMkdir name) (fl_refresh_jobbed m (append "Made \"" (append name "\"")) name))
            ((FlRenaming old new) (fl_refresh_jobbed m (fl_renamed_text old new) new))
            ((FlRelabel old new) (fl_refresh_jobbed (fl_relabelled m old new) (fl_renamed_text old new) new))
            ((FlRemove name) (fl_refresh_jobbed m (append "Deleted \"" (append name "\"")) "")))))))

; What renaming old to new says.
(def fl_renamed_text ((old (list int)) (new (list int))) (list int)
  (append "Renamed \"" (append old (append "\" to \"" (append new "\"")))))

; Why a change was refused with code w and the words rest.
(def fl_change_why ((c FlChange) (w int) (rest (list int))) (list int)
  (match c
    ((FlMkdir name) (if (eq w -4) "it is there already, or cannot be made" (io_error w)))
    ((FlRenaming old new) (io_error w))
    ((FlRelabel old new) (if (is_empty rest) (io_error w) rest))
    ((FlRemove name) (io_error w))))

; m once the volume old is called new: every path under its old name,
; Back's and Forward's too, made new's.
(def fl_relabelled ((m Files) (old (list int)) (new (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (Files (fv_relabelled d old new) es v is gs (fv_all_relabelled bk old new) (fv_all_relabelled fw old new) ov mn st pl ic wk jb))))

; m's place listed again after a change, saying said, with sel to be
; selected, as fl_refresh has it, and the jobs it takes.
(def fl_refresh_jobbed ((m Files) (said (list int)) (sel (list int))) FlJobbed
  (match (fl_refresh m said sel)
    ((FlNoAsk m2 next) (FlJobbed m2 next))
    ((FlAsk port body) (FlJobbed m (nil FlJob)))))

; --------------------------------------------------------------- places

; m showing dir: listed at once if it is the initramfs's, Back to where
; it was if back, Forward kept if fwd; or, if dir cannot be listed, as
; it was, saying why. A folder on a volume, or /Volumes, is listed by
; asking, a job (fl_jobbed), the place showing what it did meanwhile.
(def fl_go ((m Files) (dir (list int)) (back (list (list int))) (fwd (list (list int)))) Files
  (if (fl_by_server dir)
      (fl_jobbed m (FlJobList dir back fwd (nil FsStat) (FlShow)))
      (if (fv_is_volumes dir)
          (let vols (fs_volumes) (fl_jobbed m (FlJobVolumes vols vols (nil int) back fwd (FlShow))))
          (match (fv_list dir)
            ((FvNotListed why) (fl_said (fl_with_over m (FlNone)) (append dir (append ": " why))))
            ((FvListed es) (fl_at m dir es back fwd))))))

; m gone into dir from where it is, Forward forgotten; the place shown,
; listed again.
(def fl_went ((m Files) (dir (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (if (eq dir d) (fl_refreshed m (fl_status m) (fl_selected m)) (fl_go m dir (cons d bk) (nil (list int)))))))

; m back where it was before, or forward again.
(def fl_back ((m Files)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic wk jb)
      (match ov
        ((FlPreview n l p) (fl_with_over m (FlNone)))
        ((FlNone) (if (is_empty bk) m (fl_go m (head bk) (tail bk) (cons d fw))))
        ((FlNewFolder t) m) ((FlRename o t) m) ((FlDelete n) m)))))
(def fl_forward ((m Files)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) (if (is_empty fw) m (fl_go m (head fw) (cons d bk) (tail fw))))))

; m's place listed again, and its sidebar, the thing sel kept selected
; if it is still there, its line saying said: at once if the place is
; the initramfs's, the sidebar's volumes then asked their free space, a
; job; else asked, a job (fl_refresh).
(def fl_refreshed ((m Files) (said (list int)) (sel (list int))) Files
  (match (fl_refresh m said sel)
    ((FlNoAsk m2 next) (fl_jobbed_all m2 next))
    ((FlAsk port body) m)))

; m with the first of jobs in place of its own (fl_jobbed), and the
; rest after it.
(def fl_jobbed_all ((m Files) (jobs (list FlJob))) Files
  (if (is_empty jobs) m (fl_queued_all (fl_jobbed m (head jobs)) (tail jobs))))

; m with each of jobs after its jobs.
(def fl_queued_all ((m Files) (jobs (list FlJob))) Files
  (if (is_empty jobs) m (fl_queued_all (fl_queued m (head jobs)) (tail jobs))))

; m's place listed again, as fl_refreshed says: the state, and the jobs
; it takes, which the caller gives it; never an ask.
(def fl_refresh ((m Files) (said (list int)) (sel (list int))) FlAsk
  (let d (fl_dir m)
    (if (fl_by_server d)
        (FlNoAsk (fl_with_over m (FlNone)) (cons (FlJobList d (fl_backs m) (fl_fwds m) (nil FsStat) (FlKeep sel said)) (nil FlJob)))
        (if (fv_is_volumes d)
            (let vols (fs_volumes)
              (FlNoAsk (fl_with_over m (FlNone)) (cons (FlJobVolumes vols vols (nil int) (fl_backs m) (fl_fwds m) (FlKeep sel said)) (nil FlJob))))
            (match (fv_list d)
              ((FvNotListed why) (FlNoAsk (fl_said (fl_with_over m (FlNone)) (append d (append ": " why))) (nil FlJob)))
              ((FvListed es2) (FlNoAsk (fl_looking (fl_kept m es2 sel said) (nil (list int))) (cons (fl_sizes_job) (nil FlJob)))))))))

; Where Back and Forward go.
(def fl_backs ((m Files)) (list (list int)) (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) bk)))
(def fl_fwds ((m Files)) (list (list int)) (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb) fw)))

; The selection opened: gone into, started, or its text read to be
; shown, a job, the line saying so meanwhile.
(def fl_opened ((m Files) (name (list int))) Files
  (match (fl_entry_named (fl_entries m) name)
    ((None) m)
    ((Some e)
      (match (fv_open (fl_dir m) name (fv_kind e))
        ((FvGo path) (fl_went m path))
        ((FvStarted said) (fl_said m said))
        ((FvNotOpened why) (fl_said m (append name (append ": " why))))
        ((FvRead path) (fl_said (fl_jobbed m (fl_read_job (FlForText name) path)) (append "Opening \"" (append name "\"..."))))))))

; The dialog's button: its folder made, its thing renamed, or deleted,
; each asked of the file server, a job, the dialog closed; the place is
; listed again as the answer comes, saying what was done or why not.
(def fl_answered ((m Files)) Files
  (match (fl_over m)
    ((FlNone) m)
    ((FlPreview n l p) m)
    ((FlNewFolder t)
      (let name (ui_entry_text t)
        (if (not (fv_name_ok name)) m (fl_changing m (FlMkdir name)))))
    ((FlRename old t)
      (let new (ui_entry_text t)
        (if (not (fl_rename_ok m old new))
            m
            (fl_changing m (if (fv_is_volumes (fl_dir m)) (FlRelabel old new) (FlRenaming old new))))))
    ((FlDelete name) (fl_changing (fl_selecting m "") (FlRemove name)))))

; m with change c asked, a job, its dialog closed; or saying why the
; place cannot be changed, if it cannot: the initramfs's files, or
; /Volumes but for a relabel.
(def fl_changing ((m Files) (c FlChange)) Files
  (let why (match c ((FlRelabel o n) "") ((FlMkdir n) (fv_fixed_why (fl_dir m))) ((FlRenaming o n) (fv_fixed_why (fl_dir m))) ((FlRemove n) (fv_fixed_why (fl_dir m))))
    (if (is_empty why)
        (fl_jobbed (fl_with_over m (FlNone)) (FlJobChange c))
        (fl_said (fl_with_over m (FlNone)) why))))

; A volume, its path vol, relabelled from the sidebar: as from /Volumes,
; and the place shown, if it is on it, under its new name.
(def fl_relabelled_place ((m Files) (vol (list int))) Files
  (fl_with_over m (FlRename (base_name vol) (UiEntryText (base_name vol) (length (base_name vol))))))

; ------------------------------------------------------------------ acts

; The state after action, set off with ev, in window w: what needs the
; file calls first, then the rest, fl_update. With the dialog's entry, as
; with its button, Enter answers it; Esc closes what is over the place,
; or the menu.
(def fl_acted ((m Files) (action (list int)) (ev UiEvent) (w UiWin)) Files
  (let code (ui_key_pressed ev)
    (if (if (eq code (ui_key_esc)) (is_empty action) false)
        (fl_escaped m)
        (if (any_eq action (cons "dialog.ok" (cons (ui_entry_activate_action (fl_entry)) (nil (list int)))))
            (fl_answered m)
            (if (eq action "dialog.cancel")
                (fl_with_over m (FlNone))
                (fl_acted_more m action ev w code))))))

; More of fl_acted: a place chosen in the sidebar or the path bar.
(def fl_acted_more ((m Files) (action (list int)) (ev UiEvent) (w UiWin) (code int)) Files
  (let side (ui_select_key (fl_side) action)
    (if (not (is_empty side))
        (fl_went m side)
        (let depth (ui_select_key (fl_path) action)
          (if (not (is_empty depth))
              (fl_went (fl_with_over m (FlNone)) (fv_at_depth (fl_dir m) (int_prefix depth 0)))
              (fl_acted_items m action ev w code))))))

; The place's own actions: back and forward, refresh, a thing opened by
; a double click or Open, the dialogs opened, and keys.
(def fl_acted_items ((m Files) (action (list int)) (ev UiEvent) (w UiWin) (code int)) Files
  (if (eq action "app.back") (fl_back m)
  (if (eq action "app.forward") (fl_forward m)
  (if (eq action "app.refresh") (fl_refreshed m "" (fl_selected m))
  (if (eq action "app.open") (fl_opened (fl_with_menu m (FlNoMenu)) (fl_selected m))
  (if (eq action "app.newfolder") (fl_asked m (FlNewFolder (UiEntryText "" 0)))
  (if (eq action "app.rename") (fl_rename_asked m)
  (if (eq action "app.delete") (fl_delete_asked m)
  (fl_acted_rest m action ev w code)))))))))

; The menu of a sidebar's volume, Open and Rename...; a double click;
; keys with nothing over the place; else fl_update.
(def fl_acted_rest ((m Files) (action (list int)) (ev UiEvent) (w UiWin) (code int)) Files
  (let go (ui_select_key "go" action)
    (if (not (is_empty go))
        (fl_went m go)
        (let rl (ui_select_key "relabel" action)
          (if (not (is_empty rl))
              (fl_went_to_relabel m rl)
              (let sk (ui_select_key (fl_items) action)
                (if (if (not (is_empty sk)) (ui_win_double w) false)
                    (fl_opened (fl_update m action ev) sk)
                    (if (if (is_empty action) (ge code 0) false)
                        (fl_key_acted m code (ui_key_mods ev) w)
                        (fl_update m action ev)))))))))

; Renaming a volume from the sidebar: /Volumes shown, it selected, and
; asked its new name.
(def fl_went_to_relabel ((m Files) (vol (list int))) Files
  (fl_relabelled_place (fl_selecting (fl_went m "/Volumes") (base_name vol)) vol))

; A key with nothing over the place, and no menu, as fl_keyed says, with
; the modifiers mods; over a file's preview, Backspace and Alt-Left go
; back, and the rest scroll it.
(def fl_key_acted ((m Files) (code int) (mods int) (w UiWin)) Files
  (match (fl_over m)
    ((FlNone)
      (match (fl_menu_of m)
        ((FlNoMenu) (match (fl_keyed m code mods w) ((FlKeyAction a) (fl_acted_items m a (UiOther 0 "") w -1)) ((FlKeyMoved m2) m2)))
        ((FlMainMenu) m)
        ((FlContext x y k) m)))
    ((FlPreview n l p)
      (if (fl_goes_back code mods)
          (fl_back m)
          (match m ((Files d es v is gs bk fw ov mn st pl ic wk jb)
            (Files d es v is gs bk fw (FlPreview n l (ui_grid_key (fl_preview_view n l p) code (ui_win_scroller w (fl_preview)))) mn st pl ic wk jb)))))
    ((FlNewFolder t) m) ((FlRename o t) m) ((FlDelete n) m)))

; Esc: the menu closed, else what is over the place.
(def fl_escaped ((m Files)) Files
  (match (fl_menu_of m)
    ((FlNoMenu) (fl_with_over m (FlNone)))
    ((FlMainMenu) (fl_with_menu m (FlNoMenu)))
    ((FlContext x y k) (fl_with_menu m (FlNoMenu)))))

; A dialog opened over the place, unless the place cannot be changed.
(def fl_asked ((m Files) (o FlOver)) Files
  (let why (fv_fixed_why (fl_dir m))
    (if (is_empty why) (fl_with_over m o) (fl_said (fl_with_menu m (FlNoMenu)) why))))

; The selection asked a new name, its own typed already; in /Volumes too.
(def fl_rename_asked ((m Files)) Files
  (let sel (fl_selected m)
    (if (is_empty sel)
        (fl_with_menu m (FlNoMenu))
        (let o (FlRename sel (UiEntryText sel (length sel)))
          (if (fv_is_volumes (fl_dir m)) (fl_with_over m o) (fl_asked m o))))))

; The selection asked whether to delete it.
(def fl_delete_asked ((m Files)) Files
  (let sel (fl_selected m)
    (if (is_empty sel) (fl_with_menu m (FlNoMenu)) (fl_asked m (FlDelete sel)))))

; The name of the entry a dialog just opened has, if it has one.
(def fl_dialog_entry ((o FlOver)) (list int)
  (match o
    ((FlNewFolder t) (ui_entry_action (fl_entry)))
    ((FlRename old t) (ui_entry_action (fl_entry)))
    ((FlDelete n) "") ((FlPreview n l p) "") ((FlNone) "")))

; The window with the focus on a dialog's entry as it opens, so that
; typing goes to it at once; else as it was.
(def fl_focused ((w UiWin) (m Files) (m2 Files)) UiWin
  (let e (fl_dialog_entry (fl_over m2))
    (if (if (is_empty e) true (eq (fl_dialog_entry (fl_over m)) e)) w (ui_win_focusing w e))))

; ------------------------------------------------------------------- loop

; why said on standard error, and a failure.
(def fl_complain ((why (list int))) int (complain_as "files" why))

; How big a window of Files opens.
(def fl_win_w () int 880)
(def fl_win_h () int 560)

; Files started as an app (uiapp.l0) that answers its opens itself, its
; first window opened, decorated by itself, the full-color icons loaded,
; and the folder its first argument names shown, or /, at once if it is
; the initramfs's, else asked (fl_go); the sidebar's volumes asked their
; free space after; and its windows served until the last is closed.
(def files () int
  (match (ui_app_start)
    ((UiAppFailed why) (fl_complain why))
    ((UiAppStarted a)
      (match (ui_app_open_csd (ui_app_opening a) "Files" (fl_win_w) (fl_win_h))
        ((UiAppRefused a2 why) (fl_complain why))
        ((UiAppOpened a2 id)
          (let im (ui_images_load (ui_image_names) (ui_app_scale a2))
            (let m (fl_queued (fl_placed (fl_go (fl_new (nil FvEntry) (fl_place_rows (fs_volumes) (nil (list int)) im) im) "/" (nil (list int)) (nil (list int))) (args))
                              (fl_sizes_job))
              (match (fl_asking a2 id m)
                ((FlAsked a3 m2) (fl_loop (ui_app_present a3 id (fl_view m2)) (map_put ((MapEmpty int Files)) id m2)))))))))))

; A folder an open names, and what it holds; one listed by asking, a
; job; or none.
(data FlOpenAt (FlOpenAt (list int) (list FvEntry)) (FlOpenListing (list int)) (FlOpenNowhere))

; The folder an open's arguments, or Files's own, name: the first, a
; path made normal, if it is a folder Files lists, with what it holds,
; or to be asked, a job; or none, for no argument, a URL, a file, or a
; folder it cannot list.
(def fl_open_at ((argv (list (list int)))) FlOpenAt
  (if (is_empty argv)
      (FlOpenNowhere)
      (if (not (starts_with (head argv) "/"))
          (FlOpenNowhere)
          (let dir (normal_path (head argv))
            (if (fl_by_job dir)
                (FlOpenListing dir)
                (match (fv_list dir) ((FvListed es) (FlOpenAt dir es)) ((FvNotListed why) (FlOpenNowhere))))))))

; m, at the place argv names if it names one, as a window opened there
; shows it: nothing selected, over it or open, and no Back or Forward;
; a folder listed by asking, a job (fl_go).
(def fl_placed ((m Files) (argv (list (list int)))) Files
  (match (fl_open_at argv)
    ((FlOpenAt dir es) (fl_at m dir es (nil (list int)) (nil (list int))))
    ((FlOpenListing dir) (fl_go m dir (nil (list int)) (nil (list int))))
    ((FlOpenNowhere) m)))

; Each event of a window routed, that window's state changed, and it
; repainted, each window's state in ms by its id; and an open, of no
; window, a new window; until the last window is closed.
; A reply, of no window, goes to the window whose ask it answers, by
; its tag; idle work's turn, when nothing waits, looks at one thing of
; a window with things still to look at and nothing asked, as the app
; has idle work while any has.
(def fl_loop ((a0 UiApp) (ms (Map int Files))) int
  (match (ui_app_next (ui_app_idling a0 (fl_any_work (map_values ms))))
    ((UiAppNext a e)
      (if (ui_app_event_lost e)
          (fl_complain "lost its port")
          (match e
            ((UiAppEvent id ev)
              (if (lt id 0)
                  (match (ui_reply_of ev)
                    ((UiReplyTo tag msg) (fl_replied a ms tag msg))
                    ((UiNoReply)
                      (if (ui_is_idle ev)
                          (fl_idled a ms (map_keys ms))
                          (match (ui_app_route a id ev)
                            ((UiAppRouted a2 action) (if (eq action (ui_open_action)) (fl_open_asked a2 ms ev) (fl_loop a2 ms)))))))
                  (match (map_get ms id)
                    ((None) (fl_loop a ms))
                    ((Some m)
                      (match (ui_app_route a id ev)
                        ((UiAppRouted a2 action) (fl_stepped a2 ms id m action ev))))))))))))

; Whether any of ms has things still to look at.
(def fl_any_work ((ms (list Files))) bool
  (if (is_empty ms) false (if (fl_has_work (head ms)) true (fl_any_work (tail ms)))))

; A reply tagged tag, msg, given to the window it is of, whose job goes
; on from it, its next ask sent, and which is painted again; nothing if
; it has closed.
(def fl_replied ((a UiApp) (ms (Map int Files)) (tag int) (msg Message)) int
  (let id (fl_tag_window tag)
    (match (map_get ms id)
      ((None) (fl_loop a ms))
      ((Some m) (fl_shown a ms id (fl_replied_to m tag msg))))))

; A piece of idle work, of the first of ids whose window has some: its
; next thing asked of its file server, and the window painted again.
(def fl_idled ((a UiApp) (ms (Map int Files)) (ids (list int))) int
  (if (is_empty ids)
      (fl_loop a ms)
      (match (map_get ms (head ids))
        ((None) (fl_idled a ms (tail ids)))
        ((Some m) (if (fl_has_work m) (fl_shown a ms (head ids) (fl_look_started m)) (fl_idled a ms (tail ids)))))))

; Window id's jobs asked on (fl_asking), the window painted showing m,
; kept as its state, and the loop on.
(def fl_shown ((a UiApp) (ms (Map int Files)) (id int) (m Files)) int
  (match (fl_asking a id m)
    ((FlAsked a2 m2) (fl_loop (ui_app_present a2 id (fl_view m2)) (map_put ms id m2)))))

; Files launched again, an open, ev: a window more, in front, at the
; folder its first argument names, or else at /, as Nautilus opens a
; window for a launch, the open answered with it; or, if there is no
; room for one, answered with the front window, 0.
(def fl_open_asked ((a UiApp) (ms (Map int Files)) (ev UiEvent)) int
  (if (eq (map_size ms) 0)
      (fl_loop (ui_app_shown a ev 0) ms)
      (let n (fl_open_state (head (map_values ms)) (ui_open_args ev))
        (match (ui_app_open_csd a "Files" (fl_win_w) (fl_win_h))
          ((UiAppRefused a2 why) (fl_loop (ui_app_shown a2 ev 0) ms))
          ((UiAppOpened a2 nid)
            (match (fl_asking a2 nid n)
              ((FlAsked a3 n2) (fl_loop (ui_app_shown (ui_app_present a3 nid (fl_view n2)) ev nid) (map_put ms nid n2)))))))))

; A new window's state for an open with argv, m any window's, whose
; view, sidebar and icons it keeps: at the place argv names, or at /; a
; folder listed by asking, a job (fl_go), m's place shown until it
; answers.
(def fl_open_state ((m Files) (argv (list (list int)))) Files
  (match (fl_open_at argv)
    ((FlOpenAt dir es) (fl_at (fl_twin m) dir es (nil (list int)) (nil (list int))))
    ((FlOpenListing dir) (fl_go (fl_twin m) dir (nil (list int)) (nil (list int))))
    ((FlOpenNowhere) (fl_go (fl_twin m) "/" (nil (list int)) (nil (list int))))))

; Window id's action, set off with ev, its state m: win.close closes it,
; and with the last Files ends; New Window opens one more; anything else
; changes the window's state, its jobs are asked on, and it is painted
; again.
(def fl_stepped ((a UiApp) (ms (Map int Files)) (id int) (m Files) (action (list int)) (ev UiEvent)) int
  (if (eq action (ui_close_action))
      (let a2 (ui_app_close a id)
        (if (eq (ui_app_count a2) 0) 0 (fl_loop a2 (map_remove ms id))))
      (if (eq action "app.newwindow")
          (fl_new_window a ms id m)
          (match (ui_app_win a id)
            ((None) (fl_loop a ms))
            ((Some w)
              (let m1 (fl_acted m action ev w)
                (fl_shown (ui_app_put a (fl_focused w m m1)) ms id m1)))))))

; New Window, from window id showing m: its menu closed, and a window
; opened in front at the same place, as Nautilus's New Window opens one,
; with a state of its own; or, if there is no room for one, m saying
; why.
(def fl_new_window ((a UiApp) (ms (Map int Files)) (id int) (m Files)) int
  (let m1 (fl_with_menu m (FlNoMenu))
    (match (ui_app_open_csd (ui_app_present a id (fl_view m1)) "Files" (fl_win_w) (fl_win_h))
      ((UiAppRefused a2 why)
        (let m2 (fl_said m1 why) (fl_loop (ui_app_present a2 id (fl_view m2)) (map_put ms id m2))))
      ((UiAppOpened a2 nid)
        (let n (fl_twin m1)
          (fl_loop (ui_app_present a2 nid (fl_view n)) (map_put (map_put ms id m1) nid n)))))))

; A new window's state at the place m shows: its things, view, sidebar
; and icons, but nothing selected, over it or open, no Back or Forward,
; and no jobs, m's being its own.
(def fl_twin ((m Files)) Files
  (fl_with_jobs (fl_at m (fl_dir m) (fl_entries m) (nil (list int)) (nil (list int))) (fl_jobs_none)))
