; files.l0 -- Files, as GNOME's Nautilus is in GNOME 45: a window that
; draws its own header bars (ui_open_csd). A sidebar of places, under a
; header bar of its own titled Files: the computer, /, the volumes, and
; each volume with how much of it is free. Beside it, the place shown,
; under a header bar holding Back and Forward, a path bar of where it is,
; a toggle between a grid of icons and a list, the menu, and the window's
; close button; and a line of what was last done at its foot.
;
; A click selects a thing, a double click or Enter opens it: a folder or
; a volume is gone into, an app's bundle or a program started, and any
; other file shown, its text, as a page over the place, until Back or
; Esc. A right click opens a menu of what can be done with what it is
; on, Open, Rename... and Delete, or with the place, New Folder...; the
; menu button's has New Folder..., Refresh and the other view. F2
; renames, Delete deletes, Backspace goes back. Renaming a volume in
; /Volumes relabels it (fsview.l0's fv_rename), and what is shown under
; its old name is shown under its new. Each change is made by the file
; calls, or by the file server, and the place listed again after it.

; ------------------------------------------------------------------ model

; How the place shows what is in it: tiles in a grid, or rows of a list.
(data FlView (FlGrid) (FlList))

; What is over the place: nothing; a dialog asking a new folder's name,
; typed so far; one asking a new name for the thing named, typed so far;
; one asking whether to delete it; or a file's lines shown, its name, and
; the state of the grid they are rows of.
(data FlOver (FlNone) (FlNewFolder UiEntryText) (FlRename (list int) UiEntryText) (FlDelete (list int))
             (FlPreview (list int) (list (list int)) UiGridState))

; Which menu is open: none; the menu button's; or a right click's, where
; it was, for the thing named, "" for the place itself.
(data FlMenu (FlNoMenu) (FlMainMenu) (FlContext int int (list int)))

; The window's state: the place shown, what is in it, how it is shown,
; the icon view's and the list's states, which share the selected
; thing's name; the places Back and Forward go to, the nearest first;
; what is over it, the menu, the line of what was last done, the
; sidebar's rows, and the full-color icons things are shown with.
(data Files (Files (list int) (list FvEntry) FlView UiIconState UiGridState (list (list int)) (list (list int))
                   FlOver FlMenu (list int) (list UiSideRow) UiImages))

; The prefixes of the place's views, the sidebar's rows, the path bar's
; parts, the view's toggles, the menus and the dialog's entry.
(def fl_items () (list int) "files")
(def fl_side () (list int) "side")
(def fl_path () (list int) "path")
(def fl_toggle () (list int) "view")
(def fl_menu () (list int) "menu")
(def fl_entry () (list int) "name")
(def fl_preview () (list int) "preview")

; The place shown, what is in it, what is over it, the line, and the
; view.
(def fl_dir((m Files)) (list int) (match m ((Files d es v is gs bk fw ov mn st pl ic) d)))
(def fl_entries ((m Files)) (list FvEntry) (match m ((Files d es v is gs bk fw ov mn st pl ic) es)))
(def fl_over ((m Files)) FlOver (match m ((Files d es v is gs bk fw ov mn st pl ic) ov)))
(def fl_status ((m Files)) (list int) (match m ((Files d es v is gs bk fw ov mn st pl ic) st)))
(def fl_view_of ((m Files)) FlView (match m ((Files d es v is gs bk fw ov mn st pl ic) v)))

; The selected thing's name, "" for none.
(def fl_selected ((m Files)) (list int) (match m ((Files d es v is gs bk fw ov mn st pl ic) (ui_is_selected is))))

; m with another line of what was last done.
(def fl_said ((m Files) (s (list int))) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic) (Files d es v is gs bk fw ov mn s pl ic))))

; m with another thing over it, and no menu.
(def fl_with_over ((m Files) (o FlOver)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic) (Files d es v is gs bk fw o (FlNoMenu) st pl ic))))

; m with another menu.
(def fl_with_menu ((m Files) (n FlMenu)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic) (Files d es v is gs bk fw ov n st pl ic))))

; m with name selected, in both views.
(def fl_selecting ((m Files) (name (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match is
        ((UiIconState s f)
          (match gs
            ((UiGridState c desc s2 f2) (Files d es v (UiIconState name f) (UiGridState c desc name f2) bk fw ov mn st pl ic))))))))

; The entry named name, if one is.
(def fl_entry_named ((es (list FvEntry)) (name (list int))) (Option FvEntry)
  (if (is_empty es) ((None FvEntry)) (if (eq (fv_name (head es)) name) (Some (head es)) (fl_entry_named (tail es) name))))

; What the line says of a place's entries: how many, or the one
; selected.
(def fl_count_text ((es (list FvEntry)) (sel (list int))) (list int)
  (if (not (is_empty sel))
      (append "\"" (append sel "\" selected"))
      (let n (length es) (append (digits n) (if (eq n 1) " item" " items")))))

; A state showing dir, its entries es, as view shows them, after the one
; before, m, of which it keeps the view, Back, Forward and the sidebar.
(def fl_at ((m Files) (dir (list int)) (es (list FvEntry)) (back (list (list int))) (fwd (list (list int)))) Files
  (match m
    ((Files d old v is gs bk fw ov mn st pl ic)
      (Files dir es v (ui_icon_state_new) (ui_grid_state_new) back fwd (FlNone) (FlNoMenu) (fl_count_text es "") pl ic))))

; The first state: / shown, as listed, with the sidebar's rows, and
; the full-color icons im.
(def fl_new ((es (list FvEntry)) (rows (list UiSideRow)) (im UiImages)) Files
  (Files "/" es (FlGrid) (ui_icon_state_new) (ui_grid_state_new) (nil (list int)) (nil (list int)) (FlNone) (FlNoMenu)
         (fl_count_text es "") rows im))

; ---------------------------------------------------------------- places

; The sidebar's rows: the computer, /; the volumes; and each of vols,
; /Volumes/LABEL, with frees its line, how much of it is free; each
; with its full-color icon from im, if it has it.
(def fl_place_rows ((vols (list (list int))) (frees (list (list int))) (im UiImages)) (list UiSideRow)
  (cons (UiSideRow "/" "computer" "Computer" "The system's files" (ui_image im "computer"))
        (cons (UiSideRow "/Volumes" "drive-harddisk" "Volumes" (append (digits (length vols)) (if (eq (length vols) 1) " volume" " volumes"))
                         (ui_image im "drive-multidisk"))
              (fl_volume_rows vols frees im))))

; A row of each of vols, its line the one of frees beside it.
(def fl_volume_rows ((vols (list (list int))) (frees (list (list int))) (im UiImages)) (list UiSideRow)
  (if (is_empty vols)
      (nil UiSideRow)
      (cons (UiSideRow (head vols) "drive-harddisk" (base_name (head vols)) (if (is_empty frees) "" (head frees)) (ui_image im "drive-harddisk"))
            (fl_volume_rows (tail vols) (if (is_empty frees) frees (tail frees)) im))))

; The place of the sidebar dir is in: its volume's, /Volumes's, or the
; computer's.
(def fl_place_of ((dir (list int))) (list int)
  (if (fv_is_volumes dir) dir (if (starts_with dir "/Volumes/") (append "/Volumes/" (up_to 47 (drop_n dir 9))) "/")))

; How much of volume vol is free, as its line says: kB of its clusters.
(def fl_free_text ((space FsSpace)) (list int)
  (match space
    ((FsSpace sectors clusters free files) (append (format_size (mul free 4096)) " free"))
    ((FsSpaceRefused code) "")))

; ---------------------------------------------------------------- update

; The state after action, set off with ev, that needs no file calls: the
; selection, the views, the menus and the dialogs' entries. Opening,
; going places and changing files are fl_acted's.
(def fl_update ((m Files) (action (list int)) (ev UiEvent)) Files
  (match (ui_context_of action)
    ((Some c) (fl_context m c))
    ((None)
      (let sk (ui_select_key (fl_items) action)
        (if (not (is_empty sk))
            (fl_said (fl_with_menu (fl_selecting m sk) (FlNoMenu)) (fl_count_text (fl_entries m) sk))
            (fl_update_more m action ev))))))

; More of fl_update: the view toggled, the menus opened and closed.
(def fl_update_more ((m Files) (action (list int)) (ev UiEvent)) Files
  (let tk (ui_select_key (fl_toggle) action)
    (if (not (is_empty tk))
        (fl_viewed m (if (eq tk "list") (FlList) (FlGrid)))
        (if (eq action "app.menu")
            (fl_with_menu m (match (fl_menu_of m) ((FlMainMenu) (FlNoMenu)) ((FlNoMenu) (FlMainMenu)) ((FlContext x y k) (FlMainMenu))))
            (if (eq action (ui_menu_dismiss_action (fl_menu)))
                (fl_with_menu m (FlNoMenu))
                (if (eq action "app.view")
                    (fl_with_menu (fl_viewed m (match (fl_view_of m) ((FlGrid) (FlList)) ((FlList) (FlGrid)))) (FlNoMenu))
                    (fl_update_dialog m action ev)))))))

; The menu open.
(def fl_menu_of ((m Files)) FlMenu (match m ((Files d es v is gs bk fw ov mn st pl ic) mn)))

; m shown as view v.
(def fl_viewed ((m Files) (v FlView)) Files
  (match m ((Files d es old is gs bk fw ov mn st pl ic) (Files d es v is gs bk fw ov mn st pl ic))))

; A right click: on a thing in the place, it selected and its menu
; there; on the place's ground, or on nothing that does anything, as an
; empty folder's page, the place's menu; on a volume's row in the
; sidebar, that volume's; elsewhere, as on a button, nothing.
(def fl_context ((m Files) (c UiContextAt)) Files
  (match c
    ((UiContextAt x y t)
      (let sk (ui_select_key (fl_items) t)
        (if (not (is_empty sk))
            (fl_said (fl_with_menu (fl_selecting m sk) (FlContext x y sk)) (fl_count_text (fl_entries m) sk))
            (let side (ui_select_key (fl_side) t)
              (if (fv_is_volume side)
                  (fl_with_menu m (FlContext x y side))
                  (if (is_empty t)
                      (fl_with_menu m (FlContext x y ""))
                      (match (ui_scroll_of t)
                    ((UiScrollArea name f mo sh st) (if (eq name (fl_items)) (fl_with_menu m (FlContext x y "")) m))
                    ((UiScrollBar name f mo sp sl) m)
                    ((UiNoScroll) m))))))))))

; Typing in a dialog's entry, and the views' own actions: the icon
; view's and the list's selection and scrolling, the list's sorting, and
; the preview's scrolling.
(def fl_update_dialog ((m Files) (action (list int)) (ev UiEvent)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match ov
        ((FlNewFolder t) (Files d es v is gs bk fw (FlNewFolder (ui_entry_update (fl_entry) t action ev)) mn st pl ic))
        ((FlRename old t) (Files d es v is gs bk fw (FlRename old (ui_entry_update (fl_entry) t action ev)) mn st pl ic))
        ((FlPreview name lines pg) (Files d es v is gs bk fw (FlPreview name lines (ui_grid_action pg (fl_preview) action)) mn st pl ic))
        ((FlDelete name) m)
        ((FlNone)
          (let is2 (ui_icon_action is (fl_items) action)
            (let gs2 (ui_grid_action gs (fl_items) action)
              (match v
                ((FlGrid) (fl_synced (Files d es v is2 gs bk fw ov mn st pl ic) (ui_is_selected is2)))
                ((FlList) (fl_synced (Files d es v is gs2 bk fw ov mn st pl ic) (ui_gs_selected gs2)))))))))))

; m with sel the selection of both views, and the line saying so if it
; changed.
(def fl_synced ((m Files) (sel (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match is
        ((UiIconState s f)
          (match gs
            ((UiGridState c desc s2 f2)
              (Files d es v (UiIconState sel f) (UiGridState c desc sel f2) bk fw ov mn
                     (if (eq sel (ui_is_selected is)) st (fl_count_text es sel)) pl ic))))))))

; ------------------------------------------------------------------ keys

; Linux's codes for F2 and Backspace.
(def fl_key_f2 () int 60)
(def fl_key_backspace () int 14)

; What a key does with nothing over the place and no menu: Enter opens
; the selection, F2 renames it, Delete deletes it, Backspace goes back;
; the arrows, Home, End, Page Up and Page Down move it, scrolled into
; view as the window w shows the view. Its action, or "" and the state
; it moved to.
(data FlKeyed (FlKeyAction (list int)) (FlKeyMoved Files))

; What key code does in m, shown in w.
(def fl_keyed ((m Files) (code int) (w UiWin)) FlKeyed
  (if (eq code (ui_key_enter)) (FlKeyAction "app.open")
  (if (eq code (fl_key_f2)) (FlKeyAction "app.rename")
  (if (eq code (ui_key_delete)) (FlKeyAction "app.delete")
  (if (eq code (fl_key_backspace)) (FlKeyAction "app.back")
  (FlKeyMoved (fl_moved m code w)))))))

; The selection moved by a key, in whichever view is shown.
(def fl_moved ((m Files) (code int) (w UiWin)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match v
        ((FlGrid)
          (let is2 (ui_icon_key (fl_icon_data m) code (ui_win_scroller w (fl_items)) (ui_win_icon_cols w (fl_items)))
            (fl_synced (Files d es v is2 gs bk fw ov mn st pl ic) (ui_is_selected is2))))
        ((FlList)
          (let gs2 (ui_grid_key (fl_grid_view m) code (ui_win_scroller w (fl_items)))
            (fl_synced (Files d es v is gs2 bk fw ov mn st pl ic) (ui_gs_selected gs2))))))))

; ----------------------------------------------------------------- view

; The window: the sidebar's pane, a line, and the place's; under the
; menu, if one is open, or the dialog, if one is.
(def fl_view ((m Files)) UiWidget
  (let page (UiBox (UiH) 0 (cons (fl_side_pane m) (cons (UiSeparator (UiV)) (cons (UiExpand (fl_place_pane m)) (nil UiWidget)))))
    (match (fl_over m)
      ((FlNewFolder t) (UiModal page (fl_name_alert "New Folder" "Create" t (fv_name_ok (ui_entry_text t)))))
      ((FlRename old t) (UiModal page (fl_name_alert (append "Rename \"" (append old "\"")) "Rename" t (fl_rename_ok m old (ui_entry_text t)))))
      ((FlDelete name) (UiModal page (fl_delete_alert name)))
      ((FlPreview name lines pg) (fl_with_popover m page))
      ((FlNone) (fl_with_popover m page)))))

; page under the menu that is open, if one is.
(def fl_with_popover ((m Files) (page UiWidget)) UiWidget
  (match (fl_menu_of m)
    ((FlNoMenu) page)
    ((FlMainMenu) (UiPopover page (UiMenu (fl_menu) (UiBelow "app.menu") (fl_main_items m))))
    ((FlContext x y k) (UiPopover page (UiMenu (fl_menu) (UiAt x y) (fl_context_items m k))))))

; The menu button's: New Folder..., Refresh, and the view not shown.
(def fl_main_items ((m Files)) (list UiMenuItem)
  (cons (UiItem "app.newfolder" "New Folder..." (is_empty (fv_fixed_why (fl_dir m))))
        (cons (UiItemSep)
              (cons (UiItem "app.refresh" "Refresh" true)
                    (cons (UiItem "app.view" (match (fl_view_of m) ((FlGrid) "Show as List") ((FlList) "Show as Grid")) true)
                          (nil UiMenuItem))))))

; A right click's, for the thing named k, or the place for "": Open,
; Rename... and Delete, each only where it can be done; or New Folder...
; A volume's row in the sidebar has Open and Rename...
(def fl_context_items ((m Files) (k (list int))) (list UiMenuItem)
  (if (is_empty k)
      (cons (UiItem "app.newfolder" "New Folder..." (is_empty (fv_fixed_why (fl_dir m)))) (nil UiMenuItem))
      (if (starts_with k "/")
          (cons (UiItem (ui_select_action "go" k) "Open" true)
                (cons (UiItem (ui_select_action "relabel" k) "Rename..." true) (nil UiMenuItem)))
          (let fixed (not (is_empty (fv_fixed_why (fl_dir m))))
            (cons (UiItem "app.open" "Open" true)
                  (cons (UiItemSep)
                        (cons (UiItem "app.rename" "Rename..." (if fixed (fv_is_volumes (fl_dir m)) true))
                              (cons (UiItem "app.delete" "Delete" (not fixed)) (nil UiMenuItem)))))))))

; A dialog asking for a name, titled title, its button labelled verb,
; live if ok.
(def fl_name_alert ((title (list int)) (verb (list int)) (t UiEntryText) (ok bool)) UiWidget
  (ui_alert_form title (nil (list int))
    (cons (UiProps (cons (UiProp "Name" (UiEntry (fl_entry) t "" (fl_entry_w))) (nil UiProp))) (nil UiWidget))
    (cons (fl_cancel) (cons (UiButton "dialog.ok" "" verb (UiBtnSuggested) ok) (nil UiWidget)))))

; How wide a name's entry is: 24 of the face's widest characters, and
; its edges.
(def fl_entry_w () int (add (ui_chars_w 24 (ui_text_font) false) (add (mul 2 (ui_entry_pad)) (ui_entry_cursor_w))))

; Whether old may be renamed new where m is: a name, or in /Volumes a
; label, other than the one it has.
(def fl_rename_ok ((m Files) (old (list int)) (new (list int))) bool
  (if (eq old new) false (if (fv_is_volumes (fl_dir m)) (label_ok new) (fv_name_ok new))))

; The dialog asking whether to delete name.
(def fl_delete_alert ((name (list int))) UiWidget
  (ui_alert (append "Delete \"" (append name "\"?")) (cons "It will be gone for good." (nil (list int)))
            (cons (fl_cancel) (cons (UiButton "dialog.ok" "" "Delete" (UiBtnDestructive) true) (nil UiWidget)))))

; A dialog's Cancel.
(def fl_cancel () UiWidget (UiButton "dialog.cancel" "" "Cancel" (UiBtnRegular) true))

; The sidebar's pane: its header bar, titled Files, and the places, the
; one the place shown is in selected.
(def fl_side_pane ((m Files)) UiWidget
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (UiBox (UiV) 0
        (cons (UiCsdBar (nil UiWidget) (UiLabel "Files" (UiHeading) (UiCenter)) (nil UiWidget) false)
              (cons (UiExpand (UiSidebar (ui_sidebar_w) pl (fl_side) (fl_place_of d))) (nil UiWidget)))))))

; The place's pane: its header bar, then what is in the place, or the
; file shown, then the line of what was done.
(def fl_place_pane ((m Files)) UiWidget
  (UiBox (UiV) 0
    (cons (fl_header m)
          (cons (UiExpand (fl_body m))
                (cons (UiSeparator (UiH))
                      (cons (UiPad (ui_space_m) (ui_space_s) (UiLabel (fl_status m) (UiDimmed) (UiStart))) (nil UiWidget)))))))

; The place's header bar: Back and Forward, the path bar, the toggle of
; the views, the menu button, and the window's close button.
(def fl_header ((m Files)) UiWidget
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (let preview (match ov ((FlPreview n l p) true) ((FlNone) false) ((FlNewFolder t) false) ((FlRename o t) false) ((FlDelete n) false))
        (UiCsdBar (cons (UiButton "app.back" "go-previous" "" (UiBtnFlat) (if preview true (not (is_empty bk))))
                        (cons (UiButton "app.forward" "go-next" "" (UiBtnFlat) (if preview false (not (is_empty fw)))) (nil UiWidget)))
                  (UiPathBar (fl_path) (if preview (append (fv_crumbs d) (cons (fl_preview_name ov) (nil (list int)))) (fv_crumbs d)))
                  (cons (UiToggleGroup (fl_toggle) (fl_toggles) (match v ((FlGrid) "grid") ((FlList) "list")))
                        (cons (UiButton "app.menu" "open-menu" "" (UiBtnFlat) true) (nil UiWidget)))
                  true)))))

; The name of the file shown, if one is.
(def fl_preview_name ((ov FlOver)) (list int)
  (match ov ((FlPreview n l p) n) ((FlNone) "") ((FlNewFolder t) "") ((FlRename o t) "") ((FlDelete n) "")))

; The view's toggles: the grid, and the list.
(def fl_toggles () (list UiToggle)
  (cons (UiToggle "grid" "view-grid" "") (cons (UiToggle "list" "view-list" "") (nil UiToggle))))

; What is in the place: its file shown, a page of an empty folder, its
; tiles, or its rows.
(def fl_body ((m Files)) UiWidget
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match ov
        ((FlPreview name lines pg) (UiGrid (fl_preview_view name lines pg)))
        ((FlNone) (fl_place_body m))
        ((FlNewFolder t) (fl_place_body m))
        ((FlRename o t) (fl_place_body m))
        ((FlDelete n) (fl_place_body m))))))

; What is in the place itself.
(def fl_place_body ((m Files)) UiWidget
  (if (is_empty (fl_entries m))
      (UiView (UiStatusPage "folder" "Folder is Empty" ""))
      (match (fl_view_of m)
        ((FlGrid) (UiIconView (fl_icon_data m)))
        ((FlList) (UiGrid (fl_grid_view m))))))

; The tiles of m's entries.
(def fl_icon_data ((m Files)) UiIconData
  (match m ((Files d es v is gs bk fw ov mn st pl ic) (UiIconData (fl_items) (fl_tiles es ic) is))))

; A tile of each of es, its icon from im: a thing's full-color icon, as
; Nautilus shows it; an app's its own, as the launcher shows it.
(def fl_tiles ((es (list FvEntry)) (im UiImages)) (list UiTile)
  (if (is_empty es)
      (nil UiTile)
      (match (head es)
        ((FvEntry n k s) (cons (fl_tile n k im) (fl_tiles (tail es) im))))))

; The tile of name, of kind k: its icon drawn, or, with none, the
; symbolic one, a place's in the accent, as Adwaita's folders are blue.
(def fl_tile ((name (list int)) (k FvKind) (im UiImages)) UiTile
  (let ops (fl_icon_ops k im)
    (if (is_empty ops)
        (UiTile name (fl_icon k) name (if (fv_is_place k) (UiAccentTone) (UiNeutral)))
        (UiTileDrawn name ops name))))

; What a thing's icon paints, 48 square from 0, 0: an app's image, or
; its drawing commands' ops; anything else's full-color icon from im;
; none for an app with no icon, or an icon im has not.
(def fl_icon_ops ((k FvKind) (im UiImages)) (list UiPaint)
  (match k
    ((FvApp i)
      (match i
        ((FvImage ts) (fl_image_ops ts))
        ((FvDrawn ds) (fl_draws_ops ds))))
    ((FvDir) (fl_image_ops (ui_image im (fl_icon k)))) ((FvVolume) (fl_image_ops (ui_image im (fl_icon k))))
    ((FvProgram) (fl_image_ops (ui_image im (fl_icon k)))) ((FvText) (fl_image_ops (ui_image im (fl_icon k))))))

; Images ts painted 48 square from 0, 0; nothing for none.
(def fl_image_ops ((ts (list UiCov))) (list UiPaint)
  (if (is_empty ts) (nil UiPaint) (cons (UiPImage 0 0 (ui_tile_icon) false ts) (nil UiPaint))))

; What each of ds paints, in order.
(def fl_draws_ops ((ds (list UiDraw))) (list UiPaint)
  (if (is_empty ds) (nil UiPaint) (append (ui_draw_ops (head ds)) (fl_draws_ops (tail ds)))))

; An app's icon in a list, 16 square: its image; or the symbolic icon
; its icon.draw puts on its square, in the square's color, as the square
; cannot be drawn that small with the icon on it, or in its own color if
; the square is too light to show on the list's ground; the generic app
; icon if it has none. Anything else's full-color icon from im, or its
; symbolic one if im has not that.
(def fl_cell_icon ((name (list int)) (k FvKind) (im UiImages)) UiCell
  (match k
    ((FvApp i)
      (match i
        ((FvImage ts) (fl_cell_image name (fl_icon k) ts))
        ((FvDrawn ds) (fl_cell_drawn name k ds))))
    ((FvDir) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))
    ((FvVolume) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))
    ((FvProgram) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))
    ((FvText) (fl_cell_image name (fl_icon k) (ui_image im (fl_icon k))))))

; A cell of name beside images ts, or symbolic icon if there are none.
(def fl_cell_image ((name (list int)) (icon (list int)) (ts (list UiCov))) UiCell
  (if (is_empty ts) (UiCellIcon icon name) (UiCellImage ts name)))

; An app's icon in a list from its icon.draw's commands ds.
(def fl_cell_drawn ((name (list int)) (k FvKind) (ds (list UiDraw))) UiCell
  (let glyph (fl_draws_glyph ds)
    (if (is_empty glyph)
        (UiCellIcon (fl_icon k) name)
        (let sq (fl_draws_color ds (ui_accent_bg))
          (UiCellTinted glyph (if (fl_is_light sq) (fl_draws_glyph_color ds sq) sq) name)))))

; The first icon ds draw, "" for none; and the color of the first square,
; or c.
(def fl_draws_glyph ((ds (list UiDraw))) (list int)
  (if (is_empty ds)
      ""
      (match (head ds)
        ((UiDrawIcon x y name sc c) name)
        ((UiDrawRound x y w h r c) (fl_draws_glyph (tail ds)))
        ((UiDrawButton x y k l) (fl_draws_glyph (tail ds)))
        ((UiDrawBasic cmd) (fl_draws_glyph (tail ds))))))
(def fl_draws_color ((ds (list UiDraw)) (c int)) int
  (if (is_empty ds)
      c
      (match (head ds)
        ((UiDrawRound x y w h r col) col)
        ((UiDrawIcon x y name sc col) (fl_draws_color (tail ds) c))
        ((UiDrawButton x y k l) (fl_draws_color (tail ds) c))
        ((UiDrawBasic cmd) (fl_draws_color (tail ds) c)))))

; The color of the first icon ds draw, or c.
(def fl_draws_glyph_color ((ds (list UiDraw)) (c int)) int
  (if (is_empty ds)
      c
      (match (head ds)
        ((UiDrawIcon x y name sc col) col)
        ((UiDrawRound x y w h r col) (fl_draws_glyph_color (tail ds) c))
        ((UiDrawButton x y k l) (fl_draws_glyph_color (tail ds) c))
        ((UiDrawBasic cmd) (fl_draws_glyph_color (tail ds) c)))))

; Whether c is light: its luma, ITU-R 601's, over 200 of 255, as Adwaita's
; light_ colors are and its darker ones not.
(def fl_is_light ((c int)) bool
  (gt (div (add (mul (rgb_red c) 299) (add (mul (rgb_green c) 587) (mul (rgb_blue c) 114))) 1000) 200))

; A thing's icon, and the word for what it is.
(def fl_icon ((k FvKind)) (list int)
  (match k ((FvDir) "folder") ((FvVolume) "drive-harddisk") ((FvApp ds) "view-app-grid") ((FvProgram) "application-x-executable") ((FvText) "text-x-generic")))
(def fl_kind_word ((k FvKind)) (list int)
  (match k ((FvDir) "Folder") ((FvVolume) "Volume") ((FvApp ds) "App") ((FvProgram) "Program") ((FvText) "Document")))

; What a thing's size says in the list: a file's or a volume's bytes, as
; format_size says them; how many things a folder or a bundle holds;
; nothing if it is not known.
(def fl_size_cell ((k FvKind) (s int)) UiCell
  (if (lt s 0)
      (UiCellText "")
      (if (fv_is_holder k) (UiCellNum s (if (eq s 1) " item" " items")) (UiCellSize s))))

; The list of m's entries: Name, its icon beside it, Size and Kind.
(def fl_grid_view ((m Files)) UiGridView
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (UiGridView (fl_items)
                  (cons (UiColumn "Name" 0 (UiStart) true) (cons (UiColumn "Size" 100 (UiEnd) true) (cons (UiColumn "Kind" 120 (UiStart) true) (nil UiColumn))))
                  (fl_rows es ic) gs))))

; A row of each of es, keyed by its name: its icon, from im, and name,
; its size as fl_size_cell says it, and what it is.
(def fl_rows ((es (list FvEntry)) (im UiImages)) (list UiRow)
  (if (is_empty es)
      (nil UiRow)
      (match (head es)
        ((FvEntry n k s)
          (cons (UiRow n (cons (fl_cell_icon n k im) (cons (fl_size_cell k s) (cons (UiCellText (fl_kind_word k)) (nil UiCell)))))
                (fl_rows (tail es) im))))))

; A file's lines as the rows of a list of one column, titled its name.
(def fl_preview_view ((name (list int)) (lines (list (list int))) (pg UiGridState)) UiGridView
  (UiGridView (fl_preview) (cons (UiColumn name 0 (UiStart) false) (nil UiColumn)) (fl_line_rows lines 0 (nil UiRow)) pg))

; A row of each of lines, keyed by its number from i, onto acc.
(def fl_line_rows ((lines (list (list int))) (i int) (acc (list UiRow))) (list UiRow)
  (if (is_empty lines)
      (rev acc)
      (fl_line_rows (tail lines) (add i 1) (cons (UiRow (digits i) (cons (UiCellText (head lines)) (nil UiCell))) acc))))

; ------------------------------------------------------------- file calls

; m showing dir, listed: Back to where it was if back, Forward kept if
; fwd; or, if dir cannot be listed, as it was, saying why.
(def fl_go ((m Files) (dir (list int)) (back (list (list int))) (fwd (list (list int)))) Files
  (match (fv_list dir)
    ((FvNotListed why) (fl_said (fl_with_over m (FlNone)) (append dir (append ": " why))))
    ((FvListed es) (fl_at m dir es back fwd))))

; m gone into dir from where it is, Forward forgotten.
(def fl_went ((m Files) (dir (list int))) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic) (if (eq dir d) (fl_refreshed m (fl_status m)) (fl_go m dir (cons d bk) (nil (list int)))))))

; m back where it was before, or forward again.
(def fl_back ((m Files)) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match ov
        ((FlPreview n l p) (fl_with_over m (FlNone)))
        ((FlNone) (if (is_empty bk) m (fl_go m (head bk) (tail bk) (cons d fw))))
        ((FlNewFolder t) m) ((FlRename o t) m) ((FlDelete n) m)))))
(def fl_forward ((m Files)) Files
  (match m ((Files d es v is gs bk fw ov mn st pl ic) (if (is_empty fw) m (fl_go m (head fw) (cons d bk) (tail fw))))))

; m's place listed again, and its sidebar, the selection kept if it is
; still there, its line saying said.
(def fl_refreshed ((m Files) (said (list int))) Files
  (match m
    ((Files d es v is gs bk fw ov mn st pl ic)
      (match (fv_list d)
        ((FvNotListed why) (fl_said m (append d (append ": " why))))
        ((FvListed es2)
          (let sel (match (fl_entry_named es2 (ui_is_selected is)) ((Some e) (ui_is_selected is)) ((None) ""))
            (fl_synced (Files d es2 v (UiIconState "" (match is ((UiIconState s f) f))) (match gs ((UiGridState c desc s f) (UiGridState c desc "" f))) bk fw (FlNone) (FlNoMenu)
                              (if (is_empty said) (fl_count_text es2 "") said) (fl_rows_now ic) ic)
                       sel)))))))

; The sidebar's rows as the volumes are now, their icons im's.
(def fl_rows_now ((im UiImages)) (list UiSideRow)
  (let vols (fs_volumes)
    (fl_place_rows vols (fl_frees vols) im)))

; How much of each of vols is free, as its row says.
(def fl_frees ((vols (list (list int)))) (list (list int))
  (if (is_empty vols) vols (cons (fl_free_text (fs_df (head vols))) (fl_frees (tail vols)))))

; The selection opened: gone into, started, or shown.
(def fl_opened ((m Files) (name (list int))) Files
  (match (fl_entry_named (fl_entries m) name)
    ((None) m)
    ((Some e)
      (match (fv_open (fl_dir m) name (fv_kind e))
        ((FvGo path) (fl_went m path))
        ((FvStarted said) (fl_said m said))
        ((FvNotOpened why) (fl_said m (append name (append ": " why))))
        ((FvShown lines) (fl_said (fl_with_over m (FlPreview name lines (ui_grid_state_new))) (append "\"" (append name "\" shown"))))))))

; The dialog's button: its folder made, its thing renamed, or deleted;
; the place listed again, saying what was done or why not.
(def fl_answered ((m Files)) Files
  (match (fl_over m)
    ((FlNone) m)
    ((FlPreview n l p) m)
    ((FlNewFolder t)
      (let name (ui_entry_text t)
        (if (not (fv_name_ok name))
            m
            (fl_done m (fv_mkdir (fl_dir m) name) (append "Made \"" (append name "\"")) name))))
    ((FlRename old t)
      (let new (ui_entry_text t)
        (if (not (fl_rename_ok m old new))
            m
            (fl_renamed m old new (fv_rename (fl_dir m) old new)))))
    ((FlDelete name)
      (fl_done (fl_selecting m "") (fv_delete (fl_dir m) name) (append "Deleted \"" (append name "\"")) ""))))

; After a change that said why, "" if it was done: the place listed
; again, saying done or why, with sel selected.
(def fl_done ((m Files) (why (list int)) (done (list int)) (sel (list int))) Files
  (if (is_empty why)
      (fl_selecting (fl_refreshed (fl_with_over m (FlNone)) done) sel)
      (fl_said (fl_with_over m (FlNone)) why)))

; After old was renamed new, with why "" if it was: a volume's places
; and every path under it, Back's and Forward's too, made new's.
(def fl_renamed ((m Files) (old (list int)) (new (list int)) (why (list int))) Files
  (if (not (is_empty why))
      (fl_said (fl_with_over m (FlNone)) why)
      (match m
        ((Files d es v is gs bk fw ov mn st pl ic)
          (let said (append "Renamed \"" (append old (append "\" to \"" (append new "\""))))
            (if (fv_is_volumes d)
                (fl_selecting (fl_refreshed (Files d es v is gs (fv_all_relabelled bk old new) (fv_all_relabelled fw old new) (FlNone) mn st pl ic) said) new)
                (fl_selecting (fl_refreshed (fl_with_over m (FlNone)) said) new)))))))

; A volume, its path vol, relabelled from the sidebar: as from /Volumes,
; and the place shown, if it is on it, under its new name.
(def fl_relabelled_place ((m Files) (vol (list int))) Files
  (fl_with_over m (FlRename (base_name vol) (UiEntryText (base_name vol) (length (base_name vol))))))

; ------------------------------------------------------------------ acts

; The state after action, set off with ev, in window w: what needs the
; file calls first, then the rest, fl_update. With the dialog's entry, as
; with its button, Enter answers it; Esc closes what is over the place,
; or the menu.
(def fl_acted ((m Files) (action (list int)) (ev UiEvent) (w UiWin)) Files
  (let code (ui_key_pressed ev)
    (if (if (eq code (ui_key_esc)) (is_empty action) false)
        (fl_escaped m)
        (if (any_eq action (cons "dialog.ok" (cons (ui_entry_activate_action (fl_entry)) (nil (list int)))))
            (fl_answered m)
            (if (eq action "dialog.cancel")
                (fl_with_over m (FlNone))
                (fl_acted_more m action ev w code))))))

; More of fl_acted: a place chosen in the sidebar or the path bar.
(def fl_acted_more ((m Files) (action (list int)) (ev UiEvent) (w UiWin) (code int)) Files
  (let side (ui_select_key (fl_side) action)
    (if (not (is_empty side))
        (fl_went m side)
        (let depth (ui_select_key (fl_path) action)
          (if (not (is_empty depth))
              (fl_went (fl_with_over m (FlNone)) (fv_at_depth (fl_dir m) (int_prefix depth 0)))
              (fl_acted_items m action ev w code))))))

; The place's own actions: back and forward, refresh, a thing opened by
; a double click or Open, the dialogs opened, and keys.
(def fl_acted_items ((m Files) (action (list int)) (ev UiEvent) (w UiWin) (code int)) Files
  (if (eq action "app.back") (fl_back m)
  (if (eq action "app.forward") (fl_forward m)
  (if (eq action "app.refresh") (fl_refreshed m "")
  (if (eq action "app.open") (fl_opened (fl_with_menu m (FlNoMenu)) (fl_selected m))
  (if (eq action "app.newfolder") (fl_asked m (FlNewFolder (UiEntryText "" 0)))
  (if (eq action "app.rename") (fl_rename_asked m)
  (if (eq action "app.delete") (fl_delete_asked m)
  (fl_acted_rest m action ev w code)))))))))

; The menu of a sidebar's volume, Open and Rename...; a double click;
; keys with nothing over the place; else fl_update.
(def fl_acted_rest ((m Files) (action (list int)) (ev UiEvent) (w UiWin) (code int)) Files
  (let go (ui_select_key "go" action)
    (if (not (is_empty go))
        (fl_went m go)
        (let rl (ui_select_key "relabel" action)
          (if (not (is_empty rl))
              (fl_went_to_relabel m rl)
              (let sk (ui_select_key (fl_items) action)
                (if (if (not (is_empty sk)) (ui_win_double w) false)
                    (fl_opened (fl_update m action ev) sk)
                    (if (if (is_empty action) (ge code 0) false)
                        (fl_key_acted m code w)
                        (fl_update m action ev)))))))))

; Renaming a volume from the sidebar: /Volumes shown, it selected, and
; asked its new name.
(def fl_went_to_relabel ((m Files) (vol (list int))) Files
  (fl_relabelled_place (fl_selecting (fl_went m "/Volumes") (base_name vol)) vol))

; A key with nothing over the place, and no menu, as fl_keyed says.
(def fl_key_acted ((m Files) (code int) (w UiWin)) Files
  (match (fl_over m)
    ((FlNone)
      (match (fl_menu_of m)
        ((FlNoMenu) (match (fl_keyed m code w) ((FlKeyAction a) (fl_acted_items m a (UiOther 0 "") w -1)) ((FlKeyMoved m2) m2)))
        ((FlMainMenu) m)
        ((FlContext x y k) m)))
    ((FlPreview n l p)
      (if (eq code (fl_key_backspace))
          (fl_back m)
          (match m ((Files d es v is gs bk fw ov mn st pl ic)
            (Files d es v is gs bk fw (FlPreview n l (ui_grid_key (fl_preview_view n l p) code (ui_win_scroller w (fl_preview)))) mn st pl ic)))))
    ((FlNewFolder t) m) ((FlRename o t) m) ((FlDelete n) m)))

; Esc: the menu closed, else what is over the place.
(def fl_escaped ((m Files)) Files
  (match (fl_menu_of m)
    ((FlNoMenu) (fl_with_over m (FlNone)))
    ((FlMainMenu) (fl_with_menu m (FlNoMenu)))
    ((FlContext x y k) (fl_with_menu m (FlNoMenu)))))

; A dialog opened over the place, unless the place cannot be changed.
(def fl_asked ((m Files) (o FlOver)) Files
  (let why (fv_fixed_why (fl_dir m))
    (if (is_empty why) (fl_with_over m o) (fl_said (fl_with_menu m (FlNoMenu)) why))))

; The selection asked a new name, its own typed already; in /Volumes too.
(def fl_rename_asked ((m Files)) Files
  (let sel (fl_selected m)
    (if (is_empty sel)
        (fl_with_menu m (FlNoMenu))
        (let o (FlRename sel (UiEntryText sel (length sel)))
          (if (fv_is_volumes (fl_dir m)) (fl_with_over m o) (fl_asked m o))))))

; The selection asked whether to delete it.
(def fl_delete_asked ((m Files)) Files
  (let sel (fl_selected m)
    (if (is_empty sel) (fl_with_menu m (FlNoMenu)) (fl_asked m (FlDelete sel)))))

; The name of the entry a dialog just opened has, if it has one.
(def fl_dialog_entry ((o FlOver)) (list int)
  (match o
    ((FlNewFolder t) (ui_entry_action (fl_entry)))
    ((FlRename old t) (ui_entry_action (fl_entry)))
    ((FlDelete n) "") ((FlPreview n l p) "") ((FlNone) "")))

; The window with the focus on a dialog's entry as it opens, so that
; typing goes to it at once; else as it was.
(def fl_focused ((w UiWin) (m Files) (m2 Files)) UiWin
  (let e (fl_dialog_entry (fl_over m2))
    (if (if (is_empty e) true (eq (fl_dialog_entry (fl_over m)) e)) w (ui_win_focusing w e))))

; ------------------------------------------------------------------- loop

; why said on standard error, and a failure.
(def fl_complain ((why (list int))) int (complain_as "files" why))

; The window opened, decorated by itself, the full-color icons loaded, /
; listed, and the window served until its close button is clicked.
(def files () int
  (match (ui_open_csd "Files" 880 560)
    ((UiOpenFailed why) (fl_complain why))
    ((UiOpenedWin w)
      (let im (ui_images_load (ui_image_names) (ui_win_scale w))
        (let m (match (fv_list "/")
                 ((FvListed es) (fl_new es (fl_rows_now im) im))
                 ((FvNotListed why) (fl_said (fl_new (nil FvEntry) (fl_rows_now im) im) why)))
          (fl_loop (ui_present w (fl_view m)) m))))))

; Each event routed, the state changed, and the window repainted, until
; the window's own close button closes it.
(def fl_loop ((w UiWin) (m Files)) int
  (match (port_receive (ui_win_port w))
    ((RecvFailed) (fl_complain "lost its port"))
    ((Message from b)
      (let ev (ui_event_of w (Message from b))
        (match (ui_route w ev)
          ((UiRouted w2 action)
            (if (eq action (ui_close_action))
                (ui_close w2)
                (let m2 (fl_acted m action ev w2)
                  (fl_loop (ui_present (fl_focused w2 m m2) (fl_view m2)) m2)))))))))
