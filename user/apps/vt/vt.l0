; vt.l0 -- Terminal: terminals in a window, as GNOME Console's, each in a
; tab of its own. Keys typed while the window is in front, which the
; compositor, user/wm, sends it, go to the selected tab, edited into lines
; as the serial line's are; what is written to a tab is kept in its cells
; (cells.l0) and, if it is the one shown, drawn into the window in the
; font's 8 by 16 cells, light on a dark ground, scrolling up a line at the
; bottom.
;
;   vt [COLS ROWS]          a window of 80 by 24 cells unless given
;
; The window draws its own decorations (window.l0's ui_open_csd): the
; toolkit's header bar, with the selected tab's name as its title and a
; button that opens a tab, and under it, once there are two tabs or
; more, a tab bar (nav.l0's UiTabBar), a click on a tab selecting it and
; its close button closing it. Under them is the terminal, a drawing area
; vt paints itself. Its edges and its header bar resize and maximize it as
; any toolkit window's do, and the terminal is then as many cells as fit,
; every tab's cells wrapped again at the new width (cells_rewrapped).
;
; Each tab is a terminal as user/lib/tty.l0 says, the same as uart's
; console: "r" for a line, "i" for Ctrl-C notices, "w" to write. Each tab
; has a port of its own, on which vt registers its name, the first of
; vt1, vt2, and so on that no one has registered, and vt waits on the
; app's port and every tab's at once, a set of ports (port_set), so it
; knows a tab by the port a message came on. With its name registered vt
; starts the tab's shell, sh NAME, and watches it: when the shell exits
; the tab closes, its name let go (name_unregister) and its port kept for
; the next tab, and the window closes with its last.
;
; Terminal is an app of many windows on one port (uiapp.l0's UiApp),
; registered as app.vt: launched again while it runs, it is sent an open
; (appopen.l0), and opens a new window with one tab, answering with the
; window's id. Each window is a Vt of its own, its tabs its own; vt ends
; when its last window closes, with the status of the shell whose exit
; closed it, or 0 for a close button. Its windows have at most tabs_most
; tabs between them, as one set holds port_set_limit ports.
; The wheel scrolls the selected tab back through what scrolled off it.
; At the desktop's scale 2 a cell is still 8 by 16 of the desktop's
; pixels, 16 by 32 of its buffer's, and its characters are the face's
; (face.l0), smooth.

; Its colors are the toolkit's for a terminal, GNOME Console's.
(def ground () int (ui_term_bg))
(def ink () int (ui_term_fg))
(def cursor_color () int (ui_term_cursor))

; A cell: the toolkit's character, the font's glyph.
(def cell_w () int (ui_char_w))
(def cell_h () int (ui_char_h))

; ---------------------------------------------------------------- render

; Where the next character goes, and how many columns and rows fit.
(data Term (Term int int int int))

; What bytes written at the terminal do to its cells: a run of characters
; from a cell, a cell blanked, a line scrolled up, and a row ended, by a
; wrap if true, else by a newline.
(data Op (OpText int int (list int)) (OpBlank int int) (OpScroll) (OpEnd int bool))

; The ops that show bytes, and where the cursor is after them.
(data Rendered (Rendered Term (list Op)))

(def render ((t Term) (bs (list int))) Rendered
  (render_onto t bs (nil int) 0 (nil Op)))

; A run of printable characters waiting to be drawn: reversed, from
; column start of the term's row; and the ops so far, reversed.
(def render_onto ((t Term) (bs (list int)) (run (list int)) (start int) (ops (list Op))) Rendered
  (if (is_empty bs)
      (Rendered t (rev (flush_run t run start ops)))
      (render_byte t (head bs) (tail bs) run start ops)))

(def render_byte ((t Term) (b int) (rest (list int)) (run (list int)) (start int) (ops (list Op))) Rendered
  (match t
    ((Term col row cols rows)
      (if (if (ge b 32) (le b 126) false)
          (if (ge col cols)
              (wrapped t b rest run start ops)
              (render_onto (Term (add col 1) row cols rows) rest (cons b run) (if (is_empty run) col start) ops))
          (let done (flush_run t run start ops)
            (if (eq b 10) (newline t rest done false)
            (if (eq b 13) (render_onto (Term 0 row cols rows) rest (nil int) 0 done)
            (if (eq b 9) (render_onto t (append (spaces (sub 8 (mod col 8))) rest) (nil int) 0 done)
            (if (eq b 8) (backed t rest done)
            (render_onto t rest (nil int) 0 done))))))))))

; Past the last column: the next line, then the character.
(def wrapped ((t Term) (b int) (rest (list int)) (run (list int)) (start int) (ops (list Op))) Rendered
  (newline t (cons b rest) (flush_run t run start ops) true))

; The next line's start, scrolling a line up from the last; the row left
; ended by a wrap if wrap, else by a newline.
(def newline ((t Term) (rest (list int)) (ops (list Op)) (wrap bool)) Rendered
  (match t
    ((Term col row cols rows)
      (let ended (cons (OpEnd row wrap) ops)
        (if (ge (add row 1) rows)
            (render_onto (Term 0 row cols rows) rest (nil int) 0 (cons (OpScroll) ended))
            (render_onto (Term 0 (add row 1) cols rows) rest (nil int) 0 ended))))))

; Back one column, and that cell blanked, as a Backspace's echo needs.
(def backed ((t Term) (rest (list int)) (ops (list Op))) Rendered
  (match t
    ((Term col row cols rows)
      (if (eq col 0)
          (render_onto t rest (nil int) 0 ops)
          (let b (Term (sub (min col cols) 1) row cols rows)
            (render_onto b rest (nil int) 0 (cons (OpBlank (term_col b) row) ops)))))))

; The run drawn, if there is one, onto ops.
(def flush_run ((t Term) (run (list int)) (start int) (ops (list Op))) (list Op)
  (if (is_empty run)
      ops
      (match t ((Term col row cols rows) (cons (OpText start row (rev run)) ops)))))

; The cursor's cell: the last column while a wrap is pending.
(def term_col ((t Term)) int (match t ((Term col row cols rows) (min col (sub cols 1)))))
(def term_row ((t Term)) int (match t ((Term col row cols rows) row)))

; The cells after ops: what they write kept, rows scrolled, and rows'
; ends marked.
(def cells_after ((cl Cells) (ops (list Op))) Cells
  (if (is_empty ops)
      cl
      (cells_after
        (match (head ops)
          ((OpText col row cs) (cells_put cl col row cs))
          ((OpBlank col row) (cells_put cl col row " "))
          ((OpScroll) (cells_scroll cl))
          ((OpEnd row wrap) (cells_end cl row wrap)))
        (tail ops))))

; How many rows ops scroll up.
(def scrolls ((ops (list Op))) int (scrolls_onto ops 0))

; scrolls's loop: n so far.
(def scrolls_onto ((ops (list Op)) (n int)) int
  (if (is_empty ops)
      n
      (scrolls_onto (tail ops)
        (match (head ops)
          ((OpScroll) (add n 1))
          ((OpText col row cs) n) ((OpBlank col row) n) ((OpEnd row wrap) n)))))

; ---------------------------------------------------------------- the view

; How many rows a step of the wheel scrolls.
(def wheel_rows () int 3)

; How far back the view is after dy steps of the wheel, down positive,
; from back: wheel_rows a step, no further than the cells have rows
; scrolled off, nor past the bottom.
(def wheeled_back ((back int) (dy int) (most int)) int
  (max 0 (min most (sub back (mul dy (wheel_rows))))))

; How far back the view is once the screen has scrolled n rows under it,
; as output does while it is back: as far again, so that it shows what it
; did, unless that has gone from the ring.
(def kept_back ((back int) (n int) (most int)) int
  (if (eq back 0) 0 (min most (add back n))))

; ------------------------------------------------------------------- draw

; Where the terminal is in a window ww by wh with n tabs: all of it under
; the header bar, and under the tab bar once there are two tabs or more.
(def term_area ((ww int) (wh int) (n int)) Rect
  (let top (add (ui_headerbar_h) (if (ge n 2) (ui_tabbar_h) 0))
    (Rect 0 top ww (max 0 (sub wh top)))))

; How many columns and rows of cells fit in the area a, at least one.
(def area_cols ((a Rect)) int (max 1 (div (rect_w a) (cell_w))))
(def area_rows ((a Rect)) int (max 1 (div (rect_h a) (cell_h))))

; The tab's view drawn whole in the area a: each row; the ground below the
; last, where no whole row fits; and, while the view is back, the
; toolkit's overlay scrollbar along its right.
(def view_drawn ((c Canvas) (face UiFace) (a Rect) (t Tab)) Canvas
  (let rows (cells_rows (tab_cells t))
    (let c2 (rows_drawn c face a t 0 rows)
      (let under (mul rows (cell_h))
        (let c3 (ui_draw_fill c2 (Rect (rect_x a) (add (rect_y a) under) (rect_w a) (max 0 (sub (rect_h a) under))) (ground) (ui_face_scale face))
          (if (eq (tab_back t) 0) c3 (scrollbar_drawn c3 face a t)))))))

; The view's rows from v up to n drawn.
(def rows_drawn ((c Canvas) (face UiFace) (a Rect) (t Tab) (v int) (n int)) Canvas
  (if (ge v n) c (rows_drawn (row_drawn c face a t v) face a t (add v 1) n)))

; Row v of the view drawn across the area a: its ground, the characters
; of the row of the cells it shows, and the cursor, a line along the
; cell's last row, which no glyph uses, if it is on that row.
(def row_drawn ((c Canvas) (face UiFace) (a Rect) (t Tab) (v int)) Canvas
  (let cl (tab_cells t)
    (let l (cells_line cl (add (sub (cells_back cl) (tab_back t)) v))
      (let y (add (rect_y a) (mul v (cell_h)))
        (let s (ui_face_scale face)
          (let c2 (ui_draw_fill c (Rect (rect_x a) y (rect_w a) (cell_h)) (ground) s)
            (let c3 (ui_draw_text c2 face (rect_x a) y (ink) -1 (bytes_to_list (line_chars l)))
              (if (eq v (add (term_row (tab_term t)) (tab_back t)))
                  (ui_draw_fill c3 (Rect (add (rect_x a) (mul (term_col (tab_term t)) (cell_w))) (add y (sub (cell_h) 1)) (cell_w) 1) (cursor_color) s)
                  c3))))))))

; The toolkit's overlay scrollbar (grid.l0's ui_scrollbar_on) painted
; over the area's right edge: its slider as long as the share of the
; rows the view shows, as far down as the view is.
(def scrollbar_drawn ((c Canvas) (face UiFace) (a Rect) (t Tab)) Canvas
  (let cl (tab_cells t)
    (let rows (cells_rows cl)
      (nodes_painted c face a
        (ui_scrollbar_on "term" (rect_x a) (rect_w a) (rect_y a) (cell_h) (add (cells_back cl) rows) rows
                         (sub (cells_back cl) (tab_back t)) (ui_state_new (ui_style)) (ground) (nil UiNode))))))

; Each of ns's ops painted, cut to clip.
(def nodes_painted ((c Canvas) (face UiFace) (clip Rect) (ns (list UiNode))) Canvas
  (if (is_empty ns)
      c
      (match (head ns) ((UiNode r ops a f) (nodes_painted (ui_paint c face clip ops) face clip (tail ns))))))

; What output that scrolled k rows did to the view at the bottom, drawn:
; the area's rows moved k up, as they are copied, not drawn again, and
; then the rows from the cursor's before, as moved, to its after drawn
; again; or all of the view, if it scrolled a whole screen or more.
(def output_drawn ((c Canvas) (face UiFace) (a Rect) (before Term) (t Tab) (k int)) Canvas
  (let rows (cells_rows (tab_cells t))
    (if (ge k rows)
        (view_drawn c face a t)
        (let s (ui_face_scale face)
          (let moved (if (eq k 0) c (canvas_copy_rows c (rect_scaled (rows_rect a rows) s) (mul (mul k (cell_h)) s)))
            (rows_drawn moved face a t (max 0 (sub (term_row before) k)) (add (term_row (tab_term t)) 1)))))))

; What output_drawn changed: the rows it moved, or the rows it drew.
(def output_damage ((a Rect) (before Term) (t Tab) (k int)) Rect
  (let rows (cells_rows (tab_cells t))
    (if (gt k 0)
        (if (ge k rows) a (rows_rect a rows))
        (let lo (term_row before)
          (Rect (rect_x a) (add (rect_y a) (mul lo (cell_h))) (rect_w a) (mul (add (sub (term_row (tab_term t)) lo) 1) (cell_h)))))))

; The area's first n rows of cells, across all of it.
(def rows_rect ((a Rect) (n int)) Rect (Rect (rect_x a) (rect_y a) (rect_w a) (mul n (cell_h))))

; -------------------------------------------------------------- naming

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "vt" why))

; The name of terminal i: vt1 for 1.
(def vt_name ((i int)) (list int) (append "vt" (digits i)))

; The most names vt tries: as many as there can be processes.
(def vt_names () int (max_procs))

; What naming the terminal came to: the name it registered as, or why it
; has none.
(data VtName (VtNamed (list int)) (VtUnnamed (list int)))

; port registered as the first free name from vt_name i on: one taken
; means the next is tried, up to vt_names of them.
(def vt_register ((port int) (i int)) VtName
  (match (name_register port (vt_name i))
    ((Registered) (VtNamed (vt_name i)))
    ((RegisterTaken)
      (if (ge i (vt_names))
          (VtUnnamed (append "every name from vt1 to " (append (vt_name i) " is taken")))
          (vt_register port (add i 1))))
    ((RegisterNoPort) (VtUnnamed (vt_unregistered (RegisterNoPort))))
    ((RegisterTooLong) (VtUnnamed (vt_unregistered (RegisterTooLong))))))

; Why vt could not register, as name_register answered r.
(def vt_unregistered ((r Registration)) (list int)
  (append "cannot register: " (registration_why r)))

; The columns and rows the arguments give, or 80 by 24.
(def vt_cells ((argv (list (list int)))) Term
  (if (lt (length argv) 2)
      (Term 0 0 80 24)
      (Term 0 0 (max 8 (min 158 (int_prefix (head argv) 0)))
                (max 2 (min 46 (int_prefix (head (tail argv)) 0))))))

; A window of the cells the arguments give.
(def vt () int (windowed (vt_cells (args))))

; ---------------------------------------------------------------- ports

; The most tabs a window has: a set holds port_set_limit ports, the
; window's one of them.
(def tabs_most () int (sub (port_set_limit) 1))

; port, every message waiting on it taken and dropped, as a closed tab's
; port is before another tab has it: what its old shell sent last.
(def port_drained ((port int)) int
  (match (port_try_receive port)
    ((RecvFailed) port)
    ((Message from b) (port_drained port))))

; name, a closed tab's, let go: free for the next tab, or for anyone,
; at once. One already gone, or not vt's, is let be: the tab goes
; either way.
(def name_let_go ((name (list int))) int
  (if (is_empty name)
      0
      (match (name_unregister name)
        ((Unregistered) 0)
        ((UnregisterNoName) 0)
        ((UnregisterNotYours) 0))))

; ---------------------------------------------------------------- serving

; A window: the toolkit's window, the tabs, the status of the last shell
; to exit, the title wm was last told, what was last drawn whole in the
; terminal's area, and what the app lends it for a step (Lent).
(data Vt (Vt UiWin Tabs int (list int) Shown Lent))

; What a window is lent for a step, from the app's: the ports of tabs
; closed, in any of its windows, kept for the next tabs, since a port is
; never given back; and how many tabs its other windows have, as one set
; holds every window's.
(data Lent (Lent (list int) int))

; The ports lent, and the tabs elsewhere.
(def lent_free ((l Lent)) (list int) (match l ((Lent free others) free)))
(def lent_others ((l Lent)) int (match l ((Lent free others) others)))

; Whether a window with here tabs may open one more, others in the app's
; other windows: every tab's port is in the one set, beside the app's.
(def tabs_room ((here int) (others int)) bool
  (lt (add here others) (tabs_most)))

; What was last drawn whole: the area, the canvas, the tab shown, by its
; port, and how far back its view was. A view that differs in any of
; them from what is to be shown is drawn whole again.
(data Shown (Shown Rect Canvas int int))

; What a message does to a window: it goes on, or it has closed, as it
; was at the end, with the status vt ends with if it was the last.
(data Step (Go Vt) (Stop Vt int))

; What a window is asked to do in a step: take the compositor's notice
; m, at byte at of its payload; take what came on its tab's port; or
; close the tab whose shell exited.
(data Ask (AskWm Message int) (AskTab int (list int)) (AskExit int int))

; The step of window v asked q.
(def vt_asked ((v Vt) (q Ask)) Step
  (match q
    ((AskWm m at) (from_wm_at v m at))
    ((AskTab port payload)
      (match (tabs_by_port (vt_tabs v) port)
        ((Some t) (Go (from_tab v t payload)))
        ((None) (Go v))))
    ((AskExit pid status) (exited v pid status))))

; Terminal, an app of any number of windows on one port (uiapp.l0's
; UiApp): its windows' Vts by id, the ports of tabs closed, kept for the
; next tabs of any window, the set of ports last waited on, and the cells
; a new window has, the arguments'.
(data Vts (Vts UiApp (Map int Vt) (list int) (list int) Term))

; What a message does to the app: it goes on, or vt ends with a status,
; its last window closed.
(data VtsStep (VtsGo Vts) (VtsEnd int))

; The app with a window more, and its id; or as it was, and why not.
(data VtsOpen (VtsOpened Vts int) (VtsRefused Vts (list int)))

; The app started, a window t's cells big opened in it, and served.
(def windowed ((t Term)) int
  (match (ui_app_start)
    ((UiAppFailed why) (complain why))
    ((UiAppStarted a)
      (match (vts_opened (Vts a ((MapEmpty int Vt)) (nil int) (nil int) t))
        ((VtsRefused vs why) (complain why))
        ((VtsOpened vs id) (serve (vts_waiting vs)))))))

; The size of a window of t's cells: a header bar's height more.
(def term_win_w ((t Term)) int (match t ((Term col row cols rows) (mul cols (cell_w)))))
(def term_win_h ((t Term)) int (match t ((Term col row cols rows) (add (ui_headerbar_h) (mul rows (cell_h))))))

; vs with a new window, in front, of the cells it opens windows at, its
; first tab opened in it.
(def vts_opened ((vs Vts)) VtsOpen
  (match vs
    ((Vts a wins free set t)
      (match (ui_app_open_csd a "Terminal" (term_win_w t) (term_win_h t))
        ((UiAppRefused a2 why) (VtsRefused (Vts a2 wins free set t) why))
        ((UiAppOpened a2 id)
          (match (ui_app_win a2 id)
            ((None) (VtsRefused (Vts a2 wins free set t) "no window"))
            ((Some w)
              (let v (Vt w (tabs_none) 0 "Terminal" (Shown (Rect 0 0 0 0) (ui_win_canvas w) 0 0) (Lent free (vts_tab_count vs)))
                (VtsOpened (vts_kept (Vts a2 wins free set t) id (refreshed (tab_opened v))) id)))))))))

; The app's windows' Vts.
(def vts_wins ((vs Vts)) (list Vt) (match vs ((Vts a wins free set t) (map_values wins))))

; How many tabs the app's windows have, all together.
(def vts_tab_count ((vs Vts)) int (vt_tab_count_onto (vts_wins vs) 0))

; vt_tab_count's loop over l, onto n.
(def vt_tab_count_onto ((l (list Vt)) (n int)) int
  (if (is_empty l) n (vt_tab_count_onto (tail l) (add n (tabs_count (vt_tabs (head l)))))))

; What vt waits on: the app's port, where every window's notices and the
; shells' exits come, then every window's tabs' ports.
(def vts_ports ((vs Vts)) (list int)
  (match vs ((Vts a wins free set t) (cons (ui_app_port a) (tabs_ports_all (map_values wins) (nil int))))))

; Every tab's port of each of l's windows, onto the reversed acc.
(def tabs_ports_all ((l (list Vt)) (acc (list int))) (list int)
  (if (is_empty l)
      (rev acc)
      (tabs_ports_all (tail l) (rev_onto (tabs_ports (vt_tabs (head l))) acc))))

; vs, its set of ports made its windows' and tabs', if they are not the
; set it waits on already, as after a tab or a window opens or closes;
; saying why not if the kernel refuses it, which tabs_room keeps from
; happening.
(def vts_waiting ((vs Vts)) Vts
  (match vs
    ((Vts a wins free set t)
      (let want (vts_ports vs)
        (if (eq want set)
            vs
            (let kept (Vts a wins free want t)
              (match (port_set want)
                ((PortSetMade) kept)
                ((PortSetNotYours) (let s (said_why (port_setting_why (PortSetNotYours))) kept))
                ((PortSetSize) (let s (said_why (port_setting_why (PortSetSize))) kept)))))))))

; Serves the windows until the last closes, waiting on the set of ports.
(def serve ((vs Vts)) int
  (match (port_receive_set)
    ((SetRecvFailed) (complain "lost its ports"))
    ((SetMessage port m)
      (match m
        ((RecvFailed) (complain "lost its ports"))
        ((Message from b)
          (match (vts_received vs port m from b)
            ((VtsGo vs2) (serve (vts_waiting vs2)))
            ((VtsEnd status) status)))))))

; What a message m, bytes b from from, that came on port does: on the
; app's port, the app's (from_app); on a tab's, that tab's window's.
(def vts_received ((vs Vts) (port int) (m Message) (from int) (b bytes)) VtsStep
  (match vs
    ((Vts a wins free set t)
      (if (eq port (ui_app_port a))
          (from_app vs m from)
          (match (vts_holding vs port true)
            ((Some id) (vts_step vs id (AskTab port (msg_text b))))
            ((None) (VtsGo vs)))))))

; What came on the app's port, m from from: the compositor's notice of a
; window, that window's; a shell's exit, its window's, which closes its
; tab; an open, Terminal launched again, a window more; anything else,
; nothing.
(def from_app ((vs Vts) (m Message) (from int)) VtsStep
  (match vs
    ((Vts a wins free set t)
      (if (eq from (compositor_pid (ui_app_compositor a)))
          (match (win_notice_of m)
            ((WinNotice id at) (vts_step vs id (AskWm m at)))
            ((NoWinNotice) (from_other vs m)))
          (from_other vs m)))))

; from_app's message m that is no window's notice.
(def from_other ((vs Vts) (m Message)) VtsStep
  (match (exit_of m)
    ((Exited pid status)
      (match (vts_holding vs pid false)
        ((Some id) (vts_step vs id (AskExit pid status)))
        ((None) (VtsGo vs))))
    ((NotExit)
      (let ev (ui_message_event m)
        (if (ge (ui_open_reply ev) 0) (VtsGo (vts_open_asked vs ev)) (VtsGo vs))))))

; vs after an open, ev, Terminal launched again: a new window, in front,
; with one tab, answered with its id; or, if it cannot open, why said and
; answered 0, the front window brought forward.
(def vts_open_asked ((vs Vts) (ev UiEvent)) Vts
  (match (vts_opened vs)
    ((VtsOpened vs2 id) (let s (ui_open_answer ev id) vs2))
    ((VtsRefused vs2 why) (let w (said_why (append "cannot open a window: " why)) (let s (ui_open_answer ev 0) vs2)))))

; The id of the window with a tab on port n, or if not by_port whose
; shell is n, if one has.
(def vts_holding ((vs Vts) (n int) (by_port bool)) (Option int)
  (vt_holding (vts_wins vs) n by_port))

; vts_holding's search of l.
(def vt_holding ((l (list Vt)) (n int) (by_port bool)) (Option int)
  (if (is_empty l)
      ((None int))
      (let ts (vt_tabs (head l))
        (match (if by_port (tabs_by_port ts n) (tabs_by_shell ts n))
          ((Some t) (Some (ui_win_id (vt_win (head l)))))
          ((None) (vt_holding (tail l) n by_port))))))

; Window id's step asked q, lent the app's free ports and painted with its
; face; nothing if it has no such window.
(def vts_step ((vs Vts) (id int) (q Ask)) VtsStep
  (match vs
    ((Vts a wins free set t)
      (match (map_get wins id)
        ((None) (VtsGo vs))
        ((Some v) (vts_stepped vs id (vt_asked (vt_lent v a free (sub (vts_tab_count vs) (tabs_count (vt_tabs v)))) q)))))))

; v lent free and others' count, its window painted with a's face.
(def vt_lent ((v Vt) (a UiApp) (free (list int)) (others int)) Vt
  (match v
    ((Vt w ts st title sh l)
      (match (ui_app_win a (ui_win_id w))
        ((None) (Vt w ts st title sh (Lent free others)))
        ((Some aw) (Vt (ui_win_faced w (ui_win_face aw)) ts st title sh (Lent free others)))))))

; vs after window id's step s: the window kept, or, stopped, closed and
; forgotten; vt ending with the status of the last.
(def vts_stepped ((vs Vts) (id int) (s Step)) VtsStep
  (match s
    ((Go v) (VtsGo (vts_kept vs id v)))
    ((Stop v status)
      (match vs
        ((Vts a wins free set t)
          (let a2 (ui_app_close (ui_app_put_faced a (vt_win v)) id)
            (let wins2 (map_remove wins id)
              (if (eq (map_size wins2) 0)
                  (VtsEnd status)
                  (VtsGo (Vts a2 wins2 (lent_free (vt_lent_of v)) set t))))))))))

; vs with window id as v left it: its window, and the face it painted
; with, the app's; the ports it was lent, as it left them, the app's.
(def vts_kept ((vs Vts) (id int) (v Vt)) Vts
  (match vs
    ((Vts a wins free set t)
      (Vts (ui_app_put_faced a (vt_win v)) (map_put wins id v) (lent_free (vt_lent_of v)) set t))))

; What v was lent, as it has it now.
(def vt_lent_of ((v Vt)) Lent (match v ((Vt w ts st title sh l) l)))

; why said on standard error.
(def said_why ((why (list int))) int
  (let w (write_err (append "vt: " (append why "\n"))) (let f (file_flush (IoFile 2)) 0)))

; The window, its tabs, and the last status.
(def vt_win ((v Vt)) UiWin (match v ((Vt w ts st title sh free) w)))
(def vt_tabs ((v Vt)) Tabs (match v ((Vt w ts st title sh free) ts)))

; v with other tabs.
(def vt_tabbed ((v Vt) (ts Tabs)) Vt (match v ((Vt w old st title sh free) (Vt w ts st title sh free))))

; The notice of v's window, m, at byte at of its payload: a key, to the
; selected tab; the wheel, over the terminal, scrolling it; anything
; else routed by the toolkit.
(def from_wm_at ((v Vt) (m Message) (at int)) Step
  (match (key_event_at m at)
    ((Some k) (Go (keyed v k)))
    ((None)
      (match (wheel_event_at m at)
        ((Some e)
          (match e
            ((WheelEvent x y dx dy)
              (if (rect_has (vt_area v) x y) (Go (refreshed (wheeled v dy))) (Go v)))))
        ((None)
          (match (ui_route (vt_win v) (ui_event_of (vt_win v) m))
            ((UiRouted w2 action) (acted (vt_windowed v w2) action))))))))

; v with the window w.
(def vt_windowed ((v Vt) (w UiWin)) Vt (match v ((Vt old ts st title sh free) (Vt w ts st title sh free))))

; The terminal's area in the window as it is.
(def vt_area ((v Vt)) Rect
  (let w (vt_win v) (term_area (ui_win_w w) (ui_win_h w) (tabs_count (vt_tabs v)))))

; What an action set off does: the close button closes the window and
; every tab; the new-tab button opens a tab; a tab clicked is selected;
; a tab's close button ends its shell, which closes it.
(def acted ((v Vt) (action (list int))) Step
  (if (eq action (ui_close_action))
      (Stop (closed_all v) 0)
      (if (eq action "tab.new")
          (Go (refreshed (tab_opened v)))
          (let sel (ui_select_key "tabs" action)
            (if (not (is_empty sel))
                (Go (refreshed (vt_tabbed v (tabs_select (vt_tabs v) (int_prefix sel 0)))))
                (let k (ui_tab_close_key "tabs" action)
                  (if (not (is_empty k))
                      (Go (refreshed (tab_ended v (int_prefix k 0))))
                      (Go (refreshed v)))))))))

; v with a tab opened, and selected: a port for it, a closed tab's or a
; new one, its name registered there and its shell started; or v as it
; was, the port kept, if either cannot be, or the app's windows have
; tabs_most tabs already, saying why. The app then waits on the tab's
; port too (vts_waiting).
(def tab_opened ((v Vt)) Vt
  (match v
    ((Vt w ts st title sh l)
      (match l
        ((Lent free others)
          (if (not (tabs_room (tabs_count ts) others))
              (said v (append "cannot open a tab: Terminal's windows have at most " (append (digits (tabs_most)) " tabs")))
              (if (is_empty free)
                  (tab_on v (port_new))
                  (tab_on (Vt w ts st title sh (Lent (tail free) others)) (port_drained (head free))))))))))

; v with a tab on port, its name the first vtN free registered there.
(def tab_on ((v Vt) (port int)) Vt
  (match (vt_register port 1)
    ((VtUnnamed why) (said (vt_freed v port) why))
    ((VtNamed name) (tab_named v port name))))

; v with a tab on port, named name: its shell started, sh NAME, and the
; tab added and selected; or, if the shell cannot start, its name let
; go and its port kept, saying why.
(def tab_named ((v Vt) (port int) (name (list int))) Vt
  (match (shell_started name (ui_win_port (vt_win v)))
    ((ShellRunning pid) (vt_tabbed v (tabs_add (vt_tabs v) (tab_started (tab_new port 80 24) name pid))))
    ((NoShell why) (let u (name_let_go name) (said (vt_freed v port) why)))))

; v with port kept for a later tab, if it is a port.
(def vt_freed ((v Vt) (port int)) Vt
  (match v
    ((Vt w ts st title sh l)
      (if (gt port 0) (Vt w ts st title sh (Lent (cons port (lent_free l)) (lent_others l))) v))))

; v, why said on standard error.
(def said ((v Vt) (why (list int))) Vt
  (let s (said_why why) v))

; The tab on port ended: its shell killed, and the tab closed once its
; exit is told.
(def tab_ended ((v Vt) (port int)) Vt
  (match (tabs_by_port (vt_tabs v) port)
    ((None) v)
    ((Some t) (let k (killed (cons (tab_shell t) (nil int))) v))))

; v with every tab's shell ended and the tab gone, its name let go and
; its port kept for the app's next tabs: the window closing, which the
; app does (vts_stepped). The shells' exits, told later, find no tab.
(def closed_all ((v Vt)) Vt
  (let k (killed (tabs_pids (vt_tabs v)))
    (match (tabs_by_port (vt_tabs v) (tabs_first_port (vt_tabs v)))
      ((None) v)
      ((Some t)
        (let u (name_let_go (tab_name t))
          (closed_all (vt_freed (vt_tabbed v (tabs_drop (vt_tabs v) (tab_port t))) (tab_port t))))))))

; Each of pids killed.
(def killed ((pids (list int))) int
  (if (is_empty pids) 0 (let k (proc_kill (head pids)) (killed (tail pids)))))

; A process watched, pid, exited with status: if it is a tab's shell, the
; tab closes. With no tab left the window closes and vt ends with the
; last shell's status.
(def exited ((v Vt) (pid int) (status int)) Step
  (match (tabs_by_shell (vt_tabs v) pid)
    ((Some t) (tab_closed v t status))
    ((None) (Go v))))

; The tab t closed, its shell having exited with status: its name let
; go, its port kept for the next tab and no longer waited on; the window
; closing with the last, which the app does (vts_stepped).
(def tab_closed ((v Vt) (t Tab) (status int)) Step
  (let u (name_let_go (tab_name t))
    (match v
      ((Vt w ts st title sh l)
        (let v2 (vt_freed (Vt w (tabs_drop ts (tab_port t)) status title sh l) (tab_port t))
          (if (eq (tabs_count (vt_tabs v2)) 0)
              (Stop v2 status)
              (Go (refreshed v2))))))))

; What came on the tab t's port, payload: its requests as a terminal
; takes them.
(def from_tab ((v Vt) (t Tab) (payload (list int))) Vt
  (match t
    ((Tab r sh name term cl back con)
      (match (tty_request con payload)
        ((TtyAsk con2) (vt_tabbed v (tabs_put (vt_tabs v) (Tab r sh name term cl back (deliver con2)))))
        ((TtyWrite bs) (output v t bs))
        ((TtyAnswer to body) (let s (port_send to body) v))))))

; What starting the shell came to: its pid, watched; or why not.
(data Shell (ShellRunning int) (NoShell (list int)))

; sh NAME started, and watched on port.
(def shell_started ((name (list int)) (port int)) Shell
  (match (spawn_path "/bin/sh" (Some (cons name (nil (list int)))))
    ((Spawned pid) (shell_watched pid (proc_watch pid port)))
    ((SpawnNoEntry) (NoShell "no /bin/sh to run"))
    ((SpawnNotProgram) (NoShell (cannot_shell (SpawnNotProgram))))
    ((SpawnTooBig) (NoShell (cannot_shell (SpawnTooBig))))
    ((SpawnNoRoom) (NoShell (cannot_shell (SpawnNoRoom))))))

; The shell, pid, as watching it went: a shell that is not watched would
; never be known to have exited.
(def shell_watched ((pid int) (w Watch)) Shell
  (match w
    ((Watched) (ShellRunning pid))
    ((WatchNoProc) (NoShell "cannot watch /bin/sh: it is gone"))
    ((WatchFull) (NoShell "cannot watch /bin/sh: too many ports watch it"))))

; Why the shell did not start, as spawning it answered s.
(def cannot_shell ((s Spawn)) (list int)
  (append "cannot start /bin/sh: " (spawn_why s)))

; A key's character fed to the selected tab's line editing, its echo
; shown, and any line finished delivered; its view first brought back to
; the bottom, if it is not there. Esc is not fed: the editing would take
; it for the start of an escape sequence, and drop the key after it.
(def keyed ((v Vt) (k KeyEvent)) Vt
  (match k
    ((KeyEvent code value ch)
      (if (if (eq value 0) true (if (eq ch 0) true (eq ch 27)))
          v
          (match (tabs_selected (vt_tabs v))
            ((None) v)
            ((Some t)
              (let v2 (if (eq (tab_back t) 0) v (refreshed (vt_tabbed v (tabs_put (vt_tabs v) (tab_backed t 0)))))
                (match (tabs_selected (vt_tabs v2))
                  ((None) v2)
                  ((Some t2)
                    (match t2
                      ((Tab r sh name term cl back con)
                        (match (feed con ch)
                          ((Fed con2 e) (output v2 (Tab r sh name term cl back (deliver con2)) e))))))))))))))

; v with the selected tab's view dy steps of the wheel further down, up
; below 0.
(def wheeled ((v Vt) (dy int)) Vt
  (match (tabs_selected (vt_tabs v))
    ((None) v)
    ((Some t) (vt_tabbed v (tabs_put (vt_tabs v) (tab_backed t (wheeled_back (tab_back t) dy (cells_back (tab_cells t)))))))))

; v with bs written at the tab t: kept in its cells, the cursor moved,
; and, if the tab is shown with its view at the bottom, drawn and the
; window told. Otherwise nothing is drawn, and a view that is back stays
; on the rows it shows.
(def output ((v Vt) (t Tab) (bs (list int))) Vt
  (match t
    ((Tab r sh name term cl back con)
      (match (render term bs)
        ((Rendered term2 ops)
          (let cl2 (cells_after cl ops)
            (let k (scrolls ops)
              (let t2 (Tab r sh name term2 cl2 (kept_back back k (cells_back cl2)) con)
                (let v2 (vt_tabbed v (tabs_put (vt_tabs v) t2))
                  (if (if (eq back 0) (tabs_is_selected (vt_tabs v) t) false)
                      (output_shown v2 term t2 k)
                      v2))))))))))

; The tab t, shown, with output drawn that moved its cursor from before
; and scrolled k rows, and the window told.
(def output_shown ((v Vt) (before Term) (t Tab) (k int)) Vt
  (let w (vt_win v)
    (let a (vt_area v)
      (let c (output_drawn (ui_win_canvas w) (ui_win_face w) a before t k)
        (let d (ui_win_damaged w (cons (output_damage a before t k) (nil Rect))) v)))))

; v with its window up to date with its tabs: every tab as many cells as
; fit the terminal's area; the selected tab's view drawn whole, if it is
; not what was last drawn whole there; the title told, if it changed; and
; the window's header bar and tab bar painted where they changed. If the
; window is not the size or buffer it was after that, as when wm would
; not have a resize, all of it again.
(def refreshed ((v Vt)) Vt
  (match v
    ((Vt w ts st title shown free)
      (let a (term_area (ui_win_w w) (ui_win_h w) (tabs_count ts))
        (let ts2 (tabs_resized ts (area_cols a) (area_rows a))
          (let title2 (tabs_title ts2)
            (let t (if (eq title2 title) 0 (ui_win_titled w title2))
              (let shown2 (view_shown w ts2 a shown)
                (let w2 (ui_present w (vt_view ts2 title2))
                  (let d (if (eq shown2 shown) 0 (ui_win_damaged w2 (cons a (nil Rect))))
                    (let v2 (Vt w2 ts2 st title2 shown2 free)
                      (if (if (eq (ui_win_canvas w2) (ui_win_canvas w)) (if (eq (ui_win_w w2) (ui_win_w w)) (eq (ui_win_h w2) (ui_win_h w)) false) false)
                          v2
                          (refreshed v2)))))))))))))

; What is shown whole in the area a after the selected tab's view is
; drawn whole there, if what was, shown, is not it; as it was if it is.
(def view_shown ((w UiWin) (ts Tabs) (a Rect) (shown Shown)) Shown
  (match (tabs_selected ts)
    ((None) shown)
    ((Some t)
      (let want (Shown a (ui_win_canvas w) (tab_port t) (tab_back t))
        (if (eq want shown)
            shown
            (let c (view_drawn (ui_win_canvas w) (ui_win_face w) a t) want))))))

; What the window shows: the header bar, its title and the button that
; opens a tab; the tab bar, with two tabs or more; and the terminal.
(def vt_view ((ts Tabs) (title (list int))) UiWidget
  (let header (UiCsdBar (cons (UiButton "tab.new" "tab-new" "" (UiBtnFlat) true) (nil UiWidget))
                        (UiLabel title (UiHeading) (UiCenter)) (nil UiWidget) true)
    (let term (UiExpand (UiDrawingArea "term" 0 0))
      (UiBox (UiV) 0
        (cons header
              (if (ge (tabs_count ts) 2)
                  (cons (UiTabBar "tabs" (tabs_shown ts) (tabs_selected_key ts)) (cons term (nil UiWidget)))
                  (cons term (nil UiWidget))))))))
