; The tabs as text: each one's port, its name after a colon if it has
; one, a * after the selected one.
(def tabs_text ((ts Tabs)) (list int)
  (match ts ((Tabs l sel) (tabs_text_of l sel))))

(def tabs_text_of ((l (list Tab)) (sel int)) (list int)
  (if (is_empty l)
      ""
      (let t (head l)
        (append (digits (tab_port t))
          (append (if (is_empty (tab_name t)) "" (append ":" (tab_name t)))
            (append (if (eq (tab_port t) sel) "*" "")
              (if (is_empty (tail l)) "" (append " " (tabs_text_of (tail l) sel)))))))))

; Three tabs, on ports 5, 6 and 7, the last opened selected.
(def three () Tabs
  (tabs_add (tabs_add (tabs_add (tabs_none) (tab_new 5 80 24)) (tab_new 6 80 24)) (tab_new 7 80 24)))

(def test_added_selected () int
  (add (check_str "the last opened selected" (tabs_text (three)) "5 6 7*")
       (check_int "three" (tabs_count (three)) 3)))

(def test_select () int
  (add (check_str "6" (tabs_text (tabs_select (three) 6)) "5 6* 7")
       (check_str "none such" (tabs_text (tabs_select (three) 9)) "5 6 7*")))

; A tab named, its shell 20: found by its shell or its port.
(def test_named () int
  (let ts (tabs_put (three) (tab_started (tab_new 6 80 24) "vt2" 20))
    (add (check_str "named" (tabs_text ts) "5 6:vt2 7*")
         (add (check_int "by its shell" (match (tabs_by_shell ts 20) ((Some t) (tab_port t)) ((None) 0)) 6)
              (check_str "by its port" (match (tabs_by_port ts 6) ((Some t) (tab_name t)) ((None) "none")) "vt2")))))

; No shell 0, and no tab on a port no tab has.
(def test_not_found () int
  (add (check_int "no shell 0" (match (tabs_by_shell (three) 0) ((Some t) (tab_port t)) ((None) 0)) 0)
       (check_int "no port 9" (match (tabs_by_port (three) 9) ((Some t) (tab_port t)) ((None) 0)) 0)))

; The ports vt waits on for its tabs, in order, one gone as its tab
; closes.
; The first tab's port, which a window's close lets go first; 0 for none.
(def test_first_port () int
  (add (check_int "5" (tabs_first_port (three)) 5)
       (check_int "none" (tabs_first_port (tabs_none)) 0)))

(def test_ports () int
  (add (check_str "5 6 7" (unwords (pids_text (tabs_ports (three)))) "5 6 7")
       (check_str "6 dropped" (unwords (pids_text (tabs_ports (tabs_drop (three) 6)))) "5 7")))

; Closing the selected tab selects the one after it, or before it if it
; was the last; closing another keeps the selection.
(def test_drop () int
  (add (check_str "the last, selected" (tabs_text (tabs_drop (three) 7)) "5 6*")
       (add (check_str "the middle, selected" (tabs_text (tabs_drop (tabs_select (three) 6) 6)) "5 7*")
            (check_str "another" (tabs_text (tabs_drop (three) 5)) "6 7*"))))

(def test_drop_the_last () int
  (let ts (tabs_drop (tabs_add (tabs_none) (tab_new 5 80 24)) 5)
    (add (check_int "none left" (tabs_count ts) 0)
         (check_str "no title but Terminal" (tabs_title ts) "Terminal"))))

; The title is the selected tab's name, Terminal until it has one.
(def test_title () int
  (add (check_str "unnamed" (tabs_title (three)) "Terminal")
       (check_str "named" (tabs_title (tabs_put (three) (tab_started (tab_new 7 80 24) "vt3" 21))) "vt3")))

; The tab bar's tabs, keyed by port.
(def test_shown () int
  (let ts (tabs_put (three) (tab_started (tab_new 5 80 24) "vt1" 20))
    (add (check_str "titles" (ui_tabs_text (tabs_shown ts)) "5=vt1 6=Terminal 7=Terminal")
         (check_str "selected" (tabs_selected_key ts) "7"))))

(def ui_tabs_text ((ts (list UiTab))) (list int)
  (if (is_empty ts)
      ""
      (match (head ts)
        ((UiTab k t) (append k (append "=" (append t (if (is_empty (tail ts)) "" (append " " (ui_tabs_text (tail ts)))))))))))

; The processes to end with the window: the shells, none not started.
(def test_pids () int
  (let ts (tabs_put (three) (tab_started (tab_new 6 80 24) "vt2" 20))
    (check_str "20 alone" (unwords (pids_text (tabs_pids ts))) "20")))

(def pids_text ((ps (list int))) (list (list int))
  (if (is_empty ps) (nil (list int)) (cons (digits (head ps)) (pids_text (tail ps)))))

; Every tab wrapped again at another size; one that size already stays.
(def test_resized () int
  (let ts (tabs_resized (three) 40 10)
    (match (tabs_selected ts)
      ((None) (fail_because "selected" "none"))
      ((Some t) (add (check_int "columns" (cells_cols (tab_cells t)) 40)
                     (check_int "rows" (cells_rows (tab_cells t)) 10))))))

; A view back further than a smaller ring has rows is brought in.
(def test_resized_back () int
  (let t (tab_backed (tab_new 5 80 24) 3)
    (check_int "nothing scrolled off" (tab_back (tab_resized t 40 10)) 0)))
