; Every row the cells have, the ring's first, as text: each row's
; characters, then + if a wrap ended it, a | between rows.
(def lines_text ((c Cells)) (list int)
  (lines_text_from c 0 (add (cells_back c) (cells_rows c)) (nil int)))

(def lines_text_from ((c Cells) (i int) (n int) (acc (list int))) (list int)
  (if (ge i n)
      (rev acc)
      (let l (cells_line c i)
        (lines_text_from c (add i 1) n
          (push (if (line_wrapped l) "+" "") (push (bytes_to_list (line_chars l)) (if (eq i 0) acc (push "|" acc))))))))

; The cells after bytes are written from the top left corner.
(def written ((cols int) (rows int) (bs (list int))) Cells
  (match (render (Term 0 0 cols rows) bs)
    ((Rendered t ops) (cells_after (cells_new cols rows) ops))))

(def test_blank () int
  (add (check_str "rows" (lines_text (cells_new 4 3)) "||")
       (check_int "nothing scrolled off" (cells_back (cells_new 4 3)) 0)))

(def test_put () int
  (check_str "from column 1" (lines_text (cells_put (cells_new 4 2) 1 1 "ab")) "| ab"))

(def test_put_past_the_end () int
  (add (check_str "cut at the last column" (lines_text (cells_put (cells_new 4 1) 2 0 "abc")) "  ab")
       (check_str "none past it" (lines_text (cells_put (cells_new 4 1) 4 0 "abc")) "")))

(def test_end () int
  (add (check_str "wrapped" (lines_text (cells_end (cells_put (cells_new 2 2) 0 0 "ab") 0 true)) "ab+|")
       (check_str "unwrapped again" (lines_text (cells_end (cells_end (cells_new 2 2) 0 true) 0 false)) "|")))

; A wrapped row keeps every cell, its spaces too: they are text the line
; goes on after.
(def test_wrapped_keeps_spaces () int
  (check_str "a b, then c" (lines_text (written 4 3 "a b  c")) "a b +| c|"))

(def test_scroll () int
  (let c (cells_scroll (cells_put (cells_put (cells_new 3 2) 0 0 "top") 0 1 "low"))
    (add (check_str "the top row in the ring" (lines_text c) "top|low|")
         (check_int "one scrolled off" (cells_back c) 1))))

(def test_scroll_keeps_the_mark () int
  (check_str "wrapped" (lines_text (written 3 2 "abcdefgh")) "abc+|def+|gh"))

(def test_written () int
  (check_str "lines and a scroll" (lines_text (written 10 2 "one\ntwo\nthree")) "one|two|three"))

(def test_backspace_blanks () int
  (check_str "rubbed out" (lines_text (written 10 1 "ab\x08 \x08")) "a"))

; ring_max rows and one more: the oldest, row 0, is dropped.
(def test_ring_bounded () int
  (let c (scrolled_n (cells_new 6 1) 0 (add (ring_max) 1))
    (add (check_int "at most ring_max" (cells_back c) (ring_max))
         (check_str "the oldest kept is row 1" (bytes_to_list (line_chars (cells_line c 0))) "1"))))

; c with row i, then n - i more, each its number, scrolled off.
(def scrolled_n ((c Cells) (i int) (n int)) Cells
  (if (ge i n) c (scrolled_n (cells_scroll (cells_put c 0 0 (digits i))) (add i 1) n)))

; Whatever is written, its lines are there to read again: the rows joined
; where a wrap ended them are the lines written, as many as the ring keeps.
(def test_lines_kept () int
  (lines_kept_from 7 0 0))

(def lines_kept_from ((seed int) (i int) (bad int)) int
  (if (ge i 200)
      (check_int "mismatches" bad 0)
      (let s1 (rand_next seed)
        (let cols (add 1 (rand_below s1 12))
          (let s2 (rand_next s1)
            (let text (random_text s2 (rand_below s2 60) (nil int))
              (let got (joined (written cols 3 text))
                (lines_kept_from (rand_next s2) (add i 1)
                  (if (eq got (trimmed_lines text)) bad (add bad 1))))))))))

; n random characters, a third of them newlines, the rest a, b and spaces.
(def random_text ((s int) (n int) (acc (list int))) (list int)
  (if (eq n 0)
      acc
      (let k (rand_below s 6)
        (random_text (rand_next s) (sub n 1) (cons (if (lt k 2) 10 (if (lt k 4) 97 (if (eq k 4) 98 32))) acc)))))

; The lines of every row the cells have, joined at wraps, as
; trimmed_lines has them: a wrapped row's spaces at the end of a line,
; such as one ended in spaces and then a newline, are not text.
(def joined ((c Cells)) (list int)
  (trimmed_lines (joined_from c 0 (add (cells_back c) (cells_rows c)) (nil int))))

(def joined_from ((c Cells) (i int) (n int) (acc (list int))) (list int)
  (if (ge i n)
      (rev acc)
      (let l (cells_line c i)
        (joined_from c (add i 1) n
          (let a (push (bytes_to_list (line_chars l)) acc) (if (line_wrapped l) a (cons 10 a)))))))

; text's lines, each without its trailing spaces and ended by a newline,
; the trailing empty ones left out: what the cells should hold.
(def trimmed_lines ((text (list int))) (list int)
  (drop_blank_tail (trimmed_from (split_lines text) (nil int))))

(def trimmed_from ((ls (list (list int))) (acc (list int))) (list int)
  (if (is_empty ls) (rev acc) (trimmed_from (tail ls) (cons 10 (push (trim_end (head ls)) acc)))))

; s without its spaces at the end.
(def trim_end ((s (list int))) (list int) (rev (drop_spaces (rev s))))
(def drop_spaces ((s (list int))) (list int)
  (if (is_empty s) s (if (eq (head s) 32) (drop_spaces (tail s)) s)))

; s split at each newline, the piece after the last one too.
(def split_lines ((s (list int))) (list (list int)) (rev (split_lines_onto s (nil int) (nil (list int)))))
(def split_lines_onto ((s (list int)) (cur (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (cons (rev cur) acc)
      (if (eq (head s) 10)
          (split_lines_onto (tail s) (nil int) (cons (rev cur) acc))
          (split_lines_onto (tail s) (cons (head s) cur) acc))))

; s without the newlines at its end.
(def drop_blank_tail ((s (list int))) (list int) (rev (drop_newlines (rev s))))
(def drop_newlines ((s (list int))) (list int)
  (if (is_empty s) s (if (eq (head s) 10) (drop_newlines (tail s)) s)))

; ------------------------------------------------------- wrapping again

; The cells and cursor bytes leave, written from the top left corner.
(def written_at ((cols int) (rows int) (bs (list int))) Rewrapped
  (match (render (Term 0 0 cols rows) bs)
    ((Rendered t ops) (match t ((Term col row tc tr) (Rewrapped (cells_after (cells_new cols rows) ops) col row))))))

; What cells and a cursor show, as text: lines_text, then the cursor.
(def rewrapped_text ((r Rewrapped)) (list int)
  (match r ((Rewrapped c col row) (append (lines_text c) (append " @" (append (digits col) (append "," (digits row))))))))

; r wrapped again at cols by rows.
(def again ((r Rewrapped) (cols int) (rows int)) Rewrapped
  (match r ((Rewrapped c col row) (cells_rewrapped c col row cols rows))))

(def test_rewrap_same () int
  (check_str "as it was" (rewrapped_text (again (written_at 6 3 "ab\ncd") 6 3)) "ab|cd| @2,1"))

; abcdef fills 6 columns, a wrap pending; at 3 it is two rows, the
; cursor still pending at the end of the second.
(def test_rewrap_narrower () int
  (check_str "cut again" (rewrapped_text (again (written_at 6 3 "abcdef") 3 3)) "abc+|def| @3,1"))

(def test_rewrap_wider () int
  (check_str "joined again" (rewrapped_text (again (written_at 3 3 "abcde") 6 3)) "abcde|| @5,0"))

; Fewer rows: the screen's top moves down to keep the cursor's row on
; it, the rows above going to the ring.
(def test_rewrap_shorter () int
  (let r (again (written_at 4 4 "a\nb\nc") 4 2)
    (add (check_str "c in view" (rewrapped_text r) "a|b|c @1,1")
         (check_int "a scrolled off" (match r ((Rewrapped c col row) (cells_back c))) 1))))

; More rows: the screen takes rows back from the ring.
(def test_rewrap_taller () int
  (let r (again (written_at 4 2 "a\nb\nc") 4 4)
    (add (check_str "all of it on the screen" (rewrapped_text r) "a|b|c| @1,2")
         (check_int "nothing scrolled off" (match r ((Rewrapped c col row) (cells_back c))) 0))))

; The cursor in a line's second row keeps its place in the line: abcd
; wraps, e is on the next row, the carriage return goes back to its
; start and xy writes over e, so the line is abcdxy, the cursor 6 into
; it; at 2 columns it is three rows, the cursor pending at the end of the
; third.
(def test_rewrap_cursor_in_line () int
  (check_str "at 6 of the line" (rewrapped_text (again (written_at 4 3 "abcde\rxy") 2 4)) "ab+|cd+|xy| @2,2"))

; Two Backspaces rub out d and e, the cursor 3 into abc: at 2 columns,
; column 1 of the second row.
(def test_rewrap_cursor_mid_row () int
  (check_str "at 3 of abc" (rewrapped_text (again (written_at 6 3 "abcde\x08\x08") 2 4)) "ab+|c|| @1,1"))

; Written at one width and wrapped again at another, the cells and the
; cursor are what writing at the other would have left: over 300 random
; texts with no spaces at the ends of lines, which only a wrap keeps.
(def test_rewrap_as_written () int
  (rewrap_from 11 0 0))

(def rewrap_from ((seed int) (i int) (bad int)) int
  (if (ge i 300)
      (check_int "mismatches" bad 0)
      (let s1 (rand_next seed)
        (let a (add 1 (rand_below s1 9))
          (let s2 (rand_next s1)
            (let b (add 1 (rand_below s2 9))
              (let s3 (rand_next s2)
                (let text (no_end_spaces (random_text s3 (rand_below s3 50) (nil int)))
                  (rewrap_from (rand_next s3) (add i 1)
                    (if (eq (rewrapped_text (again (written_at a 3 text) b 3)) (rewrapped_text (written_at b 3 text)))
                        bad
                        (add bad 1)))))))))))

; s with each space before a newline or its end made a b.
(def no_end_spaces ((s (list int))) (list int)
  (if (is_empty s)
      s
      (let rest (no_end_spaces (tail s))
        (if (if (eq (head s) 32) (if (is_empty rest) true (eq (head rest) 10)) false)
            (cons 98 rest)
            (cons (head s) rest)))))
