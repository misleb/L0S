(def term_text ((t Term)) (list int)
  (match t ((Term col row cols rows) (append (digits col) (append "," (digits row))))))

(def op_text ((op Op)) (list int)
  (match op
    ((OpText col row cs) (append "text " (append (digits col) (append "," (append (digits row) (append " " cs))))))
    ((OpBlank col row) (append "blank " (append (digits col) (append "," (digits row)))))
    ((OpScroll) "scroll")
    ((OpEnd row wrap) (append (if wrap "wrap " "end ") (digits row)))))

(def ops_text ((ops (list Op))) (list int)
  (if (is_empty ops) ""
      (is_empty (tail ops)) (op_text (head ops))
      (append (op_text (head ops)) (append " ; " (ops_text (tail ops))))))

(def rendered_text ((r Rendered)) (list int)
  (match r ((Rendered t ops) (append (term_text t) (append ": " (ops_text ops))))))

(def screen () Term (Term 0 0 80 24))

(def test_plain_run () int
  (check_str "one run" (rendered_text (render (screen) "hi")) "2,0: text 0,0 hi"))

(def test_newline () int
  (check_str "two rows" (rendered_text (render (screen) "a\nb")) "1,1: text 0,0 a ; end 0 ; text 0,1 b"))

(def test_scroll_at_the_bottom () int
  (check_str "a line up" (rendered_text (render (Term 3 23 80 24) "x\ny")) "1,23: text 3,23 x ; end 23 ; scroll ; text 0,23 y"))

(def test_wrap () int
  (check_str "past the last column" (rendered_text (render (Term 79 0 80 24) "ab")) "1,1: text 79,0 a ; wrap 0 ; text 0,1 b"))

(def test_backspace () int
  (check_str "back and blanked" (rendered_text (render (Term 5 2 80 24) "\x08 \x08"))
    "4,2: blank 4,2 ; text 4,2   ; blank 4,2"))

(def test_backspace_at_start () int
  (check_str "nowhere" (rendered_text (render (Term 0 2 80 24) "\x08")) "0,2: "))

(def test_tab () int
  (check_str "to column 8" (term_text (match (render (Term 3 0 80 24) "\t") ((Rendered t ops) t))) "8,0"))

(def test_carriage_return () int
  (check_str "column 0" (rendered_text (render (Term 7 1 80 24) "\rz")) "1,1: text 0,1 z"))

(def test_control_bytes_skipped () int
  (check_str "bell" (rendered_text (render (screen) "a\x07b")) "2,0: text 0,0 a ; text 1,0 b"))

; The cursor's cell is the last column while a wrap is pending.
(def test_cursor_at_a_pending_wrap () int
  (check_int "in the last column"
    (match (render (Term 79 0 80 24) "z") ((Rendered t ops) (term_col t)))
    79))

(def test_names () int
  (add (check_str "the first" (vt_name 1) "vt1")
       (check_str "the twelfth" (vt_name 12) "vt12")))

(def vt_name_text ((n VtName)) (list int)
  (match n ((VtNamed name) name) ((VtUnnamed why) why)))

; Under an operating system there is no kernel to register with, so no
; name is tried after the first.
(def test_no_name () int
  (check_str "refused" (vt_name_text (vt_register 1 1)) "cannot register: the port is not this process's"))

(def cells_text ((t Term)) (list int)
  (match t ((Term c r cols rows) (append (digits cols) (append "x" (digits rows))))))

(def test_cells () int
  (add (check_str "80 by 24" (cells_text (vt_cells (nil (list int)))) "80x24")
       (add (check_str "given" (cells_text (vt_cells (split_spaces "100 30"))) "100x30")
            (check_str "one alone is not enough" (cells_text (vt_cells (split_spaces "100"))) "80x24"))))

(def test_cannot_shell () int
  (add (check_str "no room" (cannot_shell (SpawnNoRoom)) "cannot start /bin/sh: no room for another process")
       (check_str "not a program" (cannot_shell (SpawnNotProgram)) "cannot start /bin/sh: not a program")))

(def shell_text ((s Shell)) (list int)
  (match s ((ShellRunning pid) (digits pid)) ((NoShell why) why)))

(def test_shell_watched () int
  (add (check_str "watched" (shell_text (shell_watched 7 (Watched))) "7")
       (check_str "gone" (shell_text (shell_watched 7 (WatchNoProc))) "cannot watch /bin/sh: it is gone")))

; Under an operating system there is no /bin/sh among the entries.
(def test_no_shell () int
  (check_str "none" (shell_text (shell_started "vt" 1)) "no /bin/sh to run"))

; Under an operating system there is no kernel to register with, so no
; terminal.
(def test_no_kernel () int
  (check_int "fails" (vt) 1))

(def test_scrolls () int
  (add (check_int "none" (scrolls (match (render (screen) "a\nb") ((Rendered t ops) ops))) 0)
       (check_int "two" (scrolls (match (render (Term 0 23 80 24) "a\nb\nc") ((Rendered t ops) ops))) 2)))

; The scroller's first row shown, of the ring's 100 and the screen's:
; 100 is the bottom, 97 three rows back; none past the ring's oldest or
; the bottom.
(def test_scrolled_back () int
  (add (check_int "the bottom" (scrolled_back 100 100) 0)
       (add (check_int "three back" (scrolled_back 97 100) 3)
            (add (check_int "the oldest" (scrolled_back 0 100) 100)
                 (check_int "past the bottom" (scrolled_back 120 100) 0)))))

; Shift-Page Up, a page of 24 rows back; Shift-Page Down forward, no
; further than the ring nor past the bottom.
(def test_paged_back () int
  (add (check_int "a page up" (paged_back 0 -1 24 100) 24)
       (add (check_int "the ring's end" (paged_back 90 -1 24 100) 100)
            (check_int "down to the bottom" (paged_back 10 1 24 100) 0))))

; Ctrl-Shift-T (T is 20; Ctrl 2 and Shift 1) opens a tab; Ctrl-T alone,
; and its release, are typed, or nothing.
(def test_shortcut_new_tab () int
  (add (check_str "ctrl-shift-t" (shortcut_of (KeyEvent 20 1 20 3)) "tab.new")
       (add (check_str "ctrl-t" (shortcut_of (KeyEvent 20 1 20 2)) "")
            (check_str "released" (shortcut_of (KeyEvent 20 0 0 3)) ""))))

; Shift-Page Up and Down (104, 109) page the view; Page Up alone, or
; with Ctrl too, does not.
(def test_shortcut_pages () int
  (add (check_str "up" (shortcut_of (KeyEvent 104 1 0 1)) "view.page_up")
       (add (check_str "down, repeated" (shortcut_of (KeyEvent 109 2 0 1)) "view.page_down")
            (add (check_str "alone" (shortcut_of (KeyEvent 104 1 0 0)) "")
                 (check_str "ctrl-shift" (shortcut_of (KeyEvent 104 1 0 3)) "")))))

; Output while the view is back moves it back as far as the screen
; scrolled, so it shows the same rows; at the bottom it stays there.
(def test_kept_back () int
  (add (check_int "kept on its rows" (kept_back 5 2 100) 7)
       (add (check_int "at the bottom" (kept_back 0 2 100) 0)
            (check_int "as far as the ring goes" (kept_back 99 5 100) 100))))

; The terminal is all of the window under the header bar, 46, and the
; tab bar's 40 too once there are two tabs: where the toolkit lays out
; the drawing area of vt_view.
(def test_term_area () int
  (add (check_str "one tab" (rect_text (term_area 640 430 1)) "0,46 640x384")
       (check_str "two tabs" (rect_text (term_area 640 430 2)) "0,86 640x344")))

(def test_term_area_as_laid_out () int
  (add (check_str "one tab" (laid_area (one_tab) 640 430) (rect_text (term_area 640 430 1)))
       (check_str "two tabs" (laid_area (two_tabs) 640 430) (rect_text (term_area 640 430 2)))))

(def rect_text ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

; Where the toolkit lays out the terminal in vt_view of ts in w by h.
(def laid_area ((ts Tabs) (w int) (h int)) (list int)
  (match (ui_drawing_rect (ui_layout_window (vt_view ts "t") w h (ui_state_new (UiDark))) "term")
    ((Some r) (rect_text r))
    ((None) "none")))

(def one_tab () Tabs (tabs_add (tabs_none) (tab_new 7 80 24)))
(def two_tabs () Tabs (tabs_add (one_tab) (tab_new 9 80 24)))

; 640 by 385 is 80 by 24, the outline's pixel under the last row; 645
; by 399 too, the rest not a whole cell; 640 by 384, 23.
(def test_area_cells () int
  (add (check_int "columns" (area_cols (Rect 0 46 645 399)) 80)
       (add (add (check_int "rows" (area_rows (Rect 0 46 645 399)) 24) (check_int "not over the outline" (area_rows (Rect 0 46 640 384)) 23))
            (check_int "at least one" (area_rows (Rect 0 46 645 0)) 1))))

; Terminal's windows have at most 29 tabs between them: a set holds 32
; ports, the app's and the toolkit's two reply ports among them.
(def test_tabs_most () int
  (check_int "29" (tabs_most) 29))

; A tab more fits while this window's and the others' are under 29.
(def test_tabs_room () int
  (add (check_bool "one window, 28" (tabs_room 28 0) true)
       (add (check_bool "one window, 29" (tabs_room 29 0) false)
            (check_bool "20 here, 9 in others" (tabs_room 20 9) false))))

; The tabs' ports are the app's own: every window's, in order, and none
; with no window.
(def test_vts_ports () int
  (check_int "none yet" (length (vts_ports (Vts (no_windows) ((MapEmpty int Vt)) (nil int) (screen)))) 0))

; An app of no windows, on port 4.
(def no_windows () UiApp (UiApp (Compositor 1 2 9 1) 4 (ui_face_none) ((MapEmpty int UiWin)) false (ui_loop_new)))

; The terminal is its scroller: a tab 3 rows back of 30 scrolled off,
; on a screen of 24, shows row 27 of 54 first, 24 at once, the most first
; 30; its rows a cell high, but said as 0, so a present moves none of
; vt's pixels.
(def test_term_scroller () int
  (let ns (ui_layout_window (vt_view (back_tab 30 3) "t") 640 430 (ui_state_new (UiDark)))
    (add (check_bool "the scroller" (has_action ns "term.scroll.27.30.24.0") true)
         (check_bool "the drawing area" (has_action ns "term.drawing") true))))

; Whether a node of ns sets off a.
(def has_action ((ns (list UiNode)) (a (list int))) bool
  (if (is_empty ns) false (eq (.action (head ns)) a) true (has_action (tail ns) a)))

; One tab whose cells have had n rows scrolled off, its view back rows
; back.
(def back_tab ((n int) (back int)) Tabs
  (tabs_add (tabs_none) (.back (.cells (tab_new 7 80 24) (scrolled_cells (cells_new 80 24) n)) back)))

; c with n rows scrolled off.
(def scrolled_cells ((c Cells) (n int)) Cells
  (if (le n 0) c (scrolled_cells (cells_scroll c) (sub n 1))))

; The scrollbar hides at rest at the bottom, shows while back, and is
; wide under the pointer.
(def test_bar_shown () int
  (let (st (ui_state_new (UiDark))
        t (tab_new 7 80 24))
    (add (check_int "at rest" (bar_shown t st) 0)
         (add (check_int "back" (bar_shown (.back t 3) st) 1)
              (check_int "under the pointer" (bar_shown t (.hover st "term.scrollbar.27.30.300.80")) 2)))))

; A window of 80 by 24 cells is 640 wide and 46 + 384 + 1 high, the
; outline's pixel along its foot under the last row.
(def test_term_win () int
  (add (check_int "wide" (term_win_w (screen)) 640)
       (check_int "high" (term_win_h (screen)) 431)))

; Output that scrolled none changes the rows from the cursor's before to
; its after; one that scrolled, every row of the area's cells; a whole
; screen of it, all of the area.
(def test_due_damage () int
  (let t (tab_new 7 80 24)
    (add (check_str "rows 0 to 2" (rect_text (due_damage (Rect 0 46 640 384) t (due_after (due_none) 0 2 0))) "0,46 640x48")
         (add (check_str "scrolled" (rect_text (due_damage (Rect 0 46 645 390) t (due_after (due_none) 23 23 1))) "0,46 645x384")
              (check_str "a screen" (rect_text (due_damage (Rect 0 46 645 390) t (Due 30 0 23))) "0,46 645x390")))))

; Output put together while the window waits: the scrolls added up, the
; rows due before moved up with them, those above the top gone.
(def test_due_after () int
  (let (d1 (due_after (due_none) 3 5 0)
        d2 (due_after d1 5 23 2)
        d3 (due_after (Due 0 0 1) 23 23 4))
    (add (check_int "rows 3" (.lo d1) 3)
         (add (check_str "moved up" (due_text d2) "2 1 23")
              (add (check_str "gone above" (due_text d3) "4 19 23")
                   (check_bool "none" (due_empty (due_none)) true))))))

; d as its scroll, first and last row, for a test.
(def due_text ((d Due)) (list int) (unwords (cons (digits (.k d)) (cons (digits (.lo d)) (cons (digits (.hi d)) (nil (list int)))))))

; t with its cursor at the start of row r.
(def tab_with_cursor ((t Tab) (r int)) Tab
  (.term t (Term 0 r 80 24)))
