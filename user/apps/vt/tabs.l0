; tabs.l0 -- a Terminal's tabs, each a terminal of its own: its name, its
; shell, its cells and its line editing, and which tab is selected. Each
; tab has a port of the window's vt, on which vt registers the tab's
; name, so vt knows a tab by the port a message came on (a set of ports,
; vt.l0's serve), and lets the name go as the tab closes.

; A tab: its port; its shell's pid, 0 until it starts; its name, ""
; until it is registered; the cursor; the cells; how many rows above the
; screen its view is, 0 at the bottom; and its line editing.
(data Tab (Tab int int (list int) Term Cells int Console))

; A tab on port, unnamed and with no shell yet, its cells cols by rows
; and blank.
(def tab_new ((port int) (cols int) (rows int)) Tab
  (Tab port 0 "" (Term 0 0 cols rows) (cells_new cols rows) 0 (console_new)))

; Its port, its shell's pid, its name, its cursor, its cells, how far
; back its view is, and its line editing.
(def tab_port ((t Tab)) int (match t ((Tab r sh name term cl back con) r)))
(def tab_shell ((t Tab)) int (match t ((Tab r sh name term cl back con) sh)))
(def tab_name ((t Tab)) (list int) (match t ((Tab r sh name term cl back con) name)))
(def tab_term ((t Tab)) Term (match t ((Tab r sh name term cl back con) term)))
(def tab_cells ((t Tab)) Cells (match t ((Tab r sh name term cl back con) cl)))
(def tab_back ((t Tab)) int (match t ((Tab r sh name term cl back con) back)))

; What a tab is called, on the tab bar and as the window's title: its
; name, or Terminal until it has one.
(def tab_title ((t Tab)) (list int) (let n (tab_name t) (if (is_empty n) "Terminal" n)))

; t named name, its shell pid.
(def tab_started ((t Tab) (name (list int)) (pid int)) Tab
  (match t ((Tab r sh old term cl back con) (Tab r pid name term cl back con))))

; t with its view back rows above the screen.
(def tab_backed ((t Tab) (b int)) Tab
  (match t ((Tab r sh name term cl old con) (Tab r sh name term cl b con))))

; t's cells and cursor wrapped again at cols by rows, as cells.l0's
; cells_rewrapped does, its view no further back than its cells now
; have rows scrolled off; as it was if it is that size already.
(def tab_resized ((t Tab) (cols int) (rows int)) Tab
  (match t
    ((Tab r sh name term cl back con)
      (match term
        ((Term col row tc tr)
          (if (if (eq tc cols) (eq tr rows) false)
              t
              (match (cells_rewrapped cl col row cols rows)
                ((Rewrapped cl2 col2 row2)
                  (Tab r sh name (Term col2 row2 cols rows) cl2 (min back (cells_back cl2)) con)))))))))

; ------------------------------------------------------------------ tabs

; The tabs, in order, and the selected one's port, 0 if there is none.
(data Tabs (Tabs (list Tab) int))

; No tabs.
(def tabs_none () Tabs (Tabs (nil Tab) 0))

; How many there are.
(def tabs_count ((ts Tabs)) int (match ts ((Tabs l sel) (length l))))

; ts with t added after the others, and selected.
(def tabs_add ((ts Tabs) (t Tab)) Tabs
  (match ts ((Tabs l sel) (Tabs (append l (cons t (nil Tab))) (tab_port t)))))

; The tab on port, if one is.
(def tabs_by_port ((ts Tabs) (port int)) (Option Tab)
  (match ts ((Tabs l sel) (tab_where l port true))))

; The first tab's port, 0 if there is none.
(def tabs_first_port ((ts Tabs)) int
  (match ts ((Tabs l sel) (if (is_empty l) 0 (tab_port (head l))))))

; The tab whose shell is pid, if one is.
(def tabs_by_shell ((ts Tabs) (pid int)) (Option Tab)
  (if (eq pid 0) ((None Tab)) (match ts ((Tabs l sel) (tab_where l pid false)))))

; The first of l whose port, or if not by_port whose shell, is n.
(def tab_where ((l (list Tab)) (n int) (by_port bool)) (Option Tab)
  (if (is_empty l)
      ((None Tab))
      (if (eq (if by_port (tab_port (head l)) (tab_shell (head l))) n)
          (Some (head l))
          (tab_where (tail l) n by_port))))

; The selected tab, if there is one.
(def tabs_selected ((ts Tabs)) (Option Tab)
  (match ts ((Tabs l sel) (tab_where l sel true))))

; Whether t is the selected tab.
(def tabs_is_selected ((ts Tabs) (t Tab)) bool
  (match ts ((Tabs l sel) (eq sel (tab_port t)))))

; ts with the tab on port selected, if there is one.
(def tabs_select ((ts Tabs) (port int)) Tabs
  (match (tabs_by_port ts port)
    ((None) ts)
    ((Some t) (match ts ((Tabs l sel) (Tabs l port))))))

; ts with t in place of the tab on its port.
(def tabs_put ((ts Tabs) (t Tab)) Tabs
  (match ts ((Tabs l sel) (Tabs (tabs_put_onto l t (nil Tab)) sel))))

; tabs_put's loop, onto the reversed acc.
(def tabs_put_onto ((l (list Tab)) (t Tab) (acc (list Tab))) (list Tab)
  (if (is_empty l)
      (rev acc)
      (tabs_put_onto (tail l) t (cons (if (eq (tab_port (head l)) (tab_port t)) t (head l)) acc))))

; ts without the tab on port. If it was selected, the one after it is,
; or the one before it if it was the last, as GNOME Console selects when
; a tab closes.
(def tabs_drop ((ts Tabs) (port int)) Tabs
  (match ts
    ((Tabs l sel)
      (let kept (tabs_without l port (nil Tab))
        (Tabs kept (if (eq sel port) (tab_after l port 0) sel))))))

; l without the tab on port, onto the reversed acc.
(def tabs_without ((l (list Tab)) (port int) (acc (list Tab))) (list Tab)
  (if (is_empty l)
      (rev acc)
      (tabs_without (tail l) port (if (eq (tab_port (head l)) port) acc (cons (head l) acc)))))

; The port of the tab after the one on port in l, or of the one before
; it, before, if it is the last; 0 if it is alone.
(def tab_after ((l (list Tab)) (port int) (before int)) int
  (if (is_empty l)
      before
      (if (eq (tab_port (head l)) port)
          (if (is_empty (tail l)) before (tab_port (head (tail l))))
          (tab_after (tail l) port (tab_port (head l))))))

; Every tab's cells and cursor wrapped again at cols by rows.
(def tabs_resized ((ts Tabs) (cols int) (rows int)) Tabs
  (match ts ((Tabs l sel) (Tabs (tabs_resized_onto l cols rows (nil Tab)) sel))))

; tabs_resized's loop, onto the reversed acc.
(def tabs_resized_onto ((l (list Tab)) (cols int) (rows int) (acc (list Tab))) (list Tab)
  (if (is_empty l) (rev acc) (tabs_resized_onto (tail l) cols rows (cons (tab_resized (head l) cols rows) acc))))

; The window's title: the selected tab's, or Terminal with none.
(def tabs_title ((ts Tabs)) (list int)
  (match (tabs_selected ts) ((None) "Terminal") ((Some t) (tab_title t))))

; The tabs as the tab bar shows them: each its port as its key, and its
; title.
(def tabs_shown ((ts Tabs)) (list UiTab)
  (match ts ((Tabs l sel) (tabs_shown_onto l (nil UiTab)))))

; tabs_shown's loop, onto the reversed acc.
(def tabs_shown_onto ((l (list Tab)) (acc (list UiTab))) (list UiTab)
  (if (is_empty l) (rev acc) (tabs_shown_onto (tail l) (cons (UiTab (digits (tab_port (head l))) (tab_title (head l))) acc))))

; The selected tab's key on the tab bar.
(def tabs_selected_key ((ts Tabs)) (list int) (match ts ((Tabs l sel) (digits sel))))

; Every tab's shell, those not yet started left out: the processes to
; end when the window closes.
(def tabs_pids ((ts Tabs)) (list int)
  (match ts ((Tabs l sel) (tab_shells_of l))))

; Each of l's shells, but none that is 0.
(def tab_shells_of ((l (list Tab))) (list int)
  (if (is_empty l)
      (nil int)
      (let p (tab_shell (head l))
        (if (eq p 0) (tab_shells_of (tail l)) (cons p (tab_shells_of (tail l)))))))

; Every tab's port, in order: with the window's, what vt waits on.
(def tabs_ports ((ts Tabs)) (list int)
  (match ts ((Tabs l sel) (tab_ports_onto l (nil int)))))

; tabs_ports's loop, onto the reversed acc.
(def tab_ports_onto ((l (list Tab)) (acc (list int))) (list int)
  (if (is_empty l) (rev acc) (tab_ports_onto (tail l) (cons (tab_port (head l)) acc))))
