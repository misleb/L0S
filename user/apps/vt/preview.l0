; preview.l0 -- Terminal's scenes for make preview APP=vt, each a window
; of 80 by 24 cells painted as on the board, the terminal drawn by vt's
; own drawing and the window's outline over it: a shell's first prompt;
; after a listing, in two tabs; and scrolled back through a long one,
; its scrollbar showing.
(def main () int (ui_preview_painted scenes))

; The scenes, painted with face.
(def scenes ((face UiFace)) (list UiPainted)
  (cons (scene face "prompt" (tabs_add (tabs_none) (shell 1 "vt1" "/" (motd))))
        (cons (scene face "tabs" (tabs_add (tabs_add (tabs_none) (shell 1 "vt1" "/" (motd))) (shell 2 "vt2" "/Volumes/data" (listing 12))))
              (cons (scene face "back" (tabs_add (tabs_none) (back_by (shell 1 "vt1" "/bin" (listing 60)) 20)))
                    (nil UiPainted)))))

; The window of a Terminal with tabs ts, as vt_refreshed draws it: its
; tabs as many cells as fit, its widgets painted, its outline last, and
; the selected tab's view drawn in the terminal's area, under the
; outline, as ui_present paints it over what vt drew.
(def scene ((face UiFace) (name (list int)) (ts Tabs)) UiPainted
  (let (t0 (vt_cells (nil (list int)))
        w (term_win_w t0)
        h (term_win_h t0)
        a (term_area w h (tabs_count ts))
        ts2 (tabs_resized ts (area_cols a) (area_rows a))
        st (ui_state_new (ui_style))
        ns (ui_outlined true (ui_layout_window (vt_view ts2 (tabs_title ts2)) w h st) w h (ui_style))
        c (ui_paint_nodes (canvas_new w h (ui_window_bg (ui_style))) face (Rect 0 0 w h) ns)
        c2 (match (tabs_selected ts2) ((None) c) ((Some t) (view_drawn c face a t st))))
    (UiPainted name w h (ui_overlaid c2 face ns (cons a (nil Rect))))))

; A tab on port, named name, whose shell, at the folder dir, wrote text
; and then its prompt, and told dir as its title.
(def shell ((port int) (name (list int)) (dir (list int)) (text (list int))) Tab
  (.title (.tab (tab_written (tab_started (tab_new port 80 24) name (add port 10)) (append text "l0s> "))) dir))

; t with its view n rows back.
(def back_by ((t Tab) (n int)) Tab (.back t n))

; The shell's greeting.
(def motd () (list int) "L0S shell, on an L0 microkernel. Type help for the commands.\n")

; ls of a folder of n files, a line each.
(def listing ((n int)) (list int) (append "l0s> ls\n" (listing_lines 1 n)))

; Lines i up to n of a listing.
(def listing_lines ((i int) (n int)) (list int)
  (if (gt i n) "" (append (append "file" (append (digits i) ".txt\n")) (listing_lines (add i 1) n))))
