; virtio-net_test.l0 -- tests of virtio-net.l0: the queues' layout, the
; descriptors and rings the card is given, and frames as it reads them.

; The rings of each queue fit their page, and the receive buffers the 10
; pages, each in one page: buffer 15 is the last, at 8192 + 15 * 2048.
(def test_layout () int
  (add (check_int "receive's used ring" (rx_used) 512)
       (add (check_int "transmit's used ring" (tx_used) 4608)
            (add (check_int "the last buffer's end" (add (rx_buffer 15) (buffer_size)) (mul (queue_pages) 4096))
                 (check_int "two a page" (mod (rx_buffer 3) 4096) 2048)))))

; Each descriptor is a buffer of 2048 bytes the card writes, where it
; reaches the page it is in: buffer 1 is at 10240, in page 2, half way.
(def test_rx_descriptors () int
  (let addrs (array_from (cons 0 (cons 4096 (cons 81920 (cons 90112 (repeat 6 0))))) 0)
    (let b (bytes_from_list (rx_descriptors addrs 0 (nil int)))
      (add (check_int "16 of them" (bytes_len b) 256)
           (add (check_int "buffer 1's address" (le_u32 b 16) 83968)
                (add (check_int "its length" (le_u32 b 24) 2048)
                     (check_int "written, no next" (le_u32 b 28) 2)))))))

(def test_rx_avail () int
  (let b (bytes_from_list (rx_avail_all))
    (add (check_int "flags and idx 16" (le_u32 b 0) 1048576)       ; 16 << 16
         (add (check_int "the last entry" (le_u16_at b 34) 15)
              (check_int "36 bytes" (bytes_len b) 36)))))

(def test_tx_avail () int
  (check_str "no interrupt" (tx_avail_none) (cons 1 (cons 0 (cons 0 (cons 0 (nil int)))))))

; A short frame is padded to 60 bytes, after the 12 of the header.
(def test_tx_bytes () int
  (let bs (tx_bytes (repeat 14 7))
    (add (check_int "header and 60" (length bs) 72)
         (add (check_str "header" (take bs 12) (zeros 12))
              (check_int "padding" (nth bs 14) 7)))))

(def test_tx_long () int
  (check_int "not padded" (length (tx_bytes (zeros 1514))) 1526))

(def test_refusal () int
  (add (check_str "too short" (frame_refusal (zeros 13)) "a frame has at least 14 bytes")
       (add (check_str "too long" (frame_refusal (zeros 1515)) "a frame has at most 1514 bytes")
            (check_str "fine" (frame_refusal (zeros 60)) ""))))

(def test_counts () int
  (check_str "counted" (counts_text (counted_tx (counted_rx (counted_rx (NicCounts 0 0 0) true) false) true))
             "rx 1 tx 1 dropped 1"))

; Under an operating system there are no transports to drive.
(def test_no_device () int
  (check_int "fails" (virtio_net) 1))
