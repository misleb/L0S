; virtio-net.l0 -- a network driver for QEMU's virtio-net: finds the card
; among the board's virtio-mmio transports, keeps its receive queue filled
; with buffers in DMA pages, takes its interrupt as a message, and tells
; each process listening of every frame it receives; and puts on the wire
; each frame it is sent. Serves the nic protocol, user/lib/proto/nic.l0,
; as nic. Its module must be flagged dev.
;
; A frame travels in a message, both ways, since one fits: a frame of the
; card's is copied out of its buffer into a notice, and one to send is
; copied into the one transmit buffer, which the card reads by DMA. The
; driver sends one frame at a time and waits for the card to have it, as
; virtq_wait does; the stack above it, inet, is what queues.

(def net_device () int 1)           ; DeviceID of a network card

; VIRTIO_NET_F_MAC, bit 5: the card's configuration holds its address
; (virtio 1.2, section 5.1.3).
(def net_f_mac () int 32)

; The address a card that gives none is given: QEMU's first, 52:54:00:12:34:56.
(def default_mac () (list int)
  (cons 82 (cons 84 (cons 0 (cons 18 (cons 52 (cons 86 (nil int))))))))

; Every frame begins with struct virtio_net_hdr, 12 bytes with
; VIRTIO_F_VERSION_1 (section 5.1.6): flags, gso_type, hdr_len, gso_size,
; csum_start, csum_offset, num_buffers. Zero for a frame sent whole.
(def net_header_len () int 12)

; ---------------------------------------------------------------- the queues

; The queues, in 10 DMA pages: the receive queue's descriptors, available
; and used rings in the first; the transmit queue's in the second, with
; its one buffer at 6144; and a buffer of 2048 bytes for each of the
; receive queue's 16 entries from 8192, each within a page.
(def ring_size () int 16)
(def queue_pages () int 10)
(def buffer_size () int 2048)

; Where the receive queue's descriptors, available ring and used ring are.
(def rx_desc () int 0)

; The receive queue's available ring.
(def rx_avail () int (virtq_avail_off (ring_size)))

; The receive queue's used ring.
(def rx_used () int (virtq_used_off (ring_size)))

; Where the transmit queue's descriptors are, in the second page.
(def tx_desc () int 4096)

; The transmit queue's available ring.
(def tx_avail () int (add (tx_desc) (virtq_avail_off (ring_size))))

; The transmit queue's used ring.
(def tx_used () int (add (tx_desc) (virtq_used_off (ring_size))))

; The one transmit buffer, the second page's second half.
(def tx_buffer () int 6144)

; Receive buffer i, from the third page, two a page.
(def rx_buffer ((i int)) int (add 8192 (mul i (buffer_size))))

; Queue 0 receives, queue 1 transmits (section 5.1.2).
(def rx_queue () int 0)
(def tx_queue () int 1)

; The receive queue's descriptors from i on, each one buffer the card
; writes a frame into, where the card reaches pages at addrs.
(def rx_descriptors ((addrs (array int)) (i int) (acc (list int))) (list int)
  (if (eq i (ring_size))
      (rev acc)
      (rx_descriptors addrs (add i 1)
                      (push (descriptor (device_at addrs (rx_buffer i)) (buffer_size) (desc_write) 0) acc))))

; The receive queue's available ring holding every buffer, in order:
; flags, idx, ring.
(def rx_avail_all () (list int)
  (append (le16 0) (append (le16 (ring_size)) (rev (rx_entries 0 (nil int))))))

; The ring's entries from i, each the buffer of its own number, onto acc.
(def rx_entries ((i int) (acc (list int))) (list int)
  (if (eq i (ring_size)) acc (rx_entries (add i 1) (push (le16 i) acc))))

; The transmit queue's available ring, empty, flagged
; VIRTQ_AVAIL_F_NO_INTERRUPT: the driver waits for the card itself.
(def tx_avail_none () (list int) (append (le16 1) (le16 0)))

; frame as the card is to read it: the header, then the frame, padded.
(def tx_bytes ((frame (list int))) (list int)
  (append (zeros (net_header_len)) (nic_padded frame)))

; ---------------------------------------------------------------- the driver

; The driver: the transports' registers and the card's transport; the
; queues' pages and where the card reaches each; the next index to make
; available on the receive queue and the next used one to read, as the
; rings count them; the frames sent, as the transmit ring counts them;
; the ports listening; the card's address; and the counts.
(data Nic (Nic IoDevice int IoDevice (array int) int int int (list int) (list int) NicCounts))

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "virtio-net" why))

; What the driver says once it serves nic: the card's address and where
; it is.
(def card_line ((mac (list int)) (t int)) (list int)
  (append "a card " (append (mac_text mac) (append ", " (append (virtio_where t) ", serving nic")))))

; The driver: the transports opened, and the first card among them found.
(def virtio_net () int
  (match (virtio_open)
    ((Err why) (complain why))
    ((Ok d) (found d (find_device d (net_device) 0)))))

; No card is no failure: the board was started without one.
(def found ((d IoDevice) (t int)) int
  (match (virtio_probe_features d t "the virtio-net" "receive" (ring_size) (net_f_mac))
    ((VirtioAbsent) (info_as "virtio-net" "no virtio-net on the board"))
    ((VirtioUnusable why) (complain why))
    ((VirtioReady t2)
      (if (lt (queue_max d t (tx_queue)) (ring_size))
          (complain "the transmit queue is too small")
          (match (virtq_mem (queue_pages) "the queues")
            ((NoVirtqMem why) (complain why))
            ((VirtqMem va q addrs) (filled d t q addrs (card_mac d t))))))))

; The card's address: its configuration's first six bytes, if it gives
; one, and otherwise QEMU's first.
(def card_mac ((d IoDevice) (t int)) (list int)
  (if (eq (bit_and (device_features d t 0) (net_f_mac)) 0)
      (default_mac)
      (get_bytes d (treg t (reg_config)) 6)))

; Both queues laid out and started, the card told the driver is ready
; and given every receive buffer, and the driver serving.
(def filled ((d IoDevice) (t int) (q IoDevice) (addrs (array int)) (mac (list int))) int
  (let ds (put_bytes q (rx_desc) (rx_descriptors addrs 0 (nil int)))
    (let av (put_bytes q (rx_avail) (rx_avail_all))
      (let tv (put_bytes q (tx_avail) (tx_avail_none))
        (let r (start_queue d t (rx_queue) (ring_size) (device_at addrs (rx_desc)) (device_at addrs (rx_avail)) (device_at addrs (rx_used)))
          (let s (start_queue d t (tx_queue) (ring_size) (device_at addrs (tx_desc)) (device_at addrs (tx_avail)) (device_at addrs (tx_used)))
            (let o (driver_ok d t)
              (let b (barrier)
                (let n (notify d t (rx_queue))
                  (listening (Nic d t q addrs (ring_size) 0 0 (nil int) mac (NicCounts 0 0 0))))))))))))

; Registers as nic and binds the card's interrupt, then serves.
(def listening ((k Nic)) int
  (let port (port_new)
    (let r (name_register_or_why port "nic")
      (if (not (is_empty r))
          (complain r)
          (let b (irq_bind_or_why (transport_irq (nic_transport k)) port)
            (if (is_empty b)
                (let n (info_as "virtio-net" (match k ((Nic d t q addrs rxa rxu txn ls mac c) (card_line mac t))))
                  (serve k port))
                (complain b)))))))

; The card's transport, whose interrupt is the card's.
(def nic_transport ((k Nic)) int (match k ((Nic d t q addrs rxa rxu txn ls mac c) t)))

; ---------------------------------------------------------------- serving

; Each message on port: the card's interrupt, or a request.
(def serve ((k Nic) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from payload)
      (if (is_irq_notice (Message from payload) (transport_irq (nic_transport k)))
          (serve (interrupted k) port)
          (serve (requested k payload) port)))))

; A request answered: send puts a frame on the wire, listen adds the
; reply port to those told of frames, info and stats say what they say.
(def requested ((k Nic) (payload (list int))) Nic
  (let body (request_body payload)
    (match (nic_sent_frame body)
      ((Some frame) (sent_answered (transmitted k frame) payload))
      ((None)
        (if (eq body "listen")
            (listened k (request_reply payload))
            (match (asked k body)
              ((Served k2 answer) (let a (request_answer payload answer) k2))))))))

; info, stats, or anything else, which is refused.
(def asked ((k Nic) (body (list int))) (Served Nic)
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (if (eq body "info") (Served k (append "nic " (mac_text mac)))
      (if (eq body "stats") (Served k (nic_counts_text c))
      (served_error k (append "no request " (take_line body))))))))

; A send's answer, to its reply port if it names one.
(def sent_answered ((s (Served Nic)) (payload (list int))) Nic
  (match s ((Served k answer) (let a (request_answer payload answer) k))))

; k with port listening, if it is one and the answer to its listen says
; it is still there.
(def listened ((k Nic) (port int)) Nic
  (if (le port 0)
      k
      (match k
        ((Nic d t q addrs rxa rxu txn ls mac c)
          (Nic d t q addrs rxa rxu txn (listener_add ls port (port_send port "ok")) mac c)))))

; ---------------------------------------------------------------- sending

; frame put on the wire, or why not.
(def transmitted ((k Nic) (frame (list int))) (Served Nic)
  (let why (nic_frame_refusal frame)
    (if (not (is_empty why))
        (served_error (with_counts k (nic_counted_tx (nic_counts k) false)) why)
        (transmit k frame))))

; The driver's counts.
(def nic_counts ((k Nic)) NicCounts (match k ((Nic d t q addrs rxa rxu txn ls mac c) c)))

; k with the counts c2.
(def with_counts ((k Nic) (c2 NicCounts)) Nic
  (match k ((Nic d t q addrs rxa rxu txn ls mac c) (Nic d t q addrs rxa rxu txn ls mac c2))))

; The frame copied into the transmit buffer, its descriptor made the
; queue's first, offered, and waited for.
(def transmit ((k Nic) (frame (list int))) (Served Nic)
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (let bs (tx_bytes frame)
        (let w (put_bytes q (tx_buffer) bs)
          (let ds (put_bytes q (tx_desc) (descriptor (device_at addrs (tx_buffer)) (length bs) 0 0))
            (let n (virtq_offer d t (tx_queue) q (tx_avail) (ring_size) txn 0)
              (let ok (virtq_wait q (tx_used) n (clock_ns))
                (let k2 (Nic d t q addrs rxa rxu n ls mac (nic_counted_tx c ok))
                  (if ok (served_ok k2) (served_error k2 "the card did not take the frame")))))))))))

; -------------------------------------------------------------- receiving

; The card has used buffers: ends its interrupt, reads each frame and
; tells it, gives the buffers back, and ends the interrupt with the kernel.
(def interrupted ((k Nic)) Nic
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (let st (device_read32 d (treg t (reg_interrupt_status)))
        (let a (device_write32 d (treg t (reg_interrupt_ack)) st)
          (let b (barrier)
            (refilled (drain k (virtq_used_index q (rx_used))))))))))

; The buffers given back made available, and the interrupt ended.
(def refilled ((k Nic)) Nic
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (let p (virtq_publish d t (rx_queue) q (rx_avail) rxa)
        (let a (irq_ack (transport_irq t)) k)))))

; Each used entry from the next to read up to the card's index.
(def drain ((k Nic) (device_idx int)) Nic
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (if (eq (bit_and rxu 65535) device_idx)
          k
          (let id (mod (virtq_used_id q (rx_used) (ring_size) rxu) (ring_size))
            (let len (virtq_used_len q (rx_used) (ring_size) rxu)
              (let k2 (received (Nic d t q addrs rxa (add rxu 1) txn ls mac c) (frame_at q id len))
                (drain (given_back k2 id) device_idx))))))))

; What the card wrote into buffer id, len bytes with its header: the
; frame, or none if it is too short or too long to be one.
(def frame_at ((q IoDevice) (id int) (len int)) (Option (list int))
  (let n (sub len (net_header_len))
    (if (if (lt n (frame_min)) true (gt n (frame_max)))
        ((None (list int)))
        (Some (get_bytes q (add (rx_buffer id) (net_header_len)) n)))))

; A frame told to every listener, and counted; none, or no one to tell,
; is a frame dropped.
(def received ((k Nic) (f (Option (list int)))) Nic
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (match f
        ((None) (Nic d t q addrs rxa rxu txn ls mac (nic_counted_rx c false)))
        ((Some frame)
          (Nic d t q addrs rxa rxu txn (listeners_tell ls (frame_notice frame)) mac
               (nic_counted_rx c (not (is_empty ls)))))))))

; Buffer id on the available ring again.
(def given_back ((k Nic) (id int)) Nic
  (match k
    ((Nic d t q addrs rxa rxu txn ls mac c)
      (let w (virtq_slot q (rx_avail) (ring_size) rxa id)
        (Nic d t q addrs (add rxa 1) rxu txn ls mac c)))))
