; endpoint_test.l0 -- tests of endpoint.l0: loudness, and when a phrase
; has begun and ended, on pieces of samples made here.

; n samples of loudness a, +a and -a in turn, so each piece's power is
; a squared, as 16-bit little-endian bytes.
(def tone ((n int) (a int)) bytes (bytes_from_list (tone_onto n a (nil int))))
(def tone_onto ((n int) (a int) (acc (list int))) (list int)
  (if (le n 0) acc (tone_onto (sub n 1) a (append (le16 (bit_and (if (eq (mod n 2) 0) a (neg a)) 65535)) acc))))

; e fed k pieces of 160 samples (10 ms) of loudness a.
(def fed_pieces ((e Endpoint) (k int) (a int)) Endpoint
  (if (le k 0) e (let p (tone 160 a) (fed_pieces (endpoint_fed e p 0 (bytes_len p)) (sub k 1) a))))

(def test_power_of_a_tone () int
  (let p (tone 160 1000) (check_int "power" (ep_power p 0 (bytes_len p)) 1000000)))

(def test_power_of_nothing () int
  (check_int "none" (ep_power (bytes_from_list "") 0 0) 0))

(def test_power_counts_negative () int
  ; -3 is 0xfffd: its square is 9, not 65533's.
  (check_int "power" (ep_power (bytes_from_list (le16 65533)) 0 2) 9))

(def test_new_is_going () int
  (check_str "verdict" (verdict_text (endpoint_verdict (endpoint_new))) "going"))

; The room at 100, under both leasts: its floor is 10000.
(def test_floor_is_the_quietest () int
  (let e (fed_pieces (fed_pieces (endpoint_new) 5 300) 5 100)
    (check_int "floor" (.floor e) 10000)))

(def test_quiet_room_is_not_speech () int
  (let e (fed_pieces (endpoint_new) 100 100)
    (add (check_bool "spoke" (.spoke e) false)
         (check_str "verdict" (verdict_text (endpoint_verdict e)) "going"))))

; Speech at 2000 after a room at 100, then 0.8 s (80 pieces) of the room.
(def test_speech_then_quiet_ends () int
  (let e (fed_pieces (fed_pieces (fed_pieces (endpoint_new) 30 100) 100 2000) 80 100)
    (check_str "verdict" (verdict_text (endpoint_verdict e)) "ended")))

(def test_a_short_pause_goes_on () int
  (let e (fed_pieces (fed_pieces (fed_pieces (endpoint_new) 30 100) 100 2000) 40 100)
    (check_str "verdict" (verdict_text (endpoint_verdict e)) "going")))

(def test_speech_again_restarts_the_quiet () int
  (let e (fed_pieces (fed_pieces (fed_pieces (fed_pieces (endpoint_new) 30 100) 50 2000) 60 100) 1 2000)
    (check_int "quiet" (.quiet e) 0)))

; A noisy room, 600: speech is 4 times as loud, 2400, and 1500 is
; neither speech nor quiet.
(def test_loudness_is_against_the_floor () int
  (let e (fed_pieces (fed_pieces (endpoint_new) 30 600) 30 1500)
    (check_bool "spoke" (.spoke e) false)))

(def test_no_speech_in_five_seconds () int
  (let e (fed_pieces (endpoint_new) 500 100)
    (check_str "verdict" (verdict_text (endpoint_verdict e)) "silent")))

(def test_thirty_seconds_is_full () int
  (let e (fed_pieces (fed_pieces (endpoint_new) 10 100) 2990 2000)
    (check_str "verdict" (verdict_text (endpoint_verdict e)) "full")))
