; speech_test.l0 -- tests of speech.l0: its arguments, what its key
; does, when a phrase is over, the agent's answers, and its lines.

; What the arguments ask, as text.
(def ask_text ((line (list int))) (list int)
  (match (ask_of (split_spaces line))
    ((AskServe m k) (append "serve " (append m (cons 32 (digits k)))))
    ((AskTell body) (append "tell " body))
    ((AskWrong why) "wrong")))

(def test_ask_serve_by_default () int
  (check_str "none" (ask_text "") "serve /Volumes/data/speech/whistle.cact 88"))

(def test_ask_model_and_key () int
  (add (check_str "both" (ask_text "-k 87 -m /etc/whistle.cact") "serve /etc/whistle.cact 87")
       (check_str "not a key" (ask_text "-k F11") "wrong")))

(def test_ask_requests () int
  (add (check_str "listen" (ask_text "listen") "tell listen")
       (add (check_str "hear" (ask_text "hear /etc/clip.wav") "tell hear /etc/clip.wav")
            (check_str "open is a program's" (ask_text "open 5") "wrong"))))

; What a key does, as a word.
(def key_text ((m Mode) (value int) (now int)) (list int)
  (match (key_do m value now)
    ((KeyBegin) "begin")
    ((KeyEnd) "end")
    ((KeyTap) "tap")
    ((KeyNone) "none")))

(def test_press_begins () int
  (add (check_str "pressed" (key_text (Idle) 1 0) "begin")
       (check_str "let go" (key_text (Idle) 0 0) "none")))

; Held from 1 s: let go 0.1 s on is a tap, 1 s on the end.
(def test_release_ends_or_taps () int
  (add (check_str "tap" (key_text (Held 1000000000) 0 1100000000) "tap")
       (add (check_str "held" (key_text (Held 1000000000) 0 2000000000) "end")
            (check_str "repeat" (key_text (Held 1000000000) 2 2000000000) "none"))))

(def test_press_after_tap_ends () int
  (add (check_str "pressed" (key_text (Tapped) 1 0) "end")
       (check_str "let go" (key_text (Tapped) 0 0) "none")))

; An endpointer that has heard 5 s of nothing, and one full.
(def silent_ep () Endpoint (Endpoint 80000 100 false 0))
(def full_ep () Endpoint (Endpoint 480000 100 true 0))

(def test_tap_is_over_when_silent () int
  (add (check_bool "tapped" (phrase_over (Tapped) (silent_ep)) true)
       (check_bool "held" (phrase_over (Held 0) (silent_ep)) false)))

(def test_held_is_over_when_full () int
  (add (check_bool "held" (phrase_over (Held 0) (full_ep)) true)
       (check_bool "idle" (phrase_over (Idle) (full_ep)) false)))

; The agent's answers to say, as words.
(def say_text ((a (list int))) (list int)
  (match (say_do_of a) ((SaidOk) "ok") ((SaidBusy) "busy") ((SaidFailed why) why)))

(def test_say_answers () int
  (add (check_str "ok" (say_text "ok") "ok")
       (add (check_str "busy" (say_text "error: busy") "busy")
            (check_str "other" (say_text "error: no model") "no model"))))

(def test_state_word () int
  (add (check_str "muted" (state_word true (Held 0) "x") "muted")
       (add (check_str "listening" (state_word false (Tapped) "") "listening")
            (add (check_str "held" (state_word false (Idle) "x") "held")
                 (check_str "idle" (state_word false (Idle) "") "idle")))))

(def test_phrase_text () int
  (add (check_str "trimmed" (phrase_text "  Testing, testing. \n") "Testing, testing.")
       (check_str "nothing" (phrase_text "   ") "")))

; 16384 is half of 32768; 65535 is -1.
(def test_samples_of () int
  (let xs (samples_of (bytes_from_list (append (le16 16384) (le16 65535))))
    (add (check_int "two" (array_len xs) 2)
         (check_bool "half" (eq (array_get xs 0) 0.5) true))))

(def test_serving_line () int
  (add (check_str "keyed" (serving_line 14600 88 "") "Whistle read in 14600 ms, the key 88, serving speech")
       (check_str "no key" (serving_line 5 88 "no compositor; is wm running?") "Whistle read in 5 ms, no key: no compositor; is wm running?, serving speech")))

; Under an operating system there is no model where the installer puts
; it, so the service says so and ends as a driver with no device, 0;
; and no service to ask, 1.
(def test_entry_with_no_kernel () int
  (add (check_int "serve" (speech_main (nil (list int))) 0)
       (check_int "listen" (speech_main (cons "listen" (nil (list int)))) 1)))
