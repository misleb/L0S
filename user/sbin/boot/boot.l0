; boot.l0 -- the first process, pid 1, of an inittab that starts L0S in
; two stages: the initramfs's inittab starts boot and the drivers and fs,
; and boot starts the rest, the lines of /etc/system. Booted with
; root=UUID, a GPT partition's UUID, boot waits for fs to mount that
; partition's volume, until fs has mounted all it will, and if it holds
; /etc/system, makes it / (the
; kernel's root_switch, which gives the initramfs up) and starts the
; system volume's /etc/system; with no root=, or no such volume, or
; none that holds L0S, it says why and starts the initramfs's own. Then
; it waits for the first program started, the shell on the serial line,
; and exits with its status, which stops the system, as the first
; program of a one-stage inittab does.
;
; Booted with root=tmpfs, on a board with no system disk, boot has
; install copy the initramfs onto the RAM file system, started as fs ram,
; and makes that volume, tmp, / the same way: a / that can be written,
; with nothing kept once the board stops.
;
;   /etc/system: a line each, # for a comment
;   start PATH [ARG ...]   PATH started, in order, with ARGs, or else the
;                          arguments the inittab gives it

; Says why, as boot.
(def complain ((why (list int))) int (fail_as "boot" why))

; ------------------------------------------------------------ arguments

; The UUID root= names among the boot arguments, as text, in lower case;
; empty if there is none.
(def root_uuid ((args (list (list int)))) (list int)
  (if (is_empty args)
      ""
      (starts_with (head args) "root=")
      (lower (drop_n (head args) 5))
      (root_uuid (tail args))))

; s with its capital letters made small, as a UUID is compared.
(def lower ((s (list int))) (list int)
  (if (is_empty s)
      s
      (let c (head s)
        (cons (if (and (ge c 65) (le c 90)) (add c 32) c) (lower (tail s))))))

; ---------------------------------------------------------- /etc/system

; A program to start: its path, and its arguments if the line gives any.
(data Start (Start (list int) (Option (list (list int)))))

; The programs /etc/system starts, text, in order, or why not, with the
; line.
(def system_starts ((text (list int))) (Result (list Start) (list int))
  (system_lines (lines text) 1 (nil Start)))

(def system_lines ((ls (list (list int))) (n int) (acc (list Start))) (Result (list Start) (list int))
  (if (is_empty ls)
      ((Ok (list Start) (list int)) (rev acc))
      (let ws (split_spaces (strip_cr (head ls)))
        (if (or (is_empty ws) (starts_with (head ws) "#"))
            (system_lines (tail ls) (add n 1) acc)
            (and (eq (head ws) "start") (not (is_empty (tail ws))))
            (system_lines (tail ls) (add n 1)
                          (cons (Start (normal_path (head (tail ws)))
                                       (if (is_empty (tail (tail ws))) ((None (list (list int)))) (Some (tail (tail ws)))))
                                acc))
            ((Err (list Start) (list int)) (append "/etc/system line " (append (digits n) ": not start PATH [ARG ...]")))))))

; ----------------------------------------------------------- the volume

; The volume mounted with the UUID u, /Volumes/LABEL, among ms; or empty.
(def volume_of_uuid ((ms (list MountInfo)) (u (list int))) (list int)
  (if (is_empty ms)
      ""
      (match (head ms)
        ((MountInfo path port id)
          (if (and (starts_with path "/Volumes/") (eq (lower id) u)) path (volume_of_uuid (tail ms) u))))))

; The volume u is, once fs has mounted it, asked every 100 ms, tries
; times at most; or empty if it never is. fs registers only once it has
; mounted every volume on the disk, so once it has, and u is not among
; them, it never will be: asking whether it has before reading the mount
; table, so as not to miss a volume mounted between the two, ends the
; wait then, rather than at the last try.
(def volume_waited ((u (list int)) (tries int)) (list int)
  (let (done (fs_registered) v (volume_of_uuid (mount_list) u))
    (if (or (not (is_empty v)) (or done (le tries 0)))
        v
        (let s (sleep_ns 100000000) (volume_waited u (sub tries 1))))))

; Whether a file server has registered as fs.
(def fs_registered () bool
  (match (name_lookup "fs") ((Found port) true) ((NotFound) false)))

; How long fs may take to mount the disk's volumes: 10 s, of 100 ms. Only
; a board with no disk, whose fs never registers, waits it all.
(def volume_tries () int 100)

; What came of making a volume /: it is, or why it is not.
(data Rooted (Rooted (list int)) (NotRooted (list int)))

; The volume u made /, if it is mounted and holds /etc/system.
(def rooted ((u (list int))) Rooted
  (let v (volume_waited u (volume_tries))
    (if (is_empty v)
        (NotRooted (append "no volume " (append u " is mounted")))
        (match (read_whole (append v "/etc/system"))
          ((Err why) (NotRooted (append v (append "/etc/system: " why))))
          ((Ok b)
            (match (root_switch (drop_n v 9))
              ((Switched) (Rooted v))
              ((SwitchDenied) (NotRooted (switch_why (SwitchDenied))))
              ((SwitchDone) (NotRooted (switch_why (SwitchDone))))
              ((SwitchNoVolume) (NotRooted (switch_why (SwitchNoVolume))))
              ((SwitchBadLabel) (NotRooted (switch_why (SwitchBadLabel))))))))))

; What boot says of making u /, what came of it; nothing with no root=.
(def rooted_line ((u (list int)) (r Rooted)) (list int)
  (if (is_empty u)
      ""
      (match r
        ((Rooted v) (append "boot: / is " (append v "\n")))
        ((NotRooted why) (append "boot: " (append why "; starting the initramfs's system\n"))))))

; What boot logs of making u /, what came of it, as rooted_line says it
; on standard output: info for a volume made /, a warning for one that
; was not; nothing with no root=.
(def rooted_note ((u (list int)) (r Rooted)) int
  (if (is_empty u)
      0
      (match r
        ((Rooted v) (info_as "boot" (append "/ is " v)))
        ((NotRooted why) (warn_as "boot" (append why "; starting the initramfs's system"))))))

; -------------------------------------------------------------- starting

; Each of ss started, by its path: the first's pid, or 0 if it did not
; start; each that did not is said why.
(def start_all ((ss (list Start)) (first int)) int
  (if (is_empty ss)
      first
      (match (head ss)
        ((Start path args)
          (match (spawn_path path args)
            ((Spawned pid)
              (let w (debug_as "boot" (append "started " (append path (append " as pid " (digits pid)))))
                (start_all (tail ss) (if (eq first 0) pid first))))
            ((SpawnNoEntry) (start_all (tail ss) (not_started path (SpawnNoEntry) first)))
            ((SpawnNotProgram) (start_all (tail ss) (not_started path (SpawnNotProgram) first)))
            ((SpawnTooBig) (start_all (tail ss) (not_started path (SpawnTooBig) first)))
            ((SpawnNoRoom) (start_all (tail ss) (not_started path (SpawnNoRoom) first))))))))

; first, once path's not starting is said; -1 if it was to be the first.
(def not_started ((path (list int)) (s Spawn) (first int)) int
  (let w (complain (append path (append ": " (spawn_why s))))
    (if (eq first 0) -1 first)))

; The system /etc/system starts, the first waited for: its status.
(def system () int
  (match (read_whole "/etc/system")
    ((Err why) (complain (append "/etc/system: " why)))
    ((Ok b)
      (match (system_starts (bytes_to_list b))
        ((Err why) (complain why))
        ((Ok ss)
          (let first (start_all ss 0)
            (if (le first 0)
                (complain "the first program of /etc/system did not start")
                (match (wait_pid first)
                  ((Reaped st) st)
                  ((WaitNoProc) 1)))))))))

; ------------------------------------------------------------- root=tmpfs

; What root= names for the RAM file system, which fs ram serves: not a
; partition's UUID.
(def tmpfs_name () (list int) "tmpfs")

; The UUID fs ram mounts its volume tmp with.
(def tmpfs_uuid () (list int) "00000000-0000-7000-8000-000000000000")

; The UUID of the volume root= means: a, if it is one, else the RAM file
; system's for root=tmpfs.
(def root_volume ((a (list int))) (list int)
  (if (eq a (tmpfs_name)) (tmpfs_uuid) a))

; The volume u, waited for as long as volume_waited waits, but not
; ended by fs's registering, as the disk's volumes are all mounted by
; then and the RAM file system's is a server of its own; or empty.
(def volume_waited_for ((u (list int)) (tries int)) (list int)
  (let v (volume_of_uuid (mount_list) u)
    (if (or (not (is_empty v)) (le tries 0))
        v
        (let s (sleep_ns 100000000) (volume_waited_for u (sub tries 1))))))

; The initramfs copied onto the RAM file system u, by install, from
; which it can be made /: nothing, or why not.
(def tmpfs_filled ((u (list int))) (list int)
  (let v (volume_waited_for u (volume_tries))
    (if (is_empty v)
        "no RAM file system is mounted; is fs ram started?"
        (match (spawn_path "/bin/install" (Some (cons (drop_n v 9) (nil (list int)))))
          ((Spawned pid) (installed (wait_pid pid)))
          ((SpawnNoEntry) (append "/bin/install: " (spawn_why (SpawnNoEntry))))
          ((SpawnNotProgram) (append "/bin/install: " (spawn_why (SpawnNotProgram))))
          ((SpawnTooBig) (append "/bin/install: " (spawn_why (SpawnTooBig))))
          ((SpawnNoRoom) (append "/bin/install: " (spawn_why (SpawnNoRoom))))))))

; Nothing if install, waited for, exited with 0, else why not.
(def installed ((r Reaped)) (list int)
  (match r
    ((Reaped st) (if (eq st 0) "" (append "install exited with " (digits st))))
    ((WaitNoProc) "install is gone")))

; The volume u made /, as rooted does, after the RAM file system has the
; initramfs copied onto it, if a is root=tmpfs.
(def rooted_for ((a (list int)) (u (list int))) Rooted
  (if (eq a (tmpfs_name))
      (let why (tmpfs_filled u)
        (if (is_empty why) (rooted u) (NotRooted why)))
      (rooted u)))

; Boots: the volume root= names made /, if it can be, then the system.
; Under an operating system there is no kernel, no boot argument, and no
; /etc/system.
(def boot () int
  (let (a (root_uuid (boot_args))
        u (root_volume a)
        r (if (is_empty u) (NotRooted "") (rooted_for a u))
        w (say (rooted_line u r))
        n (rooted_note u r))
    (system)))
