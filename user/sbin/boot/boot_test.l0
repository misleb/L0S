; boot_test.l0 -- tests of what boot reads: the boot arguments,
; /etc/system, the mount table, and what it says.

(def sys_uuid () (list int) "018f0000-0000-7000-8000-00000000000a")

(def test_root_uuid () int
  (add (check_str "among others" (root_uuid (split_spaces "quiet root=018F0000-0000-7000-8000-00000000000A x")) (sys_uuid))
       (check_str "none" (root_uuid (split_spaces "quiet")) "")))

(def starts_text ((r (Result (list Start) (list int)))) (list int)
  (match r
    ((Err why) (append "error: " why))
    ((Ok ss) (starts_words ss))))

(def starts_words ((ss (list Start))) (list int)
  (if (is_empty ss)
      ""
      (match (head ss)
        ((Start path args)
          (append path (append (match args ((None) "") ((Some a) (append " " (unwords a)))) (append "|" (starts_words (tail ss)))))))))

(def test_system_starts () int
  (check_str "in order, args given or not"
             (starts_text (system_starts "# the rest\nstart /bin/sh\n\nstart sbin/wm\r\nstart /Applications/Terminal.app/vt a b\n"))
             "/bin/sh|/sbin/wm|/Applications/Terminal.app/vt a b|"))

(def test_system_bad () int
  (add (check_str "another word" (starts_text (system_starts "start /bin/sh\ndev /sbin/uart\n")) "error: /etc/system line 2: not start PATH [ARG ...]")
       (check_str "no path" (starts_text (system_starts "start\n")) "error: /etc/system line 1: not start PATH [ARG ...]")))

(def test_volume_of_uuid () int
  (let ms (cons (MountInfo "/" 0 "")
            (cons (MountInfo "/Volumes/data" 5 "018f0000-0000-7000-8000-000000000002")
                  (cons (MountInfo "/Volumes/System" 5 "018F0000-0000-7000-8000-00000000000A") (nil MountInfo))))
    (add (check_str "System" (volume_of_uuid ms (sys_uuid)) "/Volumes/System")
         (check_str "none" (volume_of_uuid ms "018f0000-0000-7000-8000-000000000009") ""))))

(def test_rooted_line () int
  (add (check_str "made /" (rooted_line (sys_uuid) (Rooted "/Volumes/System")) "boot: / is /Volumes/System\n")
       (add (check_str "not" (rooted_line (sys_uuid) (NotRooted "no volume x is mounted"))
                       "boot: no volume x is mounted; starting the initramfs's system\n")
            (check_str "no root=" (rooted_line "" (NotRooted "")) ""))))

; Under an operating system no fs has registered, and no volume is
; mounted: the last try finds none.
(def test_volume_waited_none () int
  (add (check_bool "no fs" (fs_registered) false)
       (check_str "no volume" (volume_waited (sys_uuid) 0) "")))

; Under an operating system there is no kernel: no boot argument, so no
; volume is asked for, and no /etc/system to start.
(def test_no_kernel () int
  (check_int "fails" (boot) 1))

(def test_root_tmpfs () int
  (add (check_str "root=tmpfs names the RAM file system's UUID" (root_volume (root_uuid (split_spaces "root=tmpfs"))) (tmpfs_uuid))
       (add (check_str "a UUID is itself" (root_volume (sys_uuid)) (sys_uuid))
            (check_str "none" (root_volume "") ""))))

; The RAM file system's volume is waited for by itself: under an
; operating system there is none, and the last try finds none.
(def test_volume_waited_for () int
  (check_str "none" (volume_waited_for (tmpfs_uuid) 0) ""))

(def test_installed () int
  (add (check_str "exited 0" (installed (Reaped 0)) "")
       (add (check_str "exited 1" (installed (Reaped 1)) "install exited with 1")
            (check_str "gone" (installed (WaitNoProc)) "install is gone"))))

; Under an operating system no RAM file system is mounted, so there is
; nothing to copy onto.
(def test_tmpfs_filled_none () int
  (check_str "no volume" (tmpfs_filled (tmpfs_uuid)) "no RAM file system is mounted; is fs ram started?"))
