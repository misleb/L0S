; usb-hid_test.l0 -- the driver's state, handled without a usb server.

; A keyboard driver whose usb server is pid 3, with device 7's keyboard,
; at endpoint 0x81, holding nothing.
(def kbd () Hid (Hid (Keyboards) 10 11 3 (nil int) (cons (Board 7 129 (held_none)) (nil Board)) 0 (NoRepeat) (nil Message)))

(def report_msg ((bytes (list int))) Message (Message 3 (usb_report_notice (UsbReport 7 129 bytes))))

(def keys ((u int) (mods int)) (list int) (cons mods (cons 0 (cons u (zeros 5)))))

(def mods_of ((h Hid)) int (match h ((Hid k port usb pid ls bs mods r kept) mods)))

(def repeat_code ((h Hid)) int (match (hid_repeat h) ((Repeating c at) c) ((NoRepeat) 0)))

(def test_kinds () int
  (add (check_bool "keyboard" (eq (kind_of (split_spaces "keyboard")) (Some (Keyboards))) true)
       (add (check_bool "mouse" (eq (kind_of (split_spaces "mouse")) (Some (Mice))) true)
            (check_bool "other" (eq (kind_of (split_spaces "tablet")) ((None Kind))) true))))

(def test_names () int
  (add (check_str "keyboard" (kind_name (Keyboards)) "keyboard")
       (check_str "pointer" (kind_name (Mice)) "pointer")))

; Shift held, by the modifier byte's bit 1: the modifiers say so.
(def test_shift_report () int
  (check_int "left shift" (mods_of (handled (kbd) (report_msg (keys 0 2)))) 1))

; a pressed repeats; let go, it stops.
(def test_repeat () int
  (let h (handled (kbd) (report_msg (keys 4 0)))
    (add (check_int "a repeats" (repeat_code h) 30)
         (check_int "let go" (repeat_code (handled h (report_msg (keys 0 0)))) 0))))

; Unplugged with a key held: let go, and the device forgotten.
(def test_unplugged () int
  (let h (handled (handled (kbd) (report_msg (keys 4 0))) (Message 3 (usb_detach_notice 7)))
    (add (check_int "no repeat" (repeat_code h) 0)
         (check_bool "forgotten" (eq (board_of h 7) ((None Board))) true))))

; A report of another device is passed over.
(def test_other_device () int
  (check_int "nothing" (repeat_code (handled (kbd) (Message 3 (usb_report_notice (UsbReport 8 129 (keys 4 0)))))) 0))

; A message from anyone else is a request, not a notice.
(def test_not_from_usb () int
  (check_int "passed over" (repeat_code (handled (kbd) (Message 4 (usb_report_notice (UsbReport 7 129 (keys 4 0)))))) 0))

(def test_is_notice () int
  (add (check_bool "uin" (is_notice (usb_report_notice (UsbReport 7 129 (nil int)))) true)
       (add (check_bool "ok" (is_notice "ok") false)
            (check_bool "error" (is_notice "error: stall") false))))

; Under an operating system there is no usb server.
(def test_no_usb () int
  (check_int "fails" (usb_hid) 1))
