; audio_test.l0 -- the audio server, with no kernel beneath.

; Under an operating system there is no kernel to register audio with.
(def test_entry () int
  (check_int "fails" (audio) 1))

; Without a kernel the chime's file is not there: none, silently.
(def test_chime_loaded () int
  (check_bool "off" (eq (chime_loaded (settings_default)) (ChimeOff)) true))

; A stream of a pid's, or not: no such stream, and not the asker's.
(def test_stream_of () int
  (let s (srv_stream (srv_new 1 2 (settings_default) (ChimeOff))
           (stream_new 1 (.rate (dev_new 1 (AudiodevAttach 12 "hdmi0" false 2 (cons 48000 (nil int)) 0) 7 100) 48000) 9 (PcmFormat 48000 2 2) (FromClient)))
    (add (check_str "none" (match (stream_of s 9 2) ((Ok st) "ok") ((Err why) why)) "no such stream")
         (add (check_str "other" (match (stream_of s 8 1) ((Ok st) "ok") ((Err why) why)) "not your stream")
              (check_str "own" (match (stream_of s 9 1) ((Ok st) "ok") ((Err why) why)) "ok")))))
