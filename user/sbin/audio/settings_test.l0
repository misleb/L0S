; settings_test.l0 -- /etc/audio read.

(def read_or ((text (list int))) Settings
  (match (settings_of text) ((Ok s) s) ((Err why) (settings_default))))
(def why_of ((text (list int))) (list int)
  (match (settings_of text) ((Ok s) "ok") ((Err why) why)))

; Every key, a comment and a blank line, and one another program's.
(def test_settings () int
  (let s (read_or "# sound\noutput hdmi0\n\ninput usb-046d:0acf-microphone\nvolume hdmi0 40\nchime off\nfoo bar\n")
    (add (check_str "output" (.output s) "hdmi0")
         (add (check_str "input" (.input s) "usb-046d:0acf-microphone")
              (add (check_int "volume" (settings_volume s "hdmi0") 40)
                   (check_bool "chime" (.chime s) false))))))

; Nothing said: no names, 100, the chime on.
(def test_settings_default () int
  (let s (read_or "")
    (add (check_str "output" (.output s) "")
         (add (check_int "volume" (settings_volume s "hdmi0") 100)
              (check_bool "chime" (.chime s) true)))))

; A line wrong fails the whole, saying how.
(def test_settings_wrong () int
  (add (check_str "values" (why_of "output a b\n") "output takes one value")
       (add (check_str "pct" (why_of "volume hdmi0 101\n") "a volume is 0 to 100")
            (check_str "chime" (why_of "chime maybe\n") "chime is on or off"))))

; The boot argument chime=off wins over the file's on.
(def test_settings_chime () int
  (add (check_bool "on" (settings_chime (read_or "") (nil (list int))) true)
       (check_bool "off" (settings_chime (read_or "") (cons "chime=off" (nil (list int)))) false)))

; Under an operating system there is no /etc/audio: the defaults.
(def test_settings_read () int
  (check_bool "default" (match (settings_read) ((Ok s) (eq s (settings_default))) ((Err why) false)) true))
