; settings.l0 -- the audio server's settings, /etc/audio, read purely
; from its text, and from the file, which the server reads as it
; starts and again when asked to reload:
;
;   # a comment
;   output NAME       the default output, by the name its driver gave
;                     it (hdmi0, usb-046d:0acf-speaker); the first
;                     output attached if none, or if it is not there
;   input NAME        the default input, the same way
;   volume NAME PCT   a device's volume, 0 to 100; 100 if none
;   chime off         no chime as the first output comes; on is the
;                     default, and so is the boot argument chime=off
;
; A key not known is passed over, so another program's lines may share
; the file; a line of a key known that is wrong fails the whole.

; The settings: the default output's and input's names, empty for none;
; each device's volume by name; and whether the chime plays.
(data Settings (Settings (output (list int)) (input (list int)) (volumes (Map (list int) int)) (chime bool)))

; Where they are.
(def settings_path () (list int) "/etc/audio")

; The settings with nothing said: no defaults named, every volume 100,
; the chime on.
(def settings_default () Settings (Settings "" "" ((MapEmpty (list int) int)) true))

; Device name's volume in s: as set, or 100.
(def settings_volume ((s Settings) (name (list int))) int
  (match (map_get (.volumes s) name) ((Some v) v) ((None) 100)))

; The settings text says, or why not: a line each, a # starting a
; comment.
(def settings_of ((text (list int))) (Result Settings (list int))
  (settings_lines (lines text) (settings_default)))

; settings_of's loop: the lines ls read onto s so far.
(def settings_lines ((ls (list (list int))) (s Settings)) (Result Settings (list int))
  (if (is_empty ls)
      ((Ok Settings (list int)) s)
      (let ws (split_spaces (up_to 35 (strip_cr (head ls))))
        (if (is_empty ws)
            (settings_lines (tail ls) s)
            (match (settings_line (head ws) (tail ws) s)
              ((Err why) ((Err Settings (list int)) why))
              ((Ok s2) (settings_lines (tail ls) s2)))))))

; s with the line KEY VALUE... read: or why the line is wrong.
(def settings_line ((key (list int)) (vs (list (list int))) (s Settings)) (Result Settings (list int))
  (if (not (any_eq key (split_spaces "output input volume chime"))) ((Ok Settings (list int)) s)
      (eq key "volume") (settings_volume_line vs s)
      (not (eq (length vs) 1)) ((Err Settings (list int)) (append key " takes one value"))
      (eq key "output") ((Ok Settings (list int)) (.output s (head vs)))
      (eq key "input") ((Ok Settings (list int)) (.input s (head vs)))
      (any_eq (head vs) (split_spaces "on off")) ((Ok Settings (list int)) (.chime s (eq (head vs) "on")))
      ((Err Settings (list int)) "chime is on or off")))

; s with a volume line's NAME PCT: or why not.
(def settings_volume_line ((vs (list (list int))) (s Settings)) (Result Settings (list int))
  (if (not (eq (length vs) 2))
      ((Err Settings (list int)) "volume takes NAME PCT")
      (match (word_number (nth vs 1))
        ((None) ((Err Settings (list int)) (append "not a number: " (nth vs 1))))
        ((Some pct)
          (if (or (lt pct 0) (gt pct 100))
              ((Err Settings (list int)) "a volume is 0 to 100")
              ((Ok Settings (list int)) (.volumes s (map_put (.volumes s) (head vs) pct))))))))

; The settings from their file: the defaults if there is none, or why
; its text is wrong, naming the file.
(def settings_read () (Result Settings (list int))
  (match (read_whole (settings_path))
    ((Err why) ((Ok Settings (list int)) (settings_default)))
    ((Ok b)
      (match (settings_of (bytes_to_list b))
        ((Ok s) ((Ok Settings (list int)) s))
        ((Err why) ((Err Settings (list int)) (append (settings_path) (append ": " why))))))))

; Whether the chime plays: s says on, and the boot arguments args do
; not say chime=off.
(def settings_chime ((s Settings) (args (list (list int)))) bool
  (and (.chime s) (not (any_eq "chime=off" args))))
