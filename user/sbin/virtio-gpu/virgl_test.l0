; Tests of the bytes of 3D mode: each command's size, and where its
; fields are, from virtio 1.2's structs and virgl_protocol.h's copy.

(def test_header_ctx () int
  (let b (bytes_from_list (header_ctx 519 1))
    (add (check_int "24 bytes" (bytes_len b) 24)
         (add (check_int "type" (le_u32 b 0) 519)
              (check_int "ctx_id" (le_u32 b 16) 1)))))

(def test_ctx_create () int
  (let b (bytes_from_list (ctx_create 1 "l0s"))
    (add (check_int "24, 8 and a 64 byte name" (bytes_len b) 96)
         (add (check_int "type" (le_u32 b 0) 512)
              (add (check_int "ctx_id" (le_u32 b 16) 1)
                   (add (check_int "name length" (le_u32 b 24) 3)
                        (check_int "the name's bytes" (le_u32 b 32) 7549036)))))))   ; l, 0, s, 0: 0x6c + 0x30 * 256 + 0x73 * 65536

(def test_ctx_attach_detach () int
  (let a (bytes_from_list (ctx_attach 18))
    (let d (bytes_from_list (ctx_detach 18))
      (add (check_int "32 bytes" (bytes_len a) 32)
           (add (check_int "attach type" (le_u32 a 0) 514)
                (add (check_int "resource" (le_u32 a 24) 18)
                     (add (check_int "in context 1" (le_u32 a 16) 1)
                          (check_int "detach type" (le_u32 d 0) 515))))))))

(def test_resource_unref () int
  (let b (bytes_from_list (resource_unref 18))
    (add (check_int "32 bytes" (bytes_len b) 32)
         (add (check_int "type" (le_u32 b 0) 258)
              (check_int "resource" (le_u32 b 24) 18)))))

(def test_resource_create_3d () int
  (let b (bytes_from_list (resource_create_3d 17 2 (bind_texture) 640 400))
    (add (check_int "72 bytes" (bytes_len b) 72)
         (add (check_int "type" (le_u32 b 0) 516)
              (add (check_int "resource" (le_u32 b 24) 17)
                   (add (check_int "target, 2D" (le_u32 b 28) 2)
                        (add (check_int "format" (le_u32 b 32) 2)
                             (add (check_int "bind" (le_u32 b 36) 10)
                                  (add (check_int "width" (le_u32 b 40) 640)
                                       (add (check_int "height" (le_u32 b 44) 400)
                                            (add (check_int "depth" (le_u32 b 48) 1)
                                                 (check_int "array size" (le_u32 b 52) 1))))))))))))

; The screen's bind adds the scanout bit, 1 << 18, to a texture's.
(def test_binds () int
  (check_int "scanout" (bit_and (bind_scanout) 262144) 262144))

(def test_transfer_to_host_3d () int
  (let b (bytes_from_list (transfer_to_host_3d 17 8 16 32 4 82080 2560))
    (add (check_int "72 bytes" (bytes_len b) 72)
         (add (check_int "type" (le_u32 b 0) 517)
              (add (check_int "ctx_id" (le_u32 b 16) 1)
                   (add (check_int "x" (le_u32 b 24) 8)
                        (add (check_int "y" (le_u32 b 28) 16)
                             (add (check_int "w" (le_u32 b 36) 32)
                                  (add (check_int "h" (le_u32 b 40) 4)
                                       (add (check_int "d" (le_u32 b 44) 1)
                                            (add (check_int "offset" (le_u32 b 48) 82080)
                                                 (add (check_int "resource" (le_u32 b 56) 17)
                                                      (check_int "stride" (le_u32 b 64) 2560)))))))))))))

(def test_submit_3d_head () int
  (let b (bytes_from_list (submit_3d_head 56))
    (add (check_int "32 bytes" (bytes_len b) 32)
         (add (check_int "type" (le_u32 b 0) 519)
              (add (check_int "ctx_id" (le_u32 b 16) 1)
                   (check_int "size in bytes" (le_u32 b 24) 56))))))

; 17, resource copy region, and 13 words after: 17 + 13 * 65536.
(def test_virgl_cmd () int
  (check_int "the command word" (virgl_cmd 17 13) 851985))

(def test_copy_region () int
  (let ws (copy_region 1 10 20 17 3 4 30 40)
    (add (check_int "14 words" (length ws) 14)
         (add (check_int "command" (nth ws 0) 851985)
              (add (check_int "dst" (nth ws 1) 1)
                   (add (check_int "dst x" (nth ws 3) 10)
                        (add (check_int "dst y" (nth ws 4) 20)
                             (add (check_int "src" (nth ws 6) 17)
                                  (add (check_int "src x" (nth ws 8) 3)
                                       (add (check_int "src y" (nth ws 9) 4)
                                            (add (check_int "w" (nth ws 11) 30)
                                                 (add (check_int "h" (nth ws 12) 40)
                                                      (check_int "depth" (nth ws 13) 1)))))))))))))
