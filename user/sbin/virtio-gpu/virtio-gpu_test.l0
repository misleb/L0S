; ---------------------------------------------------------------- commands

(def test_header () int
  (let b (bytes_from_list (header 261))
    (add (check_int "24 bytes" (bytes_len b) 24)
         (check_int "type" (le_u32 b 0) 261))))

(def test_resource_create_2d () int
  (let b (bytes_from_list (resource_create_2d 2 1 64 64))
    (add (check_int "40 bytes" (bytes_len b) 40)
         (add (check_int "resource" (le_u32 b 24) 2)
              (add (check_int "format" (le_u32 b 28) 1)
                   (check_int "height" (le_u32 b 36) 64))))))

(def test_set_scanout () int
  (let b (bytes_from_list (set_scanout 1280 800))
    (add (check_int "48 bytes" (bytes_len b) 48)
         (add (check_int "width" (le_u32 b 32) 1280)
              (check_int "resource" (le_u32 b 44) 1)))))

(def test_transfer_rect () int
  (let b (bytes_from_list (transfer_to_host_2d_at 2 8 16 8 16 81952))
    (add (check_int "56 bytes" (bytes_len b) 56)
         (add (check_int "x" (le_u32 b 24) 8)
              (add (check_int "offset" (le_u32 b 40) 81952)
                   (check_int "resource" (le_u32 b 48) 2))))))

(def test_flush () int
  (check_int "48 bytes" (length (resource_flush_at 0 0 4 2)) 48))

(def test_attach_backing () int
  (let b (bytes_from_list (attach_backing 1 (cons (VirtqRun 2550136832 8192) (cons (VirtqRun 4096 4096) (nil VirtqRun)))))
    (add (check_int "header, id, count, 2 entries" (bytes_len b) 64)
         (add (check_int "count" (le_u32 b 28) 2)
              (add (check_int "first address" (le_u32 b 32) 2550136832)
                   (check_int "second length" (le_u32 b 56) 4096))))))

(def test_detach_backing () int
  (let b (bytes_from_list (detach_backing 2))
    (add (check_int "32 bytes" (bytes_len b) 32)
         (check_int "resource" (le_u32 b 24) 2))))

(def test_cursor_cmd () int
  (let b (bytes_from_list (cursor_cmd (cmd_update_cursor) 100 200 3 4))
    (add (check_int "56 bytes" (bytes_len b) 56)
         (add (check_int "type" (le_u32 b 0) 768)
              (add (check_int "x" (le_u32 b 28) 100)
                   (add (check_int "resource" (le_u32 b 40) 2)
                        (check_int "hot y" (le_u32 b 48) 4)))))))

; ---------------------------------------------------------------- runs

(def run_text ((runs (list VirtqRun))) (list int)
  (if (is_empty runs)
      ""
      (match (head runs)
        ((VirtqRun a n) (append (digits a) (append "+" (append (digits n) (append " " (run_text (tail runs))))))))))

(def test_pages_contiguous () int
  (check_str "one run" (run_text (pages_runs (array_from (cons 4096 (cons 8192 (cons 12288 (nil int)))) 0))) "4096+12288 "))

(def test_pages_gaps () int
  (check_str "three runs" (run_text (pages_runs (array_from (cons 8192 (cons 4096 (cons 16384 (nil int)))) 0)))
             "8192+4096 4096+4096 16384+4096 "))

(def sample_addrs () (array int)
  (array_from (cons 40960 (cons 81920 (cons 12288 (cons 20480 (nil int))))) 0))

; 5000 bytes from 8192, page 2, are 4096 there and 904 on page 3, which
; the device sees elsewhere: two descriptors, then the response's.
(def test_descriptors () int
  (let b (bytes_from_list (descriptors 8192 5000 (sample_addrs) 4096 24))
    (add (check_int "three descriptors" (bytes_len b) 48)
         (add (check_int "first address" (le_u32 b 0) 12288)
              (add (check_int "first flags, next" (le_u32 b 12) 65537)   ; NEXT, then 1
                   (check_int "response flags" (le_u32 b 44) 2))))))

; ----------------------------------------------------------- the backing

; A desktop, buffer 0, 4 by 2 on one page at 1000000; a window, buffer 1,
; 2 by 1 on one page at 2000000. Where the driver maps them doesn't
; matter here.
(def bufs () (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer)) 0 (Buffer 4 2 (array_from (cons 1000000 (nil int)) 0) 0 (square)))
           1 (Buffer 2 1 (array_from (cons 2000000 (nil int)) 0) 0 (square))))

(def test_in_layers () int
  (add (check_bool "the window" (in_layers (cons (desktop) (cons (Layer 1 1 0 0) (nil Layer))) 1) true)
       (check_bool "not on the screen" (in_layers (cons (desktop) (nil Layer)) 1) false)))

(def test_cursor_buffer () int
  (add (check_int "none yet" (cursor_buffer (Cursor false 0 0 0 0 -1)) -1)
       (check_int "buffer 3" (cursor_buffer (Cursor true 5 5 0 0 3)) 3)))

(def desktop () Layer (Layer 0 0 0 0))

(def backing ((ls (list Layer))) (list int)
  (run_text (backing_runs 4 2 ls (bufs) 9000000)))

(def test_backing_desktop () int
  (check_str "both rows, one run" (backing (cons (desktop) (nil Layer))) "1000000+32 "))

(def test_backing_window () int
  (check_str "the window's two pixels between the desktop's"
    (backing (cons (desktop) (cons (Layer 1 1 0 0) (nil Layer))))
    "1000000+4 2000000+8 1000012+20 "))

(def test_backing_ring () int
  (check_str "the second row first" (backing (cons (Layer 0 0 0 1) (nil Layer))) "1000016+16 1000000+16 "))

(def test_backing_black () int
  (check_str "the zero page, a row at a time" (backing (nil Layer)) "9000000+16 9000000+16 "))

(def test_backing_off_screen () int
  (check_str "the window's second pixel, at column 0"
    (backing (cons (desktop) (cons (Layer 1 -1 1 0) (nil Layer))))
    "1000000+16 2000004+4 1000020+12 "))

(def test_backing_window_on_top () int
  (check_str "the upper layer wins"
    (backing (cons (desktop) (cons (Layer 1 0 0 0) (cons (Layer 1 1 0 0) (nil Layer)))))
    "2000000+4 2000000+8 1000012+20 "))

(def test_backing_pages () int
  (let wide (map_put ((MapEmpty int Buffer)) 0 (Buffer 1024 2 (array_from (cons 10000 (cons 50000 (nil int))) 0) 0 (square)))
    (check_str "a page a row" (run_text (backing_runs 1024 2 (cons (Layer 0 0 0 0) (nil Layer)) wide 0))
               "10000+4096 50000+4096 ")))

(def test_backing_cut_in_a_page () int
  (let wide (map_put ((MapEmpty int Buffer)) 0 (Buffer 1536 1 (array_from (cons 10000 (cons 50000 (nil int))) 0) 0 (square)))
    (check_str "where the page ends" (run_text (backing_runs 1536 1 (cons (Layer 0 0 0 0) (nil Layer)) wide 0))
               "10000+4096 50000+2048 ")))

(def test_backing_size () int
  (let n (length (backing_runs 1280 800 (cons (Layer 0 0 0 0) (nil Layer))
                               (map_put ((MapEmpty int Buffer)) 0 (Buffer 1280 800 (array_new 1000 0) 0 (square))) 0))
    (check_true "a screen in runs, under the limit" (le n (max_runs)))))

; ---------------------------------------------------------------- damage

; Each box by its corners, x0,y0-x1,y1, the second past its last pixel;
; an empty one not at all.
(def boxes_text ((ds (list Rect))) (list int)
  (if (is_empty ds)
      ""
      (if (rect_empty (head ds))
          (boxes_text (tail ds))
          (match (head ds) ((Rect x y w h) (append (box_text x y (add x w) (add y h)) (boxes_text (tail ds))))))))

(def box_text ((x0 int) (y0 int) (x1 int) (y1 int)) (list int)
  (append (digits x0) (append "," (append (digits y0) (append "-" (append (digits x1) (append "," (append (digits y1) " "))))))))

(def test_damage_plain () int
  (check_str "at the layer's place"
    (boxes_text (damage_boxes (cons (Layer 3 5 10 0) (nil Layer)) 3 20 1 2 3 3)) "6,12-9,15 "))

(def test_damage_ring () int
  (check_str "two boxes where it wraps"
    (boxes_text (damage_boxes (cons (Layer 3 5 10 5) (nil Layer)) 3 20 1 2 3 5)) "6,27-9,30 6,10-9,12 "))

(def test_damage_other_buffer () int
  (check_str "none" (boxes_text (damage_boxes (cons (Layer 3 5 10 0) (nil Layer)) 4 20 0 0 1 1)) ""))

; Boxes that overlap are shown as one by rect.l0's rect_merge, tested
; there.

; ---------------------------------------------------------------- shapes

; A corner's cut is render.l0's corner_cut, tested there.

(def test_fits_radius () int
  (add (check_bool "half the width" (corners_fit (Corners 15 0 0 15) 30 40) true)
       (add (check_bool "more than half the height" (corners_fit (Corners 0 11 0 0) 40 21) false)
            (check_bool "negative" (corners_fit (Corners 0 0 -1 0) 40 40) false))))

(def seg_text ((s Seg)) (list int)
  (match s
    ((Bare x0 x1) (append "b" (append (digits x0) (append "-" (digits x1)))))
    ((Owned x0 x1 l) (append "o" (append (digits (layer_id l)) (append ":" (append (digits x0) (append "-" (digits x1)))))))))

(def segs_text ((ss (list Seg))) (list int)
  (if (is_empty ss) "" (append (seg_text (head ss)) (append " " (segs_text (tail ss))))))

; A desktop, buffer 0, 40 by 40, and a window, buffer 1, 30 by 30, its top
; left and bottom right corners rounded to 12, at 5, 5 on a screen 40 by
; 40.
(def shaped_bufs ((cs Corners)) (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer)) 0 (Buffer 40 40 (array_new 2 0) 0 (square)))
           1 (Buffer 30 30 (array_new 1 0) 0 cs)))

(def shaped_layers () (list Layer) (cons (desktop) (cons (Layer 1 5 5 0) (nil Layer))))

(def shaped_row ((y int)) (list int)
  (segs_text (row_segs 40 y (shaped_layers) (shaped_bufs (Corners 12 0 0 12)) (cons (Bare 0 40) (nil Seg)))))

(def test_shaped_top_row () int
  (check_str "9 cut at the left, the desktop showing there" (shaped_row 5) "o0:0-14 o1:14-35 o0:35-40 "))

(def test_shaped_middle_row () int
  (check_str "the whole width" (shaped_row 20) "o0:0-5 o1:5-35 o0:35-40 "))

(def test_shaped_bottom_row () int
  (check_str "9 cut at the right" (shaped_row 34) "o0:0-5 o1:5-26 o0:26-40 "))

(def test_shaped_backing () int
  (let round (map_put (map_put ((MapEmpty int Buffer)) 0 (Buffer 4 4 (array_from (cons 1000000 (nil int)) 0) 0 (square)))
                      1 (Buffer 4 4 (array_from (cons 2000000 (nil int)) 0) 0 (Corners 2 2 2 2)))
    (check_str "each corner pixel the desktop's"
      (run_text (backing_runs 4 4 (cons (desktop) (cons (Layer 1 0 0 0) (nil Layer))) round 0))
      "1000000+4 2000004+8 1000012+4 2000016+32 1000048+4 2000052+8 1000060+4 ")))

; Ten windows of 400 by 300, every corner rounded, over a desktop, every
; page of each apart from the next.
(def apart ((n int)) (array int) (apart_from (array_new n 0) 0))

(def apart_from ((a (array int)) (i int)) (array int)
  (if (eq i (array_len a)) a (apart_from (array_set a i (mul (add i 1) 65536)) (add i 1))))

(def windows_bufs ((m (Map int Buffer)) (i int)) (Map int Buffer)
  (if (gt i 10) m (windows_bufs (map_put m i (Buffer 400 300 (apart 118) 0 (Corners 12 12 12 12))) (add i 1))))

(def windows_layers ((i int) (acc (list Layer))) (list Layer)
  (if (gt i 10) (rev acc) (windows_layers (add i 1) (cons (Layer i (mul i 80) (mul i 45) 0) acc))))

(def test_shaped_backing_size () int
  (let bufs (windows_bufs (map_put ((MapEmpty int Buffer)) 0 (Buffer 1280 800 (apart 1000) 0 (square))) 1)
    (let n (length (backing_runs 1280 800 (cons (desktop) (windows_layers 1 (nil Layer))) bufs 0))
      (check_true "rounded windows, under the limit" (le n (max_runs))))))

; -------------------------------------------------------------- restacks

; A desktop, buffer 0, 8 by 6, and a window, buffer 1, 2 by 2.
(def restack_bufs () (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer)) 0 (Buffer 8 6 (array_new 1 0) 0 (square)))
           1 (Buffer 2 2 (array_new 1 0) 0 (square))))

(def window_at ((x int) (y int)) (list Layer) (cons (desktop) (cons (Layer 1 x y 0) (nil Layer))))

(def test_restack_moved () int
  (check_str "where it was, and where it is"
    (boxes_text (restack_damage 8 6 (window_at 1 0) (restack_bufs) (window_at 5 4) (restack_bufs)))
    "1,0-3,2 5,4-7,6 "))

(def test_restack_moved_down () int
  (check_str "rows that differ next to each other, one band"
    (boxes_text (restack_damage 8 6 (window_at 1 0) (restack_bufs) (window_at 4 1) (restack_bufs)))
    "1,0-6,3 "))

(def test_restack_unchanged () int
  (check_str "nothing" (boxes_text (restack_damage 8 6 (window_at 1 0) (restack_bufs) (window_at 1 0) (restack_bufs))) ""))

(def test_restack_scrolled () int
  (check_str "a new top shows its whole layer"
    (boxes_text (restack_damage 8 6 (window_at 1 0) (restack_bufs)
                                (cons (desktop) (cons (Layer 1 1 0 1) (nil Layer))) (restack_bufs)))
    "1,0-3,2 "))

(def test_restack_shape () int
  (check_str "the corners' rows, from the first corner cut to the last"
    (boxes_text (restack_damage 40 40 (shaped_layers) (shaped_bufs (square)) (shaped_layers) (shaped_bufs (Corners 12 0 0 12))))
    "5,5-14,14 26,26-35,35 "))

(def test_restack_new_buffer () int
  (check_str "the layer whose buffer was shared again"
    (boxes_text (restack_damage 8 6 (window_at 1 0) (restack_bufs) (window_at 1 0)
                                (map_put (restack_bufs) 1 (Buffer 2 2 (array_new 1 4096) 0 (square)))))
    "1,0-3,2 "))

; Under an operating system there are no transports to drive.
(def test_no_device () int
  (check_int "fails" (virtio_gpu) 1))

; ---------------------------------------------------------- cached rows

; A run's words, as little-endian bytes, are attach_backing's entry.
(def words_bytes ((ws (list int))) (list int)
  (if (is_empty ws) (nil int) (append (u32_le (head ws)) (words_bytes (tail ws)))))

(def test_run_words () int
  (let r (VirtqRun 4294971392 8192)                      ; 0x100001000, past 32 bits
    (add (check_strs "the words" (map_digits (run_words r)) (split_spaces "4096 1 8192 0"))
         (check_bool "attach_backing's bytes" (eq (words_bytes (run_words r)) (rev (push_runs (cons r (nil VirtqRun)) (nil int)))) true))))

(def map_digits ((ns (list int))) (list (list int))
  (if (is_empty ns) (nil (list int)) (cons (digits (head ns)) (map_digits (tail ns)))))

(def marked ((d (array bool)) (i int)) (list int)
  (if (ge i (array_len d)) "" (append (if (array_get d i) "x" ".") (marked d (add i 1)))))

; The window, 2 rows high, moved from row 0 to row 4: rows 0, 1, 4 and 5.
(def test_dirty_moved () int
  (check_str "where it was and is" (marked (dirty_rows 6 (window_at 1 0) (restack_bufs) (window_at 5 4) (restack_bufs)) 0) "xx..xx"))

(def test_dirty_unchanged () int
  (check_str "none" (marked (dirty_rows 6 (window_at 1 0) (restack_bufs) (window_at 1 0) (restack_bufs)) 0) "......"))

(def test_dirty_raised () int
  (check_str "another order, every row"
    (marked (dirty_rows 6 (window_at 1 0) (restack_bufs) (cons (Layer 1 1 0 0) (cons (desktop) (nil Layer))) (restack_bufs)) 0)
    "xxxxxx"))

; The window is 30 rows from row 5: rows 5 to 34.
(def test_dirty_buffer () int
  (check_str "a buffer's corners changed, its rows"
    (marked (dirty_rows 40 (shaped_layers) (shaped_bufs (square)) (shaped_layers) (shaped_bufs (Corners 12 0 0 12))) 0)
    ".....xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx....."))

(def test_dirty_off_screen () int
  (check_str "only the rows on the screen"
    (marked (dirty_rows 6 (window_at 1 -1) (restack_bufs) (window_at 1 5) (restack_bufs)) 0) "x....x"))

; A desktop 64 by 40 of its own pages and two windows, every page apart,
; one rounded: moved about at random, each restack from the rows the one
; before left must give the backing and damage that building every row
; again gives.
(def prop_bufs () (Map int Buffer)
  (map_put (map_put (map_put ((MapEmpty int Buffer)) 0 (Buffer 64 40 (apart 3) 0 (square)))
                    1 (Buffer 20 12 (apart 1) 0 (Corners 4 4 4 4)))
           2 (Buffer 30 9 (apart 1) 0 (square))))

(def prop_layers ((s int)) (list Layer)
  (let x1 (sub (rand_below s 90) 13)
    (let s2 (rand_next s)
      (let y1 (sub (rand_below s2 56) 8)
        (let s3 (rand_next s2)
          (let x2 (sub (rand_below s3 90) 13)
            (let s4 (rand_next s3)
              (cons (desktop) (cons (Layer 1 x1 y1 (rand_below s4 12)) (cons (Layer 2 x2 (sub (rand_below (rand_next s4) 56) 8) 0) (nil Layer)))))))))))

(def all_dirty ((r Restack) (rows (array Row))) Restacked
  (match r ((Restack w h ols obufs nls nbufs ids) (update_rows r (array_new h true) 0 rows 0 (rect_none) (nil Rect)))))

(def prop_steps ((s int) (n int) (ls (list Layer)) (rows (array Row)) (bad int)) int
  (if (eq n 0)
      bad
      (let nls (prop_layers s)
        (let r (Restack 64 40 ls (prop_bufs) nls (prop_bufs) (nil int))
          (match (all_dirty r (screen_rows 64 40 ls (prop_bufs) 0))
            ((Restacked full want)
              (match (rows_restacked r 0 rows)
                ((Restacked rows2 got)
                  (prop_steps (rand_next (rand_next (rand_next (rand_next (rand_next s))))) (sub n 1) nls rows2
                              (add bad (add (if (eq (rows_runs rows2) (backing_runs 64 40 nls (prop_bufs) 0)) 0 1)
                                            (if (eq got want) 0 1))))))))))))

(def test_cached_rows_agree () int
  (check_int "restacks that differ from a full rebuild"
    (prop_steps 7 300 (prop_layers 1) (screen_rows 64 40 (prop_layers 1) (prop_bufs) 0) 0) 0))
