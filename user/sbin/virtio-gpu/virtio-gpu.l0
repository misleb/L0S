; virtio-gpu.l0 -- a display driver for QEMU's virtio-gpu, serving the
; hardware-neutral display protocol, user/lib/display.l0, that the
; compositor, user/wm, draws the screen through. Its module must be
; flagged dev.
;
; Clients share buffers of pixels with it, and say how to stack them
; into the screen: layers. It does the rest with what virtio-gpu's 2D
; mode does itself, never copying a pixel:
;
; - The screen is resource 1, and its backing, the memory the device
;   copies it from, is built from the layers: each screen row as runs of
;   the topmost buffer's own pages, so the host gathers the screen out
;   of the clients' memory. A buffer's rows may be read from any row as a
;   ring, so scrolling one costs no copying either. The driver keeps
;   every row as the backing has it, so a restack builds again only the
;   rows a layer that moved, scrolled or changed covers, and compares
;   only those with what they were to find what to show again.
; - A damaged rectangle is a transfer and a flush of just that part.
; - The pointer is the device's own cursor, resource 2, a 64 by 64 image
;   moved on the cursor queue.

(def gpu_device () int 16)          ; DeviceID of a GPU

; --------------------------------------------------------------- commands

; virtio-gpu's command and response types (virtio 1.2, section 5.7.6.7).
(def cmd_get_display_info () int 256)    ; 0x0100
(def cmd_resource_create_2d () int 257)
(def cmd_set_scanout () int 259)
(def cmd_resource_flush () int 260)
(def cmd_transfer_to_host_2d () int 261)
(def cmd_resource_attach_backing () int 262)
(def cmd_resource_detach_backing () int 263)
(def cmd_update_cursor () int 768)       ; 0x0300
(def cmd_move_cursor () int 769)
(def resp_ok_nodata () int 4352)         ; 0x1100
(def resp_ok_display_info () int 4353)   ; 0x1101

(def format_b8g8r8a8 () int 1)           ; b, g, r, then alpha: the cursor's
(def format_b8g8r8x8 () int 2)           ; b, g, r, then unused: the screen's
(def screen_res () int 1)
(def cursor_res () int 2)
(def cursor_size () int 64)

; virtio_gpu_ctrl_hdr: type, flags, fence_id, ctx_id, ring_idx and padding.
(def header ((type int)) (list int)
  (append (u32_le type) (append (u32_le 0) (append (le64 0) (append (u32_le 0) (u32_le 0))))))

(def rect ((w int) (h int)) (list int) (rect_at 0 0 w h))

(def rect_at ((x int) (y int) (w int) (h int)) (list int)
  (append (u32_le x) (append (u32_le y) (append (u32_le w) (u32_le h)))))

(def get_display_info () (list int) (header (cmd_get_display_info)))

(def display_info_len () int 408)        ; the header and 16 modes of 24 bytes

(def resource_create_2d ((id int) (format int) (w int) (h int)) (list int)
  (append (header (cmd_resource_create_2d))
    (append (u32_le id) (append (u32_le format) (append (u32_le w) (u32_le h))))))

(def set_scanout ((w int) (h int)) (list int)
  (append (header (cmd_set_scanout)) (append (rect w h) (append (u32_le 0) (u32_le (screen_res))))))

; Copies the rectangle at x, y, w by h, of resource id's backing to the
; device's own copy; off is where in the backing its top left pixel is.
(def transfer_to_host_2d_at ((id int) (x int) (y int) (w int) (h int) (off int)) (list int)
  (append (header (cmd_transfer_to_host_2d))
    (append (rect_at x y w h) (append (le64 off) (append (u32_le id) (u32_le 0))))))

(def resource_flush_at ((x int) (y int) (w int) (h int)) (list int)
  (append (header (cmd_resource_flush)) (append (rect_at x y w h) (append (u32_le (screen_res)) (u32_le 0)))))

(def attach_backing ((id int) (runs (list VirtqRun))) (list int)
  (append (header (cmd_resource_attach_backing))
    (append (u32_le id) (append (u32_le (length runs)) (rev (push_runs runs (nil int)))))))

(def push_runs ((runs (list VirtqRun)) (acc (list int))) (list int)
  (if (is_empty runs)
      acc
      (match (head runs)
        ((VirtqRun a n) (push_runs (tail runs) (push (append (le64 a) (append (u32_le n) (u32_le 0))) acc))))))

(def detach_backing ((id int)) (list int)
  (append (header (cmd_resource_detach_backing)) (append (u32_le id) (u32_le 0))))

; virtio_gpu_update_cursor: the header, the position (scanout, x, y), the
; cursor's resource, and its hot spot. Moving it takes the same, the
; resource and hot spot unread.
(def cursor_cmd ((type int) (x int) (y int) (hx int) (hy int)) (list int)
  (append (header type)
    (append (u32_le 0) (append (u32_le x) (append (u32_le y) (append (u32_le 0)
      (append (u32_le (cursor_res)) (append (u32_le hx) (append (u32_le hy) (u32_le 0))))))))))

; Every page whose device address is in addrs, as the fewest runs.
(def pages_runs ((addrs (array int))) (list VirtqRun)
  (rev (virtq_page_runs addrs 0 (mul (array_len addrs) (page_size)) (nil VirtqRun))))

; ------------------------------------------------------------ descriptors

; The descriptor table for a request of len bytes from off of the
; driver's memory, whose pages the device reaches at addrs, as runs
; chained in order from descriptor 0; then the response, which the device
; writes.
(def descriptors ((off int) (len int) (addrs (array int)) (resp_off int) (resp_len int)) (list int)
  (rev (push (descriptor (device_at addrs resp_off) resp_len (desc_write) 0)
             (virtq_push_chain (rev (virtq_page_runs addrs off len (nil VirtqRun))) (desc_next) 1 (nil int)))))

; ---------------------------------------------------------------- layers

; A buffer a client shared: its width and height in pixels, where the
; device reaches each of its pages, where this process does, and its
; corners.
(data Buffer (Buffer int int (array int) int Corners))

; The radii of a buffer's corners, top left, top right, bottom left and
; bottom right, in pixels: 0 is square. Where a corner is rounded off, the
; layer beneath shows, since the device cannot blend.
(data Corners (Corners int int int int))

(def square () Corners (Corners 0 0 0 0))

; How many pixels row by of a buffer bh high is cut at its left, and at its
; right, by its corners.
(def left_inset ((cs Corners) (bh int) (by int)) int
  (match cs ((Corners tl tr bl br) (max (corner_cut tl by) (corner_cut bl (sub (sub bh 1) by))))))

(def right_inset ((cs Corners) (bh int) (by int)) int
  (match cs ((Corners tl tr bl br) (max (corner_cut tr by) (corner_cut br (sub (sub bh 1) by))))))

; Whether r is a radius a buffer bw by bh can have: up to half of each.
(def fits_radius ((r int) (bw int) (bh int)) bool
  (if (lt r 0) false (if (gt (mul 2 r) bw) false (le (mul 2 r) bh))))

; A buffer on the screen: its id, its top left there, and the row of the
; buffer that is its top, its rows read from there as a ring.
(data Layer (Layer int int int int))

; Who shows at columns x0 up to x1 of a row: a layer, or nothing, black.
(data Seg (Owned int int Layer) (Bare int int))

(def seg_x0 ((s Seg)) int (match s ((Owned a b l) a) ((Bare a b) a)))
(def seg_x1 ((s Seg)) int (match s ((Owned a b l) b) ((Bare a b) b)))

; segs with columns a up to b given to layer l, over what was there.
(def overlay ((segs (list Seg)) (a int) (b int) (l Layer) (acc (list Seg))) (list Seg)
  (if (is_empty segs)
      (rev acc)
      (let s (head segs)
        (let x0 (seg_x0 s)
          (let x1 (seg_x1 s)
            (let left (if (lt x0 (min x1 a)) (cons (cut_seg s x0 (min x1 a)) acc) acc)
              (let mid (if (lt (max x0 a) (min x1 b)) (cons (Owned (max x0 a) (min x1 b) l) left) left)
                (overlay (tail segs) a b l
                         (if (lt (max x0 b) x1) (cons (cut_seg s (max x0 b) x1) mid) mid)))))))))

(def cut_seg ((s Seg) (a int) (b int)) Seg
  (match s ((Owned x0 x1 l) (Owned a b l)) ((Bare x0 x1) (Bare a b))))

; Who shows along screen row y of a screen w wide: each layer covering it,
; bottom first, over the one before, less what its corners cut.
(def row_segs ((w int) (y int) (layers (list Layer)) (bufs (Map int Buffer)) (segs (list Seg))) (list Seg)
  (if (is_empty layers)
      segs
      (match (head layers)
        ((Layer id lx ly top)
          (match (map_get bufs id)
            ((None) (row_segs w y (tail layers) bufs segs))
            ((Some b)
              (match b
                ((Buffer bw bh addrs va cs)
                  (if (if (ge y ly) (lt y (add ly bh)) false)
                      (row_segs w y (tail layers) bufs
                        (overlay_span segs (max (add lx (left_inset cs bh (sub y ly))) 0)
                                      (min (sub (add lx bw) (right_inset cs bh (sub y ly))) w) (head layers)))
                      (row_segs w y (tail layers) bufs segs))))))))))

; segs with columns a up to b given to layer l, if there are any.
(def overlay_span ((segs (list Seg)) (a int) (b int) (l Layer)) (list Seg)
  (if (lt a b) (overlay segs a b l (nil Seg)) segs))


; n bytes of black, from the one zero page at zero, onto runs.
(def zero_runs ((zero int) (n int) (runs (list VirtqRun))) (list VirtqRun)
  (if (le n 0)
      runs
      (zero_runs zero (sub n (min n (page_size))) (virtq_push_run runs zero (min n (page_size))))))

(def seg_runs ((y int) (segs (list Seg)) (bufs (Map int Buffer)) (zero int) (runs (list VirtqRun))) (list VirtqRun)
  (if (is_empty segs)
      runs
      (seg_runs y (tail segs) bufs zero
        (match (head segs)
          ((Bare x0 x1) (zero_runs zero (mul (sub x1 x0) 4) runs))
          ((Owned x0 x1 l) (layer_runs y x0 x1 l bufs zero runs))))))

; Columns x0 up to x1 of screen row y, from layer l's buffer: its row
; (y - ly + top) mod its height, from column x0 - lx.
(def layer_runs ((y int) (x0 int) (x1 int) (l Layer) (bufs (Map int Buffer)) (zero int) (runs (list VirtqRun))) (list VirtqRun)
  (match l
    ((Layer id lx ly top)
      (match (map_get bufs id)
        ((None) (zero_runs zero (mul (sub x1 x0) 4) runs))
        ((Some b)
          (match b
            ((Buffer bw bh addrs va cs)
              (let r (mod (add (sub y ly) top) bh)
                (virtq_page_runs addrs (mul (add (mul r bw) (sub x0 lx)) 4) (mul (sub x1 x0) 4) runs)))))))))

; The screen's backing, w by h, from layers, bottom first: every row's
; runs, in order, the screen's bytes row after row, with what no layer
; covers black from the zero page.
(def backing_runs ((w int) (h int) (layers (list Layer)) (bufs (Map int Buffer)) (zero int)) (list VirtqRun)
  (rows_runs (screen_rows w h layers bufs zero)))

; One row of the screen as the backing has it: who shows along it, and
; the runs of memory its pixels are, in order. The driver keeps every
; row, so that a restack builds again only the rows it changes.
(data Row (Row (list Seg) (list VirtqRun)))

(def row_segs_of ((r Row)) (list Seg) (match r ((Row segs runs) segs)))
(def row_runs ((r Row)) (list VirtqRun) (match r ((Row segs runs) runs)))

(def no_rows () (array Row) (array_new 0 (Row (nil Seg) (nil VirtqRun))))

; Screen row y, w wide, from layers over bufs.
(def row_of ((w int) (y int) (layers (list Layer)) (bufs (Map int Buffer)) (zero int)) Row
  (let segs (row_segs w y layers bufs (cons (Bare 0 w) (nil Seg)))
    (Row segs (rev (seg_runs y segs bufs zero (nil VirtqRun))))))

; Every row of a screen w by h, from layers over bufs.
(def screen_rows ((w int) (h int) (layers (list Layer)) (bufs (Map int Buffer)) (zero int)) (array Row)
  (build_rows w 0 layers bufs zero (array_new h (Row (nil Seg) (nil VirtqRun)))))

(def build_rows ((w int) (y int) (layers (list Layer)) (bufs (Map int Buffer)) (zero int) (rows (array Row))) (array Row)
  (if (ge y (array_len rows))
      rows
      (build_rows w (add y 1) layers bufs zero (array_set rows y (row_of w y layers bufs zero)))))

; The rows' runs, one after another, a run that starts where the one
; before it ends, as the end of one row and the start of the next often
; do, joined to it.
(def rows_runs ((rows (array Row))) (list VirtqRun)
  (rev (rows_runs_from rows 0 (nil VirtqRun))))

(def rows_runs_from ((rows (array Row)) (y int) (acc (list VirtqRun))) (list VirtqRun)
  (if (ge y (array_len rows))
      acc
      (rows_runs_from rows (add y 1) (push_all (row_runs (array_get rows y)) acc))))

; runs, in order, onto acc, reversed, each joined to the last if it can be.
(def push_all ((runs (list VirtqRun)) (acc (list VirtqRun))) (list VirtqRun)
  (if (is_empty runs)
      acc
      (match (head runs) ((VirtqRun a n) (push_all (tail runs) (virtq_push_run acc a n))))))

; Where a buffer's rows y up to y + n show, for layer l: one box, or two
; where its ring wraps; columns x up to x + cw.
(def layer_damage ((l Layer) (bh int) (x int) (y int) (cw int) (n int)) (list Damage)
  (match l
    ((Layer id lx ly top)
      (let s (mod (add (mod (sub y top) bh) bh) bh)        ; mod keeps the sign: this does not
        (if (le (add s n) bh)
            (cons (Box (add lx x) (add ly s) (add lx (add x cw)) (add ly (add s n))) (nil Damage))
            (cons (Box (add lx x) (add ly s) (add lx (add x cw)) (add ly bh))
                  (cons (Box (add lx x) ly (add lx (add x cw)) (add ly (sub (add s n) bh))) (nil Damage))))))))

; Every box on the screen showing rows y up to y + n, columns x up to
; x + cw, of buffer id, in each layer showing it.
(def damage_boxes ((layers (list Layer)) (id int) (bh int) (x int) (y int) (cw int) (n int)) (list Damage)
  (if (is_empty layers)
      (nil Damage)
      (match (head layers)
        ((Layer lid lx ly top)
          (if (eq lid id)
              (append (layer_damage (head layers) bh x y cw n) (damage_boxes (tail layers) id bh x y cw n))
              (damage_boxes (tail layers) id bh x y cw n))))))

; boxes with each pair that overlaps made one, the box around both, until
; none do.
(def merge_boxes ((boxes (list Damage)) (acc (list Damage))) (list Damage)
  (if (is_empty boxes)
      (rev acc)
      (match (head boxes)
        ((NoDamage) (merge_boxes (tail boxes) acc))
        ((Box x0 y0 x1 y1)
          (match (overlapping acc (head boxes))
            ((NoDamage) (merge_boxes (tail boxes) (cons (head boxes) acc)))
            ((Box a0 b0 a1 b1)
              (merge_boxes (cons (union (head boxes) (Box a0 b0 a1 b1)) (tail boxes)) (without_box acc (Box a0 b0 a1 b1)))))))))

; The first of boxes that overlaps d, or none.
(def overlapping ((boxes (list Damage)) (d Damage)) Damage
  (if (is_empty boxes)
      (NoDamage)
      (if (boxes_overlap (head boxes) d) (head boxes) (overlapping (tail boxes) d))))

(def boxes_overlap ((a Damage) (b Damage)) bool
  (match a
    ((NoDamage) false)
    ((Box ax0 ay0 ax1 ay1)
      (match b
        ((NoDamage) false)
        ((Box bx0 by0 bx1 by1)
          (if (lt ax0 bx1) (if (lt bx0 ax1) (if (lt ay0 by1) (lt by0 ay1) false) false) false))))))

; boxes without the first that is d.
(def without_box ((boxes (list Damage)) (d Damage)) (list Damage)
  (if (is_empty boxes) boxes (if (eq (head boxes) d) (tail boxes) (cons (head boxes) (without_box (tail boxes) d)))))

; ---------------------------------------------------------------- restacks

; The boxes of a screen w by h whose pixels differ between layers ols over
; buffers obufs and layers nls over nbufs: each row's segments compared,
; and consecutive rows that differ made a band, a box from the least
; column that differs in any of its rows to the greatest. A segment of a
; layer whose buffer is not the same in both differs too.
(def restack_damage ((w int) (h int) (ols (list Layer)) (obufs (Map int Buffer)) (nls (list Layer)) (nbufs (Map int Buffer))) (list Damage)
  (match (rows_restacked (Restack w h ols obufs nls nbufs (changed_ids nls obufs nbufs (nil int))) 0 (screen_rows w h ols obufs 0))
    ((Restacked rows dmg) dmg)))

; The rows after a restack, and the boxes that differ.
(data Restacked (Restacked (array Row) (list Damage)))

; rows, the screen as r's old layers make it, made as its new layers do:
; each row a layer changed in built again and compared with what it was,
; and consecutive rows that differ made a band, as restack_damage says.
(def rows_restacked ((r Restack) (zero int) (rows (array Row))) Restacked
  (match r
    ((Restack w h ols obufs nls nbufs ids)
      (update_rows r (dirty_rows h ols obufs nls nbufs) zero rows 0 (NoDamage) (nil Damage)))))

(def update_rows ((r Restack) (dirty (array bool)) (zero int) (rows (array Row)) (y int) (band Damage) (acc (list Damage))) Restacked
  (match r
    ((Restack w h ols obufs nls nbufs ids)
      (if (ge y h)
          (Restacked rows (rev (band_onto band acc)))
          (if (not (array_get dirty y))
              (update_rows r dirty zero rows (add y 1) (NoDamage) (band_onto band acc))
              (let old (row_segs_of (array_get rows y))
                (let new (row_of w y nls nbufs zero)
                  (let change (row_change old (row_segs_of new) ids)
                    (let rows2 (array_set rows y new)
                      (match change
                        ((NoSpan) (update_rows r dirty zero rows2 (add y 1) (NoDamage) (band_onto band acc)))
                        ((Span x0 x1) (update_rows r dirty zero rows2 (add y 1) (union band (Box x0 y x1 (add y 1))) acc))))))))))))

; Which of h rows a restack from layers ols over obufs to nls over nbufs
; can change: every row, if the layers are not the same buffers in the
; same order; else the rows each layer that moved, scrolled or has a
; buffer that changed covers, where it was and where it is.
(def dirty_rows ((h int) (ols (list Layer)) (obufs (Map int Buffer)) (nls (list Layer)) (nbufs (Map int Buffer))) (array bool)
  (if (eq (layer_ids ols (nil int)) (layer_ids nls (nil int)))
      (mark_layers ols obufs nls nbufs (array_new h false))
      (array_new h true)))

(def layer_ids ((ls (list Layer)) (acc (list int))) (list int)
  (if (is_empty ls) (rev acc) (layer_ids (tail ls) (cons (layer_id (head ls)) acc))))

(def mark_layers ((ols (list Layer)) (obufs (Map int Buffer)) (nls (list Layer)) (nbufs (Map int Buffer)) (d (array bool))) (array bool)
  (if (if (is_empty ols) true (is_empty nls))
      d
      (mark_layers (tail ols) obufs (tail nls) nbufs
        (if (same_layer (head ols) obufs (head nls) nbufs)
            d
            (mark_layer (mark_layer d (head ols) obufs) (head nls) nbufs)))))

; Whether layer a over abufs and b over bbufs show the same: the same
; place and top, and the same buffer, pages and corners.
(def same_layer ((a Layer) (abufs (Map int Buffer)) (b Layer) (bbufs (Map int Buffer))) bool
  (if (eq a b) (eq (map_get abufs (layer_id a)) (map_get bbufs (layer_id b))) false))

; d with the rows layer l covers marked, its buffer's from bufs.
(def mark_layer ((d (array bool)) (l Layer) (bufs (Map int Buffer))) (array bool)
  (match l
    ((Layer id x y top)
      (match (map_get bufs id)
        ((None) d)
        ((Some b) (match b ((Buffer bw bh addrs va cs) (mark_span d (max y 0) (min (add y bh) (array_len d))))))))))

(def mark_span ((d (array bool)) (y int) (end int)) (array bool)
  (if (ge y end) d (mark_span (array_set d y true) (add y 1) end)))

; What restack_damage compares: the screen's size, the old layers and
; buffers, the new, and the ids whose buffer changed.
(data Restack (Restack int int (list Layer) (Map int Buffer) (list Layer) (Map int Buffer) (list int)))

(def changed_ids ((ls (list Layer)) (obufs (Map int Buffer)) (nbufs (Map int Buffer)) (acc (list int))) (list int)
  (if (is_empty ls)
      acc
      (let id (layer_id (head ls))
        (changed_ids (tail ls) obufs nbufs (if (eq (pixels_of (map_get obufs id)) (pixels_of (map_get nbufs id))) acc (cons id acc))))))

; Where a buffer's pixels come from: its size and pages, but not its
; corners, which its segments already show.
(def pixels_of ((b (Option Buffer))) (Option Buffer)
  (match b
    ((None) b)
    ((Some x) (match x ((Buffer bw bh addrs va cs) (Some (Buffer bw bh addrs 0 (square))))))))

(def layer_id ((l Layer)) int (match l ((Layer id x y top) id)))

(def band_onto ((band Damage) (acc (list Damage))) (list Damage)
  (match band ((NoDamage) acc) ((Box x0 y0 x1 y1) (cons band acc))))

; Columns x0 up to x1 of a row, from the first column whose pixel differs
; between segments os and ns to the last; or none. Both cover the whole
; row, so each is walked from the left, and then from the right, in step
; with the other.
(def row_change ((os (list Seg)) (ns (list Seg)) (ids (list int))) Span
  (match (first_diff os ns ids)
    ((None) (NoSpan))
    ((Some x0)
      (match (last_diff (rev os) (rev ns) ids)
        ((None) (NoSpan))
        ((Some x1) (Span x0 x1))))))

; The first column where os and ns show different pixels: each head's
; shared columns compared, and whichever ends first dropped.
(def first_diff ((os (list Seg)) (ns (list Seg)) (ids (list int))) (Option int)
  (if (if (is_empty os) true (is_empty ns))
      ((None int))
      (let a (head os)
        (let b (head ns)
          (if (not (same_owner a b ids))
              (Some (max (seg_x0 a) (seg_x0 b)))
              (let e (min (seg_x1 a) (seg_x1 b))
                (first_diff (if (le (seg_x1 a) e) (tail os) os) (if (le (seg_x1 b) e) (tail ns) ns) ids)))))))

; The same from the right, os and ns reversed: the column after the last
; that differs.
(def last_diff ((os (list Seg)) (ns (list Seg)) (ids (list int))) (Option int)
  (if (if (is_empty os) true (is_empty ns))
      ((None int))
      (let a (head os)
        (let b (head ns)
          (if (not (same_owner a b ids))
              (Some (min (seg_x1 a) (seg_x1 b)))
              (let s (max (seg_x0 a) (seg_x0 b))
                (last_diff (if (ge (seg_x0 a) s) (tail os) os) (if (ge (seg_x0 b) s) (tail ns) ns) ids)))))))

; Whether a and b show the same pixels where they meet: both black, or
; the same layer, its buffer unchanged.
(def same_owner ((a Seg) (b Seg) (ids (list int))) bool
  (match a
    ((Bare ax0 ax1) (match b ((Bare bx0 bx1) true) ((Owned bx0 bx1 lb) false)))
    ((Owned ax0 ax1 la)
      (match b
        ((Bare bx0 bx1) false)
        ((Owned bx0 bx1 lb) (if (eq la lb) (not (any_eq (layer_id la) ids)) false))))))

; ---------------------------------------------------------------- driving

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "virtio-gpu" why))

(def virtio_gpu () int
  (match (virtio_open)
    ((Err why) (complain why))
    ((Ok d) (found d (find_device d (gpu_device) 0)))))

; No GPU is no failure: the board was started without one.
(def found ((d IoDevice) (t int)) int
  (match (virtio_probe d t "the virtio-gpu" "control" (ring_size))
    ((VirtioAbsent) (note_as "virtio-gpu" "no virtio-gpu on the board"))
    ((VirtioUnusable why) (complain why))
    ((VirtioReady t2)
      (match (virtq_mem (queue_pages) "the queue")
        ((NoVirtqMem why) (complain why))
        ((VirtqMem va q addrs) (with_cursor_queue (Gpu d t q addrs 0)))))))

; The control queue's memory: page 0 the ring, descriptors at 0, the
; available ring at 1024, the used ring at 2048; page 1 a response; the
; rest a request, which may be long, for a backing of many runs.
(def queue_pages () int 64)
(def ring_size () int 64)
(def avail_off () int (virtq_avail_off (ring_size)))
(def used_off () int (virtq_used_off (ring_size)))
(def resp_off () int 4096)
(def req_off () int 8192)

; The most runs one backing may have: what the request's pages hold.
(def max_runs () int (div (sub (mul (sub (queue_pages) 2) (page_size)) 32) 16))

; The driver: the transports' registers and the GPU's transport, the
; queue's memory and where the device reaches each page of it, and how
; many requests it has made.
(data Gpu (Gpu IoDevice int IoDevice (array int) int))

; The cursor queue, queue 1, in one page, as the control queue's first
; but of 16, with its request at 1024; and the zero page after it, black
; for what no layer covers.
(data Curq (Curq IoDevice int int))

(def cursor_ring () int 16)
(def cursor_avail () int (virtq_avail_off (cursor_ring)))
(def cursor_used () int (virtq_used_off (cursor_ring)))
(def cursor_req () int 1024)

(def with_cursor_queue ((g Gpu)) int
  (match (virtq_mem 2 "the cursor queue")
    ((NoVirtqMem why) (complain why))
    ((VirtqMem va cq at) (ready_queues g (Curq cq (array_get at 0) 0) (array_get at 1)))))

(def ready_queues ((g Gpu) (c Curq) (zero int)) int
  (match g
    ((Gpu d t q addrs n)
      (match c
        ((Curq cq ca cn)
          (let s (start_queue d t 0 (ring_size) (device_at addrs 0) (device_at addrs (avail_off)) (device_at addrs (used_off)))
            (let s1 (start_queue d t 1 (cursor_ring) ca (add ca (cursor_avail)) (add ca (cursor_used)))
              (let o (driver_ok d t)
                (display_info g c zero)))))))))

; ------------------------------------------------------------- requests

; The outcome of a request: the response's type, and the driver after it.
(data Answer (Answer int Gpu) (NoAnswer (list int)))

; Sends req, with room for resp_len bytes of response, and waits for the
; device to answer it.
(def submit ((g Gpu) (req (list int)) (resp_len int)) Answer
  (match g
    ((Gpu d t q addrs n)
      (let w (put_bytes q (req_off) req)
        (queued g (length req) resp_len)))))

; The request of len bytes already at req_off made: its descriptors
; written and the device told, then its answer waited for.
(def queued ((g Gpu) (len int) (resp_len int)) Answer
  (match g
    ((Gpu d t q addrs n)
      (let ds (put_bytes q 0 (descriptors (req_off) len addrs (resp_off) resp_len))
        (let n2 (virtq_offer d t 0 q (avail_off) (ring_size) n 0)
          (answered (Gpu d t q addrs n2) (clock_ns)))))))

; Waits for the used ring's index to reach the requests made, as
; virtq_wait does, then reads the response's type.
(def answered ((g Gpu) (since int)) Answer
  (match g
    ((Gpu d t q addrs n)
      (if (virtq_wait q (used_off) n since)
          (Answer (device_read32 q (resp_off)) g)
          (NoAnswer "the virtio-gpu did not answer")))))

; The response's u32 at off, from the queue's memory.
(def resp_word ((g Gpu) (off int)) int
  (match g ((Gpu d t q addrs n) (device_read32 q (add (resp_off) off)))))

; Sends req, and goes on with the driver if the answer is want.
(data Commanded (Commanded Gpu) (NotCommanded (list int)))

(def send ((g Gpu) (what (list int)) (req (list int)) (want int)) Commanded
  (sent_as what (submit g req 24) want))

(def sent_as ((what (list int)) (a Answer) (want int)) Commanded
  (match a
    ((NoAnswer why) (NotCommanded why))
    ((Answer type g2)
      (if (eq type want)
          (Commanded g2)
          (NotCommanded (append what (append " answered 0x" (hex_digits type 4))))))))

; attach_backing's request for runs, n of them, sent: written into the
; queue's memory as it goes, four words a run, as attach_backing lays
; them out, rather than made as a list of bytes first, which for a
; screen of 2500 runs is 40 KB, and then written a byte at a time.
(def send_attach ((g Gpu) (id int) (runs (list VirtqRun)) (n int)) Commanded
  (match g
    ((Gpu d t q addrs k)
      (let hd (put_bytes q (req_off) (append (header (cmd_resource_attach_backing)) (append (u32_le id) (u32_le n))))
        (let rs (put_runs q (add (req_off) 32) runs)
          (sent_as "attach_backing" (queued g (add 32 (mul 16 n)) 24) (resp_ok_nodata)))))))

(def put_runs ((q IoDevice) (off int) (runs (list VirtqRun))) int
  (if (is_empty runs)
      0
      (let w (put_words q off (run_words (head runs)))
        (put_runs q (add off 16) (tail runs)))))

; A run as attach_backing's entry: its address's low and high words, its
; length, and padding.
(def run_words ((r VirtqRun)) (list int)
  (match r ((VirtqRun a n) (cons (bit_and a 4294967295) (cons (bit_shr a 32) (cons n (cons 0 (nil int))))))))

(def put_words ((q IoDevice) (off int) (ws (list int))) int
  (if (is_empty ws) 0 (let w (device_write32 q off (head ws)) (put_words q (add off 4) (tail ws)))))

; Sends a cursor request, which has no response, and waits for the device
; to take it.
(def cursor_send ((g Gpu) (c Curq) (req (list int))) Curq
  (match g
    ((Gpu d t q addrs n)
      (match c
        ((Curq cq ca cn)
          (let w (put_bytes cq (cursor_req) req)
            (let ds (put_bytes cq 0 (descriptor (add ca (cursor_req)) (length req) 0 0))
              (let cn2 (virtq_offer d t 1 cq (cursor_avail) (cursor_ring) cn 0)
                (let k (virtq_wait cq (cursor_used) cn2 (clock_ns))
                  (Curq cq ca cn2))))))))))

; ------------------------------------------------------------- the screen

(def display_info ((g Gpu) (c Curq) (zero int)) int
  (match (submit g (get_display_info) (display_info_len))
    ((NoAnswer why) (complain why))
    ((Answer type g2)
      (if (not (eq type (resp_ok_display_info)))
          (complain (append "display info answered 0x" (hex_digits type 4)))
          (let w (resp_word g2 32)                    ; the first mode's width, then height
            (let h (resp_word g2 36)
              (if (if (lt w 1) true (lt h 1))
                  (complain "scanout 0 has no mode")
                  (create g2 c zero w h))))))))

; The screen, resource 1, black, shown on scanout 0; then display served.
; A scanout must have a backing, so until layers come it is the zero page,
; over and over.
(def create ((g Gpu) (c Curq) (zero int) (w int) (h int)) int
  (match (send g "resource_create_2d" (resource_create_2d (screen_res) (format_b8g8r8x8) w h) (resp_ok_nodata))
    ((NotCommanded why) (complain why))
    ((Commanded g2)
      (match (send g2 "attach_backing" (attach_backing (screen_res) (backing_runs w h (nil Layer) ((MapEmpty int Buffer)) zero)) (resp_ok_nodata))
        ((NotCommanded why) (complain why))
        ((Commanded g3) (scanned_out g3 c zero w h))))))

(def scanned_out ((g Gpu) (c Curq) (zero int) (w int) (h int)) int
  (match (send g "set_scanout" (set_scanout w h) (resp_ok_nodata))
    ((NotCommanded why) (complain why))
    ((Commanded g2)
      (match (present g2 w h (Box 0 0 w h))
        ((NotCommanded why) (complain why))
        ((Commanded g3) (start_serving (Drv g3 c w h ((MapEmpty int Buffer)) (nil Layer) true (Cursor false 0 0 0 0 -1) zero (no_rows))))))))

; The pointer: whether its image is set, where it is, its hot spot, and
; the buffer its image is, -1 for none.
(data Cursor (Cursor bool int int int int int))

; The driver: the control queue, the cursor queue, the screen's width and
; height, the buffers shared with it, the layers, whether the screen has
; a backing, the pointer, the zero page, and each row of the screen as
; the backing has it, or none.
(data Drv (Drv Gpu Curq int int (Map int Buffer) (list Layer) bool Cursor int (array Row)))

; ------------------------------------------------------------- serving

; Registers as display, then answers each request, as display.l0 makes
; them: ok, display W H cursor, or error: WHY.
(def start_serving ((v Drv)) int
  (let port (port_new)
    (let r (name_register_or_why port "display")
      (if (is_empty r) (serve v port) (complain r)))))

(def serve ((v Drv) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from payload)
      (match (handle v (request_body payload))
        ((Served v2 reply)
          (let r (request_answer payload reply)
            (serve v2 port)))))))

; A request's body, its op and then its numbers, answered.
(def handle ((v Drv) (body (list int))) (Served Drv)
  (match (request_numbers body)
    ((ReqBad why) (served_error v why))
    ((ReqNums op ns) (requested v op ns (length ns)))))

(def requested ((v Drv) (op (list int)) (ns (list int)) (n int)) (Served Drv)
  (if (if (eq op "info") (eq n 0) false) (info v)
  (if (if (eq op "buffer") (eq n 4) false) (shared v (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3))
  (if (if (eq op "forget") (eq n 1) false) (forgot v (nth ns 0))
  (if (if (eq op "layers") (eq (mod n 4) 0) false) (stacked v (layers_of ns (nil Layer)))
  (if (if (eq op "damage") (if (gt n 0) (eq (mod n 5) 0) false) false) (damaged v ns (nil Damage))
  (requested_pointer v op ns n)))))))

(def requested_pointer ((v Drv) (op (list int)) (ns (list int)) (n int)) (Served Drv)
  (if (if (eq op "shape") (eq n 5) false) (shaped v (nth ns 0) (Corners (nth ns 1) (nth ns 2) (nth ns 3) (nth ns 4)))
  (if (if (eq op "cursor") (eq n 3) false) (pointer_image v (nth ns 0) (nth ns 1) (nth ns 2))
  (if (if (eq op "move") (eq n 2) false) (moved v (nth ns 0) (nth ns 1))
  (served_error v (append "no request " op))))))

(def info ((v Drv)) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (Served v (append "display " (append (digits w) (append " " (append (digits h) " cursor"))))))))

(def layers_of ((ns (list int)) (acc (list Layer))) (list Layer)
  (if (is_empty ns)
      (rev acc)
      (layers_of (drop_n ns 4) (cons (Layer (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3)) acc))))

; buffer ID W H VA: the w by h pixels a client shared, at va here.
(def shared ((v Drv) (id int) (bw int) (bh int) (va int)) (Served Drv)
  (if (if (lt bw 1) true (lt bh 1))
      (served_error v "a buffer has no pixels")
      (let n (div (add (mul (mul bw bh) 4) (sub (page_size) 1)) (page_size))
        (match (page_addresses va n)
          ((None) (served_error v "the buffer is not shared with the display"))
          ((Some addrs) (put_buffer v id (Buffer bw bh addrs va (square))))))))

; The driver with buffer b as id: the screen rebuilt if it shows id, since
; its backing reads the old one's pages, or its corners have changed.
(def put_buffer ((v Drv) (id int) (b Buffer)) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (if (if attached (in_layers layers id) false)
          (restacked v layers (map_put bufs id b))
          (served_ok (Drv g c w h (map_put bufs id b) layers attached cur zero rows))))))

; shape ID TL TR BL BR: the buffer's corners rounded to those radii, each
; from 0, square, up to half the buffer's width and height.
(def shaped ((v Drv) (id int) (cs Corners)) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (match (map_get bufs id)
        ((None) (served_error v (append "no buffer " (digits id))))
        ((Some b)
          (match b
            ((Buffer bw bh addrs va old)
              (if (corners_fit cs bw bh)
                  (put_buffer v id (Buffer bw bh addrs va cs))
                  (served_error v "a corner's radius must be from 0 to half the buffer's width and height")))))))))

(def corners_fit ((cs Corners) (bw int) (bh int)) bool
  (match cs
    ((Corners tl tr bl br)
      (if (fits_radius tl bw bh) (if (fits_radius tr bw bh) (if (fits_radius bl bw bh) (fits_radius br bw bh) false) false) false))))

; forget ID: the buffer dropped, and its pages given up, so that once its
; client has given them up too their memory is freed. Refused while it is
; on the screen or is the pointer's, since the device still reads it.
(def forgot ((v Drv) (id int)) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (match (map_get bufs id)
        ((None) (served_ok v))
        ((Some b)
          (if (if (in_layers layers id) true (eq (cursor_buffer cur) id))
              (served_error v (append "buffer " (append (digits id) " is in use")))
              (match b
                ((Buffer bw bh addrs va cs)
                  (let u (shm_unmap va (array_len addrs))
                    (served_ok (Drv g c w h (map_remove bufs id) layers attached cur zero rows)))))))))))

(def in_layers ((ls (list Layer)) (id int)) bool
  (if (is_empty ls)
      false
      (match (head ls) ((Layer lid x y top) (if (eq lid id) true (in_layers (tail ls) id))))))

(def cursor_buffer ((cur Cursor)) int
  (match cur ((Cursor set px py hx hy id) id)))

; layers ID X Y TOP ...: the screen rebuilt from new layers.
(def stacked ((v Drv) (ls (list Layer)) ) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows) (restacked v ls bufs))))

; The screen rebuilt from layers ls over buffers nbufs: its backing
; detached, the new one attached, and what that changed shown; all of it
; if nothing was stacked before, or the backing was not attached. Only
; the rows a changed layer covers, before or after, are built again;
; the rest are the backing's already.
(def restacked ((v Drv) (ls (list Layer)) (nbufs (Map int Buffer))) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (match (if (if attached (if (not (is_empty layers)) (eq (array_len rows) h) false) false)
                 (rows_restacked (Restack w h layers bufs ls nbufs (changed_ids ls bufs nbufs (nil int))) zero rows)
                 (Restacked (screen_rows w h ls nbufs zero) (cons (Box 0 0 w h) (nil Damage))))
        ((Restacked rows2 dmg)
          (backed (Drv g c w h bufs layers attached cur zero (no_rows)) ls nbufs rows2 dmg))))))

; The backing rows2 make attached in place of the old one, and dmg shown:
; the driver then has layers ls over nbufs, and rows2. If it cannot be,
; the driver is left as v, which has no rows, so the next restack builds
; every row again.
(def backed ((v Drv) (ls (list Layer)) (nbufs (Map int Buffer)) (rows2 (array Row)) (dmg (list Damage))) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero none)
      (let runs (rows_runs rows2)
        (let n (length runs)
          (if (gt n (max_runs))
              (served_error v "the screen is in too many pieces")
              (match (if attached (send g "detach_backing" (detach_backing (screen_res)) (resp_ok_nodata)) (Commanded g))
                ((NotCommanded why) (served_error v why))
                ((Commanded g2)
                  (match (send_attach g2 (screen_res) runs n)
                    ((NotCommanded why) (served_error (Drv g2 c w h bufs layers false cur zero none) why))
                    ((Commanded g3) (shown_boxes (Drv g3 c w h nbufs ls true cur zero rows2) dmg)))))))))))

; damage ID X Y W H ...: each rectangle of its buffer shown wherever it
; is on the screen, boxes that overlap shown as one; nothing shown if a
; buffer is unknown.
(def damaged ((v Drv) (ns (list int)) (acc (list Damage))) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (if (is_empty ns)
          (if attached (shown_boxes v (merge_boxes (clipped acc w h (nil Damage)) (nil Damage))) (served_ok v))
          (match (map_get bufs (head ns))
            ((None) (served_error v (append "no buffer " (digits (head ns)))))
            ((Some b)
              (match b
                ((Buffer bw bh addrs va cs)
                  (damaged v (drop_n ns 5)
                    (rev_onto (damage_boxes layers (nth ns 0) bh (nth ns 1) (max (nth ns 2) 0) (nth ns 3) (min (nth ns 4) bh)) acc))))))))))

; boxes, those on a screen w by h, cut to it.
(def clipped ((boxes (list Damage)) (w int) (h int) (acc (list Damage))) (list Damage)
  (if (is_empty boxes)
      (rev acc)
      (match (clip_damage (head boxes) w h)
        ((NoDamage) (clipped (tail boxes) w h acc))
        ((Box x0 y0 x1 y1) (clipped (tail boxes) w h (cons (Box x0 y0 x1 y1) acc))))))

; Each box transferred and flushed.
(def shown_boxes ((v Drv) (boxes (list Damage))) (Served Drv)
  (if (is_empty boxes)
      (served_ok v)
      (match v
        ((Drv g c w h bufs layers attached cur zero rows)
          (match (present g w h (head boxes))
            ((NotCommanded why) (served_error v why))
            ((Commanded g2) (shown_boxes (Drv g2 c w h bufs layers attached cur zero rows) (tail boxes))))))))

; Has the device copy part of the screen's backing and show it.
(def present ((g Gpu) (w int) (h int) (d Damage)) Commanded
  (match (clip_damage d w h)
    ((NoDamage) (Commanded g))
    ((Box x0 y0 x1 y1)
      (match (send g "transfer_to_host_2d"
                   (transfer_to_host_2d_at (screen_res) x0 y0 (sub x1 x0) (sub y1 y0) (mul (add (mul y0 w) x0) 4)) (resp_ok_nodata))
        ((NotCommanded why) (NotCommanded why))
        ((Commanded g2) (send g2 "resource_flush" (resource_flush_at x0 y0 (sub x1 x0) (sub y1 y0)) (resp_ok_nodata)))))))

; ---------------------------------------------------------------- pointer

; cursor ID HX HY: the pointer's image, 64 by 64, as resource 2.
(def pointer_image ((v Drv) (id int) (hx int) (hy int)) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (match (map_get bufs id)
        ((None) (served_error v (append "no buffer " (digits id))))
        ((Some b)
          (match b
            ((Buffer bw bh addrs va cs)
              (if (not (if (eq bw (cursor_size)) (eq bh (cursor_size)) false))
                  (served_error v "a cursor is 64 by 64")
                  (cursor_resource v cur id addrs hx hy)))))))))

(def cursor_resource ((v Drv) (cur Cursor) (id int) (addrs (array int)) (hx int) (hy int)) (Served Drv)
  (match cur
    ((Cursor set px py ohx ohy oid)
      (match v
        ((Drv g c w h bufs layers attached old zero rows)
          (match (if set (send g "detach_backing" (detach_backing (cursor_res)) (resp_ok_nodata))
                         (send g "resource_create_2d" (resource_create_2d (cursor_res) (format_b8g8r8a8) (cursor_size) (cursor_size)) (resp_ok_nodata)))
            ((NotCommanded why) (served_error v why))
            ((Commanded g2)
              (match (send g2 "attach_backing" (attach_backing (cursor_res) (pages_runs addrs)) (resp_ok_nodata))
                ((NotCommanded why) (served_error v why))
                ((Commanded g3)
                  (match (send g3 "transfer_to_host_2d"
                               (transfer_to_host_2d_at (cursor_res) 0 0 (cursor_size) (cursor_size) 0) (resp_ok_nodata))
                    ((NotCommanded why) (served_error v why))
                    ((Commanded g4)
                      (served_ok (Drv g4 (cursor_send g4 c (cursor_cmd (cmd_update_cursor) px py hx hy))
                               w h bufs layers attached (Cursor true px py hx hy id) zero rows)))))))))))))

; move X Y: the pointer there.
(def moved ((v Drv) (x int) (y int)) (Served Drv)
  (match v
    ((Drv g c w h bufs layers attached cur zero rows)
      (match cur
        ((Cursor set px py hx hy id)
          (served_ok (Drv g (if set (cursor_send g c (cursor_cmd (cmd_move_cursor) x y hx hy)) c)
                   w h bufs layers attached (Cursor set x y hx hy id) zero rows)))))))
