; flight_test.l0 -- tests of flight.l0: room in the queue, commands
; retired in order whatever order they are used in, and replies sent in
; the order their requests came.

; The request pages of the driver's queue: from 8192 to 64 pages.
(def lo () int 8192)
(def hi () int 262144)

; f as text: made, used, retired, the next descriptor, descriptors held,
; cursor commands made and used, replies waiting, and any fault.
(def fl_text ((f Flight)) (list int)
  (unwords (list_of (cons "made" (cons (digits (fl_made f)) (cons "used" (cons (digits (fl_used f)) (cons "done" (cons (digits (fl_done f)) (nil (list int))))))))
    (list_of (cons "head" (cons (digits (fl_next_head f)) (cons "held" (cons (digits (fl_descs_held f)) (nil (list int))))))
      (cons "cursor" (cons (append (digits (fl_cursor_made f)) (append "/" (digits (fl_cursor_used f))))
        (cons "waiting" (cons (digits (fl_waiting f)) (cons "fault" (cons (fl_fault f) (nil (list int))))))))))))

; xs before ys.
(def list_of ((xs (list (list int))) (ys (list (list int)))) (list (list int)) (append xs ys))

; The replies due as text: each reply, a frame's marked *.
(def due_text ((d FlDue)) (list int)
  (match d ((FlDue f as) (join_with ", " (answers_words as (nil (list int)))))))

(def answers_words ((as (list FlAnswer)) (acc (list (list int)))) (list (list int))
  (if (is_empty as)
      (rev acc)
      (match (head as) ((FlAnswer mb r fr) (answers_words (tail as) (cons (if fr (append r "*") r) acc))))))

(def due_flight ((d FlDue)) Flight (match d ((FlDue f as) f)))

(def msg () bytes (bytes_from_list "...."))

; f with a small command offered where there is room, of n descriptors.
(def small ((f Flight) (n int)) Flight
  (fl_offered f (fl_room f 24 (lo) (hi)) 24 n "cmd" 4352))

; Nothing in flight: a request goes at the pages' start.
(def test_room_empty () int
  (check_int "at lo" (fl_room (fl_new (lo)) 100 (lo) (hi)) 8192))

; Two commands of 24 bytes: each 64 apart, their chains 2 descriptors.
(def test_offered () int
  (let f (small (small (fl_new (lo)) 2) 2)
    (add (check_str "flight" (fl_text f) "made 2 used 0 done 0 head 4 held 4 cursor 0/0 waiting 0 fault ")
         (check_int "next byte" (fl_room f 24 (lo) (hi)) 8320))))

; Used out of order, the second first: neither retired until the first is.
(def test_retire_in_order () int
  (let f (small (small (fl_new (lo)) 2) 2)
    (let a (due_flight (fl_due (fl_answered f 2 4352)))
      (let b (due_flight (fl_due (fl_answered a 0 4352)))
        (add (check_int "second only" (fl_done a) 0)
             (check_str "both" (fl_text b) "made 2 used 2 done 2 head 4 held 0 cursor 0/0 waiting 0 fault "))))))

; A reply waits for the commands made before it, and the next reply,
; with none of its own, waits behind it.
(def test_reply_order () int
  (let f (fl_reply (fl_reply (small (fl_new (lo)) 2) (msg) "ok" true) (msg) "display 1 2" false)
    (add (check_str "none yet" (due_text (fl_due f)) "")
         (check_str "both, in order" (due_text (fl_due (fl_answered f 0 4352))) "ok*, display 1 2"))))

; A reply with nothing before it goes at once.
(def test_reply_at_once () int
  (check_str "at once" (due_text (fl_due (fl_reply (fl_new (lo)) (msg) "ok" false))) "ok"))

; A command answered with another type makes its reply an error.
(def test_failed_reply () int
  (let f (fl_reply (small (fl_new (lo)) 2) (msg) "ok" false)
    (check_str "error" (due_text (fl_due (fl_answered f 0 4608))) "error: cmd answered 0x1200")))

; A failure before any reply waits goes to the next registered.
(def test_failed_then_reply () int
  (let f (due_flight (fl_due (fl_answered (small (fl_new (lo)) 2) 0 4608)))
    (add (check_str "kept" (fl_fault f) "cmd answered 0x1200")
         (check_str "next" (due_text (fl_due (fl_reply f (msg) "ok" false))) "error: cmd answered 0x1200"))))

; A reply waits for the cursor's commands too.
(def test_cursor_wait () int
  (let f (fl_reply (fl_cursor_offered (fl_new (lo))) (msg) "ok" false)
    (add (check_str "waits" (due_text (fl_due f)) "")
         (check_str "used" (due_text (fl_due (fl_cursor_index f 1))) "ok"))))

; The cursor's index counts round from 65535 to 0.
(def test_cursor_wraps () int
  (let f (fl_cursor_index (fl_cursor_offered (fl_new (lo))) 1)
    (check_int "all used" (fl_cursor_used (fl_cursor_index (fl_offer_cursor_n f 65536) 1)) 65537)))

(def fl_offer_cursor_n ((f Flight) (n int)) Flight
  (if (eq n 0) f (fl_offer_cursor_n (fl_cursor_offered f) (sub n 1))))

; No descriptors left: 63 held, a request needing 3 waits.
(def test_room_descriptors () int
  (let f (small (small (fl_new (lo)) 31) 32)
    (check_int "waits" (fl_room f 24 (lo) (hi)) -1)))

; The request pages are a ring: after a big request of 200,000 bytes
; from 8192 and a small one at 208192, 60,000 more fit neither after
; them (53,888 are left) nor before; once the big one is retired, they
; wrap to lo, under the small one still read. 8000 go after it.
(def test_room_wraps () int
  (let f (fl_offered (fl_new (lo)) (lo) 200000 51 "attach" 4352)
    (let g (small f 2)
      (let a (fl_room g 60000 (lo) (hi))
        (let h (due_flight (fl_due (fl_answered g 0 4352)))
          (add (check_int "waits" a -1)
               (add (check_int "wraps to lo" (fl_room h 60000 (lo) (hi)) 8192)
                    (check_int "after" (fl_room h 8000 (lo) (hi)) 208256))))))))

; Bytes after the last given are used before wrapping.
(def test_bytes_free () int
  (add (check_int "after" (fl_bytes_free 9000 8192 64 8192 10000) 9000)
       (add (check_int "wrap" (fl_bytes_free 9990 8320 64 8192 10000) 8192)
            (check_int "full" (fl_bytes_free 8256 8320 128 8192 10000) -1))))

; How many descriptors a request takes at most: a page and a bit is 3
; runs' worth, and the response.
(def test_descs_for () int
  (add (check_int "small" (fl_descs_for 24) 3) (check_int "whole" (fl_descs_for 253952) 64)))

; Used entries to read, counting round.
(def test_unread () int
  (check_int "round" (fl_unread (fl_new (lo)) 3) 3))

; Busy while a command or a cursor command is out.
(def test_busy () int
  (add (check_bool "idle" (fl_busy (fl_new (lo))) false)
       (check_bool "cursor" (fl_busy (fl_cursor_offered (fl_new (lo)))) true)))
