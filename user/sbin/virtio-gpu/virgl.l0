; virgl.l0 -- the bytes of virtio-gpu's 3D mode: its commands (virtio 1.2,
; section 5.7.6.8), and the one virgl command the driver sends through
; SUBMIT_3D, resource copy region (virglrenderer's virgl_protocol.h).
; The driver composes the screen with it on the host's GPU, so it makes
; textures, backs them with the clients' pages, and copies parts of them
; onto the screen's. Pure: it only makes the lists of bytes and words.

; The command types of 3D mode, and resource_unref's, which every
; resource is given up with.
(def cmd_resource_unref () int 258)           ; 0x0102
(def cmd_ctx_create () int 512)               ; 0x0200
(def cmd_ctx_attach_resource () int 514)
(def cmd_ctx_detach_resource () int 515)
(def cmd_resource_create_3d () int 516)
(def cmd_transfer_to_host_3d () int 517)
(def cmd_submit_3d () int 519)                ; 0x0207

; The feature bit a device offers if it has virgl: VIRTIO_GPU_F_VIRGL.
(def feature_virgl () int 1)

; The one rendering context the driver makes, and the target, 2D texture,
; and binds of the textures it creates: a render target and a sampler
; view, which a copy's destination and source need, and the scanout bit
; for the screen's.
(def virgl_ctx () int 1)
(def virgl_texture_2d () int 2)
(def bind_texture () int 10)                  ; render target, 1 << 1, and sampler view, 1 << 3
(def bind_scanout () int 262154)              ; the same, and scanout, 1 << 18

; virtio_gpu_ctrl_hdr of a command in context ctx: type, flags, fence_id,
; ctx_id, ring_idx and padding.
(def header_ctx ((type int) (ctx int)) (list int)
  (append (u32_le type) (append (u32_le 0) (append (le64 0) (append (u32_le ctx) (u32_le 0))))))

; n bytes of zero.
(def virgl_zeros ((n int)) (list int)
  (virgl_zeros_onto n (nil int)))

; virgl_zeros' loop: n more zeros onto acc.
(def virgl_zeros_onto ((n int) (acc (list int))) (list int)
  (if (le n 0) acc (virgl_zeros_onto (sub n 1) (cons 0 acc))))

; ctx_create: context ctx made, named name, as the 64 bytes a name has.
(def ctx_create ((ctx int) (name (list int))) (list int)
  (append (header_ctx (cmd_ctx_create) ctx)
    (append (u32_le (length name)) (append (u32_le 0)
      (append name (virgl_zeros (sub 64 (length name))))))))

; ctx_attach_resource and ctx_detach_resource: resource res put in, or
; taken out of, the context's reach.
(def ctx_attach ((res int)) (list int)
  (append (header_ctx (cmd_ctx_attach_resource) (virgl_ctx)) (append (u32_le res) (u32_le 0))))

; ctx_detach: resource res taken out of the context's reach.
(def ctx_detach ((res int)) (list int)
  (append (header_ctx (cmd_ctx_detach_resource) (virgl_ctx)) (append (u32_le res) (u32_le 0))))

; resource_unref: resource res given up.
(def resource_unref ((res int)) (list int)
  (append (header_ctx (cmd_resource_unref) 0) (append (u32_le res) (u32_le 0))))

; resource_create_3d: a 2D texture res, w by h pixels of format, to be
; bound as bind says: target, format, bind, width, height, depth 1, array
; size 1, level 0, no samples, no flags.
(def resource_create_3d ((res int) (format int) (bind int) (w int) (h int)) (list int)
  (append (header_ctx (cmd_resource_create_3d) 0)
    (append (u32_le res) (append (u32_le (virgl_texture_2d)) (append (u32_le format) (append (u32_le bind)
      (append (u32_le w) (append (u32_le h) (append (u32_le 1) (append (u32_le 1)
        (append (u32_le 0) (append (u32_le 0) (append (u32_le 0) (u32_le 0))))))))))))))

; transfer_to_host_3d: the rectangle at x, y, w by h of texture res, as
; its backing has it, its rows stride bytes apart from off, which is
; where the rectangle's top left pixel is, copied to the host's texture.
(def transfer_to_host_3d ((res int) (x int) (y int) (w int) (h int) (off int) (stride int)) (list int)
  (append (header_ctx (cmd_transfer_to_host_3d) (virgl_ctx))
    (append (u32_le x) (append (u32_le y) (append (u32_le 0) (append (u32_le w) (append (u32_le h) (append (u32_le 1)
      (append (le64 off) (append (u32_le res) (append (u32_le 0) (append (u32_le stride) (u32_le 0)))))))))))))

; submit_3d's head, before size bytes of virgl commands.
(def submit_3d_head ((size int)) (list int)
  (append (header_ctx (cmd_submit_3d) (virgl_ctx)) (append (u32_le size) (u32_le 0))))

; ------------------------------------------------------- virgl commands

; The word that starts a virgl command: its number, 17 for resource copy
; region, an object of 0, and the length of what follows it in words.
(def virgl_cmd ((cmd int) (len int)) int
  (bit_or cmd (bit_shl len 16)))

; Resource copy region: the w by h pixels at sx, sy of texture src
; copied to dx, dy of texture dst, as its 14 words: the command, then
; dst, its level, dx, dy, z, src, its level, sx, sy, z, w, h and depth.
(def copy_region ((dst int) (dx int) (dy int) (src int) (sx int) (sy int) (w int) (h int)) (list int)
  (cons (virgl_cmd 17 13)
    (cons dst (cons 0 (cons dx (cons dy (cons 0
      (cons src (cons 0 (cons sx (cons sy (cons 0
        (cons w (cons h (cons 1 (nil int))))))))))))))))
