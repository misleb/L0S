; eeprom_test.l0 -- tests of the firmware's command line's messages, and
; of eeprom's arguments.

; The request's first words and its size: 7 words of header and end tag
; and 256 of room, 1052 bytes; "bootloader_config" packed little-endian
; from the seventh, "boot" as 0x746f6f62.
(def test_gencmd_request () int
  (let ws (ee_gencmd_request "bootloader_config")
    (add (check_int "words" (length ws) (ee_gencmd_words))
      (add (check_int "size" (head ws) 1052)
        (add (check_int "tag" (nth ws 2) 196736)
             (check_str "boot" (hex_digits (nth ws 6) 8) "746f6f62"))))))

(def test_gencmd_request_ends () int
  (let ws (ee_gencmd_request "x")
    (add (check_int "end tag" (nth ws (sub (ee_gencmd_words) 1)) 0)
         (check_int "x then zeros" (nth ws 6) 120))))

; The firmware's answer to bootloader_config: the request's words with
; the codes set and the text in the room.
(def answer_of ((code int) (tagcode int) (err int) (text (list int))) (list int)
  (let req (ee_gencmd_request text)
    (cons (head req) (cons code (cons (nth req 2) (cons (nth req 3) (cons tagcode (cons err (drop req 6)))))))))

(def gen_text ((a GenAnswer)) (list int)
  (match a ((GenText t) t) ((GenFailed why) (append "error: " why))))

(def test_gencmd_reply () int
  (check_str "text" (gen_text (ee_gencmd_reply (answer_of 2147483648 2147483660 0 "[all]\nBOOT_ORDER=0xf41\n")))
    "[all]\nBOOT_ORDER=0xf41\n"))

(def test_gencmd_reply_error () int
  (check_str "error" (gen_text (ee_gencmd_reply (answer_of 2147483648 2147483660 1 "")))
    "error: the firmware's command line says error 1"))

(def test_gencmd_reply_refused () int
  (add (check_str "buffer" (gen_text (ee_gencmd_reply (answer_of 2147483649 2147483660 0 "x")))
         "error: the firmware did not take the command")
       (check_str "size" (gen_text (ee_gencmd_reply (cons 0 (nil int))))
         "error: the firmware's answer is the wrong size")))

(def test_with_newline () int
  (add (check_str "added" (ee_with_newline "a=1") "a=1\n")
    (add (check_str "kept" (ee_with_newline "a=1\n") "a=1\n")
         (check_str "empty" (ee_with_newline "") ""))))

(def test_path () int
  (add (check_str "slash" (ee_path "/Volumes/bootfs" "pieeprom.upd") "/Volumes/bootfs/pieeprom.upd")
       (check_str "ends" (ee_path "/Volumes/bootfs/" "pieeprom.sig") "/Volumes/bootfs/pieeprom.sig")))

(def test_usage () int
  (check_int "status" (eeprom_main (split_spaces "show")) 1))

; Under an operating system there is no mailbox.
(def test_eeprom_no_mailbox () int
  (check_int "status" (eeprom_main (nil (list int))) 1))

; Nor any file.
(def test_show_missing () int
  (check_int "status" (eeprom_main (split_spaces "show /no/such.bin")) 1))

; bootloader_version's answer as a Pi 5 gave it (2026-10-27).
(def version_text () (list int)
  "2026/05/26 16:01:25\nversion 086b83e3332dfc8927c56762771d082f3077a1ae (release)\ntimestamp 1779807685\nupdate-time 1792897039\ncapabilities 0x0000007f\n")

(def opt_text ((o (Option int))) (list int)
  (match o ((None) "none") ((Some n) (digits n))))

(def test_update_time_of () int
  (add (check_str "found" (opt_text (ee_update_time_of (lines (version_text)))) "1792897039")
       (check_str "none" (opt_text (ee_update_time_of (lines "timestamp 5\n"))) "none")))

; A clock behind the last update, as with no battery: after the last.
(def test_update_ts () int
  (add (check_int "behind" (ee_update_ts 4140 (Some 1792897039)) 1792897040)
    (add (check_int "ahead" (ee_update_ts 1800000000 (Some 1792897039)) 1800000000)
         (check_int "no firmware" (ee_update_ts 4140 ((None int))) 4140))))
