; eeprom.l0 -- the Raspberry Pi 5's bootloader configuration, which it
; keeps in its EEPROM: read through the firmware, and changed by the
; update the bootloader flashes itself from (pieeprom.l0, bootloader.l0). Its module must
; be flagged dev, for the mailbox.
;
;   eeprom                          the configuration the bootloader is
;                                   running, as vcgencmd
;                                   bootloader_config says it
;   eeprom version                  the bootloader's version, as
;                                   vcgencmd bootloader_version says it
;   eeprom show IMAGE               the configuration in IMAGE, a
;                                   pieeprom.bin
;   eeprom update IMAGE CONFIG DIR  IMAGE with the file CONFIG as its
;                                   configuration, written to DIR as
;                                   pieeprom.upd and pieeprom.sig, which
;                                   the bootloader flashes on the next
;                                   boot from DIR, the card's boot
;                                   partition
;
; The update's time must be later than the last update's for the
; bootloader to take it: it is the clock's, or the last update's and a
; second if the clock is behind that, as with no battery on the RTC.

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "eeprom" why))

; What eeprom takes.
(def eeprom_usage () (list int)
  "usage: eeprom [version | show IMAGE | update IMAGE CONFIG DIR]")

; eeprom with the arguments as: its exit status.
(def eeprom_main ((as (list (list int)))) int
  (if (is_empty as)
      (ee_gencmd_say "bootloader_config")
      (let (w (head as) n (length as))
        (if (and (eq w "version") (eq n 1)) (ee_gencmd_say "bootloader_version")
            (and (eq w "show") (eq n 2)) (ee_show (nth as 1))
            (and (eq w "update") (eq n 4)) (ee_update_files (nth as 1) (nth as 2) (nth as 3))
            (complain (eeprom_usage))))))

; ------------------------------------------------------------- the firmware

; Says the answer to cmd on standard output, ending in a newline: 0, or
; 1 if there is none.
(def ee_gencmd_say ((cmd (list int))) int
  (match (ee_gencmd cmd)
    ((GenFailed why) (complain why))
    ((GenText t) (let w (write_str (ee_with_newline t)) 0))))

; s, ending in a newline if it is not empty.
(def ee_with_newline ((s (list int))) (list int)
  (if (is_empty s) s (eq (last_or s 0) 10) s (append s "\n")))

; The last of xs, or fallback if it is empty.
(def (last_or T) ((xs (list T)) (fallback T)) T
  (if (is_empty xs) fallback (last_or (tail xs) (head xs))))

; ------------------------------------------------------------- images

; Says the configuration in the image at path: 0, or 1 if it has none.
(def ee_show ((path (list int))) int
  (match (read_whole path)
    ((Err why) (complain (append path (append ": " why))))
    ((Ok b)
      (match (ee_config b)
        ((Err why) (complain (append path (append ": " why))))
        ((Ok c) (let w (write_str (ee_with_newline (bytes_to_list c))) 0))))))

; The update of the image at image to the configuration in the file
; conf, written to dir: the image first, so that the bootloader never
; finds a signature without it.
(def ee_update_files ((image (list int)) (conf (list int)) (dir (list int))) int
  (match (read_whole image)
    ((Err why) (complain (append image (append ": " why))))
    ((Ok b)
      (match (read_whole conf)
        ((Err why) (complain (append conf (append ": " why))))
        ((Ok c)
          (let ts (ee_update_ts (ee_clock_seconds) (ee_last_update))
            (if (le ts 0)
                (complain "no clock and no firmware: the update needs a time later than the last, for the bootloader to take it")
                (match (ee_update b c ts)
                  ((Err why) (complain (append image (append ": " why))))
                  ((Ok u) (ee_write_update u dir))))))))))

; Writes u's files to dir: 0, or 1 if either could not be.
(def ee_write_update ((u EeUpdate) (dir (list int))) int
  (match (ee_update_written u dir)
    ((Err why) (complain why))
    ((Ok ps) (let w (write_str (ee_written_line (nth ps 0) (nth ps 1))) 0))))

; What update says once it has written upd and sg.
(def ee_written_line ((upd (list int)) (sg (list int))) (list int)
  (append "eeprom: wrote " (append upd (append " and " (append sg
    "; the bootloader flashes it as the board next boots from there\n")))))
