; conv.l0 -- agentd's conversation, pure: its turns, the person's and the
; model's, each of blocks (a text, a tool's use, a tool's result), and
; the last answer's usage; and the conversation as the Messages API's
; JSON, with its prompt-caching breakpoints. Three cache_control marks
; at most: the system prompt's one block, the last tool's definition,
; and the last block of the last turn, so the prompt and tools are read
; from the cache on every request, and the conversation so far too.

; A turn's block: a text; a tool's use, its id, name and input; or a
; tool's result, the use's id, the text, and whether it failed.
(data Block (BText bytes) (BToolUse bytes bytes Json) (BToolResult bytes bytes bool))

; A turn: the person's (true), whose blocks are texts and tools'
; results, or the model's (false), texts and tools' uses.
(data Turn (Turn bool (list Block)))

; What an answer spent, in tokens: its input, its output, the cache
; written, and the cache read; -1 for a count not yet said.
(data Usage (Usage int int int int))

; A conversation: its turns, newest first, the last answer's usage, and
; the paths of the images shown the person in it, newest first.
(data Conv (Conv (turns (list Turn)) (usage Usage) (images (list bytes))))

; A conversation with nothing in it.
(def conv_new () Conv (Conv (nil Turn) (Usage -1 -1 -1 -1) (nil bytes)))

; The most images a conversation keeps, the newest.
(def conv_images_most () int 64)

; c with the image at path shown, newest; the oldest past the most let
; go.
(def conv_shown ((c Conv) (path bytes)) Conv
  (.images c (take (cons path (.images c)) (conv_images_most))))

; c's turns, oldest first.
(def conv_turns ((c Conv)) (list Turn) (rev (.turns c)))

; c with t its newest turn. A turn of the same side as the newest is
; joined onto it, its blocks after the newest's, since the API takes
; the person's and the model's turns in turn; a turn of no blocks adds
; nothing.
(def conv_add ((c Conv) (t Turn)) Conv
  (match c
    ((Conv ts u ims)
      (match t
        ((Turn who bs)
          (if (is_empty bs) c
              (is_empty ts) (Conv (cons t ts) u ims)
              (match (head ts)
                ((Turn who0 bs0)
                  (if (eq who who0)
                      (Conv (cons (Turn who (append bs0 bs)) (tail ts)) u ims)
                      (Conv (cons t ts) u ims))))))))))

; c with its usage updated by what an MUsage said: each count that is
; not -1 replaces the one before (message_start says them all, then
; message_delta the output so far).
(def conv_spent ((c Conv) (input int) (output int) (cwrite int) (cread int)) Conv
  (match c
    ((Conv ts u ims)
      (match u
        ((Usage i o w r)
          (Conv ts (Usage (or_kept input i) (or_kept output o) (or_kept cwrite w) (or_kept cread r)) ims))))))

; n, unless it is -1, when kept.
(def or_kept ((n int) (kept int)) int (if (eq n -1) kept n))

; The tokens an answer's prompt took: its input, the cache written and
; the cache read, a count not said taken as 0.
(def usage_prompt ((u Usage)) int
  (match u ((Usage i o w r) (add (max i 0) (add (max w 0) (max r 0))))))

; --------------------------------------------------------------- as JSON

; The cache_control field that marks a breakpoint.
(def conv_cache () JField
  (json_field "cache_control" (json_obj (cons (json_field "type" (json_str "ephemeral")) (nil JField)))))

; c's turns as the API's messages, oldest first, the last block of the
; last turn marked for the cache. An empty text block, which the API
; refuses, is left out.
(def conv_messages ((c Conv)) Json
  (JArr (turns_json (.turns c) true (nil Json))))

; ts, newest first, onto acc, each as a message, so oldest first at the
; end: the first (the newest) marked if last.
(def turns_json ((ts (list Turn)) (last bool) (acc (list Json))) (list Json)
  (if (is_empty ts)
      acc
      (turns_json (tail ts) false (cons (turn_json (head ts) last) acc))))

; A turn as a message, its last block marked if last.
(def turn_json ((t Turn) (last bool)) Json
  (match t
    ((Turn who bs)
      (json_obj (cons (json_field "role" (json_str (if who "user" "assistant")))
                  (cons (json_field "content" (JArr (blocks_json (kept_blocks bs (nil Block)) last (nil Json))))
                        (nil JField)))))))

; bs without their empty texts.
(def kept_blocks ((bs (list Block)) (acc (list Block))) (list Block)
  (if (is_empty bs)
      (rev acc)
      (kept_blocks (tail bs) (if (is_empty_text (head bs)) acc (cons (head bs) acc)))))

; Whether b is a text of nothing.
(def is_empty_text ((b Block)) bool
  (match b
    ((BText t) (eq (bytes_len t) 0))
    ((BToolUse id n input) false)
    ((BToolResult id t failed) false)))

; bs as content blocks onto acc, reversed; the last marked if last.
(def blocks_json ((bs (list Block)) (last bool) (acc (list Json))) (list Json)
  (if (is_empty bs)
      (rev acc)
      (blocks_json (tail bs) last
        (cons (block_json (head bs) (and last (is_empty (tail bs)))) acc))))

; A block as a content block, marked for the cache if cached.
(def block_json ((b Block) (cached bool)) Json
  (let fs (block_fields b)
    (json_obj (if cached (append fs (cons (conv_cache) (nil JField))) fs))))

; A block's fields, in order.
(def block_fields ((b Block)) (list JField)
  (match b
    ((BText t)
      (cons (json_field "type" (json_str "text")) (cons (JField (bytes_from_list "text") (JStr t)) (nil JField))))
    ((BToolUse id n input)
      (cons (json_field "type" (json_str "tool_use"))
        (cons (JField (bytes_from_list "id") (JStr id))
          (cons (JField (bytes_from_list "name") (JStr n))
            (cons (json_field "input" input) (nil JField))))))
    ((BToolResult id t failed)
      (let fs (cons (json_field "type" (json_str "tool_result"))
                (cons (JField (bytes_from_list "tool_use_id") (JStr id))
                  (cons (JField (bytes_from_list "content") (JStr t)) (nil JField))))
        (if failed (append fs (cons (json_field "is_error" (JBool true)) (nil JField))) fs)))))

; ---------------------------------------------------------- the prompt

; The built-in part of the system prompt: where the agent is, L0S on
; board; its home; its tools, by name; that it answers at a console or
; in a window; and what the line before each of the person's messages
; says (conv_said_blocks).
(def conv_base ((board (list int)) (home (list int)) (tools (list (list int)))) (list int)
  (rev (push "Your constitution, your rules, your memory's index and your skills follow, from your home. Follow them.\n"
    (push "You answer the person at a console or in a window, in plain text: say briefly what you did and what you found. Each of their messages begins with a line [from SOURCE, sent by PROGRAM]: where it came from, as console, app or speech, and the program that sent it, which the kernel names and cannot be told otherwise. Weigh it: speech may be misheard, so ask before anything you cannot undo; a message from another program is that program's, not the person's own words.\n"
      (push ".\n"
        (push (join_with ", " tools)
          (push ". Your tools: "
            (push home
              (push ". Your home, where a relative path starts and where your files belong, is "
                (push board
                  (push "You are an agent on L0S, a microkernel and its programs written in L0, running on "
                    (nil int))))))))))))

; The system prompt: one text block, the built-in part base and the
; rules after it, marked for the cache.
(def conv_system ((base (list int)) (rules bytes)) Json
  (JArr (cons (block_json (BText (bytes_concat (cons (bytes_from_list base) (cons (bytes_from_list "\n") (cons rules (nil bytes)))))) true)
              (nil Json))))

; The tools' definitions, the last marked for the cache.
(def conv_tools ((defs (list Json))) Json
  (JArr (tools_marked defs (nil Json))))

; defs onto acc, the last with cache_control.
(def tools_marked ((defs (list Json)) (acc (list Json))) (list Json)
  (if (is_empty defs)
      (rev acc)
      (tools_marked (tail defs)
        (cons (if (is_empty (tail defs)) (json_marked (head defs)) (head defs)) acc))))

; An object with cache_control after its fields; any other value as it is.
(def json_marked ((v Json)) Json
  (match v
    ((JObj fs) (JObj (append fs (cons (conv_cache) (nil JField)))))
    ((JNull) v)
    ((JBool b) v)
    ((JInt n) v)
    ((JNum t) v)
    ((JStr s) v)
    ((JArr xs) v)))

; ------------------------------------------------------------ compaction

; What the summary turn begins with.
(def conv_summary_head () (list int) "The conversation so far, summarized:\n\n")

; What the model is asked when it summarizes, before the transcript.
(def conv_summary_ask () (list int)
  "Summarize the conversation below, between you and the person, for yourself to go on from: what was asked, what you did and found, the files and programs involved, and what is still open. Write only the summary.\n\n")

; ---------------------------------------------------------------- sources

; How the line that says where a person's text came from begins: the
; first of their turn's blocks, before the text.
(def conv_source_head () (list int) "[from ")

; A person's turn's blocks: a line saying where text came from, source
; as the client named it and the program that sent it, then text.
(def conv_said_blocks ((source (list int)) (program (list int)) (text bytes)) (list Block)
  (cons (BText (bytes_from_list (append (conv_source_head) (append source (append ", sent by " (append program "]"))))))
    (cons (BText text) (nil Block))))

; The source a block's text t names, if it is a source line: the word
; after its head, up to the comma.
(def conv_source_of ((t bytes)) (Option (list int))
  (if (not (bytes_is_at t 0 (conv_source_head)))
      ((None (list int)))
      (let rest (bytes_to_list (bytes_slice t (length (conv_source_head)) (bytes_len t)))
        (Some (up_to 44 rest)))))

; Whether t is a turn of the person's own text: theirs, with a text,
; and no tool's result, so that nothing before it awaits an answer in
; it.
(def is_person_text ((t Turn)) bool
  (match t ((Turn who bs) (and who (and (has_text bs) (not (has_result bs)))))))

; Whether bs has a text, and a tool's result.
(def has_text ((bs (list Block)) ) bool
  (if (is_empty bs) false (match (head bs) ((BText s) true) ((BToolUse i n v) (has_text (tail bs))) ((BToolResult i s f) (has_text (tail bs))))))
(def has_result ((bs (list Block))) bool
  (if (is_empty bs) false (match (head bs) ((BText s) (has_result (tail bs))) ((BToolUse i n v) (has_result (tail bs))) ((BToolResult i s f) true))))

; How many of c's turns, oldest first, compaction summarizes, keeping
; the last keep: the cut moved earlier until the turn after it is the
; person's own text, so a tool's use is never parted from its result;
; 0 if there is no such cut, too few turns to cut.
(def conv_cut ((c Conv) (keep int)) int
  (let ts (conv_turns c)
    (cut_back ts (sub (length ts) (max keep 0)))))

; cut_back's walk: k, or before it, where the turn at k is the person's
; own text; 0 once k is below 1.
(def cut_back ((ts (list Turn)) (k int)) int
  (if (lt k 1) 0
      (is_person_text (nth ts k)) k
      (cut_back ts (sub k 1))))

; c's oldest k turns, as the transcript the model summarizes: who said
; each, its texts, its tools' uses and results, each result cut to
; conv_result_brief bytes.
(def conv_transcript ((c Conv) (k int)) bytes
  (bytes_concat (rev (transcript_turns (take (conv_turns c) k) (nil bytes)))))

; The most of a result a transcript holds.
(def conv_result_brief () int 2000)

; ts onto acc, reversed, each a header line and its blocks.
(def transcript_turns ((ts (list Turn)) (acc (list bytes))) (list bytes)
  (if (is_empty ts)
      acc
      (match (head ts)
        ((Turn who bs)
          (transcript_turns (tail ts)
            (transcript_blocks bs (cons (bytes_from_list (if who "The person:\n" "You:\n")) acc)))))))

; bs onto acc, reversed, each on lines of its own.
(def transcript_blocks ((bs (list Block)) (acc (list bytes))) (list bytes)
  (if (is_empty bs)
      (cons (bytes_from_list "\n") acc)
      (transcript_blocks (tail bs)
        (match (head bs)
          ((BText t) (cons (bytes_from_list "\n") (cons t acc)))
          ((BToolUse id n v)
            (cons (bytes_from_list "]\n") (cons (json_bytes v) (cons (bytes_from_list " ") (cons n (cons (bytes_from_list "[tool ") acc))))))
          ((BToolResult id t f)
            (cons (bytes_from_list "\n")
              (cons (if (le (bytes_len t) (conv_result_brief)) t (bytes_slice t 0 (conv_result_brief)))
                (cons (bytes_from_list (if f "[result, failed]\n" "[result]\n")) acc))))))))

; The messages of the request that asks for c's oldest k turns
; summarized: one turn of the person's, the ask and the transcript.
(def conv_summary_messages ((c Conv) (k int)) Json
  (conv_messages (conv_add (conv_new)
    (Turn true (cons (BText (bytes_concat (cons (bytes_from_list (conv_summary_ask)) (cons (conv_transcript c k) (nil bytes)))))
                     (nil Block))))))

; c with its oldest k turns replaced by summary: the person's turn,
; conv_summary_head and the summary, then the turns kept, the first of
; which, the person's own text, joins it; the usage not known until the
; next answer says it; the images shown kept.
(def conv_compacted ((c Conv) (k int) (summary bytes)) Conv
  (adds (conv_add (.images (conv_new) (.images c))
                  (Turn true (cons (BText (bytes_concat (cons (bytes_from_list (conv_summary_head)) (cons summary (nil bytes)))))
                                   (nil Block))))
        (drop (conv_turns c) k)))

; Each of ts added to c, in order.
(def adds ((c Conv) (ts (list Turn))) Conv
  (if (is_empty ts) c (adds (conv_add c (head ts)) (tail ts))))

; ---------------------------------------------------------------- kept

; The conversation as its file keeps it: the conversation; when it
; began, the clock's seconds (0 with no clock); and how many times the
; person has said something in it, 0 for one not begun.
(data ConvKept (ConvKept (conv Conv) (began int) (said int)))

; A conversation not begun.
(def conv_kept_new () ConvKept (ConvKept (conv_new) 0 0))

; k as its file's bytes: a JSON object of when it began, how many times
; the person spoke, the last answer's usage as four counts, the paths of
; the images shown, oldest first, and the turns as the API's messages,
; with no breakpoints.
(def conv_kept_bytes ((k ConvKept)) bytes
  (let c (.conv k)
    (json_bytes
      (json_obj (cons (json_field "began" (JInt (.began k)))
                  (cons (json_field "said" (JInt (.said k)))
                    (cons (json_field "usage" (usage_json (.usage c)))
                      (cons (json_field "images" (JArr (images_json (.images c) (nil Json))))
                        (cons (json_field "messages" (JArr (turns_json (.turns c) false (nil Json))))
                              (nil JField))))))))))

; Paths, newest first, as JSON strings onto acc: oldest first.
(def images_json ((ps (list bytes)) (acc (list Json))) (list Json)
  (if (is_empty ps) acc (images_json (tail ps) (cons (JStr (head ps)) acc))))

; The paths the file's object o keeps as the images shown, oldest first
; there, newest first here; none if it keeps none.
(def kept_images ((o Json)) (list bytes)
  (match (json_get o "images")
    ((None) (nil bytes))
    ((Some a) (kept_texts (json_items a) (nil bytes)))))

; Each of vs that is a string, onto acc reversed.
(def kept_texts ((vs (list Json)) (acc (list bytes))) (list bytes)
  (if (is_empty vs)
      acc
      (kept_texts (tail vs) (match (json_text (head vs)) ((Some t) (cons t acc)) ((None) acc)))))

; A usage as an array of its four counts.
(def usage_json ((u Usage)) Json
  (match u
    ((Usage i o w r) (JArr (cons (JInt i) (cons (JInt o) (cons (JInt w) (cons (JInt r) (nil Json)))))))))

; The file's bytes b read back, or why they are not a conversation.
(def conv_kept_of ((b bytes)) (Result ConvKept (list int))
  (match (json_whole b 0 (bytes_len b))
    ((Err why) ((Err ConvKept (list int)) why))
    ((Ok v)
      (match (json_get v "messages")
        ((None) ((Err ConvKept (list int)) "no messages"))
        ((Some ms)
          (match (kept_turns (json_items ms) (conv_new))
            ((Err why) ((Err ConvKept (list int)) why))
            ((Ok c)
              ((Ok ConvKept (list int))
                (ConvKept (.images (.usage c (kept_usage v)) (kept_images v)) (kept_int v "began" 0) (kept_int v "said" 0))))))))))

; The number of o's field name, or fallback if it has none.
(def kept_int ((o Json) (name (list int)) (fallback int)) int
  (match (json_get o name)
    ((None) fallback)
    ((Some v) (match (json_int v) ((Some n) n) ((None) fallback)))))

; The text of o's field name, empty if it has none.
(def kept_text ((o Json) (name (list int))) bytes
  (match (json_get o name)
    ((None) (bytes_from_list (nil int)))
    ((Some v) (match (json_text v) ((Some t) t) ((None) (bytes_from_list (nil int)))))))

; The usage the file's object o keeps, each count not there -1.
(def kept_usage ((o Json)) Usage
  (let u (match (json_get o "usage") ((None) (JArr (nil Json))) ((Some a) a))
    (Usage (usage_count u 0) (usage_count u 1) (usage_count u 2) (usage_count u 3))))

; The usage array u's count i, or -1.
(def usage_count ((u Json) (i int)) int
  (match (json_at u i)
    ((None) -1)
    ((Some v) (match (json_int v) ((Some n) n) ((None) -1)))))

; The messages ms, in order, added to c as its turns; or why one is not
; a turn.
(def kept_turns ((ms (list Json)) (c Conv)) (Result Conv (list int))
  (if (is_empty ms)
      ((Ok Conv (list int)) c)
      (match (kept_turn (head ms))
        ((Err why) ((Err Conv (list int)) why))
        ((Ok t) (kept_turns (tail ms) (conv_add c t))))))

; A message as a turn: its role the person's (user) or the model's
; (assistant), its content's blocks.
(def kept_turn ((m Json)) (Result Turn (list int))
  (let (role (bytes_to_list (kept_text m "role"))
        content (match (json_get m "content") ((None) (nil Json)) ((Some a) (json_items a))))
    (if (not (or (eq role "user") (eq role "assistant")))
        ((Err Turn (list int)) "a message of no role")
        (match (kept_content content (nil Block))
          ((Err why) ((Err Turn (list int)) why))
          ((Ok bs) ((Ok Turn (list int)) (Turn (eq role "user") bs)))))))

; The content blocks vs as blocks, onto acc reversed; then in order. A
; text, a tool's use or a tool's result; any other type is why not.
(def kept_content ((vs (list Json)) (acc (list Block))) (Result (list Block) (list int))
  (if (is_empty vs)
      ((Ok (list Block) (list int)) (rev acc))
      (let (v (head vs)
            kind (bytes_to_list (kept_text v "type")))
        (if (eq kind "text")
            (kept_content (tail vs) (cons (BText (kept_text v "text")) acc))
            (eq kind "tool_use")
            (kept_content (tail vs) (cons (BToolUse (kept_text v "id") (kept_text v "name") (kept_input v)) acc))
            (eq kind "tool_result")
            (kept_content (tail vs) (cons (BToolResult (kept_text v "tool_use_id") (kept_text v "content") (kept_failed v)) acc))
            ((Err (list Block) (list int)) (append "a block of type " kind))))))

; A tool's use's input, {} if it has none.
(def kept_input ((v Json)) Json
  (match (json_get v "input") ((None) (json_obj (nil JField))) ((Some x) x)))

; Whether a tool's result says it failed.
(def kept_failed ((v Json)) bool
  (match (json_get v "is_error") ((None) false) ((Some x) (match (json_bool x) ((Some f) f) ((None) false)))))

; What the log says of k, read from path: how many turns it has, and
; how many times the person spoke.
(def conv_kept_line ((path (list int)) (k ConvKept)) (list int)
  (append "the conversation from " (append path (append ": " (append (digits (length (.turns (.conv k))))
    (append " turns, " (append (digits (.said k)) " said")))))))
