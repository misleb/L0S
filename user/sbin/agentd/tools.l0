; tools.l0 -- agentd's tools: their definitions, as the model is told
; them; the file tools, read_file, write_file, list_dir, make_dir,
; remove, rename, file_info and volumes; and run and sh, which start a program, agentd its terminal, and give
; back its exit status and what it wrote (a Run, pure, keeps that).
; Each takes its input as JSON and answers a text, or a failure the
; model reads (a ToolAnswer). A relative path is from the agent's home,
; the configuration's home (/Volumes/data/agent if none); any path is
; taken, and programs are started as a shell would, since the agent's
; limits are its rules, not enforced here.

; ------------------------------------------------------- configuration

; The absolute path p names: a relative one from home. The home itself
; is the configuration's (agenthome.l0's home_of).
(def tool_path ((home (list int)) (p (list int))) (list int)
  (path_resolve home p))

; ------------------------------------------------------------ answering

; The most a tool gives back of a file, or of what a program wrote.
(def tool_max () int 65536)

; An answer, of text, and a failure, of words.
(def tool_ok ((text bytes)) ToolAnswer (ToolAnswer text false))
(def tool_failed ((why (list int))) ToolAnswer (ToolAnswer (bytes_from_list why) true))

; b as text the model can be sent: each byte that is not part of UTF-8
; a question mark, since a JSON string must be UTF-8; b itself if it
; all is.
(def tool_text ((b bytes)) bytes
  (if (utf8_from b 0 (bytes_len b))
      b
      (bytes_from_list (rev (utf8_clean b 0 (bytes_len b) (nil int))))))

; Whether b from i to j is all text: ASCII or well-formed UTF-8.
(def utf8_from ((b bytes) (i int) (j int)) bool
  (if (ge i j)
      true
      (let n (utf8_len b i j)
        (if (eq n 0) false (utf8_from b (add i n) j)))))

; How many bytes the character at i is: 1 for ASCII, control characters
; too (JSON escapes them), 2 to 4 for UTF-8's sequences; 0 if none.
(def utf8_len ((b bytes) (i int) (j int)) int
  (if (lt (bytes_get b i) 128) 1 (json_char_len b i j)))

; b from i to j onto acc, reversed, each byte not of text a ?.
(def utf8_clean ((b bytes) (i int) (j int) (acc (list int))) (list int)
  (if (ge i j)
      acc
      (let n (utf8_len b i j)
        (if (eq n 0)
            (utf8_clean b (add i 1) j (cons 63 acc))
            (utf8_clean b (add i n) j (rev_onto (bytes_to_list (bytes_slice b i (add i n))) acc))))))

; b, at most tool_max bytes of it, cut where a character starts, and if
; cut, a line saying how much more there was.
(def tool_cut ((b bytes)) bytes
  (let n (bytes_len b)
    (if (le n (tool_max))
        (tool_text b)
        (let k (char_start b (tool_max))
          (bytes_concat (cons (tool_text (bytes_slice b 0 k))
                          (cons (bytes_from_list (append "\n[cut: " (append (digits (sub n k)) " more bytes]\n")))
                                (nil bytes))))))))

; k, or before it, where a character starts: not a UTF-8 continuation
; byte, at most three back.
(def char_start ((b bytes) (k int)) int
  (char_back b k 3))

; char_start's loop: back from k while it is a continuation byte, at
; most left more.
(def char_back ((b bytes) (k int) (left int)) int
  (if (or (eq left 0) (le k 0)) k
      (eq (bit_and (bytes_get b k) 192) 128) (char_back b (sub k 1) (sub left 1))
      k))

; ------------------------------------------------------------ the input

; The string field name of input, or none.
(def tool_str ((input Json) (name (list int))) (Option (list int))
  (match (json_get input name)
    ((None) ((None (list int))))
    ((Some v) (match (json_text v) ((None) ((None (list int)))) ((Some t) (Some (bytes_to_list t)))))))

; --------------------------------------------------------------- dispatch

; Whether name is one of the file tools.
(def is_file_tool ((name (list int))) bool
  (any_eq name (split_spaces "read_file write_file list_dir make_dir remove rename file_info volumes")))

; The file tool name done with input, its paths from home; a write in
; home kept in its history as conv's, at now. A write to the home's
; fixed part is refused before anything is touched.
(def tool_file ((home (list int)) (name (list int)) (input Json) (conv (list int)) (now int)) ToolAnswer
  (if (eq name "volumes") (volumes_told (fs_volumes))
      (eq name "rename") (rename_tool home input conv now)
      (match (tool_str input "path")
        ((None) (tool_failed "path is missing, or not a string"))
        ((Some p)
          (let (path (tool_path home p)
                writes (any_eq name (split_spaces "write_file make_dir remove")))
            (if (and writes (home_fixed home path)) (fixed_refused path)
                (eq name "read_file") (read_file path)
                (eq name "write_file") (write_file home path (json_get input "content") conv now)
                (eq name "list_dir") (list_dir path)
                (eq name "make_dir") (make_dir home path conv now)
                (eq name "remove") (remove_path home path conv now)
                (eq name "file_info") (file_info path)
                (tool_failed (append "no tool " name))))))))

; A write to the home's fixed part, at path, refused.
(def fixed_refused ((path (list int))) ToolAnswer
  (tool_failed (append path ": is fixed: the constitution and the history are not yours to change")))

; read_file: the file's text, cut at tool_max bytes.
(def read_file ((path (list int))) ToolAnswer
  (match (read_whole path)
    ((Err why) (tool_failed (append path (append ": " why))))
    ((Ok b) (tool_ok (tool_cut b)))))

; write_file: the file made to hold content, anew; its directory must be
; there. In home, the write is kept in its history (agenthome.l0).
(def write_file ((home (list int)) (path (list int)) (content (Option Json)) (conv (list int)) (now int)) ToolAnswer
  (match content
    ((None) (tool_failed "content is missing"))
    ((Some v)
      (match (json_text v)
        ((None) (tool_failed "content is not a string"))
        ((Some b)
          (let why (home_write home path b conv now)
            (if (is_empty why)
                (tool_ok (bytes_from_list (append "wrote " (append (digits (bytes_len b)) (append " bytes to " path)))))
                (tool_failed (append path (append ": " why))))))))))

; list_dir: a line for each entry, NAME SIZE, a directory's NAME/; from
; its file server on a volume, else the initramfs's.
(def list_dir ((path (list int))) ToolAnswer
  (if (on_initramfs path)
      (list_root path (root_paths))
      (match (fs_list path)
        ((FsFiles files) (tool_ok (bytes_from_list (stat_lines files (nil int)))))
        ((FsListRefused code) (tool_failed (append path (append ": " (io_error code))))))))

; The entries' lines onto acc, reversed, then the whole in order.
(def stat_lines ((files (list FsStat)) (acc (list int))) (list int)
  (if (is_empty files)
      (rev acc)
      (match (head files)
        ((FsStat name size)
          (stat_lines (tail files)
            (push "\n" (if (is_dir_name name) (push name acc) (push (digits size) (push " " (push name acc))))))))))

; Whether a name is a directory's, ending in /.
(def is_dir_name ((name (list int))) bool
  (and (not (is_empty name)) (eq (last name) 47)))

; A directory of the initramfs, among names: its entries, without sizes.
(def list_root ((path (list int)) (names (list (list int)))) ToolAnswer
  (let kids (entry_children names path)
    (if (and (is_empty kids) (not (any_eq (append path "/") names)))
        (tool_failed (append path ": no such directory"))
        (tool_ok (bytes_from_list (join_lines kids))))))

; Each of ws on a line.
(def join_lines ((ws (list (list int)))) (list int)
  (rev (join_lines_onto ws (nil int))))

; join_lines's loop: each of ws and a newline onto acc, reversed.
(def join_lines_onto ((ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws) acc (join_lines_onto (tail ws) (push "\n" (push (head ws) acc)))))

; make_dir: a directory made at path, on a volume; in home, kept in its
; history.
(def make_dir ((home (list int)) (path (list int)) (conv (list int)) (now int)) ToolAnswer
  (if (on_initramfs path)
      (tool_failed (append path ": the initramfs cannot be changed"))
      (let why (home_mkdir home path conv now)
        (if (is_empty why)
            (tool_ok (bytes_from_list (append "made " path)))
            (tool_failed (append path (append ": " why)))))))

; What is at path, as its file server's stat says: a directory, a file
; of a size and whether it is a program, or the code it refused with.
(def path_kind ((path (list int))) FsKind
  (match (fs_path_ask "stat" path "")
    ((FsReply w rest) (if (lt w 0) (FsNoKind w) (fs_kind_of rest)))))

; file_info: what is at path, a directory or a file, its size, and
; whether it is a program; on the initramfs, while / is it, which of the
; two it is.
(def file_info ((path (list int))) ToolAnswer
  (if (on_initramfs path)
      (let names (root_paths)
        (if (any_eq path names) (tool_ok (bytes_from_list (append path ": a file, on the initramfs")))
            (any_eq (append path "/") names) (tool_ok (bytes_from_list (append path ": a directory, on the initramfs")))
            (tool_failed (append path ": nothing is there"))))
      (match (path_kind path)
        ((FsIsDir) (tool_ok (bytes_from_list (append path ": a directory"))))
        ((FsIsFile size exec)
          (tool_ok (bytes_from_list (append path (append ": a file of " (append (digits size) (if exec " bytes, a program" " bytes")))))))
        ((FsNoKind code) (tool_failed (append path (append ": " (io_error code))))))))

; show_image's check of the file at path: nothing if it is a PNG, by
; its first 8 bytes, which are all of it read; else why not.
(def image_refused ((path (list int))) (list int)
  (match (open_in path)
    ((IoFailed fault why) (append path (append ": " why)))
    ((IoOpened f)
      (let (got (file_read_some f 8) c (file_close f))
        (match got
          ((IoReadFailed code) (append path (append ": " (io_error code))))
          ((IoBytes b)
            (if (and (eq (bytes_len b) 8) (eq (bytes_to_list b) (png_magic))) "" (append path ": not a PNG"))))))))

; The eight bytes every PNG starts with.
(def png_magic () (list int) (cons 137 (cons 80 (cons 78 (cons 71 (cons 13 (cons 10 (cons 26 (cons 10 (nil int))))))))))

; Whether name is show_image's.
(def is_image_tool ((name (list int))) bool (eq name "show_image"))

; show_image's definition.
(def image_tool_defs () (list Json)
  (cons (tool_def "show_image" "Show the person a PNG image, in the Agent app's Images pane beside the conversation: one you made, or found. A build_app's previews are shown already."
          (cons (path_prop "The PNG") (nil JField)))
        (nil Json)))

; remove: the file at path removed, or the directory if it is empty; in
; home, kept in its history, so it can be undone.
(def remove_path ((home (list int)) (path (list int)) (conv (list int)) (now int)) ToolAnswer
  (if (on_initramfs path)
      (tool_failed (append path ": the initramfs cannot be changed"))
      (let (inside (home_inside home path)
            why (match (path_kind path)
                  ((FsIsDir) (if inside (home_rmdir home path conv now) (removed_why (fs_removed path) true)))
                  ((FsIsFile size exec) (if inside (home_remove home path conv now) (removed_why (fs_removed path) false)))
                  ((FsNoKind code) (io_error code))))
        (if (is_empty why)
            (tool_ok (bytes_from_list (append "removed " path)))
            (tool_failed (append path (append ": " why)))))))

; Why removing failed, its code from fs; nothing for 0. A directory's -4
; is that it is not empty.
(def removed_why ((code int) (dir bool)) (list int)
  (if (eq code 0) ""
      (and dir (eq code -4)) "it is not empty"
      (io_error code)))

; rename: the file or directory at from given the name to, on the same
; volume. A file in home, or going into it, is written anew at to and
; removed at from, each kept in its history, so either can be undone; a
; directory there is refused, as the history keeps files.
(def rename_tool ((home (list int)) (input Json) (conv (list int)) (now int)) ToolAnswer
  (match (tool_str input "from")
    ((None) (tool_failed "from is missing, or not a string"))
    ((Some f)
      (match (tool_str input "to")
        ((None) (tool_failed "to is missing, or not a string"))
        ((Some t)
          (let (from (tool_path home f)
                to (tool_path home t)
                kept (or (home_inside home from) (home_inside home to)))
            (if (home_fixed home from) (fixed_refused from)
                (home_fixed home to) (fixed_refused to)
                (or (on_initramfs from) (on_initramfs to)) (tool_failed "the initramfs cannot be changed")
                (match (path_kind from)
                  ((FsNoKind code) (tool_failed (append from (append ": " (io_error code)))))
                  ((FsIsDir) (if kept (tool_failed (append from ": a directory in your home is not renamed, as its history keeps files: make the new one and rename each file into it")) (renamed from to)))
                  ((FsIsFile size exec) (if kept (renamed_kept home from to conv now) (renamed from to)))))))))))

; The file or directory at from renamed to, by the kernel's rename.
(def renamed ((from (list int)) (to (list int))) ToolAnswer
  (match (rename_file from to)
    ((Done) (tool_ok (bytes_from_list (append "renamed " (append from (append " to " to))))))
    ((NotDone fault why) (tool_failed (append from (append ": " why))))))

; The file at from written anew at to and removed at from, each kept in
; home's history where it is in home.
(def renamed_kept ((home (list int)) (from (list int)) (to (list int)) (conv (list int)) (now int)) ToolAnswer
  (match (read_whole from)
    ((Err why) (tool_failed (append from (append ": " why))))
    ((Ok b)
      (let w (home_write home to b conv now)
        (if (not (is_empty w))
            (tool_failed (append to (append ": " w)))
            (let r (if (home_inside home from) (home_remove home from conv now) (removed_why (fs_removed from) false))
              (if (is_empty r)
                  (tool_ok (bytes_from_list (append "renamed " (append from (append " to " to)))))
                  (tool_failed (append "wrote " (append to (append ", but " (append from (append " is still there: " r)))))))))))))

; volumes: a line for each volume mounted, its path, its size and what
; is free, and its files, by its file server's df.
(def volumes_told ((vols (list (list int)))) ToolAnswer
  (if (is_empty vols)
      (tool_ok (bytes_from_list "no volumes are mounted"))
      (tool_ok (bytes_from_list (join_lines (volume_lines vols (nil (list int))))))))

; Each volume's line onto acc, reversed; then in order.
(def volume_lines ((vols (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty vols)
      (rev acc)
      (volume_lines (tail vols) (cons (volume_line (head vols) (fs_df (head vols))) acc))))

; A volume's line, as df said its space: clusters of 4096 bytes.
(def volume_line ((vol (list int)) (space FsSpace)) (list int)
  (match space
    ((FsSpace sectors clusters free files)
      (append vol (append ": " (append (format_size (mul clusters 4096)) (append ", " (append (format_size (mul free 4096)) (append " free, " (append (digits files) " files"))))))))
    ((FsSpaceRefused code) (append vol (append ": " (io_error code))))))

; ------------------------------------------------------------ definitions

; A tool's definition: its name, what it does, and its input's JSON
; Schema, an object of the properties given, all of them required.
(def tool_def ((name (list int)) (what (list int)) (props (list JField))) Json
  (tool_def_needing name what props (prop_names props (nil Json))))

; The same, needing only the properties named in required.
(def tool_def_needing ((name (list int)) (what (list int)) (props (list JField)) (required (list Json))) Json
  (json_obj (cons (json_field "name" (json_str name))
              (cons (json_field "description" (json_str what))
                (cons (json_field "input_schema"
                        (json_obj (cons (json_field "type" (json_str "object"))
                                    (cons (json_field "properties" (json_obj props))
                                      (cons (json_field "required" (JArr required)) (nil JField))))))
                      (nil JField))))))

; The names of props, as JSON strings, in order.
(def prop_names ((props (list JField)) (acc (list Json))) (list Json)
  (if (is_empty props)
      (rev acc)
      (match (head props) ((JField n v) (prop_names (tail props) (cons (JStr n) acc))))))

; A property of type ty, described.
(def tool_prop ((name (list int)) (ty (list int)) (what (list int))) JField
  (json_field name (json_obj (cons (json_field "type" (json_str ty))
                               (cons (json_field "description" (json_str what)) (nil JField))))))

; The path property, said of what it names.
(def path_prop ((what (list int))) JField
  (tool_prop "path" "string" (append what "; a relative path is from your home")))

; The file tools' definitions.
(def file_tool_defs () (list Json)
  (cons (tool_def "read_file" "Read a file's text, at most 64 KB of it; it says so if cut."
          (cons (path_prop "The file") (nil JField)))
    (cons (tool_def "write_file" "Make a file hold content, anew; its directory must be there."
            (cons (path_prop "The file") (cons (tool_prop "content" "string" "What the file is to hold") (nil JField))))
      (cons (tool_def "list_dir" "List a directory: a line NAME SIZE for each file, NAME/ for each directory."
              (cons (path_prop "The directory") (nil JField)))
        (cons (tool_def "make_dir" "Make a directory, on a volume; the one it is in must be there."
                (cons (path_prop "The directory") (nil JField)))
          (cons (tool_def "remove" "Remove a file, or a directory if it is empty. In your home, it can be undone with agent undo."
                  (cons (path_prop "The file or directory") (nil JField)))
            (cons (tool_def "rename" "Give a file or directory another name or place, on the same volume; the directory it goes into must be there."
                    (cons (tool_prop "from" "string" "Its name now; a relative path is from your home")
                      (cons (tool_prop "to" "string" "Its new name; a relative path is from your home") (nil JField))))
              (cons (tool_def "file_info" "Say what is at a path: a directory, or a file, its size, and whether it is a program."
                      (cons (path_prop "The path") (nil JField)))
                (cons (tool_def "volumes" "List the volumes mounted, /Volumes/LABEL, with their size, what is free and how many files." (nil JField))
                      (nil Json))))))))))

; The definitions of run and sh.
(def run_tool_defs () (list Json)
  (cons (tool_def_needing "run"
          "Run a program, as the shell's run finds it (/bin/NAME, /sbin/NAME, an app's, or a path), in your home, with args in place of its own; it gives exit N, then what it wrote, at most 64 KB. One still running after the time allowed is ended."
          (cons (tool_prop "program" "string" "The program: a name, or a path, a relative one from your home")
            (cons (json_field "args" (json_obj (cons (json_field "type" (json_str "array"))
                                                 (cons (json_field "items" (json_obj (cons (json_field "type" (json_str "string")) (nil JField))))
                                                   (cons (json_field "description" (json_str "Its arguments, each a word")) (nil JField))))))
                  (nil JField)))
          (cons (json_str "program") (nil Json)))
    (cons (tool_def "sh"
            "Run a line of the L0S shell's commands (help lists them; a program runs only as run NAME), as /bin/sh -c LINE, in your home; it gives exit N, then what it wrote, as run does."
            (cons (tool_prop "command" "string" "The line") (nil JField)))
          (nil Json))))

; Every tool's definition: the file tools', run's and sh's, then the
; desktop's and the clock's (desk.l0), then build_app's (build.l0), then
; show_image's.
(def tool_defs () (list Json)
  (append (file_tool_defs) (append (run_tool_defs) (append (desk_tool_defs) (append (build_tool_defs) (image_tool_defs))))))

; Every tool's name, as the system prompt lists them.
(def tool_names () (list (list int))
  (append (split_spaces "read_file write_file list_dir make_dir remove rename file_info volumes run sh") (append (desk_tool_names) (split_spaces "build_app show_image"))))

; ------------------------------------------------------ running programs

; How long a program may run, in seconds, if the configuration says
; nothing.
(def run_timeout_default () int 60)

; How long a program may run, the configuration text's run_timeout, or
; the default.
(def tool_run_timeout ((text (list int))) int
  (let t (home_conf text "run_timeout")
    (if (is_number t) (int_prefix t 0) (run_timeout_default))))

; A program running: its pid; the port that is its terminal and is told
; of its exit; what it wrote, the pieces kept reversed, how many bytes
; kept and how many dropped past tool_max; the time on clock_ns past
; which it is ended; its exit status, once it has exited; and whether it
; was ended for running too long.
(data Run (Run (pid int) (port int) (o (list bytes)) (k int) (d int) (deadline int) (status (Option int)) (e bool)))

; A program just started as pid, its terminal port, to end at deadline.
(def run_new ((pid int) (port int) (deadline int)) Run
  (Run pid port (nil bytes) 0 0 deadline ((None int)) false))

; A message to send in answer, as a terminal answers: its port and
; payload.
(data RunSend (RunSend int (list int)))

; What run_heard gives: the run after a message, and what to send.
(data RunHeard (RunHeard Run (list RunSend)))

; r after m, which came on its port: its exit notice, the status kept;
; or a request to its terminal (tty.l0's protocol): w with no reply
; port, what it wrote, kept; r, a line, answered with the end of input
; at once; p answered tty, so the asker learns agentd's pid; i, Ctrl-C's
; notices, of which none will come. Anything else is passed over.
(def run_heard ((r Run) (m Message)) RunHeard
  (match r
    ((Run pid port out kept dropped dl st ended)
      (match (exit_of m)
        ((Exited p s)
          (RunHeard (if (eq p pid) (Run pid port out kept dropped dl (Some s) ended) r) (nil RunSend)))
        ((NotExit)
          (match m
            ((RecvFailed) (RunHeard r (nil RunSend)))
            ((Message from b) (run_terminal r b))))))))

; r after the request in a message's bytes b, to its terminal.
(def run_terminal ((r Run) (b bytes)) RunHeard
  (if (run_is_write b)
      (RunHeard (run_kept r b (add (header_len) 5) (bytes_len b)) (nil RunSend))
      (let reply (msg_reply b)
        (if (or (lt reply 1) (not (eq (msg_len b) 5)))
            (RunHeard r (nil RunSend))
            (let op (msg_byte b 4)
              (if (eq op 114) (RunHeard r (cons (RunSend reply (nil int)) (nil RunSend)))
                  (eq op 112) (RunHeard r (cons (RunSend reply "tty") (nil RunSend)))
                  (RunHeard r (nil RunSend))))))))

; Whether a message's bytes b are bytes to write: no reply port, then w.
(def run_is_write ((b bytes)) bool
  (and (gt (msg_len b) 4) (and (eq (msg_u32 b 0) 0) (eq (msg_byte b 4) 119))))

; r with b's bytes from i to j kept, as many as fit in tool_max, the
; rest counted as dropped.
(def run_kept ((r Run) (b bytes) (i int) (j int)) Run
  (match r
    ((Run pid port out kept dropped dl st ended)
      (let (n (sub j i)
            k (min n (max 0 (sub (tool_max) kept))))
        (Run pid port (if (gt k 0) (cons (bytes_slice b i (add i k)) out) out)
             (add kept k) (add dropped (sub n k)) dl st ended)))))

; r ended for running past its deadline.
(def run_ended ((r Run)) Run
  (.e r true))

; r given up on, its port failing: its status taken as -1.
(def run_lost ((r Run)) Run
  (.status r (Some -1)))

; A run's result: that it was ended if it ran too long, exit N, then what
; it wrote, and how much more was dropped; failed unless it exited 0.
(def run_result ((r Run)) ToolAnswer
  (match r
    ((Run pid port out kept dropped dl st ended)
      (let (status (match st ((Some s) s) ((None) -1))
            head (append (if ended "ended: still running when its time was up\n" "")
                         (append "exit " (append (digits status) "\n"))))
        (ToolAnswer
          (bytes_concat (cons (bytes_from_list head)
                          (cons (tool_text (bytes_concat (rev out)))
                            (cons (bytes_from_list (if (gt dropped 0) (append "\n[dropped: " (append (digits dropped) " more bytes]\n")) ""))
                                  (nil bytes)))))
          (or ended (not (eq status 0))))))))

; ------------------------------------------------- starting and waiting

; Whether name is run or sh.
(def is_run_tool ((name (list int))) bool
  (any_eq name (split_spaces "run sh")))

; What starting run or sh came to: the program running, or the tool's
; answer at once, a failure, as when no program is found.
(data RunStart (RunGoing Run) (RunRefused ToolAnswer))

; The tool run or sh begun with input: the program started in home, its
; terminal port, agentd's, which is told of its exit and its deadline,
; timeout seconds from now, and back given back as agentd's own terminal
; after the start (0 for the kernel's). agentd then feeds what comes to
; port to run_heard until the program has exited.
(def tool_run_start ((home (list int)) (name (list int)) (input Json) (timeout int) (back int) (port int)) RunStart
  (if (eq name "sh")
      (match (tool_str input "command")
        ((None) (RunRefused (tool_failed "command is missing, or not a string")))
        ((Some line) (run_program home "/bin/sh" (cons "-c" (cons line (nil (list int)))) timeout back port)))
      (match (tool_str input "program")
        ((None) (RunRefused (tool_failed "program is missing, or not a string")))
        ((Some p) (run_program home p (run_args input) timeout back port)))))

; The args of run's input, its strings; none if there are none.
(def run_args ((input Json)) (list (list int))
  (match (json_get input "args")
    ((None) (nil (list int)))
    ((Some v) (texts_of (json_items v) (nil (list int))))))

; The strings among vs, in order.
(def texts_of ((vs (list Json)) (acc (list (list int)))) (list (list int))
  (if (is_empty vs)
      (rev acc)
      (texts_of (tail vs) (match (json_text (head vs)) ((None) acc) ((Some t) (cons (bytes_to_list t) acc))))))

; The program what names found, a path from home if it holds a /, as the
; shell's run finds it; then started.
(def run_program ((home (list int)) (what (list int)) (args (list (list int))) (timeout int) (back int) (port int)) RunStart
  (let path (program_found (if (any_eq 47 what) (tool_path home what) what) (root_paths))
    (if (is_empty path)
        (RunRefused (tool_failed (append "no program " what)))
        (match (run_start home path args timeout back port)
          ((Err why) (RunRefused (tool_failed why)))
          ((Ok r) (RunGoing r))))))

; The program at path started with args, its current directory home,
; its terminal port, agentd's, which is told of its exit and of its
; deadline, timeout seconds from now; agentd's own terminal set back to
; back after. Or why it could not be.
(def run_start ((home (list int)) (path (list int)) (args (list (list int))) (timeout int) (back int) (port int)) (Result Run (list int))
  (match (tty_set port)
      ((TtyNoPort) ((Err Run (list int)) "no port to be its terminal"))
      ((TtySet)
        (let (c (chdir home)
              s (spawn_path path (Some args))
              t (tty_set back)
              pid (spawned_pid s))
          (if (lt pid 0)
              ((Err Run (list int)) (append "cannot start " (append path (append ": " (spawn_why s)))))
              (let (w (proc_watch pid port)
                    deadline (add (clock_ns) (mul timeout 1000000000))
                    a (alarm_at port deadline))
                ((Ok Run (list int)) (run_new pid port deadline))))))))

; The pid a spawn started, or -1.
(def spawned_pid ((s Spawn)) int
  (match s
    ((Spawned pid) pid)
    ((SpawnNoEntry) -1)
    ((SpawnNotProgram) -1)
    ((SpawnTooBig) -1)
    ((SpawnNoRoom) -1)))

; r after m came to its port, as agentd hears it: at its deadline, the
; alarm, it is ended with proc_kill, and its exit then waited for (an
; alarm before it, an earlier run's, is passed over); a
; port that fails gives it up; anything else is run_heard's, and what
; that says to send is sent.
(def run_took ((r Run) (m Message)) Run
  (match m
    ((RecvFailed) (run_lost r))
    ((Message from b)
      (if (is_alarm_notice m)
          (match (.status r)
            ((Some s) r)
            ((None) (if (lt (clock_ns) (.deadline r)) r (let k (proc_kill (.pid r)) (run_ended r)))))
          (match (run_heard r m)
            ((RunHeard r2 sends) (let x (run_send sends) r2)))))))

; Each of sends sent; a terminal's answer that cannot go is dropped.
(def run_send ((sends (list RunSend))) int
  (if (is_empty sends)
      0
      (match (head sends)
        ((RunSend port payload) (let s (port_tell port payload) (run_send (tail sends)))))))
