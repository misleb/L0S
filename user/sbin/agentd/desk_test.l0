; desk_test.l0 -- the tools of the desktop and the clock: what they make
; of their servers' answers, their input, an SVG drawn, and, with no
; kernel, no servers.

(def bb ((s (list int))) bytes (bytes_from_list s))

; An answer as text: ok or failed, then its text.
(def desk_text ((a ToolAnswer)) (list int)
  (match a ((ToolAnswer t f) (append (if f "failed: " "ok: ") (bytes_to_list t)))))

; An input of integer fields, given as names and values.
(def ints_input ((names (list (list int))) (values (list int))) Json
  (json_obj (ints_fields names values)))

(def ints_fields ((names (list (list int))) (values (list int))) (list JField)
  (if (is_empty names)
      (nil JField)
      (cons (json_field (head names) (JInt (head values))) (ints_fields (tail names) (tail values)))))

; wm's windows lines lose their buffers' words; the pointer's stays.
(def test_windows () int
  (check_str "lines" (desk_text (desk_windows "3 Files 100 80 880 560 front 9 buffer 16 frames 4\n2 Terminal 40 60 640 400 - 8 buffer 12 frames 2\npointer 5 6"))
    "ok: ID TITLE X Y WIDTH HEIGHT FRONT PID\n3 Files 100 80 880 560 front 9\n2 Terminal 40 60 640 400 - 8\npointer 5 6\n"))

; An error from the compositor is the tool's failure.
(def test_windows_refused () int
  (check_str "error" (desk_text (desk_windows "error: busy")) "failed: busy"))

; The integers named, in order; the first missing is said.
(def test_ints () int
  (let i (ints_input (split_spaces "x y width") (cons 1 (cons 2 (cons 3 (nil int)))))
    (add (check_str "got" (match (tool_ints i (split_spaces "x y width") (nil int)) ((IntsGot ns) (unwords (map_digits ns))) ((IntsMissing n) n)) "1 2 3")
         (check_str "missing" (match (tool_ints i (split_spaces "x height") (nil int)) ((IntsGot ns) "all") ((IntsMissing n) n)) "height"))))

; Numbers as their digits.
(def map_digits ((ns (list int))) (list (list int))
  (if (is_empty ns) (nil (list int)) (cons (digits (head ns)) (map_digits (tail ns)))))

; 1793482805 is 2026-10-31 21:40:05 UTC, a Saturday: 20757 days and
; 78005 seconds from 1970 (20757 times 86400 is 1793404800), and 20757 mod 7 is 2, two days on from a
; Thursday. Seven hours west, PDT, is 14:40:05.
(def test_time_lines () int
  (check_str "lines" (time_lines 1793482805 (ClockZone -420 (zone_never)))
    "2026-10-31 21:40:05 UTC, a Saturday\n2026-10-31 14:40:05 in US Pacific time (UTC-7:00)\n1793482805 seconds since 1970-01-01 UTC"))

(def test_weekday () int
  (add (check_str "the epoch" (weekday 0) "Thursday")
       (check_str "a week on, less a day" (weekday (mul 6 86400)) "Wednesday")))

; A square of red, the whole canvas, opaque.
(def test_svg () int
  (match (desk_svg (bb "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 2 2\"><rect width=\"2\" height=\"2\" fill=\"#ff0000\"/></svg>") 2 2)
    ((Err why) (check_str "drawn" why ""))
    ((Ok px) (add (check_int "words" (array_len px) 4)
                  (check_str "red" (hex_digits (array_get px 3) 8) "ffff0000")))))

; A document that is no SVG is said so.
(def test_svg_bad () int
  (check_bool "refused" (match (desk_svg (bb "not svg") 2 2) ((Err why) true) ((Ok px) false)) true))

; Under an operating system there is no compositor and no clock.
(def test_no_servers () int
  (add (check_str "windows" (desk_text (tool_desk "windows" (json_obj (nil JField)) 0)) "failed: no compositor: the desktop is not running")
       (check_str "time" (desk_text (tool_desk "time" (json_obj (nil JField)) 0)) "failed: no clock is running")))

; A name of two words is refused before anything is asked.
(def test_open_words () int
  (check_bool "spaced" (any_spaced (cons "a" (cons "b c" (nil (list int))))) true))

; The windows' ids, front first; the pointer's line is none.
(def test_window_ids () int
  (check_str "ids" (unwords (map_digits (window_ids "3 Files 100 80 880 560 front 9 buffer 16 frames 4\n2 System Monitor 40 60 640 400 - 8 buffer 12 frames 2\npointer 5 6")))
    "3 2"))
