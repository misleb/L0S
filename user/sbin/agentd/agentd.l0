; agentd.l0 -- the agent's server: it serves the agent protocol
; (proto/agent.l0), its one conversation's turns in and the answer
; streamed back as notices to every client that opened it, and does
; what its loop (loop.l0) asks: each request of the model sent through
; the host's proxy (proto/model.l0) and its streamed answer read, each
; tool run (tools.l0). It waits on three ports at once
; (port_receive_set): its own, for requests; the HTTP connection's
; notices; and the terminal of the program a tool runs, so a stop is
; heard while an answer streams or a program runs.
;
; It reads /etc/agent/config and /etc/agent/token (model.l0's, and its
; own keys: home, compact, keep, run_timeout); with neither it says so
; and exits 0, as a driver with no device does. It waits for its home's
; volume, makes the home and its CLAUDE.md, the agent's rules, from
; /etc/agent/CLAUDE.md, and the rest of the home's parts (agenthome.l0:
; its constitution, memory, skills and history), reads back the
; conversation kept there, and registers agent. One turn runs at a
; time; the conversation is kept in the home's
; .history/conversation.json at each round of tools and each turn's
; end, so it outlives agentd.

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "agentd" why))

; Says what it found or did.
(def note ((what (list int))) int (info_as "agentd" what))

; How long a streamed answer may be silent before it is given up.
(def wire_idle_ns () int 120000000000)

; Where the default rules are, and the name of the rules in the home.
(def rules_default_path () (list int) "/etc/agent/CLAUDE.md")
(def rules_name () (list int) "CLAUDE.md")

; ---------------------------------------------------------- configuration

; How large an answer's prompt may grow before the conversation is
; compacted, and how many turns compaction keeps, if the configuration
; says nothing.
(def compact_default () int 100000)
(def keep_default () int 8)

; The configuration text's number for key, or fallback if it has none
; or it is not a number.
(def conf_number ((text (list int)) (key (list int)) (fallback int)) int
  (let v (home_conf text key)
    (if (is_number v) (int_prefix v 0) fallback)))

; agentd's own settings, from the configuration text: the home, how long
; a program may run in seconds, the compaction size and the turns kept.
(data Own (Own (list int) int int int))

; The settings text says.
(def own_of ((text (list int))) Own
  (Own (home_of text) (tool_run_timeout text)
       (conf_number text "compact" (compact_default)) (conf_number text "keep" (keep_default))))

; The settings as text, for the tests and the log.
(def own_text ((o Own)) (list int)
  (match o
    ((Own home t c k)
      (append "home " (append home (append ", run_timeout " (append (digits t)
        (append ", compact " (append (digits c) (append ", keep " (digits k)))))))))))

; The volume the home is on, /Volumes/LABEL, or empty if it is not on
; one.
(def home_volume ((home (list int))) (list int)
  (if (starts_with home "/Volumes/")
      (let label (up_to 47 (drop_n home 9))
        (if (is_empty label) "" (append "/Volumes/" label)))
      ""))

; The board, as the system prompt names it.
(def board_text ((m int)) (list int)
  (if (eq m 1) "an aarch64 board (QEMU's virt board or a Raspberry Pi 5)"
      (eq m 2) "a riscv64 board (QEMU's virt board)"
      "a board"))

; ---------------------------------------------------------------- state

; What does not change while agentd runs: its port; the port its HTTP
; connections' notices come to; the port that is the terminal of the
; programs its tools run; where the model is; its own settings; the
; terminal to set back after starting a program (0 the kernel's); the
; board, as the system prompt names it; and the port the clock, and the
; servers the tools of the desktop and the clock ask, answer on.
(data Setup (Setup (port int) (np int) (rport int) (mc ModelConf) (o Own) (back int) (board (list int)) (cport int)))

; Where a request's answer is: none in flight; or coming, its status (0
; until its head), a refusal's body so far, reversed, the event
; stream's reader, and whether its stop has come (after which the loop
; may be on its next round while the response is still ending).
(data Wire (WireIdle) (WireOn int (list bytes) Sse bool))

; What a tool still running is: a program, the tool use's id and the
; run; or build_app's build (build.l0), the use's id and the build.
(data Running (Running bytes Run) (Building bytes Build))

; What agentd is doing: waiting; or a turn, the acts its loop asked not
; yet done, the answer coming, the program running, and when the answer
; is given up if nothing more comes.
(data Doing (Idle) (Busy (list Act) Wire (Option Running) int))

; agentd: its setup; the ports its notices go to, in the order they
; opened; the conversation's loop; when the conversation began and how
; many times the person has said something in it (ConvKept's); what it
; is doing; the network stack, once opened; and the HTTP connection to
; the proxy, kept between requests.
(data Agentd (Agentd (u Setup) (hear (list int)) (l Loop) (began int) (said int) (doing Doing) (net Inet) (conn (Option HttpConn))))

; The setup's home directory, and how long a program may run, from its
; own settings.
(def setup_home ((u Setup)) (list int) (match (.o u) ((Own h t c k) h)))
(def setup_timeout ((u Setup)) int (match (.o u) ((Own h t c k) t)))

; ------------------------------------------------------------- requests

; A request, as read: open NPORT; say, where its text came from (empty
; if it does not say), and the text; stop; clear; close NPORT; or why it
; is none.
(data Req (ReqOpen int) (ReqSay (list int) bytes) (ReqStop) (ReqClear) (ReqClose int) (ReqWrong (list int)))

; The request in a message's bytes b: its reply port, then a line of
; words, then for say the text, read in place.
(def req_of ((b bytes)) Req
  (if (lt (msg_len b) 4)
      (ReqWrong "not a request")
      (let (e (agent_line_end b 8)
            ws (split_spaces (bytes_to_list (bytes_slice b 8 e))))
        (req_words ws (bytes_slice b (min (add e 1) (bytes_len b)) (bytes_len b))))))

; The request the words ws make, with text after their line.
(def req_words ((ws (list (list int))) (text bytes)) Req
  (let (n (length ws)
        op (if (is_empty ws) "" (head ws))
        port (and (eq n 2) (is_number (nth ws 1))))
    (if (and (eq n 1) (eq op "say")) (ReqSay "" text)
        (and (eq n 2) (eq op "say")) (ReqSay (nth ws 1) text)
        (and (eq n 1) (eq op "stop")) (ReqStop)
        (and (eq n 1) (eq op "clear")) (ReqClear)
        (and port (eq op "open")) (ReqOpen (int_prefix (nth ws 1) 0))
        (and port (eq op "close")) (ReqClose (int_prefix (nth ws 1) 0))
        (ReqWrong "not open NPORT, say [SOURCE], stop, clear or close NPORT"))))

; ------------------------------------------------------------- notices

; b, at most max bytes of it, cut where a character starts.
(def brief ((b bytes) (max int)) bytes
  (if (le (bytes_len b) max) b (bytes_slice b 0 (char_start b max))))

; The notices a Tell is: a text in pieces of at most agent_piece_max
; bytes; a tool's input and a result cut to agent_brief_max; an error
; cut to a piece.
(def tell_notices ((t Tell)) (list bytes)
  (match t
    ((TellText b) (text_pieces b 0 (nil bytes)))
    ((TellTool n v) (cons (agent_tool_notice (bytes_to_list n) (brief (json_bytes v) (agent_brief_max))) (nil bytes)))
    ((TellResult n f text) (cons (agent_result_notice (bytes_to_list n) f (brief text (agent_brief_max))) (nil bytes)))
    ((TellError why) (cons (agent_error_notice (brief why (agent_piece_max))) (nil bytes)))
    ((TellCompacted before after) (cons (agent_compacted_notice before after) (nil bytes)))))

; b from i on as text notices, onto acc, reversed; then in order.
(def text_pieces ((b bytes) (i int) (acc (list bytes))) (list bytes)
  (let n (bytes_len b)
    (if (ge i n)
        (rev acc)
        (let (j (if (le (sub n i) (agent_piece_max)) n (char_start b (add i (agent_piece_max))))
              k (if (le j i) (min n (add i (agent_piece_max))) j))
          (text_pieces b k (cons (agent_text_notice (bytes_slice b i k)) acc))))))

; The conversation c told as its notices would have told it, oldest
; first: the person's texts as said, from the source their turn's first
; line names (unknown if it names none), a summary that compaction made as
; compacted, of tokens not known, 0; the model's texts in pieces; each
; tool's use, and its result named by the use it answers.
(def conv_replay ((c Conv)) (list bytes)
  (replay_turns (conv_turns c) ((MapEmpty bytes bytes)) (nil (list bytes))))

; The turns ts' notices, each turn's list onto acc, reversed; the names
; of the uses so far by their ids.
(def replay_turns ((ts (list Turn)) (names (Map bytes bytes)) (acc (list (list bytes)))) (list bytes)
  (if (is_empty ts)
      (concat_lists_of (rev acc) (nil bytes))
      (match (head ts)
        ((Turn who bs)
          (let names2 (if who names (uses_named bs names))
            (replay_turns (tail ts) names2 (cons (replay_blocks who bs names2 "unknown" (nil bytes)) acc)))))))

; The lists ls joined, in order, onto acc reversed; then in order.
(def concat_lists_of ((ls (list (list bytes))) (acc (list bytes))) (list bytes)
  (if (is_empty ls)
      (rev acc)
      (concat_lists_of (tail ls) (rev_onto (head ls) acc))))

; names with each tool's use among bs named by its id.
(def uses_named ((bs (list Block)) (names (Map bytes bytes))) (Map bytes bytes)
  (if (is_empty bs)
      names
      (uses_named (tail bs)
        (match (head bs)
          ((BToolUse id n v) (map_put names id n))
          ((BText t) names)
          ((BToolResult id t f) names)))))

; The notices of a turn's blocks bs, the person's if who, onto acc,
; reversed; then in order. A source line of the person's, a text
; before another (conv_said_blocks), tells nothing but names src, the
; source of the text after it.
(def replay_blocks ((who bool) (bs (list Block)) (names (Map bytes bytes)) (src (list int)) (acc (list bytes))) (list bytes)
  (if (is_empty bs)
      (rev acc)
      (match (if (and who (not (is_empty (tail bs)))) (block_source (head bs)) ((None (list int))))
        ((Some s) (replay_blocks who (tail bs) names s acc))
        ((None) (replay_blocks who (tail bs) names src (rev_onto (block_notices who (head bs) names src) acc))))))

; The source a block names, if it is a source line.
(def block_source ((b Block)) (Option (list int))
  (match b
    ((BText t) (conv_source_of t))
    ((BToolUse id n v) ((None (list int))))
    ((BToolResult id t f) ((None (list int))))))

; A block's notices, a person's text said from src.
(def block_notices ((who bool) (b Block) (names (Map bytes bytes)) (src (list int))) (list bytes)
  (match b
    ((BText t)
      (if (not who) (tell_notices (TellText t))
          (bytes_is_at t 0 (conv_summary_head)) (tell_notices (TellCompacted 0 0))
          (cons (agent_said_notice src t) (nil bytes))))
    ((BToolUse id n v) (tell_notices (TellTool n v)))
    ((BToolResult id t f)
      (tell_notices (TellResult (match (map_get names id) ((Some n) n) ((None) (bytes_from_list "tool"))) f t)))))

; notice sent to port: a full queue is waited out, a millisecond at a
; time, tries times at most, since the reader is only slow. Whether the
; port is still there.
(def notice_send ((port int) (notice bytes) (tries int)) bool
  (match (port_send_bytes port notice 0 (bytes_len notice))
    ((Sent) true)
    ((SendNoPort) false)
    ((SendTooBig) true)
    ((SendFull) (if (le tries 0) true (let s (sleep_ns 1000000) (notice_send port notice (sub tries 1)))))))

; Each of notices sent to port, until one finds it gone: whether it is
; still there.
(def notices_send ((port int) (notices (list bytes))) bool
  (if (is_empty notices)
      true
      (if (notice_send port (head notices) 2000) (notices_send port (tail notices)) false)))

; notices sent to each of ports: those still there, in order.
(def notices_told ((ports (list int)) (notices (list bytes))) (list int)
  (notices_onto ports notices (nil int)))

; notices_told's loop, the ports still there onto acc, reversed.
(def notices_onto ((ports (list int)) (notices (list bytes)) (acc (list int))) (list int)
  (if (is_empty ports)
      (rev acc)
      (notices_onto (tail ports) notices (if (notices_send (head ports) notices) (cons (head ports) acc) acc))))

; ports with p last, if it is not among them already, and without it.
(def port_with ((ports (list int)) (p int)) (list int)
  (if (any_eq p ports) ports (append ports (cons p (nil int)))))
(def port_without ((ports (list int)) (p int)) (list int)
  (filter_out_port ports p (nil int)))

; port_without's loop, onto acc reversed.
(def filter_out_port ((ports (list int)) (p int) (acc (list int))) (list int)
  (if (is_empty ports)
      (rev acc)
      (filter_out_port (tail ports) p (if (eq (head ports) p) acc (cons (head ports) acc)))))

; An answer's usage, as the log's debug line says it.
(def usage_text ((u Usage)) (list int)
  (match u
    ((Usage i o w r)
      (append "usage: input " (append (digits i) (append ", output " (append (digits o)
        (append ", cache written " (append (digits w) (append ", cache read " (digits r)))))))))))

; ------------------------------------------------------------- starting

; The entry point: the configuration read, the home made, and agent
; served; 0 if there is nothing to serve, 1 if it fails.
(def agentd () int
  (let port (port_new)
    (if (lt port 0)
        (complain "no kernel to serve under")
        (match (read_whole (model_conf_path))
          ((Err why) (note (append "no " (append (model_conf_path) ": the agent is not set up"))))
          ((Ok text)
            (match (read_whole (model_token_path))
              ((Err why) (note (append "no " (append (model_token_path) ": the agent is not set up"))))
              ((Ok token)
                (match (model_conf_of (bytes_to_list text) (bytes_to_list token))
                  ((Err why) (complain why))
                  ((Ok mc) (agentd_home port mc (own_of (bytes_to_list text))))))))))))

; agentd once its configuration is read: its home's volume waited for,
; the home and its rules made, then served.
(def agentd_home ((port int) (mc ModelConf) (o Own)) int
  (match o
    ((Own home t c k)
      (let v (home_volume home)
        (if (and (not (is_empty v)) (not (volume_waited v (volume_tries))))
            (complain (append "no volume " (append v (append " for its home " home))))
            (let made (fs_mkdir home)
              (match (chdir home)
                ((ChdirDone) (let (r (rules_made home) h (home_said (home_setup home))) (agentd_serve port mc o)))
                ((ChdirNoDir) (complain (append "cannot make its home " home)))
                ((ChdirNotDir) (complain (append home " is a file, not a home")))
                ((ChdirBad) (complain (append "cannot make its home " home))))))))))

; How long the home's volume may take to be mounted: 10 s, of 100 ms.
(def volume_tries () int 100)

; Whether the volume at path is mounted, asked every 100 ms, tries
; times at most.
(def volume_waited ((path (list int)) (tries int)) bool
  (if (is_mounted (mount_list) path) true
      (le tries 0) false
      (let s (sleep_ns 100000000) (volume_waited path (sub tries 1)))))

; Whether ms has a mount at path.
(def is_mounted ((ms (list MountInfo)) (path (list int))) bool
  (if (is_empty ms)
      false
      (match (head ms) ((MountInfo p port id) (if (eq p path) true (is_mounted (tail ms) path))))))

; The home's CLAUDE.md, made from the default rules if it is not there:
; 0, having said what it did.
(def rules_made ((home (list int))) int
  (let path (append home (append "/" (rules_name)))
    (match (read_whole path)
      ((Ok b) 0)
      ((Err why)
        (match (read_whole (rules_default_path))
          ((Err why2) (warn_as "agentd" (append "no " (append (rules_default_path) (append ": " (append path " not made"))))))
          ((Ok rules)
            (let w (write_whole path rules)
              (if (is_empty w)
                  (note (append "made " (append path (append " from " (rules_default_path)))))
                  (warn_as "agentd" (append path (append ": " w)))))))))))

; Each of the lines the home's setup gave said in the log: 0.
(def home_said ((ls (list (list int)))) int
  (if (is_empty ls) 0 (let n (note (head ls)) (home_said (tail ls)))))

; agent served on port, once the ports it waits on are set, the
; conversation read back and the name registered.
(def agentd_serve ((port int) (mc ModelConf) (o Own)) int
  (let (np (port_new)
        rp (port_new)
        cp (port_new))
    (match (port_set (cons port (cons np (cons rp (nil int)))))
      ((PortSetNotYours) (complain "cannot wait on its ports"))
      ((PortSetSize) (complain "cannot wait on its ports"))
      ((PortSetMade)
        (let (u (Setup port np rp mc o (back_terminal) (board_text (machine)) cp)
              k (conv_loaded (conv_path u))
              why (name_register_or_why port "agent"))
          (if (not (is_empty why))
              (complain why)
              (let n (note (append "serving agent: " (append (own_text o) (append ", the model " (append (.model mc)
                             (append " through " (append (.host mc) (cons 58 (digits (.port mc))))))))))
                (serve (Agentd u (nil int) (loop_for u (.conv k)) (.began k) (.said k) (Idle) (NoInet "not opened yet") ((None HttpConn)))))))))))

; The terminal to give back to agentd after starting a program.
(def back_terminal () int
  (match (tty_get) ((Terminal p) p) ((KernelTerminal) 0)))

; ---------------------------------------------------------- keeping it

; Where the conversation is kept.
(def conv_path ((u Setup)) (list int) (home_in (setup_home u) (home_conversation_name)))

; The conversation kept at path, read back: a new one if there is none;
; and if the file is not one, a new one too, the file moved aside to
; PATH.bad so that nothing is lost, which is warned of.
(def conv_loaded ((path (list int))) ConvKept
  (match (read_whole path)
    ((Err why) (let n (note "a new conversation") (conv_kept_new)))
    ((Ok b)
      (match (conv_kept_of b)
        ((Ok k) (let n (note (conv_kept_line path k)) k))
        ((Err why)
          (let (bad (append path ".bad")
                r (rename_file path bad)
                w (warn_as "agentd" (append path (append ": " (append why (append "; moved to " (append bad ", and a new conversation begun")))))))
            (conv_kept_new)))))))

; The conversation written to where it is kept, whole, under another
; name first and then renamed over the last, so that a write cut short
; leaves the last whole: 0, having warned if it could not.
(def kept ((s Agentd)) int
  (let (path (conv_path (.u s))
        fresh (append path ".new")
        w (write_whole fresh (conv_kept_bytes (ConvKept (.conv (.l s)) (.began s) (.said s)))))
    (if (not (is_empty w))
        (warn_as "agentd" (append "cannot keep the conversation: " w))
        (match (rename_file fresh path)
          ((Done) 0)
          ((NotDone f why) (warn_as "agentd" (append "cannot keep the conversation: " why)))))))

; s kept as its loop asks the model again, the conversation as the API
; takes it: unless what is asked is a summary, which changed nothing.
(def kept_asking ((s Agentd)) Agentd
  (match (.s (.cp (.l s)))
    ((Summarizing t k b ps) s)
    ((NoSummary) (let x (kept s) s))))

; ---------------------------------------------------------------- serving

; Each message on agentd's ports dealt with, for ever.
(def serve ((s Agentd)) int
  (match (port_receive_set)
    ((SetRecvFailed) (complain "its ports failed"))
    ((SetMessage p m) (serve (heard s p m)))))

; s after m came on port p.
(def heard ((s Agentd) (p int) (m Message)) Agentd
  (if (eq p (.port (.u s)))
      (match m ((RecvFailed) s) ((Message from b) (requested s from b)))
      (eq p (.np (.u s)))
      (wire_heard s m)
      (eq p (.rport (.u s)))
      (run_heard_in s m)
      s))

; s after the request in a message's bytes b, from the process from,
; answered.
(def requested ((s Agentd) (from int) (b bytes)) Agentd
  (match (req_of b)
    ((ReqWrong why) (let a (msg_answer b (error_reply why)) s))
    ((ReqOpen nport) (opened s b nport))
    ((ReqSay source text) (say_heard s b (said_source source from) (said_program from) text))
    ((ReqStop) (let (s2 (stopped s) a (msg_answer b "ok")) s2))
    ((ReqClear) (cleared s b))
    ((ReqClose nport) (let a (msg_answer b "ok") (.hear s (port_without (.hear s) nport))))))

; nport answered ok, told the conversation so far and whether a turn
; runs, and its notices from then on; unless it is gone by then.
(def opened ((s Agentd) (b bytes) (nport int)) Agentd
  (if (lt nport 1)
      (let a (msg_answer b (error_reply (append "no port " (digits nport)))) s)
      (let (a (msg_answer b "ok")
            busy (match (.doing s) ((Idle) false) ((Busy acts w r dl) true))
            there (notices_send nport (append (conv_replay (.conv (.l s))) (cons (agent_opened_notice busy) (nil bytes)))))
        (if there (.hear s (port_with (.hear s) nport)) s))))

; The conversation's loop: the system prompt as the home is now, the
; tools, and compaction as the settings say.
(def loop_for ((u Setup) (c Conv)) Loop
  (match (.o u)
    ((Own h t size keep)
      (loop_compacting (loop_new (.mc u) (system_now u) (conv_tools (tool_defs)) c) size keep))))

; The system prompt, read from the home now: its built-in part and the
; home's (its constitution, rules, memory's index and skills:
; home_prompt), so a change to them holds from the next turn.
(def system_now ((u Setup)) Json
  (let home (setup_home u)
    (conv_system (conv_base (.board u) home (tool_names)) (home_prompt home))))

; How the history names the turn said times in the conversation begun
; at began: B.N, so that a turn is told from one of an earlier
; conversation.
(def conv_tag ((began int) (said int)) (list int)
  (append (digits began) (cons 46 (digits said))))

; Where a say's text came from: the source it names, or else the name
; of the program from, which sent it.
(def said_source ((source (list int)) (from int)) (list int)
  (if (is_empty source) (base_name (said_program from)) source))

; The path of the program from, which sent a say; unknown if the kernel
; has none.
(def said_program ((from int)) (list int)
  (let p (proc_path from) (if (is_empty p) "unknown" p)))

; text said from source, by the program at path program: busy while a
; turn runs; else answered ok, told to every port as said, the system
; prompt made anew, and the turn begun with a line saying where the text
; came from (conv_said_blocks), the conversation's first dating it.
(def say_heard ((s Agentd) (b bytes) (source (list int)) (program (list int)) (text bytes)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Busy acts w r dl) (let a (msg_answer b "error: busy") s))
        ((Idle)
          (let (a (msg_answer b "ok")
                hear2 (notices_told hear (cons (agent_said_notice source text) (nil bytes)))
                b2 (if (eq n 0) (home_now (.cport u)) began)
                sy (system_now u))
            (match (loop_say (.sy l sy) (conv_said_blocks source program text))
              ((Looped l2 acts) (drive (Agentd u hear2 l2 b2 (add n 1) (Busy acts (WireIdle) ((None Running)) 0) net conn))))))))))

; The conversation begun anew, and kept so; busy while a turn runs.
(def cleared ((s Agentd) (b bytes)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Busy acts w r dl) (let a (msg_answer b "error: busy") s))
        ((Idle)
          (let (s2 (Agentd u hear (.conv l (conv_new)) 0 0 doing net conn)
                k (kept s2)
                x (note "the conversation cleared")
                a (msg_answer b "ok"))
            s2))))))

; The turn stopped, if one is running: a program running ended, the
; answer's connection reset, or a build's, so the proxy ends its
; session, and the turn done, stopped.
(def stopped ((s Agentd)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Idle) s)
        ((Busy acts w r dl)
          (let (k (run_end r)
                conn2 (if (or (is_wire_on w) (is_building r)) (conn_reset conn) conn))
            (match (loop_cancel l)
              ((Looped l2 acts2) (drive (Agentd u hear l2 began n (Busy acts2 (WireIdle) ((None Running)) 0) net conn2))))))))))

; A program running ended; 0.
(def run_end ((r (Option Running))) int
  (match r
    ((None) 0)
    ((Some x)
      (match x
        ((Running id run) (match (.status run) ((Some st) 0) ((None) (let k (proc_kill (.pid run)) 0))))
        ((Building id b) 0)))))

; Whether a tool running is a build.
(def is_building ((r (Option Running))) bool
  (match r ((None) false) ((Some x) (match x ((Running id run) false) ((Building id b) true)))))

; A connection given up, reset, its ring with it: none left.
(def conn_reset ((conn (Option HttpConn))) (Option HttpConn)
  (match conn
    ((None) conn)
    ((Some c) (let r (http_give_up c) ((None HttpConn))))))

; ------------------------------------------------------------- driving

; The turn's acts done in order, until one must wait: a request, or a
; build, which asks on the same connection, while the last answer is
; still coming; or a tool running. A request keeps the conversation
; first.
(def drive ((s Agentd)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Idle) s)
        ((Busy acts w r dl)
          (if (or (is_empty acts) (is_running r))
              s
              (let rest (Busy (tail acts) w r dl)
                (match (head acts)
                  ((ActTell t) (drive (Agentd u (notices_told hear (tell_notices t)) l began n rest net conn)))
                  ((ActDone reason) (finished (Agentd u hear l began n rest net conn) reason w))
                  ((ActAsk req) (if (is_wire_on w) s (turn_asked (kept_asking (Agentd u hear l began n rest net conn)) req)))
                  ((ActTool tid name input)
                    (if (and (is_wire_on w) (is_build_tool (bytes_to_list name)))
                        s
                        (tooled (Agentd u hear l began n rest net conn) tid name input)))))))))))

; Whether a program is running, and an answer coming.
(def is_running ((r (Option Running))) bool (match r ((None) false) ((Some x) true)))
(def is_wire_on ((w Wire)) bool (match w ((WireIdle) false) ((WireOn c ps sse st) true)))

; The turn done, for reason: told, the answer's usage in the log, the
; conversation kept, and agentd waiting. An answer whose response w has
; not ended yet has its connection reset, so the next request never
; meets the rest of it.
(def finished ((s Agentd) (reason bytes) (w Wire)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (let (hear2 (notices_told hear (cons (agent_done_notice (bytes_to_list reason)) (nil bytes)))
            d (debug_as "agentd" (append "turn " (append (conv_tag began n) (append " done " (append (bytes_to_list reason) (append ", " (usage_text (.usage (.conv l)))))))))
            s2 (Agentd u hear2 l began n (Idle) net (if (is_wire_on w) (conn_reset conn) conn))
            k (kept s2))
        s2))))

; s with its turn's loop after looped, whose acts come before those
; still to do: then driven on.
(def took ((s Agentd) (looped Looped)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Idle) s)
        ((Busy acts w r dl)
          (match looped
            ((Looped l2 more) (drive (Agentd u hear l2 began n (Busy (append more acts) w r dl) net conn)))))))))

; The turn's loop told event e: s after it, driven on; nothing while no
; turn runs.
(def turn_told ((s Agentd) (e ModelEvent)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl) (took s (loop_event (.l s) e)))))

; The tool name run for the use tid with input: a file tool, or one of
; the desktop's or the clock's, at once; run or sh started, the turn
; waiting for it; any other a failure.
(def tooled ((s Agentd) (tid bytes) (name bytes) (input Json)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Idle) s)
        ((Busy acts w r dl)
          (let nm (bytes_to_list name)
            (if (is_file_tool nm)
                (tool_answered s tid (tool_file (setup_home u) nm input (conv_tag began n) (home_now (.cport u))))
                (is_desk_tool nm)
                (tool_answered s tid (tool_desk nm input (.cport u)))
                (is_build_tool nm)
                (build_start s tid input)
                (not (is_run_tool nm))
                (tool_answered s tid (tool_failed (append "no tool " nm)))
                (match (tool_run_start (setup_home u) nm input (setup_timeout u) (.back u) (.rport u))
                  ((RunRefused a) (tool_answered s tid a))
                  ((RunGoing run) (Agentd u hear l began n (Busy acts w (Some (Running tid run)) dl) net conn))))))))))

; The use tid's answer a given to the turn's loop.
(def tool_answered ((s Agentd) (tid bytes) (a ToolAnswer)) Agentd
  (match a ((ToolAnswer text failed) (took s (loop_result (.l s) tid text failed)))))

; m, which came to the programs' terminal port: the program running
; told of it, and once it has exited, its result taken.
(def run_heard_in ((s Agentd) (m Message)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (match doing
        ((Idle) s)
        ((Busy acts w r dl)
          (match r
            ((None) s)
            ((Some x)
              (match x
                ((Building tid b) s)
                ((Running tid run)
                  (let run2 (run_took run m)
                    (match (.status run2)
                      ((None) (Agentd u hear l began n (Busy acts w (Some (Running tid run2)) dl) net conn))
                      ((Some st) (tool_answered (Agentd u hear l began n (Busy acts w ((None Running)) dl) net conn) tid (run_result run2))))))))))))))

; ---------------------------------------------------------------- asking

; The request req sent to the proxy, on the kept connection or a new
; one, and what came back at once read; a connection that cannot be
; made fails the turn, saying why.
(def turn_asked ((s Agentd) (req bytes)) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (let nt (match net ((Inet p rp) net) ((NoInet why) (inet_open)))
        (match nt
          ((NoInet why) (turn_told (Agentd u hear l began n doing nt conn) (failure why)))
          ((Inet ip irp)
            (match (connection u nt conn)
              ((Err why) (turn_told (Agentd u hear l began n doing nt ((None HttpConn))) (failure (append "the proxy: " why))))
              ((Ok c)
                (let (dl (add (clock_ns) (wire_idle_ns))
                      al (alarm_at (.np u) dl))
                  (match (http_send_as c "POST" req)
                    ((HttpGot c2 parts) (wire_parts (wire_begun (Agentd u hear l began n doing nt (Some c2)) dl) parts))))))))))))

; The connection to the proxy: the kept one, if it may take another
; request, or a new one.
(def connection ((u Setup) (nt Inet) (conn (Option HttpConn))) (Result HttpConn (list int))
  (match conn
    ((Some c) (http_reuse c))
    ((None) (http_connect nt (.np u) (.host (.mc u)) (.port (.mc u))))))

; An error event saying why, as a failure the loop tells and ends on.
(def failure ((why (list int))) ModelEvent
  (MError (bytes_from_list "agentd") (bytes_from_list why)))

; s with an answer coming, to be given up at dl if nothing more comes.
(def wire_begun ((s Agentd) (dl int)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r d0) (.doing s (Busy acts (WireOn 0 (nil bytes) (sse_new) false) r dl)))))

; m, which came to the connections' notice port: the alarm, a silent
; answer given up; anything else fed to the connection, and its parts
; read.
(def wire_heard ((s Agentd) (m Message)) Agentd
  (match m
    ((RecvFailed) s)
    ((Message from b)
      (if (is_alarm_notice m)
          (build_alarm (wire_alarm s))
          (match (.conn s)
            ((None) s)
            ((Some c)
              (match (http_feed c b)
                ((HttpGot c2 parts)
                  (if (doing_build (.doing s))
                      (build_parts (build_alive (.conn s (Some c2))) parts)
                      (wire_parts (wire_alive (.conn s (Some c2))) parts))))))))))

; An answer coming, heard from: its deadline put off.
(def wire_alive ((s Agentd)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl)
      (if (not (is_wire_on w))
          s
          (let (d2 (add (clock_ns) (wire_idle_ns))
                a (alarm_at (.np (.u s)) d2))
            (.doing s (Busy acts w r d2)))))))

; The alarm: an answer still coming past its deadline is given up, its
; connection reset, and the turn fails.
(def wire_alarm ((s Agentd)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl)
      (if (and (is_wire_on w) (ge (clock_ns) dl))
          (let c2 (conn_reset (.conn s))
            (turn_told (.conn (.doing s (Busy acts (WireIdle) r dl)) c2) (failure "the proxy did not answer")))
          s))))

; The parts of a response, in order, each read onto the turn.
(def wire_parts ((s Agentd) (parts (list HttpPart))) Agentd
  (if (is_empty parts) s (wire_parts (wire_part s (head parts)) (tail parts))))

; A part of the response read: its head's status; its body's events, or
; a refusal's body kept; its end, the answer over; or the connection
; failed.
(def wire_part ((s Agentd) (p HttpPart)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl)
      (match w
        ((WireIdle) s)
        ((WireOn code pieces sse st)
          (match p
            ((HttpHead c reason hs) (.doing s (Busy acts (WireOn c pieces sse st) r dl)))
            ((HttpBody d)
              (if (served code)
                  (match (sse_more sse d 0 (bytes_len d))
                    ((SseMore s2 es) (wire_events (.doing s (Busy acts (WireOn code pieces s2 st) r dl)) es)))
                  (.doing s (Busy acts (WireOn code (cons d pieces) sse st) r dl))))
            ((HttpEnd keep) (wire_ended (.doing s (Busy acts (WireIdle) r dl)) code (bytes_concat (rev pieces)) st))
            ((HttpBad why) (wire_lost (wire_dropped s acts r dl) why st))
            ((HttpFailed why) (wire_lost (wire_dropped s acts r dl) why st))))))))

; s with no answer coming and its connection reset, the turn's acts,
; program and deadline as they were.
(def wire_dropped ((s Agentd) (acts (list Act)) (r (Option Running)) (dl int)) Agentd
  (let c2 (conn_reset (.conn s))
    (.conn (.doing s (Busy acts (WireIdle) r dl)) c2)))

; Whether a status code says the request was served.
(def served ((code int)) bool (and (ge code 200) (lt code 300)))

; The stream's events es, each the model's events, told to the loop;
; an answer's stop, or an error, marks the answer stopped first.
(def wire_events ((s Agentd) (es (list SseEvent))) Agentd
  (if (is_empty es)
      s
      (let ms (model_events (head es))
        (wire_events (told_all (if (any_stop ms) (wire_stopped s) s) ms) (tail es)))))

; Whether any of ms ends an answer: its stop, or an error.
(def any_stop ((ms (list ModelEvent))) bool
  (if (is_empty ms)
      false
      (match (head ms)
        ((MStop r) true)
        ((MError k m) true)
        ((MText i t) (any_stop (tail ms)))
        ((MToolStart i id n) (any_stop (tail ms)))
        ((MToolInput i pj) (any_stop (tail ms)))
        ((MBlockStop i) (any_stop (tail ms)))
        ((MUsage a o w r) (any_stop (tail ms))))))

; s with the answer coming marked stopped: what comes after is no more
; of it, and its end ends nothing early.
(def wire_stopped ((s Agentd)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl)
      (match w
        ((WireIdle) s)
        ((WireOn code pieces sse st) (.doing s (Busy acts (WireOn code pieces sse true) r dl)))))))

; Each of ms told to the turn's loop.
(def told_all ((s Agentd) (ms (list ModelEvent))) Agentd
  (if (is_empty ms) s (told_all (turn_told s (head ms)) (tail ms))))

; The answer over, its status code, a refusal's body, and whether it
; had stopped: a refusal, or a stream that ended before its stop, fails
; the turn; otherwise what was waiting for it goes on.
(def wire_ended ((s Agentd) (code int) (body bytes) (stopped bool)) Agentd
  (if (not (served code)) (turn_told s (failure (model_refusal code body)))
      stopped (drive s)
      (turn_told s (failure "the answer ended before it was done"))))

; The connection lost, why: the turn fails if its answer had not
; stopped.
(def wire_lost ((s Agentd) (why (list int)) (stopped bool)) Agentd
  (if stopped (drive s) (turn_told s (failure (append "the proxy: " why)))))

; ------------------------------------------------------------- building

; build_app's use tid with input: its request sent to the proxy and the
; turn waiting on the build; a name or prompt missing or wrong its
; failure at once.
(def build_start ((s Agentd) (tid bytes) (input Json)) Agentd
  (match (tool_str input "name")
    ((None) (tool_answered s tid (tool_failed "build_app needs a name")))
    ((Some name)
      (match (tool_str input "prompt")
        ((None) (tool_answered s tid (tool_failed "build_app needs a prompt")))
        ((Some prompt)
          (if (build_name_ok name)
              (build_ask s tid (build_new name) (build_request (.mc (.u s)) name prompt) "POST")
              (tool_answered s tid (tool_failed (append name ": an app's name is lowercase letters, digits and -, a letter first, at most 32")))))))))

; The request req of build b, by method, sent to the proxy on the kept
; connection or a new one, the turn waiting on it; a connection that
; cannot be made the use's failure.
(def build_ask ((s Agentd) (tid bytes) (b Build) (req bytes) (method (list int))) Agentd
  (match s
    ((Agentd u hear l began n doing net conn)
      (let nt (match net ((Inet p rp) net) ((NoInet why) (inet_open)))
        (match nt
          ((NoInet why) (tool_answered (build_cleared (Agentd u hear l began n doing nt conn)) tid (tool_failed why)))
          ((Inet ip irp)
            (match (connection u nt conn)
              ((Err why) (tool_answered (build_cleared (Agentd u hear l began n doing nt ((None HttpConn)))) tid (tool_failed (append "the proxy: " why))))
              ((Ok c)
                (let (dl (add (clock_ns) (build_idle_ns))
                      al (alarm_at (.np u) dl))
                  (match (http_send_as c method req)
                    ((HttpGot c2 parts) (build_parts (build_now (Agentd u hear l began n doing nt (Some c2)) tid (.dl b dl)) parts))))))))))))

; s with build b, of the use tid, as the tool running.
(def build_now ((s Agentd) (tid bytes) (b Build)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl) (.doing s (Busy acts w (Some (Building tid b)) dl)))))

; s with no tool running.
(def build_cleared ((s Agentd)) Agentd
  (match (.doing s)
    ((Idle) s)
    ((Busy acts w r dl) (.doing s (Busy acts w ((None Running)) dl)))))

; Whether what agentd does is waiting on a build.
(def doing_build ((d Doing)) bool
  (match d ((Idle) false) ((Busy acts w r dl) (is_building r))))

; The build running and its use, if one is.
(data Built (Built bytes Build) (NoBuild))
(def build_of ((s Agentd)) Built
  (match (.doing s)
    ((Idle) (NoBuild))
    ((Busy acts w r dl)
      (match r
        ((None) (NoBuild))
        ((Some x) (match x ((Running tid run) (NoBuild)) ((Building tid b) (Built tid b))))))))

; A build heard from: its deadline put off.
(def build_alive ((s Agentd)) Agentd
  (match (build_of s)
    ((NoBuild) s)
    ((Built tid b)
      (let (d2 (add (clock_ns) (build_idle_ns))
            a (alarm_at (.np (.u s)) d2))
        (build_now s tid (.dl b d2))))))

; The alarm: a build silent past its deadline is given up, its
; connection reset, and its use failed.
(def build_alarm ((s Agentd)) Agentd
  (match (build_of s)
    ((NoBuild) s)
    ((Built tid b)
      (if (lt (clock_ns) (.dl b))
          s
          (build_lost s tid "it said nothing for a minute")))))

; The parts of a build's response, in order, each read onto it.
(def build_parts ((s Agentd) (parts (list HttpPart))) Agentd
  (if (is_empty parts) s (build_parts (build_part s (head parts)) (tail parts))))

; A part of a build's response read: its head's status; its events, or
; a refusal's or the image's body kept; its end; or the connection lost.
(def build_part ((s Agentd) (p HttpPart)) Agentd
  (match (build_of s)
    ((NoBuild) s)
    ((Built tid b)
      (match p
        ((HttpHead c reason hs) (build_now s tid (.code b c)))
        ((HttpBody d)
          (if (and (served (.code b)) (not (.image b)))
              (match (sse_more (.sse b) d 0 (bytes_len d))
                ((SseMore s2 es) (build_events s tid (.sse b s2) es)))
              (build_now s tid (.pieces b (cons d (.pieces b))))))
        ((HttpEnd keep) (build_ended (build_cleared s) tid b))
        ((HttpBad why) (build_lost s tid why))
        ((HttpFailed why) (build_lost s tid why))))))

; A build's events es read: progress told to every port open, as the
; tool's, and its end, done or failed, kept for the response's end.
(def build_events ((s Agentd) (tid bytes) (b Build) (es (list SseEvent))) Agentd
  (if (is_empty es)
      (build_now s tid b)
      (match (build_event (head es))
        ((BuildProgress t) (build_events (.hear s (notices_told (.hear s) (cons (agent_progress_notice "build_app" (bytes_from_list t)) (nil bytes)))) tid b (tail es)))
        ((BuildDone t) (build_events s tid (.done b (Some t)) (tail es)))
        ((BuildFailed t) (build_events s tid (.why b t) (tail es)))
        ((BuildNone) (build_events s tid b (tail es))))))

; A build's response ended: its events' done, the image then asked for;
; the image, written into the home, the use answered; or a refusal, or
; a failure, its answer.
(def build_ended ((s Agentd) (tid bytes) (b Build)) Agentd
  (let (body (bytes_concat (rev (.pieces b)))
        name (.name b))
    (if (not (served (.code b)))
        (tool_answered s tid (tool_failed (build_refused_text (.code b) body)))
        (.image b)
        (let why (build_written (setup_home (.u s)) name body)
          (tool_answered s tid
            (if (is_empty why)
                (tool_ok (bytes_from_list (build_answer_text name (match (.done b) ((None) (nil int)) ((Some t) t)))))
                (tool_failed (append "apps/" (append name (append ": " why)))))))
        (match (.done b)
          ((None) (tool_answered s tid (tool_failed (if (is_empty (.why b)) "the build ended without a result" (.why b)))))
          ((Some t) (build_ask s tid (Build name true 0 (sse_new) (nil bytes) (Some t) (nil int) 0) (image_request (.mc (.u s)) name) "GET"))))))

; A build's connection lost, why: reset, and the use failed.
(def build_lost ((s Agentd) (tid bytes) (why (list int))) Agentd
  (let s2 (.conn s (conn_reset (.conn s)))
    (tool_answered (build_cleared s2) tid (tool_failed (append "the proxy: " why)))))
