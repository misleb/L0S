; agentd.l0 -- the agent's server, its parts so far: the conversation
; (conv.l0), the loop (loop.l0), and the tools (tools.l0), each pure or
; tested on its own. It serves nothing yet: started, it says so and
; exits 1.

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "agentd" why))

; The entry point: nothing to serve.
(def agentd () int
  (complain "it serves nothing yet: only its loop and tools are written"))
