; agentd.l0 -- the agent's server: it serves the agent protocol
; (proto/agent.l0), a conversation's turns in and the answer streamed
; back as notices, and does what its loop (loop.l0) asks: each request
; of the model sent through the host's proxy (proto/model.l0) and its
; streamed answer read, each tool run (tools.l0). It waits on three
; ports at once (port_receive_set): its own, for requests; the HTTP
; connection's notices; and the terminal of the program a tool runs, so
; a stop is heard while an answer streams or a program runs.
;
; It reads /etc/agent/config and /etc/agent/token (model.l0's, and its
; own keys: home, compact, keep, run_timeout); with neither it says so
; and exits 0, as a driver with no device does. It waits for its home's
; volume, makes the home and its CLAUDE.md, the agent's rules, from
; /etc/agent/CLAUDE.md, and registers agent. One turn runs at a time, of
; any conversation; conversations live as long as agentd.

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "agentd" why))

; Says what it found or did.
(def note ((what (list int))) int (info_as "agentd" what))

; How long a streamed answer may be silent before it is given up.
(def wire_idle_ns () int 120000000000)

; Where the default rules are, and the name of the rules in the home.
(def rules_default_path () (list int) "/etc/agent/CLAUDE.md")
(def rules_name () (list int) "CLAUDE.md")

; ---------------------------------------------------------- configuration

; How large an answer's prompt may grow before the conversation is
; compacted, and how many turns compaction keeps, if the configuration
; says nothing.
(def compact_default () int 100000)
(def keep_default () int 8)

; The configuration text's number for key, or fallback if it has none
; or it is not a number.
(def conf_number ((text (list int)) (key (list int)) (fallback int)) int
  (let v (tool_conf text key)
    (if (is_number v) (int_prefix v 0) fallback)))

; agentd's own settings, from the configuration text: the home, how long
; a program may run in seconds, the compaction size and the turns kept.
(data Own (Own (list int) int int int))

; The settings text says.
(def own_of ((text (list int))) Own
  (Own (tool_home text) (tool_run_timeout text)
       (conf_number text "compact" (compact_default)) (conf_number text "keep" (keep_default))))

; The settings as text, for the tests and the log.
(def own_text ((o Own)) (list int)
  (match o
    ((Own home t c k)
      (append "home " (append home (append ", run_timeout " (append (digits t)
        (append ", compact " (append (digits c) (append ", keep " (digits k)))))))))))

; The volume the home is on, /Volumes/LABEL, or empty if it is not on
; one.
(def home_volume ((home (list int))) (list int)
  (if (starts_with home "/Volumes/")
      (let label (up_to 47 (drop_n home 9))
        (if (is_empty label) "" (append "/Volumes/" label)))
      ""))

; The board, as the system prompt names it.
(def board_text ((m int)) (list int)
  (if (eq m 1) "an aarch64 board (QEMU's virt board or a Raspberry Pi 5)"
      (if (eq m 2) "a riscv64 board (QEMU's virt board)" "a board")))

; ---------------------------------------------------------------- state

; What does not change while agentd runs: its port; the port its HTTP
; connections' notices come to; the port that is the terminal of the
; programs its tools run; where the model is; its own settings; the
; terminal to set back after starting a program (0 the kernel's); and
; the board, as the system prompt names it.
(data Setup (Setup int int int ModelConf Own int (list int)))

; A conversation: the port its notices go to, and its loop.
(data Chat (Chat int Loop))

; Where a request's answer is: none in flight; or coming, its status (0
; until its head), a refusal's body so far, reversed, and the event
; stream's reader.
(data Wire (WireIdle) (WireOn int (list bytes) Sse))

; A program a tool runs: the tool use's id, and the run.
(data Running (Running bytes Run))

; What agentd is doing: waiting; or a turn of conversation ID, its
; notices to NPORT, its loop, the acts it asked not yet done, the
; answer coming, the program running, and when the answer is given up
; if nothing more comes.
(data Doing (Idle) (Busy int int Loop (list Act) Wire (Option Running) int))

; agentd: its setup; its conversations by ID; the next ID; what it is
; doing; the network stack, once opened; and the HTTP connection to the
; proxy, kept between requests.
(data Agentd (Agentd Setup (Map int Chat) int Doing Inet (Option HttpConn)))

; The setup's parts.
(def setup_port ((u Setup)) int (match u ((Setup p np rp mc o back board) p)))
(def setup_np ((u Setup)) int (match u ((Setup p np rp mc o back board) np)))
(def setup_rport ((u Setup)) int (match u ((Setup p np rp mc o back board) rp)))
(def setup_home ((u Setup)) (list int) (match u ((Setup p np rp mc o back board) (match o ((Own h t c k) h)))))

; ------------------------------------------------------------- requests

; A request, as read: open NPORT; say ID and its text; stop ID; close
; ID; or why it is none.
(data Req (ReqOpen int) (ReqSay int bytes) (ReqStop int) (ReqClose int) (ReqWrong (list int)))

; The request in a message's bytes b: its reply port, then a line of
; words, then for say the text, read in place.
(def req_of ((b bytes)) Req
  (if (lt (msg_len b) 4)
      (ReqWrong "not a request")
      (let e (agent_line_end b 8)
        (let ws (split_spaces (bytes_to_list (bytes_slice b 8 e)))
          (if (if (eq (length ws) 2) (is_number (nth ws 1)) false)
              (req_words (head ws) (int_prefix (nth ws 1) 0) (bytes_slice b (min (add e 1) (bytes_len b)) (bytes_len b)))
              (ReqWrong "not open NPORT, say ID, stop ID or close ID"))))))

; The request op N makes, with text after its line.
(def req_words ((op (list int)) (n int) (text bytes)) Req
  (if (eq op "open") (ReqOpen n)
  (if (eq op "say") (ReqSay n text)
  (if (eq op "stop") (ReqStop n)
  (if (eq op "close") (ReqClose n)
  (ReqWrong (append "no request " op)))))))

; ------------------------------------------------------------- notices

; b, at most max bytes of it, cut where a character starts.
(def brief ((b bytes) (max int)) bytes
  (if (le (bytes_len b) max) b (bytes_slice b 0 (char_start b max))))

; The notices a Tell is, for conversation id: a text in pieces of at
; most agent_piece_max bytes; a tool's input and a result cut to
; agent_brief_max; an error cut to a piece.
(def tell_notices ((id int) (t Tell)) (list bytes)
  (match t
    ((TellText b) (text_pieces id b 0 (nil bytes)))
    ((TellTool n v) (cons (agent_tool_notice id (bytes_to_list n) (brief (json_bytes v) (agent_brief_max))) (nil bytes)))
    ((TellResult n f text) (cons (agent_result_notice id (bytes_to_list n) f (brief text (agent_brief_max))) (nil bytes)))
    ((TellError why) (cons (agent_error_notice id (brief why (agent_piece_max))) (nil bytes)))))

; b from i on as text notices, onto acc, reversed; then in order.
(def text_pieces ((id int) (b bytes) (i int) (acc (list bytes))) (list bytes)
  (let n (bytes_len b)
    (if (ge i n)
        (rev acc)
        (let j (if (le (sub n i) (agent_piece_max)) n (char_start b (add i (agent_piece_max))))
          (let k (if (le j i) (min n (add i (agent_piece_max))) j)
            (text_pieces id b k (cons (agent_text_notice id (bytes_slice b i k)) acc)))))))

; notice sent to port: a full queue is waited out, a millisecond at a
; time, tries times at most, since the reader is only slow; a port gone
; drops it. 0.
(def notice_send ((port int) (notice bytes) (tries int)) int
  (match (port_send_bytes port notice 0 (bytes_len notice))
    ((Sent) 0)
    ((SendNoPort) 0)
    ((SendTooBig) 0)
    ((SendFull) (if (le tries 0) 0 (let s (sleep_ns 1000000) (notice_send port notice (sub tries 1)))))))

; Each of notices sent to port.
(def notices_send ((port int) (notices (list bytes))) int
  (if (is_empty notices) 0 (let s (notice_send port (head notices) 2000) (notices_send port (tail notices)))))

; An answer's usage, as the log's debug line says it.
(def usage_text ((u Usage)) (list int)
  (match u
    ((Usage i o w r)
      (append "usage: input " (append (digits i) (append ", output " (append (digits o)
        (append ", cache written " (append (digits w) (append ", cache read " (digits r)))))))))))

; ------------------------------------------------------------- starting

; The entry point: the configuration read, the home made, and agent
; served; 0 if there is nothing to serve, 1 if it fails.
(def agentd () int
  (let port (port_new)
    (if (lt port 0)
        (complain "no kernel to serve under")
        (match (read_whole (model_conf_path))
          ((Err why) (note (append "no " (append (model_conf_path) ": the agent is not set up"))))
          ((Ok text)
            (match (read_whole (model_token_path))
              ((Err why) (note (append "no " (append (model_token_path) ": the agent is not set up"))))
              ((Ok token)
                (match (model_conf_of (bytes_to_list text) (bytes_to_list token))
                  ((Err why) (complain why))
                  ((Ok mc) (agentd_home port mc (own_of (bytes_to_list text))))))))))))

; agentd once its configuration is read: its home's volume waited for,
; the home and its rules made, then served.
(def agentd_home ((port int) (mc ModelConf) (o Own)) int
  (match o
    ((Own home t c k)
      (let v (home_volume home)
        (if (if (is_empty v) false (not (volume_waited v (volume_tries))))
            (complain (append "no volume " (append v (append " for its home " home))))
            (let made (fs_mkdir home)
              (match (chdir home)
                ((ChdirDone) (let r (rules_made home) (agentd_serve port mc o)))
                ((ChdirNoDir) (complain (append "cannot make its home " home)))
                ((ChdirNotDir) (complain (append home " is a file, not a home")))
                ((ChdirBad) (complain (append "cannot make its home " home))))))))))

; How long the home's volume may take to be mounted: 10 s, of 100 ms.
(def volume_tries () int 100)

; Whether the volume at path is mounted, asked every 100 ms, tries
; times at most.
(def volume_waited ((path (list int)) (tries int)) bool
  (if (is_mounted (mount_list) path)
      true
      (if (le tries 0) false (let s (sleep_ns 100000000) (volume_waited path (sub tries 1))))))

; Whether ms has a mount at path.
(def is_mounted ((ms (list MountInfo)) (path (list int))) bool
  (if (is_empty ms)
      false
      (match (head ms) ((MountInfo p port id) (if (eq p path) true (is_mounted (tail ms) path))))))

; The home's CLAUDE.md, made from the default rules if it is not there:
; 0, having said what it did.
(def rules_made ((home (list int))) int
  (let path (append home (append "/" (rules_name)))
    (match (read_whole path)
      ((Ok b) 0)
      ((Err why)
        (match (read_whole (rules_default_path))
          ((Err why2) (warn_as "agentd" (append "no " (append (rules_default_path) (append ": " (append path " not made"))))))
          ((Ok rules)
            (let w (write_whole path rules)
              (if (is_empty w)
                  (note (append "made " (append path (append " from " (rules_default_path)))))
                  (warn_as "agentd" (append path (append ": " w)))))))))))

; agent served on port, once the ports it waits on are set and the name
; is registered.
(def agentd_serve ((port int) (mc ModelConf) (o Own)) int
  (let np (port_new)
    (let rp (port_new)
      (match (port_set (cons port (cons np (cons rp (nil int)))))
        ((PortSetNotYours) (complain "cannot wait on its ports"))
        ((PortSetSize) (complain "cannot wait on its ports"))
        ((PortSetMade)
          (let why (name_register_or_why port "agent")
            (if (not (is_empty why))
                (complain why)
                (let n (note (append "serving agent: " (append (own_text o) (append ", the model " (append (model_conf_model mc)
                               (append " through " (append (model_conf_host mc) (cons 58 (digits (model_conf_port mc))))))))))
                  (serve (Agentd (Setup port np rp mc o (back_terminal) (board_text (machine)))
                                 ((MapEmpty int Chat)) 1 (Idle) (NoInet "not opened yet") ((None HttpConn))))))))))))

; The terminal to give back to agentd after starting a program.
(def back_terminal () int
  (match (tty_get) ((Terminal p) p) ((KernelTerminal) 0)))

; ---------------------------------------------------------------- serving

; Each message on agentd's ports dealt with, for ever.
(def serve ((s Agentd)) int
  (match (port_receive_set)
    ((SetRecvFailed) (complain "its ports failed"))
    ((SetMessage p m) (serve (heard s p m)))))

; s after m came on port p.
(def heard ((s Agentd) (p int) (m Message)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (if (eq p (setup_port u))
          (match m ((RecvFailed) s) ((Message from b) (requested s b)))
          (if (eq p (setup_np u))
              (wire_heard s m)
              (if (eq p (setup_rport u)) (run_heard_in s m) s))))))

; s after the request in a message's bytes b, answered.
(def requested ((s Agentd) (b bytes)) Agentd
  (match (req_of b)
    ((ReqWrong why) (let a (msg_answer b (error_reply why)) s))
    ((ReqOpen nport) (opened s b nport))
    ((ReqSay id text) (said s b id text))
    ((ReqStop id) (let s2 (stopped s id) (let a (msg_answer b "ok") s2)))
    ((ReqClose id) (closed s b id))))

; A conversation opened, its notices to nport: its rules read from the
; home now, so a change to them holds from the next; answered conv ID.
(def opened ((s Agentd) (b bytes) (nport int)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (if (lt nport 1)
          (let a (msg_answer b (error_reply (append "no port " (digits nport)))) s)
          (let l (loop_for u)
            (let a (msg_answer b (append "conv " (digits next)))
              (Agentd u (map_put chats next (Chat nport l)) (add next 1) doing net conn)))))))

; A new conversation's loop: the system prompt, its built-in part and
; the home's rules, and the tools.
(def loop_for ((u Setup)) Loop
  (match u
    ((Setup p np rp mc o back board)
      (let home (setup_home u)
        (let rules (match (read_whole (append home (append "/" (rules_name)))) ((Ok r) r) ((Err why) (bytes_from_list (nil int))))
          (loop_new mc (conv_system (conv_base board home (tool_names)) rules) (conv_tools (tool_defs)) (conv_new)))))))

; text said in conversation id: busy while any turn runs; else
; answered ok, and the turn begun.
(def said ((s Agentd) (b bytes) (id int) (text bytes)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Busy i np l acts w r dl) (let a (msg_answer b "error: busy") s))
        ((Idle)
          (match (map_get chats id)
            ((None) (let a (msg_answer b (error_reply (append "no conversation " (digits id)))) s))
            ((Some c)
              (let a (msg_answer b "ok")
                (match c
                  ((Chat nport l)
                    (match (loop_say l text)
                      ((Looped l2 acts) (drive (Agentd u chats next (Busy id nport l2 acts (WireIdle) ((None Running)) 0) net conn))))))))))))))

; Conversation id closed, its turn stopped first if it is running; ok.
(def closed ((s Agentd) (b bytes) (id int)) Agentd
  (match (stopped s id)
    ((Agentd u chats next doing net conn)
      (let a (msg_answer b "ok")
        (Agentd u (map_remove chats id) next doing net conn)))))

; The turn of conversation id stopped, if it is the one running: a
; program running ended, the answer's connection reset, and the turn
; done, stopped.
(def stopped ((s Agentd) (id int)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy i nport l acts w r dl)
          (if (not (eq i id))
              s
              (let k (run_end r)
                (let conn2 (match w ((WireIdle) conn) ((WireOn c ps sse) (conn_reset conn)))
                  (match (loop_cancel l)
                    ((Looped l2 acts2) (drive (Agentd u chats next (Busy i nport l2 acts2 (WireIdle) ((None Running)) 0) net conn2))))))))))))

; A program running ended; 0.
(def run_end ((r (Option Running))) int
  (match r
    ((None) 0)
    ((Some x) (match x ((Running id run) (match (run_status run) ((Some st) 0) ((None) (let k (proc_kill (run_pid run)) 0))))))))

; A connection given up, reset: none left.
(def conn_reset ((conn (Option HttpConn))) (Option HttpConn)
  (match conn
    ((None) conn)
    ((Some c) (let r (tcp_reset (hc_inet c) (hc_id c)) ((None HttpConn))))))

; ------------------------------------------------------------- driving

; The turn's acts done in order, until one must wait: a request while
; the last answer is still coming, or a program running.
(def drive ((s Agentd)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (if (if (is_empty acts) true (is_running r))
              s
              (match (head acts)
                ((ActTell t) (let x (notices_send nport (tell_notices id t)) (drive (Agentd u chats next (Busy id nport l (tail acts) w r dl) net conn))))
                ((ActDone reason) (finished s id nport l reason))
                ((ActAsk req) (if (is_wire_on w) s (turn_asked (Agentd u chats next (Busy id nport l (tail acts) w r dl) net conn) req)))
                ((ActTool tid name input) (tooled (Agentd u chats next (Busy id nport l (tail acts) w r dl) net conn) tid name input)))))))))

; Whether a program is running, and an answer coming.
(def is_running ((r (Option Running))) bool (match r ((None) false) ((Some x) true)))
(def is_wire_on ((w Wire)) bool (match w ((WireIdle) false) ((WireOn c ps sse) true)))

; The turn done, for reason: told, the answer's usage in the log, its
; loop kept in its conversation, and agentd waiting.
(def finished ((s Agentd) (id int) (nport int) (l Loop) (reason bytes)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (let x (notice_send nport (agent_done_notice id (bytes_to_list reason)) 2000)
        (let d (debug_as "agentd" (append "conversation " (append (digits id) (append " done " (append (bytes_to_list reason) (append ", " (usage_text (conv_usage (loop_conv l)))))))))
          (Agentd u (if (map_has chats id) (map_put chats id (Chat nport l)) chats) next (Idle) net conn))))))

; s with its turn's loop after looped, whose acts come before those
; still to do: then driven on.
(def took ((s Agentd) (looped Looped)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (match looped
            ((Looped l2 more) (drive (Agentd u chats next (Busy id nport l2 (append more acts) w r dl) net conn)))))))))

; The turn's loop, while busy.
(def turn_loop ((s Agentd)) (Option Loop)
  (match s ((Agentd u chats next doing net conn) (match doing ((Idle) ((None Loop))) ((Busy id nport l acts w r dl) (Some l))))))

; The turn's loop told event e: s after it, driven on.
(def turn_told ((s Agentd) (e ModelEvent)) Agentd
  (match (turn_loop s) ((None) s) ((Some l) (took s (loop_event l e)))))

; The tool name run for the use tid with input: a file tool at once;
; run or sh started, the turn waiting for it; any other a failure.
(def tooled ((s Agentd) (tid bytes) (name bytes) (input Json)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (let n (bytes_to_list name)
            (if (is_file_tool n)
                (tool_answered s l tid (tool_file (setup_home u) n input))
                (if (not (is_run_tool n))
                    (tool_answered s l tid (tool_failed (append "no tool " n)))
                    (match u
                      ((Setup p np rp mc o back board)
                        (match (tool_run_start (setup_home u) n input (match o ((Own h t c k) t)) back rp)
                          ((RunRefused a) (tool_answered s l tid a))
                          ((RunGoing run) (Agentd u chats next (Busy id nport l acts w (Some (Running tid run)) dl) net conn)))))))))))))

; The use tid's answer a given to the turn's loop l.
(def tool_answered ((s Agentd) (l Loop) (tid bytes) (a ToolAnswer)) Agentd
  (match a ((ToolAnswer text failed) (took s (loop_result l tid text failed)))))

; m, which came to the programs' terminal port: the program running
; told of it, and once it has exited, its result taken.
(def run_heard_in ((s Agentd) (m Message)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (match r
            ((None) s)
            ((Some x)
              (match x
                ((Running tid run)
                  (let run2 (run_took run m)
                    (match (run_status run2)
                      ((None) (Agentd u chats next (Busy id nport l acts w (Some (Running tid run2)) dl) net conn))
                      ((Some st) (tool_answered (Agentd u chats next (Busy id nport l acts w ((None Running)) dl) net conn) l tid (run_result run2))))))))))))))

; ---------------------------------------------------------------- asking

; The request req sent to the proxy, on the kept connection or a new
; one, and what came back at once read; a connection that cannot be
; made fails the turn, saying why.
(def turn_asked ((s Agentd) (req bytes)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (let n (match net ((Inet p rp) net) ((NoInet why) (inet_open)))
        (match n
          ((NoInet why) (turn_told (Agentd u chats next doing n conn) (failure why)))
          ((Inet ip irp)
            (match (connection u n conn)
              ((Err why) (turn_told (Agentd u chats next doing n ((None HttpConn))) (failure (append "the proxy: " why))))
              ((Ok c)
                (let dl (add (clock_ns) (wire_idle_ns))
                  (let al (alarm_at (setup_np u) dl)
                    (match (http_send_as c "POST" req)
                      ((HttpGot c2 parts) (wire_parts (wire_begun (Agentd u chats next doing n (Some c2)) dl) parts)))))))))))))

; The connection to the proxy: the kept one, if it may take another
; request, or a new one.
(def connection ((u Setup) (n Inet) (conn (Option HttpConn))) (Result HttpConn (list int))
  (match conn
    ((Some c) (http_reuse c))
    ((None) (match u ((Setup p np rp mc o back board) (http_connect n np (model_conf_host mc) (model_conf_port mc)))))))

; An error event saying why, as a failure the loop tells and ends on.
(def failure ((why (list int))) ModelEvent
  (MError (bytes_from_list "agentd") (bytes_from_list why)))

; s with an answer coming, to be given up at dl if nothing more comes.
(def wire_begun ((s Agentd) (dl int)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r d0) (Agentd u chats next (Busy id nport l acts (WireOn 0 (nil bytes) (sse_new)) r dl) net conn))))))

; m, which came to the connections' notice port: the alarm, a silent
; answer given up; anything else fed to the connection, and its parts
; read.
(def wire_heard ((s Agentd) (m Message)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match m
        ((RecvFailed) s)
        ((Message from b)
          (if (is_alarm_notice m)
              (wire_alarm s)
              (match conn
                ((None) s)
                ((Some c)
                  (match (http_feed c b)
                    ((HttpGot c2 parts) (wire_parts (wire_alive (Agentd u chats next doing net (Some c2))) parts)))))))))))

; An answer coming, heard from: its deadline put off.
(def wire_alive ((s Agentd)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (if (not (is_wire_on w))
              s
              (let d2 (add (clock_ns) (wire_idle_ns))
                (let a (alarm_at (setup_np u) d2)
                  (Agentd u chats next (Busy id nport l acts w r d2) net conn)))))))))

; The alarm: an answer still coming past its deadline is given up, its
; connection reset, and the turn fails.
(def wire_alarm ((s Agentd)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (if (if (is_wire_on w) (ge (clock_ns) dl) false)
              (turn_told (Agentd u chats next (Busy id nport l acts (WireIdle) r dl) net (conn_reset conn)) (failure "the proxy did not answer"))
              s))))))

; The parts of a response, in order, each read onto the turn.
(def wire_parts ((s Agentd) (parts (list HttpPart))) Agentd
  (if (is_empty parts) s (wire_parts (wire_part s (head parts)) (tail parts))))

; A part of the response read: its head's status; its body's events, or
; a refusal's body kept; its end, the answer over; or the connection
; failed.
(def wire_part ((s Agentd) (p HttpPart)) Agentd
  (match s
    ((Agentd u chats next doing net conn)
      (match doing
        ((Idle) s)
        ((Busy id nport l acts w r dl)
          (match w
            ((WireIdle) s)
            ((WireOn code pieces sse)
              (match p
                ((HttpHead c reason hs) (Agentd u chats next (Busy id nport l acts (WireOn c pieces sse) r dl) net conn))
                ((HttpBody d)
                  (if (served code)
                      (match (sse_more sse d 0 (bytes_len d))
                        ((SseMore s2 es) (wire_events (Agentd u chats next (Busy id nport l acts (WireOn code pieces s2) r dl) net conn) es)))
                      (Agentd u chats next (Busy id nport l acts (WireOn code (cons d pieces) sse) r dl) net conn)))
                ((HttpEnd keep) (wire_ended (Agentd u chats next (Busy id nport l acts (WireIdle) r dl) net conn) code (bytes_concat (rev pieces))))
                ((HttpBad why) (wire_lost (Agentd u chats next (Busy id nport l acts (WireIdle) r dl) net (conn_reset conn)) why))
                ((HttpFailed why) (wire_lost (Agentd u chats next (Busy id nport l acts (WireIdle) r dl) net (conn_reset conn)) why))))))))))

; Whether a status code says the request was served.
(def served ((code int)) bool (if (ge code 200) (lt code 300) false))

; The stream's events es, each the model's events, told to the loop.
(def wire_events ((s Agentd) (es (list SseEvent))) Agentd
  (if (is_empty es) s (wire_events (told_all s (model_events (head es))) (tail es))))

; Each of ms told to the turn's loop.
(def told_all ((s Agentd) (ms (list ModelEvent))) Agentd
  (if (is_empty ms) s (told_all (turn_told s (head ms)) (tail ms))))

; The answer over, its status code and a refusal's body: a refusal, or
; a stream that ended before its stop, fails the turn; otherwise what
; was waiting for it goes on.
(def wire_ended ((s Agentd) (code int) (body bytes)) Agentd
  (match (turn_loop s)
    ((None) s)
    ((Some l)
      (if (not (served code))
          (turn_told s (failure (model_refusal code body)))
          (if (loop_answering l)
              (turn_told s (failure "the answer ended before it was done"))
              (drive s))))))

; The connection lost, why: the turn fails if its answer was coming.
(def wire_lost ((s Agentd) (why (list int))) Agentd
  (match (turn_loop s)
    ((None) s)
    ((Some l) (if (loop_answering l) (turn_told s (failure (append "the proxy: " why))) (drive s)))))
