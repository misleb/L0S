; agentd_test.l0 -- agentd's configuration, its requests read, the
; notices its loop's tells become, the ports that hear them, the
; history's tag, and its entry point.

(def bb ((s (list int))) bytes (bytes_from_list s))

; n of byte c, onto acc.
(def many_bytes ((c int) (n int) (acc (list int))) (list int)
  (if (le n 0) acc (many_bytes c (sub n 1) (cons c acc))))

; Under an operating system there is no kernel.
(def test_entry () int
  (check_int "fails" (agentd) 1))

(def test_own_default () int
  (check_str "own" (own_text (own_of "api 10.0.2.2:8765\n"))
    "home /Volumes/data/agent, run_timeout 60, compact 100000, keep 8"))

(def test_own_given () int
  (check_str "own" (own_text (own_of "api x:1\nhome /Volumes/work/me\ncompact 5000\nkeep 2\nrun_timeout 9\n"))
    "home /Volumes/work/me, run_timeout 9, compact 5000, keep 2"))

(def test_own_not_numbers () int
  (check_str "own" (own_text (own_of "compact lots\nkeep -\n"))
    "home /Volumes/data/agent, run_timeout 60, compact 100000, keep 8"))

(def test_home_volume () int
  (add (check_str "data" (home_volume "/Volumes/data/agent") "/Volumes/data")
       (add (check_str "the volume itself" (home_volume "/Volumes/work") "/Volumes/work")
            (check_str "not on one" (home_volume "/agent") ""))))

; A request as agentd receives it, from pid 7, its reply to port 3.
(def req_msg ((body (list int))) bytes
  (match (message_new 7 (request 3 body)) ((Message from b) b) ((RecvFailed) (bb ""))))

(def req_text ((r Req)) (list int)
  (match r
    ((ReqOpen n) (append "open " (digits n)))
    ((ReqSay src t) (append "say " (append src (append "|" (bytes_to_list t)))))
    ((ReqStop) "stop")
    ((ReqClear) "clear")
    ((ReqClose n) (append "close " (digits n)))
    ((ReqWrong why) (append "wrong: " why))))

(def test_req_open () int
  (check_str "open" (req_text (req_of (req_msg (agent_open_body 12)))) "open 12"))

(def test_req_say () int
  (add (check_str "say" (req_text (req_of (req_msg (agent_say_body "speech" "make a file\nplease")))) "say speech|make a file\nplease")
       (add (check_str "no source" (req_text (req_of (req_msg "say\nhi"))) "say |hi")
            (check_str "no text" (req_text (req_of (req_msg "say"))) "say |"))))

(def test_req_stop_clear_close () int
  (add (check_str "stop" (req_text (req_of (req_msg (agent_stop_body)))) "stop")
       (add (check_str "clear" (req_text (req_of (req_msg (agent_clear_body)))) "clear")
            (check_str "close" (req_text (req_of (req_msg (agent_close_body 4)))) "close 4"))))

(def test_req_wrong () int
  (add (check_str "unknown" (req_text (req_of (req_msg "sing"))) "wrong: not open NPORT, say [SOURCE], stop, clear or close NPORT")
       (add (check_str "no port" (req_text (req_of (req_msg "open"))) "wrong: not open NPORT, say [SOURCE], stop, clear or close NPORT")
            (check_str "two sources" (req_text (req_of (req_msg "say a b"))) "wrong: not open NPORT, say [SOURCE], stop, clear or close NPORT"))))

; Notices as text, joined by |.
(def notices_text ((ns (list bytes))) (list int)
  (if (is_empty ns) "" (append (bytes_to_list (head ns)) (if (is_empty (tail ns)) "" (cons 124 (notices_text (tail ns)))))))

(def test_tell_text () int
  (check_str "text" (notices_text (tell_notices (TellText (bb "Hi.")))) "agent text\nHi."))

; 9000 bytes of text are three notices: 4000, 4000 and 1000.
(def test_tell_text_pieces () int
  (let ns (tell_notices (TellText (bytes_from_list (many_bytes 97 9000 (nil int)))))
    (add (check_int "count" (length ns) 3)
         (check_int "last" (bytes_len (last ns)) (add 1000 (length "agent text\n"))))))

; A cut moves back to where a character starts: 3999 a's and a two-byte
; é cut after the a's.
(def test_tell_text_utf8 () int
  (let ns (tell_notices (TellText (bytes_from_list (append (many_bytes 97 3999 (nil int)) (cons 195 (cons 169 (nil int)))))))
    (check_int "first" (bytes_len (head ns)) (add 3999 (length "agent text\n")))))

(def test_tell_tool () int
  (check_str "tool" (notices_text (tell_notices (TellTool (bb "make_dir") (json_obj (cons (json_field "path" (json_str "notes")) (nil JField))))))
    "agent tool make_dir\n{\"path\":\"notes\"}"))

; A result is cut to 1 KB.
(def test_tell_result_cut () int
  (let ns (tell_notices (TellResult (bb "run") false (bytes_from_list (many_bytes 120 5000 (nil int)))))
    (check_int "size" (bytes_len (head ns)) (add 1024 (length "agent result run ok\n")))))

(def test_tell_error () int
  (check_str "error" (notices_text (tell_notices (TellError (bb "Overloaded")))) "agent error\nOverloaded"))

(def test_tell_compacted () int
  (check_str "compacted" (notices_text (tell_notices (TellCompacted 120000 9000))) "agent compacted 120000 9000"))

; The person's text, the model's text and use of a tool, its failed
; result, and the person's next text, told again in that order, the
; result named by its use.
(def test_replay () int
  (let c (adds (conv_new)
           (cons (Turn true (cons (BText (bb "list it")) (nil Block)))
             (cons (Turn false (cons (BText (bb "Listing.")) (cons (BToolUse (bb "t1") (bb "list_dir") (json_obj (nil JField))) (nil Block))))
               (cons (Turn true (cons (BToolResult (bb "t1") (bb "no dir") true) (cons (BText (bb "thanks")) (nil Block))))
                     (nil Turn)))))
    (check_str "notices" (notices_text (conv_replay c))
      "agent said unknown\nlist it|agent text\nListing.|agent tool list_dir\n{}|agent result list_dir failed\nno dir|agent said unknown\nthanks")))

; A summary is told as compacted, not as something said.
(def test_replay_summary () int
  (let c (conv_compacted (adds (conv_new) (cons (Turn true (cons (BText (bb "a")) (nil Block)))
                                                (cons (Turn false (cons (BText (bb "b")) (nil Block)))
                                                      (cons (Turn true (cons (BText (bb "c")) (nil Block))) (nil Turn)))))
                         2 (bb "S."))
    (check_str "notices" (notices_text (conv_replay c)) "agent compacted 0 0|agent said unknown\nc")))

; A turn's source line tells nothing of itself, but names the source
; of the text after it; a text alone that looks like one is said.
(def test_replay_source () int
  (let c (adds (conv_new)
           (cons (Turn true (conv_said_blocks "speech" "/sbin/stt" (bb "what time is it")))
             (cons (Turn false (cons (BText (bb "Noon.")) (nil Block)))
               (cons (Turn true (cons (BText (bb "[from me, sent by you]")) (nil Block)))
                     (nil Turn)))))
    (check_str "notices" (notices_text (conv_replay c))
      "agent said speech\nwhat time is it|agent text\nNoon.|agent said unknown\n[from me, sent by you]")))

; Where a say came from: the source it names, else the sending
; program's name; with no kernel, there is no program.
(def test_said_source () int
  (add (check_str "named" (said_source "speech" 5) "speech")
       (add (check_str "unnamed" (said_source "" 5) "unknown")
            (check_str "program" (said_program 5) "unknown"))))

; Ports as text, joined by spaces.
(def ports_text ((ps (list int))) (list int)
  (if (is_empty ps) "" (append (digits (head ps)) (if (is_empty (tail ps)) "" (cons 32 (ports_text (tail ps)))))))

; A port opened goes last, once; closed, it goes, the rest in order.
(def test_ports () int
  (let ps (port_with (port_with (port_with (nil int) 5) 9) 5)
    (add (check_str "with" (ports_text ps) "5 9")
         (add (check_str "without" (ports_text (port_without (port_with ps 2) 9)) "5 2")
              (check_str "not there" (ports_text (port_without ps 4)) "5 9")))))

; The history's tag: when the conversation began, and which time the
; person spoke in it.
(def test_conv_tag () int
  (add (check_str "no clock" (conv_tag 0 1) "0.1")
       (check_str "clock" (conv_tag 1793000000 12) "1793000000.12")))

(def test_usage_text () int
  (check_str "usage" (usage_text (Usage 10 5 3 0)) "usage: input 10, output 5, cache written 3, cache read 0"))

(def test_board () int
  (add (check_str "aarch64" (board_text 1) "an aarch64 board (QEMU's virt board or a Raspberry Pi 5)")
       (check_str "other" (board_text 9) "a board")))
