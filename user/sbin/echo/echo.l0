; echo.l0 -- a server: registers its port as "echo", and sends the body
; of every request it receives back to the request's reply port.

(def serve ((port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain_as "echo" "lost its port"))
    ((Message from b)
      (let (to (msg_reply b)
            s (if (le to 0) (Sent) (port_send_bytes to b (add (header_len) 4) (bytes_len b))))
        (serve port)))))

(def echo () int
  (let port (port_new)
    (if (lt port 0)
        (complain_as "echo" "no port")
        (let r (name_register_or_why port "echo")
          (if (is_empty r) (serve port) (let w (complain_as "echo" r) 2))))))
