; launcher_test.l0 -- the launcher's grid, its labels, and its clicks.

(def rect_text ((r Rect)) (list int)
  (match r ((Rect x y w h) (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (digits h))))))))))

(def apps () (list App)
  (cons (App "Disks" "/Applications/Disks.app/disks" "" "")
    (cons (App "System Monitor" "/Applications/Monitor.app/procmon" "" "")
      (cons (App "Terminal" "/Applications/Terminal.app/vt" "" "")
        (cons (App "Widgets" "/Applications/Widgets.app/widgets" "" "") (nil App))))))

; Four apps on a page 1280 wide fit one row, 4 * 136 = 544 wide, from
; (1280 - 544) / 2 = 368: Terminal, the third, from 368 + 2 * 136 = 640.
(def test_launcher_cells () int
  (add (check_int "one row" (launcher_cols 1280 4) 4)
       (add (check_str "the first" (rect_text (launcher_cell 1280 4 0)) "368,64 136x104")
            (check_str "Terminal" (rect_text (launcher_cell 1280 4 2)) "640,64 136x104"))))

; A page too narrow for them all: (400 - 96) / 136 = 2 a row, the third
; on the next.
(def test_launcher_rows () int
  (add (check_int "two a row" (launcher_cols 400 4) 2)
       (add (check_str "the next row" (rect_text (launcher_cell 400 4 2)) "64,168 136x104")
            (check_int "never none" (launcher_cols 50 4) 1))))

; Terminal's icon, (136 - 48) / 2 = 44 in and 12 down, and its name 12
; under that, 4 in from either side.
(def test_launcher_icon_place () int
  (let cell (launcher_cell 1280 4 2)
    (add (check_int "icon x" (launcher_icon_x cell) 684)
         (add (check_int "icon y" (launcher_icon_y cell) 76)
              (check_str "label" (rect_text (launcher_label cell)) "644,136 128x16")))))

(def test_launcher_at () int
  (add (check_int "on Terminal" (launcher_at 1280 4 700 100) 2)
       (add (check_int "between rows, on the page" (launcher_at 1280 4 700 200) (launcher_ground))
            (check_int "left of the grid" (launcher_at 1280 4 100 100) (launcher_ground)))))

(def act_text ((a LauncherAct)) (list int)
  (match a
    ((LaunchApp i) (append "app " (digits i)))
    ((LaunchToggle) "toggle")
    ((LaunchClose) "close")
    ((LaunchNothing) "nothing")))

(def test_launcher_act () int
  (add (check_str "an app clicked" (act_text (launcher_act 2 2)) "app 2")
       (add (check_str "Applications clicked" (act_text (launcher_act (launcher_button) (launcher_button))) "toggle")
            (check_str "the page clicked" (act_text (launcher_act (launcher_ground) (launcher_ground))) "close"))))

(def test_launcher_act_none () int
  (add (check_str "pressed on one app, let go on another" (act_text (launcher_act 1 2)) "nothing")
       (add (check_str "from an app to the page" (act_text (launcher_act 1 (launcher_ground))) "nothing")
            (check_str "the rest of the bar" (act_text (launcher_act (launcher_bar) (launcher_bar))) "nothing"))))

; The ground, then a label an app, centred, in white.
(def test_launcher_ops () int
  (let ops (launcher_ops 1280 768 (apps))
    (add (check_int "ground and four names" (length ops) 5)
         (match (head (tail (tail ops)))
           ((UiPText r s a c b sc) (add (check_str "the second's name" s "System Monitor") (check_str "where" (rect_text r) "508,136 128x16")))
           ((UiPFill r c) (fail_because "op" "a fill"))
           ((UiPRound r rad c u) (fail_because "op" "a round"))
           ((UiPIcon x y n c sc) (fail_because "op" "an icon"))
           ((UiPImage x y n d ts) (fail_because "op" "an image"))))))

(def test_launcher_state () int
  (add (check_bool "none is never shown" (launcher_shown (NoLauncher)) false)
       (add (check_int "nor pressed" (launcher_pressed (NoLauncher)) (launcher_none))
            (check_bool "none stays none" (launcher_shown (launcher_with (NoLauncher) true 1)) false))))
