; logo_menu.l0 -- the L0S menu of the top bar: the logo button, and the card of
; About, Shut Down and Restart it drops, as the Apple menu does.
;
; Like the launcher, its state is pure and wm acts on it: whether the
; card is shown, what the last press was on, which a release is compared
; with, and the paint of the logo and the card.

; The card's canvas, whether it is shown, and what the last press was on,
; a target as below; or no menu, if its buffer could not be made.
(data Menu (Menu Canvas bool int) (NoMenu))

; What a press or a release is on: nothing the menu takes, the logo
; button, the rest of the top bar, the page outside the card, the card
; between its rows, or a row by its number from 0.
(def menu_none () int -1)
(def menu_logo () int -2)
(def menu_bar () int -3)
(def menu_ground () int -4)
(def menu_card () int -5)

; The rows: About L0S, Shut Down and Restart.
(def menu_about () int 0)
(def menu_shutdown () int 1)
(def menu_restart () int 2)

; Whether it is shown, what the last press was on, and it with those
; changed; no menu is never shown, and stays none.
(def menu_shown ((m Menu)) bool
  (match m ((Menu c shown pressed) shown) ((NoMenu) false)))

; What its last press was on.
(def menu_pressed ((m Menu)) int
  (match m ((Menu c shown pressed) pressed) ((NoMenu) (menu_none))))

; It with shown and pressed in place of its own.
(def menu_with ((m Menu) (shown bool) (pressed int)) Menu
  (match m ((Menu c was p) (Menu c shown pressed)) ((NoMenu) m)))

; ------------------------------------------------------------------ layout

; The logo button's width, at the bar's start, and where the card is
; under the bar: 4 in from the screen's edge.
(def menu_logo_w () int 32)
(def menu_x () int 4)

; The card: 200 wide, 6 of padding round About's row, the separator
; under it, and the two rows of Shut Down and Restart, each ui_row_h.
(def menu_w () int 200)
(def menu_h () int 114)

; Row i's rectangle, in the card's own pixels: About at 6, then from 48
; a row each.
(def menu_row ((i int)) Rect
  (Rect (ui_space_s) (if (eq i 0) (ui_space_s) (add 48 (mul (sub i 1) (ui_row_h)))) (sub (menu_w) 12) (ui_row_h)))

; What x, y in the card's own pixels is on: a row, or the card.
(def menu_at ((x int) (y int)) int
  (if (rect_has (menu_row 0) x y) (menu_about)
      (rect_has (menu_row 1) x y) (menu_shutdown)
      (rect_has (menu_row 2) x y) (menu_restart)
      (menu_card)))

; What x, y on the screen is on, given the bar's height: the logo button,
; the rest of the bar, the card's rows or the card, or the page.
(def menu_target ((bar_h int) (x int) (y int)) int
  (if (lt y bar_h)
      (if (lt x (menu_logo_w)) (menu_logo) (menu_bar))
      (rect_has (Rect (menu_x) bar_h (menu_w) (menu_h)) x y) (menu_at (sub x (menu_x)) (sub y bar_h))
      (menu_ground)))

; ------------------------------------------------------------------ clicks

; What a click does, pressed on one target and released on another: a row
; done, if both are on it; the menu opened or closed, if both are on the
; logo; closed, if both are on the page or the rest of the bar; and
; nothing if the pointer went from one to another.
(data MenuAct (MenuDo int) (MenuToggle) (MenuClose) (MenuNothing))

; The MenuAct a press on one target and a release on another make.
(def menu_act ((press int) (release int)) MenuAct
  (if (not (eq press release)) (MenuNothing)
      (ge press 0) (MenuDo press)
      (eq press (menu_logo)) (MenuToggle)
      (or (eq press (menu_ground)) (eq press (menu_bar))) (MenuClose)
      (MenuNothing)))

; ---------------------------------------------------------------- painting

; The logo's mark, 22 by 22 at x, y: its plate, the L in amber and the 0
; as a blue ring, flat, as branding/logo.svg draws them.
(def menu_mark_ops ((x int) (y int)) (list UiPaint)
  (let plate (ui_hex "241f31")
    (cons (UiPRound (Rect x y 22 22) 5 plate (ui_black))
      (cons (UiPFill (Rect (add x 5) (add y 5) 2 12) (ui_hex "f0c850"))
        (cons (UiPFill (Rect (add x 5) (add y 16) 10 2) (ui_hex "f0c850"))
          (cons (UiPRound (Rect (add x 10) (add y 6) 11 11) 5 (ui_hex "3584e4") plate)
            (cons (UiPRound (Rect (add x 12) (add y 8) 7 7) 3 plate (ui_hex "3584e4"))
              (nil UiPaint))))))))

; The logo button's ops: the mark, on a pill while the card is shown.
(def menu_button_ops ((shown bool) (bar_h int)) (list UiPaint)
  (let mark (menu_mark_ops 5 (div (sub bar_h 22) 2))
    (if shown
        (cons (UiPRound (Rect 2 2 28 (sub bar_h 4)) 14 (ui_bar_active_bg) (ui_black)) mark)
        mark)))

; The card's ops: a bordered rounded card, About L0S, a separator, Shut
; Down, and Restart.
(def menu_ops () (list UiPaint)
  (let (s (ui_style) bg (ui_window_bg s))
    (cons (UiPFill (Rect 0 0 (menu_w) (menu_h)) (ui_black))
      (cons (UiPRound (Rect 0 0 (menu_w) (menu_h)) (ui_window_radius) (ui_border s bg) (ui_black))
        (cons (UiPRound (Rect 1 1 (sub (menu_w) 2) (sub (menu_h) 2)) (sub (ui_window_radius) 1) bg (ui_border s bg))
          (cons (UiPFill (Rect (ui_space_s) 43 (sub (menu_w) 12) 1) (ui_border s bg))
            (cons (menu_row_text 0 "About L0S" (ui_fg s))
              (cons (menu_row_text 1 "Shut Down" (ui_fg s))
                (cons (menu_row_text 2 "Restart" (ui_fg s)) (nil UiPaint))))))))))

; Row i's label, in the row's rectangle less 6 each side.
(def menu_row_text ((i int) (text (list int)) (color int)) UiPaint
  (let r (menu_row i)
    (UiPText (Rect (add (.x r) (ui_space_s)) (.y r) (sub (.w r) 12) (.h r)) text (UiStart) color (ui_text_font) false 1)))

; The card painted on c.
(def menu_paint ((c Canvas) (face UiFace)) Canvas
  (ui_paint c face (Rect 0 0 (menu_w) (menu_h)) (menu_ops)))
