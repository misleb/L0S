; A window, id i at x, y, its content 100 by 50, so 104 wide in its
; frame, of pid 7, events to port 9, its buffers in wm at 0xE8000000 and
; on; its client no app.
(def win ((i int) (x int) (y int)) Win (app_win i x y ""))

(def app_win ((i int) (x int) (y int) (app (list int))) Win
  (Win i 9 7 x y 100 50 0 (append "w" (digits i)) (Canvas (IoDevice 0) 104 98 0) 3892314112 3892346880
       (Bufs 5 4026531840 100 10 4026552320 false 0 (NoSpare) 0) app (Sizing 0 0 100 50 false (rect_none) (rect_none)) (ServerSide)))

; The same window, but its client decorates it: no chrome, and its
; content at x, y.
(def csd_win ((i int) (x int) (y int)) Win
  (Win i 9 7 x y 100 50 0 (append "c" (digits i)) (canvas_new 0 0 0) 3892314112 0
       (Bufs 5 4026531840 100 0 0 false 0 (NoSpare) 0) "" (Sizing 0 0 100 50 false (rect_none) (rect_none)) (ClientSide)))

; Which of ws want a frame, as their ids, and which do not.
(def wanting ((ws (list Win))) (list int)
  (if (is_empty ws) "" (append (if (win_frame_wanted (head ws)) (append (digits (win_id (head ws))) " ") "") (wanting (tail ws)))))

; Frame 4 told: window 2, which asked, is told and asks no more; window
; 3, which did not, is left, and the order kept.
(def test_frames_told () int
  (let ws (cons (win_framing (win 2 0 0) true) (cons (win 3 0 0) (nil Win)))
    (let ws2 (frames_told ws 4 (nil Win))
      (add (check_str "asked" (wanting ws) "2 ")
           (add (check_str "told" (wanting ws2) "")
                (check_int "order" (win_id (head ws2)) 2))))))

; What wm tells window 6's client of it names window 6, the notice after:
; read back as the client reads it, from wm's pid, 3.
(def test_told_of_names_window () int
  (let m (message_new 3 (told_of (win 6 0 0) (focus_notice true)))
    (match (win_notice_of m)
      ((WinNotice id at) (add (check_int "window 6" id 6) (check_bool "in front" (eq (focus_notice_at m at) (Some true)) true)))
      ((NoWinNotice) (fail_because "window 6" "no window notice")))))

; The pointer told relative to window 2's content, at 10, 40 with its
; title bar 46 high and its frame 2: -10 rows above it, as a press held
; outside gives, and window 2's id first.
(def test_told_of_pointer () int
  (let m (message_new 3 (told_of (win 2 10 40) (pointer_notice (relative (win 2 10 40) 30 76 1))))
    (match (win_notice_of m)
      ((WinNotice id at)
        (match (pointer_event_at m at)
          ((Some p) (match p ((PointerEvent x y b) (check_str "id x y" (unwords (cons (digits id) (cons (digits x) (cons (digits (add y 100)) (nil (list int)))))) "2 18 90"))))
          ((None) (fail_because "pointer" "not read"))))
      ((NoWinNotice) (fail_because "pointer" "no window notice")))))

; An input kind as a word, to compare.
(def input_kind_text ((k InputKind)) (list int)
  (match k ((InputKey) "key") ((InputPointer) "pointer") ((NotInput) "none")))

; One driver, pid 5, serving the keyboard and the pointer both: its key
; is a key, and its wheel's turn and its motion are the pointer's, told
; apart by what they say, not by the pid.
(def test_input_one_driver () int
  (add (check_str "key" (input_kind_text (input_kind 5 5 (message_new 5 (key_notice (KeyEvent 30 1 97 0))))) "key")
       (add (check_str "wheel" (input_kind_text (input_kind 5 5 (message_new 5 (wheel_notice (WheelEvent 0 0 0 1))))) "pointer")
            (check_str "motion" (input_kind_text (input_kind 5 5 (message_new 5 (motion_notice (PointerMotion 0 0 0 0 -1))))) "pointer"))))

; Two drivers, the keyboard's 5 and the pointer's 6: each one's notices by
; what they are; another pid's, 7, are no input, nor any before wm listens
; (both 0), even from pid 0, the kernel.
(def test_input_two_drivers () int
  (add (check_str "6's key" (input_kind_text (input_kind 5 6 (message_new 6 (key_notice (KeyEvent 30 1 97 0))))) "key")
       (add (check_str "7" (input_kind_text (input_kind 5 6 (message_new 7 (key_notice (KeyEvent 30 1 97 0))))) "none")
            (check_str "kernel" (input_kind_text (input_kind 0 0 (message_new 0 (key_notice (KeyEvent 30 1 97 0))))) "none"))))

; Two windows of one client, pid 7, both on its port 9, as a client with
; many windows on one port opens them: 1 in front at 0, 40, 2 behind it
; at 300, 40.
(def one_client () (list Win) (cons (win 1 0 40) (cons (win 2 300 40) (nil Win))))

; Both are the client's, and run windows says so: each line ends in pid 7.
(def test_one_client_two_windows () int
  (add (check_int "of pid 7" (length (of_pid (one_client) 7)) 2)
       (check_str "windows" (win_lines (one_client) true) "1 w1 0 40 100 50 front 7 buffer 8 frames 0\n2 w2 300 40 100 50 - 7 buffer 12 frames 0\n")))

; A key goes to the front window, 1, told with its id.
(def test_one_client_key_to_front () int
  (match (key_window (one_client))
    ((None) (fail_because "key" "no window"))
    ((Some w)
      (match (win_notice_of (message_new 3 (told_of w (key_notice (KeyEvent 30 1 97 0)))))
        ((WinNotice id at) (add (check_int "window 1" id 1) (check_int "port 9" (win_port w) 9)))
        ((NoWinNotice) (fail_because "key" "no window notice"))))))

; The pointer at 350, 100 is in window 2's content, 302 to 402 across and
; 86 to 136 down (its frame 2, its title bar 46), so it goes to window 2,
; behind, told with its id, at 48, 14 in it.
(def test_one_client_pointer_to_under () int
  (match (pointer_target (one_client) (NoDrag) 350 100 -1)
    ((None) (fail_because "pointer" "no window"))
    ((Some w)
      (let m (message_new 3 (told_of w (pointer_notice (relative w 350 100 0))))
        (match (win_notice_of m)
          ((WinNotice id at)
            (match (pointer_event_at m at)
              ((Some p) (match p ((PointerEvent x y b) (check_str "id x y" (unwords (cons (digits id) (cons (digits x) (cons (digits y) (nil (list int)))))) "2 48 14"))))
              ((None) (fail_because "pointer" "not read"))))
          ((NoWinNotice) (fail_because "pointer" "no window notice")))))))

; Closes asked of windows 1, 2 and 3, due at 500, 200 and 900: the first
; due is 200; none, -1.
(def closes () (list Closing)
  (cons (Closing 1 7 500) (cons (Closing 2 7 200) (cons (Closing 3 8 900) (nil Closing)))))

(def closing_ids ((cs (list Closing))) (list int)
  (if (is_empty cs) "" (match (head cs) ((Closing id pid t) (append (digits id) (append " " (closing_ids (tail cs))))))))

(def test_close_next () int
  (add (check_int "the soonest" (close_next (closes) -1) 200)
       (check_int "none" (close_next (nil Closing) -1) -1)))

; At 500, 1 and 2 are due, the one at 500 too; 3 is not, until 900.
(def test_closes_split () int
  (match (closes_split (closes) 500 (nil Closing) (nil Closing))
    ((Closes due later) (add (check_str "due" (closing_ids due) "1 2 ") (check_str "later" (closing_ids later) "3 ")))))

; A close due is forced only on a window still open and still its
; client's: window 2 of pid 7 is; window 2 of pid 8, or window 5, is not.
(def test_still_open () int
  (add (check_bool "open" (match (still_open (one_client) 2 7) ((Some w) true) ((None) false)) true)
       (add (check_bool "another client's" (match (still_open (one_client) 2 8) ((Some w) true) ((None) false)) false)
            (check_bool "closed" (match (still_open (one_client) 5 7) ((Some w) true) ((None) false)) false))))

; The window a launch brings forward, by its id or its id if it is none
; ("-" for no window).
(def launch_window_id ((ws (list Win)) (id int) (pid int)) (list int)
  (match (launch_window ws id pid) ((None) "-") ((Some w) (digits (win_id w)))))

; A launch's answer names window 2, behind: that one comes forward; 0,
; or a window that is not open or not the app's, its front one, 1; an
; app with no window, none.
(def test_launch_window () int
  (add (check_str "the one named" (launch_window_id (one_client) 2 7) "2")
       (add (check_str "0, its front" (launch_window_id (one_client) 0 7) "1")
            (add (check_str "closed" (launch_window_id (one_client) 5 7) "1")
                 (add (check_str "another's" (launch_window_id (one_client) 2 8) "-")
                      (check_str "no window" (launch_window_id (nil Win) 0 7) "-"))))))

; The app at port 9 is pid 7, whose windows' events go there; none at
; port 4.
(def test_port_client () int
  (add (check_int "port 9" (port_client (one_client) 9) 7)
       (check_int "port 4" (port_client (one_client) 4) -1)))

; The close button asks with the close notice, naming the window.
(def test_close_notice_told () int
  (let m (message_new 3 (told_of (win 4 0 40) (close_notice)))
    (match (win_notice_of m)
      ((WinNotice id at) (add (check_int "window 4" id 4) (check_bool "close" (is_close_notice_at m at) true)))
      ((NoWinNotice) (fail_because "close" "no window notice")))))

(def test_with_id () int
  (let ws (cons (win 1 0 0) (cons (win 2 5 5) (nil Win)))
    (add (check_int "found" (length (with_id ws 2)) 1)
         (add (check_int "the one" (win_id (head (with_id ws 2))) 2)
              (check_int "none" (length (with_id ws 9)) 0)))))

(def placed_text ((ls (list Placed))) (list int)
  (if (is_empty ls)
      ""
      (match (head ls)
        ((Placed id x y top) (append (one_placed id x y top) (placed_text (tail ls)))))))

(def one_placed ((id int) (x int) (y int) (top int)) (list int)
  (append (digits id) (append "@" (append (digits x) (append "," (append (digits y) (append "/" (append (digits top) " "))))))))

(def ids ((ws (list Win))) (list int)
  (if (is_empty ws) "" (append (digits (win_id (head ws))) (append " " (ids (tail ws))))))

; ---------------------------------------------------------------- layers

(def test_layers_desktop () int
  (check_str "the desktop and the bar" (placed_text (layers (nil Win) false)) "0@0,0/0 2@0,0/0 "))

; Window 1 in front of window 0: the desktop, then 0's chrome and
; content, 5 and 4, the content 2 in and under the title bar, then 1's,
; 9 and 8, then the top bar over them all.
(def test_layers_order () int
  (check_str "back to front"
    (placed_text (layers (cons (win 1 50 60) (cons (win 0 10 20) (nil Win))) false))
    "0@0,0/0 5@10,20/0 4@12,66/0 9@50,60/0 8@52,106/0 2@0,0/0 "))

; A window its client decorates is its content alone, 4, at its own top
; left: no chrome, 5, under it.
(def test_layers_csd () int
  (check_str "content only"
    (placed_text (layers (cons (csd_win 0 10 20) (nil Win)) false))
    "0@0,0/0 4@10,20/0 2@0,0/0 "))

; Window 0, decorated by its client, 100 by 50 at 10, 20: all of it is its
; content, its title bar's rows too, so the press goes to the client; the
; border round it, the top's too, is its edges; its cut corner is its
; corner's; and nothing of it is wm's title bar or close button.
(def test_hit_csd () int
  (let ws (cons (csd_win 0 10 20) (nil Win))
    (add (check_str "its top rows are content" (hit_text (hit ws 60 25)) "content 0 50,5")
         (add (check_str "its top right, no close button" (hit_text (hit ws 100 30)) "content 0 90,10")
              (add (check_str "above it, the top" (hit_text (hit ws 60 17)) "edge 0 4")
                   (add (check_str "its right" (hit_text (hit ws 112 40)) "edge 0 2")
                        (check_str "its cut top left" (hit_text (hit ws 10 20)) "edge 0 5")))))))

; With no frame, the edges are only outside: the window's own first and
; last columns are its content's.
(def test_edges_csd () int
  (add (check_int "its first column" (edges_at (ClientSide) 100 50 0 25) 0)
       (add (check_int "left of it" (edges_at (ClientSide) 100 50 -1 25) 1)
            (add (check_int "its last row" (edges_at (ClientSide) 100 50 50 49) 0)
                 (check_int "under it" (edges_at (ClientSide) 100 50 50 50) 8)))))

; The pointer in a client-decorated window's content, at its own top
; left, 50, 60: 60, 70 is 10, 10 of it.
(def test_pointer_relative_csd () int
  (match (relative (csd_win 1 50 60) 60 70 1)
    ((PointerEvent x y b) (add (check_int "across" x 10) (check_int "down" y 10)))))

; With no title bar or frame, a window at 50, 100 may grow to the
; screen's edges: 590 across, 380 down, on 640 by 480.
(def test_resize_geometry_csd () int
  (add (check_str "right, to the screen" (size_text (resize_geometry (ClientSide) 2 400 7 50 100 300 200 640 480)) "590x200")
       (check_str "bottom, to the screen" (size_text (resize_geometry (ClientSide) 8 7 400 50 100 300 200 640 480)) "300x380")))

; Maximized on a 640x480 screen, a window is at 0, 32, under the bar:
; one wm decorates 4 narrower for its border and 48 shorter for its
; title bar and foot, 636x400; one its client decorates all of it,
; 640x448.
(def test_maximized_rect () int
  (add (check_str "wm's" (place_text (maximized_rect (ServerSide) 640 480)) "0,32 636x400")
       (check_str "the client's" (place_text (maximized_rect (ClientSide) 640 480)) "0,32 640x448")))

; A place and size as X,Y WxH.
(def place_text ((r Rect)) (list int)
  (append (digits (rect_x r)) (append "," (append (digits (rect_y r)) (append " " (append (digits (rect_w r)) (append "x" (digits (rect_h r)))))))))

; A window keeps where it is restored to, and none at first.
(def test_win_restore () int
  (add (check_bool "none" (rect_empty (win_restore (csd_win 1 10 20))) true)
       (check_str "kept" (place_text (win_restore (win_maxing (csd_win 1 10 20) (Rect 10 20 100 50) (rect_none)))) "10,20 100x50")))

; A client's move starts only with nothing dragged, the left button down,
; and the pointer held for its window.
(def test_move_may () int
  (add (check_bool "held for it" (move_may (NoDrag) 1 3 3) true)
       (add (check_bool "no button" (move_may (NoDrag) 0 3 3) false)
            (add (check_bool "the right one alone" (move_may (NoDrag) 2 3 3) false)
                 (add (check_bool "held for another" (move_may (NoDrag) 1 4 3) false)
                      (check_bool "already dragging" (move_may (Dragging 3 0 0 0) 1 3 3) false))))))

; A second press on window 3's title bar 100 ms after the first is a
; double click; one 500 ms after, past GTK's 400, or on window 4, is not;
; nor is one after none.
(def test_title_double () int
  (add (check_bool "100 ms on" (title_double (TitleClick 3 1000000000) 3 1100000000) true)
       (add (check_bool "500 ms on" (title_double (TitleClick 3 1000000000) 3 1500000000) false)
            (check_bool "another window" (title_double (TitleClick 3 1000000000) 4 1100000000) false))))

(def test_title_double_none () int
  (check_bool "after none" (title_double (TitleClick -1 0) 3 100) false))

; A client may ask to drag one edge, as the right (2), or two that meet,
; as the bottom right (2 + 8); not two that face, as the left and right
; (1 + 2), nor none, nor bits no edge has.
(def test_edges_ok () int
  (add (check_bool "the right" (edges_ok 2) true)
       (check_bool "the bottom right" (edges_ok 10) true)))

(def test_edges_ok_facing () int
  (add (check_bool "left and right" (edges_ok 3) false)
       (check_bool "top and bottom" (edges_ok 12) false)))

(def test_edges_ok_none () int
  (add (check_bool "none" (edges_ok 0) false)
       (check_bool "past them" (edges_ok 16) false)))

; A window whose buffers a resize has made in the other bank is shown
; from those: window 0's, 7 and 6.
(def test_layers_bank () int
  (check_str "the other bank"
    (placed_text (layers (cons (win_in_bank (win 0 10 20) 1 1) (nil Win)) false))
    "0@0,0/0 7@10,20/0 6@12,66/0 2@0,0/0 "))

; One whose content alone an attach has moved to its other bank: its
; chrome 5, its content 6.
(def test_layers_content_bank () int
  (check_str "the content's bank"
    (placed_text (layers (cons (win_in_bank (win 0 10 20) 0 1) (nil Win)) false))
    "0@0,0/0 5@10,20/0 6@12,66/0 2@0,0/0 "))

; w with its chrome's ids in bank k and its content's in bank kc.
(def win_in_bank ((w Win) (k int) (kc int)) Win
  (match w
    ((Win id port pid x y cw ch top title tc cva tva bf app sz dc)
      (match bf
        ((Bufs cn dcva csd tn dtva fw ck sp nt)
          (Win id port pid x y cw ch top title tc cva tva (Bufs cn dcva csd tn dtva fw kc sp nt) app (Sizing k 0 cw ch false (rect_none) (rect_none)) dc))))))

; Window 2 with another buffer attached at 0xE9000000, 5 pages, as wm
; keeps it until a damage commits it.
(def pending_win () Win (win_with_spare (win 2 0 0) (Spare 3909091328 5 4026600000 100 100 50 true)))

; A commit shows the attached buffer: its address the content's, under
; the other bank, 4 + 4·2 + 2 = 14; the one shown before kept as the
; other buffer, under bank 0's id, 12, and no longer attached.
(def test_win_swapped () int
  (let w2 (win_swapped (pending_win))
    (add (check_int "content" (win_cva w2) 3909091328)
         (add (check_int "its id" (win_content_id w2) 14)
              (add (check_int "the other's id" (win_spare_id w2) 12)
                   (check_bool "not attached" (win_pending w2) false))))))

; A window with nothing attached stays as it is.
(def test_win_swapped_none () int
  (check_int "content" (win_cva (win_swapped (win 2 0 0))) 3892314112))

; Whether any window has its other buffer attached, waiting for the
; damage that commits it.
(def test_pending () int
  (add (check_bool "one" (any_pending (cons (win 1 0 0) (cons (pending_win) (nil Win)))) true)
       (check_bool "none" (any_pending (cons (win 1 0 0) (nil Win))) false)))

; A resize into the other buffer keeps the content it had as the other
; buffer, of its size then; one into the buffer it has keeps none.
(def test_resized_bufs () int
  (let obf (win_bufs (pending_win))
    (add (check_int "kept" (spare_va (match (resized_bufs obf 3892314112 100 50 3909091328 5 4026600000 100 10 4026552320)
                                        ((Bufs cn dcva csd tn dtva fw ck sp nt) sp))) 3892314112)
         (check_int "in place" (spare_va (match (resized_bufs obf 3892314112 100 50 3892314112 5 4026531840 100 10 4026552320)
                                           ((Bufs cn dcva csd tn dtva fw ck sp nt) sp))) -1))))

(def test_layers_top () int
  (check_str "the content's row"
    (placed_text (layers (cons (win_top (win 0 10 20) 32) (nil Win)) false))
    "0@0,0/0 5@10,20/0 4@12,66/32 2@0,0/0 "))

; The launcher, 3, under the bar, in place of the windows.
(def test_layers_launcher () int
  (check_str "no window" (placed_text (layers (two) true)) "0@0,0/0 3@0,32/0 2@0,0/0 "))

(def test_buffer_ids () int
  (add (check_int "the launcher's" (launcher_id) 3)
       (add (check_int "the first content" (content_id 0 0) 4)
            (add (check_int "window 1's chrome" (chrome_id 1 0) 9)
                 (check_int "window 1's chrome, in the other bank" (chrome_id 1 1) 11)))))

; ------------------------------------------------------------------- hits

(def hit_text ((h Hit)) (list int)
  (match h
    ((OnDesktop) "desktop")
    ((OnClose w) (append "close " (digits (win_id w))))
    ((OnTitle w) (append "title " (digits (win_id w))))
    ((OnContent w x y) (append "content " (append (digits (win_id w)) (append " " (append (digits x) (append "," (digits y)))))))
    ((OnFrame w) (append "frame " (digits (win_id w))))
    ((OnEdge w e) (append "edge " (append (digits (win_id w)) (append " " (digits e)))))))

(def two () (list Win) (cons (win 1 50 60) (cons (win 0 10 20) (nil Win))))

(def test_hit_title () int
  (check_str "the front one's" (hit_text (hit (two) 60 70)) "title 1"))

; Window 1's bar is 104 wide at 50, 60: its close button is 24 square,
; 6 in from its right and in the middle of its 45 rows, at 74, 10 in it,
; so 124 to 147 across and 70 to 93 down on the screen.
(def test_hit_close () int
  (add (check_str "on it" (hit_text (hit (two) 125 75)) "close 1")
       (add (check_str "its far corner" (hit_text (hit (two) 147 93)) "close 1")
            (add (check_str "right of it, the bar" (hit_text (hit (two) 148 80)) "title 1")
                 (add (check_str "under it, the bar" (hit_text (hit (two) 130 94)) "title 1")
                      (check_str "left of it, the bar" (hit_text (hit (two) 123 80)) "title 1"))))))

(def test_on_close () int
  (add (check_bool "inside" (on_close 640 615 15) true)
       (add (check_bool "the last pixel" (on_close 640 633 33) true)
            (add (check_bool "past it" (on_close 640 634 20) false)
                 (check_bool "above it" (on_close 640 620 9) false)))))

(def test_hit_content () int
  (check_str "relative to the content" (hit_text (hit (two) 60 115)) "content 1 8,9"))

; Window 1's content is 52 to 151 across and 106 to 155 down; its frame
; is the two columns either side, and the two rows under it, which grab
; the left edge (1), the right (2) and the bottom (8), as does the border
; outside, 6 wide: row 158 is still the bottom's, row 164 the desktop's.
(def test_hit_frame () int
  (add (check_str "its left side" (hit_text (hit (two) 51 120)) "edge 1 1")
       (add (check_str "its right side" (hit_text (hit (two) 152 120)) "edge 1 2")
            (add (check_str "its foot" (hit_text (hit (two) 100 157)) "edge 1 8")
                 (add (check_str "below it, in the border" (hit_text (hit (two) 100 158)) "edge 1 8")
                      (check_str "past the border" (hit_text (hit (two) 100 164)) "desktop"))))))

; A window 100 by 50: 104 wide, 46 + 52 = 98 high. Left of it, the left
; edge; its lower left corner, within 12 of the foot, grabs the foot too;
; above it, the top; the title bar's own rows are no edge, nor is the
; content; and 6 outside is the end of the border.
(def test_edges_at () int
  (add (check_int "left" (edges_at (ServerSide) 100 50 -3 60) 1)
       (add (check_int "lower left" (edges_at (ServerSide) 100 50 -3 95) 9)
            (add (check_int "above" (edges_at (ServerSide) 100 50 50 -3) 4)
                 (add (check_int "upper left" (edges_at (ServerSide) 100 50 3 -3) 5)
                      (add (check_int "upper right" (edges_at (ServerSide) 100 50 101 -3) 6)
                           (add (check_int "right, outside" (edges_at (ServerSide) 100 50 109 60) 2)
                                (add (check_int "past the border" (edges_at (ServerSide) 100 50 110 60) 0)
                                     (add (check_int "the title bar" (edges_at (ServerSide) 100 50 1 20) 0)
                                          (add (check_int "the content" (edges_at (ServerSide) 100 50 50 60) 0)
                                               (add (check_int "the foot" (edges_at (ServerSide) 100 50 50 99) 8)
                                                    (check_int "the frame's corner" (edges_at (ServerSide) 100 50 1 97) 9))))))))))))

; A corner is grabbed 20 along each side, wherever the window has nothing
; of its own there: 15 left of the top left corner, outside; 15 up the
; frame's left side from the foot; the content's own bottom left pixel,
; which its corner cuts away; but not the content a little in from it, at
; 10, 44 of it, where the cut is 1 wide; nor the title bar's own pixels
; near its corner; and 21 along the border above, the top alone.
(def test_edges_corners () int
  (add (check_int "outside, along the top" (edges_at (ServerSide) 100 50 15 -3) 5)
       (add (check_int "up the frame's side" (edges_at (ServerSide) 100 50 1 83) 9)
            (add (check_int "the content's cut corner" (edges_at (ServerSide) 100 50 2 95) 9)
                 (add (check_int "the content, near it" (edges_at (ServerSide) 100 50 12 90) 0)
                      (add (check_int "the title bar, near its corner" (edges_at (ServerSide) 100 50 5 5) 0)
                           (check_int "past the corner" (edges_at (ServerSide) 100 50 21 -3) 4)))))))

; The pointer for each set of edges: across for a side, up and down for
; the top or foot, the diagonal a corner moves along.
; Each pointer is a buffer of its own: the arrow's 1, the I-beam's
; 100001, the last resize pointer's 100005, past the menu's 100000; an
; unknown name is the arrow.
(def test_pointer_id () int
  (add (check_int "the arrow" (pointer_id "") 1)
       (add (check_int "the I-beam" (pointer_id "text") 100001)
            (add (check_int "nesw" (pointer_id "nesw-resize") 100005)
                 (check_int "unknown" (pointer_id "busy") 1)))))

; A cursor request's default is the arrow; any other name is as it is.
(def test_pointer_named () int
  (add (check_str "default" (pointer_named "default") "")
       (check_str "text" (pointer_named "text") "text")))

; A pointer with nothing asked for.
(def ptr0 () Ptr (Ptr 0 0 0 -1 -1 ((MapEmpty int (list int))) "" (TitleClick -1 0)))

; What a window's client asked for is its window's alone, and goes with
; the window.
(def test_win_pointer () int
  (let p (ptr_asking (ptr_asking (ptr0) 3 "text") 5 "ew-resize")
    (add (check_str "window 3" (win_pointer p 3) "text")
         (add (check_str "window 4 asked nothing" (win_pointer p 4) "")
              (check_str "window 3 closed" (win_pointer (ptr_forgetting p 3) 3) "")))))

(def test_resize_cursor () int
  (add (check_str "left" (resize_cursor 1) "ew-resize")
       (add (check_str "bottom" (resize_cursor 8) "ns-resize")
            (add (check_str "top left" (resize_cursor 5) "nwse-resize")
                 (add (check_str "bottom right" (resize_cursor 10) "nwse-resize")
                      (add (check_str "top right" (resize_cursor 6) "nesw-resize")
                           (add (check_str "bottom left" (resize_cursor 9) "nesw-resize")
                                (check_str "none" (resize_cursor 0) ""))))))))

(def size_text ((s Size)) (list int)
  (match s ((Size w h) (append (digits w) (append "x" (digits h))))))

; A window at 50, 100, 300 by 200, on a screen 640 by 480: its right edge
; dragged 30 right is 330 wide; its left edge 30 left, the same; its top
; edge 40 up, 240 high, but never above the bar, 268 at most; its bottom
; edge up 150, at the least 100 high; the right edge as far as the
; screen goes, 586.
(def test_resize_geometry () int
  (add (check_str "right" (size_text (resize_geometry (ServerSide)2 30 7 50 100 300 200 640 480)) "330x200")
       (add (check_str "left" (size_text (resize_geometry (ServerSide)1 -30 7 50 100 300 200 640 480)) "330x200")
            (add (check_str "top" (size_text (resize_geometry (ServerSide)4 7 -40 50 100 300 200 640 480)) "300x240")
                 (add (check_str "top, to the bar" (size_text (resize_geometry (ServerSide)4 7 -100 50 100 300 200 640 480)) "300x268")
                      (add (check_str "bottom, to the least" (size_text (resize_geometry (ServerSide)8 7 -150 50 100 300 200 640 480)) "300x100")
                           (add (check_str "right, to the screen" (size_text (resize_geometry (ServerSide)2 400 7 50 100 300 200 640 480)) "586x200")
                                (check_str "the corner, both" (size_text (resize_geometry (ServerSide)10 30 20 50 100 300 200 640 480)) "330x220"))))))))

; Window 0, at 10, 20, 104 by 46 + 52: its top left pixel is cut away,
; and grabs its top left corner, left and top (5); 9 in along its top
; row it is its own title bar again. Its frame's bottom right corner is
; cut too, and grabs the right and bottom edges (10).
(def test_hit_corners () int
  (add (check_str "the top left, cut" (hit_text (hit (cons (win 0 10 20) (nil Win)) 10 20)) "edge 0 5")
       (add (check_str "9 in, its own" (hit_text (hit (cons (win 0 10 20) (nil Win)) 19 20)) "title 0")
            (check_str "the bottom right, cut" (hit_text (hit (cons (win 0 10 20) (nil Win)) 113 117)) "edge 0 10"))))

(def test_cut_off () int
  (add (check_bool "a corner" (cut_off (ServerSide) 100 50 0 0) true)
       (add (check_bool "the middle of the top" (cut_off (ServerSide) 100 50 50 0) false)
            (check_bool "the left edge, mid way" (cut_off (ServerSide) 100 50 0 40) false))))

(def dirty_text ((ds (list Dirty))) (list int)
  (if (is_empty ds)
      ""
      (match (head ds)
        ((Dirty id r) (append (digits (rect_y r)) (append "+" (append (digits (rect_h r)) (append " " (dirty_text (tail ds))))))))))

; Rows of a ring of 100 read from row 90: rows 0 to 4 are its 90 to 94;
; rows 5 to 14 are its 95 to 99, then 0 to 4.
(def test_buffer_dirty () int
  (add (check_str "one" (dirty_text (rev (buffer_dirty 2 0 0 10 5 90 100 (nil Dirty)))) "90+5 ")
       (check_str "wrapped, two" (dirty_text (rev (buffer_dirty 2 0 5 10 10 90 100 (nil Dirty)))) "95+5 0+5 ")))

(def test_hit_behind () int
  (check_str "the back one, where the front is not" (hit_text (hit (two) 15 25)) "title 0"))

(def test_hit_desktop () int
  (add (check_str "outside" (hit_text (hit (two) 500 500)) "desktop")
       (check_str "past the border" (hit_text (hit (two) 160 70)) "desktop")))

; ---------------------------------------------------------------- stacking

(def test_raised () int
  (add (check_str "to the front" (ids (raised (two) 0)) "0 1 ")
       (check_str "already" (ids (raised (two) 1)) "1 0 ")))

(def test_without_win () int
  (check_str "gone" (ids (without_win (two) 1)) "0 "))

(def test_replaced () int
  (check_str "moved, in place"
    (placed_text (layers (replaced (two) (win_at (win 0 10 20) 200 300)) false))
    "0@0,0/0 5@200,300/0 4@202,346/0 9@50,60/0 8@52,106/0 2@0,0/0 "))

(def test_of_pid () int
  (add (check_int "pid 7's" (length (of_pid (two) 7)) 2)
       (check_int "none of 8's" (length (of_pid (two) 8)) 0)))

(def test_cascade () int
  (add (check_str "the first" (placed_text (cons (cascade 0 (ServerSide) 640 384 1280 800) (nil Placed))) "0@40,40/0 ")
       (add (check_str "the second" (placed_text (cons (cascade 1 (ServerSide) 640 384 1280 800) (nil Placed))) "0@100,90/0 ")
            (add (check_str "the eighth, back to the top, past the bottom" (placed_text (cons (cascade 7 (ServerSide) 640 384 1280 800) (nil Placed))) "0@460,40/0 ")
                 (add (check_str "back to the left, past the right edge" (placed_text (cons (cascade 3 (ServerSide) 640 384 800 640) (nil Placed))) "0@40,190/0 ")
                      (check_str "with no title bar, the eighth fits" (placed_text (cons (cascade 7 (ClientSide) 640 384 1280 800) (nil Placed))) "0@460,390/0 "))))))

(def test_scaled () int
  (add (check_int "the left" (scaled 0 1280) 0)
       (add (check_int "the right" (scaled 32767 1280) 1279)
            (check_int "the middle" (scaled 16384 800) 399))))

; A mouse moves the pointer a pixel a count, and the screen's edges stop
; it: on a 1280-wide screen, 0 to 1279.
(def test_nudge_clamped () int
  (add (check_int "within" (clamp (add 600 7) 0 1279) 607)
       (add (check_int "past the left" (clamp (add 3 -10) 0 1279) 0)
            (check_int "past the right" (clamp (add 1275 127) 0 1279) 1279))))

; A motion as text: dx dy buttons wdx wdy.
(def motion_text ((m PointerMotion)) (list int)
  (match m ((PointerMotion dx dy b wx wy) (unwords (cons (digits dx) (cons (digits dy) (cons (digits b) (cons (digits wx) (cons (digits wy) (nil (list int)))))))))))

; Motions queued behind one are joined, their moves added, the later
; one's buttons kept: 3-5 and -1+2.
(def test_motion_joined () int
  (check_str "added" (motion_text (motion_joined (PointerMotion 3 -1 1 0 0) (PointerMotion -5 2 1 0 0))) "-2 1 1 0 0"))

; Only motions that turn no wheel join, and only while the buttons stay
; as they were, so a press or a release is never lost.
(def test_motion_joins () int
  (add (check_bool "no wheel" (motion_joins (PointerMotion 4 4 0 0 0)) true)
       (add (check_bool "a wheel's turn" (motion_joins (PointerMotion 0 0 0 0 1)) false)
            (check_bool "a press" (same_buttons (PointerMotion 1 1 0 0 0) (PointerMotion 1 1 1 0 0)) false))))

; -------------------------------------------------------------- requests

; The bar in front and in the backdrop: the same parts, painted otherwise.
(def test_title_nodes () int
  (add (check_int "the same parts" (length (title_nodes "vt1" 640 true)) (length (title_nodes "vt1" 640 false)))
       (check_bool "painted otherwise" (eq (title_nodes "vt1" 640 true) (title_nodes "vt1" 640 false)) false)))

(def test_pointer_relative () int
  (match (relative (win 1 50 60) 40 100 1)
    ((PointerEvent x y b) (add (check_int "left of it, past the frame" x -12) (check_int "in its content" y -6)))))

; The wheel's turn kept, where the pointer is made relative as a pointer
; event's is: 60, 115 is 8, 9 in window 1's content, at 50 + 2, 60 + 46.
(def test_wheel_relative () int
  (check_bool "8, 9, three down" (eq (wheel_relative (win 1 50 60) 60 115 (WheelEvent 0 0 0 3)) (WheelEvent 8 9 0 3)) true))

; Nothing on a window's frame goes to its client.
(def test_pointer_on_frame () int
  (check_bool "not the client's" (eq (pointer_target (two) (NoDrag) 51 120 -1) ((None Win))) true))

; ---------------------------------------------------------------- frames

(def test_outer () int
  (add (check_int "wider by both sides" (outer_w (ServerSide) 100) 104)
       (add (check_int "higher by its foot" (frame_h (ServerSide) 50) 52)
            (add (check_int "with no frame, its content's width" (outer_w (ClientSide) 100) 100)
                 (check_int "and height" (chrome_h (ClientSide) 50) 50)))))

(def test_radii () int
  (add (check_int "the frame's" (bottom_radius (ServerSide) 100 50) 12)
       (add (check_int "the content's, inside it" (inner_radius (ServerSide) 100 50) 10)
            (add (check_int "the title bar's" (top_radius (ServerSide) 100 50) 12)
                 (add (check_int "with no chrome, the content's top" (top_radius (ClientSide) 100 50) 12)
                      (add (check_int "and its foot" (inner_radius (ClientSide) 100 50) 12)
                           (check_int "no more than half a short window" (top_radius (ClientSide) 100 16) 8)))))))

(def fill_text ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (match (head ops)
        ((UiPFill r c) (append (one_rect r) (fill_text (tail ops))))
        ((UiPRound r radius c under) (fill_text (tail ops)))
        ((UiPText r s a c f bold scale) (fill_text (tail ops)))
        ((UiPIcon x y name c scale) (fill_text (tail ops)))
        ((UiPImage x y n d ts) (fill_text (tail ops))))))

(def one_rect ((r Rect)) (list int)
  (match r ((Rect x y w h) (unwords (cons (digits x) (cons (digits y) (cons (digits w) (cons (append (digits h) " ") (nil (list int))))))))))

(def first_color ((ops (list UiPaint))) int
  (match (head ops)
    ((UiPFill r c) c)
    ((UiPRound r radius c under) c)
    ((UiPText r s a c f bold scale) c)
    ((UiPIcon x y name c scale) c)
    ((UiPImage x y n d ts) -1)))

; A frame 104 by 52, under the 46 rows of the title bar in a chrome 98
; high: its sides, its foot, and its bottom corners, 12 square.
(def test_frame_ops () int
  (check_str "its parts" (fill_text (frame_ops 100 50 true)) "0 46 2 52 102 46 2 52 0 96 104 2 0 86 12 12 92 86 12 12 "))

(def test_frame_color () int
  (add (check_int "in front, the active bar's" (first_color (frame_ops 100 50 true)) (ui_hex "303030"))
       (check_int "in the backdrop, its" (first_color (frame_ops 100 50 false)) (ui_hex "242424"))))

; What is painted is what is damaged: a rectangle a part.
(def test_frame_rects () int
  (add (check_int "a rectangle a part" (length (frame_rects 100 50)) 5)
       (check_bool "the left side first" (eq (head (frame_rects 100 50)) (Rect 0 46 2 52)) true)))

(def test_pointer_target () int
  (add (check_bool "its content" (eq (pointer_target (two) (NoDrag) 60 115 -1) (Some (win 1 50 60))) true)
       (add (check_bool "a title bar is not" (eq (pointer_target (two) (NoDrag) 60 70 -1) ((None Win))) true)
            (check_bool "held by a press, anywhere" (eq (pointer_target (two) (NoDrag) 900 900 0) (Some (win 0 10 20))) true))))

(def test_window_lines () int
  (check_str "front first"
    (win_lines (two) true)
    "1 w1 50 60 100 50 front 7 buffer 8 frames 0\n0 w0 10 20 100 50 - 7 buffer 4 frames 0\n"))

; A window told a frame counts it, and its line says so; after a commit
; it shows its other buffer, under the other bank: 14 for window 2.
(def test_window_line_frames () int
  (add (check_str "told" (win_lines (frames_told (cons (win_framing (win 2 0 0) true) (nil Win)) 3 (nil Win)) false)
                  "2 w2 0 0 100 50 - 7 buffer 12 frames 1\n")
       (check_str "swapped" (win_lines (cons (win_swapped (pending_win)) (nil Win)) false)
                  "2 w2 0 0 100 50 - 7 buffer 14 frames 0\n")))

; Under an operating system there is no display.
(def test_no_display () int
  (check_int "fails" (wm) 1))

; ---------------------------------------------------------------- the bar

(def text_of ((p UiPaint)) (list int)
  (match p
    ((UiPFill r c) "")
    ((UiPRound r radius c under) "")
    ((UiPText r s a c f bold scale) s)
    ((UiPIcon x y name c scale) "")
    ((UiPImage x y n d ts) "")))

(def rect_of ((p UiPaint)) Rect
  (match p
    ((UiPFill r c) r)
    ((UiPRound r radius c under) r)
    ((UiPText r s a c f bold scale) r)
    ((UiPIcon x y name c scale) (Rect x y 16 16))
    ((UiPImage x y n d ts) (Rect x y n n))))

; Its ground across the screen, Applications, the title, then the clock.
(def test_bar_ops () int
  (let ops (bar_ops 1280 false false "vt1" "Oct 15  22:42")
    (add (check_bool "the ground" (eq (rect_of (head ops)) (Rect 0 0 1280 32)) true)
         (add (check_str "Applications" (text_of (nth_op ops 1)) "Applications")
              (add (check_str "the title" (text_of (nth_op ops 2)) "vt1")
                   (check_str "the clock" (text_of (nth_op ops 3)) "Oct 15  22:42"))))))

(def nth_op ((ops (list UiPaint)) (i int)) UiPaint
  (if (eq i 0) (head ops) (nth_op (tail ops) (sub i 1))))

; Applications is 5183 units of Source Sans 3, kerned, 69.11 pixels, so 70,
; with 12 either side: 94 wide, after the logo's 32. While the launcher
; is open, a pill 4 in from its edges is behind it, as round as it is
; high, 24. The logo's mark is five ops after the clock's.
(def test_bar_button () int
  (let ops (bar_ops 1280 true false "" "")
    (add (check_int "its room" (bar_apps_w) 94)
         (add (check_int "a pill more, and the logo's mark" (length ops) 10)
              (match (nth_op ops 1)
                ((UiPRound r radius c under) (add (check_bool "the pill" (eq r (Rect 36 4 86 24)) true)
                                                  (check_str "lit" (hex_digits c 6) "404040")))
                ((UiPFill r c) (fail_because "pill" "a fill"))
                ((UiPText r s a c f bold scale) (fail_because "pill" "text"))
                ((UiPIcon x y name c scale) (fail_because "pill" "an icon"))
                ((UiPImage x y n d ts) (fail_because "pill" "an image")))))))

; The clock is 5592 units of bold Source Sans 3, kerned, 74.56 pixels, so 75,
; in the middle of 1280: the title has from Applications' end, 126, up
; to 12 before it, 1205 / 2 - 12 - 126 = 464 pixels; with no clock,
; 640 - 138 = 502.
(def test_bar_title_room () int
  (add (check_bool "beside the clock" (eq (rect_of (nth_op (bar_ops 1280 false false "vt1" "Oct 15  22:42") 2)) (Rect 126 0 464 32)) true)
       (check_bool "with no clock, half the bar" (eq (rect_of (nth_op (bar_ops 1280 false false "vt1" "") 2)) (Rect 126 0 502 32)) true)))

(def test_bar_title () int
  (add (check_str "the front one's" (bar_title (two) false) "w1")
       (add (check_str "none" (bar_title (nil Win) false) "")
            (check_str "the launcher's open" (bar_title (two) true) ""))))

; A window of an app's client is named by the app, as GNOME Shell's app
; menu names it.
(def test_bar_title_app () int
  (add (check_str "the app" (bar_title (cons (app_win 1 0 40 "Terminal") (nil Win)) false) "Terminal")
       (check_str "behind, it does not" (bar_title (cons (win 2 0 40) (cons (app_win 1 0 40 "Terminal") (nil Win))) false) "w2")))

; Applications' button, 94 wide, from the logo's 32: 32 to 125.
(def test_on_apps_button () int
  (add (check_bool "its first pixel" (on_apps_button 32 0) true)
       (add (check_bool "its last" (on_apps_button 125 31) true)
            (add (check_bool "past it" (on_apps_button 126 10) false)
                 (add (check_bool "the logo's is not it" (on_apps_button 31 10) false)
                      (check_bool "under the bar" (on_apps_button 40 32) false))))))

(def test_on_logo_button () int
  (add (check_bool "its first pixel" (on_logo_button 0 0) true)
       (add (check_bool "its last" (on_logo_button 31 31) true)
            (add (check_bool "past it" (on_logo_button 32 10) false)
                 (check_bool "under the bar" (on_logo_button 10 32) false)))))

; The card is layered under the bar, over the windows.
(def test_layers_menu () int
  (check_str "under the bar"
    (placed_text (menu_layered (layers (nil Win) false) true))
    "0@0,0/0 100000@4,32/0 2@0,0/0 "))

; Under an operating system there is no process to be an app.
(def test_client_app_none () int
  (check_str "no app" (client_app (Bar (Canvas (IoDevice 0) 1 1 0) -1 -1 (nil App) (NoLauncher) (NoMenu) (nil Launch)) 7) ""))

(def test_bar_clock_text () int
  (add (check_str "no clock" (bar_clock_text -1) "")
       (check_str "the time" (bar_clock_text 1792108800) "Oct 16  00:00")))

(def test_on_bar () int
  (add (check_bool "its last row" (on_bar 31) true)
       (check_bool "below it" (on_bar 32) false)))

(def test_below_bar () int
  (add (check_int "kept below" (below_bar 5) 32)
       (check_int "left be" (below_bar 100) 100)))

; Nothing under the bar goes to a window, even one there; a window holding
; the pointer still has it.
(def test_pointer_on_bar () int
  (add (check_bool "not the window under it" (eq (pointer_target (cons (win 0 10 20) (nil Win)) (NoDrag) 40 25 -1) ((None Win))) true)
       (check_bool "held, still" (eq (pointer_target (cons (win 0 10 20) (nil Win)) (NoDrag) 40 25 0) (Some (win 0 10 20))) true)))

(def test_bar_with_apps () int
  (let b (Bar (Canvas (IoDevice 0) 1 1 0) 5 7 (nil App) (NoLauncher) (NoMenu) (nil Launch))
    (let b2 (bar_with_apps b (cons (App "Disks" "/Applications/Disks.app/disks" "" "") (nil App)))
      (add (check_int "an app" (length (bar_apps b2)) 1)
           (add (check_int "the clock kept" (bar_clock b2) 5)
                (check_bool "no launcher kept" (launcher_shown (bar_launcher b2)) false))))))

; Under an operating system there is no process to be an app's.
(def test_installed_app_name () int
  (check_str "no app" (installed_app_name "/Applications/Disks.app/disks") ""))

; The screen in its own pixels is the desktop's size times its scale.
(def test_desktop_line () int
  (add (check_str "one app" (desktop_line 1280 800 1 1 true) "the screen is 1280x800 at scale 1, 1 app, with a clock, serving compositor")
       (check_str "scaled" (desktop_line 1920 1080 2 4 false) "the screen is 3840x2160 at scale 2, 4 apps, with no clock, serving compositor")))
