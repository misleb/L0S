; snip_test.l0 -- a screenshot's area from a drag, its outline, and the
; arguments /bin/snip is given.

(def rect_text ((r Rect)) (list int)
  (unwords (numbers_words (cons (.x r) (cons (.y r) (cons (.w r) (cons (.h r) (nil int))))))))

; A press is an area of one pixel; a drag either way is the same area.
(def test_snip_area () int
  (add (check_str "a press" (rect_text (snip_area 10 20 10 20 100 100)) "10 20 1 1")
       (add (check_str "down right" (rect_text (snip_area 10 20 30 50 100 100)) "10 20 21 31")
            (check_str "up left" (rect_text (snip_area 30 50 10 20 100 100)) "10 20 21 31"))))

; Kept on the screen.
(def test_snip_area_kept () int
  (check_str "kept" (rect_text (snip_area 90 90 150 -5 100 100)) "90 0 10 91"))

; Four strips 2 thick inside the area; the area itself if it is too
; small for an inside; none for none.
(def test_snip_outline () int
  (let o (snip_outline (Rect 10 10 20 10))
    (add (check_int "four" (length o) 4)
         (add (check_str "top" (rect_text (head o)) "10 10 20 2")
              (add (check_str "right" (rect_text (nth o 3)) "28 12 2 6")
                   (add (check_int "small" (length (snip_outline (Rect 0 0 3 3))) 1)
                        (check_int "none" (length (snip_outline (Rect 0 0 0 0))) 0)))))))

(def test_snip_args () int
  (check_str "args" (unwords (snip_args (Rect 1 2 30 40))) "1 2 30 40"))

; Pixel 3 of row 2 of a screen 10 wide is word 23, byte 92.
(def test_snip_span_at () int
  (check_int "byte" (snip_span_at 10 3 2) 92))
