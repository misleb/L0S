; snip.l0 -- the screenshot's area, chosen with the pointer, as GNOME's
; screenshot tool chooses one: the screen frozen, a capture of it shown
; over everything, and a rectangle dragged out on it, outlined, which
; /bin/snip then saves. Pure, as the launcher is: wm keeps the state and
; acts on it.

; Choosing an area: the frozen screen's canvas, its buffer's pages and
; where they are, its pixels as captured, the screen's words row after
; row, to put back what the outline covers; where the press was, and the
; area now, in the desktop's pixels, empty before a press; and whether
; the button is held. Or not choosing.
(data Snip (Snipping (c Canvas) (va int) (pages int) (px bytes) (ax int) (ay int) (sel Rect) (held bool)) (NoSnip))

; Whether an area is being chosen.
(def snipping ((s Snip)) bool (match s ((Snipping c va pages px ax ay sel held) true) ((NoSnip) false)))

; The area from a press at ax, ay to the pointer at x, y, either way, on
; a screen w by h: its corners each pixel's own, so a press and a drag
; one pixel on make an area two wide, and kept on the screen.
(def snip_area ((ax int) (ay int) (x int) (y int) (w int) (h int)) Rect
  (let (x0 (max 0 (min ax x))
        y0 (max 0 (min ay y))
        x1 (min w (add (max ax x) 1))
        y1 (min h (add (max ay y) 1)))
    (Rect x0 y0 (max 0 (sub x1 x0)) (max 0 (sub y1 y0)))))

; How thick the outline is.
(def snip_line () int 2)

; The outline of r, inside it: its top, its foot, and its sides between
; them; r itself if it is too small to have an inside; none for empty r.
(def snip_outline ((r Rect)) (list Rect)
  (let t (snip_line)
    (if (rect_empty r) (nil Rect)
        (or (le (.w r) (mul 2 t)) (le (.h r) (mul 2 t))) (cons r (nil Rect))
        (cons (Rect (.x r) (.y r) (.w r) t)
          (cons (Rect (.x r) (sub (rect_y1 r) t) (.w r) t)
            (cons (Rect (.x r) (add (.y r) t) t (sub (.h r) (mul 2 t)))
              (cons (Rect (sub (rect_x1 r) t) (add (.y r) t) t (sub (.h r) (mul 2 t))) (nil Rect))))))))

; Where pixel x of row y is, in bytes, among a screen's words, the screen
; sw of its own pixels wide.
(def snip_span_at ((sw int) (x int) (y int)) int (mul (add (mul y sw) x) 4))

; snip's arguments for area r: X Y W H, the desktop's pixels.
(def snip_args ((r Rect)) (list (list int))
  (numbers_words (cons (.x r) (cons (.y r) (cons (.w r) (cons (.h r) (nil int)))))))
