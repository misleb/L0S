; status_test.l0 -- the status menu: its button, the card's targets and
; clicks, the volume's icon and slider, and what it asks the audio
; server as each answer comes.

; The menu shown, with output 1 at 50.
(def shown_out () Status (.vol (.shown (status_new 0) true) (StatusOut 1 50)))

; The card is as high with an output as without, so its two buffers' ids
; keep their heights whatever the volume; power open makes it taller.
(def test_status_heights () int
  (add (check_int "closed" (status_h false (StatusOut 1 50)) (status_h false (StatusNoOut)))
       (add (check_int "open" (status_h true (StatusOut 1 50)) (status_h true (StatusNoOut)))
            (check_true "taller open" (gt (status_h true (StatusNoOut)) (status_h false (StatusNoOut)))))))

; The button is 36 wide with the power icon alone, 60 with the speaker,
; at the bar's end.
(def test_status_button () int
  (add (check_int "power alone" (status_button_x 1280 (StatusNoOut)) 1244)
       (check_int "and the speaker" (status_button_x 1280 (StatusOut 1 50)) 1220)))

; Its ops: the power icon; the speaker first with an output; a pill
; behind them while shown.
(def test_status_button_ops () int
  (add (check_int "power" (length (status_button_ops 1280 32 false (StatusNoOut) 0 0 0)) 1)
       (add (check_int "speaker" (length (status_button_ops 1280 32 false (StatusOut 1 50) 0 0 0)) 2)
            (check_int "pill" (length (status_button_ops 1280 32 true (StatusOut 1 50) 0 0 0)) 3))))

(def test_status_vol_icon () int
  (add (check_str "0" (status_vol_icon 0) "audio-volume-muted")
       (add (check_str "33" (status_vol_icon 33) "audio-volume-low")
            (add (check_str "66" (status_vol_icon 66) "audio-volume-medium")
                 (check_str "67" (status_vol_icon 67) "audio-volume-high")))))

; On the bar: the button at its end, the rest the bar's; under it, the
; page, or the card while it is shown, at 916, 36 on a screen 1280 wide.
(def test_status_target () int
  (let st (status_new 0)
    (add (check_str "button" (status_target st 1280 32 1250 10) (status_button))
         (add (check_str "bar" (status_target st 1280 32 100 10) (status_bar))
              (add (check_str "page" (status_target st 1280 32 1000 50) (status_ground))
                   (check_str "card" (status_target (.shown st true) 1280 32 920 39) (status_card)))))))

; The card's buttons and the slider are where the layout puts them.
(def test_status_target_buttons () int
  (let (st (shown_out)
        ns (status_nodes st))
    (add (check_str "snip" (target_of st ns (status_snip)) (status_snip))
         (add (check_str "power" (target_of st ns (status_power)) (status_power))
              (check_true "slider" (status_on_slider (target_of st ns (ui_scale_node_action (status_volume) 0 100))))))))

; What is at the middle of the node of action a, on the screen.
(def target_of ((st Status) (ns (list UiNode)) (a (list int))) (list int)
  (match (ui_node_with_last ns a)
    ((None) "none")
    ((Some n)
      (let r (.rect n)
        (status_target st 1280 32 (add 916 (add (.x r) (div (.w r) 2))) (add 36 (add (.y r) (div (.h r) 2))))))))

; Restart and Shut Down are there only with power open.
(def test_status_power_rows () int
  (let st (shown_out)
    (add (check_str "closed" (target_of st (status_nodes st) (status_restart)) "none")
         (check_str "open" (target_of (.power st true) (status_nodes (.power st true)) (status_restart)) (status_restart)))))

; The slider at the card's left edge is 0, past its right 100.
(def test_status_slider_at () int
  (let st (shown_out)
    (add (check_true "left" (eq (status_slider_at st 1280 32 916) (Some 0)))
         (check_true "right" (eq (status_slider_at st 1280 32 1279) (Some 100))))))

(def test_status_act () int
  (add (check_true "toggle" (eq (status_act (status_button) (status_button)) (StatusToggle)))
       (add (check_true "close" (eq (status_act (status_ground) (status_ground)) (StatusClose)))
            (add (check_true "moved off" (eq (status_act (status_snip) (status_card)) (StatusNothing)))
                 (add (check_true "snip" (eq (status_act (status_snip) (status_snip)) (StatusSnip)))
                      (add (check_true "restart" (eq (status_act (status_restart) (status_restart)) (StatusRestart)))
                           (check_true "card" (eq (status_act (status_card) (status_card)) (StatusNothing)))))))))

; Found, the server is asked to watch; then for its devices; then the
; default output's volume; then shows it.
(def test_status_asks () int
  (let (a (status_found (status_new 5) 9)
        b (status_answered (.st a) "ok")
        c (status_answered (.st b) "2 in mic 1 48000 default\n1 out hdmi0 2 48000 default\n")
        d (status_answered (.st c) "volume 40"))
    (add (check_str "watch" (.ask a) "watch")
         (add (check_str "devices" (.ask b) "devices")
              (add (check_str "volume" (.ask c) "volume 1")
                   (add (check_true "shown" (eq (.vol (.st d)) (StatusOut 1 40)))
                        (check_str "nothing more" (.ask d) "")))))))

; With no output, nothing is asked and none is shown.
(def test_status_no_output () int
  (let (a (.asking (status_new 5) "devices")
        b (status_answered a "2 in mic 1 48000 default\n"))
    (add (check_true "none" (eq (.vol (.st b)) (StatusNoOut)))
         (check_str "nothing asked" (.ask b) ""))))

; The slider moved while a volume is asked: shown at once, kept, and
; sent once the answer comes, which then does not move it back.
(def test_status_set_waits () int
  (let (st (.asking (shown_out) "volume")
        a (status_set st 70)
        b (status_answered (.st a) "volume 50"))
    (add (check_str "kept" (.ask a) "")
         (add (check_true "shown" (eq (.vol (.st a)) (StatusOut 1 70)))
              (add (check_str "sent" (.ask b) "volume 1 70")
                   (check_true "still" (eq (.vol (.st b)) (StatusOut 1 70))))))))

; Nothing out, a move is sent at once.
(def test_status_set_now () int
  (check_str "sent" (.ask (status_set (shown_out) 30)) "volume 1 30"))

; An error leaves the server unasked, the volume as it was.
(def test_status_error () int
  (let a (status_answered (.asking (shown_out) "volume") "error: no such device")
    (add (check_str "unasked" (.asking (.st a)) "")
         (check_true "as it was" (eq (.vol (.st a)) (StatusOut 1 50))))))
