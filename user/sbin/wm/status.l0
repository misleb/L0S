; status.l0 -- the status menu of the top bar, as GNOME Shell's: the
; button at the bar's right end, a speaker at the default output's
; volume and the power icon, and the card of quick settings it drops: a
; row of round buttons, screenshot, settings and power, power opening
; Restart and Shut Down in the card, and the volume slider of the
; default output, as the audio server says it is.
;
; Like the launcher, its state is pure and wm acts on it: whether the
; card is shown, what the last press was on, what the pointer is over,
; whether the slider is held, the volume, and what wm last asked the
; audio server, on a port of its own, which wm sends.

; The volume as known: the default output's id and percent, or no output,
; as before the audio server has said, or if it has none.
(data StatusVol (StatusOut (id int) (pct int)) (StatusNoOut))

; The card's canvas, none if its buffer could not be made; whether it is
; shown, and power open in it; what the last press was on and what the
; pointer is over, targets as below; whether the slider is held; the
; volume; the audio server's port, 0 until found, and the port its
; answers come to; what was asked of it and is not yet answered, "" for
; nothing; the volume to set once that is, -1 for none; and the
; screenshot's area being chosen, which its button starts (snip.l0).
(data Status (Status (c (Option Canvas)) (shown bool) (power bool) (pressed (list int)) (hover (list int)) (held bool)
               (vol StatusVol) (audio int) (reply int) (asking (list int)) (wanted int) (snip Snip)))

; The menu at first: no card yet, nothing shown or known, audio's
; answers to reply.
(def status_new ((reply int)) Status
  (Status ((None Canvas)) false false "" "" false (StatusNoOut) 0 reply "" -1 (NoSnip)))

; What a press or a release is on, besides the card's own actions: the
; status button, the rest of the bar, the page outside the card, and the
; card where it has no action; "" for nothing.
(def status_button () (list int) "status.button")
(def status_bar () (list int) "status.bar")
(def status_ground () (list int) "status.ground")
(def status_card () (list int) "status.card")

; The card's actions: its buttons, Restart and Shut Down, and the
; volume slider's name.
(def status_snip () (list int) "status.snip")
(def status_settings () (list int) "status.settings")
(def status_power () (list int) "status.power")
(def status_restart () (list int) "status.select.restart")
(def status_shutdown () (list int) "status.select.shutdown")
(def status_volume () (list int) "status.volume")

; Whether the menu takes the pointer: while the card is shown, and from a
; press on its button until the release.
(def status_busy ((st Status)) bool
  (or (.shown st) (not (is_empty (.pressed st)))))

; ------------------------------------------------------------------ layout

; The card: 360 wide, 4 in from the screen's right edge and 4 under the
; bar, as GNOME's quick settings float.
(def status_w () int 360)
(def status_gap () int 4)

; The card as widgets, power open or not, at volume vol: 12 round it and
; between its rows; the buttons at the top row's end, then Restart and
; Shut Down while power is open, then the volume's row.
(def status_view ((power bool) (vol StatusVol)) UiWidget
  (UiPad (ui_space_m) (ui_space_m)
    (UiBox (UiV) (ui_space_m)
      (cons (status_buttons)
        (if power
            (cons (status_power_list) (cons (status_volume_row vol) (nil UiWidget)))
            (cons (status_volume_row vol) (nil UiWidget)))))))

; The top row: screenshot, settings and power, round, at its end.
(def status_buttons () UiWidget
  (UiBox (UiH) (ui_space_m)
    (cons (UiExpand (UiSpace 0 0))
      (cons (UiButton (status_snip) "applets-screenshooter" "" (UiBtnCircular) true)
        (cons (UiButton (status_settings) "emblem-system" "" (UiBtnCircular) true)
          (cons (UiButton (status_power) "system-shutdown" "" (UiBtnCircular) true) (nil UiWidget)))))))

; Restart and Shut Down, a boxed list, as power opens them.
(def status_power_list () UiWidget
  (UiList (UiListData "status" (cons (ui_list_row "restart" "Restart" "") (cons (ui_list_row "shutdown" "Shut Down" "") (nil UiListRow))) 0)))

; The volume's row: its icon, and the slider from 0 to 100; or, with no
; output, the muted icon and a line that says so.
(def status_volume_row ((vol StatusVol)) UiWidget
  (match vol
    ((StatusOut id pct)
      (UiBox (UiH) (ui_space_s)
        (cons (UiButton "" (status_vol_icon pct) "" (UiBtnFlat) true)
          (cons (UiScale (status_volume) pct 0 100 (status_slider_w)) (nil UiWidget)))))
    ((StatusNoOut)
      (UiBox (UiH) (ui_space_s)
        (cons (UiButton "" (status_vol_icon 0) "" (UiBtnFlat) true)
          (cons (UiExpand (UiLabel "No sound output" (UiDimmed) (UiStart))) (nil UiWidget)))))))

; The slider's width: the rest of its row, past the icon's button and
; the space after it, in the card less 12 each side.
(def status_slider_w () int
  (sub (sub (status_w) (mul 2 (ui_space_m))) (add (ui_button_h) (ui_space_s))))

; The speaker at pct: muted at 0, low to 33, medium to 66, else high.
(def status_vol_icon ((pct int)) (list int)
  (if (le pct 0) "audio-volume-muted"
      (le pct 33) "audio-volume-low"
      (le pct 66) "audio-volume-medium"
      "audio-volume-high"))

; The card's height, power open or not, as its widgets ask.
(def status_h ((power bool) (vol StatusVol)) int
  (.sh (ui_measure (status_view power vol))))

; Where the card is on a screen w wide under a bar bar_h high.
(def status_rect ((w int) (bar_h int) (power bool) (vol StatusVol)) Rect
  (Rect (sub (sub w (status_gap)) (status_w)) (add bar_h (status_gap)) (status_w) (status_h power vol)))

; The card laid out in its own pixels, with st's hover and press.
(def status_nodes ((st Status)) (list UiNode)
  (let s (ui_style)
    (ui_layout (status_view (.power st) (.vol st)) (Rect 0 0 (status_w) (status_h (.power st) (.vol st)))
               (.pressed (.hover (ui_state_new s) (.hover st)) (.pressed st)) (ui_window_bg s))))

; ----------------------------------------------------------------- the bar

; The button's width: 10 either side of its icons, the speaker's only
; while an output's volume is known, 8 between them.
(def status_button_w ((vol StatusVol)) int
  (match vol ((StatusOut id pct) 60) ((StatusNoOut) 36)))

; Where the button starts, at the end of a bar w wide.
(def status_button_x ((w int) (vol StatusVol)) int (sub w (status_button_w vol)))

; The button's ops on a bar w wide, bar_h high, on a pill while the card
; is shown: the speaker, then the power icon, 8 down.
(def status_button_ops ((w int) (bar_h int) (shown bool) (vol StatusVol) (fg int) (pill int) (bg int)) (list UiPaint)
  (let (x (status_button_x w vol)
        bw (status_button_w vol)
        y (div (sub bar_h (ui_icon_size)) 2)
        power (UiPIcon (sub (add x bw) 26) y "system-shutdown" fg 1)
        icons (match vol
                ((StatusOut id pct) (cons (UiPIcon (add x 10) y (status_vol_icon pct) fg 1) (cons power (nil UiPaint))))
                ((StatusNoOut) (cons power (nil UiPaint)))))
    (if shown
        (cons (UiPRound (Rect (add x 4) 4 (sub bw 8) (sub bar_h 8)) (div (sub bar_h 8) 2) pill bg) icons)
        icons)))

; ----------------------------------------------------------------- targets

; What x, y on a screen w wide is on, the bar bar_h high: the button, the
; rest of the bar, the card's action there or the card, or the page.
(def status_target ((st Status) (w int) (bar_h int) (x int) (y int)) (list int)
  (let r (status_rect w bar_h (.power st) (.vol st))
    (if (lt y bar_h)
        (if (ge x (status_button_x w (.vol st))) (status_button) (status_bar))
        (and (.shown st) (rect_has r x y))
        (let a (ui_hit (status_nodes st) (sub x (.x r)) (sub y (.y r)))
          (if (is_empty a) (status_card) a))
        (status_ground))))

; Whether target a is the volume slider.
(def status_on_slider ((a (list int))) bool
  (eq a (ui_scale_node_action (status_volume) 0 100)))

; The volume the slider gives at screen column x, on a screen w wide
; under a bar bar_h high; none if it is not laid out.
(def status_slider_at ((st Status) (w int) (bar_h int) (x int)) (Option int)
  (let r (status_rect w bar_h (.power st) (.vol st))
    (match (ui_node_with_last (status_nodes st) (ui_scale_node_action (status_volume) 0 100))
      ((None) ((None int)))
      ((Some n) (Some (ui_scale_value (status_volume) -1 0 100 (ui_scale_set_at n (sub x (.x r)))))))))

; ------------------------------------------------------------------ clicks

; What a click does, pressed on one target and released on another: the
; card opened or closed by the button; closed by the page or the rest of
; the bar; a button or a row of the card done; nothing if the pointer
; went from one to another, or for the card's ground.
(data StatusAct (StatusToggle) (StatusClose) (StatusSnip) (StatusSettings) (StatusPower) (StatusRestart) (StatusShutDown) (StatusNothing))

; The StatusAct a press on one target and a release on another make.
(def status_act ((press (list int)) (release (list int))) StatusAct
  (if (not (eq press release)) (StatusNothing)
      (eq press (status_button)) (StatusToggle)
      (or (eq press (status_ground)) (eq press (status_bar))) (StatusClose)
      (eq press (status_snip)) (StatusSnip)
      (eq press (status_settings)) (StatusSettings)
      (eq press (status_power)) (StatusPower)
      (eq press (status_restart)) (StatusRestart)
      (eq press (status_shutdown)) (StatusShutDown)
      (StatusNothing)))

; ---------------------------------------------------------------- painting

; The card painted on c, for st: a bordered rounded card on black, its
; widgets over it.
(def status_paint ((c Canvas) (face UiFace) (st Status)) Canvas
  (let (s (ui_style)
        bg (ui_window_bg s)
        w (status_w)
        h (status_h (.power st) (.vol st))
        r (Rect 0 0 w h)
        p (ui_paint c face r
            (cons (UiPFill r (ui_black))
              (cons (UiPRound r (ui_window_radius) (ui_border s bg) (ui_black))
                (cons (UiPRound (Rect 1 1 (sub w 2) (sub h 2)) (sub (ui_window_radius) 1) bg (ui_border s bg)) (nil UiPaint))))))
    (ui_paint_nodes p face r (status_nodes st))))

; ------------------------------------------------------------------- audio

; What st becomes and what to ask the audio server next, "" for nothing.
(data StatusNext (StatusNext (st Status) (ask (list int))))

; The audio server found at port: told to watch for devices, then asked
; for them.
(def status_found ((st Status) (port int)) StatusNext
  (StatusNext (.asking (.audio st port) "watch") "watch"))

; What the server answered, text, to what st asked: once it watches, its
; devices asked; the default output's volume asked once they are known,
; or no output; the volume shown once said, or the one wanted since sent;
; anything else, an error, leaves the server unasked.
(def status_answered ((st Status) (text (list int))) StatusNext
  (let (asked (.asking st)
        st2 (.asking st ""))
    (if (eq asked "watch") (StatusNext (.asking st2 "devices") "devices")
        (eq asked "devices")
        (match (audio_default_of (audio_devices_of text) false)
          ((None) (StatusNext (.vol st2 (StatusNoOut)) ""))
          ((Some d) (StatusNext (.asking (.vol st2 (StatusOut (.id d) (status_pct (.vol st) 100))) "volume")
                                (status_volume_ask (.id d) -1))))
        (eq asked "volume")
        (let said (status_said text)
          (if (ge (.wanted st2) 0) (status_set (.wanted st2 -1) (.wanted st2))
              (lt said 0) (StatusNext st2 "")
              (StatusNext (.vol st2 (status_with_pct (.vol st2) said)) "")))
        (StatusNext st2 ""))))

; The percent volume N says, or -1.
(def status_said ((text (list int))) int
  (let ws (split_spaces text)
    (if (and (eq (length ws) 2) (and (eq (head ws) "volume") (is_number (nth ws 1)))) (int_prefix (nth ws 1) 0) -1)))

; vol's percent, or else.
(def status_pct ((vol StatusVol) (else int)) int
  (match vol ((StatusOut id pct) pct) ((StatusNoOut) else)))

; vol at pct, if it is an output's.
(def status_with_pct ((vol StatusVol) (pct int)) StatusVol
  (match vol ((StatusOut id was) (StatusOut id pct)) ((StatusNoOut) vol)))

; volume ID, or volume ID PCT to set it.
(def status_volume_ask ((id int) (pct int)) (list int)
  (unwords (cons "volume" (cons (digits id) (if (lt pct 0) (nil (list int)) (cons (digits pct) (nil (list int))))))))

; The slider moved to pct: shown at once, and sent, or kept to send once
; what is asked is answered.
(def status_set ((st Status) (pct int)) StatusNext
  (match (.vol st)
    ((StatusNoOut) (StatusNext st ""))
    ((StatusOut id was)
      (let st2 (.vol st (StatusOut id pct))
        (if (is_empty (.asking st2))
            (StatusNext (.asking st2 "volume") (status_volume_ask id pct))
            (StatusNext (.wanted st2 pct) ""))))))

; The card opened: the volume asked again, since no notice says another
; client changed it, if nothing else is asked.
(def status_opened ((st Status)) StatusNext
  (match (.vol st)
    ((StatusNoOut) (StatusNext st ""))
    ((StatusOut id pct)
      (if (is_empty (.asking st))
          (StatusNext (.asking st "volume") (status_volume_ask id -1))
          (StatusNext st "")))))

; A device came or went: the devices asked again, if nothing else is.
(def status_devices_changed ((st Status)) StatusNext
  (if (is_empty (.asking st))
      (StatusNext (.asking st "devices") "devices")
      (StatusNext st "")))

; The server gone, or never there: nothing known or asked.
(def status_unheard ((st Status)) Status
  (.wanted (.asking (.audio (.vol st (StatusNoOut)) 0) "") -1))
