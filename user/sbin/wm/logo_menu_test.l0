; logo_menu_test.l0 -- the logo menu's targets, clicks and card.

(def act_name ((a MenuAct)) (list int)
  (match a
    ((MenuDo i) (append "do " (digits i)))
    ((MenuToggle) "toggle")
    ((MenuClose) "close")
    ((MenuNothing) "nothing")))

; The bar is 32 high: the logo is its first 32 columns; the card is at
; (4, 32), 200 by 84, its rows 6 in: About 6 to 36, Shut Down 48 to 78.
(def test_menu_targets () int
  (add (check_int "the logo" (menu_target 32 10 10) (menu_logo))
       (add (check_int "the rest of the bar" (menu_target 32 300 10) (menu_bar))
            (add (check_int "About" (menu_target 32 100 40) (menu_about))
                 (add (check_int "the separator, on the card" (menu_target 32 100 76) (menu_card))
                      (add (check_int "Shut Down" (menu_target 32 100 90) (menu_shutdown))
                           (check_int "beside the card" (menu_target 32 300 90) (menu_ground))))))))

(def test_menu_act () int
  (add (check_str "a row" (act_name (menu_act 1 1)) "do 1")
       (add (check_str "the logo again" (act_name (menu_act (menu_logo) (menu_logo))) "toggle")
            (add (check_str "outside" (act_name (menu_act (menu_ground) (menu_ground))) "close")
                 (add (check_str "the bar" (act_name (menu_act (menu_bar) (menu_bar))) "close")
                      (check_str "slid off a row" (act_name (menu_act 0 1)) "nothing"))))))

; The card shown, as a state.
(def test_menu_state () int
  (let m (Menu (canvas_new 1 1 0) false (menu_none))
    (add (check_bool "hidden" (menu_shown m) false)
         (add (check_bool "opened" (menu_shown (menu_with m true (menu_logo))) true)
              (check_int "pressed" (menu_pressed (menu_with m true (menu_logo))) (menu_logo))))))

(def test_no_menu () int
  (add (check_bool "never shown" (menu_shown (menu_with (NoMenu) true 0)) false)
       (check_int "never pressed" (menu_pressed (menu_with (NoMenu) true 0)) (menu_none))))

; The logo's mark is 22 square and the card's ops are a ground, two
; rounds, the separator and two labels.
(def test_menu_ops () int
  (add (check_int "the mark" (length (menu_mark_ops 5 5)) 5)
       (add (check_int "the card" (length (menu_ops)) 6)
            (check_int "lit, a pill more" (length (menu_button_ops true 32)) 6))))
