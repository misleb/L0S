; The one descriptor of a request: the buffer, 2048 into the page, which
; the device writes, chained to nothing. Flags and next are the word at 12.
(def test_descriptor () int
  (let b (bytes_from_list (rng_descriptor 40960 64))
    (add (check_int "16 bytes" (bytes_len b) 16)
         (add (check_int "the buffer" (le_u32 b 0) 43008)
              (add (check_int "its length" (le_u32 b 8) 64)
                   (check_int "written, no next" (le_u32 b 12) 2))))))

; A request asks for what is wanted, up to the buffer's 2048.
(def test_ask_size () int
  (add (check_int "a few" (rng_ask_size 16) 16)
       (check_int "the buffer" (rng_ask_size 5000) 2048)))

; The buffer lies after the rings, within the page.
(def test_layout () int
  (add (check_true "after the used ring" (gt (buffer_off) (add (used_off) (add 6 (mul 8 (ring_size))))))
       (check_int "the page's end" (add (buffer_off) (buffer_size)) 4096)))

; Under an operating system there are no transports to drive.
(def test_no_device () int
  (check_int "fails" (virtio_rng) 1))

(def test_source_line () int
  (check_str "source" (source_line 29) "virtio-mmio 29 at 0x0a003a00, irq 77, serving random"))
