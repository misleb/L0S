; rng200_test.l0 -- tests of rng200.l0's pure parts: CTRL, INT_STATUS
; and FIFO_COUNT read as Linux's iproc-rng200.c reads them, words made
; bytes least significant first, and what the driver says; and that
; with no generator it does not fail.

; CTRL is on when any RBGEN bit is; Linux's value has them all and the
; divider 3 above.
(def test_is_on () int
  (add (check_bool "off" (rng200_is_on 0) false)
       (add (check_bool "divider alone" (rng200_is_on 24576) false)
            (check_bool "Linux's on" (rng200_is_on (rng200_ctrl_on)) true))))

; enable_set clears RBGEN and sets bit 0, keeping the divider (24576 is
; 3 << 13).
(def test_ctrl_bits () int
  (add (check_int "off" (rng200_ctrl_off (rng200_ctrl_on)) 24576)
       (check_int "enabled" (rng200_ctrl_enabled (rng200_ctrl_on)) 24577)))

; A health test failed is bit 31 or bit 5 of INT_STATUS; the warm-up's
; bit 17 and the count's bit 0 are not failures.
(def test_failed () int
  (add (check_bool "lockout" (rng200_has_failed 2147483648) true)
       (add (check_bool "nist" (rng200_has_failed 32) true)
            (check_bool "startup, count" (rng200_has_failed 131073) false))))

; FIFO_COUNT's words are its low byte, the threshold above it.
(def test_words () int
  (check_int "words" (rng200_words (add (rng200_fifo_threshold) 7)) 7))

; A word's bytes, least significant first, pushed onto a reversed list:
; 0x04030201 then 0x08070605 read 1 to 8.
(def test_word_bytes () int
  (check_strs "bytes"
              (cons (digits_list (rev (rng200_word_bytes 134678021 (rng200_word_bytes 67305985 (nil int))))) (nil (list int)))
              (cons "1 2 3 4 5 6 7 8" (nil (list int)))))

; The bytes as words.
(def digits_list ((bs (list int))) (list int)
  (unwords (digits_each bs (nil (list int)))))
(def digits_each ((bs (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty bs) (rev acc) (digits_each (tail bs) (cons (digits (head bs)) acc))))

(def test_line () int
  (check_str "line" (rng200_line) "an RNG200 at 0x107d208000, serving random"))

; Under an operating system there is no RNG200: said, and no failure.
(def test_no_device () int
  (check_int "no device" (rng200) 0))
