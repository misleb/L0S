; hdmi-audio_test.l0 -- tests of hdmi-audio.l0.

; Under an operating system there is no dma40 channel: no sound, and no
; failure.
(def test_no_channel () int
  (check_int "status" (hdmi_audio_main (nil (list int))) 0))

; GET_CLOCK_RATE of clock 13, M2MC, in a buffer of 8 words.
(def test_m2mc_request () int
  (add (check_int "words" (length (m2mc_request)) 8)
       (check_str "tag" (hex_digits (nth (m2mc_request) 2) 8) "00030002")))

; 12 periods of 512 frames: 128 ms at 48 kHz.
(def test_ring_size () int
  (check_int "ms" (div (mul 1000 (mul (ring_periods_n) (period_frames))) 48000) 128))

; A period is a page of two subframes a frame.
(def test_period_is_page () int
  (check_int "bytes" (mul (period_frames) (frame_bytes)) (page_size)))
