; dma40_test.l0 -- tests of dma40.l0.

(def hexes ((ws (list int)) (acc (list (list int)))) (list int)
  (if (is_empty ws) (unwords (rev acc)) (hexes (tail ws) (cons (hex_digits (head ws) 8) acc))))

; A period of 8192 bytes at 0x12_3456_0000, then the block at 0x20000.
(def test_cb_words () int
  (check_str "block" (hexes (cb_words 78187462656 8192 131072 10) (nil (list int)))
    "00009405 34560000 00005312 7c72001c 00000310 00002000 00001000 00000000"))

; Two periods, in pages apart: each block points at the other.
(def test_ring_cbs () int
  (check_str "ring" (hexes (ring_cb_words 4096 (array_set (array_new 2 65536) 1 90112) 4096 12) (nil (list int)))
    "00009805 00010000 00005300 7c72001c 00000310 00001000 00000081 00000000 00009805 00016000 00005300 7c72001c 00000310 00001000 00000080 00000000"))

; TI as Linux's to_bcm2711_ti makes it: 0x9405 for the C0's DREQ 10,
; 0x9805 for the D0's 12.
(def test_cb_ti () int
  (add (check_str "C0" (hex_digits (cb_ti (hdmi0_dreq false)) 8) "00009405")
       (check_str "D0" (hex_digits (cb_ti (hdmi0_dreq true)) 8) "00009805")))

(def test_period_of_cb () int
  (add (check_int "second" (period_of_cb 129 4096 2) 1)
       (add (check_int "idle" (period_of_cb 0 4096 2) -1)
            (check_int "past" (period_of_cb 130 4096 2) -1))))

(def test_cs () int
  (add (check_str "start" (hex_digits (cs_start) 8) "00fa0301")
       (check_bool "transactions" (cs_transactions 33554433) true)))
