; iec958.l0 -- 16-bit samples as the IEC958 subframes HDMI0's audio
; FIFO, the MAI, takes: one 32-bit word a sample, as alsa-lib's iec958
; plugin builds them for Linux's vc4 (pcm_iec958.c's iec958_subframe,
; with vc4-hdmi.conf's preambles and status). Pure.
;
;   bits 0-3    the preamble: Z, 0x08, on the first frame of a block of
;               192 on channel 0; X, 0x02, on its other frames; Y, 0x04,
;               on channel 1
;   bits 8-27   the sample, a 16-bit one in 12 to 27
;   bit 30      the frame's bit of the channel status, the same on both
;               channels
;   bit 31      even parity over bits 4 to 30

; Frames in a block, which the channel status spans a bit a frame.
(def iec_block () int 192)

; The channel status's first five bytes, as vc4-hdmi.conf and the
; plugin give them for 16-bit PCM at rate: AES0 0x04, consumer, no copy
; restriction; AES1 0x82, the original's category; AES2 0; AES3 the
; rate, 0 for 44.1 kHz, 2 for 48 and 3 for 32; AES4 0x02, 16-bit
; words. Every later byte is 0.
(def iec_status_byte ((rate int) (i int)) int
  (if (eq i 0) 4
  (if (eq i 1) 130
  (if (eq i 3) (iec_rate_code rate)
  (if (eq i 4) 2
  0)))))

; AES3's sampling frequency for rate: 1, not indicated, for any other.
(def iec_rate_code ((rate int)) int
  (if (eq rate 44100) 0 (if (eq rate 48000) 2 (if (eq rate 32000) 3 1))))

; The status bit of frame k of a block: byte k/8's bit k%8.
(def iec_status_bit ((rate int) (k int)) int
  (bit_and (bit_shr (iec_status_byte rate (div k 8)) (mod k 8)) 1))

; The subframe of sample s, 0 to 65535 as its two bytes read it, on
; channel ch, 0 or 1, of frame k of a block, at rate.
(def iec_subframe ((s int) (ch int) (k int) (rate int)) int
  (let w (bit_or (bit_shl (bit_and s 65535) 12) (bit_shl (iec_status_bit rate k) 30))
    (bit_or (bit_or w (bit_shl (bit_and (bit_count w) 1) 31))   ; bits 0-3 are clear, so this is 4 to 30's parity
      (iec_preamble ch k))))

; The preamble of channel ch on frame k of a block.
(def iec_preamble ((ch int) (k int)) int
  (if (eq ch 1) 4 (if (eq k 0) 8 2)))

; The subframe of silence on channel ch of frame k.
(def iec_silence ((ch int) (k int) (rate int)) int (iec_subframe 0 ch k rate))
