; mai_test.l0 -- tests of mai.l0, against the words Linux's vc4 writes.

(def smp_text ((o (Option int))) (list int)
  (match o ((None) "none") ((Some v) (hex_digits v 8))))

; 108 MHz / 48 kHz is 2250 exactly: N 2250, M 0.
(def test_smp_48k () int
  (check_str "MAI_SMP" (smp_text (mai_smp_for 48000)) "0008ca00"))

; 108 MHz / 44.1 kHz is 120000/49: N 120000, M 48.
(def test_smp_44k1 () int
  (check_str "MAI_SMP" (smp_text (mai_smp_for 44100)) "01d4c030"))

; 108 MHz / 32 kHz is 3375.
(def test_smp_32k () int
  (check_str "MAI_SMP" (smp_text (mai_smp_for 32000)) "000d2f00"))

(def test_fmt_48k () int
  (check_str "MAI_FMT" (hex_digits (mai_fmt_for 48000) 8) "00020900"))

; N 6144 and EXTERNAL_CTS_EN, as vc4 writes for 48 kHz.
(def test_crp_48k () int
  (check_str "CRP_CFG" (hex_digits (crp_cfg_for 48000) 8) "01001800"))

; At 48 kHz CTS is the pixel clock in kHz: 148500 at 148.5 MHz.
(def test_cts_48k () int
  (check_int "CTS" (acr_cts 148500000 48000) 148500))

; 594 MHz, as hvs's phy_rate sets the PHY: RM_OFFSET 0x9B800000, the
; divider 2 with bit 10.
(def test_tmds_594 () int
  (check_int "Hz" (tmds_hz 2608857088 1026) 594000000))

(def test_tmds_no_divider () int
  (check_int "Hz" (tmds_hz 2608857088 1024) 0))

(def test_thr () int
  (add (check_str "D0" (hex_digits (mai_thr_for true) 8) "08080e1c")
       (check_str "C0" (hex_digits (mai_thr_for false) 8) "10101c1c")))

; The board's SCALER6_VERSION, 0x00002454, is a D0.
(def test_version_d0 () int
  (add (check_bool "D0" (version_is_d0 9300) true)
       (check_bool "C0" (version_is_d0 9299) false)))

; Header 0x84, 1, 10; checksum 0x100 - (0x84 + 1 + 10 + 1) = 0x70.
(def test_infoframe () int
  (add (check_str "header" (hex_digits (head (audio_infoframe)) 8) "000a0184")
       (add (check_str "PB" (hex_digits (nth (audio_infoframe) 1) 8) "00000170")
            (check_int "words" (length (audio_infoframe)) 9))))

(def test_slot () int
  (check_int "slot 4" (slot_at (audio_slot)) 14480))       ; 0x3890

(def test_core_offsets () int
  (add (check_int "CRP_CFG" (crp_cfg) 5328)                  ; 0x14D0
       (check_int "SCHEDULER_CONTROL" (scheduler_control) 5352)))

(def test_mai_ctl_text () int
  (check_str "text" (mai_ctl_text 32780) "MAI_CTL 0x0000800c, ran dry, underflowed"))
