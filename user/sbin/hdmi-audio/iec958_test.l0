; iec958_test.l0 -- tests of iec958.l0.

; Silence's left subframe on a block's first frame at 48 kHz: preamble Z,
; 0x08, and frame 0's status bit, AES0's bit 0, 0; no bits, so parity 0.
(def test_iec_block_start () int
  (check_str "word" (hex_digits (iec_silence 0 0 48000) 8) "00000008"))

; Frame 2's status bit is AES0's bit 2, 1 (AES0 0x04): bit 30, and so
; parity bit 31 too.
(def test_iec_status_bit () int
  (check_str "word" (hex_digits (iec_silence 0 2 48000) 8) "c0000002"))

; The right channel's preamble is Y, 0x04, on every frame.
(def test_iec_right () int
  (check_str "word" (hex_digits (iec_silence 1 0 48000) 8) "00000004"))

; 0x8001 in bits 12 to 27 is two bits set: parity 0.
(def test_iec_sample () int
  (check_str "word" (hex_digits (iec_subframe 32769 0 1 48000) 8) "08001002"))

; 0x0001 is one bit: parity 1. A negative sample stays in 12 to 27.
(def test_iec_parity () int
  (add (check_str "one" (hex_digits (iec_subframe 1 1 1 48000) 8) "80001004")
       (check_str "-1" (hex_digits (iec_subframe 65535 0 1 48000) 8) "0ffff002")))

; AES3's rate: frame 25 is its bit 1, set at 48 kHz (2), not at 44.1 (0).
(def test_iec_rate_bit () int
  (add (check_int "48 kHz" (iec_status_bit 48000 25) 1)
       (check_int "44.1 kHz" (iec_status_bit 44100 25) 0)))

; The status bits of a block, as a count: AES0 0x04 one, AES1 0x82 two,
; AES3 2 at 48 kHz one, AES4 0x02 one.
(def test_iec_status_count () int
  (check_int "bits" (status_bits 48000 0 0) 5))

(def status_bits ((rate int) (k int) (n int)) int
  (if (ge k (iec_block)) n (status_bits rate (add k 1) (add n (iec_status_bit rate k)))))

; Every word over a block has even parity over bits 4 to 31.
(def test_iec_parity_property () int
  (check_int "odd words" (odd_words 0 1 0) 0))

(def odd_words ((k int) (seed int) (n int)) int
  (if (ge k (iec_block))
      n
      (let (s (rand_next seed)
            w (iec_subframe (bit_and s 65535) (mod k 2) k 44100))
        (odd_words (add k 1) s (add n (bit_and (bit_count (bit_shr w 4)) 1))))))
