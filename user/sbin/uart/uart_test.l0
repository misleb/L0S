; The line editing uart does is user/lib/tty.l0's, tested there.

; Under an operating system there is no serial port to drive.
(def test_no_device () int
  (check_int "fails" (uart) 1))

(def test_uart_line () int
  (add (check_str "echo" (uart_line (virt_uart) true) "a PL011 at 0x09000000, irq 33, serving console")
       (check_str "noecho" (uart_line (virt_uart) false) "a PL011 at 0x09000000, irq 33, serving console, without echo")))

(def test_uart_line_pi5 () int
  (check_str "the Pi 5's debug UART" (uart_line (pi5_uart) true) "a PL011 at 0x107d001000, irq 153, serving console"))

(def test_uart_places () int
  (add (check_int "QEMU's first" (.base (head (uart_places))) 150994944)
       (check_int "then the Pi 5's" (.irq (head (tail (uart_places)))) 153)))

; QEMU's is known by its ID registers; the Pi 5's read 0.
(def test_uart_ids () int
  (add (check_bool "QEMU's" (.ids (virt_uart)) true)
       (check_bool "the Pi 5's" (.ids (pi5_uart)) false)))

; Under an operating system no place is a region.
(def test_uart_found_none () int
  (match (uart_found (uart_places))
    ((NoUart why) (pass "none"))
    ((UartAt p d) (fail_because "none" "found one"))))

(def test_not_pl011 () int
  (check_str "a part" (not_pl011 "0x107d001000" 17) "0x107d001000: its ID says part 0x011, not a PL011"))
