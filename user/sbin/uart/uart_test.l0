; The line editing uart does is user/lib/tty.l0's, tested there.

; Under an operating system there is no serial port to drive.
(def test_no_device () int
  (check_int "fails" (uart) 1))

(def test_uart_line () int
  (add (check_str "echo" (uart_line true) "a PL011 at 0x09000000, irq 33, serving console")
       (check_str "noecho" (uart_line false) "a PL011 at 0x09000000, irq 33, serving console, without echo")))
