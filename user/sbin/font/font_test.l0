; font_test.l0 -- tests of font.l0: its requests answered, as far as
; they go with no kernel, the faces read from fonts/ through the same
; names, and the stats it gives.

; Under an operating system there are no ports.
(def test_no_port () int
  (check_int "fails" (font) 1))

; A service with no faces and no strikes.
(def empty () Font (Font ((MapEmpty (list int) Ttf)) ((MapEmpty (list int) Cached)) 0))

; A service with strikes kept, made by hand.
(def with_two () Font
  (with_cached (with_cached (empty) "code 16" (Cached 4096 3 9224 (cons (Holder 5 8192) (cons (Holder 6 8192) (nil Holder)))))
               "code 32" (Cached 16384 4 15328 (nil Holder))))

(def answer ((s (Served Font))) (list int) (match s ((Served f r) r)))

(def test_faces_none () int
  (check_str "none read" (answer (requested (empty) 5 (split_spaces "faces"))) "faces"))

(def test_faces_some () int
  (let s (Font (map_put ((MapEmpty (list int) Ttf)) "sans" (Ttf (bytes_from_list "") 1000 false 0 0 0 0 0 0))
               ((MapEmpty (list int) Cached)) 0)
    (check_str "sans" (answer (requested s 5 (split_spaces "faces"))) "faces sans")))

(def test_strike_refused () int
  (add (check_str "no face" (answer (requested (empty) 5 (split_spaces "strike serif 16"))) "error: no face serif")
       (check_str "not a height" (answer (requested (empty) 5 (split_spaces "strike code x"))) "error: not a height: x")))

(def test_strike_unread () int
  (check_str "not read" (answer (requested (empty) 5 (split_spaces "strike code 16"))) "error: no font for code"))

(def test_no_such_request () int
  (check_str "no request" (answer (requested (empty) 5 (split_spaces "draw"))) "error: no request draw"))

; A strike already kept, asked again by a process given it: where that
; process sees it, nothing made.
(def test_shared_again () int
  (check_str "the same pages" (answer (requested (with_two) 6 (split_spaces "strike code 16"))) "8192 3"))

(def test_stats () int
  (check_str "stats" (stats_text (with_two)) "builds 0\ncode 16 9224 2\ncode 32 15328 0"))

(def test_serving_line () int
  (check_str "line" (serving_line (split_spaces "code sans"))
    "2 faces from /etc/fonts, code sans, serving font"))

; The demo's faces, read through their names from fonts/, where the
; Makefile stages them to /etc/fonts from.
(def test_faces_read () int
  (check_int "none from /etc/fonts on this host"
    (map_size (faces_read (font_faces) ((MapEmpty (list int) Ttf)))) 0))

(def test_built_line () int
  (check_str "line" (built_line "sans" 32 15848 412345678) "sans 32: built, 15848 bytes in 412 ms"))

; With no faces, nothing is made before it registers, and nothing
; counted.
(def test_prebuild_none () int
  (check_str "stats" (stats_text (prebuild (empty) (prebuilt))) "builds 0"))
