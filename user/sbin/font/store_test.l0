; store_test.l0 -- tests of store.l0: strikes placed in arenas first
; fit, given and held, and let go once their holders exit.

; An arena of 8 pages at 4096, as a test's arenas are small.
(def one () Store (store_arena_add (store_empty) 4096 8))

; A Spot, or a test's failure as -1, -1.
(def spot_text ((p (Option Spot))) (list int)
  (match p
    ((None) "none")
    ((Some s) (match s ((Spot a first) (append (digits a) (append " " (digits first))))))))

; The first strike goes at page 0 of arena 0.
(def test_fit_first () int
  (check_str "spot" (spot_text (store_fit (one) 3)) "0 0"))

; A strike of 3 pages at 0 leaves the next of 3 at page 3.
(def test_fit_after () int
  (let s (store_put (one) "code 16" (Spot 0 0) 3 9224 false)
    (check_str "spot" (spot_text (store_fit s 3)) "0 3")))

; 8 pages: 3 used leave 5, so one of 6 fits nowhere, and one of 6 goes
; into a second arena.
(def test_fit_none () int
  (let s (store_put (one) "code 16" (Spot 0 0) 3 9224 false)
    (add (check_str "none" (spot_text (store_fit s 6)) "none")
         (check_str "the next arena" (spot_text (store_fit (store_arena_add s 65536 8) 6)) "1 0"))))

; Pages freed between two strikes are found first fit.
(def test_fit_freed () int
  (let s (store_put (store_put (one) "a 8" (Spot 0 0) 2 10 false) "b 8" (Spot 0 2) 2 10 true)
    (match (store_sweep s)
      ((Swept s2 gone) (check_str "a's pages" (spot_text (store_fit s2 2)) "0 0")))))

; A strike given to a pid twice is held once; its offset is its pages'.
(def test_hold () int
  (let s (store_hold (store_hold (store_put (one) "code 16" (Spot 0 2) 3 9224 false) "code 16" 7) "code 16" 7)
    (add (check_str "lines" (join_with "," (store_lines s)) "code 16 9224 1")
         (match (store_get s "code 16")
           ((Some k) (check_int "offset" (kept_offset k) 8192))
           ((None) (fail_because "kept" "none"))))))

; Where a pid sees an arena, once shared; whether it was given anything.
(def test_shared () int
  (let s (store_shared (one) 0 7 3758096384)
    (add (check_bool "seen" (eq (store_seen s 0 7) (Some 3758096384)) true)
         (add (check_bool "known" (store_knows s 7) true)
              (check_bool "another" (store_knows s 8) false)))))

; Two holders; one exits and the strike stays, held by the other.
(def test_exit_one () int
  (let s (store_hold (store_hold (store_put (one) "sans 24" (Spot 0 0) 3 12208 false) "sans 24" 7) "sans 24" 8)
    (match (store_sweep (store_exited s 7))
      ((Swept s2 gone) (check_str "lines" (join_with "," (store_lines s2)) "sans 24 12208 1")))))

; The last holder exits: the strike is let go, its pages free, and the
; pid is no longer known.
(def test_exit_last () int
  (let s (store_shared (store_hold (store_put (one) "sans 24" (Spot 0 0) 3 12208 false) "sans 24" 7) 0 7 3758096384)
    (match (store_sweep (store_exited s 7))
      ((Swept s2 gone)
        (add (check_int "kept" (store_size s2) 0)
             (add (check_int "used" (store_used s2) 0)
                  (check_bool "known" (store_knows s2 7) false)))))))

; A stored strike no one holds is kept.
(def test_stored_kept () int
  (match (store_sweep (store_put (one) "code 16" (Spot 0 0) 3 9224 true))
    ((Swept s2 gone) (check_str "lines" (join_with "," (store_lines s2)) "code 16 9224 0"))))

; An arena left with no strike is let go, but arena 0.
(def test_arena_gone () int
  (let s (store_put (store_arena_add (one) 65536 8) "sans 100" (Spot 1 0) 8 30000 false)
    (match (store_sweep s)
      ((Swept s2 gone)
        (add (check_int "gone" (length gone) 1)
             (add (check_int "the first kept" (store_total s2) 8)
                  (check_int "its va" (.va (head gone)) 65536)))))))

; The pages used and the arenas', counted.
(def test_counts () int
  (let s (store_put (store_put (store_arena_add (one) 65536 16) "a 8" (Spot 0 0) 2 10 true) "b 8" (Spot 1 4) 5 10 true)
    (add (check_int "used" (store_used s) 7) (check_int "total" (store_total s) 24))))
