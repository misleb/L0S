; font.l0 -- the font service: owns the fonts in /etc/fonts and serves
; the font protocol (user/lib/proto/font.l0) as font. A face at a line
; height is rasterized into a strike (format/strike.l0) the first time
; any program asks for it, in pages of its own, and kept, never freed
; while it runs; each asker after is given the same pages, shared, so a
; strike costs its pages once however many programs draw with it. The
; desktop's strikes come made, from the build; a face's font is read
; only when a strike of it must be made.

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "font" why))

; A strike kept: where it is here, its pages, its bytes, and the
; processes it has been shared with.
(data Cached (Cached int int int (list Holder)))

; A process given a strike, and where it sees it.
(data Holder (Holder int int))

; The service: the faces' fonts read so far, by name, the strikes it
; keeps by face and height, and how many it has made.
(data Font (Font (Map (list int) Ttf) (Map (list int) Cached) int))

; The key a strike is kept by: FACE H.
(def strike_key ((face (list int)) (h int)) (list int) (append face (append " " (digits h))))

; ---------------------------------------------------------------- faces

; What came of reading a face's font: the service after, and the font;
; or why it cannot be read.
(data FaceRead (FaceRead Font Ttf) (FaceUnread Font (list int)))

; Face's font, read from its file the first time, then kept in s.
(def face_read ((s Font) (face (list int))) FaceRead
  (match s
    ((Font fs cache builds)
      (match (map_get fs face)
        ((Some f) (FaceRead s f))
        ((None)
          (let path (font_file face)
            (match (read_whole path)
              ((Err why) (FaceUnread s (append path (append ": " why))))
              ((Ok b)
                (match (ttf_read b)
                  ((Err why) (FaceUnread s (append path (append ": " why))))
                  ((Ok f) (FaceRead (Font (map_put fs face f) cache builds) f)))))))))))

; What it says once it serves: its faces, and how many strikes it keeps
; already.
(def serving_line ((n int)) (list int)
  (append "faces " (append (unwords (font_faces)) (append " from /etc/fonts, " (append (digits n) " strikes stored, serving font")))))

; ---------------------------------------------------------------- serving

; The service: the desktop's strikes kept as stored, registered as font,
; then each request answered.
(def font () int
  (let port (port_new)
    (if (lt port 0)
        (complain "no port")
        (let s (stored_kept (Font ((MapEmpty (list int) Ttf)) ((MapEmpty (list int) Cached)) 0) (stored))
          (let r (name_register_or_why port "font")
            (if (not (is_empty r))
                (complain r)
                (let i (info_as "font" (serving_line (match s ((Font fs cache builds) (map_size cache)))))
                  (serve s port))))))))

; Each request on port answered, one at a time.
(def serve ((s Font) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from mb)
      (match (requested s from (split_spaces (msg_text_from mb 4)))
        ((Served s2 reply)
          (let r (msg_answer mb reply)
            (serve s2 port)))))))

; A request's words, from pid from, answered.
(def requested ((s Font) (from int) (ws (list (list int)))) (Served Font)
  (if (is_empty ws)
      (served_error s "an empty request")
      (let op (head ws)
        (if (eq op "faces")
            (Served s (unwords (cons "faces" (font_faces))))
            (if (eq op "stats")
                (Served s (stats_text s))
                (if (if (eq op "strike") (eq (length ws) 3) false)
                    (strike_asked s from (nth ws 1) (nth ws 2))
                    (served_error s (append "no request " op))))))))

; strike FACE H, asked by from: the strike, made if no one has asked for
; it, shared with from if it has not been.
(def strike_asked ((s Font) (from int) (face (list int)) (hw (list int))) (Served Font)
  (match (word_number hw)
    ((None) (served_error s (append "not a height: " hw)))
    ((Some h)
      (let why (font_refusal face h)
        (if (not (is_empty why))
            (served_error s why)
            (match (strike_had s face h)
              ((NotBuilt s2 why2) (served_error s2 why2))
              ((Built s2 c) (shared s2 (strike_key face h) c from))))))))

; What came of finding a strike: the service after, and the strike; or
; why there is none.
(data Built (Built Font Cached) (NotBuilt Font (list int)))

; Face at height h: the strike kept, or one made and counted if there is
; none, its font read first if it has not been.
(def strike_had ((s Font) (face (list int)) (h int)) Built
  (match s
    ((Font fs0 cache0 builds0)
      (match (map_get cache0 (strike_key face h))
        ((Some c) (Built s c))
        ((None)
          (match (face_read s face)
            ((FaceUnread s2 why) (NotBuilt s2 why))
            ((FaceRead s2 f)
              (match (cached face f h)
                ((Err why) (NotBuilt s2 why))
                ((Ok c)
                  (match s2
                    ((Font fs cache builds) (Built (Font fs (map_put cache (strike_key face h) c) (add builds 1)) c))))))))))))

; The strikes the desktop's text is drawn from, Source Code Pro's and
; Source Sans 3's regular and bold at 16, 32 and 64, the heights scales
; 1 and 2 paint: FACE H each. tools/mkstrike makes them at the build,
; from the same fonts with the same code, into /etc/fonts, as
; rasterizing them here would take every boot seconds on QEMU before
; any window could paint.
(def stored () (list (list int))
  (split_on 44 (append "code 16,code-bold 16,code 32,code-bold 32,code 64,code-bold 64,"
                       "sans 16,sans-bold 16,sans 32,sans-bold 32,sans 64,sans-bold 64")))

; Where a stored strike is: /etc/fonts/FACE-H.strike.
(def stored_path ((face (list int)) (h int)) (list int)
  (append (font_dir) (append face (append "-" (append (digits h) ".strike")))))

; The stored strikes keys name kept, each that is there and is the strike
; it is named for; one that is not is built on its first ask, as any
; other is.
(def stored_kept ((s Font) (keys (list (list int)))) Font
  (if (is_empty keys)
      s
      (let ws (split_spaces (head keys))
        (match (word_number (nth ws 1))
          ((None) (stored_kept s (tail keys)))
          ((Some h) (stored_kept (stored_one s (head ws) h) (tail keys)))))))

; One stored strike, face at h, kept if its file is there and holds it.
(def stored_one ((s Font) (face (list int)) (h int)) Font
  (match (read_whole (stored_path face h))
    ((Err why) (let d (debug_as "font" (append (stored_path face h) (append ": " why))) s))
    ((Ok b)
      (if (if (strike_ok b) (eq (strike_height b) h) false)
          (match (in_pages b)
            ((Err why) (let w (warn_as "font" (append (stored_path face h) (append ": " why))) s))
            ((Ok c) (with_cached s (strike_key face h) c)))
          (let w (warn_as "font" (append (stored_path face h) (append ": not a strike " (append (digits h) " tall")))) s)))))

; Face f at height h made a strike, in pages of its own, and how long
; that took said for dmesg; or why not.
(def cached ((face (list int)) (f Ttf) (h int)) (Result Cached (list int))
  (let t0 (clock_ns)
    (let b (strike_make f h)
      (let d (debug_as "font" (built_line face h (bytes_len b) (sub (clock_ns) t0)))
        (in_pages b)))))

; Strike b in pages of its own, written once, its region closed again so
; that the cache keeps none of the 64 a process may have open; or why
; not.
(def in_pages ((b bytes)) (Result Cached (list int))
  (let n (pages_for (bytes_len b))
    (match (shm_region n "a strike")
      ((NoShmRegion why) ((Err Cached (list int)) why))
      ((ShmRegion va r)
        (let w (device_write_bytes r 0 b 0 (bytes_len b))
          (let c (close_device r)
            ((Ok Cached (list int)) (Cached va n (bytes_len b) (nil Holder)))))))))

; What it says of a strike it built: FACE H, its bytes, the time taken.
(def built_line ((face (list int)) (h int) (len int) (ns int)) (list int)
  (append (strike_key face h) (append ": built, " (append (digits len) (append " bytes in " (append (digits (div ns 1000000)) " ms"))))))

; Strike c, kept as key, shared with pid read only, so that no client can
; change another's text, or where pid already sees it: the answer VA N.
(def shared ((s Font) (key (list int)) (c Cached) (pid int)) (Served Font)
  (match c
    ((Cached va n len hs)
      (match (holder_va hs pid)
        ((Some there) (Served (with_cached s key c) (font_strike_reply there n)))
        ((None)
          (match (shm_share_read va n pid)
            ((ShmShared there)
              (Served (with_cached s key (Cached va n len (cons (Holder pid there) hs))) (font_strike_reply there n)))
            ((ShmShareNoProc) (served_error (with_cached s key c) (shm_share_why (ShmShareNoProc))))
            ((ShmShareTooMany) (served_error (with_cached s key c) (shm_share_why (ShmShareTooMany))))
            ((ShmShareFailed) (served_error (with_cached s key c) (shm_share_why (ShmShareFailed))))))))))

; s with strike c kept as key, as it is after c is shared again.
(def with_cached ((s Font) (key (list int)) (c Cached)) Font
  (match s ((Font fs cache builds) (Font fs (map_put cache key c) builds))))

; Where pid sees a strike, if hs says it has been given it.
(def holder_va ((hs (list Holder)) (pid int)) (Option int)
  (if (is_empty hs)
      ((None int))
      (match (head hs) ((Holder p va) (if (eq p pid) (Some va) (holder_va (tail hs) pid))))))

; stats: builds B, then each strike kept, FACE H BYTES PIDS, in order.
(def stats_text ((s Font)) (list int)
  (match s
    ((Font fs cache builds)
      (join_with "\n" (cons (append "builds " (digits builds)) (stats_lines cache (sort (map_keys cache))))))))

; The line of each strike keys names.
(def stats_lines ((cache (Map (list int) Cached)) (keys (list (list int)))) (list (list int))
  (if (is_empty keys)
      (nil (list int))
      (match (map_get cache (head keys))
        ((None) (stats_lines cache (tail keys)))
        ((Some c)
          (match c
            ((Cached va n len hs)
              (cons (unwords (cons (head keys) (cons (digits len) (cons (digits (length hs)) (nil (list int))))))
                    (stats_lines cache (tail keys)))))))))
