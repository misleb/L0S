; gem_test.l0 -- tests of gem.l0: the firmware's answer for the board's
; address, and what the driver says.

; Under an operating system there is no RP1, which is no failure.
(def test_no_rp1 () int
  (check_int "exits 0" (gem) 0))

; Words as eight hex digits each, each followed by a space.
(def words_text ((ws (list int))) (list int)
  (if (is_empty ws) "" (append (hex_digits (head ws) 8) (append " " (words_text (tail ws))))))

; 32 bytes, a request, GET_BOARD_MAC_ADDRESS with 8 bytes of value.
(def test_mac_request () int
  (check_str "eight words" (words_text (mac_request))
    "00000020 00000000 00010003 00000008 00000000 00000000 00000000 00000000 "))

; The firmware's answer: both codes, the tag's with its length, 6, and
; d8:3a:dd:12:34:56 in the next words, the first byte lowest.
(def answer ((code int)) (list int)
  (cons 32 (cons code (cons 65539 (cons 8 (cons 2147483654 (cons 316488408 (cons 22068 (cons 0 (nil int))))))))))

(def test_mac_reply () int
  (add (check_str "the board's" (mac_text (mac_reply (answer 2147483648))) "d8:3a:dd:12:34:56")
       (add (check_int "refused" (length (mac_reply (answer 2147483649))) 0)
            (check_int "too short" (length (mac_reply (cons 32 (nil int)))) 0))))

(def test_card_line () int
  (check_str "card" (card_line (mac_reply (answer 2147483648)) 1611498658)
    "RP1's Ethernet d8:3a:dd:12:34:56, a GEM at 0x1f00100000, its PHY 0x600d84a2 at MDIO 1, serving nic"))
