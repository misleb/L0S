; phy_test.l0 -- tests of phy.l0: the PHY's ID, the words its delays
; are written with, and the link its registers say.

(def test_phy_id () int
  (add (check_bool "the Pi's" (is_bcm54213pe (phy_id 24589 33954)) true)    ; 0x600d, 0x84a2
       (add (check_bool "another revision" (is_bcm54213pe (phy_id 24589 33953)) true)
            (check_bool "another PHY" (is_bcm54213pe (phy_id 28 50192)) false))))

(def test_phy_answers () int
  (add (check_bool "nothing on the bus" (phy_answers (phy_id 65535 65535)) false)
       (add (check_bool "in reset" (phy_answers 0) false)
            (check_bool "a PHY" (phy_answers (bcm54213pe)) true))))

; WREN, RGMII_SKEW_EN and shadow 7 over what it read, 0x8107 from
; nothing; and GTXCLK_EN in shadow 3's data, 0x8e01 from 1.
(def test_delays () int
  (add (check_str "misc" (hex_digits (auxctl_misc_write 0) 4) "8107")
       (add (check_str "misc kept" (hex_digits (auxctl_misc_write 240) 4) "81f7")
            (check_str "clock" (hex_digits (shadow_clk_write 1) 4) "8e01"))))

; Linked and negotiated: BMSR's link and autonegotiation bits.
(def up () int 36)

(def test_link_gigabit () int
  (add (check_str "full" (link_text (link_of (up) (adv_all) 0 768 2048)) "link up at 1000 Mb/s, full duplex")
       (check_str "half" (link_text (link_of (up) (adv_all) 0 768 1024)) "link up at 1000 Mb/s, half duplex")))

; No 1000BASE-T from the partner: what both advertise, fastest first.
(def test_link_slow () int
  (add (check_str "100, half" (link_text (link_of (up) (adv_all) 161 768 0)) "link up at 100 Mb/s, half duplex")
       (add (check_str "10, full" (link_text (link_of (up) (adv_all) 65 768 0)) "link up at 10 Mb/s, full duplex")
            (check_str "100, full" (link_text (link_of (up) (adv_all) 481 768 0)) "link up at 100 Mb/s, full duplex"))))

(def test_link_down () int
  (add (check_str "no link" (link_text (link_of 32 (adv_all) 481 768 2048)) "link down")
       (check_str "still negotiating" (link_text (link_of 4 (adv_all) 481 768 2048)) "link down")))

; Ours not advertised, theirs is: not gigabit.
(def test_link_ours_only () int
  (check_str "100" (link_text (link_of (up) (adv_all) 481 0 2048)) "link up at 100 Mb/s, full duplex"))
