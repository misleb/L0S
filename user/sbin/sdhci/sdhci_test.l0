; sdhci_test.l0 -- the driver's answers that need no card.

; A card of 256 MB, standard capacity, at address 0x4567.
(def card () Card (Card 17767 false 524288))

(def test_info () int
  (check_str "sectors of 512" (info_of (card)) "disk 524288 512"))

(def test_refusals () int
  (add (check_str "none" (move_refusal (card) 0 0) "1 to 128 sectors at a time")
       (add (check_str "too many" (move_refusal (card) 0 129) "1 to 128 sectors at a time")
            (add (check_str "past the end" (move_refusal (card) 524287 2) "past the end of the disk")
                 (check_str "the last" (move_refusal (card) 524287 1) "")))))

(def test_card_line () int
  (add (check_str "standard" (card_line (card)) "an SD card of 268.4 MB, 524288 sectors")
       (check_str "high" (card_line (Card 1 true 8388608)) "an SDHC card of 4.3 GB, 8388608 sectors")))

; A request for a disk no slot has is refused, as is one naming none.
(def test_no_such_disk () int
  (add (check_str "none named" (answer (nil SdSlot) "info") "error: no disk named")
       (check_str "another" (answer (nil SdSlot) "disk3 info") "error: no disk disk3")))

; Under an operating system it is started with no arguments: usage.
(def test_usage () int
  (check_int "fails" (sdhci) 1))

; Under an operating system there is no pci server.
(def test_no_pci () int
  (check_int "fails" (from_pci) 1))

; A slot's line ends with how it waits.
(def test_wait_text () int
  (add (check_str "interrupt" (wait_text (Waits 37 5)) ", interrupt 37")
       (check_str "polled" (wait_text (Polled)) ", polled")))

; Under an operating system an interrupt cannot be bound: polled.
(def test_wait_for () int
  (add (check_str "none raised" (wait_text (wait_for 0)) ", polled")
       (check_str "not bound" (wait_text (wait_for 37)) ", polled")))

(def test_controller_line () int
  (check_str "the controller" (controller_line (PciFunction 24 6966 36 525569 37 (cons 268435456 (nil int)) (cons 256 (nil int))))
    "a controller at 00:03.0, registers at 0x10000000, 256 bytes"))
