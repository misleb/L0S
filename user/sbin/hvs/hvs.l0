; hvs.l0 -- a display driver for the Raspberry Pi 5, serving the
; hardware-neutral display protocol, user/lib/proto/display.l0, that the
; compositor, user/sbin/wm, draws the screen through, as virtio-gpu does
; on QEMU. Its module must be flagged dev.
;
; The firmware brings HDMI0 up at 1920x1080 and leaves the BCM2712's HVS
; scanning channel 0. The driver reads the monitor's EDID from it
; (edid.l0) and sets HDMI0 to the monitor's preferred mode itself, its
; PHY, timings and pixel valve, through the regions L0 gives for them
; (hdmi.l0, modeset.l0; the boot argument hdmi= chooses otherwise), then
; takes the channel over without resetting it: it never copies a pixel, but writes display lists,
; one plane for each piece of each layer (pieces.l0), each fetched by the
; HVS straight from the client's pages:
;
; - A client's pages are scattered, and a plane is one run of addresses,
;   so the driver maps each buffer's pages one after another in an
;   aperture of the IOMMU in front of the HVS (iommu.l0), and points its
;   planes there.
; - Two lists, each in its own half of the list memory, so that the one
;   written is never the one shown: a restack is answered at once, and
;   its list written into the half the channel is not fetching, and the
;   channel pointed at it, as soon as the list pointed at before has been
;   taken, at the end of frame that shows it taken if not at once; only
;   the latest screen asked is written (pending.l0). A buffer forgotten
;   while a list may still read it keeps its pages until none does.
; - The Pi's DMA does not see the CPU's caches, and the HVS reads every
;   pixel every frame, so a damaged rectangle is only a cleaning of the
;   pages its rows are in.
; - The pointer is a plane on top with its pixels' own alpha.
; - A layer with rounded corners is a plane with its pixels' own alpha,
;   which the driver writes 0 where its corners cut (corners.l0), and
;   which the toolkit writes opaque everywhere else.
;
; L0 gives the HVS and both IOMMUs as regions on the Pi 5 (L0 roadmap
; 0105); on QEMU there are none, and the driver says there is no HVS and
; exits 0. The HVS answers only once the firmware has brought a monitor
; up on HDMI0 at boot, and a read of it unclocked hangs the board with no
; fault, so the driver asks the firmware first (fw.l0). It has shown
; the desktop on a board. It was brought up a stage at a time, by its
; argument, each stage doing all the one before it does and then
; exiting, which is still how to look at the HVS:
;
;   hvs probe   reads the firmware's displays, the monitor's EDID and
;               the clocks, the HVS's and the IOMMU's registers and the
;               firmware's list, asks the firmware's display tags, tells
;               the firmware the display is ours, and reads the clocks
;               again; its EDID's bytes too
;   hvs mode    an experiment: asks the firmware, by firmware KMS's
;               SET_TIMING, for the monitor's preferred mode, and says
;               what the mode is after
;   hvs hdmi    reads HDMI0's controller, PHY, pixel valve and DDC, M2MC
;               made sure of first, and the mode they say, writing none
;   hvs list    the display released, its clocks made sure of, and the
;               channel moved to an empty list of the driver's own
;   hvs iommu   the IOMMU then set up as bcm2712_iommu_init does
;   hvs         all that, then serving display
;   hvs eof     beside them all, touching no HVS register: asks for the
;               end of frame's interrupt controller and interrupt, and
;               says whether the board gives each
;
; Every step that could hang says so before it runs, and the kernel
; writes that line out at once, so the last line names it. Raspberry
; Pi's Linux is the guide, and spec/display.md's first-run checklist says what
; to look at on the board.

; What ends the driver, said as hvs: 1.
(def complain ((why (list int))) int (fail_as "hvs" why))

; ---------------------------------------------------------------- start

; ---------------------------------------------------------------- stages

; How far the driver goes before it stops (the file's header): each stage
; does all the one before it does.
; StageMode, mode, is an experiment beside them, which asks the firmware
; for the monitor's preferred mode and stops (edid.l0's mode_tried).
; StageHdmi, hdmi, reads HDMI0's controller, PHY and pixel valve and
; stops (hdmi.l0's hdmi_probed). StageEof, eof, asks for the end of
; frame's interrupt controller and interrupt, touching no HVS register,
; and says which the board gives (eof_asked).
(data Stage (StageProbe) (StageList) (StageIommu) (StageFull) (StageMode) (StageHdmi) (StageEof))

; Its place in that order, 0 for probe to 3 for serving; mode is -1,
; hdmi -2 and eof -3, before them all.
(def stage_rank ((s Stage)) int
  (match s ((StageProbe) 0) ((StageList) 1) ((StageIommu) 2) ((StageFull) 3) ((StageMode) -1) ((StageHdmi) -2) ((StageEof) -3)))

; Whether stage s stops at stage t, having done it.
(def stops_at ((s Stage) (t Stage)) bool (eq (stage_rank s) (stage_rank t)))

; The stage hvs's arguments as name: none is serving, else probe, list,
; iommu, mode, hdmi or eof; anything else is none.
(def stage_of ((as (list (list int)))) (Option Stage)
  (if (is_empty as)
      (Some (StageFull))
      (if (not (is_empty (tail as)))
          ((None Stage))
          (stage_named (head as)))))

; The stage called a, if one is.
(def stage_named ((a (list int))) (Option Stage)
  (if (eq a "probe") (Some (StageProbe))
  (if (eq a "list") (Some (StageList))
  (if (eq a "iommu") (Some (StageIommu))
  (if (eq a "mode") (Some (StageMode))
  (if (eq a "hdmi") (Some (StageHdmi))
  (if (eq a "eof") (Some (StageEof))
  ((None Stage)))))))))

; A step said before it is taken, so that if it hangs the board it is the
; last line on the serial line; as debug, kept and not printed, once the
; driver serves, past the stages. 0.
(def step ((s Stage) (what (list int))) int
  (if (stops_at s (StageFull)) (debug_as "hvs" what) (info_as "hvs" what)))

; hvs [probe | list | iommu | mode | hdmi | eof], from main.
(def hvs_main ((as (list (list int)))) int
  (match (stage_of as)
    ((None) (complain "usage: hvs [probe | list | iommu | mode | hdmi | eof]"))
    ((Some s) (if (stops_at s (StageEof)) (eof_asked) (hvs s)))))

; Stage eof: channel 0's ends of frame counted for two seconds, through
; the display's interrupt controller and its interrupt, bound to a port
; of the stage's own, each said refused if the board does not give it.
; It writes no HVS register and reads only channel 0's STATUS, so it runs
; beside the driver that serves; the controller is clocked as the HVS
; is, so it is read only if the firmware brought a display up. 0.
(def eof_asked () int
  (match (mailbox_open)
    ((NoMbox why) (complain (append "cannot ask the firmware whether the display is clocked: " why)))
    ((MboxOpen mb)
      (match (fw_displays mb)
        ((None) (complain "the firmware did not say how many displays it brought up"))
        ((Some n)
          (if (eq n 0)
              (info_as "hvs" "eof: no monitor on HDMI0 at boot; the display is unclocked")
              (eof_opened)))))))

; The controller opened, or why not.
(def eof_opened () int
  (match (open_device (disp_intr_base) (disp_intr_bytes))
    ((DeviceFailed fault why)
      (info_as "hvs" (append "eof: the display's interrupt controller, 0x107c502000, is not given: " why)))
    ((DeviceOpened l2)
      (let port (port_new)
        (let why (irq_bind_or_why (disp_intr_irq) port)
          (if (is_empty why)
              (eof_bound l2 port)
              (info_as "hvs" (append "eof: " why))))))))

; The interrupt bound to port: the HVS opened to read STATUS by, every
; line masked and cleared, channel 0's unmasked, the count taken, and
; every line masked and cleared again. Not the mask as it was (the
; firmware's 0, all unmasked): once the stage has enabled 129, which
; stays enabled, a line left unmasked with nothing to clear it raised
; it for ever and hung a Pi 5's kernel (roadmap 0005's Log).
(def eof_bound ((l2 IoDevice) (port int)) int
  (match (open_device (hvs_base) (hvs_bytes))
    ((DeviceFailed fault why) (complain (append "eof: no HVS: " why)))
    ((DeviceOpened d)
      (match (hvs_gen_of (device_read32 d (hvs_version)))
        ((None) (complain "eof: an HVS of a version this driver does not know"))
        ((Some g)
          (let saved (device_read32 l2 (l2_mask_status))
            (let s (info_as "hvs" (reg_line "eof: the controller's mask" (l2_mask_status) saved))
              (let m (device_write32 l2 (l2_mask_set) (l2_all))
                (let c (device_write32 l2 (l2_clear) (l2_all))
                  (let u (device_write32 l2 (l2_mask_clear) (eof_bit 0))
                    (let t0 (clock_ns)
                      (let a (alarm_at port (add t0 2000000000))
                        (let f0 (status_frames (device_read32 d (disp_status g 0)))
                          (let r (eof_counted l2 port 0 0)
                            (let t1 (clock_ns)
                              (let f1 (status_frames (device_read32 d (disp_status g 0)))
                                (let b (device_write32 l2 (l2_mask_set) (l2_all))
                                  (let c2 (device_write32 l2 (l2_clear) (l2_all))
                                    (eof_said r (sub t1 t0) f0 f1)))))))))))))))))))

; How many interrupts came, and of them how many had channel 0's line
; raised.
(data EofCount (EofCount int int))

; Interrupts taken on port until its alarm, each with channel 0's line
; cleared before it is acked; n of them so far, e with the line raised.
(def eof_counted ((l2 IoDevice) (port int) (n int) (e int)) EofCount
  (let m (port_receive port)
    (if (is_alarm_notice m)
        (EofCount n e)
        (if (is_irq_notice m (disp_intr_irq))
            (let st (device_read32 l2 (l2_status))
              (let c (device_write32 l2 (l2_clear) (eof_bit 0))
                (let k (irq_ack (disp_intr_irq))
                  (eof_counted l2 port (add n 1)
                    (if (eq (bit_and st (eof_bit 0)) 0) e (add e 1))))))
            (eof_counted l2 port n e)))))

; The count said: the interrupts, those of channel 0's end of frame, the
; rate, and STATUS's 6-bit frame count before and after. 0.
(def eof_said ((r EofCount) (ns int) (f0 int) (f1 int)) int
  (match r
    ((EofCount n e)
      (let t (eof_tenths_hz e ns)
        (info_as "hvs" (append "eof: " (append (digits n) (append " interrupts in " (append (digits (div ns 1000000))
          (append " ms, " (append (digits e) (append " of them channel 0's end of frame: "
          (append (digits (div t 10)) (append "." (append (digits (mod t 10))
          (append " Hz; STATUS's frame count " (append (digits f0) (append " to " (digits f1)))))))))))))))))))

; ---------------------------------------------------------------- start

; Finds the HVS and HDMI0's channel, takes the IOMMU, and serves, or
; stops after stage s.
(def hvs ((s Stage)) int
  (match (open_device (hvs_base) (hvs_bytes))
    ((DeviceFailed fault why) (info_as "hvs" "no HVS on the board"))
    ((DeviceOpened d)
      (match (mailbox_open)
        ((NoMbox why) (complain (append "cannot ask the firmware whether the HVS is clocked: " why)))
        ((MboxOpen mb) (guarded d mb s))))))

; The HVS read only if the firmware brought a display up at boot: with
; none, the HVS has no clock, and its first read hangs the board.
(def guarded ((d IoDevice) (mb Mailbox) (s Stage)) int
  (let w (info_as "hvs" "asking the firmware how many displays it brought up")
    (match (fw_displays mb)
      ((None) (complain "the firmware did not say how many displays it brought up"))
      ((Some n)
        (if (eq n 0)
            (info_as "hvs" "no monitor on HDMI0 at boot; the HVS is unclocked")
            (let e (monitor_said mb s)
              (let c (clocks_said mb "at boot")
                (let r (step s "reading the HVS's version")
                  (with_hvs d mb s)))))))))

; The HVS opened as d: its layout, and HDMI0's channel's mode, once the
; firmware has been asked for the monitor's preferred one (edid.l0). A
; channel that does not run is no screen, which is no failure.
(def with_hvs ((d IoDevice) (mb Mailbox) (s Stage)) int
  (let v (device_read32 d (hvs_version))
    (match (hvs_gen_of v)
      ((None) (complain (append "an HVS of version 0x" (append (hex_digits v 8) " this driver does not know"))))
      ((Some g)
        (if (stops_at s (StageHdmi))
            (hdmi_probed mb)
        (if (stops_at s (StageMode))
            (mode_tried d g mb)
        (if (stops_at s (StageProbe))
            (probed d g mb)
            (let c (mode_preferred d g mb s (device_read32 d (disp_ctrl0 g (hdmi0_channel))))
              (if (ctrl0_enabled c)
                  (taken_over d g mb s (ctrl0_width c) (ctrl0_height c))
                  (info_as "hvs" "no screen on HDMI0: the firmware left its channel off"))))))))))

; The display released, its clocks made sure of, and the channel on an
; empty list of the driver's own; then, past stage list, the IOMMU.
(def taken_over ((d IoDevice) (g HvsGen) (mb Mailbox) (s Stage) (w int) (h int)) int
  (let r (display_released_by mb)
    (let c (clocks_ensured mb)
      (let k (own_list d g s)
        (if (stops_at s (StageList))
            (channel_said d g "on its own list")
            (with_iommus d g s k w h))))))

; ----------------------------------------------------------------- probe

; A register's name, where it is, and the word read there.
(def reg_line ((name (list int)) (off int) (w int)) (list int)
  (append name (append " (0x" (append (hex_digits off 4) (append ") = 0x" (hex_digits w 8))))))

; A register of a device, by name and offset.
(data NamedReg (NamedReg (list int) int))

; The registers probe reads of the HVS: its version and HDMI0's channel's.
(def hvs_regs ((g HvsGen)) (list NamedReg)
  (cons (NamedReg "VERSION" (hvs_version))
  (append (hvs_sizes)
  (cons (NamedReg "DISP0 CTRL0" (disp_ctrl0 g (hdmi0_channel)))
  (cons (NamedReg "DISP0 CTRL1" (disp_ctrl1 g (hdmi0_channel)))
  (cons (NamedReg "DISP0 BGND" (disp_bgnd g (hdmi0_channel)))
  (cons (NamedReg "DISP0 LPTRS" (disp_lptrs g (hdmi0_channel)))
  (cons (NamedReg "DISP0 STATUS" (disp_status g (hdmi0_channel)))
  (cons (NamedReg "DISP0 DL" (disp_dl g (hdmi0_channel)))
  (nil NamedReg))))))))))

; The HVS's memories' sizes, the same on C0 and D0 (vc4_regs.h's
; SCALER6_CXM_SIZE to COB_SIZE), and its HANDLE_ERROR: Linux reads none
; of them and takes the UPM, the UBM, to be 1,024 units of 256 bytes.
(def hvs_sizes () (list NamedReg)
  (cons (NamedReg "CXM_SIZE" 4)
  (cons (NamedReg "LBM_SIZE" 8)
  (cons (NamedReg "UBM_SIZE" 12)
  (cons (NamedReg "COB_SIZE" 20)
  (cons (NamedReg "HANDLE_ERROR" 44)
  (nil NamedReg)))))))

; The registers probe and stage iommu read of the IOMMU in front of the HVS.
(def iommu_regs () (list NamedReg)
  (cons (NamedReg "iommu4 CTRL" (mmu_ctrl))
  (cons (NamedReg "iommu4 PT_PA_BASE" (mmu_pt_pa_base))
  (cons (NamedReg "iommu4 ADDR_CAP" (mmu_addr_cap))
  (cons (NamedReg "iommu4 BYPASS_START" (mmu_bypass_start))
  (cons (NamedReg "iommu4 BYPASS_END" (mmu_bypass_end))
  (cons (NamedReg "iommu4 MISC" (mmu_misc))
  (cons (NamedReg "iommu4 ILLEGAL_ADR" (mmu_illegal_adr))
  (cons (NamedReg "iommu4 DEBUG_INFO" (mmu_debug_info))
  (nil NamedReg))))))))))

; Each of rs read from d and said, each said before it is read: 0.
(def regs_said ((d IoDevice) (rs (list NamedReg))) int
  (if (is_empty rs)
      0
      (match (head rs)
        ((NamedReg name off)
          (let w (info_as "hvs" (append "reading " name))
            (let s (info_as "hvs" (reg_line name off (device_read32 d off)))
              (regs_said d (tail rs))))))))

; Registers rs read and said on one line after acc: 0.
(def sizes_said ((d IoDevice) (rs (list NamedReg)) (acc (list int))) int
  (if (is_empty rs)
      (info_as "hvs" (append "the HVS's memories:" acc))
      (match (head rs)
        ((NamedReg name off)
          (sizes_said d (tail rs) (append acc (append " " (append name (append " 0x" (hex_digits (device_read32 d off) 8))))))))))

; If HANDLE_ERROR is not 0 after a list of planes ps was written, it
; said, with how far the planes' UPM reaches: 0. (The channel's STATUS
; EMPTY, bit 22, is no sign of the HVS running dry: on a board it sets
; with three planes, at line 0, and reading it every list slowed the
; pointer.)
(def handle_error_said ((d IoDevice) (ps (list Plane))) int
  (let e (device_read32 d 44)
    (if (eq e 0)
        0
        (warn_as "hvs" (append "HANDLE_ERROR 0x" (append (hex_digits e 8)
          (append " with " (append (digits (length ps)) (append " planes, UPM to unit " (digits (upm_reach ps 0)))))))))))

; How far the UPM of planes ps reaches, at least to r.
(def upm_reach ((ps (list Plane)) (r int)) int
  (if (is_empty ps)
      r
      (match (head ps)
        ((Plane x y w h addr pitch upm handle alpha)
          (upm_reach (tail ps) (max r (add upm (upm_for (mul 4 w)))))))))

; The words of list memory from word i to the end marker, at most n: 0.
(def dlist_said ((d IoDevice) (i int) (n int)) int
  (if (if (le n 0) true (ge i (dlist_words)))
      0
      (let w (device_read32 d (dlist_word_offset i))
        (let s (info_as "hvs" (reg_line (append "dlist " (digits i)) (dlist_word_offset i) w))
          (if (eq (bit_and w (dlist_end)) (dlist_end)) 0 (dlist_said d (add i 1) (sub n 1)))))))

; Stage probe: the HVS's registers and the firmware's list, the IOMMU's
; and its cache's, all read; the firmware's display tags asked (fw.l0);
; then the display released and the clocks read again, touching the HVS
; no more. 0.
(def probed ((d IoDevice) (g HvsGen) (mb Mailbox)) int
  (let a (info_as "hvs" (append "an HVS " (hvs_gen_name g)))
    (let b (regs_said d (hvs_regs g))
      (let c (dlist_said d (dl_active (device_read32 d (disp_dl g (hdmi0_channel)))) 64)
        (let e (iommus_said)
          (let t (display_tags_said mb (display_asks))
            (let r (display_released_by mb)
              (let k (clocks_said mb "released")
                (info_as "hvs" "probe done")))))))))

; The IOMMU's registers and its cache's word 0, read and said: 0.
(def iommus_said () int
  (match (open_device (iommu4_base) (iommu_bytes))
    ((DeviceFailed fault why) (warn_as "hvs" "no IOMMU in front of the HVS on the board"))
    ((DeviceOpened mmu)
      (let a (regs_said mmu (iommu_regs))
        (let c (close_device mmu)
          (match (open_device (iommuc_base) (iommu_bytes))
            ((DeviceFailed fault why) (warn_as "hvs" "no IOMMU cache on the board"))
            ((DeviceOpened cache)
              (let b (regs_said cache (cons (NamedReg "iommuc 0" 0) (nil NamedReg)))
                (let e (close_device cache) 0)))))))))

; Where HDMI0's channel is, said after what: its status and its list. 0.
(def channel_said ((d IoDevice) (g HvsGen) (what (list int))) int
  (let st (device_read32 d (disp_status g (hdmi0_channel)))
    (let dl (device_read32 d (disp_dl g (hdmi0_channel)))
      (info_as "hvs" (append what (append ": " (channel_line st dl)))))))

; The channel's status and list, as said: its mode, frame count and the
; word its list starts at.
(def channel_line ((st int) (dl int)) (list int)
  (append "channel mode " (append (digits (status_mode st))
    (append ", frame " (append (digits (status_frames st))
      (append ", list at word " (digits (dl_active dl))))))))

; -------------------------------------------------------------- own list

; The channel's background black, then the channel moved to a list of the
; driver's own holding only its end, in the half the firmware's list is
; not in, before the IOMMU changes under it: that half, 0 or 1; or, if
; the firmware keeps the channel (fw_lists_written), -1.
(def own_list ((d IoDevice) (g HvsGen) (s Stage)) int
  (let a (step s "writing HDMI0's background black")
    (let b (background_black d g)
      (let k (if (eq (live_half d g) 0) 1 0)
        (let c (step s (append "writing an empty list at word " (digits (dlist_half_start k))))
          (let wr (words_written d (dlist_half_start k) (list_words g (nil Plane)))
            (let e (step s "moving HDMI0's channel to it")
              (match (list_switched (frames_polled) d g (dlist_half_start k) (list_words g (nil Plane)))
                ((TakenBy ok f) (if ok k -1))))))))))

; The channel's background black and filled in where no plane is: 0.
(def background_black ((d IoDevice) (g HvsGen)) int
  (let b (device_write32 d (disp_bgnd g (hdmi0_channel)) 0)
    (let c (device_read32 d (disp_ctrl1 g (hdmi0_channel)))
      (device_write32 d (disp_ctrl1 g (hdmi0_channel)) (ctrl1_with_background c)))))

; The half of the list memory the channel fetches from now, 0 or 1, or
; -1 if its list is in neither, as the firmware's may be.
(def live_half ((d IoDevice) (g HvsGen)) int
  (dlist_half_of (dl_active (device_read32 d (disp_dl g (hdmi0_channel))))))

; ----------------------------------------------------------------- iommu

; The IOMMU in front of the HVS and its cache opened, for a screen w by
; h, the channel on its list in half k.
(def with_iommus ((d IoDevice) (g HvsGen) (s Stage) (k int) (w int) (h int)) int
  (match (open_device (iommu4_base) (iommu_bytes))
    ((DeviceFailed fault why) (info_as "hvs" "no IOMMU in front of the HVS on the board"))
    ((DeviceOpened mmu)
      (match (open_device (iommuc_base) (iommu_bytes))
        ((DeviceFailed fault why) (info_as "hvs" "no IOMMU cache on the board"))
        ((DeviceOpened cache) (with_tables d g mmu cache s k w h))))))

; The IOMMU's tables, in DMA pages of this driver's, opened to write.
(def with_tables ((d IoDevice) (g HvsGen) (mmu IoDevice) (cache IoDevice) (s Stage) (k int) (w int) (h int)) int
  (match (dma_alloc (table_pages))
    ((DmaDenied) (complain "may not drive devices: it needs a dev line"))
    ((DmaTooMany) (complain "the IOMMU's tables are more pages than one allocation"))
    ((DmaNoRoom) (complain "no memory for the IOMMU's tables"))
    ((DmaPages va)
      (match (dma_open va (table_pages))
        ((DeviceFailed fault why) (complain why))
        ((DeviceOpened t)
          (match (page_addresses va (table_pages))
            ((None) (complain "the IOMMU's tables are not DMA pages"))
            ((Some addrs) (started (Hw d g mmu cache t va addrs (frames_polled)) s k w h))))))))

; The hardware the driver keeps: the HVS, its layout, the IOMMU and its
; cache, and the IOMMU's tables, opened, where this process sees them,
; and where the IOMMU reaches each page; and the ends of frame, counted
; (frames.l0), none until the driver serves.
(data Hw (Hw IoDevice HvsGen IoDevice IoDevice IoDevice int (array int) Frames))

; The IOMMU on, under the channel's own list, which fetches no plane;
; then, past stage iommu, the driver serving, the channel's list in half
; k.
(def started ((hw Hw) (s Stage) (k int) (w int) (h int)) int
  (let a (iommu_on hw s)
    (if (stops_at s (StageIommu))
        (match hw
          ((Hw d g mmu cache t tva addrs fr)
            (let r (regs_said mmu (iommu_regs))
              (channel_said d g "under the IOMMU"))))
        (start_serving (Drv hw w h ((MapEmpty int Buffer)) (nil Layer) (no_cursor) (aperture_new) (lists_new k))))))

; Each second-level table entered in the first, the tables cleaned out of
; the caches for the IOMMU to read, then the IOMMU's registers in the
; order bcm2712_iommu_init writes them: off, its sticky bits and TLB
; cleared; two levels; the aperture's end; everything below the aperture
; passed through, so what the firmware left still fetches; the tables'
; base; and the default page. Then the cache flushed and the IOMMU on.
; 0.
(def iommu_on ((hw Hw) (s Stage)) int
  (match hw
    ((Hw d g mmu cache t tva addrs fr)
      (let e (l1_entries t addrs 0)
        (let y (dma_synced tva (table_pages))
          (let r (step s "writing iommu4 CTRL off, its sticky bits and TLB cleared")
            (let c (device_write32 mmu (mmu_ctrl) (mmu_ctrl_reset))
              (let p (if (polled mmu (mmu_ctrl) 7 100) 0 (warn_as "hvs" "the IOMMU's TLB did not clear"))
                (iommu_ranged hw s)))))))))

; iommu_on's registers from MISC to ILLEGAL_ADR, each said first; then
; the cache and CTRL. 0.
(def iommu_ranged ((hw Hw) (s Stage)) int
  (match hw
    ((Hw d g mmu cache t tva addrs fr)
      (let a (step s "writing iommu4 MISC, two levels")
        (let m (device_write32 mmu (mmu_misc) (misc_two_level (device_read32 mmu (mmu_misc))))
          (let b (step s "writing iommu4 ADDR_CAP and BYPASS_START")
            (let c (device_write32 mmu (mmu_addr_cap) (addr_cap))
              (let bs (device_write32 mmu (mmu_bypass_start) 0)
                (let dbg (device_read32 mmu (mmu_debug_info))
                  (let e (step s "writing iommu4 BYPASS_END, PT_PA_BASE and ILLEGAL_ADR")
                    (let be (device_write32 mmu (mmu_bypass_end) (bypass_end dbg))
                      (let p (device_write32 mmu (mmu_pt_pa_base) (pt_pa_base (array_get addrs 0)))
                        (let i (device_write32 mmu (mmu_illegal_adr) (illegal_adr (array_get addrs (default_page))))
                          (iommu_enabled hw s))))))))))))))

; The IOMMU's cache flushed, then the IOMMU on: 0.
(def iommu_enabled ((hw Hw) (s Stage)) int
  (match hw
    ((Hw d g mmu cache t tva addrs fr)
      (let a (step s "flushing the IOMMU's cache")
        (let f (device_write32 cache 0 (cache_flush))
          (let p (if (polled cache 0 2 100) 0 (warn_as "hvs" "the IOMMU's cache did not flush"))
            (let b (step s "writing iommu4 CTRL on")
              (device_write32 mmu (mmu_ctrl) (mmu_ctrl_on)))))))))

; The first-level table's entries from table i on, each the page of the
; second-level table after it: 0.
(def l1_entries ((t IoDevice) (addrs (array int)) (i int)) int
  (if (ge i (l2_tables))
      0
      (let w (device_write32 t (l1_offset i) (l1_entry (array_get addrs (add i 1))))
        (l1_entries t addrs (add i 1)))))

; The IOMMU's TLB cleared and the cache it shares flushed, so that what
; the tables now say is what it reads; each waited for. 0.
(def iommu_cleared ((hw Hw)) int
  (match hw
    ((Hw d g mmu cache t tva addrs fr)
      (let c (device_write32 mmu (mmu_ctrl) (mmu_tlb_clear (mmu_ctrl_on)))
        (let a (if (polled mmu (mmu_ctrl) 7 100) 0 (warn_as "hvs" "the IOMMU's TLB did not clear"))
          (let f (device_write32 cache 0 (cache_flush))
            (if (polled cache 0 2 100) 0 (warn_as "hvs" "the IOMMU's cache did not flush"))))))))

; Whether bit b of the register at off in d is clear, read up to n
; times, 100 microseconds apart.
(def polled ((d IoDevice) (off int) (b int) (n int)) bool
  (if (eq (bit_and (bit_shr (device_read32 d off) b) 1) 0)
      true
      (if (le n 0) false (let s (sleep_ns 100000) (polled d off b (sub n 1))))))

; n DMA pages from va cleaned out of the caches, for a device to read: 0.
(def dma_synced ((va int) (n int)) int
  (if (le n 0)
      0
      (match (dma_sync va n 1) ((DmaSynced k) 0) ((DmaSyncDenied) 0) ((DmaSyncBad) 0))))

; --------------------------------------------------------------- the driver

; The driver: its hardware, the screen's width and height, the buffers
; shared with it, the layers and the pointer last asked, the aperture,
; and its display lists (pending.l0): the half of the list memory the
; channel fetches from, or -1 once the firmware is found keeping the
; channel on its own two lists, over which each list is then written
; (fw_lists_written); the list fetched, the one pointed at and the
; screen wanted, each with the UPM of its planes, which the next list
; keeps or keeps clear of (pieces.l0); and the pages forgotten that a
; list may still read.
(data Drv (Drv Hw int int (Map int Buffer) (list Layer) Cursor Aperture Lists))

; What the driver says as it starts serving: the screen, where, and how.
(def screen_line ((g HvsGen) (w int) (h int) (s int)) (list int)
  (append "a screen of " (append (digits w) (append "x" (append (digits h)
    (append " on HDMI0, HVS " (append (hvs_gen_name g)
      (append " at 0x" (append (hex_digits (hvs_base) 10)
        (append ", channel " (append (digits (hdmi0_channel))
          (append ", scale " (append (digits s) ", serving display")))))))))))))

; Registers as display, so that a client finds it at once, takes the
; ends of frame, shows the first frame while what the client asks waits
; on the port, then answers each request, as display.l0 makes them: ok,
; display W H cursor scale S, or error: WHY.
(def start_serving ((v Drv)) int
  (let port (port_new)
    (let r (name_register_or_why port "display")
      (if (is_empty r)
          (match (first_frame (frames_kept v (frames_started)))
            ((Drv hw w h bufs layers cur ap lists)
              (match hw
                ((Hw d g mmu cache t tva addrs fr)
                  (let n (info_as "hvs" (screen_line g w h (scale_of w h (boot_args))))
                    (let z (sizes_said d (hvs_sizes) "")
                      (serving (Drv hw w h bufs layers cur ap lists) port)))))))
          (complain r)))))

; The driver with its ends of frame f.
(def frames_kept ((v Drv) (f Frames)) Drv
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match hw
        ((Hw d g mmu cache t tva addrs fr)
          (Drv (Hw d g mmu cache t tva addrs f) w h bufs layers cur ap lists))))))

; The driver's ends of frame.
(def drv_frames ((v Drv)) Frames
  (match v ((Drv hw w h bufs layers cur ap lists) (match hw ((Hw d g mmu cache t tva addrs fr) fr)))))

; Serving on port, and on the ends of frame's port beside it as one set
; if there are ends of frame; with none, on port alone.
(def serving ((v Drv) (port int)) int
  (let fp (frames_port (drv_frames v))
    (if (lt fp 0)
        (serve v port)
        (match (port_set (cons port (cons fp (nil int))))
          ((PortSetMade) (serve_set v port))
          ((PortSetNotYours) (complain "its ports are not its own"))
          ((PortSetSize) (complain "cannot wait on two ports"))))))

; ------------------------------------------------------------- wallpaper

; The screen's first frame, as soon as the channel is the driver's: the
; wallpaper (render.l0's wallpaper_load) drawn into pages of the
; driver's own the screen's size, centered and cut as wm draws it,
; mapped in the aperture as a client's buffer is, and shown as the only
; plane, in place of the black background. With no wallpaper, or if it
; cannot be shown, said once, and the screen stays black.
(def first_frame ((v Drv)) Drv
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (let a (step (StageFull) "drawing the wallpaper")
        (match (wall_pages w h (scale_of w h (boot_args)))
          ((None) v)
          ((Some wp)
            (match wp
              ((WallPages va n addrs)
                (match (mapped_for v (wall_id) w h w va n addrs)
                  ((Served v2 reply)
                    (if (not (eq reply "ok"))
                        (wall_unshown v reply va n)
                        (wall_first_shown v2))))))))))))

; The wallpaper, in the aperture, shown alone; if it cannot be, said,
; and given up.
(def wall_first_shown ((v Drv)) Drv
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (let a (step (StageFull) "showing the wallpaper")
        (match (wall_gone (shown_as v (wall_under (nil Layer) true) cur (nil Stamp)))
          ((Served v2 reply)
            (if (eq reply "ok")
                v2
                (let k (warn_as "hvs" (append "the wallpaper not shown: " reply))
                  (wall_gone_now v2)))))))))

; The wallpaper's pages, va and n of them, not mapped, given up, for
; why, said: v as it was.
(def wall_unshown ((v Drv) (why (list int)) (va int) (n int)) Drv
  (let k (warn_as "hvs" (append "the wallpaper not shown: " why))
    (let u (shm_unmap_count va n) v)))

; The wallpaper drawn: its pages, where this process has them, how many,
; and where the IOMMU reaches each.
(data WallPages (WallPages int int (array int)))

; The wallpaper at scale s drawn into w by h pixels of new shared pages,
; their region closed once drawn, so that it holds none of the 64; or
; none, said once, if it cannot be read or there is no memory for it.
(def wall_pages ((w int) (h int) (s int)) (Option WallPages)
  (match (wallpaper_load s 100)
    ((BgBad why) (wall_none why))
    ((BgOk bg)
      (let n (pages_for (mul (mul w h) 4))
        (match (shm_region n "the wallpaper")
          ((NoShmRegion why) (wall_none why))
          ((ShmRegion va r)
            (let f (paint_background (Canvas r w h 0) bg)
              (let k (close_device r)
                (match (page_addresses va n)
                  ((None) (let u (shm_unmap_count va n) (wall_none "its pages are not DMA pages")))
                  ((Some addrs) (Some (WallPages va n addrs))))))))))))

; No wallpaper, for why: said once.
(def wall_none ((why (list int))) (Option WallPages)
  (let k (warn_as "hvs" (append "no wallpaper: " why)) ((None WallPages))))

; Whether one of ls, a client's layers, covers the screen w by h whole,
; square-cornered, so that nothing under it shows.
(def screen_covered ((ls (list Layer)) (bufs (Map int Buffer)) (w int) (h int)) bool
  (if (is_empty ls)
      false
      (if (layer_covering (head ls) bufs w h) true (screen_covered (tail ls) bufs w h))))

; Whether layer l, a client's, covers the screen w by h whole.
(def layer_covering ((l Layer) (bufs (Map int Buffer)) (w int) (h int)) bool
  (match l
    ((Layer id x y top)
      (if (eq id (wall_id))
          false
          (match (map_get bufs id)
            ((None) false)
            ((Some b) (match b ((Buffer bw bh sd va n addr cs) (layer_covers x y bw bh (eq cs (square)) w h)))))))))

; Whether the wallpaper is still on the screen: its buffer is kept.
(def wall_shown ((bufs (Map int Buffer))) bool (map_has bufs (wall_id)))

; Whether the wallpaper stays under a client's layers ls: while it is
; shown and nothing of theirs covers the screen.
(def wall_kept ((ls (list Layer)) (bufs (Map int Buffer)) (w int) (h int)) bool
  (if (wall_shown bufs) (not (screen_covered ls bufs w h)) false))

; After showing r's list, if the wallpaper is no longer in it, its
; pages given up (wall_gone_now); r as it is if it failed or kept it.
(def wall_gone ((r (Served Drv))) (Served Drv)
  (match r
    ((Served v reply)
      (match v
        ((Drv hw w h bufs layers cur ap lists)
          (if (if (eq reply "ok") (if (wall_shown bufs) (not (in_layers layers (wall_id))) false) false)
              (Served (wall_gone_now v) reply)
              r))))))

; The wallpaper's buffer dropped, once the layers asked leave it out, and
; its pages given up as a forgotten buffer's are (dropped): once no
; list that may still be read names them.
(def wall_gone_now ((v Drv)) Drv
  (if (in_layers (drv_layers v) (wall_id)) v (dropped v (wall_id))))

; A request refused for why, said as a warning too, since its client
; may not say it: the state as it was.
(def refused ((v Drv) (why (list int))) (Served Drv)
  (let w (warn_as "hvs" (append "refused: " why)) (served_error v why)))

; Each request on port answered, for as long as the port lasts.
(def serve ((v Drv) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from mb)
      (match (handle v (msg_text_from mb 4))
        ((Served v2 reply)
          (let r (msg_answer mb reply)
            (serve v2 port)))))))

; serve on the set of port and the ends of frame's port: an end of frame
; counted, each request answered.
(def serve_set ((v Drv) (port int)) int
  (match (port_receive_set)
    ((SetRecvFailed) (complain "lost its ports"))
    ((SetMessage p m)
      (if (eq p port)
          (match m
            ((RecvFailed) (serve_set v port))
            ((Message from mb)
              (match (handle v (msg_text_from mb 4))
                ((Served v2 reply)
                  (let r (msg_answer mb reply)
                    (serve_set v2 port))))))
          (serve_set (eof_served v m) port)))))

; Channel 0's STATUS, read now.
(def drv_status ((v Drv)) int
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match hw ((Hw d g mmu cache t tva addrs fr) (device_read32 d (disp_status g (hdmi0_channel))))))))

; A request's body, its op and then its numbers, answered.
(def handle ((v Drv) (body (list int))) (Served Drv)
  (match (request_numbers body)
    ((ReqBad why) (refused v why))
    ((ReqNums op ns) (requested v op ns (length ns)))))

; Request op with its n numbers ns: the buffers and layers, or the
; corners and pointer next.
(def requested((v Drv) (op (list int)) (ns (list int)) (n int)) (Served Drv)
  (if (if (eq op "info") (eq n 0) false) (info v)
  (if (if (eq op "buffer") (if (ge n 4) (le n 6) false) false) (shared v (nth ns 0) (nth ns 1) (nth ns 2) (nth ns 3) (buffer_pages_arg ns) (buffer_stride_arg ns))
  (if (if (eq op "forget") (eq n 1) false) (forgot v (nth ns 0))
  (if (if (eq op "layers") (eq (mod n 4) 0) false) (stacked v (layers_of ns (nil Layer)))
  (if (if (eq op "damage") (if (gt n 0) (eq (mod n 5) 0) false) false) (damaged v ns)
  (requested_pointer v op ns n)))))))

; Request op with its n numbers ns, a buffer's corners or the pointer's,
; or no request this driver knows.
(def requested_pointer((v Drv) (op (list int)) (ns (list int)) (n int)) (Served Drv)
  (if (if (eq op "shape") (eq n 5) false) (shaped v (nth ns 0) (Corners (nth ns 1) (nth ns 2) (nth ns 3) (nth ns 4)))
  (if (if (eq op "cursor") (eq n 3) false) (pointer_image v (nth ns 0) (nth ns 1) (nth ns 2))
  (if (if (eq op "move") (eq n 2) false) (moved v (nth ns 0) (nth ns 1))
  (if (if (eq op "frames") (eq n 1) false) (frames_asked v (nth ns 0))
  (refused v (append "no request " op)))))))

; frames PORT: port told, from now on, each frame that showed a change,
; at its end, and each buffer a list switched to left out, once that
; list is shown (frames.l0's frames_taken).
(def frames_asked ((v Drv) (port int)) (Served Drv)
  (if (lt port 0)
      (refused v "frames takes a port")
      (served_ok (frames_kept v (frames_listening (drv_frames v) port)))))

; info: the screen's size, its own pointer, and the scale.
(def info((v Drv)) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (Served v (info_reply w h (scale_of w h (boot_args)))))))

; -------------------------------------------------------------- buffers

; buffer ID W H VA [PAGES [STRIDE]]: the w by h pixels a client shared,
; at va here, its rows sd pixels apart, mapped in the aperture, where
; they already are if another buffer is in the same pages, and cleaned
; out of the caches for the HVS to read.
(def shared ((v Drv) (id int) (bw int) (bh int) (va int) (pages int) (sd int)) (Served Drv)
  (if (if (lt bw 1) true (if (lt bh 1) true (lt sd bw)))
      (refused v "a buffer has no pixels, or its stride is less than its width")
      (if (not (buffer_id_ok id))
          (refused v "a buffer's id is from 0 to 1000000")
          (let n (buffer_shared_pages sd bh pages)
            (match (page_addresses va n)
              ((None) (refused v "the buffer is not shared with the display"))
              ((Some addrs) (mapped_for v id bw bh sd va n addrs)))))))

; The buffer's n pages at va, at addrs, given a place in the aperture.
(def mapped_for ((v Drv) (id int) (bw int) (bh int) (sd int) (va int) (n int) (addrs (array int))) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match (aperture_mapped ap va)
        ((Some m)
          (match m
            ((Mapped first k)
              (if (lt k n)
                  (refused v "the buffer's pages are already mapped, fewer of them")
                  (let c (dma_synced va n)
                    (with_buffer v id (Buffer bw bh sd va n (aperture_address first) (square))))))))
        ((None)
          (match (aperture_take ap va n)
            ((NoRoom) (refused v "no room left in the IOMMU's aperture"))
            ((Taken ap2 first)
              (let e (ptes_written hw first addrs 0)
                (let c (dma_synced va n)
                  (with_buffer (Drv hw w h bufs layers cur ap2 lists) id
                    (Buffer bw bh sd va n (aperture_address first) (square))))))))))))

; The aperture's pages from first mapped to the pages at addrs, from i,
; the tables they are in cleaned for the IOMMU, which then forgets what
; it read of them before: 0.
(def ptes_written ((hw Hw) (first int) (addrs (array int)) (i int)) int
  (match hw
    ((Hw d g mmu cache t tva taddrs fr)
      (if (lt i (array_len addrs))
          (let e (device_write32 t (pte_offset (add first i)) (pte (array_get addrs i)))
            (ptes_written hw first addrs (add i 1)))
          (tables_synced hw first (array_len addrs))))))

; The aperture's n pages from first unmapped: 0.
(def ptes_cleared ((hw Hw) (first int) (n int) (i int)) int
  (match hw
    ((Hw d g mmu cache t tva taddrs fr)
      (if (lt i n)
          (let e (device_write32 t (pte_offset (add first i)) 0)
            (ptes_cleared hw first n (add i 1)))
          (tables_synced hw first n)))))

; The second-level tables of the aperture's n pages from first cleaned
; out of the caches, and the IOMMU's own copies of them cleared: 0.
(def tables_synced ((hw Hw) (first int) (n int)) int
  (match hw
    ((Hw d g mmu cache t tva taddrs fr)
      (let p0 (div (pte_offset first) (page_size))
        (let p1 (div (pte_offset (add first (sub (max n 1) 1))) (page_size))
          (let s (dma_synced (add tva (mul p0 (page_size))) (add (sub p1 p0) 1))
            (iommu_cleared hw)))))))

; The driver with buffer b as id: the screen shown again if it shows id,
; since its planes fetch from the old one, and the old one's corners put
; back. An old one in other pages leaves them as a forgotten buffer
; does (pages_left).
(def with_buffer ((v Drv) (id int) (b Buffer)) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (let nbufs (map_put bufs id b)
        (match (if (if (in_layers layers id) true (eq (cursor_id cur) id))
                   (shown_as (Drv hw w h nbufs layers cur ap lists) layers cur (stamps_of layers bufs))
                   (served_ok (Drv hw w h nbufs layers cur ap lists)))
          ((Served v2 reply)
            (match (map_get bufs id)
              ((None) (Served v2 reply))
              ((Some old)
                (if (eq (buffer_va old) (buffer_va b))
                    (Served v2 reply)
                    (Served (pages_left v2 (buffer_va old)) reply))))))))))

; Where this process sees a buffer's pages.
(def buffer_va ((b Buffer)) int (match b ((Buffer bw bh sd va n addr cs) va)))

; The buffer the pointer's image is, -1 for none.
(def cursor_id ((cur Cursor)) int (match cur ((Cursor id px py hx hy) id)))

; forget ID: the buffer dropped, and once no other buffer is in its pages,
; its place in the aperture and the pages given up (dropped). Refused
; while it is on the screen asked or is the pointer's. The reply does
; not wait for the screen asked to be shown, so a list the channel
; fetches, or is pointed at, may still name the buffer: its pages are
; then given up only once a list that leaves them out is shown.
(def forgot ((v Drv) (id int)) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (if (if (in_layers layers id) true (eq (cursor_id cur) id))
          (if (map_has bufs id)
              (refused v (append "buffer " (append (digits id) " is in use")))
              (served_ok v))
          (served_ok (dropped v id))))))

; Buffer id dropped, if the driver has it, and its pages left
; (pages_left).
(def dropped ((v Drv) (id int)) Drv
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match (map_get bufs id)
        ((None) v)
        ((Some b) (pages_left (Drv hw w h (map_remove bufs id) layers cur ap lists) (buffer_va b)))))))

; The pages at va, which no buffer of the driver's may now be in: given
; up at once if no list that may still be read names them, else once
; none does (pending.l0's lists_forgot); kept if a buffer is in them.
(def pages_left ((v Drv) (va int)) Drv
  (stepped v (lists_forgot (drv_lists v) va (bufs_vas (drv_bufs v)))))

; The driver's buffers.
(def drv_bufs ((v Drv)) (Map int Buffer) (match v ((Drv hw w h bufs layers cur ap lists) bufs)))

; The driver's lists.
(def drv_lists ((v Drv)) Lists (match v ((Drv hw w h bufs layers cur ap lists) lists)))

; Where each of bufs's pages are.
(def bufs_vas ((bufs (Map int Buffer))) (list int)
  (buffers_vas (map_values bufs) (nil int)))

; Where each of bs's pages are, onto acc.
(def buffers_vas ((bs (list Buffer)) (acc (list int))) (list int)
  (if (is_empty bs) acc (buffers_vas (tail bs) (cons (buffer_va (head bs)) acc))))

; The pages a list of layers ls and pointer cur over bufs reads: each
; layer's buffer's and the pointer's.
(def screen_vas ((ls (list Layer)) (cur Cursor) (bufs (Map int Buffer))) (list int)
  (layers_vas ls bufs (match (map_get bufs (cursor_id cur)) ((None) (nil int)) ((Some b) (cons (buffer_va b) (nil int))))))

; The pages of layers ls's buffers over bufs, onto acc.
(def layers_vas ((ls (list Layer)) (bufs (Map int Buffer)) (acc (list int))) (list int)
  (if (is_empty ls)
      acc
      (match (head ls)
        ((Layer id x y top)
          (layers_vas (tail ls) bufs (match (map_get bufs id) ((None) acc) ((Some b) (cons (buffer_va b) acc))))))))

; The driver after a step of its lists (pending.l0): a list taken noted
; as a change, shown a frame on (shown.l0's list_frames), with the
; buffers it releases; a list to write written into its half, the
; channel pointed at it, and the ends of frame's port given an alarm for
; when it should have been taken; and the pages no list reads unmapped
; and given up.
(def stepped ((v Drv) (st ListsStep)) Drv
  (match st
    ((ListsStep ls wr took rel free)
      (let v2 (if took (frames_kept v (frames_released (frames_changed_now (drv_frames v) (drv_status v) (list_frames)) rel)) v)
        (let p (match wr ((None) 0) ((Some lw) (list_pointed v2 lw (lists_due ls))))
          (pages_given_up (lists_kept v2 ls) free))))))

; The driver with lists ls.
(def lists_kept ((v Drv) (ls Lists)) Drv
  (match v ((Drv hw w h bufs layers cur ap lists) (Drv hw w h bufs layers cur ap ls))))

; List lw written into its half and the channel pointed at it, which it
; takes from its next frame; an alarm set on the ends of frame's port
; for due, so that a list never taken is noticed (overdue_checked): 0.
(def list_pointed ((v Drv) (lw ListWrite) (due int)) int
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match hw
        ((Hw d g mmu cache t tva addrs fr)
          (match lw
            ((ListWrite k l)
              (let wr (words_written d (dlist_half_start k) (listed_words l))
                (let lp (device_read32 d (disp_lptrs g (hdmi0_channel)))
                  (let pw (device_write32 d (disp_lptrs g (hdmi0_channel)) (lptrs_with_head lp (dlist_half_start k)))
                    (let port (frames_port fr)
                      (if (lt port 0) 0 (let a (alarm_at port due) 0)))))))))))))

; The pages at each of vas unmapped from the aperture and given up.
(def pages_given_up ((v Drv) (vas (list int))) Drv
  (if (is_empty vas)
      v
      (match v
        ((Drv hw w h bufs layers cur ap lists)
          (pages_given_up (Drv hw w h bufs layers cur (unmapped hw ap (head vas)) lists) (tail vas))))))

; The pages at va unmapped from the aperture and given up: the aperture
; without them.
(def unmapped ((hw Hw) (ap Aperture) (va int)) Aperture
  (match (aperture_mapped ap va)
    ((None) ap)
    ((Some m)
      (match m
        ((Mapped first n)
          (let c (ptes_cleared hw first n 0)
            (let u (shm_unmap_count va n)
              (aperture_give ap va))))))))

; shape ID TL TR BL BR: the buffer's corners rounded to those radii, its
; pixels there clear, and the screen shown again if it shows the buffer,
; whose planes then have alpha, or no longer.
(def shaped ((v Drv) (id int) (cs Corners)) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match (map_get bufs id)
        ((None) (refused v (append "no buffer " (digits id))))
        ((Some b)
          (match b
            ((Buffer bw bh sd va n addr old)
              (if (corners_fit cs bw bh)
                  (let nv (Drv hw w h (map_put bufs id (Buffer bw bh sd va n addr cs)) layers cur ap lists)
                    (if (in_layers layers id) (shown_as nv layers cur (stamps_of layers bufs)) (served_ok nv)))
                  (refused v "a corner's radius must be from 0 to half the buffer's width and height")))))))))

; --------------------------------------------------------------- showing

; layers ID X Y TOP ...: the screen shown from new layers, the
; wallpaper under them until one covers the screen, when it leaves. The
; buffers a list leaves out are released once it is shown (shown_as).
(def stacked ((v Drv) (ls (list Layer))) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (wall_gone (shown_as v (wall_under ls (wall_kept ls bufs w h)) cur (stamps_of layers bufs))))))

; The driver's layers.
(def drv_layers ((v Drv)) (list Layer) (match v ((Drv hw w h bufs layers cur ap lists) layers)))

; The screen shown as layers ls and pointer cur: the corners cut as they
; show, where stamps had cut them before (corners.l0), then their planes
; made a list, kept clear of the UPM of the list it will be written
; beside, and the request answered at once: the list written and the
; channel pointed at it now if the last list pointed at has been taken,
; else kept as the screen wanted and written at the end of frame that
; shows that one taken (list_shown). If they cannot be one list beside
; it, refused, and the screen and its corners left as they were.
(def shown_as ((v Drv) (ls (list Layer)) (cur Cursor) (stamps (list Stamp))) (Served Drv)
  (match v
    ((Drv hw w h bufs layers old ap lists)
      (match (screen_planes w h ls bufs cur (lists_allocs lists))
        ((Unplannable why) (refused v why))
        ((Planned ps nal)
          (match hw
            ((Hw d g mmu cache t tva addrs fr)
              (let ws (let r (restamped stamps (stamps_of ls bufs)) (list_words g ps))
                (let v2 (list_shown (Drv hw w h bufs ls cur ap lists) (Listed ws nal ls (screen_vas ls cur bufs)))
                  (let he (handle_error_said d ps)
                    (served_ok v2)))))))))))

; List s, the screen asked, shown. With the channel the driver's and
; ends of frame to wait by, at once if nothing is pointed at or what is
; has been taken (DL names it), else at the end of frame that shows it
; taken (pending.l0's lists_asked). Otherwise, as before it, written and
; waited for until the channel fetches it (shown_synced).
(def list_shown ((v Drv) (s Listed)) Drv
  (if (lists_waited v)
      (shown_synced v s)
      (let taken (pending_taken v 0)
        (let st (drv_status v)
          (stepped v (lists_asked (drv_lists v) s taken (frames_now (drv_frames v) st) (clock_ns)))))))

; Whether lists are written and waited for as they come: the firmware
; keeps the channel, or there are no ends of frame to wait by.
(def lists_waited ((v Drv)) bool
  (if (lists_synced_only (drv_lists v)) true (lt (frames_port (drv_frames v)) 0)))

; List s written and waited for until the channel fetches it: over the
; firmware's lists if it keeps the channel, else in the half the channel
; is not fetching, the channel moved to it, and, if it does not take it,
; over the firmware's lists (list_switched). No list but it is read
; after, so it is noted shown a frame on and releases what the one
; before showed, and pages forgotten are given up (lists_synced).
(def shown_synced ((v Drv) (s Listed)) Drv
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match hw
        ((Hw d g mmu cache t tva addrs fr)
          (let ws (listed_words s)
            (if (lists_synced_only lists)
                (synced_kept v (fw_lists_written fr d g ws) -1 s)
                (let k (lists_other lists)
                  (let wr (words_written d (dlist_half_start k) ws)
                    (match (list_switched fr d g (dlist_half_start k) ws)
                      ((TakenBy ok f) (synced_kept v f (if ok k -1) s))))))))))))

; The driver with ends of frame f after list s was written and waited
; for in half k, -1 for the firmware's lists.
(def synced_kept ((v Drv) (f Frames) (k int) (s Listed)) Drv
  (let v2 (frames_kept v f)
    (stepped v2 (lists_synced (drv_lists v2) k s (bufs_vas (drv_bufs v2))))))

; Whether the channel has taken the list pointed at, if one is: DL names
; it, read now and up to n more times a millisecond apart.
(def pending_taken ((v Drv) (n int)) bool
  (match (lists_pending (drv_lists v))
    ((None) false)
    ((Some p)
      (match v
        ((Drv hw w h bufs layers cur ap lists)
          (match hw
            ((Hw d g mmu cache t tva addrs fr) (list_taken d g (dlist_half_start (lists_other lists)) n))))))))

; An end of frame, as a message m on the ends of frame's port: counted,
; and what it showed told (frames.l0's frames_taken); then the list
; pointed at, if the channel takes it now or within 2 ms, taken, and
; the screen wanted written; the pages no list reads given up; and if
; the list pointed at should have been taken by now and is not, the
; channel taken to be the firmware's (lists_fallen). An alarm is a
; list's time up, if it is (overdue_checked); anything else nothing.
(def eof_served ((v Drv) (m Message)) Drv
  (if (is_irq_notice m (disp_intr_irq))
      (let v2 (frames_kept v (frames_taken (drv_frames v) (drv_status v)))
        (if (lists_synced_only (drv_lists v2))
            v2
            (let taken (pending_taken v2 2)
              (let v3 (stepped v2 (lists_ended (drv_lists v2) taken (frames_count (drv_frames v2)) (clock_ns) (bufs_vas (drv_bufs v2))))
                (overdue_checked v3)))))
      (if (is_alarm_notice m) (overdue_checked v) v)))

; If the list pointed at should have been taken by now, the driver after
; lists_fallen; else as it is.
(def overdue_checked ((v Drv)) Drv
  (if (lists_overdue (drv_lists v) (clock_ns)) (lists_fallen v) v))

; A list pointed at 50 ms ago and not seen taken: said once (frames.l0's
; frames_unanswered), and the channel read once more. If it has taken
; the list, taken; if not, the firmware keeps the channel, as roadmap
; 0005 found, and the latest screen asked is written over its lists,
; and every list after it (shown_synced).
(def lists_fallen ((v Drv)) Drv
  (let v2 (frames_kept v (frames_unanswered (drv_frames v)))
    (let taken (pending_taken v2 0)
      (let st (drv_status v2)
      (if taken
          (stepped v2 (lists_took (drv_lists v2) true (frames_now (drv_frames v2) st) (clock_ns)))
          (match v2
            ((Drv hw w h bufs layers cur ap lists)
              (match hw
                ((Hw d g mmu cache t tva addrs fr)
                  (let b (warn_as "hvs" (untaken_line (dlist_half_start (lists_other lists))
                                                       (device_read32 d (disp_lptrs g (hdmi0_channel)))
                                                       (device_read32 d (disp_dl g (hdmi0_channel)))
                                                       st))
                    (let s (lists_latest lists)
                      (synced_kept v2 (fw_lists_written fr d g (listed_words s)) -1 s))))))))))))

; ws written into the list memory from word i: 0.
(def words_written ((d IoDevice) (i int) (ws (list int))) int
  (if (is_empty ws)
      0
      (let w (device_write32 d (dlist_word_offset i) (head ws))
        (words_written d (add i 1) (tail ws)))))

; HDMI0's channel pointed at the list ws, written from word start, and
; waited for until it fetches it, as it does from its next frame, by the
; ends of frame f (taken_by), up to 50 ms: whether it did, and f after.
; If it did not, the firmware has the channel: ws is written over its
; lists (fw_lists_written), and said.
(def list_switched ((f Frames) (d IoDevice) (g HvsGen) (start int) (ws (list int))) TakenBy
  (let l (device_read32 d (disp_lptrs g (hdmi0_channel)))
    (let w (device_write32 d (disp_lptrs g (hdmi0_channel)) (lptrs_with_head l start))
      (match (taken_by f d g start)
        ((TakenBy ok f2)
          (if ok
              (TakenBy true f2)
              (let a (fw_lists_written f2 d g ws)
                (let b (warn_as "hvs" (untaken_line start (device_read32 d (disp_lptrs g (hdmi0_channel)))
                                                      (device_read32 d (disp_dl g (hdmi0_channel)))
                                                      (device_read32 d (disp_status g (hdmi0_channel)))))
                  (TakenBy false a)))))))))

; The firmware's two lists, at words 32 and 672 of the list memory. Once
; it has set a mode by SET_TIMING it moves the channel to one or the
; other every frame, however often the driver moves it to its own (a
; board run), but never rewrites them; so the driver writes its list
; over both, and the screen is the driver's all the same.
(def fw_list_a () int 32)
(def fw_list_b () int 672)

; ws written over both of the firmware's lists, never the one the
; channel is fetching: the HVS reads a list through its frame, so a list
; rewritten under it shows half of each, and the planes whose UPM moved
; garbled (white columns, on a board).
; So the list the channel is not on first, then, once the firmware has
; moved the channel to it, waited for by the ends of frame f up to 50 ms
; on, the other: f after.
(def fw_lists_written ((f Frames) (d IoDevice) (g HvsGen) (ws (list int))) Frames
  (let live (dl_active (device_read32 d (disp_dl g (hdmi0_channel))))
    (let first (if (eq live (fw_list_b)) (fw_list_a) (fw_list_b))
      (let a (words_written d first ws)
        (match (taken_by f d g first)
          ((TakenBy ok f2)
            (let b (words_written d (if (eq first (fw_list_a)) (fw_list_b) (fw_list_a)) ws) f2)))))))

; What the driver says of a list the channel has not taken from word
; start: what LPTRS, DL and STATUS read then, to tell whether another
; has moved the channel to a list of its own, or the channel has stalled.
(def untaken_line ((start int) (lp int) (dl int) (st int)) (list int)
  (append "HDMI0's channel has not taken its new list at word "
    (append (digits start)
      (append ": LPTRS 0x"
        (append (hex_digits lp 8)
          (append ", DL 0x" (append (hex_digits dl 8) (append ", STATUS 0x" (append (hex_digits st 8)
            "; the firmware keeps it, so the driver's lists are written over the firmware's")))))))))

; Whether the channel fetches the list from word start, read up to n
; more times, a millisecond apart.
(def list_taken((d IoDevice) (g HvsGen) (start int) (n int)) bool
  (if (eq (dl_active (device_read32 d (disp_dl g (hdmi0_channel)))) start)
      true
      (if (le n 0) false (let s (sleep_ns 1000000) (list_taken d g start (sub n 1))))))

; damage ID X Y W H ...: the HVS reads the buffers every frame, so each
; damaged rectangle's rows need only be cleaned out of the caches, for it
; to read what the client wrote, once the corners it drew over are cut
; again. Nothing more is shown; the change is noted, shown two frames
; on (shown.l0's damage_frames).
(def damaged ((v Drv) (ns (list int))) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (if (is_empty ns)
          (served_ok (frames_kept v (frames_changed (drv_frames v) (damage_frames))))
          (match (map_get bufs (head ns))
            ((None) (refused v (append "no buffer " (digits (head ns)))))
            ((Some b)
              (let s (damage_restamped (stamps_of layers bufs) (head ns) (nth ns 2) (nth ns 4))
                (let c (rows_cleaned b (nth ns 2) (nth ns 4))
                  (damaged v (drop_n ns 5))))))))))

; Rows y up to y + n of b cleaned, those it has: 0.
(def rows_cleaned ((b Buffer) (y int) (n int)) int
  (match b
    ((Buffer bw bh sd va pages addr cs)
      (let y0 (max y 0)
        (let y1 (min (add y n) bh)
          (if (le y1 y0)
              0
              (let p0 (div (mul (mul y0 sd) 4) (page_size))
                (let p1 (min (ceil_div (mul (mul y1 sd) 4) (page_size)) pages)
                  (dma_synced (add va (mul p0 (page_size))) (sub p1 p0))))))))))

; ---------------------------------------------------------------- pointer

; cursor ID HX HY: the pointer's image, 64 by 64, a plane on top, its
; pages cleaned out of the caches first: wm paints a new shape into the
; same buffer and then asks, and the HVS, which does not see the caches,
; showed the rows already written back beside the old ones, torn, until
; the rest were (a board run, at each change to a resize pointer).
(def pointer_image ((v Drv) (id int) (hx int) (hy int)) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match (map_get bufs id)
        ((None) (refused v (append "no buffer " (digits id))))
        ((Some b)
          (match b
            ((Buffer bw bh sd va n addr cs)
              (if (not (if (eq bw 64) (eq bh 64) false))
                  (refused v "a cursor is 64 by 64")
                  (let c (dma_synced va n)
                    (match cur
                      ((Cursor old px py ohx ohy) (shown_as v layers (Cursor id px py hx hy) (stamps_of layers bufs)))))))))))))

; move X Y: the pointer there, the list written again with its plane
; moved.
(def moved ((v Drv) (x int) (y int)) (Served Drv)
  (match v
    ((Drv hw w h bufs layers cur ap lists)
      (match cur
        ((Cursor id px py hx hy)
          (if (lt id 0)
              (served_ok (Drv hw w h bufs layers (Cursor id x y hx hy) ap lists))
              (shown_as v layers (Cursor id x y hx hy) (stamps_of layers bufs))))))))
