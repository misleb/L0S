; modeset_test.l0 -- tests of the mode set's words, against what stage
; hdmi read on a board of the firmware's 1080p, and Linux's for 4K.

; CEA 1080p: 148.5 MHz, 1920 active, 280 blanking, 88 front porch, 44
; sync; 1080 lines, 45 blanking, 4 and 5; digital separate sync, both
; positive (0x1E).
(def p1080 () Dtd (Dtd 148500 1920 280 88 44 1080 45 4 5 30))

; CEA 2160p30: 297 MHz, 3840 active, 560 blanking, 176 and 88; 2160
; lines, 90 blanking, 8 and 10.
(def p2160 () Dtd (Dtd 297000 3840 560 176 88 2160 90 8 10 30))

; The core's HORZA and HORZB as the firmware wrote them: 0x0058c780,
; 0x0094002c.
(def test_core_horz_1080 () int
  (add (check_str "horza" (hex8 (core_horza_of (p1080))) "0058c780")
       (check_str "horzb" (hex8 (core_horzb_of (p1080))) "0094002c")))

; VERTA as Linux writes it, front porch 4: the firmware's reads 0 there.
; VERTB0 the back porch, 36, as the firmware's.
(def test_core_vert_1080 () int
  (add (check_str "verta" (hex8 (core_verta_of (p1080))) "05040438")
       (check_str "vertb0" (hex8 (core_vertb0_of (p1080))) "00000024")))

; Pixel valve 0's at two pixels a clock, as the firmware wrote them.
(def test_pv_1080 () int
  (add (check_str "horza" (hex8 (pv_horza_of (p1080))) "004a0016")
       (add (check_str "horzb" (hex8 (pv_horzb_of (p1080))) "002c03c0")
            (add (check_str "verta" (hex8 (pv_verta_of (p1080))) "00240005")
                 (check_str "vertb" (hex8 (pv_vertb_of (p1080))) "00040438")))))

; A PHY rate as its five words.
(def phy_text ((r PhyRate)) (list int)
  (match r
    ((PhyRate ctl ck rm vd ws)
      (join_with " " (cons (hex8 ctl) (cons (hex8 ck) (cons (hex8 rm) (cons (hex8 vd) (cons (digits ws) (nil (list int)))))))))))

; 148.5 MHz as the firmware set the PHY.
(def test_phy_148 () int
  (check_str "148.5" (phy_text (phy_rate 148500)) "80828700 80828700 98100000 00000407 0"))

; 297 and 594 MHz from Linux's tables: dividers 3 and 2.
(def test_phy_297_594 () int
  (add (check_str "297" (phy_text (phy_rate 297000)) "c0870000 c0870800 94a00000 00000403 0")
       (check_str "594" (phy_text (phy_rate 594000)) "848f8700 849f8f00 9b800000 00000402 3")))

; 2160p30's words: the channel 3840 by 2160, as the firmware's SET_TIMING
; left it (0x8eff086f); the core's and pixel valve's.
(def test_2160 () int
  (add (check_str "ctrl0" (hex8 (ctrl0_for 3840 2160)) "8eff086f")
       (add (check_str "horza" (hex8 (core_horza_of (p2160))) "00b0cf00")
            (check_str "pv horzb" (hex8 (pv_horzb_of (p2160))) "00580780"))))

; VERTB1 has VSPO, half of 4400, 2200, over the back porch 72.
(def test_vertb1 () int
  (check_str "vertb1" (hex8 (core_vertb1_of (p2160))) "08980048"))
