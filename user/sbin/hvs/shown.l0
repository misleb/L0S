; shown.l0 -- which frame showed each change, purely: the frames counted,
; filled out by STATUS's own 6-bit count where the driver missed some,
; and each change (a list switched, a damage's clean) noted with the
; frame it is pending for, then marked shown at that frame's end. The
; latest change shown is what roadmap 0006's notices will read.

; A change pending: its number, and the frame at whose end it is shown.
(data Pend (Pend int int))

; The changes: the next one's number, those pending, oldest first, and
; the latest shown, 0 for none yet.
;
; Then, for roadmap 0006's notices, the buffers each change releases,
; those a list switched to leaves out, and how many frames that showed
; a change have been told.
(data Changes (Changes int (list Pend) int (list Rel) int))

; The buffers change k releases once it is shown.
(data Rel (Rel int (list int)))

; No change yet; the first is 1.
(def changes_new () Changes (Changes 1 (nil Pend) 0 (nil Rel) 0))

; The frame count n carried on to STATUS's 6-bit count fr, read at the
; end of a frame: as many frames past n as fr is past n's low six bits,
; so up to 63 frames the driver missed are counted, and none lost.
(def frame_extended ((n int) (fr int)) int
  (add n (mod (add (sub (bit_and fr 63) (bit_and n 63)) 64) 64)))

; Frames after the count at which a list was taken until it is shown
; whole: the channel fetches it from the next frame on, so that frame's
; end.
(def list_frames () int 1)

; Frames after the count at which a damage's rows were cleaned until
; they are shown whole: the frame being fetched may have read some rows
; before, so the one after it.
(def damage_frames () int 2)

; c with a change noted at frame count n, shown at the end of frame n
; plus after: its number is c's next.
(def change_noted ((c Changes) (n int) (after int)) Changes
  (match c
    ((Changes next ps latest rs told)
      (Changes (add next 1) (append ps (cons (Pend next (add n after)) (nil Pend))) latest rs told))))

; c with the buffers ids released by the last change noted, once it is
; shown, as a list switched to that leaves them out releases them.
(def changes_releasing ((c Changes) (ids (list int))) Changes
  (match c
    ((Changes next ps latest rs told)
      (if (if (is_empty ids) true (eq next 1))
          c
          (Changes next ps latest (cons (Rel (sub next 1) ids) rs) told)))))

; What the end of a frame showed: c after it (changes_at), the frame's
; number among those that showed a change, from 1, or 0 if it showed
; none, and the buffers its changes released, in the order noted.
(data Shown (Shown Changes int (list int)))

; c at the end of frame n, as changes_at, and what it showed.
(def changes_shown ((c Changes) (n int)) Shown
  (match c
    ((Changes next ps latest rs told)
      (let due (pends_due ps n (nil int))
        (if (is_empty due)
            (Shown c 0 (nil int))
            (Shown (Changes next (pends_after ps n) (pends_latest ps n latest) (rels_not rs due (nil Rel)) (add told 1))
                   (add told 1)
                   (rels_of (rev rs) due (nil int))))))))

; The numbers of ps shown by frame n, onto acc.
(def pends_due ((ps (list Pend)) (n int) (acc (list int))) (list int)
  (if (is_empty ps)
      acc
      (match (head ps) ((Pend k f) (pends_due (tail ps) n (if (le f n) (cons k acc) acc))))))

; The buffers rs releases for the changes ks, in rs's order, onto acc
; reversed: each once.
(def rels_of ((rs (list Rel)) (ks (list int)) (acc (list int))) (list int)
  (if (is_empty rs)
      (rev acc)
      (match (head rs)
        ((Rel k ids) (rels_of (tail rs) ks (if (any_eq k ks) (ids_onto ids acc) acc))))))

; ids onto acc, but those it has.
(def ids_onto ((ids (list int)) (acc (list int))) (list int)
  (if (is_empty ids) acc (ids_onto (tail ids) (if (any_eq (head ids) acc) acc (cons (head ids) acc)))))

; rs without the releases of the changes ks, onto acc reversed.
(def rels_not ((rs (list Rel)) (ks (list int)) (acc (list Rel))) (list Rel)
  (if (is_empty rs)
      (rev acc)
      (match (head rs) ((Rel k ids) (rels_not (tail rs) ks (if (any_eq k ks) acc (cons (head rs) acc)))))))

; c at the end of frame n: every change pending for n or before shown,
; the latest of them kept.
(def changes_at ((c Changes) (n int)) Changes
  (match c
    ((Changes next ps latest rs told)
      (Changes next (pends_after ps n) (pends_latest ps n latest) rs told))))

; Those of ps still pending after frame n.
(def pends_after ((ps (list Pend)) (n int)) (list Pend)
  (if (is_empty ps)
      ps
      (match (head ps)
        ((Pend k f)
          (if (le f n) (pends_after (tail ps) n) (cons (head ps) (pends_after (tail ps) n)))))))

; The latest of ps shown by frame n, or latest if none is later.
(def pends_latest ((ps (list Pend)) (n int) (latest int)) int
  (if (is_empty ps)
      latest
      (match (head ps)
        ((Pend k f)
          (pends_latest (tail ps) n (if (le f n) (max latest k) latest))))))

; The latest change shown.
(def changes_latest ((c Changes) ) int (match c ((Changes next ps latest rs told) latest)))

; How many changes are pending.
(def changes_pending ((c Changes)) int (match c ((Changes next ps latest rs told) (length ps))))

; The last change noted, 0 for none.
(def changes_last ((c Changes)) int (match c ((Changes next ps latest rs told) (sub next 1))))
