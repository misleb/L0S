; regs_test.l0 -- tests of the HVS's register map.

; ------------------------------------------------------------ the layouts

(def gen_text ((g (Option HvsGen))) (list int)
  (match g ((None) "none") ((Some x) (hvs_gen_name x))))

(def test_gen_of () int
  (add (check_str "0x53" (gen_text (hvs_gen_of 83)) "C0")
       (add (check_str "0x54" (gen_text (hvs_gen_of 84)) "D0")
            (check_str "0x55" (gen_text (hvs_gen_of 85)) "none"))))

; Only the low byte says: 0x1253 is C0.
(def test_gen_low_byte () int
  (check_str "0x1253" (gen_text (hvs_gen_of 4691)) "C0"))

; ------------------------------------------------------------- channels

; C0: channel 0 from 0x30, LPTRS at 0x3C, STATUS 0x44, DL 0x48; channel 1
; 0x20 on.
(def test_c0_channels () int
  (add (check_int "lptrs" (disp_lptrs (HvsC0) 0) 60)
       (add (check_int "status" (disp_status (HvsC0) 0) 68)
            (check_int "channel 1's dl" (disp_dl (HvsC0) 1) 104))))

; D0: channel 0 from 0x100, LPTRS at 0x110, STATUS 0x118, DL 0x11C;
; channel 1 0x40 on.
(def test_d0_channels () int
  (add (check_int "lptrs" (disp_lptrs (HvsD0) 0) 272)
       (add (check_int "status" (disp_status (HvsD0) 0) 280)
            (check_int "channel 1's ctrl0" (disp_ctrl0 (HvsD0) 1) 320))))

(def test_bgnd_and_ctrl1 () int
  (add (check_int "C0 bgnd" (disp_bgnd (HvsC0) 0) 56)
       (check_int "D0 ctrl1" (disp_ctrl1 (HvsD0) 0) 260)))

; --------------------------------------------------------------- fields

; ENB, 1919 in FWIDTH and 1079 in LINES: 1920 by 1080, running.
(def ctrl0_1080p () int (bit_or (bit_shl 1 31) (bit_or (bit_shl 1919 16) 1079)))

(def test_ctrl0 () int
  (add (check_bool "enabled" (ctrl0_enabled (ctrl0_1080p)) true)
       (add (check_int "width" (ctrl0_width (ctrl0_1080p)) 1920)
            (check_int "height" (ctrl0_height (ctrl0_1080p)) 1080))))

(def test_ctrl0_disabled () int
  (check_bool "ENB clear" (ctrl0_enabled (bit_or (bit_shl 1919 16) 1079)) false))

(def test_status_fields () int
  (let w (bit_or (bit_shl 37 16) (bit_shl 2 13))
    (add (check_int "running" (status_mode w) 2)
         (check_int "frame 37" (status_frames w) 37))))

(def test_dl_active () int
  (check_int "the low 12 bits" (dl_active (bit_or (bit_shl 1 20) 2064)) 2064))

; HEADE replaced, the bits above it kept.
(def test_lptrs_with_head () int
  (check_str "head 32" (hex_digits (lptrs_with_head (bit_or (bit_shl 5 12) 4095) 32) 8) "00005020"))

(def test_ctrl1_background () int
  (check_int "BGENB" (ctrl1_with_background 1) 257))

; ------------------------------------------------------- the list memory

(def test_halves () int
  (add (check_int "half 0" (dlist_half_start 0) 32)
       (add (check_int "half 1" (dlist_half_start 1) 2064)
            (check_int "each" (dlist_half_words) 2032))))

(def test_half_of () int
  (add (check_int "the bootloader's" (dlist_half_of 31) -1)
       (add (check_int "half 0" (dlist_half_of 2063) 0)
            (add (check_int "half 1" (dlist_half_of 4095) 1)
                 (check_int "past the end" (dlist_half_of 4096) -1)))))

(def test_word_offset () int
  (check_int "word 32" (dlist_word_offset 32) 16512))
