; frames.l0 -- channel 0's ends of frame, as the serving driver takes
; them: through the display's interrupt controller, disp_intr, and its
; interrupt, 129, bound to a port of the driver's own (regs.l0 has the
; words). The driver counts every frame, and at each sees whether the
; channel took the list it pointed it at (pending.l0), not by polling DL;
; where the board gives neither, it waits for each list by polling, and
; where a frame brings no interrupt within 50 ms, it reads DL once more.

; The ends of frame: the controller, the port its interrupt comes to,
; the frames counted so far, whether a frame that brought none in 50 ms
; has been said, which frame showed each change (shown.l0), and when the
; latest end of frame was taken, by clock_ns, 0 before the first; or
; none, and the driver polls.
; Either way, last, the ports the frames and releases are told to
; (display.l0's frames), and with none, the frames told.
(data Frames (Frames IoDevice int int bool Changes int (list int)) (NoFrames (list int) int))

; The controller opened and its interrupt bound, every line masked and
; cleared but channel 0's, unmasked, said; or none, said, if the board
; gives neither. Only once the HVS answers, as its clock is the HVS's.
(def frames_started () Frames
  (match (open_device (disp_intr_base) (disp_intr_bytes))
    ((DeviceFailed fault why)
      (frames_none (append "the display's interrupt controller is not given: " why)))
    ((DeviceOpened l2)
      (let port (port_new)
        (let why (irq_bind_or_why (disp_intr_irq) port)
          (if (not (is_empty why))
              (frames_none why)
              (let m (device_write32 l2 (l2_mask_set) (l2_all))
                (let c (device_write32 l2 (l2_clear) (l2_all))
                  (let u (device_write32 l2 (l2_mask_clear) (eof_bit 0))
                    (let s (info_as "hvs" "ends of frame by interrupt 129, line 2 of disp_intr")
                      (Frames l2 port 0 false (changes_new) 0 (nil int))))))))))))

; No ends of frame, for why: said, and the driver polls.
(def frames_none ((why (list int))) Frames
  (let s (info_as "hvs" (append "ends of frame polled: " why)) (frames_polled)))

; No ends of frame, no port told yet.
(def frames_polled () Frames (NoFrames (nil int) 0))

; f with port told its frames and releases from now on, once.
(def frames_listening ((f Frames) (port int)) Frames
  (match f
    ((Frames l2 p n said ch last ls) (Frames l2 p n said ch last (if (any_eq port ls) ls (append ls (cons port (nil int))))))
    ((NoFrames ls nt) (NoFrames (if (any_eq port ls) ls (append ls (cons port (nil int)))) nt))))

; Each of rel told to the ports ls as a release, then frame fr, if it
; is one, from 1: the ports still there.
(def shown_told ((ls (list int)) (fr int) (rel (list int))) (list int)
  (if (is_empty rel)
      (if (gt fr 0) (listeners_tell ls (shown_notice fr)) ls)
      (shown_told (listeners_tell ls (release_notice (head rel))) fr (tail rel))))

; The port ends of frame come to, or -1 for none.
(def frames_port ((f Frames)) int
  (match f ((Frames l2 port n said ch last ls) port) ((NoFrames ls nt) -1)))

; The frames counted, 0 with none.
(def frames_count ((f Frames)) int
  (match f ((Frames l2 port n said ch last ls) n) ((NoFrames ls nt) 0)))

; Which frame showed each change, none with no ends of frame.
(def frames_changes ((f Frames)) Changes
  (match f ((Frames l2 port n said ch last ls) ch) ((NoFrames ls nt) (changes_new))))

; An end of frame taken, channel 0's STATUS st read at it: the line
; cleared, then the interrupt ended, and the count carried on to
; STATUS's (frame_extended), so frames passed while the driver was busy
; count too; the changes pending for it shown, and if any were, the
; buffers they released told, then the frame, to the ports frames named
; (roadmap 0006). Every 600th frame, ten seconds at 60 Hz, said at the
; debug level.
(def frames_taken ((f Frames) (st int)) Frames
  (match f
    ((NoFrames ls nt) f)
    ((Frames l2 port n said ch last ls)
      (let c (device_write32 l2 (l2_clear) (eof_bit 0))
        (let k (irq_ack (disp_intr_irq))
          (let n2 (frame_extended n (status_frames st))
            (match (changes_shown ch n2)
              ((Shown ch2 fr rel)
                (let ls2 (shown_told ls fr rel)
                  (let s (if (gt (div n2 600) (div n 600)) (frames_said n2 ch2) 0)
                    (let now (clock_ns)
                      (let gap (frames_gap_said last now n n2)
                        (Frames l2 port n2 said ch2 now ls2)))))))))))))

; A gap of over 100 ms between the end of frame taken at last and this
; one, at now, from frame n to n2, said at the debug level, as more than
; 63 frames in one would go uncounted; none before the first: 0.
(def frames_gap_said ((last int) (now int) (n int) (n2 int)) int
  (if (if (gt last 0) (gt (sub now last) 100000000) false)
      (debug_as "hvs" (append "no end of frame taken for " (append (digits (div (sub now last) 1000000))
        (append " ms, frames " (append (digits n) (append " to " (digits n2)))))))
      0))

; The frames counted and the changes, said at the debug level: 0.
(def frames_said ((n int) (ch Changes)) int
  (debug_as "hvs" (append "frame " (append (digits n)
    (append ": changes shown to " (append (digits (changes_latest ch))
      (append " of " (append (digits (changes_last ch))
        (append ", " (append (digits (changes_pending ch)) " pending"))))))))))

; f with a change noted at its count, shown after more frames
; (list_frames, damage_frames), whose end tells the frame; with no ends
; of frame, a frame told at once.
(def frames_changed ((f Frames) (after int)) Frames
  (match f
    ((NoFrames ls nt) (NoFrames (shown_told ls (add nt 1) (nil int)) (add nt 1)))
    ((Frames l2 port n said ch last ls) (Frames l2 port n said (change_noted ch n after) last ls))))

; f with the buffers rel released by the change last noted: told at the
; end of the frame that shows it, or at once with no ends of frame, as
; the list leaving them out was polled until taken.
(def frames_released ((f Frames) (rel (list int))) Frames
  (match f
    ((NoFrames ls nt) (NoFrames (shown_told ls 0 rel) nt))
    ((Frames l2 port n said ch last ls) (Frames l2 port n said (changes_releasing ch rel) last ls))))

; f with a change noted at the frames counted now, as channel 0's STATUS
; st reads them (frame_extended), so an end of frame not yet taken
; counts too; shown after more frames; with no ends of frame, a frame
; told at once (frames_changed). A list seen taken as a request comes is
; noted so: the channel fetches it in the frame after the count.
(def frames_changed_now ((f Frames) (st int) (after int)) Frames
  (match f
    ((NoFrames ls nt) (frames_changed f after))
    ((Frames l2 port n said ch last ls)
      (Frames l2 port n said (change_noted ch (frame_extended n (status_frames st)) after) last ls))))

; The frames counted now, as channel 0's STATUS st reads them; 0 with
; no ends of frame.
(def frames_now ((f Frames) (st int)) int
  (match f
    ((NoFrames ls nt) 0)
    ((Frames l2 port n said ch last ls) (frame_extended n (status_frames st)))))

; Whether a list was taken, and the ends of frame after the wait.
(data TakenBy (TakenBy bool Frames))

; Whether HDMI0's channel fetches the list from word start, waited for by
; ends of frame up to 50 ms, or with none, polled a millisecond apart as
; long. A frame that brings no interrupt in that time is said once, and
; the channel polled once more.
(def taken_by ((f Frames) (d IoDevice) (g HvsGen) (start int)) TakenBy
  (match f
    ((NoFrames ls nt) (TakenBy (list_taken d g start 50) f))
    ((Frames l2 port n said ch last ls)
      (let due (add (clock_ns) 50000000)
        (let a (alarm_at port due)
          (frames_awaited f d g start due))))))

; taken_by's wait on f's port until due: after each end of frame the
; channel is read, and polled for 2 ms more, as it may take the list
; just after the end of the frame.
(def frames_awaited ((f Frames) (d IoDevice) (g HvsGen) (start int) (due int)) TakenBy
  (let m (port_receive (frames_port f))
    (if (is_irq_notice m (disp_intr_irq))
        (let f2 (frames_taken f (device_read32 d (disp_status g (hdmi0_channel))))
          (if (list_taken d g start 2) (TakenBy true f2) (frames_awaited f2 d g start due)))
        (if (if (is_alarm_notice m) (ge (clock_ns) due) false)
            (TakenBy (list_taken d g start 0) (frames_unanswered f))
            (frames_awaited f d g start due)))))

; A wait that no end of frame answered in 50 ms, said the first time: f
; marked said.
(def frames_unanswered ((f Frames)) Frames
  (match f
    ((NoFrames ls nt) f)
    ((Frames l2 port n said ch last ls)
      (if said
          f
          (let w (warn_as "hvs" "no end of frame in 50 ms: the channel polled instead")
            (Frames l2 port n true ch last ls))))))
