; fw_test.l0 -- tests of the firmware's requests and their replies.

; Six words, 24 bytes: the size, a request, the tag 0x30066 with no
; value, and the end tag.
(def test_display_done_request () int
  (check_bool "words" (eq (display_done_request)
                          (cons 24 (cons 0 (cons 196710 (cons 0 (cons 0 (cons 0 (nil int)))))))) true))

; One word of value: seven words, 28 bytes.
(def test_num_displays_request () int
  (check_bool "words" (eq (num_displays_request)
                          (cons 28 (cons 0 (cons 262163 (cons 4 (cons 0 (cons 0 (cons 0 (nil int))))))))) true))

; DISP's rate: its id and a word for the rate.
(def test_clock_get_request () int
  (check_bool "words" (eq (clock_get_request (tag_get_clock_rate) (fw_clk_disp))
                          (cons 32 (cons 0 (cons 196610 (cons 8 (cons 0 (cons 16 (cons 0 (cons 0 (nil int)))))))))) true))

(def test_clock_set_requests () int
  (add (check_bool "on" (eq (clock_on_request 4)
                            (cons 32 (cons 0 (cons 229377 (cons 8 (cons 0 (cons 4 (cons 1 (cons 0 (nil int)))))))))) true)
       (check_int "rate's size" (head (clock_rate_request 4 500000000)) 36)))

; A reply: the buffer's code 0x80000000, and the tag's bit 31 with the
; 8 bytes it wrote, 0x80000008.
(def answered_reply () (list int)
  (cons 32 (cons 2147483648 (cons 196610 (cons 8 (cons 2147483656 (cons 16 (cons 500000000 (cons 0 (nil int))))))))))

(def test_fw_value () int
  (add (check_bool "rate" (eq (fw_value (answered_reply) 1) (Some 500000000)) true)
       (check_bool "past the end" (eq (fw_value (answered_reply) 3) ((None int))) true)))

; A request the firmware has not answered gives nothing.
(def test_fw_value_unanswered () int
  (check_bool "none" (eq (fw_value (clock_get_request (tag_get_clock_rate) 16) 1) ((None int))) true))

(def test_clock_line () int
  (add (check_str "on" (clock_line 4 (Some 1) (Some 500000000)) "CORE: on, 500000000 Hz")
       (add (check_str "off" (clock_line 16 (Some 0) (Some 0)) "DISP: off, 0 Hz")
            (check_str "none" (clock_line 16 ((None int)) ((None int))) "DISP: state not given, rate not given"))))

(def test_clock_missing () int
  (check_str "missing" (clock_line 9 (Some 2) (Some 0)) "clock 9: no such clock, 0 Hz"))

; Under an operating system there is no mailbox: a warning, 0.
(def test_display_released_none () int
  (check_int "warned" (display_released) 0))
