; corners_test.l0 -- tests of a rounded buffer's corners as the alpha
; bytes the driver writes.

; A stamp of a buffer 30 by 30, its rows 32 pixels apart, at 8192, with
; corners cs and its ring's top row top.
(def stamp_of ((cs Corners) (top int)) Stamp (Stamp 7 8192 4 30 30 32 cs top))

; Each cut row as ROW:LEFT/RIGHT.
(def rows_text ((rs (list CutRow))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((CutRow row l r)
          (append (digits row) (append ":" (append (digits l) (append "/" (append (digits r) (append " " (rows_text (tail rs))))))))))))

; Numbers, each and a space.
(def nums_text ((ns (list int))) (list int)
  (if (is_empty ns) "" (append (digits (head ns)) (append " " (nums_text (tail ns))))))

; ---------------------------------------------------------------- stamps

(def two_bufs () (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer))
    1 (Buffer 30 20 32 4096 1 0 (square)))
    2 (Buffer 30 20 32 8192 1 0 (Corners 3 3 3 3))))

(def test_stamps_of_square () int
  (check_int "none" (length (stamps_of (cons (Layer 1 0 0 0) (nil Layer)) (two_bufs))) 0))

; Its top, 24, is row 4 of 20.
(def test_stamps_of_rounded () int
  (check_bool "one, top 4"
    (eq (stamps_of (cons (Layer 1 0 0 0) (cons (Layer 2 5 5 24) (nil Layer))) (two_bufs))
        (cons (Stamp 2 8192 1 30 20 32 (Corners 3 3 3 3) 4) (nil Stamp)))
    true))

; ------------------------------------------------------------------ rows

; A 12-pixel corner cuts 9 6 5 4 3 2 1 1 1 0 0 0 (render.l0's corner_cut):
; nine rows, from the top.
(def test_rows_top_left_12 () int
  (check_str "nine rows" (rows_text (stamp_rows (stamp_of (Corners 12 0 0 0) 0)))
    "0:9/0 1:6/0 2:5/0 3:4/0 4:3/0 5:2/0 6:1/0 7:1/0 8:1/0 "))

; A 3-pixel corner cuts one pixel of its first row only: a bottom right
; one is the last row's last pixel.
(def test_rows_bottom_right_3 () int
  (check_str "the last row" (rows_text (stamp_rows (stamp_of (Corners 0 0 0 3) 0))) "29:0/1 "))

; Read from row 28, the layer's first row is 28 and its last 27.
(def test_rows_round_the_ring () int
  (check_str "wrapped" (rows_text (stamp_rows (stamp_of (Corners 3 3 3 3) 28))) "28:1/1 27:1/1 "))

(def test_rows_between () int
  (check_str "rows 1 to 2" (rows_text (rows_between (stamp_rows (stamp_of (Corners 12 0 0 0) 0)) 1 2))
    "1:6/0 2:5/0 "))

; --------------------------------------------------------------- offsets

; Row 2 cut 1 at the left and 2 at the right, rows 32 pixels apart: the
; fourth bytes of pixels 64, 92 and 93, 259, 371 and 375.
(def test_alpha_offsets () int
  (check_str "fourth bytes" (nums_text (alpha_offsets (stamp_of (square) 0) (cons (CutRow 2 1 2) (nil CutRow))))
    "259 371 375 "))

; Rows of 1024 pixels are a page each: rows 0, 1 and 29 are pages 0 and
; 1, a run of two, and 29.
(def test_rows_pages () int
  (let s (Stamp 7 0 30 1024 30 1024 (square) 0)
    (check_str "two runs"
      (runs_text (page_runs (rows_pages s (cons (CutRow 29 1 0) (cons (CutRow 1 1 0) (cons (CutRow 0 2 0) (nil CutRow))))) (nil PageRun)))
      "0+2 29+1 ")))

; Each run as FIRST+COUNT.
(def runs_text ((rs (list PageRun))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs) ((PageRun p n) (append (digits p) (append "+" (append (digits n) (append " " (runs_text (tail rs))))))))))

; A row 30 pixels wide that starts 8 bytes before a page's end is in it
; and the next.
(def test_row_across_pages () int
  (let s (Stamp 7 0 2 30 2 1022 (square) 0)
    (check_str "both" (nums_text (rows_pages s (cons (CutRow 1 1 0) (nil CutRow)))) "0 1 ")))

; ------------------------------------------------------------- restamping

(def stamp_a () Stamp (Stamp 1 4096 1 30 20 32 (Corners 3 3 3 3) 0))
(def stamp_b () Stamp (Stamp 2 8192 1 30 20 32 (Corners 3 3 3 3) 0))
(def stamp_b2 () Stamp (Stamp 3 8192 1 30 20 32 (Corners 3 3 3 3) 0))

(def test_not_in () int
  (check_int "a is gone" (length (stamps_not_in (cons (stamp_a) (cons (stamp_b) (nil Stamp))) (cons (stamp_b) (nil Stamp)))) 1))

; Only what is new is cut again, unless one put back was in its pages.
(def test_cut_again_new_only () int
  (check_int "b2 only"
    (length (stamps_cut_again (cons (stamp_a) (cons (stamp_b2) (nil Stamp))) (cons (stamp_a) (nil Stamp)) (nil int))) 1))

(def test_cut_again_same_pages () int
  (check_int "a, in the pages put back"
    (length (stamps_cut_again (cons (stamp_a) (cons (stamp_b2) (nil Stamp))) (cons (stamp_a) (cons (stamp_b2) (nil Stamp))) (cons 4096 (nil int))))
    1))

; Under an operating system there is no buffer to open; the same stamps
; are no work.
(def test_restamped_same () int
  (check_int "nothing" (restamped (cons (stamp_a) (nil Stamp)) (cons (stamp_a) (nil Stamp))) 0))
