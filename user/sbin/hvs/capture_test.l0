; capture_test.l0 -- hvs's buffers as a capture reads them: each its
; size, stride, pages and corners, under its id.

; A buffer of 640 by 400, rows 700 apart, 300 pages at 0x1000, rounded.
(def test_cap_bufs () int
  (let m (cap_bufs (cons 5 (nil int)) (cons (Buffer 640 400 700 4096 300 0 (Corners 12 12 0 0)) (nil Buffer)) ((MapEmpty int CapBuf)))
    (match (map_get m 5)
      ((None) (fail_because "buffer 5" "missing"))
      ((Some b)
        (add (check_str "size" (unwords (numbers_words (cons (.bw b) (cons (.bh b) (cons (.sd b) (nil int)))))) "640 400 700")
             (add (check_str "pages" (unwords (numbers_words (cons (.va b) (cons (.pages b) (nil int))))) "4096 300")
                  (check_true "corners" (eq (.cs b) (Corners 12 12 0 0)))))))))
