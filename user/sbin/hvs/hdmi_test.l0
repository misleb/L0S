; hdmi_test.l0 -- tests of HDMI0's register map and what stage hdmi says.

; Each register as NAME@OFFSET in hex.
(def regs_text ((rs (list NamedReg))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((NamedReg name off) (append name (append "@" (append (hex_digits off 1) (append " " (regs_text (tail rs))))))))))

; The core's from 0x1400: FIFO_CTL at 0x147c, HORZA at 0x14ec,
; SCRAMBLER_CTL at 0x15e4.
(def test_core_regs () int
  (add (check_int "fifteen" (length (core_regs)) 15)
       (check_str "first three" (regs_text (take (core_regs) 3)) "FIFO_CTL@147c RAM_PACKET_CONFIG@14c4 SCHEDULER_CONTROL@14e8 ")))

; The PHY's from 0x1D00, its PLL's reset and power at 0x1e90 and 0x1e94.
(def test_phy_regs () int
  (add (check_int "twenty-two" (length (phy_regs)) 22)
       (check_str "last two" (regs_text (drop (phy_regs) 20)) "PLL_RESET_CTL@1e90 PLL_POWERUP_CTL@1e94 ")))

; Every register of the run lies inside its 0x4800 bytes.
(def test_blocks_inside () int
  (check_bool "inside" (all_below (blocks_regs) (hdmi_blocks_bytes)) true))

; Whether every register of rs is a word below n.
(def all_below ((rs (list NamedReg)) (n int)) bool
  (if (is_empty rs)
      true
      (match (head rs) ((NamedReg name off) (if (le (add off 4) n) (all_below (tail rs) n) false)))))

; Pixel valve 0's HORZB and VERTB, and DDC0's registers within 0x58.
(def test_pv_and_ddc () int
  (add (check_str "pv" (regs_text (take (drop (pv_regs) 4) 3)) "PV_HORZB@10 PV_VERTA@14 PV_VERTB@18 ")
       (check_bool "ddc inside" (all_below (ddc_regs) (ddc_bytes)) true)))

; 1080p as the firmware sets it: the core's HORZA with its sync flags in
; bits 15 and 14 and the front porch 88 in 28 to 16 over 1920,
; 0x0058C780; VERTA0 with sync 5 in 28 to 24 and front porch 4 in 22 to
; 16 over 1080, 0x05040438; the pixel valve's HFP 88 over 1920 and VFP
; 4 over 1080.
(def test_timings_line () int
  (check_str "1080p" (timings_line 5818240 84149304 5769088 263224)
    "HDMI0's mode: the core says 1920x1080, pixel valve 0 says 1920x1080"))

; Under an operating system there is no HDMI0.
(def test_hdmi_open_none () int
  (match (hdmi_open)
    ((HdmiOpen hm) (fail_because "open" "opened"))
    ((NoHdmi why) (check_bool "said" (not (is_empty why)) true))))
