; plane_test.l0 -- tests of a plane's words and its UPM.

; Linux's own: an opaque XRGB8888 plane's CTL0 is 0x4900C007 on C0 and
; 0x490CC007 on D0, and its CTL2 0x4000FFF0 on C0.
(def test_ctl0_linux () int
  (add (check_str "C0" (hex_digits (plane_ctl0 (HvsC0) false) 8) "4900c007")
       (check_str "D0" (hex_digits (plane_ctl0 (HvsD0) false) 8) "490cc007")))

(def test_ctl2_linux () int
  (check_str "C0 opaque" (hex_digits (plane_ctl2 (HvsC0) false) 8) "4000fff0"))

; The pointer's alpha is its pixels' own: no fixed mode on C0, no mask on
; D0.
(def test_alpha_plane () int
  (add (check_str "C0 ctl2" (hex_digits (plane_ctl2 (HvsC0) true) 8) "0000fff0")
       (check_str "D0 ctl0" (hex_digits (plane_ctl0 (HvsD0) true) 8) "4900c007")))

(def words_text ((ws (list int))) (list int)
  (if (is_empty ws) "" (append (hex_digits (head ws) 8) (append " " (words_text (tail ws))))))

; At 10, 20, 300 by 200, from aperture address 0xA00001000 with rows 1200
; bytes apart; UPM from unit 5, handle 3. POS0 is 20 << 16 | 10, POS2 199
; << 16 | 299; PTR0 5 << 16 | 3 << 10 | 0x0A, the address's top byte.
(def test_plane_words () int
  (check_str "nine words"
    (words_text (plane_words (HvsC0) (Plane 10 20 300 200 42949677056 1200 5 3 false)))
    "4900c007 0014000a 4000fff0 00c7012b c0c0c0c0 00050c0a 00001000 000004b0 80000000 "))

(def test_list_words () int
  (add (check_str "an empty list ends at once" (words_text (list_words (HvsC0) (nil Plane))) "80000000 ")
       (check_int "two planes and its end" (length (list_words (HvsD0) (cons (Plane 0 0 1 1 0 4 0 0 false) (cons (Plane 0 0 1 1 0 4 1 1 true) (nil Plane))))) 19)))

; A plane far off is cut to POS0's 13 bits, never into START_Y.
(def test_pos0_bits () int
  (check_str "13 bits each" (hex_digits (plane_pos0 8192 1) 8) "00010000"))

; ------------------------------------------------------------------ UPM

; 1920 pixels, 7680 bytes: (7742 / 32) * 32 * 2 = 15424 bytes, 61 units
; of 256 rounded up. The 64-pixel pointer: (318 / 32) * 64 = 576, 3.
(def test_upm_for () int
  (add (check_int "a 1080p row" (upm_for 7680) 61)
       (check_int "the pointer's" (upm_for 256) 3)))

(def test_upm_halves () int
  (add (check_int "units" (upm_half_units) 512)
       (check_int "handles" (upm_half_handles) 16)))
