; pieces_test.l0 -- tests of the screen cut into HVS planes.

; A screen 100 by 80 of buffers: 0, the desktop, 100 by 80, from address
; 1000000; 1, a window 30 by 20, its rows 40 pixels apart, from 2000000;
; 2, the pointer, 64 by 64, from 3000000; 3 and 4, strips 1920 by 10.
(def bufs () (Map int Buffer)
  (map_put (map_put (map_put (map_put (map_put (map_put (map_put (map_put ((MapEmpty int Buffer))
    0 (Buffer 100 80 100 0 8 1000000 (square)))
    1 (Buffer 30 20 40 0 1 2000000 (square)))
    2 (Buffer 64 64 64 0 4 3000000 (square)))
    3 (Buffer 1920 10 1920 0 19 4000000 (square)))
    4 (Buffer 1920 10 1920 0 19 5000000 (square)))
    5 (Buffer 1920 10 1920 0 19 6000000 (square)))
    6 (Buffer 3000 10 3000 0 30 7000000 (square)))
    7 (Buffer 3000 10 3000 0 30 8000000 (square))))

(def desktop () Layer (Layer 0 0 0 0))

; Each piece as X,Y WxH @ADDR /PITCH, and a for alpha.
(def pieces_text ((ps (list Piece))) (list int)
  (if (is_empty ps)
      ""
      (match (head ps)
        ((Piece r addr pitch alpha key cover)
          (match r
            ((Rect x y w h)
              (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (append (digits h)
                (append " @" (append (digits addr) (append " /" (append (digits pitch)
                  (append (if alpha "a " " ") (pieces_text (tail ps))))))))))))))))))))

(def shown ((ls (list Layer)) (cur Cursor)) (list int)
  (pieces_text (screen_pieces 100 80 ls (bufs) cur)))

(def two ((a Layer) (b Layer)) (list Layer) (cons a (cons b (nil Layer))))

; ------------------------------------------------------------- placing

(def test_desktop_and_window () int
  (check_str "bottom first" (shown (two (desktop) (Layer 1 10 5 0)) (no_cursor))
    "0,0 100x80 @1000000 /400 10,5 30x20 @2000000 /160 "))

; Off the top left by 5 and 3: the plane starts at the screen's corner,
; its address 3 rows of 40 and 5 pixels on, 4 bytes each: 2000500.
(def test_off_top_left () int
  (check_str "cut into the address" (shown (cons (Layer 1 -5 -3 0) (nil Layer)) (no_cursor))
    "0,0 25x17 @2000500 /160 "))

(def test_off_bottom_right () int
  (check_str "cut short" (shown (cons (Layer 1 90 70 0) (nil Layer)) (no_cursor))
    "90,70 10x10 @2000000 /160 "))

(def test_off_screen () int
  (check_str "none" (shown (cons (Layer 1 200 0 0) (nil Layer)) (no_cursor)) ""))

(def test_unknown_buffer () int
  (check_str "none" (shown (cons (Layer 9 0 0 0) (nil Layer)) (no_cursor)) ""))

; A ring read from row 4: rows 4 to 19 at the layer's top, from 4 rows on,
; 2000640; then rows 0 to 3 under them, at 21.
(def test_ring () int
  (check_str "two pieces" (shown (cons (Layer 1 10 5 4) (nil Layer)) (no_cursor))
    "10,5 30x16 @2000640 /160 10,21 30x4 @2000000 /160 "))

(def test_ring_past_its_height () int
  (check_str "top 24 is row 4" (shown (cons (Layer 1 10 5 24) (nil Layer)) (no_cursor))
    "10,5 30x16 @2000640 /160 10,21 30x4 @2000000 /160 "))

; ------------------------------------------------------------- hiding

(def test_hidden_whole () int
  (check_str "the window under the desktop" (shown (two (Layer 1 10 5 0) (desktop)) (no_cursor))
    "0,0 100x80 @1000000 /400 "))

(def test_partly_hidden () int
  (check_str "both, the desktop showing round the window"
    (shown (two (desktop) (Layer 0 50 0 0)) (no_cursor))
    "0,0 100x80 @1000000 /400 50,0 50x80 @1000000 /400 "))

; The pointer is drawn with alpha, so it hides nothing, and is on top.
(def test_cursor () int
  (check_str "the pointer, its hot spot at 50, 40"
    (shown (cons (desktop) (nil Layer)) (Cursor 2 50 40 3 4))
    "0,0 100x80 @1000000 /400 47,36 53x44 @3000000 /256a "))

(def test_cursor_off_left () int
  (check_str "cut at the left" (shown (nil Layer) (Cursor 2 0 0 3 0))
    "0,0 61x64 @3000012 /256a "))

; ------------------------------------------------------------- budget

; n layers of buffer 1, each a pixel right of the one before, so each
; shows a column.
(def staggered ((n int) (acc (list Layer))) (list Layer)
  (if (eq n 0) acc (staggered (sub n 1) (cons (Layer 1 n 0 0) acc))))

(def planned_text ((p Planned)) (list int)
  (match p
    ((Planned ps as) (append "planes " (digits (length ps))))
    ((Unplannable why) why)))

; Each plane's UPM as KEY:UNIT+UNITS#HANDLE.
(def allocs_text ((as (list Alloc))) (list int)
  (if (is_empty as)
      ""
      (match (head as)
        ((Alloc k u n hd)
          (append (digits k) (append ":" (append (digits u) (append "+" (append (digits n)
            (append "#" (append (digits hd) (append " " (allocs_text (tail as))))))))))))))

; The UPM a screen's planes are given beside the list shown, or why none.
(def planned_allocs ((p Planned)) (list int)
  (match p ((Planned ps as) (allocs_text as)) ((Unplannable why) why)))

; The UPM given layers ls on a screen 100 by 80, beside nothing shown.
(def allocs_of ((ls (list Layer))) (list Alloc)
  (match (screen_planes 100 80 ls (bufs) (no_cursor) (nil Alloc))
    ((Planned ps as) as)
    ((Unplannable why) (nil Alloc))))

; With nothing shown a list has all 32 handles.
(def test_thirty_two_planes () int
  (check_str "the handles"
    (planned_text (screen_planes 100 80 (staggered 32 (nil Layer)) (bufs) (no_cursor) (nil Alloc))) "planes 32"))

(def test_thirty_three_refused () int
  (check_str "one too many"
    (planned_text (screen_planes 100 80 (staggered 33 (nil Layer)) (bufs) (no_cursor) (nil Alloc)))
    "the screen has too many layers for the HVS"))

; n strips 1920 wide, one under the next: each takes 61 units, so 16,
; 976, fit in 1,024, and 17 do not.
(def strips ((n int) (acc (list Layer))) (list Layer)
  (if (eq n 0) acc (strips (sub n 1) (cons (Layer 3 0 (mul 10 (sub n 1)) 0) acc))))

(def test_upm_refused () int
  (add (check_str "sixteen fit"
         (planned_text (screen_planes 1920 200 (strips 16 (nil Layer)) (bufs) (no_cursor) (nil Alloc))) "planes 16")
       (check_str "seventeen do not"
         (planned_text (screen_planes 1920 200 (strips 17 (nil Layer)) (bufs) (no_cursor) (nil Alloc)))
         "the screen's layers are too wide for the HVS's line memory")))

; The desktop, buffer 0 100 wide, takes 4 units (upm_for 400) and the
; window, buffer 1 30 wide, 2 (upm_for 120), each the lowest free, keyed
; by id times 16.
(def test_first_allocs () int
  (check_str "allocs" (allocs_text (allocs_of (two (desktop) (Layer 1 10 5 0)))) "0:0+4#0 16:4+2#1 "))

; The same screen again beside itself keeps every plane's UPM.
(def test_kept () int
  (let shown (allocs_of (two (desktop) (Layer 1 10 5 0)))
    (check_str "kept" (planned_allocs (screen_planes 100 80 (two (desktop) (Layer 1 50 40 0)) (bufs) (no_cursor) shown))
      "0:0+4#0 16:4+2#1 ")))

; A plane not in the list shown keeps clear of all it uses: the strip,
; 1920 wide cut to 100, takes 4 units, from 6, past the desktop's and the
; window's, and handle 2, though the window is gone from the new list.
(def test_fresh_beside_shown () int
  (let shown (allocs_of (two (desktop) (Layer 1 10 5 0)))
    (check_str "fresh" (planned_allocs (screen_planes 100 80 (two (desktop) (Layer 3 0 0 0)) (bufs) (no_cursor) shown))
      "0:0+4#0 48:6+4#2 ")))

; A list that only fits once the list shown's UPM is free is refused:
; nine strips shown, 549 units, then nine of buffer 6, 3000 wide, 94
; units each, which cannot take over the strips' 61 (pieces_planes):
; 846 more, where 475 are free.
(def test_refused_beside_shown () int
  (let shown (match (screen_planes 3840 200 (strips 9 (nil Layer)) (bufs) (no_cursor) (nil Alloc))
               ((Planned ps as) as) ((Unplannable why) (nil Alloc)))
    (check_str "refused" (planned_text (screen_planes 3840 200 (strips_of 6 9 0 (nil Layer)) (bufs) (no_cursor) shown))
      "the screen's layers are too wide for the HVS's line memory")))

; Nine others as wide, keyed apart, take over the nine's units, as a
; window's other buffer does.
(def test_taken_over_beside_shown () int
  (let shown (match (screen_planes 1920 200 (strips 9 (nil Layer)) (bufs) (no_cursor) (nil Alloc))
               ((Planned ps as) as) ((Unplannable why) (nil Alloc)))
    (check_str "taken over" (planned_text (screen_planes 1920 200 (moved_strips 9 (nil Layer)) (bufs) (no_cursor) shown))
      "planes 9")))

; A screen's fit as "planes N, M left out", or why none.
(def fit_text ((f Fit)) (list int)
  (match f
    ((Fit p n) (append (planned_text p) (append ", " (append (digits n) " left out"))))))

; Seventeen strips fit once the lowest is left out: sixteen, 976 units.
(def test_fit_leaves_lowest () int
  (check_str "sixteen of seventeen"
    (fit_text (screen_fit 1920 200 (strips 17 (nil Layer)) (bufs) (no_cursor) (nil Alloc)))
    "planes 16, 1 left out"))

; A screen that fits leaves none out.
(def test_fit_whole () int
  (check_str "all"
    (fit_text (screen_fit 1920 200 (strips 16 (nil Layer)) (bufs) (no_cursor) (nil Alloc)))
    "planes 16, 0 left out"))

; Beside nine strips shown, 549 units, nine of buffer 6's, 94 units each,
; fit only as five: six would take 564 more where 475 are free; five
; take 470.
(def test_fit_beside_shown () int
  (let shown (match (screen_planes 3840 200 (strips 9 (nil Layer)) (bufs) (no_cursor) (nil Alloc))
               ((Planned ps as) as) ((Unplannable why) (nil Alloc)))
    (check_str "five of nine"
      (fit_text (screen_fit 3840 200 (strips_of 6 9 0 (nil Layer)) (bufs) (no_cursor) shown))
      "planes 5, 4 left out")))

; n strips of buffer 4, keyed apart from buffer 3's, from y0 on, 10
; apart: as a window dragged in beside those shown.
(def strips_at ((n int) (y0 int) (acc (list Layer))) (list Layer)
  (if (eq n 0) acc (strips_at (sub n 1) y0 (cons (Layer 4 0 (add y0 (mul 10 (sub n 1))) 0) acc))))

; The flicker the Pi 5 showed: nine strips shown, 549 units, and a
; screen of those nine, there still and as wide, under nine new ones at
; 100 on. The nine kept take only the list shown's units, so leaving
; them out frees nothing: what is left out is the two lowest of the new
; nine, 7 new beside 549 fitting in the 1,024, and the nine shown stay.
; Left out from the bottom, the nine and two of the new went, the
; screen all but blank every other frame.
(def test_fit_leaves_what_moved () int
  (let shown (match (screen_planes 1920 200 (strips 9 (nil Layer)) (bufs) (no_cursor) (nil Alloc))
               ((Planned ps as) as) ((Unplannable why) (nil Alloc)))
    (check_str "the nine kept, seven new"
      (fit_text (screen_fit 1920 200 (append (strips 9 (nil Layer)) (strips_at 9 100 (nil Layer))) (bufs) (no_cursor) shown))
      "planes 16, 2 left out")))

; n strips of buffer id from y0 on, 10 apart.
(def strips_of ((id int) (n int) (y0 int) (acc (list Layer))) (list Layer)
  (if (eq n 0) acc (strips_of id (sub n 1) y0 (cons (Layer id 0 (add y0 (mul 10 (sub n 1))) 0) acc))))

; The UPM of a fit's planes, none if it has none.
(def fit_allocs ((f Fit)) (list Alloc)
  (match f ((Fit p n) (match p ((Planned ps as) as) ((Unplannable why) (nil Alloc))))))

; Shown: nine strips of buffer 3 and a window of seven, buffer 4, 976
; units, 48 free. Then the window's pieces keyed anew, buffer 5, as a
; paced window's other buffer is: beside the list shown its seven would
; need 427 units, but they take over buffer 4's seven, as wide, so the
; first list is all of it, and so is the next.
(def test_fit_settles () int
  (let a (fit_allocs (screen_fit 1920 200 (append (strips 9 (nil Layer)) (strips_of 4 7 100 (nil Layer))) (bufs) (no_cursor) (nil Alloc)))
    (let screen (append (strips 9 (nil Layer)) (strips_of 5 7 100 (nil Layer)))
      (let b (screen_fit 1920 200 screen (bufs) (no_cursor) a)
        (add (check_str "all of it at once" (fit_text b) "planes 16, 0 left out")
             (check_str "and next" (fit_text (screen_fit 1920 200 screen (bufs) (no_cursor) (fit_allocs b))) "planes 16, 0 left out"))))))

; Each plane's UPM of a fit as allocs_text says, top first.
(def fit_upm ((f Fit)) (list int) (allocs_text (rev (fit_allocs f))))

; The Pi 5's flicker: a paced window presents its other buffer, keyed
; anew, each time. Fifteen strips, 915 units, and window 6, 3000 wide,
; 94 units at 0, 15 left free; then its other buffer, 7, as wide, in its
; place, which no 94 free units could hold: it takes over 6's units and
; handle, as Linux keeps a plane's over a page flip, and nothing is left
; out. Before, it was left out, and with it most of the screen.
(def test_fit_buffer_swapped () int
  (let a (fit_allocs (screen_fit 3840 200 (append (strips 15 (nil Layer)) (cons (Layer 6 0 150 0) (nil Layer))) (bufs) (no_cursor) (nil Alloc)))
    (let b (screen_fit 3840 200 (append (strips 15 (nil Layer)) (cons (Layer 7 0 150 0) (nil Layer))) (bufs) (no_cursor) a)
      (add (check_str "nothing left out" (fit_text b) "planes 16, 0 left out")
           (check_str "6's units and handle, keyed 7's" (take_words 1 (fit_upm b)) "112:915+94#15")))))

; A window whose width on the screen changes, as one dragged past the
; screen's edge, needs new units, as Linux's planes do: fifteen strips
; and window 6 at 1840, 2000 of it showing, 63 units, 46 free; dragged
; to 1000, 2840 of it shows, which needs 89, no 89 are free, and it is
; left out, one piece. The Pi 5 blanked the screen when a handle's units
; were kept for a plane of another width.
(def test_fit_window_widened () int
  (let a (fit_allocs (screen_fit 3840 200 (append (strips 15 (nil Layer)) (cons (Layer 6 1840 150 0) (nil Layer))) (bufs) (no_cursor) (nil Alloc)))
    (check_str "left out"
      (fit_text (screen_fit 3840 200 (append (strips 15 (nil Layer)) (cons (Layer 6 1000 150 0) (nil Layer))) (bufs) (no_cursor) a))
      "planes 15, 1 left out")))

; The first n words of s, each with the space after it but the last.
(def take_words ((n int) (s (list int))) (list int)
  (if (if (is_empty s) true (le n 0))
      ""
      (if (eq (head s) 32)
          (if (eq n 1) "" (cons 32 (take_words (sub n 1) (tail s))))
          (cons (head s) (take_words n (tail s))))))

; Past the 32 handles, the lowest are left out too.
(def test_fit_handles () int
  (check_str "thirty-two of thirty-three"
    (fit_text (screen_fit 100 80 (staggered 33 (nil Layer)) (bufs) (no_cursor) (nil Alloc)))
    "planes 32, 1 left out"))

; Said as the screen stops fitting and as it fits again, not between.
(def test_fit_change () int
  (add (check_str "stops" (option_text (fit_change 0 2)) "the screen's layers are too wide for the HVS's line memory: pieces left out until they fit")
  (add (check_str "goes on" (option_text (fit_change 2 3)) "")
  (add (check_str "fits" (option_text (fit_change 3 0)) "the screen's layers fit the HVS's line memory again")
       (check_str "fitting" (option_text (fit_change 0 0)) "")))))

; Some text, or "" for none.
(def option_text ((o (Option (list int)))) (list int)
  (match o ((Some s) s) ((None) "")))

; n strips of buffer 4, 1920 by 10 as buffer 3, so keyed apart from those.
(def moved_strips ((n int) (acc (list Layer))) (list Layer)
  (if (eq n 0) acc (moved_strips (sub n 1) (cons (Layer 4 0 (mul 10 (sub n 1)) 0) acc))))

; ------------------------------------------------------------- cutting

; A frame and its content on a screen 2560 wide: buffer 5, a frame 100
; by 80 from 6000000, under buffer 6, content 96 by 60 at 2, 18 in it
; from 7000000; and the same on one 1920 wide.
(def framed_bufs () (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer))
    5 (Buffer 100 80 100 0 8 6000000 (square)))
    6 (Buffer 96 60 96 0 6 7000000 (square))))

(def framed ((w int)) (list int)
  (pieces_text (screen_pieces w 1000 (two (Layer 5 0 0 0) (Layer 6 2 18 0)) (framed_bufs) (no_cursor))))

; On 2560 the frame is what shows of it: the title band, 18 rows, the
; edges each side of the content, 2 wide, and the 2 rows under it, each
; fetched from where it is in the frame's rows of 400 bytes: the left
; edge from row 18, 6000000 + 18 * 400; the right from column 98, 392
; bytes more; the bottom from row 78.
(def test_frame_cut () int
  (check_str "cut" (framed 2560)
    "98,18 2x60 @6007592 /400 0,18 2x60 @6007200 /400 0,78 100x2 @6031200 /400 0,0 100x18 @6000000 /400 2,18 96x60 @7000000 /384 "))

; On 1920 it is one plane, as before.
(def test_frame_whole () int
  (check_str "whole" (framed 1920)
    "0,0 100x80 @6000000 /400 2,18 96x60 @7000000 /384 "))

; The cut parts are keyed the frame's 80 plus 0 to 3, in the order
; rects_minus gives them, last first.
(def test_frame_cut_keys () int
  (check_str "keys" (keys_text (screen_pieces 2560 1000 (two (Layer 5 0 0 0) (Layer 6 2 18 0)) (framed_bufs) (no_cursor)))
    "83 82 81 80 96 "))

; ------------------------------------------------------------- rounded

; Each rectangle as X,Y WxH.
(def rects_text ((rs (list Rect))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((Rect x y w h)
          (append (digits x) (append "," (append (digits y) (append " " (append (digits w) (append "x" (append (digits h)
            (append " " (rects_text (tail rs))))))))))))))

(def test_cover_square () int
  (check_str "all of it" (rects_text (layer_cover 10 5 30 20 (square))) "10,5 30x20 "))

; Top corners 12, bottom 10, on 100 by 80 at 0, 0: the 12 rows at the top
; less 12 columns each end, the 58 rows between whole, and the bottom 10
; less 10 each end.
(def test_cover_rounded () int
  (check_str "less the corners" (rects_text (layer_cover 0 0 100 80 (Corners 12 12 10 10)))
    "12,0 76x12 0,12 100x58 10,70 80x10 "))

(def test_is_square () int
  (add (check_bool "square" (is_square (square)) true)
       (check_bool "one corner" (is_square (Corners 0 0 0 4)) false)))

; Buffer 7, the screen's size, its corners rounded 12, over the desktop:
; it has alpha, and the desktop shows in its corners, so it is not hidden.
(def rounded_bufs () (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer))
    0 (Buffer 100 80 100 0 8 1000000 (square)))
    7 (Buffer 100 80 100 0 8 8000000 (Corners 12 12 12 12))))

(def test_rounded_hides_not_its_corners () int
  (check_str "both, the window with alpha"
    (pieces_text (screen_pieces 100 80 (two (desktop) (Layer 7 0 0 0)) (rounded_bufs) (no_cursor)))
    "0,0 100x80 @1000000 /400 0,0 100x80 @8000000 /400a "))

; A rounded frame on 2560 is still cut to what shows of it, its parts
; keeping its alpha, the content over it opaque.
(def rounded_framed_bufs () (Map int Buffer)
  (map_put (map_put ((MapEmpty int Buffer))
    5 (Buffer 100 80 100 0 8 6000000 (Corners 12 12 12 12)))
    6 (Buffer 96 60 96 0 6 7000000 (square))))

(def test_rounded_frame_cut () int
  (check_str "cut, with alpha"
    (pieces_text (screen_pieces 2560 1000 (two (Layer 5 0 0 0) (Layer 6 2 18 0)) (rounded_framed_bufs) (no_cursor)))
    "98,18 2x60 @6007592 /400a 0,18 2x60 @6007200 /400a 0,78 100x2 @6031200 /400a 0,0 100x18 @6000000 /400a 2,18 96x60 @7000000 /384 "))

; Each piece's key.
(def keys_text ((ps (list Piece))) (list int)
  (if (is_empty ps)
      ""
      (match (head ps) ((Piece r addr pitch alpha key cover) (append (digits key) (append " " (keys_text (tail ps))))))))

; n frames, each under its content, 200 apart, on a screen 2560 wide.
; Eight cut would be 8 times 5, 40 planes, more than the 32 handles, so
; the screen is planned whole: 16 planes.
(def framed_layers ((n int) (acc (list Layer))) (list Layer)
  (if (eq n 0) acc (framed_layers (sub n 1) (cons (Layer 5 (mul 200 n) 0 0) (cons (Layer 6 (add (mul 200 n) 2) 18 0) acc)))))

(def test_whole_when_cut_is_too_many () int
  (check_str "whole" (planned_text (screen_planes 2560 1000 (framed_layers 8 (nil Layer)) (framed_bufs) (no_cursor) (nil Alloc)))
    "planes 16"))

; n allocations of u units each.
(def allocs_n ((n int) (u int) (acc (list Alloc))) (list Alloc)
  (if (eq n 0) acc (allocs_n (sub n 1) u (cons (Alloc n (mul n u) u n) acc))))

; Half is 16 handles and 512 units: 16 of 32 units are within it, 17
; planes or 16 of 33 units are not.
(def test_within_half () int
  (add (check_bool "16 of 32" (within_half (allocs_n 16 32 (nil Alloc))) true)
       (add (check_bool "17 planes" (within_half (allocs_n 17 1 (nil Alloc))) false)
            (check_bool "528 units" (within_half (allocs_n 16 33 (nil Alloc))) false))))
