; hvs_test.l0 -- tests of the driver's own: what it says, and what it
; does with no HVS.

; Under an operating system there is no HVS: no region is given, and no
; HVS is no failure.
(def test_no_hvs () int
  (check_int "exits 0" (hvs (StageFull)) 0))

(def test_screen_line () int
  (add (check_str "C0 at 1080p" (screen_line (HvsC0) 1920 1080 1)
        "a screen of 1920x1080 on HDMI0, HVS C0 at 0x107c580000, channel 0, scale 1, serving display")
       (check_str "D0 at 4K" (screen_line (HvsD0) 3840 2160 2)
        "a screen of 3840x2160 on HDMI0, HVS D0 at 0x107c580000, channel 0, scale 2, serving display")))

; The pages the buffers hold, which a forgotten buffer's pages are kept
; for: two buffers in the same pages, as a window resized in its room
; is, hold them until both are forgotten.
(def test_bufs_vas () int
  (let bufs (map_put (map_put ((MapEmpty int Buffer)) 4 (Buffer 10 10 16 8192 1 0 (square))) 6 (Buffer 10 10 16 8192 1 0 (square)))
    (add (check_int "both" (length (bufs_vas bufs)) 2)
         (check_bool "at 8192" (any_eq 8192 (bufs_vas (map_remove bufs 4))) true))))

; A list reads its layers' buffers' pages and the pointer's; a layer
; with no buffer reads none.
(def test_screen_vas () int
  (let bufs (map_put (map_put ((MapEmpty int Buffer)) 4 (Buffer 10 10 16 8192 1 0 (square))) 1 (Buffer 64 64 64 40960 4 0 (square)))
    (check_strs "pages"
      (numbers_words (sort (screen_vas (cons (Layer 4 0 0 0) (cons (Layer 9 0 0 0) (nil Layer))) (Cursor 1 5 5 0 0) bufs)))
      (split_spaces "8192 40960"))))

(def test_cursor_id () int
  (add (check_int "none" (cursor_id (no_cursor)) -1)
       (check_int "buffer 1" (cursor_id (Cursor 1 5 5 0 0)) 1)))

; Damage past the buffer's rows cleans nothing; under no kernel, a clean
; is 0 whatever it reaches.
(def test_rows_cleaned_past_the_end () int
  (check_int "nothing" (rows_cleaned (Buffer 10 10 16 8192 1 0 (square)) 20 5) 0))

; Each stage stops where it says; under an operating system there is no
; HVS, so none gets past opening it.
(def test_stages_no_hvs () int
  (add (check_int "probe" (hvs (StageProbe)) 0)
       (add (check_int "list" (hvs_main (cons "list" (nil (list int)))) 0)
            (check_int "iommu" (hvs_main (cons "iommu" (nil (list int)))) 0))))

(def test_stage_of () int
  (add (check_int "none is serving" (stage_rank_of (nil (list int))) 3)
       (add (check_int "probe" (stage_rank_of (cons "probe" (nil (list int)))) 0)
            (check_int "iommu" (stage_rank_of (cons "iommu" (nil (list int)))) 2))))

(def test_stage_of_bad () int
  (add (check_int "unknown" (stage_rank_of (cons "all" (nil (list int)))) -1)
       (check_int "two" (stage_rank_of (cons "list" (cons "iommu" (nil (list int))))) -1)))

; A stage's rank, or -1 for no stage.
(def stage_rank_of ((as (list (list int)))) int
  (match (stage_of as) ((None) -1) ((Some s) (stage_rank s))))

; A bad argument is a failure, said.
(def test_usage () int
  (check_int "fails" (hvs_main (cons "all" (nil (list int)))) 1))

; watch takes seconds, more than none: a word or 0 is a failure, said.
(def test_watch_usage () int
  (add (check_int "a word" (hvs_main (cons "watch" (cons "soon" (nil (list int))))) 1)
       (check_int "zero" (hvs_main (cons "watch" (cons "0" (nil (list int))))) 1)))

; Under an operating system there is no mailbox, so watch cannot ask
; whether the display is clocked, and fails.
(def test_watch_no_mailbox () int
  (check_int "fails" (hvs_main (cons "watch" (cons "5" (nil (list int))))) 1))

(def test_reg_line () int
  (check_str "D0's CTRL0" (reg_line "DISP0 CTRL0" 256 2148467767) "DISP0 CTRL0 (0x0100) = 0x800f0437"))

; STATUS 0x00054000: mode 2, running, frame 5; DL at word 32.
(def test_channel_line () int
  (check_str "running" (channel_line 344064 32) "channel mode 2, frame 5, list at word 32"))

; What probe reads: the version, the memories' four sizes and
; HANDLE_ERROR, and six of the channel's registers; and eight of the
; IOMMU's.
(def test_hvs_regs () int
  (add (check_int "twelve" (length (hvs_regs (HvsD0))) 12)
       (check_int "eight of the IOMMU" (length (iommu_regs)) 8)))

; ------------------------------------------------------------- wallpaper

; A screen 100 by 80: the wallpaper's buffer, 0 the desktop, 1 a window
; 30 by 20, 2 a rounded desktop.
(def walled () (Map int Buffer)
  (map_put (map_put (map_put (map_put ((MapEmpty int Buffer))
    (wall_id) (Buffer 100 80 100 0 8 9000000 (square)))
    0 (Buffer 100 80 100 0 8 1000000 (square)))
    1 (Buffer 30 20 40 0 1 2000000 (square)))
    2 (Buffer 100 80 100 0 8 3000000 (Corners 12 12 0 0))))

; The desktop covers the screen; a window, a rounded desktop or the
; wallpaper itself does not.
(def test_screen_covered () int
  (add (check_bool "the desktop" (screen_covered (cons (Layer 0 0 0 0) (nil Layer)) (walled) 100 80) true)
       (add (check_bool "a window" (screen_covered (cons (Layer 1 5 5 0) (nil Layer)) (walled) 100 80) false)
            (add (check_bool "rounded" (screen_covered (cons (Layer 2 0 0 0) (nil Layer)) (walled) 100 80) false)
                 (check_bool "the wallpaper" (screen_covered (cons (wall_layer) (nil Layer)) (walled) 100 80) false)))))

; The wallpaper stays under a window, leaves under the desktop, and is
; gone once its buffer is.
(def test_wall_kept () int
  (add (check_bool "under a window" (wall_kept (cons (Layer 1 5 5 0) (nil Layer)) (walled) 100 80) true)
       (add (check_bool "under the desktop" (wall_kept (cons (Layer 0 0 0 0) (nil Layer)) (walled) 100 80) false)
            (check_bool "gone" (wall_kept (cons (Layer 1 5 5 0) (nil Layer)) (map_remove (walled) (wall_id)) 100 80) false))))

; The first frame is one piece, the whole wallpaper, from its aperture
; address; under a window it is cut around it, as the desktop would be.
(def test_wall_pieces () int
  (add (check_int "alone" (length (screen_pieces 100 80 (wall_under (nil Layer) true) (walled) (no_cursor))) 1)
       (check_int "under a window"
         (length (screen_pieces 100 80 (wall_under (cons (Layer 1 5 5 0) (nil Layer)) true) (walled) (no_cursor)))
         (length (screen_pieces 100 80 (cons (Layer 0 0 0 0) (cons (Layer 1 5 5 0) (nil Layer))) (walled) (no_cursor))))))

(def test_untaken_line () int
  (check_str "line" (untaken_line 2064 32 2064 4294967295)
    "HDMI0's channel has not taken its new list at word 2064: LPTRS 0x00000020, DL 0x00000810, STATUS 0xffffffff; the firmware keeps it, so the driver's lists are written over the firmware's"))
