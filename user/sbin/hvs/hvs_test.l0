; hvs_test.l0 -- tests of the driver's own: what it says, and what it
; does with no HVS.

; Under an operating system there is no HVS: no region is given, and no
; HVS is no failure.
(def test_no_hvs () int
  (check_int "exits 0" (hvs) 0))

(def test_screen_line () int
  (add (check_str "C0 at 1080p" (screen_line (HvsC0) 1920 1080 1)
        "a screen of 1920x1080 on HDMI0, HVS C0 at 0x107c580000, channel 0, scale 1, serving display")
       (check_str "D0 at 4K" (screen_line (HvsD0) 3840 2160 2)
        "a screen of 3840x2160 on HDMI0, HVS D0 at 0x107c580000, channel 0, scale 2, serving display")))

; Two buffers in the same pages, as a window resized in its room is,
; until the second is forgotten too.
(def test_buffer_at () int
  (let bufs (map_put ((MapEmpty int Buffer)) 4 (Buffer 10 10 16 8192 1 0 (square)))
    (add (check_bool "another in the pages" (buffer_at bufs 8192) true)
         (check_bool "none at another place" (buffer_at bufs 12288) false))))

(def test_cursor_id () int
  (add (check_int "none" (cursor_id (no_cursor)) -1)
       (check_int "buffer 1" (cursor_id (Cursor 1 5 5 0 0)) 1)))

; Damage past the buffer's rows cleans nothing; under no kernel, a clean
; is 0 whatever it reaches.
(def test_rows_cleaned_past_the_end () int
  (check_int "nothing" (rows_cleaned (Buffer 10 10 16 8192 1 0 (square)) 20 5) 0))
