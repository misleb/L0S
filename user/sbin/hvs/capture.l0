; capture.l0 -- the capture request on the Pi 5: the driver's buffers
; given display_server.l0's captured_into, which copies what the screen
; shows from their pages by the CPU, as virtio-gpu does. The HVS only
; reads the pages, so the CPU's view of them is what it shows; the pixels
; a rounded layer's corners cut, whose alpha hvs writes 0 (corners.l0),
; are left to the layer beneath by the same corner_cut. A client that
; shows what was captured damages it, which cleans it out of the caches
; for the HVS.

; capture ID X Y W H: rectangle X Y W H of the screen, in its pixels,
; copied into buffer id from its top left. Refused for a rectangle off
; the screen or bigger than the buffer, and for a buffer on the screen.
(def captured ((v Drv) (id int) (r Rect)) (Served Drv)
  (let e (captured_into (.layers v) (cap_bufs (map_keys (.bufs v)) (map_values (.bufs v)) ((MapEmpty int CapBuf))) (.w v) (.h v) id r)
    (if (is_empty e) (served_ok v) (refused v e))))

; The buffers ids are, bs in step with them, as a capture reads them,
; into m.
(def cap_bufs ((ids (list int)) (bs (list Buffer)) (m (Map int CapBuf))) (Map int CapBuf)
  (if (is_empty ids)
      m
      (let b (head bs)
        (cap_bufs (tail ids) (tail bs) (map_put m (head ids) (CapBuf (.bw b) (.bh b) (.sd b) (.va b) (.n b) (.cs b)))))))
