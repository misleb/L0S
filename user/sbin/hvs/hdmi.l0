; hdmi.l0 -- HDMI0 on the Raspberry Pi 5: the regions L0 gives for its
; controller, PHY, pixel valve and DDC (L0 roadmap 0120), where in them
; each register Linux's vc4 uses is (vc4_hdmi_regs.h's
; vc6_hdmi_hdmi0_fields, vc4_regs.h's PV_ registers), and stage hdmi,
; which reads them all while the firmware's mode runs, to check that map
; before any is written. Nothing here writes yet.

; ---------------------------------------------------------------- regions

; HDMI0's blocks, one run from bcm2712.dtsi's dvp at 0x7c700000 to the
; end of its metadata, 0x4800 bytes; the HD block both HDMIs share; pixel
; valve 0, which feeds HDMI0 from HVS channel 0; and DDC0, the
; brcmstb-i2c on HDMI0's DDC lines. CPU addresses, bus + 0x10_0000_0000.
(def hdmi_blocks_base () int 70807191552)   ; 0x107C700000
(def hdmi_blocks_bytes () int 18432)        ; 0x4800
(def hd_base () int 70807322624)            ; 0x107C720000
(def pv0_base () int 70804111360)           ; 0x107C410000
(def ddc0_base () int 70821904896)          ; 0x107D508200
(def small_bytes () int 256)                ; 0x100
(def ddc_bytes () int 88)                   ; 0x58

; Where each block is in the run: the DVP's clock and reset controller,
; the CSC, the DVP, the HDMI core, the PHY and the rate manager.
(def at_dvp_ctrl () int 0)
(def at_csc () int 256)                     ; 0x100
(def at_dvp () int 4096)                    ; 0x1000
(def at_core () int 5120)                   ; 0x1400
(def at_phy () int 7424)                    ; 0x1D00
(def at_rm () int 8192)                     ; 0x2000

; HDMI0's regions, open: the run, HD, pixel valve 0 and DDC0.
(data Hdmi (Hdmi IoDevice IoDevice IoDevice IoDevice))

; Them opened, or why not.
(data HdmiOpened (HdmiOpen Hdmi) (NoHdmi (list int)))

; Each region opened in turn; the first refused says why.
(def hdmi_open () HdmiOpened
  (match (open_device (hdmi_blocks_base) (hdmi_blocks_bytes))
    ((DeviceFailed f why) (NoHdmi (append "HDMI0's blocks: " why)))
    ((DeviceOpened b)
      (match (open_device (hd_base) (small_bytes))
        ((DeviceFailed f why) (NoHdmi (append "the HD block: " why)))
        ((DeviceOpened hd)
          (match (open_device (pv0_base) (small_bytes))
            ((DeviceFailed f why) (NoHdmi (append "pixel valve 0: " why)))
            ((DeviceOpened pv)
              (match (open_device (ddc0_base) (ddc_bytes))
                ((DeviceFailed f why) (NoHdmi (append "DDC0: " why)))
                ((DeviceOpened ddc) (HdmiOpen (Hdmi b hd pv ddc)))))))))))

; -------------------------------------------------------------- registers

; The registers stage hdmi reads of the run, each where it is in it: the
; HDMI core's, the DVP's and its controller's, the PHY's, the rate
; manager's and the CSC's.
(def blocks_regs () (list NamedReg)
  (append (core_regs)
    (append (dvp_regs)
      (append (phy_regs) (append (rm_regs) (csc_regs))))))

; The HDMI core's, from 0x1400.
(def core_regs () (list NamedReg)
  (named_at (at_core)
    "FIFO_CTL RAM_PACKET_CONFIG SCHEDULER_CONTROL HORZA HORZB VERTA0 VERTB0 VERTA1 VERTB1 MISC_CONTROL DEEP_COLOR_CONFIG_1 GCP_CONFIG GCP_WORD_1 HOTPLUG SCRAMBLER_CTL"
    (cons 124 (cons 196 (cons 232 (cons 236 (cons 240 (cons 244 (cons 248 (cons 256 (cons 260 (cons 276 (cons 396 (cons 404 (cons 408 (cons 456 (cons 484 (nil int))))))))))))))))))

; The DVP controller's SW_INIT and MISC_CONFIG, and the DVP's CLOCK_STOP,
; VEC_INTERFACE_CFG and VEC_INTERFACE_XBAR.
(def dvp_regs () (list NamedReg)
  (append (named_at (at_dvp_ctrl) "DVP_SW_INIT DVP_MISC_CONFIG" (cons 4 (cons 8 (nil int))))
    (named_at (at_dvp) "CLOCK_STOP VEC_INTERFACE_CFG VEC_INTERFACE_XBAR" (cons 188 (cons 240 (cons 244 (nil int)))))))

; The PHY's, from 0x1D00.
(def phy_regs () (list NamedReg)
  (named_at (at_phy)
    "PHY_RESET_CTL PHY_POWERUP_CTL PHY_CTL_0 PHY_CTL_1 PHY_CTL_2 PHY_CTL_CK PLL_REFCLK PLL_POST_KDIV PLL_VCOCLK_DIV PLL_CFG TMDS_CLK_WORD_SEL PLL_MISC_0 PLL_MISC_1 PLL_MISC_2 PLL_MISC_3 PLL_MISC_4 PLL_MISC_5 PLL_MISC_6 PLL_MISC_7 PLL_MISC_8 PLL_RESET_CTL PLL_POWERUP_CTL"
    (cons 0 (cons 4 (cons 8 (cons 12 (cons 16 (cons 20 (cons 28 (cons 40 (cons 44 (cons 68 (cons 84
      (cons 96 (cons 100 (cons 104 (cons 108 (cons 112 (cons 116 (cons 120 (cons 124 (cons 128
        (cons 400 (cons 404 (nil int)))))))))))))))))))))))))

; The rate manager's CONTROL, OFFSET and FORMAT.
(def rm_regs () (list NamedReg)
  (named_at (at_rm) "RM_CONTROL RM_OFFSET RM_FORMAT" (cons 0 (cons 24 (cons 28 (nil int))))))

; The CSC's CTL and CHANNEL_CTL.
(def csc_regs () (list NamedReg)
  (named_at (at_csc) "CSC_CTL CSC_CHANNEL_CTL" (cons 0 (cons 44 (nil int)))))

; The HD block's DVP_CTL, VID_CTL (HDMI0's) and FRAME_COUNT.
(def hd_regs () (list NamedReg)
  (named_at 0 "HD_DVP_CTL HD_VID_CTL HD_FRAME_COUNT" (cons 0 (cons 68 (cons 96 (nil int))))))

; Pixel valve 0's.
(def pv_regs () (list NamedReg)
  (named_at 0 "PV_CONTROL PV_V_CONTROL PV_VSYNCD_EVEN PV_HORZA PV_HORZB PV_VERTA PV_VERTB PV_INTEN PV_STAT PV_HACT_ACT PV_MUX_CFG PV_PIPE_INIT_CTRL"
    (cons 0 (cons 4 (cons 8 (cons 12 (cons 16 (cons 20 (cons 24 (cons 36 (cons 44 (cons 48 (cons 52 (cons 148 (nil int)))))))))))))))

; DDC0's chip address, count, control, enable, high control and SCL
; parameters (i2c-brcmstb.c's bsc_regs).
(def ddc_regs () (list NamedReg)
  (named_at 0 "DDC_CHIP_ADDRESS DDC_CNT DDC_CTL DDC_IIC_ENABLE DDC_CTLHI DDC_SCL_PARAM"
    (cons 0 (cons 36 (cons 40 (cons 44 (cons 80 (cons 84 (nil int)))))))))

; The names in words, each at base plus its offset in offs.
(def named_at ((base int) (words (list int)) (offs (list int))) (list NamedReg)
  (named_onto base (split_spaces words) offs (nil NamedReg)))

; The rest of names at base plus offs, after the reversed acc.
(def named_onto ((base int) (names (list (list int))) (offs (list int)) (acc (list NamedReg))) (list NamedReg)
  (if (if (is_empty names) true (is_empty offs))
      (rev acc)
      (named_onto base (tail names) (tail offs) (cons (NamedReg (head names) (add base (head offs))) acc))))

; ----------------------------------------------------------------- timings

; What the HDMI core's and the pixel valve's timing registers say of the
; mode, for checking the map against the mode the firmware set: the core's
; HORZA active pixels (bits 12 to 0) and VERTA0 active lines (12 to 0);
; the pixel valve's HORZB active pixels (15 to 0) and VERTB active lines
; (15 to 0).
(def core_hap ((horza int)) int (bit_and horza 8191))
(def core_val ((verta int)) int (bit_and verta 8191))
(def pv_hactive ((horzb int)) int (bit_and horzb 65535))
(def pv_vactive ((vertb int)) int (bit_and vertb 65535))

; The mode as the core and the pixel valve say it.
(def timings_line ((horza int) (verta int) (pvhb int) (pvvb int)) (list int)
  (append "HDMI0's mode: the core says "
    (append (digits (core_hap horza))
      (append "x"
        (append (digits (core_val verta))
          (append ", pixel valve 0 says "
            (append (digits (pv_hactive pvhb)) (append "x" (digits (pv_vactive pvvb))))))))))

; ------------------------------------------------------------- stage hdmi

; Stage hdmi: M2MC made sure of, since an HDMI register read with it off
; stalls the CPU (Linux's clk-raspberrypi.c keeps it at 120 MHz at
; least), then HDMI0's regions opened and every register above read and
; said, and the mode as the core and pixel valve 0 say it. Nothing
; written but the clock. 0.
(def hdmi_probed ((mb Mailbox)) int
  (let a (info_as "hvs" (append "at boot: " (clock_now mb (fw_clk_m2mc))))
    (let b (info_as "hvs" (append "at boot: " (clock_now mb (fw_clk_bvb))))
      (match (fw_clock_state mb (fw_clk_m2mc))
        ((None) (complain "the firmware gave no state for M2MC; not touching HDMI0"))
        ((Some s)
          (if (if (clock_is_on s) (gt (option_or (fw_clock_rate mb (fw_clk_m2mc)) 0) 0) false)
              (hdmi_read_all)
              (complain "M2MC is off; reading HDMI0 would stall the CPU")))))))

; Whether M2MC is on at a rate, so HDMI0's registers may be touched.
(def m2mc_ready ((mb Mailbox)) bool
  (match (fw_clock_state mb (fw_clk_m2mc))
    ((None) false)
    ((Some s) (if (clock_is_on s) (gt (option_or (fw_clock_rate mb (fw_clk_m2mc)) 0) 0) false))))

; The value of o, or d if none.
(def option_or ((o (Option int)) (d int)) int (match o ((None) d) ((Some v) v)))

; HDMI0's regions opened and read: 0, or 1 if one is not given.
(def hdmi_read_all () int
  (let w (info_as "hvs" "opening HDMI0's regions")
    (match (hdmi_open)
      ((NoHdmi why) (complain (append "no HDMI0 regions: " why)))
      ((HdmiOpen hm)
        (match hm
          ((Hdmi b hd pv ddc)
            (let r1 (regs_said b (blocks_regs))
              (let r2 (regs_said hd (hd_regs))
                (let r3 (regs_said pv (pv_regs))
                  (let r4 (regs_said ddc (ddc_regs))
                    (let m (info_as "hvs" (timings_line (device_read32 b (add (at_core) 236)) (device_read32 b (add (at_core) 244))
                                                        (device_read32 pv 16) (device_read32 pv 24)))
                      (info_as "hvs" "hdmi done"))))))))))))
