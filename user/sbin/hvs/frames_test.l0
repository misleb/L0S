; frames_test.l0 -- tests of what frames.l0 keeps without a board: the
; ports frames and releases are told to, and with no ends of frame, the
; frames told at once.

; f's ports, and with no ends of frame the frames told, as text.
(def polled_text ((f Frames)) (list int)
  (match f
    ((NoFrames ls nt) (append "ports" (append (unwords (cons "" (numbers_words ls))) (append " told " (digits nt)))))
    ((Frames l2 port n said ch last ls) "ends of frame")))

; A port asked twice is told once.
(def test_frames_listening () int
  (check_str "once" (polled_text (frames_listening (frames_listening (frames_polled) 7) 7)) "ports 7 told 0"))

; With no ends of frame each change is a frame told at once; a release
; is told and counts none. Under an operating system a notice to port 7
; is not sent, and the port is kept, as a full queue's is.
(def test_polled_frames () int
  (let f (frames_released (frames_changed (frames_changed (frames_listening (frames_polled) 7) 1) 2) (cons 4 (nil int)))
    (check_str "two" (polled_text f) "ports 7 told 2")))

; Telling nothing keeps the ports as they are.
(def test_shown_told_nothing () int
  (check_strs "kept" (numbers_words (shown_told (cons 3 (cons 9 (nil int))) 0 (nil int))) (split_spaces "3 9")))
