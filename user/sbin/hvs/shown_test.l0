; shown_test.l0 -- tests of which frame showed each change.

; ----------------------------------------------------------- frame count

; STATUS's count moving on by one is one frame.
(def test_extended_one () int
  (check_int "130 to 3" (frame_extended 130 3) 131))

; Twenty missed across the wrap: count 60, STATUS 16 (80 mod 64).
(def test_extended_wrap () int
  (check_int "60 to 16" (frame_extended 60 16) 80))

; The same six bits is no frame missed; only the low six bits of fr are
; read.
(def test_extended_same () int
  (add (check_int "same" (frame_extended 200 8) 200)
       (check_int "high bits" (frame_extended 200 (add 8 4096)) 200)))

; Against counting one by one: a few hundred starts, each 0 to 63 frames
; on, as STATUS would read.
(def extended_cases ((seed int) (i int) (bad int)) int
  (if (ge i 300)
      bad
      (let s1 (rand_next seed)
        (let s2 (rand_next s1)
          (let n (bit_and s1 65535)
            (let k (bit_and s2 63)
              (extended_cases s2 (add i 1)
                (if (eq (frame_extended n (mod (add n k) 64)) (add n k)) bad (add bad 1)))))))))

(def test_extended_property () int
  (check_int "wrong" (extended_cases 7 0 0) 0))

; --------------------------------------------------------------- changes

; The changes as text: next, pending as NUMBER@FRAME, latest.
(def changes_text ((c Changes)) (list int)
  (match c
    ((Changes next ps latest)
      (append "next " (append (digits next) (append " pending" (append (pends_text ps) (append " latest " (digits latest)))))))))

(def pends_text ((ps (list Pend))) (list int)
  (if (is_empty ps)
      ""
      (match (head ps)
        ((Pend k f) (append " " (append (digits k) (append "@" (append (digits f) (pends_text (tail ps))))))))))

; A list taken at 10 is pending for 11; a damage at 10 for 12.
(def test_noted () int
  (check_str "two"
    (changes_text (change_noted (change_noted (changes_new) 10 (list_frames)) 10 (damage_frames)))
    "next 3 pending 1@11 2@12 latest 0"))

; At 11's end the list is shown, the damage still pending.
(def test_shown_in_turn () int
  (check_str "at 11"
    (changes_text (changes_at (change_noted (change_noted (changes_new) 10 1) 10 2) 11))
    "next 3 pending 2@12 latest 1"))

; Frames missed: at 14's end both are shown, the latest 2.
(def test_shown_late () int
  (check_str "at 14"
    (changes_text (changes_at (change_noted (change_noted (changes_new) 10 1) 10 2) 14))
    "next 3 pending latest 2"))

; A later change pending for an earlier frame (a list at 12, then a
; damage at 11): each shown at its own frame, the latest the larger.
(def test_shown_out_of_order () int
  (check_str "at 13"
    (changes_text (changes_at (change_noted (change_noted (changes_new) 12 1) 11 2) 13))
    "next 3 pending latest 2"))

; Nothing pending: a frame's end changes nothing.
(def test_shown_none () int
  (add (check_int "latest" (changes_latest (changes_at (changes_new) 5)) 0)
       (check_int "pending" (changes_pending (changes_at (changes_new) 5)) 0)))
