; fs_test.l0 -- tests of the file server, on volumes in memory: what each
; request answers, and what it leaves on the disk.

; data, sectors 8 to 1535, and scratch, 1536 to 2047, as tools/mkdisk
; made them before the disk had a GPT, empty, on a store of memory of
; 2048 sectors; the port 7.
(def two () Fs
  (fs_new (StoreMem ((MapEmpty int (list int))) 2048 0 0) 7
          (array_from (cons (FsVol 0 8 "" (vol_new "data" (vol_layout 1528)))
                            (cons (FsVol 0 1536 "" (vol_new "scratch" (vol_layout 512))) (nil FsVol)))
                      (FsVol 0 0 "" (vol_new "x" (vol_layout 16))))))

; An answer as text: the word, a colon, the bytes.
(def answer_text ((a Answered)) (list int)
  (match a ((Answered f w bs) (append (digits w) (append ":" bs)))))

(def after ((a Answered)) Fs (match a ((Answered f w bs) f)))

; The requests done in order by pid 5, their answers joined by |, and f
; after them.
(data Ran (Ran Fs (list int)))

(def run ((f Fs) (reqs (list (list int)))) Ran
  (run_from f reqs (nil int)))

; Each request comes as the server receives it, a message's bytes, so a
; write's bytes are written from them in place.
(def run_from ((f Fs) (reqs (list (list int))) (acc (list int))) Ran
  (if (is_empty reqs)
      (Ran f (rev acc))
      (let a (obey_msg f 5 (req_msg (head reqs)))
        (run_from (after a) (tail reqs) (push (answer_text a) (if (is_empty acc) acc (push "|" acc)))))))

; body as the bytes of a request's message from pid 5, its reply to 9.
(def req_msg ((body (list int))) bytes
  (match (message_new 5 (request 9 body)) ((Message from b) b) ((RecvFailed) (bytes_from_list (nil int)))))

; A write read from its message's bytes does as one read as text.
(def test_write_in_place () int
  (add (check_str "as text" (answer_text (obey (two) 5 "write 1 x")) "-5:")
       (add (check_str "in place" (answer_text (obey_msg (two) 5 (req_msg "write 1 x"))) "-5:")
            (check_str "no handle" (answer_text (obey_msg (two) 5 (req_msg "write x y"))) "-5:"))))

(def ran_text ((r Ran)) (list int) (match r ((Ran f t) t)))
(def ran_fs ((r Ran)) Fs (match r ((Ran f t) f)))

; What the requests answer, from two.
(def answers ((reqs (list (list int)))) (list int)
  (ran_text (run (two) reqs)))

(def reqs1 ((a (list int))) (list (list int)) (cons a (nil (list int))))
(def reqs2 ((a (list int)) (b (list int))) (list (list int)) (cons a (reqs1 b)))
(def reqs3 ((a (list int)) (b (list int)) (c (list int))) (list (list int)) (cons a (reqs2 b c)))
(def reqs4 ((a (list int)) (b (list int)) (c (list int)) (d (list int))) (list (list int)) (cons a (reqs3 b c d)))

; ----------------------------------------------------------- write, read

(def written_notes () (list (list int))
  (reqs3 "open 2 /Volumes/data/notes" "write 1 hello disk" "close 1"))

(def test_write () int
  (check_str "a handle, ten bytes, closed" (answers (written_notes)) "1:|10:|0:"))

(def test_read_back () int
  (check_str "the bytes, then the end"
             (answers (append (written_notes) (reqs3 "open 1 /Volumes/data/notes" "read 2 100" "read 2 100")))
             "1:|10:|0:|2:|10:hello disk|0:"))

(def test_read_in_pieces () int
  (check_str "four, then six"
             (answers (append (written_notes) (reqs3 "open 1 /Volumes/data/notes" "read 2 4" "read 2 100")))
             "1:|10:|0:|2:|4:hell|6:o disk"))

; Opening to write anew empties the file.
(def test_write_anew () int
  (check_str "empty"
             (answers (append (written_notes) (reqs3 "open 2 /Volumes/data/notes" "open 1 /Volumes/data/notes" "read 3 100")))
             "1:|10:|0:|2:|3:|0:"))

(def test_append () int
  (check_str "added to"
             (answers (append (written_notes) (reqs4 "open 3 /Volumes/data/notes" "write 2  again" "open 1 /Volumes/data/notes" "read 3 100")))
             "1:|10:|0:|2:|6:|3:|16:hello disk again"))

; The bytes reach the disk: the file's first cluster is cluster 2, the
; root directory's being 1, from sector 8 + 16, and the volume, from
; sector 8, reads back as fs has it.
(def test_on_disk () int
  (let f (ran_fs (run (two) (written_notes)))
    (add (check_str "the data" (take (sectors f 24 1) 10) "hello disk")
         (check_true "the metadata" (meta_kept f 0)))))

; count sectors of f's store from sector.
(def sectors ((f Fs) (sector int) (count int)) (list int)
  (match f
    ((Fs s port vols hs next ws cp)
      (match (store_read_all (array_get s 0) sector count) ((Got s2 bs) bs) ((GotNot s2 why) why)))))

; ---------------------------------------------------- refusals and opens

(def test_open_missing () int
  (check_str "no such file" (answers (reqs1 "open 1 /Volumes/data/none")) "-3:"))

(def test_open_places () int
  (add (check_str "no such volume" (answers (reqs2 "open 1 /Volumes/x/a" "open 2 /Volumes/x/a")) "-3:|-9:")
       (add (check_str "deeper" (answers (reqs2 "open 1 /Volumes/data/a/b" "open 2 /Volumes/data/a/b")) "-3:|-9:")
            (check_str "the volume" (answers (reqs1 "open 1 /Volumes/data")) "-8:"))))

(def test_open_mode () int
  (check_str "mode 4" (answers (reqs1 "open 4 /Volumes/data/a")) "-5:"))

(def test_bad_requests () int
  (check_str "unknown, short, no number"
             (answers (reqs3 "what" "read 1" "write x y"))
             "-5:|-5:|-5:"))

; A handle is only its opener's.
(def test_others_handle () int
  (let f (ran_fs (run (two) (reqs1 "open 2 /Volumes/data/notes")))
    (add (check_str "pid 6 writing" (answer_text (obey f 6 "write 1 x")) "-5:")
         (check_str "pid 5 writing" (answer_text (obey f 5 "write 1 x")) "1:"))))

(def test_wrong_direction () int
  (check_str "read a writer, write a reader"
             (answers (append (written_notes) (reqs3 "open 2 /Volumes/data/a" "read 2 10" "write 2 x")))
             "1:|10:|0:|2:|-5:|1:"))

(def test_closed () int
  (check_str "gone once closed" (answers (reqs3 "open 2 /Volumes/data/a" "close 1" "write 1 x")) "1:|0:|-5:"))

; An exit notice's pid loses its handles.
(def test_forget_pid () int
  (let f (forget_pid (ran_fs (run (two) (reqs1 "open 2 /Volumes/data/notes"))) 5)
    (check_str "gone" (answer_text (obey f 5 "write 1 x")) "-5:")))

; A directory of 64 entries grows by a cluster for a 65th, and the disk
; then holds both of its clusters.
(def test_directory_grows () int
  (let f (opened_n (two) 64)
    (let g (after (obey f 5 "open 2 /Volumes/scratch/z"))
      (add (check_str "the 65th" (answer_text (obey f 5 "open 2 /Volumes/scratch/z")) "65:")
           (add (check_str "listed" (take (answer_text (obey g 5 "list /Volumes/scratch")) 3) "65:")
                (check_true "on the disk" (meta_kept g 1)))))))

; f with n files made on scratch, f0 to fN.
(def opened_n ((f Fs) (n int)) Fs
  (if (eq n 0) f (opened_n (after (obey f 5 (append "open 2 /Volumes/scratch/f" (digits n)))) (sub n 1))))

(def test_write_a_message () int
  (let f (ran_fs (run (two) (reqs1 "open 2 /Volumes/scratch/big")))
    (check_str "all of it" (answer_text (obey f 5 (append "write 1 " (zeros 4000)))) "4000:")))

; scratch has 63 clusters of data, the root directory's one of them; 63
; clusters' worth does not fit, and leaves the file as it was.
(def test_full_volume () int
  (let f (fill_up (ran_fs (run (two) (reqs1 "open 2 /Volumes/scratch/big"))) 62)
    (add (check_str "no room" (answer_text (obey f 5 "write 1 x")) "-6:")
         (check_str "df" (answer_text (obey f 5 "df /Volumes/scratch")) "0:512 63 0 1"))))

; f with n clusters more written to handle 1.
(def fill_up ((f Fs) (n int)) Fs
  (if (eq n 0) f (fill_up (after (obey f 5 (append "write 1 " (zeros 4096)))) (sub n 1))))

; ------------------------------------------------------- larger writes

; 5000 bytes, across two clusters, read back in pieces of a cluster.
(def test_across_clusters () int
  (let body (pattern 5000)
    (let f (ran_fs (run (two) (reqs2 "open 2 /Volumes/data/big" (append "write 1 " body))))
      (let g (after (obey f 5 "open 1 /Volumes/data/big"))
        (check_true "the same" (eq (read_all g 2 (nil int)) body))))))

; Appends that start inside a sector keep what is before them: 3, then
; 600 more, then 100, reading back as one.
(def test_appends () int
  (let body (pattern 703)
    (let f (ran_fs (run (two) (reqs4 "open 3 /Volumes/data/a" (append "write 1 " (take body 3))
                                     (append "write 1 " (take (drop_n body 3) 600)) (append "write 1 " (drop_n body 603)))))
      (let g (after (obey f 5 "open 1 /Volumes/data/a"))
        (check_true "the same" (eq (read_all g 2 (nil int)) body))))))

; Bytes 0 to n - 1 of a pattern that does not repeat within a sector.
(def pattern ((n int)) (list int)
  (pattern_onto n (nil int)))

(def pattern_onto ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (pattern_onto (sub n 1) (cons (add 33 (mod (mul (sub n 1) 7) 89)) acc))))

; Everything left on handle h, pid 5's, read in pieces of up to 4092.
(def read_all ((f Fs) (h int) (acc (list int))) (list int)
  (match (obey f 5 (append "read " (append (digits h) " 4092")))
    ((Answered g w bs) (if (le w 0) (rev acc) (read_all g h (rev_onto bs acc))))))

; ------------------------------------------------------ reading in order

; How many reads and writes f's store has been asked.
; A server's one store, disk0's, as these tests give one; and f with s
; in its place.
(def fs_store ((f Fs)) Store (fs_store_at f 0))
(def with_store ((f Fs) (s Store)) Fs (with_store_at f 0 s))

(def requests ((f Fs)) int
  (match (fs_store f) ((StoreMem m n r fl) r) ((StoreDisk d b) -1) ((StoreRam m n) -1)))

; How many flushes f's store has been asked.
(def flushes ((f Fs)) int
  (match (fs_store f) ((StoreMem m n r fl) fl) ((StoreDisk d b) -1) ((StoreRam m n) -1)))

; A write flushes its data once, before the metadata that points at it;
; a read flushes nothing.
(def test_write_flushes () int
  (let f (ran_fs (run (two) (reqs2 "open 2 /Volumes/data/a" "write 1 hello")))
    (let g (after (obey f 5 "write 1 again"))
      (let h (after (obey (after (obey g 5 "open 1 /Volumes/data/a")) 5 "read 2 4"))
        (add (check_int "one write, one flush" (sub (flushes g) (flushes f)) 1)
             (check_int "none to read" (sub (flushes h) (flushes g)) 0))))))

; f with a file of n bytes, the pattern, written at /Volumes/data/big and
; closed, and handle 2 open on it to read.
(def big_open ((n int)) Fs
  (let f (ran_fs (run (two) (reqs3 "open 2 /Volumes/data/big" (append "write 1 " (pattern n)) "close 1")))
    (after (obey f 5 "open 1 /Volumes/data/big"))))

; The counts of reads of up to 4092 of handle h, until one gives 0, a
; space between, and f after them.
(def counts ((f Fs) (h int) (acc (list int))) Ran
  (match (obey f 5 (append "read " (append (digits h) " 4092")))
    ((Answered g w bs) (if (le w 0) (Ran g (rev (push (digits w) acc))) (counts g h (push " " (push (digits w) acc)))))))

; Reads of as much as a reply holds stay whole across clusters: 12300
; bytes are three of 4092 and 24, not 4092 then the 4 left in a cluster.
(def test_read_whole_replies () int
  (check_str "4092s" (ran_text (counts (big_open 12300) 2 (nil int))) "4092 4092 4092 24 0"))

; A file of ten clusters read in order: each cluster read from the disk
; once, though eleven replies take it, and the bytes as written.
(def test_read_a_cluster_once () int
  (let f (big_open 40960)
    (let r (requests f)
      (let g (ran_fs (counts f 2 (nil int)))
        (add (check_int "reads" (sub (requests g) r) 10)
             (check_true "the same" (eq (read_back f "/Volumes/data/big") (pattern 40960))))))))

; Small reads in order take what is held: a cluster read once for 100
; reads of 10.
(def test_small_reads_held () int
  (let f (big_open 1000)
    (let r (requests f)
      (check_int "one read" (sub (requests (reads_of f 2 100)) r) 1))))

; f after n reads of 10 bytes of handle h.
(def reads_of ((f Fs) (h int) (n int)) Fs
  (if (eq n 0) f (reads_of (after (obey f 5 (append "read " (append (digits h) " 10")))) h (sub n 1))))

; A reader holding a cluster sees the file written anew under it.
(def test_read_after_rewrite () int
  (check_str "the new bytes"
             (answers (append (written_notes)
                              (append (reqs2 "open 1 /Volumes/data/notes" "read 2 4")
                                      (reqs3 "open 2 /Volumes/data/notes" "write 3 HELLO DISK" "read 2 100"))))
             "1:|10:|0:|2:|4:hell|3:|10:|6:O DISK"))

; A reader that has read to the end keeps its place while a writer adds
; to the file, and then reads what was added, across clusters.
(def test_read_on_after_append () int
  (let f (big_open 5000)
    (let g (after (obey f 5 "read 2 4092"))
      (let h (after (obey g 5 "read 2 4092"))
        (let i (ran_fs (run h (reqs2 "open 3 /Volumes/data/big" (append "write 3 " (pattern 9000)))))
          (check_true "the rest" (eq (read_all i 2 (nil int)) (pattern 9000))))))))

; A file written in order, 40 writes of 4000 bytes, each walking on from
; the cluster the last ended in: read back as written, and the metadata
; on the disk as fs has it.
(def test_write_in_order () int
  (let f (writes_of (ran_fs (run (two) (reqs1 "open 2 /Volumes/data/big"))) 1 40)
    (add (check_true "read back" (eq (read_back f "/Volumes/data/big") (pieces_of 40 (nil int))))
         (check_true "on the disk" (meta_kept f 0)))))

; f after n writes to handle h of the pattern's first 4000 bytes.
(def writes_of ((f Fs) (h int) (n int)) Fs
  (if (eq n 0) f (writes_of (after (obey f 5 (append "write " (append (digits h) (append " " (pattern 4000)))))) h (sub n 1))))

; The pattern's first 4000 bytes, n times, onto acc.
(def pieces_of ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (pieces_of (sub n 1) (append (pattern 4000) acc))))

; ------------------------------------------------- the metadata written

; Whether volume vi on f's disk, all of its sectors, its metadata and
; directories, reads back as f has it.
(def meta_kept ((f Fs) (vi int)) bool
  (let v (fs_vol f vi)
    (match (vol_of (vol_label v) (vol_layout_of v)
                   (bytes_from_list (sectors f (fs_start f vi) (match (vol_layout_of v) ((VolLayout n c t d) n)))))
      ((VolGot w) (eq w v))
      ((VolBad why) false))))

; Made, written, emptied, replaced by a rename and removed: what is on
; the disk is what fs has, each change writing only its own sectors.
(def test_meta_kept () int
  (let r (run (two) (append (written_notes)
                            (append (reqs4 "open 2 /Volumes/data/b" (append "write 2 " (pattern 9000)) "close 2" "open 2 /Volumes/data/notes")
                                    (reqs3 "close 3" "rename /Volumes/data/b /Volumes/data/notes" "remove /Volumes/data/notes"))))
    (add (check_str "answers" (ran_text r) "1:|10:|0:|2:|9000:|0:|3:|0:|0:|0:")
         (check_true "on the disk" (meta_kept (ran_fs r) 0)))))

; A write of a new file's first bytes: the data, then the table's sector
; and the root directory's first, 1 and 8, which are close, in one
; request.
(def test_write_requests () int
  (let f (ran_fs (run (two) (reqs1 "open 2 /Volumes/data/notes")))
    (check_int "two" (sub (requests (after (obey f 5 "write 1 hello"))) (requests f)) 2)))

; On a volume of 33 clusters of metadata, a write is three requests, not
; the 33 of all of it: the data, a sector of the table, one of the
; directory; and the disk then holds what fs has.
(def test_write_big_volume () int
  (let f (ran_fs (run (big_fs) (reqs1 "open 2 /Volumes/big/a")))
    (let g (after (obey f 5 "write 1 hello"))
      (add (check_int "three" (sub (requests g) (requests f)) 3)
           (check_true "on the disk" (meta_kept g 0))))))

; A server of a volume of 2^20 sectors, its metadata on the disk.
(def big_fs () Fs
  (let v (vol_new "big" (vol_layout 1048576))
    (fs_new (put_at (StoreMem ((MapEmpty int (list int))) 1048576 0 0) 0 (vol_meta v)) 7
            (array_from (cons (FsVol 0 0 "" v) (nil FsVol)) (FsVol 0 0 "" v)))))

; Random appends of up to 5000 bytes to two files read back as what was
; written, every one of 40 runs.
(def test_random_appends () int
  (check_int "mismatches" (random_runs 11 40 0) 0))

(def random_runs ((seed int) (left int) (bad int)) int
  (if (eq left 0)
      bad
      (let s1 (rand_next seed)
        (random_runs (rand_next s1) (sub left 1)
                     (if (random_run (ran_fs (run (two) (reqs2 "open 3 /Volumes/data/a" "open 3 /Volumes/data/b"))) s1 6 (nil int) (nil int))
                         bad
                         (add bad 1))))))

; n appends from seed, to handle 1 (file a) or 2 (b), checked against
; what each should hold.
(def random_run ((f Fs) (seed int) (n int) (a (list int)) (b (list int))) bool
  (if (eq n 0)
      (if (if (eq (read_back f "/Volumes/data/a") a) (eq (read_back f "/Volumes/data/b") b) false) (meta_kept f 0) false)
      (let s1 (rand_next seed)
        (let s2 (rand_next s1)
          (let which (rand_below s1 2)
            (let more (pattern (add 1 (rand_below s2 3000)))
              (let g (after (obey f 5 (append "write " (append (digits (add which 1)) (append " " more)))))
                (if (eq which 0)
                    (random_run g s2 (sub n 1) (append a more) b)
                    (random_run g s2 (sub n 1) a (append b more))))))))))

(def read_back ((f Fs) (path (list int))) (list int)
  (match (obey f 5 (append "open 1 " path))
    ((Answered g h bs) (read_all g h (nil int)))))

; ------------------------------------------------------ rename, remove

(def test_rename () int
  (check_str "renamed"
             (answers (append (written_notes) (reqs3 "rename /Volumes/data/notes /Volumes/data/old" "open 1 /Volumes/data/notes" "open 1 /Volumes/data/old")))
             "1:|10:|0:|0:|-3:|2:"))

(def test_rename_refused () int
  (check_str "missing, across, to the volume"
             (answers (append (written_notes) (reqs3 "rename /Volumes/data/x /Volumes/data/y" "rename /Volumes/data/notes /Volumes/scratch/notes" "rename /Volumes/data/notes /Volumes/data")))
             "1:|10:|0:|-3:|-10:|-8:"))

; Renaming onto a file replaces it, and frees its clusters.
(def test_rename_over () int
  (let r (run (two) (append (written_notes) (reqs4 "open 2 /Volumes/data/b" "write 2 bee" "close 2" "rename /Volumes/data/b /Volumes/data/notes")))
    (add (check_str "answers" (ran_text r) "1:|10:|0:|2:|3:|0:|0:")
         (check_str "one file" (answer_text (obey (ran_fs r) 5 "list /Volumes/data")) "1:notes 3\n"))))

(def test_remove () int
  (check_str "removed, then gone"
             (answers (append (written_notes) (reqs2 "remove /Volumes/data/notes" "open 1 /Volumes/data/notes")))
             "1:|10:|0:|0:|-3:"))

(def test_remove_open () int
  (check_str "open, so kept" (answers (reqs2 "open 2 /Volumes/data/a" "remove /Volumes/data/a")) "1:|-4:"))

(def test_remove_refused () int
  (check_str "missing, the volume" (answers (reqs2 "remove /Volumes/data/a" "remove /Volumes/data")) "-3:|-8:"))

; --------------------------------------------------------- directories

; A directory made, a file written in it, and read back by its path.
(def test_mkdir () int
  (check_str "made, written, read"
             (answers (append (reqs4 "mkdir /Volumes/data/bin" "open 2 /Volumes/data/bin/sh" "write 1 shell" "close 1")
                              (reqs2 "open 1 /Volumes/data/bin/sh" "read 2 100")))
             "0:|1:|5:|0:|2:|5:shell"))

(def test_mkdir_refused () int
  (check_str "there, no directory, a bad name, the volume"
             (answers (reqs4 "mkdir /Volumes/data/bin" "mkdir /Volumes/data/bin" "mkdir /Volumes/data/x/y" "mkdir /Volumes/data/.."))
             "0:|-4:|-9:|-5:"))

; Directories nested, and on the disk as fs has them.
(def test_nested () int
  (let r (run (two) (reqs4 "mkdir /Volumes/data/a" "mkdir /Volumes/data/a/b" "open 2 /Volumes/data/a/b/c" "write 1 deep"))
    (add (check_str "answers" (ran_text r) "0:|0:|1:|4:")
         (add (check_str "read" (ran_text (run (ran_fs r) (reqs2 "open 1 /Volumes/data/a/b/c" "read 2 9"))) "2:|4:deep")
              (check_true "on the disk" (meta_kept (ran_fs r) 0))))))

; A directory lists its own entries, a directory's with a /; a file is no
; directory to list.
(def test_list_dir () int
  (let f (ran_fs (run (two) (reqs4 "mkdir /Volumes/data/a" "mkdir /Volumes/data/a/b" "open 2 /Volumes/data/a/x" "close 1")))
    (add (check_str "a" (answer_text (obey f 5 "list /Volumes/data/a")) "2:b/ 0\nx 0\n")
         (add (check_str "the root" (answer_text (obey f 5 "list /Volumes/data")) "1:a/ 0\n")
              (check_str "a file" (answer_text (obey f 5 "list /Volumes/data/a/x")) "-9:")))))

; A directory is not opened, nor written.
(def test_open_dir () int
  (check_str "to read, to write" (answers (reqs3 "mkdir /Volumes/data/a" "open 1 /Volumes/data/a" "open 2 /Volumes/data/a")) "0:|-8:|-8:"))

(def test_stat () int
  (check_str "a directory, a file, nothing, the root"
             (answers (append (reqs4 "mkdir /Volumes/data/a" "open 2 /Volumes/data/n" "write 1 abc" "stat /Volumes/data/a")
                              (reqs3 "stat /Volumes/data/n" "stat /Volumes/data/none" "stat /Volumes/data")))
             "0:|1:|3:|0:dir|0:file 3 -|-3:|0:dir"))

(def test_chmod () int
  (check_str "made a program, then not"
             (answers (append (reqs3 "open 2 /Volumes/data/p" "chmod /Volumes/data/p +x" "stat /Volumes/data/p")
                              (reqs2 "chmod /Volumes/data/p -x" "stat /Volumes/data/p")))
             "1:|0:|0:file 0 x|0:|0:file 0 -"))

(def test_chmod_refused () int
  (check_str "a directory, nothing, a bad mode"
             (answers (reqs4 "mkdir /Volumes/data/a" "chmod /Volumes/data/a +x" "chmod /Volumes/data/n +x" "chmod /Volumes/data/a 7"))
             "0:|-8:|-3:|-5:"))

; The exec flag is kept on the disk. (A byte is written first, so that
; the table is on the disk: two's volumes are only in memory.)
(def test_chmod_kept () int
  (check_true "on the disk" (meta_kept (ran_fs (run (two) (reqs3 "open 2 /Volumes/data/p" "write 1 x" "chmod /Volumes/data/p +x"))) 0)))

; A directory with something in it is kept; empty, it goes, and its
; cluster with it.
(def test_rmdir () int
  (check_str "full, then empty"
             (answers (append (reqs4 "mkdir /Volumes/data/a" "open 2 /Volumes/data/a/x" "close 1" "remove /Volumes/data/a")
                              (reqs3 "remove /Volumes/data/a/x" "remove /Volumes/data/a" "df /Volumes/data")))
             "0:|1:|0:|-4:|0:|0:|0:1528 190 189 0"))

; A file moved between directories, and a handle open on it still
; writing to it.
(def test_move () int
  (check_str "moved, written, read"
             (answers (append (reqs4 "mkdir /Volumes/data/a" "open 2 /Volumes/data/x" "rename /Volumes/data/x /Volumes/data/a/y" "write 1 moved")
                              (reqs3 "open 1 /Volumes/data/x" "open 1 /Volumes/data/a/y" "read 2 9")))
             "0:|1:|0:|5:|-3:|2:|5:moved"))

(def test_move_dir () int
  (let r (run (two) (reqs4 "mkdir /Volumes/data/a" "mkdir /Volumes/data/b" "rename /Volumes/data/a /Volumes/data/b/a" "list /Volumes/data/b"))
    (add (check_str "moved" (ran_text r) "0:|0:|0:|1:a/ 0\n")
         (check_true "on the disk" (meta_kept (ran_fs r) 0)))))

(def test_move_refused () int
  (check_str "into itself, over a directory, a directory over a file"
             (answers (append (reqs4 "mkdir /Volumes/data/a" "mkdir /Volumes/data/b" "open 2 /Volumes/data/f" "close 1")
                              (reqs3 "rename /Volumes/data/a /Volumes/data/a/c" "rename /Volumes/data/f /Volumes/data/b" "rename /Volumes/data/a /Volumes/data/f")))
             "0:|0:|1:|0:|-5:|-8:|-4:"))

; A disk read anew finds directories within directories.
(def test_rescan_nested () int
  (let both (vols2 (data_vol) (scratch_vol))
    (let f (ran_fs (run (serving both both) (reqs4 "mkdir /Volumes/data/a" "mkdir /Volumes/data/a/b" "open 2 /Volumes/data/a/b/c" "write 1 kept")))
      (check_str "the file" (ran_text (run (rescanned_fs (rescan (after (obey f 5 "close 1")))) (reqs2 "open 1 /Volumes/data/a/b/c" "read 2 9")))
                 "2:|4:kept"))))

; ------------------------------------------------------------- volumes

(def test_list () int
  (check_str "by name"
             (answers (append (written_notes) (reqs3 "open 2 /Volumes/data/a" "close 2" "list /Volumes/data")))
             "1:|10:|0:|2:|0:|2:a 0\nnotes 10\n"))

(def test_list_refused () int
  (check_str "no volume" (answers (reqs2 "list /Volumes/x" "list /Volumes/data/notes")) "-3:|-3:"))

; data: 1528 sectors, 191 clusters, 190 of them data, one taken by the
; root directory and one by notes.
(def test_df () int
  (check_str "data" (answers (append (written_notes) (reqs1 "df /Volumes/data"))) "1:|10:|0:|0:1528 190 188 1"))

(def test_format () int
  (check_str "emptied"
             (answers (append (written_notes) (reqs2 "format /Volumes/data" "list /Volumes/data")))
             "1:|10:|0:|0:|0:"))

(def test_format_open () int
  (check_str "a file open" (answers (reqs2 "open 2 /Volumes/data/a" "format /Volumes/data")) "1:|-4:"))

; ---------------------------------------------------------------- rescan

; Volumes as tools/mkdisk makes them, empty, and another in scratch's
; place.
(def data_vol () FsVol (FsVol 0 40 (uuid_text (test_uuid 1)) (vol_new "data" (vol_layout 1496))))
(def scratch_vol () FsVol (FsVol 0 1536 (uuid_text (test_uuid 2)) (vol_new "scratch" (vol_layout 479))))
(def other_vol () FsVol (FsVol 0 1536 (uuid_text (test_uuid 2)) (vol_new "other" (vol_layout 479))))

(def vols2 ((a FsVol) (b FsVol)) (list FsVol) (cons a (cons b (nil FsVol))))

; A 2048-sector disk in memory with vols on it: a GPT of their
; partitions, each volume's metadata where its partition starts.
(def disk_with ((vols (list FsVol))) Store
  (metas_on (table_on (StoreMem ((MapEmpty int (list int))) 2048 0 0) (GptDisk (test_uuid 0) (parts_of vols 1))) vols))

(def table_on ((s Store) (d GptDisk)) Store
  (match (write_table s d) ((Put s2) s2) ((PutNot s2 why) s2)))

; A UUID of version 7 for the tests, the same each run.
(def test_uuid ((n int)) Uuid (uuid_v7 1760000000000 (uuid_noise n 10)))

(def parts_of ((vols (list FsVol)) (n int)) (list GptPart)
  (if (is_empty vols)
      (nil GptPart)
      (match (head vols)
        ((FsVol di start u v)
          (cons (GptPart (gpt_l0fs_type) (test_uuid n) start (match (vol_layout_of v) ((VolLayout s c t d) s)) (vol_label v))
                (parts_of (tail vols) (add n 1)))))))

(def metas_on ((s Store) (vols (list FsVol))) Store
  (if (is_empty vols) s (match (head vols) ((FsVol di start u v) (metas_on (put_at s start (vol_meta v)) (tail vols))))))

; A volume loaded from the disk knows its partition's UUID, to be mounted
; with: data's is the first partition's.
(def test_loaded_uuid () int
  (match (rescan (serving (vols2 (data_vol) (scratch_vol)) (vols2 (data_vol) (scratch_vol))))
    ((Rescanned a labels gone) (check_str "data's" (fs_uuid (after a) 0) (uuid_text (test_uuid 1))))))

(def put_at ((s Store) (sector int) (bs (list int))) Store
  (match (store_write_all s sector bs) ((Put s2) s2) ((PutNot s2 why) s2)))

; A server of vols, on a disk that has ondisk.
(def serving ((vols (list FsVol)) (ondisk (list FsVol))) Fs
  (fs_new (disk_with ondisk) 7 (array_from vols (data_vol))))

; A rescan as text: its answer, a bar, the labels to mount, comma
; separated, a bar, and those to unmount.
(def rescan_text ((r Rescanned)) (list int)
  (match r ((Rescanned a labels gone) (append (answer_text a) (append "|" (append (join_commas labels) (append "|" (join_commas gone))))))))

(def join_commas ((ls (list (list int)))) (list int)
  (if (is_empty ls) "" (if (is_empty (tail ls)) (head ls) (append (head ls) (append "," (join_commas (tail ls)))))))

(def rescanned_fs ((r Rescanned)) Fs (match r ((Rescanned a labels gone) (after a))))

; The same volumes: both served, nothing new to mount, nothing gone.
(def test_rescan_same () int
  (let both (vols2 (data_vol) (scratch_vol))
    (check_str "two, none new" (rescan_text (rescan (serving both both))) "2:data\nscratch\n||")))

; A volume in scratch's place is new; data is not; scratch is gone, to
; be unmounted.
(def test_rescan_new () int
  (check_str "other new"
             (rescan_text (rescan (serving (vols2 (data_vol) (scratch_vol)) (vols2 (data_vol) (other_vol)))))
             "2:data\nother\n|other|scratch"))

; From one volume to two: the second is new, and served.
(def test_rescan_more () int
  (let r (rescan (serving (cons (data_vol) (nil FsVol)) (vols2 (data_vol) (scratch_vol))))
    (add (check_str "scratch new" (rescan_text r) "2:data\nscratch\n|scratch|")
         (check_str "served" (answer_text (obey (rescanned_fs r) 5 "df /Volumes/scratch")) "0:479 58 57 0"))))

; A volume that has gone is answered as no volume of fs's.
(def test_rescan_gone () int
  (let f (rescanned_fs (rescan (serving (vols2 (data_vol) (scratch_vol)) (vols2 (data_vol) (other_vol)))))
    (check_str "scratch gone, other there"
               (ran_text (run f (reqs3 "list /Volumes/scratch" "open 2 /Volumes/scratch/a" "list /Volumes/other")))
               "-3:|-9:|0:")))

; No partitions at all: no volume served.
(def test_rescan_empty () int
  (let r (rescan (serving (vols2 (data_vol) (scratch_vol)) (nil FsVol)))
    (add (check_str "none, both gone" (rescan_text r) "0:||data,scratch")
         (check_str "data gone" (answer_text (obey (rescanned_fs r) 5 "list /Volumes/data")) "-3:"))))

; What a rescan serves is what is on the disk: a file written and
; closed is there after it.
(def test_rescan_reads_disk () int
  (let both (vols2 (data_vol) (scratch_vol))
    (let f (ran_fs (run (serving both both) (written_notes)))
      (check_str "the file" (ran_text (run (rescanned_fs (rescan f)) (reqs2 "open 1 /Volumes/data/notes" "read 2 100")))
                 "2:|10:hello disk"))))

; Refused while a file is open, served once it is closed.
(def test_rescan_open () int
  (let both (vols2 (data_vol) (scratch_vol))
    (add (check_str "open" (ran_text (run (serving both both) (reqs2 "open 2 /Volumes/data/a" "rescan"))) "1:|-4:")
         (check_str "closed" (ran_text (run (serving both both) (reqs3 "open 2 /Volumes/data/a" "close 1" "rescan")))
                    "1:|0:|2:data\nscratch\n"))))

(def test_rescan_words () int
  (check_str "takes none" (answers (reqs1 "rescan /Volumes/data")) "-5:"))

; A server of no volumes, as one that started on a disk with none, finds
; both once they are made, and mounts both.
(def test_rescan_from_none () int
  (let f (fs_new (disk_with (vols2 (data_vol) (scratch_vol))) 7 (vols_array (nil FsVol)))
    (add (check_str "nothing yet" (answer_text (obey f 5 "list /Volumes/data")) "-3:")
         (check_str "both new" (rescan_text (rescan f)) "2:data\nscratch\n|data,scratch|"))))

; ---------------------------------------------------------------- unmount

; Unmounted, a volume is no longer served: requests of it are answered
; as for any volume fs does not have. (Under l0 test there is no kernel,
; whose word, not mounted, fs takes as gone already.)
(def test_unmount () int
  (let both (vols2 (data_vol) (scratch_vol))
    (check_str "scratch gone, data kept"
               (ran_text (run (serving both both) (reqs3 "unmount /Volumes/scratch" "list /Volumes/scratch" "list /Volumes/data")))
               "0:|-3:|0:")))

; Refused while any file is open, and for a volume fs does not serve.
(def test_unmount_refused () int
  (let both (vols2 (data_vol) (scratch_vol))
    (add (check_str "a file open" (ran_text (run (serving both both) (reqs2 "open 2 /Volumes/data/a" "unmount /Volumes/scratch"))) "1:|-4:")
         (check_str "no such volume" (ran_text (run (serving both both) (reqs1 "unmount /Volumes/other"))) "-3:"))))

; Unmounted, it is found again by a rescan, as new.
(def test_unmount_rescan () int
  (let both (vols2 (data_vol) (scratch_vol))
    (let f (ran_fs (run (serving both both) (reqs1 "unmount /Volumes/scratch")))
      (check_str "scratch new again" (rescan_text (rescan f)) "2:data\nscratch\n|scratch|"))))

; ---------------------------------------------------------------- relabel

; scratch relabelled notes: served as notes, no longer as scratch, its
; partition named notes in the table. (Under l0 test there is no kernel
; to mount it, which fs takes as for mkfs's new volume.)
(def test_relabel () int
  (let a (obey (demo_fs) 5 "relabel /Volumes/scratch notes")
    (add (check_str "answered" (answer_text a) "0:notes")
         (add (check_str "named" (table_text (after a)) "[data] 40+1496 [notes] 1536+479 ")
              (check_str "served as notes only"
                         (ran_text (run (after a) (reqs2 "df /Volumes/notes" "list /Volumes/scratch")))
                         "0:479 58 57 0|-3:")))))

; Its superblock says so too: a rescan, which reads every volume from
; its disk again, finds notes, served already, and no scratch.
(def test_relabel_on_disk () int
  (let a (obey (demo_fs) 5 "relabel /Volumes/scratch notes")
    (check_str "read back" (rescan_text (rescan (after a))) "2:data\nnotes\n||")))

; A file open on it stays open, and writes on: the volume keeps its place.
(def test_relabel_open () int
  (check_str "the handle kept"
             (ran_text (run (demo_fs) (reqs4 "open 2 /Volumes/scratch/a" "relabel /Volumes/scratch notes" "write 1 hi" "close 1")))
             "1:|0:notes|2:|0:"))

; Refused: a label that is none, one served already, a volume fs has
; not, and a request without its label.
(def test_relabel_refused () int
  (add (check_str "no label" (answer_text (obey (demo_fs) 5 "relabel /Volumes/scratch a/b")) "-5:a label is 1 to 15 letters, digits, - and _")
       (add (check_str "served" (answer_text (obey (demo_fs) 5 "relabel /Volumes/scratch data")) "-4:that label is served already")
            (add (check_str "no volume" (answer_text (obey (demo_fs) 5 "relabel /Volumes/other notes")) "-3:")
                 (check_str "no new label" (answer_text (obey (demo_fs) 5 "relabel /Volumes/scratch")) "-5:")))))

; ------------------------------------------------------------ partitions

; A server of both volumes, on a disk that has them.
(def demo_fs () Fs (serving (vols2 (data_vol) (scratch_vol)) (vols2 (data_vol) (scratch_vol))))

; A server of nothing, on a blank disk of 2048 sectors.
(def blank_fs () Fs (fs_new (StoreMem ((MapEmpty int (list int))) 2048 0 0) 7 (vols_array (nil FsVol))))

; The bytes of an answer.
(def answer_bytes ((a Answered)) (list int) (match a ((Answered f w bs) bs)))
(def answer_word ((a Answered)) int (match a ((Answered f w bs) w)))

; The table on f's disk, as text: each partition's name, first sector
; and sectors.
(def table_text ((f Fs)) (list int)
  (match (read_table (fs_store f))
    ((NoTable s why) (append "none: " why))
    ((BadTable s why) (append "bad: " why))
    ((Table s d) (gpt_parts_text (gpt_parts d)))))

(def gpt_parts_text ((ps (list GptPart))) (list int)
  (if (is_empty ps) "" (append (gpt_part_text (head ps)) (gpt_parts_text (tail ps)))))

(def gpt_part_text ((p GptPart)) (list int)
  (match p
    ((GptPart t u s c n) (append "[" (append n (append "] " (append (digits s) (append "+" (append (digits c) " ")))))))))

; The 6 free sectors before data: a partition there, and its UUID, of
; version 7, in the answer.
(def test_partition () int
  (let a (obey (demo_fs) 5 "partition disk0 6")
    (add (check_int "made" (answer_word a) 0)
         (add (check_bool "its UUID" (match (uuid_of_text (answer_bytes a)) ((Some u) (eq (uuid_version u) 7)) ((None) false)) true)
              (check_str "in the table, after the two" (table_text (after a)) "[data] 40+1496 [scratch] 1536+479 [] 34+6 ")))))

(def test_partition_refused () int
  (add (check_str "no room" (answer_text (obey (demo_fs) 5 "partition disk0 7")) "-6:no free stretch is that long")
       (add (check_str "on data" (answer_text (obey (demo_fs) 5 "partition disk0 4 100")) "-6:those sectors are not free")
            (check_str "not a number" (answer_text (obey (demo_fs) 5 "partition disk0 six")) "-5:"))))

; A blank disk gets a table, then the partition where asked.
(def test_partition_blank () int
  (let a (obey (blank_fs) 5 "partition disk0 1000 100")
    (add (check_int "made" (answer_word a) 0)
         (check_str "a table of one" (table_text (after a)) "[] 100+1000 "))))

; A partition made, then a volume on it, by its UUID: served, and named.
(def test_mkfs () int
  (let a (obey (blank_fs) 5 "partition disk0 1000")
    (let b (obey (after a) 5 (append "mkfs " (append (answer_bytes a) " new")))
      (add (check_str "made" (answer_text b) "0:new")
           (add (check_str "named" (table_text (after b)) "[new] 34+1000 ")
                (check_str "served" (answer_text (obey (after b) 5 "df /Volumes/new")) "0:1000 124 123 0"))))))

; Made by its UUID, it is found again by a rescan, as at the start.
(def test_mkfs_found () int
  (let a (obey (blank_fs) 5 "partition disk0 500")
    (let b (obey (after a) 5 (append "mkfs " (append (answer_bytes a) " kept")))
      (check_str "rescanned" (rescan_text (rescan (after b))) "1:kept\n||"))))

; ------------------------------------------------------------ two disks

; A partition of a disk the server has not met, and no driver has
; registered: refused, -3, as no such disk.
(def test_partition_unknown_disk () int
  (check_str "refused" (answer_text (obey (demo_fs) 5 "partition disk1 6")) "-3:no disk disk1"))

; attach of a disk taken on already leaves it; of one no driver has
; registered, -3.
(def test_attach () int
  (add (check_str "known" (answer_text (obey (demo_fs) 5 "attach disk0")) "0:0")
       (add (check_str "none" (answer_text (obey (demo_fs) 5 "attach disk1")) "-3:no disk disk1")
            (check_str "no disk named" (answer_text (obey (demo_fs) 5 "attach")) "-5:"))))

; A partition request names its disk, and then its numbers.
(def test_partition_needs_a_disk () int
  (check_str "a number first" (answer_text (obey (demo_fs) 5 "partition 6")) "-5:"))

; Two disks: a blank one first, then one with a partition made on it.
; mkfs finds the partition on the second, makes the volume there, and
; serves it as on disk 1; the first is untouched.
(def test_mkfs_second_disk () int
  (let a (obey (blank_fs) 5 "partition disk0 1000")
    (let f (fs_new_on (cons (StoreMem ((MapEmpty int (list int))) 2048 0 0) (cons (fs_store (after a)) (nil Store))) 7 (vols_array (nil FsVol)))
      (let b (obey f 5 (append "mkfs " (append (answer_bytes a) " new")))
        (add (check_str "made" (answer_text b) "0:new")
             (add (check_int "on disk 1" (fs_vol_disk (after b) 0) 1)
                  (add (check_str "the first untouched" (table_text (after b)) "none: no partition table on the disk")
                       (check_str "served" (answer_text (obey (after b) 5 "df /Volumes/new")) "0:1000 124 123 0"))))))))

; A volume on the second disk is written there: a file made and written
; on it asks nothing more of the first, which mkfs read the table of
; only, looking for the partition, twice: both headers' places.
(def test_second_disk_files () int
  (let a (obey (blank_fs) 5 "partition disk0 1000")
    (let f (fs_new_on (cons (StoreMem ((MapEmpty int (list int))) 2048 0 0) (cons (fs_store (after a)) (nil Store))) 7 (vols_array (nil FsVol)))
      (let m (after (obey f 5 (append "mkfs " (append (answer_bytes a) " new"))))
        (let b (obey m 5 "open 2 /Volumes/new/a")
          (let c (obey (after b) 5 (append "write " (append (digits (answer_word b)) " hello")))
            (add (check_str "written" (answer_text c) "5:")
                 (add (check_int "the first disk's table read" (requests m) 2)
                      (check_int "nothing more asked of it" (requests (after c)) 2)))))))))

; mkfs of uuid and label on f, as text.
(def mkfs_text ((f Fs) (uuid (list int)) (label (list int))) (list int)
  (answer_text (obey f 5 (append "mkfs " (append uuid (append " " label))))))

(def test_mkfs_refused () int
  (let a (obey (demo_fs) 5 "partition disk0 6")
    (let f (after a)
      (let u (answer_bytes a)
        (add (check_str "not a UUID" (mkfs_text f "12" "x") "-5:not a UUID")
             (add (check_str "no such partition" (mkfs_text f (uuid_text (test_uuid 99)) "x") "-3:no partition has that UUID")
                  (add (check_str "data's, served" (mkfs_text f (uuid_text (test_uuid 1)) "x") "-4:its volume is served; format empties it")
                       (add (check_str "a label served" (mkfs_text f u "data") "-4:that label is served already")
                            (add (check_str "a bad label" (mkfs_text f u "a.b") "-5:a label is 1 to 15 letters, digits, - and _")
                                 (check_str "too small" (mkfs_text f u "tiny") "-6:the partition is too small for a volume"))))))))))

; A header with GPT's signature and nothing else right.
(def bad_header () (list int) (append "EFI PART" (zeros 504)))

; A table damaged, both copies, is never written over.
(def test_partition_bad_table () int
  (let f (blank_fs)
    (let s (put_at (put_at (fs_store f) 1 (bad_header)) 2047 (bad_header))
      (check_str "refused" (answer_text (obey (with_store f s) 5 "partition disk0 10")) "-5:a GPT header of another size"))))

; With no volumes fs goes on to serve, rather than giving up with 0; under
; an operating system there is no kernel to register it with, so it fails.
(def test_serves_none () int
  (check_int "tried to register" (found (fs_new (StoreMem ((MapEmpty int (list int))) 2048 0 0) 0 (vols_array (nil FsVol))) (nil FsVol)) 1))

; Under an operating system there is no disk.
(def test_no_disk () int
  (check_int "nothing to serve" (fs) 0))

; ----------------------------------------------------- RAM file system

; A RAM file system as fs ram makes it: tmp, 8 MB, from sector 0, on a
; store of memory, the port 7.
(def ram_fs () Fs
  (let l (vol_layout 16384)
    (let v (vol_new "tmp" l)
      (match (store_write_all (StoreRam ((MapEmpty int bytes)) 16384) 0 (vol_meta v))
        ((PutNot s why) (blank_fs))
        ((Put s) (fs_new s 7 (array_from (cons (FsVol 0 0 (ram_uuid) v) (nil FsVol)) (FsVol 0 0 "" (vol_new "x" (vol_layout 16))))))))))

(def ram_answers ((reqs (list (list int)))) (list int)
  (ran_text (run (ram_fs) reqs)))

(def test_ram_args () int
  (add (check_bool "ram" (ram_requested (split_spaces "ram")) true)
       (add (check_bool "none" (ram_requested (nil (list int))) false)
            (add (check_int "default" (ram_megabytes (split_spaces "ram")) 32)
                 (add (check_int "given" (ram_megabytes (split_spaces "ram 64")) 64)
                      (check_int "too many" (ram_megabytes (split_spaces "ram 9999")) 255))))))

(def test_ram_write_read () int
  (check_str "written, read back, listed"
             (ram_answers (reqs4 "open 2 /Volumes/tmp/a" "write 1 hello ram" "close 1" "list /Volumes/tmp"))
             "1:|9:|0:|1:a 9\n"))

(def test_ram_read_back () int
  (check_str "the bytes"
             (ram_answers (append (reqs3 "open 2 /Volumes/tmp/a" "write 1 hello ram" "close 1") (reqs2 "open 1 /Volumes/tmp/a" "read 2 100")))
             "1:|9:|0:|2:|9:hello ram"))

(def test_ram_directories () int
  (check_str "made, written in, moved"
             (ram_answers (append (reqs3 "mkdir /Volumes/tmp/d" "open 2 /Volumes/tmp/d/n" "write 1 x")
                                  (reqs3 "close 1" "rename /Volumes/tmp/d/n /Volumes/tmp/m" "stat /Volumes/tmp/m")))
             "0:|1:|1:|0:|0:|0:file 1 -"))

; A file of three writes, over three clusters, is its whole size.
(def test_ram_big_file () int
  (let w (append "write 1 " (repeat 3000 97))
    (check_str "9000 bytes"
               (ram_answers (append (reqs4 "open 2 /Volumes/tmp/big" w w w) (reqs2 "close 1" "stat /Volumes/tmp/big")))
               "1:|3000:|3000:|3000:|0:|0:file 9000 -")))

(def test_ram_refuses_tables () int
  (add (check_str "partition" (ram_answers (reqs1 "partition disk0 100")) "-5:a RAM file system has no partition table")
       (add (check_str "attach" (ram_answers (reqs1 "attach disk0")) "-5:a RAM file system has no partition table")
       (add (check_str "rescan" (ram_answers (reqs1 "rescan")) "-5:a RAM file system has no partition table")
            (check_str "mkfs" (ram_answers (reqs1 "mkfs 00000000-0000-7000-8000-000000000000 x")) "-5:a RAM file system has no partition table")))))

; Its sectors are zeros until written, and what is written reads back.
(def test_ram_store () int
  (let s (StoreRam ((MapEmpty int bytes)) 16)
    (match (store_write s 3 (zeros_plus 7))
      ((PutNot s2 why) (fail_because "write" why))
      ((Put s2)
        (match (store_read s2 2 3)
          ((GotNot s3 why) (fail_because "read" why))
          ((Got s3 bs)
            (add (check_int "three sectors" (length bs) 1536)
                 (add (check_int "zero before" (nth bs 511) 0)
                      (check_int "written" (nth bs 512) 7)))))))))

; One sector, its first byte b, the rest zeros.
(def zeros_plus ((b int)) (list int) (cons b (zeros 511)))

(def test_ram_not_a_disk () int
  (add (check_bool "ram" (store_is_ram (StoreRam ((MapEmpty int bytes)) 8)) true)
       (check_bool "memory" (store_is_ram (StoreMem ((MapEmpty int (list int))) 8 0 0)) false)))

(def test_volume_line () int
  (check_str "data" (volume_line "data" 2048 "00000000-0000-7000-8000-000000000001")
    "/Volumes/data: a volume on the partition at sector 2048, UUID 00000000-0000-7000-8000-000000000001"))

; The RAM file system's volume has no partition: it starts at 0.
(def test_volume_line_memory () int
  (check_str "tmp" (volume_line "tmp" 0 "00000000-0000-7000-8000-000000000000")
    "/Volumes/tmp: a volume in memory, UUID 00000000-0000-7000-8000-000000000000"))
