; turns.l0 -- the order fs serves what waits on its port. Each time round
; it takes every message waiting, and serves the notices, from pid 0,
; first, then the requests in the order they came. Pure: fs's serve
; receives, and these choose.

; What waits to be served: the notices, from pid 0, and the requests,
; each in the order it came.
(data Turns (Turns (Queue Message) (Queue Message)))

; Nothing waiting.
(def turns_new () Turns
  (Turns (queue_empty (RecvFailed)) (queue_empty (RecvFailed))))

; t with m, a message received, waiting: a notice if it is from pid 0,
; and otherwise a request.
(def turns_add ((t Turns) (m Message)) Turns
  (match m
    ((RecvFailed) t)
    ((Message from b)
      (match t
        ((Turns ns rs)
          (if (eq from 0)
              (Turns (queue_push ns m) rs)
              (Turns ns (queue_push rs m))))))))

; What to serve next, and what waits after it: the first notice, if
; any waits; else the first request; else nothing.
(data Turn (TurnNotice Message Turns) (TurnRequest Message Turns) (TurnNone))

; The next of t to serve, as Turn says.
(def turns_next ((t Turns)) Turn
  (match t
    ((Turns ns rs)
      (match (queue_pop ns)
        ((Popped m ns2) (TurnNotice m (Turns ns2 rs)))
        ((PopEmpty)
          (match (queue_pop rs)
            ((Popped m rs2) (TurnRequest m (Turns ns rs2)))
            ((PopEmpty) (TurnNone))))))))

; t without pid's requests, once pid has exited: none is served for it.
(def turns_drop ((t Turns) (pid int)) Turns
  (match t
    ((Turns ns rs) (Turns ns (msgs_not_from rs pid (queue_empty (RecvFailed)))))))

; The messages of q not from pid, in order, after acc.
(def msgs_not_from ((q (Queue Message)) (pid int) (acc (Queue Message))) (Queue Message)
  (match (queue_pop q)
    ((PopEmpty) acc)
    ((Popped m q2)
      (msgs_not_from q2 pid (if (eq (msg_from m) pid) acc (queue_push acc m))))))

; The pid a message is from; -1 for none.
(def msg_from ((m Message)) int
  (match m ((Message from b) from) ((RecvFailed) -1)))

; How many requests t holds.
(def turns_requests ((t Turns)) int
  (match t ((Turns ns rs) (queue_size rs))))

; t with every message waiting on port added, as port_try_receive gives
; them, until none is.
(def turns_drained ((t Turns) (port int)) Turns
  (match (port_try_receive port)
    ((RecvFailed) t)
    ((Message from b) (turns_drained (turns_add t (Message from b)) port))))
