; fs.l0 -- the file server, of every disk. Once disk0 has registered, it
; takes on every disk there is, disk0, disk1 and so on (proto/disk.l0),
; reads each one's partition table, mounts each volume of L0S's file
; system on them (user/lib/format/l0fs.l0) at /Volumes/LABEL, all from
; one port, and serves the fs protocol (user/lib/fs.l0) there: the
; kernel's requests for every process's calls on those files, in
; directories at any depth, and list, mkdir, stat, chmod, df, format and
; rescan from programs; partition, of a disk it names, and mkfs, on
; whichever disk has the partition. It also registers the port as fs,
; once every volume is mounted, and serves though no disk has one. A
; rescan takes on any disk registered since, reads every disk's volumes
; again, and mounts any new label; so does a partition of a disk not
; yet taken on.
;
; Started as fs ram [MB], it serves no disk but one volume, tmp, of MB
; megabytes (32 unless given), in its own memory, empty, at /Volumes/tmp,
; and registers as tmpfs, not fs: a second server beside the disk's, or
; on a board with no disk. It has no table: partition, mkfs and rescan
; are refused, and nothing in it outlives it.
;
; Each volume's metadata is kept in memory and written back, after the
; data, whenever it changes: only the sectors that changed. Between a
; write's data and its metadata the disk is flushed, so that its cache
; cannot put the metadata down first. A handle is
; the pid that opened it, which fs watches, dropping its handles when it
; exits; a reader's keeps the cluster it read last, so that a file read
; in order reads each cluster once and walks each link of its chain
; once. The disk is reached through a Store, which in tests is memory
; instead.

; why said on standard error, and a failure.
(def complain ((why (list int))) int (fail_as "fs" why))

; why said, and no failure: there is nothing to serve.
(def nothing_to_serve ((why (list int))) int (info_as "fs" why))

; -------------------------------------------------------------- the store

; Where the sectors are: the disk, through a buffer of a cluster shared
; with its driver; or memory, by sector, for tests, with its sectors, how
; many reads and writes it has been asked, as the disk would, and how
; many flushes. Or the memory of a RAM file system, started as fs ram:
; the sectors written, as bytes, those not written being zeros, and how
; many sectors there are.
(data Store (StoreDisk Disk DiskBuf) (StoreMem (Map int (list int)) int int int) (StoreRam (Map int bytes) int))

; How many sectors the store has: the disk's, or the memory's.
(def store_sectors ((s Store)) int
  (match s ((StoreDisk d b) (disk_sectors d)) ((StoreMem m n r fl) n) ((StoreRam m n) n)))

; Whether s is a RAM file system's, which has no partition table.
(def store_is_ram ((s Store)) bool
  (match s ((StoreDisk d b) false) ((StoreMem m n r fl) false) ((StoreRam m n) true)))

; The name of the disk s is, as its driver registered it; disk0 for
; memory, as in tests, and tmp for a RAM file system.
(def store_name ((s Store)) (list int)
  (match s ((StoreDisk d b) (disk_name_of d)) ((StoreMem m n r fl) (disk_name 0)) ((StoreRam m n) "tmp")))

; Sectors read, and the store after; or why not.
(data Got (Got Store (list int)) (GotNot Store (list int)))

; count sectors from sector, at most a cluster's.
(def store_read ((s Store) (sector int) (count int)) Got
  (match s
    ((StoreMem m n r fl) (Got (StoreMem m n (add r 1) fl) (mem_sectors m sector count (nil int))))
    ((StoreRam m n) (Got s (ram_sectors m sector count (nil int))))
    ((StoreDisk d b)
      (let why (disk_read d b sector count)
        (if (is_empty why)
            (Got s (disk_get b (mul count (vol_sector_size))))
            (GotNot s why))))))

; Sectors count to 1 from sector of m, onto acc: those never written are
; zeros.
(def mem_sectors ((m (Map int (list int))) (sector int) (count int) (acc (list int))) (list int)
  (if (le count 0)
      acc
      (mem_sectors m sector (sub count 1)
                   (append (match (map_get m (add sector (sub count 1)))
                             ((Some bs) bs)
                             ((None) (zeros (vol_sector_size))))
                           acc))))

; Sectors count to 1 from sector of m, a RAM file system's, onto acc, as
; mem_sectors does, as bytes in a list.
(def ram_sectors ((m (Map int bytes)) (sector int) (count int) (acc (list int))) (list int)
  (if (le count 0)
      acc
      (ram_sectors m sector (sub count 1)
                   (append (match (map_get m (add sector (sub count 1)))
                             ((Some b) (bytes_to_list b))
                             ((None) (zeros (vol_sector_size))))
                           acc))))

; Every one of count sectors from sector, a cluster's at a time.
(def store_read_all ((s Store) (sector int) (count int)) Got
  (store_read_from s sector count (nil int)))

(def store_read_from ((s Store) (sector int) (count int) (acc (list int))) Got
  (if (le count 0)
      (Got s (rev acc))
      (let k (min count (vol_cluster_sectors))
        (match (store_read s sector k)
          ((GotNot s2 why) (GotNot s2 why))
          ((Got s2 bs) (store_read_from s2 (add sector k) (sub count k) (rev_onto bs acc)))))))

; The store after a write, or why it failed.
(data Put (Put Store) (PutNot Store (list int)))

; bs, whole sectors, at most a cluster's, written from sector.
(def store_write ((s Store) (sector int) (bs (list int))) Put
  (match s
    ((StoreMem m n r fl) (Put (StoreMem (mem_put m sector bs) n (add r 1) fl)))
    ((StoreRam m n) (Put (StoreRam (ram_put m sector bs) n)))
    ((StoreDisk d b)
      (let p (disk_put b bs)
        (let why (disk_write d b sector (div (length bs) (vol_sector_size)))
          (if (is_empty why) (Put s) (PutNot s why)))))))

; Every write made so far on the disk itself, out of its cache, so that
; none made after reaches the disk before them.
(def store_flush ((s Store)) Put
  (match s
    ((StoreMem m n r fl) (Put (StoreMem m n r (add fl 1))))
    ((StoreRam m n) (Put s))
    ((StoreDisk d b)
      (let why (disk_flush d)
        (if (is_empty why) (Put s) (PutNot s why))))))

(def mem_put ((m (Map int (list int))) (sector int) (bs (list int))) (Map int (list int))
  (if (is_empty bs)
      m
      (mem_put (map_put m sector (take bs (vol_sector_size))) (add sector 1) (drop_n bs (vol_sector_size)))))

; bs, whole sectors, written from sector into m, a RAM file system's.
(def ram_put ((m (Map int bytes)) (sector int) (bs (list int))) (Map int bytes)
  (if (is_empty bs)
      m
      (ram_put (map_put m sector (bytes_from_list (take bs (vol_sector_size)))) (add sector 1) (drop_n bs (vol_sector_size)))))

; bs, whole sectors, written from sector, a cluster's at a time.
(def store_write_all ((s Store) (sector int) (bs (list int))) Put
  (if (is_empty bs)
      (Put s)
      (match (store_write s sector (take bs (vol_cluster_size)))
        ((PutNot s2 why) (PutNot s2 why))
        ((Put s2) (store_write_all s2 (add sector (vol_cluster_sectors)) (drop_n bs (vol_cluster_size)))))))

; ---------------------------------------------------------------- the state

; A volume served: the disk it is on, by its place among the server's
; stores, the sector its partition starts at, the partition's UUID as
; text, which the kernel mounts it with, and the volume.
(data FsVol (FsVol int int (list int) Vol))

; An open file: the pid that opened it, its volume and directory entry,
; where it has read or written to, its mode, 1 to 3 as open's, and the
; cluster it read or wrote last.
(data Handle (Handle int int VolRef int int Held))

; The cluster a handle read last: its place in the file's chain, and the
; file's bytes in it, all of them, which the next read takes from
; memory, finding the cluster after from it. Or only the place, of the
; cluster a writer wrote last, or a reader read before the file was
; written to, which is still that cluster's, since a write only adds to
; the end of a chain; or none, at first and once the file is emptied.
(data Held (Held VolAt bytes) (HeldPlace VolAt) (HeldNone))

; Where a read or write from what h holds finds the file's clusters from.
(def held_at ((h Held)) VolAt
  (match h ((Held a bs) a) ((HeldPlace a) a) ((HeldNone) (vol_at_none))))

; Whether h holds cluster a, need bytes of it at least.
(def holds ((h Held) (a VolAt) (need int)) bool
  (match h ((Held b bs) (if (eq b a) (ge (bytes_len bs) need) false)) ((HeldPlace b) false) ((HeldNone) false)))

; The bytes h holds from i up to j.
(def held_range ((h Held) (i int) (j int)) (list int)
  (match h ((Held a bs) (bytes_range bs i j)) ((HeldPlace a) (nil int)) ((HeldNone) (nil int))))

; What h holds once its file is written to: the place, not the bytes.
(def held_written ((h Held)) Held
  (match h ((Held a bs) (HeldPlace a)) ((HeldPlace a) h) ((HeldNone) h)))

; The server: its stores, a disk each, in the order it found them, its
; port, its volumes, the open files by handle, the next handle to give,
; the pids it watches, and a port of its own the clock answers on, 0
; until it is first asked the time.
(data Fs (Fs (array Store) int (array FsVol) (Map int Handle) int (list int) int))

; A server of vols on one store, on port, with nothing open; and of vols
; on the stores ss.
(def fs_new ((s Store) (port int) (vols (array FsVol))) Fs
  (fs_new_on (cons s (nil Store)) port vols))
(def fs_new_on ((ss (list Store)) (port int) (vols (array FsVol))) Fs
  (Fs (array_from ss (StoreRam ((MapEmpty int bytes)) 0)) port vols ((MapEmpty int Handle)) 1 (nil int) 0))

; Its volumes and handles; volume vi, the disk it is on, and the sector
; its partition starts at.
(def fs_vols ((f Fs)) (array FsVol) (match f ((Fs s port vols hs next ws cp) vols)))
(def fs_handles ((f Fs)) (Map int Handle) (match f ((Fs s port vols hs next ws cp) hs)))

; Volume vi, the place of its disk among the stores, its partition's
; start, and its UUID.
(def fs_vol ((f Fs) (vi int)) Vol (match (array_get (fs_vols f) vi) ((FsVol di start u v) v)))
(def fs_vol_disk ((f Fs) (vi int)) int (match (array_get (fs_vols f) vi) ((FsVol di start u v) di)))
(def fs_start ((f Fs) (vi int)) int (match (array_get (fs_vols f) vi) ((FsVol di start u v) start)))
(def fs_uuid ((f Fs) (vi int)) (list int) (match (array_get (fs_vols f) vi) ((FsVol di start u v) u)))

; Its stores; store di, and f with s2 in its place; volume vi's store,
; and f with s2 in its place.
(def fs_stores ((f Fs)) (array Store) (match f ((Fs s port vols hs next ws cp) s)))
(def fs_store_at ((f Fs) (di int)) Store (array_get (fs_stores f) di))
(def with_store_at ((f Fs) (di int) (s2 Store)) Fs
  (match f ((Fs s port vols hs next ws cp) (Fs (array_set s di s2) port vols hs next ws cp))))
(def vol_store ((f Fs) (vi int)) Store (fs_store_at f (fs_vol_disk f vi)))
(def with_vol_store ((f Fs) (vi int) (s2 Store)) Fs (with_store_at f (fs_vol_disk f vi) s2))

; f with other handles.
(def with_handles ((f Fs) (h2 (Map int Handle))) Fs
  (match f ((Fs s port vols hs next ws cp) (Fs s port vols h2 next ws cp))))

; f serving vols in place of its volumes.
(def with_vols ((f Fs) (vols2 (list FsVol))) Fs
  (match f ((Fs s port vols hs next ws cp) (Fs s port (vols_array vols2) hs next ws cp))))

; vols as an array, which may be empty.
(def vols_array ((vols (list FsVol))) (array FsVol)
  (array_from vols (FsVol 0 0 "" (vol_new "x" (vol_layout 16)))))

; f with v as volume vi, in memory only.
(def with_vol ((f Fs) (vi int) (v Vol)) Fs
  (match f ((Fs s port vols hs next ws cp) (Fs s port (array_set vols vi (FsVol (fs_vol_disk f vi) (fs_start f vi) (fs_uuid f vi) v)) hs next ws cp))))

; f with handle h open, from pid, on entry ei of volume vi; and h. pid is
; watched from its first open, so its handles go when it exits.
(data Opened (Opened Fs int))

(def open_handle ((f Fs) (pid int) (vi int) (ei VolRef) (mode int)) Opened
  (match f
    ((Fs s port vols hs next ws cp)
      (let ws2 (if (any_eq pid ws) ws (watched pid port ws))
        (Opened (Fs s port vols (map_put hs next (Handle pid vi ei 0 mode (HeldNone))) (add next 1) ws2 cp) next)))))

; ws, with pid if it can be watched.
(def watched ((pid int) (port int) (ws (list int))) (list int)
  (match (proc_watch pid port)
    ((Watched) (cons pid ws))
    ((WatchNoProc) ws)
    ((WatchFull) ws)))

; Handle h, if pid opened it.
(def handle_of ((f Fs) (pid int) (h int)) (Option Handle)
  (match (map_get (fs_handles f) h)
    ((None) ((None Handle)))
    ((Some x) (match x ((Handle p vi ei off mode held) (if (eq p pid) (Some x) ((None Handle))))))))

; Whether any handle is open on entry ei of volume vi.
(def is_open ((f Fs) (vi int) (ei VolRef)) bool
  (any_open (map_values (fs_handles f)) vi ei false))

; Whether any handle is open on any of volume vi's files.
(def is_open_on ((f Fs) (vi int)) bool
  (any_open (map_values (fs_handles f)) vi (VolRef 0 0) true))

(def any_open ((hs (list Handle)) (vi int) (ei VolRef) (any bool)) bool
  (if (is_empty hs)
      false
      (match (head hs)
        ((Handle p v e off mode held)
          (if (if (eq v vi) (if any true (eq e ei)) false) true (any_open (tail hs) vi ei any))))))

; f without pid's handles, pid having exited.
(def forget_pid ((f Fs) (pid int)) Fs
  (match f
    ((Fs s port vols hs next ws cp)
      (Fs s port vols (drop_handles hs (map_keys hs) pid) next (drop_int ws pid) cp))))

(def drop_handles ((hs (Map int Handle)) (keys (list int)) (pid int)) (Map int Handle)
  (if (is_empty keys)
      hs
      (drop_handles (match (map_get hs (head keys))
                      ((Some x) (match x ((Handle p vi ei off mode held) (if (eq p pid) (map_remove hs (head keys)) hs))))
                      ((None) hs))
                    (tail keys) pid)))

; f with the handles on entry ei of volume vi holding no bytes of it, its
; file having been written to, but their places; or, emptied, nothing.
(def unheld ((f Fs) (vi int) (ei VolRef) (emptied bool)) Fs
  (with_handles f (unheld_in (fs_handles f) (map_keys (fs_handles f)) vi ei emptied)))

(def unheld_in ((hs (Map int Handle)) (keys (list int)) (vi int) (ei VolRef) (emptied bool)) (Map int Handle)
  (if (is_empty keys)
      hs
      (unheld_in (match (map_get hs (head keys))
                   ((Some x)
                     (match x
                       ((Handle p v e off mode held)
                         (if (if (eq v vi) (eq e ei) false)
                             (map_put hs (head keys) (Handle p v e off mode (if emptied (HeldNone) (held_written held))))
                             hs))))
                   ((None) hs))
                 (tail keys) vi ei emptied)))

(def drop_int ((xs (list int)) (x int)) (list int)
  (if (is_empty xs) xs (if (eq (head xs) x) (drop_int (tail xs) x) (cons (head xs) (drop_int (tail xs) x)))))

; f with volume vi's metadata v written to the disk and kept; or as it
; was, and -5, if the write failed.
(data Committed (Committed Fs) (CommitFailed Fs))

; All of v's metadata written, as format must.
(def commit ((f Fs) (vi int) (v Vol)) Committed
  (committed f vi v (store_write_all (vol_store f vi) (fs_start f vi) (vol_meta v))))

; Only the sectors of v's metadata and directories that hold the marks
; of clusters cs and the entries es written, which must be all that
; changed: those close together in one request, as vol_runs puts them.
(def commit_some ((f Fs) (vi int) (v Vol) (cs (list int)) (es (list VolRef))) Committed
  (committed f vi v (write_runs (vol_store f vi) (fs_start f vi) v (vol_runs (vol_dirty_sectors v cs es)))))

; The one entry r, as commit_some takes the entries that changed.
(def one ((r VolRef)) (list VolRef) (cons r (nil VolRef)))

(def committed ((f Fs) (vi int) (v Vol) (p Put)) Committed
  (match p
    ((Put s2) (Committed (with_vol (with_vol_store f vi s2) vi v)))
    ((PutNot s2 why) (CommitFailed (with_vol_store f vi s2)))))

; Each run of v's metadata written, the volume's partition from start.
(def write_runs ((s Store) (start int) (v Vol) (rs (list VolRun))) Put
  (if (is_empty rs)
      (Put s)
      (match (head rs)
        ((VolRun first n)
          (match (store_write s (add start first) (vol_run_bytes v (head rs)))
            ((PutNot s2 why) (PutNot s2 why))
            ((Put s2) (write_runs s2 start v (tail rs))))))))

; ---------------------------------------------------------------- paths

; Where a path is: a name in directory dc of volume vi, whether or not
; it is there; volume vi itself, its root; or nothing of fs's, and the
; code that says so.
(data Target (TFile int int (list int)) (TVolume int) (TNone int))

; The target path names, writing or not: nothing past /Volumes/LABEL is a
; volume of fs's, nor a name in a directory that is missing or a file:
; -3 or, to write, -9.
(def target ((f Fs) (path (list int)) (writing bool)) Target
  (let missing (if writing -9 -3)
    (if (not (starts_with path "/Volumes/"))
        (TNone missing)
        (let rest (drop_n path 9)
          (let label (up_to 47 rest)
            (let vi (vol_index (fs_vols f) label 0)
              (if (lt vi 0)
                  (TNone missing)
                  (match (vol_place (fs_vol f vi) (vol_path_names (drop_n rest (length label))))
                    ((VolTop) (TVolume vi))
                    ((VolIn dc name) (TFile vi dc name))
                    ((VolNowhere) (TNone missing))))))))))

; What a path names in a volume: a file or a directory there, by its
; entry; the volume's root; nothing there, though its directory is, -3;
; or nowhere, with the code that says so.
(data Found (FoundAt int VolRef VolEntry) (FoundRoot int) (FoundNone int int (list int)) (FoundNowhere int))

; What path names, as target finds it.
(def found_at ((f Fs) (path (list int)) (writing bool)) Found
  (match (target f path writing)
    ((TNone code) (FoundNowhere code))
    ((TVolume vi) (FoundRoot vi))
    ((TFile vi dc name)
      (let i (vol_find (fs_vol f vi) dc name)
        (if (lt i 0)
            (FoundNone vi dc name)
            (FoundAt vi (VolRef dc i) (vol_entry (fs_vol f vi) (VolRef dc i))))))))

; Whether e is a directory.
(def is_dir_entry ((e VolEntry)) bool
  (match e ((VolDir name first) true) ((VolFile name size first exec) false) ((VolNone) false)))

; The volume of vols labelled label, from i, or -1.
(def vol_index ((vols (array FsVol)) (label (list int)) (i int)) int
  (if (ge i (array_len vols))
      -1
      (match (array_get vols i)
        ((FsVol di start u v) (if (eq (vol_label v) label) i (vol_index vols label (add i 1)))))))

; ------------------------------------------------------------- answering

; f after a request, and its reply: the word and the bytes after it.
(data Answered (Answered Fs int (list int)))

(def word ((f Fs) (w int)) Answered (Answered f w (nil int)))

; What the request body from pid asks done.
(def obey ((f Fs) (pid int) (body (list int))) Answered
  (let op (up_to 32 body)
    (let rest (drop_n body (add (length op) 1))
      (if (eq op "write")
          (obey_write f pid rest)
          (obey_words f pid op (split_spaces rest))))))

; write H BYTES: the handle, then every byte after its space.
(def obey_write ((f Fs) (pid int) (rest (list int))) Answered
  (let h (up_to 32 rest)
    (if (not (is_number h))
        (word f -5)
        (do_write f pid (int_prefix h 0) (drop_n rest (add (length h) 1))))))

(def obey_words ((f Fs) (pid int) (op (list int)) (ws (list (list int)))) Answered
  (let n (length ws)
    (if (if (eq op "open") (eq n 2) false) (obey_open f pid (head ws) (head (tail ws)))
    (if (if (eq op "read") (eq n 2) false) (obey_read f pid (head ws) (head (tail ws)))
    (if (if (eq op "close") (eq n 1) false) (obey_close f pid (head ws))
    (if (if (eq op "rename") (eq n 2) false) (do_rename f (head ws) (head (tail ws)))
    (if (if (eq op "chmod") (eq n 2) false) (do_chmod f (head ws) (head (tail ws)))
    (obey_volumes f op ws))))))))

(def obey_volumes ((f Fs) (op (list int)) (ws (list (list int)))) Answered
  (if (if (store_is_ram (fs_store_at f 0)) (any_eq op (split_spaces "partition mkfs rescan attach relabel")) false)
      (Answered f -5 "a RAM file system has no partition table")
      (obey_volumes_disk f op ws)))

; The same on a disk.
(def obey_volumes_disk ((f Fs) (op (list int)) (ws (list (list int)))) Answered
  (if (eq op "partition") (obey_partition f ws)
  (if (eq op "attach") (if (eq (length ws) 1) (do_attach f (head ws)) (word f -5))
  (if (eq op "mkfs") (if (eq (length ws) 2) (do_mkfs f (head ws) (head (tail ws))) (word f -5))
  (if (eq op "relabel") (if (eq (length ws) 2) (do_relabel f (head ws) (head (tail ws))) (word f -5))
  (obey_volume f op ws))))))

; A request of a volume, or rescan.
(def obey_volume ((f Fs) (op (list int)) (ws (list (list int)))) Answered
  (if (eq op "rescan")
      (if (is_empty ws) (do_rescan f) (word f -5))
  (if (not (eq (length ws) 1))
      (word f -5)
      (if (eq op "remove") (do_remove f (head ws))
      (obey_path f op (head ws))))))

; A request of one path: of a directory, a file, or a volume.
(def obey_path ((f Fs) (op (list int)) (path (list int))) Answered
  (if (eq op "list") (do_list f path)
  (if (eq op "mkdir") (do_mkdir f path)
  (if (eq op "stat") (do_stat f path)
  (if (eq op "df") (do_df f path)
  (if (eq op "format") (do_format f path)
  (if (eq op "unmount") (do_unmount f path)
  (word f -5))))))))

(def obey_open ((f Fs) (pid int) (mode (list int)) (path (list int))) Answered
  (let m (if (is_number mode) (int_prefix mode 0) 0)
    (if (not (any_eq m (cons 1 (cons 2 (cons 3 (nil int))))))
        (word f -5)
        (do_open f pid m path))))

(def obey_read ((f Fs) (pid int) (h (list int)) (n (list int))) Answered
  (if (if (is_number h) (is_number n) false)
      (do_read f pid (int_prefix h 0) (int_prefix n 0))
      (word f -5)))

(def obey_close ((f Fs) (pid int) (h (list int))) Answered
  (if (not (is_number h))
      (word f -5)
      (match (handle_of f pid (int_prefix h 0))
        ((None) (word f -5))
        ((Some x) (word (with_handles f (map_remove (fs_handles f) (int_prefix h 0))) 0)))))

; ------------------------------------------------------------------ open

; path opened by pid in mode m: to read, a file there; to write, it
; emptied (2) or kept (3), and made if it is not there.
(def do_open ((f Fs) (pid int) (m int) (path (list int))) Answered
  (match (found_at f path (not (eq m 1)))
    ((FoundNowhere code) (word f code))
    ((FoundRoot vi) (word f -8))
    ((FoundNone vi dc name) (if (eq m 1) (word f -3) (open_new f pid vi dc name m)))
    ((FoundAt vi r e)
      (if (is_dir_entry e)
          (word f -8)
          (if (eq m 1)
              (match (open_handle f pid vi r 1) ((Opened f2 h) (word f2 h)))
              (opened_write (if (eq m 2) (emptied f vi (fs_vol f vi) r) (Committed f)) pid vi r m))))))

; A new file name made in directory dc of volume vi, and opened. A name
; the volume cannot hold is -5; a directory with no room to grow, -6.
(def open_new ((f Fs) (pid int) (vi int) (dc int) (name (list int)) (m int)) Answered
  (if (not (vol_name_ok name))
      (word f -5)
      (match (vol_slot (fs_vol f vi) dc)
        ((VolNoSlot) (word f -6))
        ((VolSlot v r cs rs) (opened_write (commit_some f vi (vol_create v r name) cs (cons r rs)) pid vi r m)))))

; The file at ei of v, volume vi, emptied, and no longer held by its
; readers.
(def emptied ((f Fs) (vi int) (v Vol) (ei VolRef)) Committed
  (commit_some (unheld f vi ei true) vi (vol_truncate v ei) (vol_file_clusters v ei) (one ei)))

(def opened_write ((c Committed) (pid int) (vi int) (ei VolRef) (m int)) Answered
  (match c
    ((CommitFailed f) (word f -5))
    ((Committed f) (match (open_handle f pid vi ei m) ((Opened f2 h) (word f2 h))))))

; ------------------------------------------------------------------ read

; At most n bytes of handle h, pid's, from where it is, and no more than
; a reply holds with its word: across the end of a cluster, if they go
; on, so that reads of as much as a reply holds go on a whole reply at a
; time, rather than one ending each cluster with the few bytes left.
(def do_read ((f Fs) (pid int) (h int) (n int)) Answered
  (match (handle_of f pid h)
    ((None) (word f -5))
    ((Some x)
      (match x
        ((Handle p vi ei off mode held)
          (if (not (eq mode 1))
              (word f -5)
              (read_on f h x (min n (sub (max_message) 4)) (nil int))))))))

; Handle h, x, read on for n bytes more, a cluster's at a time, onto acc,
; reversed: the bytes, once the file or n ends, and x moved past them.
(def read_on ((f Fs) (h int) (x Handle) (n int) (acc (list int))) Answered
  (match x
    ((Handle p vi ei off mode held)
      (match (if (le n 0) ((None VolSpan)) (vol_read_span (fs_vol f vi) ei off n (held_at held)))
        ((None) (read_done f h x acc))
        ((Some span) (read_piece f h x n acc span))))))

; The bytes read, acc reversed, and handle h moved to x.
(def read_done ((f Fs) (h int) (x Handle) (acc (list int))) Answered
  (Answered (with_handles f (map_put (fs_handles f) h x)) (length acc) (rev acc)))

; The bytes of span read on from what x holds, or its cluster read and
; held in its place; -5 if the disk fails before any bytes are read, and
; those read if after.
(def read_piece ((f Fs) (h int) (x Handle) (n int) (acc (list int)) (span VolSpan)) Answered
  (match x
    ((Handle p vi ei off mode held)
      (match span
        ((VolSpan c at k)
          (match (fetch f vi ei (VolAt (div off (vol_cluster_size)) c) held (add at k))
            ((FetchFailed f2) (if (is_empty acc) (word f2 -5) (read_done f2 h x acc)))
            ((Fetched f2 held2)
              (read_on f2 h (Handle p vi ei (add off k) mode held2) (sub n k)
                       (rev_onto (held_range held2 at (add at k)) acc)))))))))

; What holds cluster a of the file at ei of volume vi, need bytes of it:
; held, if it holds them, or else the file's bytes in the cluster read
; from as few sectors as hold them, to be held in its place.
(data Fetched (Fetched Fs Held) (FetchFailed Fs))

(def fetch ((f Fs) (vi int) (ei VolRef) (a VolAt) (held Held) (need int)) Fetched
  (if (holds held a need)
      (Fetched f held)
      (match a
        ((VolAt k c)
          (let bytes_in (vol_held (fs_vol f vi) ei k)
            (match (store_read (vol_store f vi) (vol_cluster_sector (fs_start f vi) c) (ceil_div bytes_in (vol_sector_size)))
              ((GotNot s2 why) (FetchFailed (with_vol_store f vi s2)))
              ((Got s2 bs) (Fetched (with_vol_store f vi s2) (Held a (bytes_from_list (take bs bytes_in)))))))))))

; ----------------------------------------------------------------- write

; data written to handle h, pid's: from where it is, or for mode 3 at
; the file's end; all of it, or -6 if the volume has no room.
(def do_write ((f Fs) (pid int) (h int) (bs (list int))) Answered
  (match (handle_of f pid h)
    ((None) (word f -5))
    ((Some x)
      (match x
        ((Handle p vi ei off mode held)
          (if (eq mode 1)
              (word f -5)
              (match (vol_entry (fs_vol f vi) ei)
                ((VolNone) (word f -5))
                ((VolDir name first) (word f -5))
                ((VolFile name size first exec)
                  (let at (if (eq mode 3) size (min off size))
                    (match (vol_write (fs_vol f vi) ei at (length bs) (held_at held))
                      ((VolNoSpace) (word f -6))
                      ((VolWrote v2 spans fresh marked) (written f h x at size bs v2 spans fresh marked))))))))))))

; The spans written and flushed, then the metadata that changed, the
; marks of the clusters linked and the entry, if its size or first
; cluster did; the handle moved past the bytes, holding the place of the
; cluster it wrote last, for the next write to walk on from, and the
; file's readers holding none of its bytes. The flush keeps the disk from
; putting the metadata down before the data it points at.
(def written ((f Fs) (h int) (x Handle) (at int) (size int) (bs (list int)) (v2 Vol) (spans (list VolSpan)) (fresh (list int)) (marked (list int))) Answered
  (match x
    ((Handle p vi ei off mode held)
      (match (flushed_after (write_spans (vol_store f vi) (fs_start f vi) spans bs fresh at size))
        ((PutNot s2 why) (word (unheld (with_vol_store f vi s2) vi ei false) -5))
        ((Put s2)
          (match (commit_some (unheld (with_vol_store f vi s2) vi ei false) vi v2 marked
                              (if (eq (vol_entry v2 ei) (vol_entry (fs_vol f vi) ei)) (nil VolRef) (one ei)))
            ((CommitFailed f2) (word f2 -5))
            ((Committed f2)
              (word (with_handles f2 (map_put (fs_handles f2) h (Handle p vi ei (add at (length bs)) mode (HeldPlace (vol_spans_end spans at (length bs))))))
                    (length bs)))))))))

; The store flushed once p's writes have been made; p, if they failed.
(def flushed_after ((p Put)) Put
  (match p ((Put s) (store_flush s)) ((PutNot s why) p)))

; Each span of data written, the bytes of the file from at. A span's
; sectors are read first only where they hold the file's bytes that
; stay: before it in its first sector, or after it in its last, within
; the old size; never in a cluster just taken.
(def write_spans ((s Store) (start int) (spans (list VolSpan)) (bs (list int)) (fresh (list int)) (at int) (size int)) Put
  (if (is_empty spans)
      (Put s)
      (match (head spans)
        ((VolSpan c off k)
          (match (write_span s start c off (take bs k) (any_eq c fresh) (lt (add at k) size))
            ((PutNot s2 why) (PutNot s2 why))
            ((Put s2) (write_spans s2 start (tail spans) (drop_n bs k) fresh (add at k) size)))))))

(def write_span ((s Store) (start int) (c int) (off int) (piece (list int)) (fresh bool) (more bool)) Put
  (let ss (vol_sector_size)
    (let s0 (div off ss)
      (let end (add off (length piece))
        (let count (add (sub (div (sub end 1) ss) s0) 1)
          (let sector (add (vol_cluster_sector start c) s0)
            (let keep (if fresh false (if (not (eq (mod off ss) 0)) true (if more (not (eq (mod end ss) 0)) false)))
              (match (if keep (store_read s sector count) (Got s (zeros (mul count ss))))
                ((GotNot s2 why) (PutNot s2 why))
                ((Got s2 old) (store_write s2 sector (splice old (sub off (mul s0 ss)) piece)))))))))))

; old with piece in place of its bytes from i.
(def splice ((old (list int)) (i int) (piece (list int))) (list int)
  (append (take old i) (append piece (drop_n old (add i (length piece))))))

; ----------------------------------------------------- rename and remove

; The file or directory at a named b, in one volume: a file there already
; replaced, unless it is open; a directory there is -8, and a directory
; moved into itself, or over a file, refused. In its own directory it
; keeps its entry; moved to another, its open handles follow it.
(def do_rename ((f Fs) (a (list int)) (b (list int))) Answered
  (match (found_at f a false)
    ((FoundNowhere code) (word f code))
    ((FoundRoot vi) (word f -5))
    ((FoundNone vi dc name) (word f -3))
    ((FoundAt vi r e)
      (match (target f b true)
        ((TNone code) (word f code))
        ((TVolume wi) (word f -8))
        ((TFile wi dc to)
          (if (not (eq wi vi))
              (word f -10)
              (if (not (vol_name_ok to))
                  (word f -5)
                  (if (moves_into (fs_vol f vi) e dc)
                      (word f -5)
                      (rename_onto f vi r e dc to)))))))))

; Whether e is a directory that dc is, or is in.
(def moves_into ((v Vol) (e VolEntry) (dc int)) bool
  (match e ((VolDir name first) (vol_under v first dc)) ((VolFile name size first exec) false) ((VolNone) false)))

; The entry r, e, of volume vi named to in directory dc.
(def rename_onto ((f Fs) (vi int) (r VolRef) (e VolEntry) (dc int) (to (list int))) Answered
  (let v (fs_vol f vi)
    (let i (vol_find v dc to)
      (if (lt i 0)
          (rename_new f vi r dc to)
          (rename_over f vi r e (VolRef dc i) to)))))

; Over the entry old, which is there.
(def rename_over ((f Fs) (vi int) (r VolRef) (e VolEntry) (old VolRef) (to (list int))) Answered
  (let v (fs_vol f vi)
    (if (eq old r)
        (word f 0)
        (if (is_dir_entry (vol_entry v old))
            (word f -8)
            (if (if (is_dir_entry e) true (is_open f vi old))
                (word f -4)
                (rename_done f vi r old (vol_move (vol_remove v old) r old to) (vol_file_clusters v old) (nil VolRef)))))))

; To a name not there: in place, in r's own directory; else to a free
; entry of dc, which may grow for it.
(def rename_new ((f Fs) (vi int) (r VolRef) (dc int) (to (list int))) Answered
  (match r
    ((VolRef rd ri)
      (if (eq rd dc)
          (rename_done f vi r r (vol_move (fs_vol f vi) r r to) (nil int) (nil VolRef))
          (match (vol_slot (fs_vol f vi) dc)
            ((VolNoSlot) (word f -6))
            ((VolSlot v s cs rs) (rename_done f vi r s (vol_move v r s to) cs rs)))))))

; The rename committed: v, its marks cs and entries rs changed besides r
; and to, and the handles on r moved to to.
(def rename_done ((f Fs) (vi int) (r VolRef) (to VolRef) (v Vol) (cs (list int)) (rs (list VolRef))) Answered
  (match (commit_some f vi v cs (cons r (cons to rs)))
    ((CommitFailed f2) (word f2 -5))
    ((Committed f2) (word (with_handles f2 (rehandled (fs_handles f2) (map_keys (fs_handles f2)) vi r to)) 0))))

; hs with those on entry r of volume vi on to instead.
(def rehandled ((hs (Map int Handle)) (keys (list int)) (vi int) (r VolRef) (to VolRef)) (Map int Handle)
  (if (is_empty keys)
      hs
      (rehandled (match (map_get hs (head keys))
                   ((Some x)
                     (match x
                       ((Handle p v e off mode held)
                         (if (if (eq v vi) (eq e r) false) (map_put hs (head keys) (Handle p v to off mode held)) hs))))
                   ((None) hs))
                 (tail keys) vi r to)))

; The file at path gone, unless it is open; or the directory, unless it
; has anything in it.
(def do_remove ((f Fs) (path (list int))) Answered
  (match (found_at f path false)
    ((FoundNowhere code) (word f code))
    ((FoundRoot vi) (word f -8))
    ((FoundNone vi dc name) (word f -3))
    ((FoundAt vi r e)
      (if (if (is_dir_entry e) (not (vol_dir_empty (fs_vol f vi) (dir_first e))) (is_open f vi r))
          (word f -4)
          (match (commit_some f vi (vol_remove (fs_vol f vi) r) (vol_file_clusters (fs_vol f vi) r) (one r))
            ((CommitFailed f2) (word f2 -5))
            ((Committed f2) (word f2 0)))))))

; A directory's first cluster; 0 for a file or none.
(def dir_first ((e VolEntry)) int
  (match e ((VolDir name first) first) ((VolFile name size first exec) 0) ((VolNone) 0)))

; ----------------------------------------------------- directories, modes

; A new, empty directory at path: -9 if its directory is not there, -4 if
; something is at path already, -5 for a name the volume cannot hold, -6
; with no room for it.
(def do_mkdir ((f Fs) (path (list int))) Answered
  (match (found_at f path true)
    ((FoundNowhere code) (word f code))
    ((FoundRoot vi) (word f -4))
    ((FoundAt vi r e) (word f -4))
    ((FoundNone vi dc name)
      (if (not (vol_name_ok name))
          (word f -5)
          (match (vol_slot (fs_vol f vi) dc)
            ((VolNoSlot) (word f -6))
            ((VolSlot v r cs rs)
              (match (vol_mkdir v r name)
                ((VolNoRoom) (word f -6))
                ((VolMade v2 c cs2)
                  (match (commit_some f vi v2 (append cs cs2) (cons r (append rs (vol_cluster_refs c 0))))
                    ((CommitFailed f2) (word f2 -5))
                    ((Committed f2) (word f2 0)))))))))))

; What is at path: 0, then dir, or file SIZE and x for a program, - for
; any other file; -3 if nothing is.
(def do_stat ((f Fs) (path (list int))) Answered
  (match (found_at f path false)
    ((FoundNowhere code) (word f code))
    ((FoundRoot vi) (Answered f 0 "dir"))
    ((FoundNone vi dc name) (word f -3))
    ((FoundAt vi r e) (Answered f 0 (stat_text e)))))

(def stat_text ((e VolEntry)) (list int)
  (match e
    ((VolDir name first) "dir")
    ((VolFile name size first exec) (append "file " (append (digits size) (if exec " x" " -"))))
    ((VolNone) "")))

; The file at path made a program, +x, or not, -x: -8 for a directory.
(def do_chmod ((f Fs) (path (list int)) (mode (list int))) Answered
  (if (not (any_eq mode (split_spaces "+x -x")))
      (word f -5)
      (match (found_at f path false)
        ((FoundNowhere code) (word f code))
        ((FoundRoot vi) (word f -8))
        ((FoundNone vi dc name) (word f -3))
        ((FoundAt vi r e)
          (if (is_dir_entry e)
              (word f -8)
              (match (commit_some f vi (vol_set_exec (fs_vol f vi) r (eq mode "+x")) (nil int) (one r))
                ((CommitFailed f2) (word f2 -5))
                ((Committed f2) (word f2 0))))))))

; --------------------------------------------------------------- volumes

; The volume path names, or -3 if it is no volume of fs's.
(def volume_at ((f Fs) (path (list int))) int
  (match (target f path false) ((TVolume vi) vi) ((TFile vi dc name) -3) ((TNone code) -3)))

; The directory at path, a volume's root or another: how many entries it
; has, then each, a directory's name ending in /; -9 for a file.
(def do_list ((f Fs) (path (list int))) Answered
  (match (found_at f path false)
    ((FoundNowhere code) (word f -3))
    ((FoundRoot vi) (listed f vi (vol_root (fs_vol f vi))))
    ((FoundNone vi dc name) (word f -3))
    ((FoundAt vi r e) (if (is_dir_entry e) (listed f vi (dir_first e)) (word f -9)))))

(def listed ((f Fs) (vi int) (dc int)) Answered
  (let es (vol_listing (fs_vol f vi) dc)
    (Answered f (length es) (fs_listing (stats_of es)))))

(def stats_of ((es (list VolEntry))) (list FsStat)
  (if (is_empty es)
      (nil FsStat)
      (match (head es)
        ((VolFile name size first exec) (cons (FsStat name size) (stats_of (tail es))))
        ((VolDir name first) (cons (FsStat (append name "/") 0) (stats_of (tail es))))
        ((VolNone) (stats_of (tail es))))))

(def do_df ((f Fs) (path (list int))) Answered
  (let vi (volume_at f path)
    (if (lt vi 0)
        (word f -3)
        (let v (fs_vol f vi)
          (let l (vol_layout_of v)
            (Answered f 0 (fs_space_text (match l ((VolLayout n c t d) n))
                                         (sub (vol_clusters l) (vol_first_data l))
                                         (vol_free_count (vol_table v))
                                         (vol_file_count v))))))))

; Whether volume vi is /, the system volume: the kernel's mount 0 is
; f's port's, with vi's UUID. Never, with no kernel.
(def is_system ((f Fs) (vi int)) bool
  (match (mount_at 0)
    ((None) false)
    ((Some m)
      (match m
        ((MountInfo path port u)
          (if (eq port (match f ((Fs s p vols hs next ws cp) p))) (eq u (fs_uuid f vi)) false))))))

; The volume emptied, unless a file on it is open, or it is /.
(def do_format ((f Fs) (path (list int))) Answered
  (let vi (volume_at f path)
    (if (lt vi 0)
        (word f -3)
        (if (if (is_open_on f vi) true (is_system f vi))
            (word f -4)
            (match (commit f vi (vol_format (fs_vol f vi)))
              ((CommitFailed f2) (word f2 -5))
              ((Committed f2) (word f2 0)))))))

; unmount VOLUME: the volume no longer served, and /Volumes/LABEL no
; volume, until a rescan finds it again: -3 if it is not fs's, -4 while
; any file is open, since a handle names its volume by where it is among
; them, and for the system volume.
(def do_unmount ((f Fs) (path (list int))) Answered
  (let vi (volume_at f path)
    (if (lt vi 0)
        (word f -3)
        (if (if (gt (map_size (fs_handles f)) 0) true (is_system f vi))
            (word f -4)
            (let label (vol_label (fs_vol f vi))
              (match (fs_unmount label (match f ((Fs s port vols hs next ws cp) port)))
                ((Unmounted) (word (without_vol f vi) 0))
                ((UnmountNotMounted) (word (without_vol f vi) 0))
                ((UnmountDenied) (word f -4))
                ((UnmountBadLabel) (word f -5))))))))

; relabel VOLUME LABEL: the volume called LABEL from then on, as its
; superblock and its partition's name in the table say, and mounted at
; /Volumes/LABEL in place of where it was; its open files stay open, as
; it keeps its place among the volumes. The new label is mounted first,
; so that one mounted already, by any server, changes nothing. Refused
; -3 for no volume of fs's; -5 for a label that is not one; -4 for one
; served already, or mounted, and for the system volume, whose label the
; kernel keeps; -5 if the disk cannot be written, the old label kept.
(def do_relabel ((f Fs) (path (list int)) (label (list int))) Answered
  (let vi (volume_at f path)
    (if (lt vi 0)
        (word f -3)
        (if (not (label_ok label))
            (Answered f -5 "a label is 1 to 15 letters, digits, - and _")
            (if (ge (vol_index (fs_vols f) label 0) 0)
                (Answered f -4 "that label is served already")
                (if (is_system f vi)
                    (Answered f -4 "it is /, the system volume")
                    (relabel_mounting f vi label (fs_mount label (fs_uuid f vi) (fs_port f)))))))))

; The port fs serves on.
(def fs_port ((f Fs)) int (match f ((Fs s port vols hs next ws cp) port)))

; do_relabel once the kernel was asked to mount label: refused if it is
; mounted already, or no label; else written. With no kernel, as under
; test, nothing is mounted, and it is written all the same, as mkfs's
; new volume is.
(def relabel_mounting ((f Fs) (vi int) (label (list int)) (m Mounting)) Answered
  (match m
    ((MountTaken) (Answered f -4 (mounting_why m)))
    ((MountBadLabel) (Answered f -5 (mounting_why m)))
    ((Mounted) (relabel_written f vi label))
    ((MountNoPort) (relabel_written f vi label))))

; Volume vi's superblock written with label, and its partition named it
; in its disk's table, if it has one; the disk flushed; then the old
; label unmounted, and 0 and the label answered. If a write fails, the
; new label is unmounted again, and the volume is as it was.
(def relabel_written ((f Fs) (vi int) (label (list int))) Answered
  (let old (vol_label (fs_vol f vi))
    (let v2 (vol_relabel (fs_vol f vi) label)
      (match (flushed_after (store_write (vol_store f vi) (fs_start f vi) (vol_super label (vol_layout_of v2))))
        ((PutNot s2 why) (relabel_undone (with_vol_store f vi s2) label why))
        ((Put s2)
          (match (relabel_table (with_vol_store f vi s2) vi label)
            ((PutNot s3 why) (relabel_undone (with_vol_store f vi s3) label why))
            ((Put s3)
              (let u (fs_unmount old (fs_port f))
                (let w (info_as "fs" (append "/Volumes/" (append old (append " is /Volumes/" label))))
                  (Answered (with_vol (with_vol_store f vi s3) vi v2) 0 label))))))))))

; Volume vi's partition named label in its disk's table, if the disk has
; a table and it is in it; the store as it was if not, as for a RAM
; file system's.
(def relabel_table ((f Fs) (vi int) (label (list int))) Put
  (let s (vol_store f vi)
    (match (uuid_of_text (fs_uuid f vi))
      ((None) (Put s))
      ((Some u)
        (match (read_table s)
          ((NoTable s2 why) (Put s2))
          ((BadTable s2 why) (Put s2))
          ((Table s2 d) (flushed_after (write_table s2 (gpt_named_only d u label)))))))))

; d with partition u named name, its type as it was.
(def gpt_named_only ((d GptDisk) (u Uuid) (name (list int))) GptDisk
  (match d ((GptDisk du parts) (GptDisk du (parts_renamed parts u name)))))

; parts with u's named name.
(def parts_renamed ((parts (list GptPart)) (u Uuid) (name (list int))) (list GptPart)
  (if (is_empty parts)
      parts
      (match (head parts)
        ((GptPart ty id s c n)
          (cons (if (eq id u) (GptPart ty id s c name) (head parts)) (parts_renamed (tail parts) u name))))))

; A relabel that failed for why: the new label unmounted, and -5.
(def relabel_undone ((f Fs) (label (list int)) (why (list int))) Answered
  (let u (fs_unmount label (fs_port f))
    (Answered f -5 why)))

; f serving every volume but the vi'th.
(def without_vol ((f Fs) (vi int)) Fs
  (with_vols f (vols_without (array_to_list (fs_vols f)) vi)))

; vols without the i'th.
(def vols_without ((vols (list FsVol)) (i int)) (list FsVol)
  (if (is_empty vols)
      vols
      (if (eq i 0) (tail vols) (cons (head vols) (vols_without (tail vols) (sub i 1))))))

; ------------------------------------------------------------ partitions

; The place among f's stores of the disk name, or -1 if f has none of it.
(def disk_index ((f Fs) (name (list int))) int (disk_index_from (fs_stores f) name 0))

; disk_index's loop, from store i.
(def disk_index_from ((ss (array Store)) (name (list int)) (i int)) int
  (if (ge i (array_len ss)) -1 (if (eq (store_name (array_get ss i)) name) i (disk_index_from ss name (add i 1)))))

; f with the disk name among its stores, and its place there; or why it
; cannot be: there is no such disk, or no buffer shared with its driver.
(data Attached (Attached Fs int) (NotAttached Fs (list int)))

; f with the disk name among its stores: where it is already, or opened
; and added after the rest.
(def attached ((f Fs) (name (list int))) Attached
  (let di (disk_index f name)
    (if (ge di 0)
        (Attached f di)
        (match (disk_store name)
          ((Err why) (NotAttached f why))
          ((Ok s) (Attached (with_stores f (append (array_to_list (fs_stores f)) (cons s (nil Store)))) (array_len (fs_stores f))))))))

; f with the stores ss in place of its own.
(def with_stores ((f Fs) (ss (list Store))) Fs
  (match f ((Fs s port vols hs next ws cp) (Fs (array_from ss (StoreRam ((MapEmpty int bytes)) 0)) port vols hs next ws cp))))

; attach DISK: the disk registered as DISK taken on, as its driver asks
; once it has registered it, and its volumes mounted and served, after
; those served already, so open handles keep theirs: 0 and how many it
; has. One taken on already is left as it is, 0 and 0. -3 if there is no
; such disk.
(def do_attach ((f Fs) (name (list int))) Answered
  (let before (array_len (fs_stores f))
    (match (attached f name)
      ((NotAttached f2 why) (Answered f2 -3 why))
      ((Attached f2 di)
        (if (lt di before)
            (Answered f2 0 "0")
            (match (disks_loaded f2 di (nil FsVol) true)
              ((DisksLoaded f3 vols) (vols_joined f3 vols))))))))

; vols served after f's volumes, and their labels mounted from f's port:
; 0 and how many.
(def vols_joined ((f Fs) (vols (list FsVol))) Answered
  (match f
    ((Fs s port old hs next ws cp)
      (let vols2 (vols_array (append (array_to_list old) vols))
        (let m (mount_new port vols2 (labels_of vols (nil (list int))))
          (Answered (Fs s port vols2 hs next ws cp) 0 (digits (length vols))))))))

; The labels of vols, after the reversed acc.
(def labels_of ((vols (list FsVol)) (acc (list (list int)))) (list (list int))
  (if (is_empty vols) (rev acc) (match (head vols) ((FsVol di start u v) (labels_of (tail vols) (cons (vol_label v) acc))))))

; f with every disk of names it has not taken on yet attached, as attach
; does: those registered while f was loading, before it could be asked.
(def late_disks ((f Fs) (names (list (list int)))) Fs
  (if (is_empty names)
      f
      (late_disks (after_answer (do_attach f (head names))) (tail names))))

; The store of the disk name, with a buffer of a cluster shared with its
; driver; or why not.
(def disk_store ((name (list int))) (Result Store (list int))
  (match (disk_open_named name)
    ((NoDisk why) ((Err Store (list int)) why))
    ((Disk n port rp pid size)
      (match (disk_buffer (Disk n port rp pid size) (vol_cluster_sectors))
        ((NoDiskBuf why) ((Err Store (list int)) why))
        ((DiskBuf va pages there r) ((Ok Store (list int)) (StoreDisk (Disk n port rp pid size) (DiskBuf va pages there r))))))))

; f, and the time in Unix milliseconds: the clock's seconds, as rtc clock
; serves them, and the milliseconds the monotonic clock is into its own
; second; 0 seconds if no clock is running. f gains a port for the
; clock's answers the first time.
(data Timed (Timed Fs int))

; f, and the time now, as Timed says.
(def now_ms ((f Fs)) Timed
  (match f
    ((Fs s port vols hs next ws cp)
      (let cp2 (if (eq cp 0) (port_new) cp)
        (Timed (Fs s port vols hs next ws cp2)
               (add (mul (clock_seconds cp2) 1000) (mod (div (clock_ns) 1000000) 1000)))))))

; What the clock says the time is, in seconds, its answer to rp; 0 if
; there is no clock.
(def clock_seconds ((rp int)) int
  (match (name_lookup "clock")
    ((NotFound) 0)
    ((Found c)
      (match (time_of (asked_reply (port_ask c rp "time" "the clock")))
        ((Some t) t)
        ((None) 0)))))

; A new UUID of version 7 for Unix time ms: its noise random's, asked
; through f's own port for replies, which now_ms has made; or, with no
; random, the clock's mixer's, salted with salt.
(def fresh_uuid ((f Fs) (ms int) (salt int)) Uuid
  (match f
    ((Fs s port vols hs next ws cp)
      (match (random_bytes cp 10)
        ((Ok noise) (uuid_v7 ms noise))
        ((Err why) (uuid_new ms salt))))))

; partition DISK COUNT [START]: a new partition of COUNT sectors on the
; disk DISK, from START or wherever it first fits: a disk's name, then
; numbers, one or two. A disk f has not met yet is taken on first.
(def obey_partition ((f Fs) (ws (list (list int)))) Answered
  (if (if (lt (length ws) 2) true (gt (length ws) 3))
      (word f -5)
      (let ns (tail ws)
        (if (not (if (is_number (head ns)) (if (is_empty (tail ns)) true (is_number (head (tail ns)))) false))
            (word f -5)
            (match (attached f (head ws))
              ((NotAttached f2 why) (Answered f2 -3 why))
              ((Attached f2 di)
                (do_partition f2 di (int_prefix (head ns) 0) (if (is_empty (tail ns)) -1 (int_prefix (head (tail ns)) 0)))))))))

; A new partition of L0FS's type and count sectors, with a new UUID of
; version 7, written into the table, both its copies, and its first
; sector zeroed, so that no volume that was there before is found there;
; a disk with no table gets one, with a UUID of its own. The answer is 0
; and the partition's UUID, or -6 and why there is no room; -5 if the
; table is bad, which this never writes over.
(def do_partition ((f Fs) (di int) (count int) (start int)) Answered
  (match (now_ms f)
    ((Timed f2 ms)
      (match (read_table (fs_store_at f2 di))
        ((NoTable s2 why) (partition_in (with_store_at f2 di s2) di (GptDisk (fresh_uuid f2 ms 0) (nil GptPart)) count start ms))
        ((BadTable s2 why) (Answered (with_store_at f2 di s2) -5 why))
        ((Table s2 d) (partition_in (with_store_at f2 di s2) di d count start ms))))))

; The partition placed in d, disk di's table, written, and its UUID
; answered.
(def partition_in ((f Fs) (di int) (d GptDisk) (count int) (start int) (ms int)) Answered
  (match d
    ((GptDisk du parts)
      (match (gpt_place (store_sectors (fs_store_at f di)) parts count start)
        ((GptNoRoom why) (Answered f -6 why))
        ((GptAt at)
          (let p (GptPart (gpt_l0fs_type) (fresh_uuid f ms (add 1 (length parts))) at count "")
            (match (write_table (fs_store_at f di) (GptDisk du (append parts (cons p (nil GptPart)))))
              ((PutNot s2 why) (Answered (with_store_at f di s2) -5 why))
              ((Put s2)
                (match (store_write s2 at (zeros (vol_sector_size)))
                  ((PutNot s3 why) (Answered (with_store_at f di s3) -5 why))
                  ((Put s3) (Answered (with_store_at f di s3) 0 (uuid_text (gpt_part_uuid p)))))))))))))

; mkfs UUID LABEL: a new, empty volume labelled label on the partition
; whose UUID is ut, the partition named label in the table, and the
; volume mounted at /Volumes/LABEL and served. Refused -5 for a UUID or
; a label that is not one, or a bad table; -4 if label is served, or the
; partition's volume is (format empties that instead); -3 if no
; partition has that UUID; -6 if the partition is too small for a volume.
(def do_mkfs ((f Fs) (ut (list int)) (label (list int))) Answered
  (match (uuid_of_text ut)
    ((None) (Answered f -5 "not a UUID"))
    ((Some u)
      (if (not (label_ok label))
          (Answered f -5 "a label is 1 to 15 letters, digits, - and _")
          (if (ge (vol_index (fs_vols f) label 0) 0)
              (Answered f -4 "that label is served already")
              (mkfs_from (attached_all f (disk_names)) 0 u label))))))

; The volume made on the partition u of the first disk from di whose
; table has it; -3 if none has.
(def mkfs_from ((f Fs) (di int) (u Uuid) (label (list int))) Answered
  (if (ge di (array_len (fs_stores f)))
      (Answered f -3 "no partition has that UUID")
      (match (read_table (fs_store_at f di))
        ((NoTable s2 why) (mkfs_from (with_store_at f di s2) (add di 1) u label))
        ((BadTable s2 why) (mkfs_from (with_store_at f di s2) (add di 1) u label))
        ((Table s2 d)
          (match (gpt_part_of (gpt_parts d) u)
            ((None) (mkfs_from (with_store_at f di s2) (add di 1) u label))
            ((Some p) (mkfs_on (with_store_at f di s2) di d p u label)))))))

; The volume made on partition p, u, of disk di, whose table is d, if it
; can be.
(def mkfs_on ((f Fs) (di int) (d GptDisk) (p GptPart) (u Uuid) (label (list int))) Answered
  (if (served_at (fs_vols f) di (gpt_part_start p) 0)
      (Answered f -4 "its volume is served; format empties it")
      (let l (vol_layout (gpt_part_sectors p))
        (if (not (vol_layout_ok l))
            (Answered f -6 "the partition is too small for a volume")
            (made_on f di d u label (gpt_part_start p) (vol_new label l))))))

; v written at start of disk di, its partition named in the table, and v
; mounted.
(def made_on ((f Fs) (di int) (d GptDisk) (u Uuid) (label (list int)) (start int) (v Vol)) Answered
  (match (store_write_all (fs_store_at f di) start (vol_meta v))
    ((PutNot s2 why) (Answered (with_store_at f di s2) -5 why))
    ((Put s2)
      (match (write_table s2 (gpt_named d u label))
        ((PutNot s3 why) (Answered (with_store_at f di s3) -5 why))
        ((Put s3) (mounted_new (with_store_at f di s3) (FsVol di start (uuid_text u) v)))))))

; Whether a volume served is on disk di from start, among vols from i.
(def served_at ((vols (array FsVol)) (di int) (start int) (i int)) bool
  (if (ge i (array_len vols))
      false
      (match (array_get vols i)
        ((FsVol d s u v) (if (if (eq d di) (eq s start) false) true (served_at vols di start (add i 1)))))))

; d with partition u named, and of L0FS's type.
(def gpt_named ((d GptDisk) (u Uuid) (name (list int))) GptDisk
  (match d ((GptDisk du parts) (GptDisk du (parts_named parts u name)))))

; parts with u's named name, and of L0FS's type.
(def parts_named ((parts (list GptPart)) (u Uuid) (name (list int))) (list GptPart)
  (if (is_empty parts)
      parts
      (match (head parts)
        ((GptPart ty id s c n)
          (cons (if (eq id u) (GptPart (gpt_l0fs_type) id s c name) (head parts)) (parts_named (tail parts) u name))))))

; fv served, after the volumes served before, so that open handles keep
; theirs, and mounted from f's port, as a rescan mounts a new label: 0
; and its label, the volume made though it cannot be mounted.
(def mounted_new ((f Fs) (fv FsVol)) Answered
  (match f
    ((Fs s port vols hs next ws cp)
      (match fv
        ((FsVol di start u v)
          (let vols2 (vols_array (append (array_to_list vols) (cons fv (nil FsVol))))
            (let m (mount_new port vols2 (cons (vol_label v) (nil (list int))))
              (Answered (Fs s port vols2 hs next ws cp) 0 (vol_label v)))))))))

; ---------------------------------------------------------------- rescan

; What a rescan answered, the labels it found that f did not serve
; before, to be mounted, and those f served that it no longer finds, to
; be unmounted.
(data Rescanned (Rescanned Answered (list (list int)) (list (list int))))

; Every disk read again as at the start, those registered since taken on
; too, each table's partitions of L0FS's type and each volume on them,
; served in place of the volumes before: the answer is how many there
; are now, then LABEL\n for each. Refused -4 while any file is open,
; since a handle names its volume by where it is among them. A disk with
; no table has no volumes, nor has one whose table is bad, which is said
; why.
(def rescan ((f Fs)) Rescanned
  (if (gt (map_size (fs_handles f)) 0)
      (Rescanned (word f -4) (nil (list int)) (nil (list int)))
      (match (disks_loaded (attached_all f (disk_names)) 0 (nil FsVol) false)
        ((DisksLoaded f2 vols)
          (Rescanned (Answered (with_vols f2 vols) (length vols) (labels_text vols (nil int)))
                     (new_labels (fs_vols f) vols)
                     (gone_labels (array_to_list (fs_vols f)) (vols_array vols)))))))

; f with every disk of names among its stores, those that can be.
(def attached_all ((f Fs) (names (list (list int)))) Fs
  (if (is_empty names)
      f
      (match (attached f (head names))
        ((Attached f2 di) (attached_all f2 (tail names)))
        ((NotAttached f2 why) (let w (warn_as "fs" (append (head names) (append ": " why))) (attached_all f2 (tail names)))))))

; The volumes on every disk of f from di, after acc, reversed; f with
; their stores after. With say, a disk with no table, or no volumes, or a
; bad table, is said so; a bad table is said so whatever say is.
(data DisksLoaded (DisksLoaded Fs (list FsVol)))

; Disk di's table read, its volumes loaded, and the disks after it.
(def disks_loaded ((f Fs) (di int) (acc (list FsVol)) (say bool)) DisksLoaded
  (if (ge di (array_len (fs_stores f)))
      (DisksLoaded f (rev acc))
      (let name (store_name (fs_store_at f di))
        (match (read_table (fs_store_at f di))
          ((NoTable s2 why)
            (let w (if say (warn_as "fs" (append name (append ": " (append why "; partition makes a table, and a rescan serves any volume made")))) 0)
              (disks_loaded (with_store_at f di s2) (add di 1) acc say)))
          ((BadTable s2 why)
            (let w (log_as (log_error) "fs" (append name (append ": the partition table is bad: " why)))
              (disks_loaded (with_store_at f di s2) (add di 1) acc say)))
          ((Table s2 d)
            (let parts (gpt_typed (gpt_parts d) (gpt_l0fs_type))
              (let w (if (if say (is_empty parts) false) (info_as "fs" (append name ": no volumes on the disk yet; a rescan serves any made")) 0)
                (match (load_vols s2 di parts (nil FsVol))
                  ((Loaded s3 vols) (disks_loaded (with_store_at f di s3) (add di 1) (rev_onto vols acc) say))))))))))

; The labels of old that none of vols has.
(def gone_labels ((old (list FsVol)) (vols (array FsVol))) (list (list int))
  (if (is_empty old)
      (nil (list int))
      (match (head old)
        ((FsVol di start u v)
          (if (lt (vol_index vols (vol_label v) 0) 0)
              (cons (vol_label v) (gone_labels (tail old) vols))
              (gone_labels (tail old) vols))))))

; The labels of vols, a line each, after acc.
(def labels_text ((vols (list FsVol)) (acc (list int))) (list int)
  (if (is_empty vols)
      (rev acc)
      (match (head vols) ((FsVol di start u v) (labels_text (tail vols) (push "\n" (push (vol_label v) acc)))))))

; The labels of vols that none of old has.
(def new_labels ((old (array FsVol)) (vols (list FsVol))) (list (list int))
  (if (is_empty vols)
      (nil (list int))
      (match (head vols)
        ((FsVol di start u v)
          (if (lt (vol_index old (vol_label v) 0) 0)
              (cons (vol_label v) (new_labels old (tail vols)))
              (new_labels old (tail vols)))))))

; A rescan, its new labels mounted from f's port, and those that have
; gone unmounted, but for the system volume's, which is / for good, and
; whose requests are then answered as for any volume fs does not serve.
(def do_rescan ((f Fs)) Answered
  (match (rescan f)
    ((Rescanned a labels gone)
      (let port (match f ((Fs s port vols hs next ws cp) port))
        (let u (unmount_gone port gone)
          (let m (mount_new port (fs_vols (after_answer a)) labels) a))))))

; Each label unmounted from port. The system volume's stays; any other
; failure is said why.
(def unmount_gone ((port int) (labels (list (list int)))) int
  (if (is_empty labels)
      0
      (match (fs_unmount (head labels) port)
        ((Unmounted) (unmount_gone port (tail labels)))
        ((UnmountDenied) (unmount_gone port (tail labels)))
        ((UnmountNotMounted) (unmount_gone port (tail labels)))
        ((UnmountBadLabel) (let w (complain (append (head labels) (append ": " (unmounting_why (UnmountBadLabel))))) (unmount_gone port (tail labels)))))))

; f after the request a answers.
(def after_answer ((a Answered)) Fs (match a ((Answered f w bs) f)))

; Each label mounted from port, with its UUID, as vols has it. One
; mounted already is fs's from before, served again; any other failure is
; said why.
(def mount_new ((port int) (vols (array FsVol)) (labels (list (list int)))) int
  (if (is_empty labels)
      0
      (let vi (vol_index vols (head labels) 0)
        (let u (if (lt vi 0) "" (match (array_get vols vi) ((FsVol di start id v) id)))
          (match (fs_mount (head labels) u port)
            ((Mounted) (let w (info_as "fs" (append (append "/Volumes/" (head labels)) (append " mounted, UUID " u))) (mount_new port vols (tail labels))))
            ((MountTaken) (mount_new port vols (tail labels)))
            ((MountNoPort) (let w (complain (append (head labels) (append ": " (mounting_why (MountNoPort))))) (mount_new port vols (tail labels))))
            ((MountBadLabel) (let w (complain (append (head labels) (append ": " (mounting_why (MountBadLabel))))) (mount_new port vols (tail labels)))))))))

; ---------------------------------------------------------------- serving

; Every message on the port: a request answered to its reply port, if it
; has one, or an exit notice, its pid's handles dropped.
(def serve ((f Fs) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from payload)
      (match (exit_of (Message from payload))
        ((Exited pid status) (serve (forget_pid f pid) port))
        ((NotExit)
          (if (eq from 0)
              (serve f port)
              (match (obey f from (request_body payload))
                ((Answered f2 w bs) (let s (request_answer payload (fs_reply_bytes w bs)) (serve f2 port))))))))))

; ---------------------------------------------------------------- starting

; The server: the disk, its volumes found and mounted, and served; or,
; given the argument ram, a file system in memory.
(def fs () int
  (if (ram_requested (args))
      (fs_ram (ram_megabytes (args)))
      (fs_disk)))

; The disks' volumes, found, mounted and served: once disk0 is there,
; every disk registered then; one that comes later is taken on by a
; rescan, or by a partition of it.
(def fs_disk () int
  (match (disk_open)
    ((NoDisk why) (nothing_to_serve why))
    ((Disk name port rp pid n)
      (match (disk_buffer (Disk name port rp pid n) (vol_cluster_sectors))
        ((NoDiskBuf why) (complain why))
        ((DiskBuf va pages there r)
          (fs_on (attached_all (fs_new (StoreDisk (Disk name port rp pid n) (DiskBuf va pages there r)) 0 (vols_array (nil FsVol)))
                               (disk_names))))))))

; ---------------------------------------------------------- RAM file system

; Whether the arguments ask for a file system in memory, a first of ram.
(def ram_requested ((argv (list (list int)))) bool
  (if (is_empty argv) false (eq (head argv) "ram")))

; The megabytes the RAM file system is, the second argument, 32 unless
; it gives a number from 1 to 255, a volume holding at most 65534
; clusters of 4 KB.
(def ram_megabytes ((argv (list (list int)))) int
  (if (if (gt (length argv) 1) (is_number (nth argv 1)) false)
      (max 1 (min 255 (int_prefix (nth argv 1) 0)))
      32))

; The UUID the RAM file system's volume is mounted with, which boot's
; root=tmpfs looks for; it is no partition's.
(def ram_uuid () (list int) "00000000-0000-7000-8000-000000000000")

; The label the RAM file system is mounted at, /Volumes/tmp.
(def ram_label () (list int) "tmp")

; A volume of mb megabytes, empty, in memory, mounted at /Volumes/tmp and
; served, registered as tmpfs: it has no disk, no partition table, and
; nothing of it survives. Nothing in it is written to a disk.
(def fs_ram ((mb int)) int
  (let sectors (mul mb 2048)
    (let l (vol_layout sectors)
      (if (not (vol_layout_ok l))
          (complain "the RAM file system is too small")
          (let v (vol_new (ram_label) l)
            (match (store_write_all (StoreRam ((MapEmpty int bytes)) sectors) 0 (vol_meta v))
              ((PutNot s why) (complain why))
              ((Put s) (found_as (fs_new s 0 (vols_array (nil FsVol))) (cons (FsVol 0 0 (ram_uuid) v) (nil FsVol)) "tmpfs" false))))))))

; f's disks' volumes found, mounted and served, each disk with no table
; or no volumes said so.
(def fs_on ((f Fs)) int
  (match (disks_loaded f 0 (nil FsVol) true)
    ((DisksLoaded f2 vols) (found f2 vols))))

; ----------------------------------------------------------------- table

; The disk's partition table, read; that the disk has none, no GPT's
; signature where either header goes; or why the table it has is bad.
(data Table (Table Store GptDisk) (NoTable Store (list int)) (BadTable Store (list int)))

; The GPT, from its header at sector 1, or its backup's in the last
; sector if that one is bad.
(def read_table ((s Store)) Table
  (match (table_at s 1)
    ((Table s2 d) (Table s2 d))
    ((NoTable s2 why) (backup_table s2 why true))
    ((BadTable s2 why) (backup_table s2 why false))))

; The backup's table, if the primary's was none, as none says, or bad.
(def backup_table ((s Store) (why (list int)) (none bool)) Table
  (match (table_at s (sub (store_sectors s) 1))
    ((Table s2 d) (Table s2 d))
    ((NoTable s2 why2) (if none (NoTable s2 why) (BadTable s2 why)))
    ((BadTable s2 why2) (BadTable s2 (if none why2 why)))))

; The table whose header is at sector, and its entries where it says.
(def table_at ((s Store) (sector int)) Table
  (match (store_read s sector 1)
    ((GotNot s2 why) (BadTable s2 why))
    ((Got s2 hb)
      (match (gpt_header_of (bytes_from_list hb))
        ((GptNone) (NoTable s2 "no partition table on the disk"))
        ((GptNotHeader why) (BadTable s2 why))
        ((GptHeader disk at count ecrc)
          (match (store_read_all s2 at (gpt_entries_sectors count))
            ((GotNot s3 why) (BadTable s3 why))
            ((Got s3 es)
              (match (gpt_disk_of (GptHeader disk at count ecrc) (bytes_from_list es))
                ((GptBad why) (BadTable s3 why))
                ((GptGot d) (Table s3 d))))))))))

; d written: both copies of its table, and the protective MBR.
(def write_table ((s Store) (d GptDisk)) Put
  (write_pieces s (gpt_pieces (store_sectors s) d)))

; Each piece written where it goes.
(def write_pieces ((s Store) (ps (list GptPiece))) Put
  (if (is_empty ps)
      (Put s)
      (match (head ps)
        ((GptPiece sector bs)
          (match (store_write_all s sector bs)
            ((PutNot s2 why) (PutNot s2 why))
            ((Put s2) (write_pieces s2 (tail ps))))))))

; The volumes of parts, each a partition of disk di, store s, onto acc;
; one that cannot be read is said why, and left.
(data Loaded (Loaded Store (list FsVol)))

(def load_vols ((s Store) (di int) (parts (list GptPart)) (acc (list FsVol))) Loaded
  (if (is_empty parts)
      (Loaded s (rev acc))
      (match (head parts)
        ((GptPart ty u start count name)
          (match (store_read s start 1)
            ((GotNot s2 why) (load_vols s2 di (tail parts) (cons_not acc start why)))
            ((Got s2 bs)
              (match (vol_super_of (bytes_from_list bs))
                ((VolNotSuper why) (load_vols s2 di (tail parts) (cons_not acc start why)))
                ((VolSuper label l) (load_meta s2 di (tail parts) acc start (uuid_text u) count label l)))))))))

; load_vols's rest, for the partition at start, u, of count sectors,
; whose superblock says label and l: its metadata and directories read.
(def load_meta ((s Store) (di int) (parts (list GptPart)) (acc (list FsVol)) (start int) (u (list int)) (count int) (label (list int)) (l VolLayout)) Loaded
  (if (gt (match l ((VolLayout n c t d) n)) count)
      (load_vols s di parts (cons_not acc start "a volume larger than its partition"))
      (match (store_read_all s start (vol_meta_sectors l))
        ((GotNot s2 why) (load_vols s2 di parts (cons_not acc start why)))
        ((Got s2 bs)
          (match (vol_base label l (bytes_from_list bs))
            ((VolBad why) (load_vols s2 di parts (cons_not acc start why)))
            ((VolGot v)
              (match (load_dirs s2 start v (cons (vol_root v) (nil int)))
                ((DirsNot s3 why) (load_vols s3 di parts (cons_not acc start why)))
                ((Dirs s3 v2) (load_vols s3 di parts (cons (FsVol di start u v2) acc))))))))))

; A volume with every directory read, or why not, and the store after.
(data Dirs (Dirs Store Vol) (DirsNot Store (list int)))

; v, its partition from start, with the directories from dcs on read
; from the store, and those in them.
(def load_dirs ((s Store) (start int) (v Vol) (dcs (list int))) Dirs
  (if (is_empty dcs)
      (Dirs s v)
      (match (read_clusters s start (vol_dir_clusters v (head dcs)) (nil int))
        ((GotNot s2 why) (DirsNot s2 why))
        ((Got s2 bs)
          (match (vol_add_dir v (head dcs) (bytes_from_list bs))
            ((VolBad why) (DirsNot s2 why))
            ((VolGot v2) (load_dirs s2 start v2 (append (vol_subdirs v2 (head dcs)) (tail dcs)))))))))

; The clusters cs of the partition from start, in order, after acc,
; reversed.
(def read_clusters ((s Store) (start int) (cs (list int)) (acc (list int))) Got
  (if (is_empty cs)
      (Got s (rev acc))
      (match (store_read s (vol_cluster_sector start (head cs)) (vol_cluster_sectors))
        ((GotNot s2 why) (GotNot s2 why))
        ((Got s2 bs) (read_clusters s2 start (tail cs) (rev_onto bs acc))))))

; acc, having said why the partition at start is not served.
(def cons_not ((acc (list FsVol)) (start int) (why (list int))) (list FsVol)
  (let w (warn_as "fs" (append "the partition at sector " (append (digits start) (append ": " why))))
    acc))

; The volumes vols of f's disks mounted and served, and fs registered,
; though there be none: a rescan serves any made later. A disk
; registered while they were loaded, whose driver could not yet ask fs to
; attach it, is attached then.
(def found ((f Fs) (vols (list FsVol))) int
  (found_as f vols "fs" true))

; The same, registered as name, the late disks attached if late.
(def found_as ((f Fs) (vols (list FsVol)) (name (list int)) (late bool)) int
  (let port (port_new)
    (let m (mount_all port vols)
      (let r (name_register_or_why port name)
        (if (is_empty r)
            (match f
              ((Fs s p vs hs next ws cp)
                (let f2 (Fs s port (vols_array vols) hs next ws cp)
                  (serve (if late (late_disks f2 (disk_names)) f2) port))))
            (complain r))))))

; What fs says of a volume it mounted: where it is, the partition it is
; on, by its first sector, and its UUID.
(def volume_line ((label (list int)) (start int) (uuid (list int))) (list int)
  (append "/Volumes/" (append label
    (if (eq start 0)
        (append ": a volume in memory, UUID " uuid)
        (append ": a volume on the partition at sector " (append (digits start) (append ", UUID " uuid)))))))

; Each volume mounted from port, with its partition's UUID; one that
; cannot be is said why, and each that is is said where it is.
(def mount_all ((port int) (vols (list FsVol))) int
  (if (is_empty vols)
      0
      (match (head vols)
        ((FsVol di start u v)
          (match (fs_mount (vol_label v) u port)
            ((Mounted) (let w (info_as "fs" (volume_line (vol_label v) start u)) (mount_all port (tail vols))))
            ((MountNoPort) (let w (complain (append (vol_label v) (append ": " (mounting_why (MountNoPort))))) (mount_all port (tail vols))))
            ((MountTaken) (let w (complain (append (vol_label v) (append ": " (mounting_why (MountTaken))))) (mount_all port (tail vols))))
            ((MountBadLabel) (let w (complain (append (vol_label v) (append ": " (mounting_why (MountBadLabel))))) (mount_all port (tail vols)))))))))
