; turns_test.l0 -- tests of the order fs serves what waits on its port.

; A request from pid, its body text, its reply to 9.
(def req ((pid int) (body (list int))) Message
  (message_new pid (request 9 body)))

; An exit notice of pid, from pid 0.
(def exit_note ((pid int)) Message
  (message_new 0 (append "exit" (append (u32_le pid) (u32_le 0)))))

; ts with each of ms added, in order.
(def added ((ts Turns) (ms (list Message))) Turns
  (if (is_empty ms) ts (added (turns_add ts (head ms)) (tail ms))))

; What ts serves, in order, as text: N for a notice, or PID:BODY for a
; request, joined by |.
(def order ((ts Turns)) (list int)
  (order_from ts (nil int)))

(def order_from ((ts Turns) (acc (list int))) (list int)
  (match (turns_next ts)
    ((TurnNone) (rev acc))
    ((TurnNotice m ts2) (order_from ts2 (push "N" (if (is_empty acc) acc (push "|" acc)))))
    ((TurnRequest m ts2) (order_from ts2 (push (req_text m) (if (is_empty acc) acc (push "|" acc)))))))

; A request as PID:BODY.
(def req_text ((m Message)) (list int)
  (match m
    ((RecvFailed) "?")
    ((Message from b) (append (digits from) (cons 58 (msg_text_from b 4))))))

(def ms2 ((a Message) (b Message)) (list Message) (cons a (cons b (nil Message))))
(def ms3 ((a Message) (b Message) (c Message)) (list Message) (cons a (ms2 b c)))
(def ms4 ((a Message) (b Message) (c Message) (d Message)) (list Message) (cons a (ms3 b c d)))

; Nothing waiting is nothing to serve.
(def test_turns_empty () int
  (check_str "none" (order (turns_new)) ""))

; Notices go before every request, though they came after.
(def test_notices_first () int
  (check_str "order"
    (order (added (turns_new) (ms3 (req 5 "stat /Volumes/a") (exit_note 7) (req 6 "stat /Volumes/b"))))
    "N|5:stat /Volumes/a|6:stat /Volumes/b"))

; A pid's requests are dropped once it has exited, and only its.
(def test_turns_drop () int
  (let ts (added (turns_new) (ms4 (req 5 "close 1") (req 6 "close 2") (req 5 "close 3") (exit_note 5)))
    (add (check_int "waiting" (turns_requests (turns_drop ts 5)) 1)
         (check_str "left" (order (turns_drop ts 5)) "N|6:close 2"))))
