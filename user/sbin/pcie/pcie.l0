; pcie.l0 -- the PCIe bus's server, for QEMU's virt board, where nothing
; else sets the bus up: it reads every function of bus 0 through the
; ECAM, sizes each memory BAR and puts it in the 32-bit MMIO window,
; turns on each function's memory space and bus mastering, and then
; serves pci (proto/pci.l0): what it found, to the drivers of it. Its
; module must be flagged dev. Started as
;
;   pcie virt    QEMU's virt board: its high ECAM, 0x4010000000, and its
;                MMIO window, 0x10000000 up to 0x3EFF0000
;
; On the Raspberry Pi 5 the firmware sets RP1 up, and xhci finds its
; controllers without this. Bus 0 is all QEMU's virt board has without
; a bridge, so the buses behind bridges are not looked at.

(def ecam_base () int 275146342400)     ; 0x4010000000
(def ecam_bus_bytes () int 1048576)     ; bus 0's 32 devices of 8 functions of 4 KB

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "pcie" why))

; The bus scanned, then pci served.
(def pcie () int
  (if (not (eq (args) (cons "virt" (nil (list int)))))
      (complain "usage: pcie virt")
      (match (open_device (ecam_base) (ecam_bus_bytes))
        ((DeviceFailed fault why) (complain (append "no ECAM: " why)))
        ((DeviceOpened e)
          (match (scanned e 0 0 (Scan (window_base) (nil PciFunction)))
            ((Scan next fs) (serving fs)))))))

; ------------------------------------------------------------------ scan

; The scan so far: where the next BAR may go, and the functions found,
; the last first.
(data Scan (Scan int (list PciFunction)))

; The functions of bus 0 from device dev's function fn on, found and set
; up, after s.
(def scanned ((e IoDevice) (dev int) (fn int) (s Scan)) Scan
  (if (ge dev 32)
      (match s ((Scan next fs) (Scan next (rev fs))))
      (let off (ecam_offset 0 dev fn)
        (let ids (device_read32 e off)
          (if (no_function ids)
              (scanned e (add dev 1) 0 s)
              (let more (if (eq fn 0) (multifunction (device_read32 e (add off (cfg_header)))) true)
                (let s2 (function_set_up e dev fn off ids s)
                  (if (if more (lt fn 7) false)
                      (scanned e dev (add fn 1) s2)
                      (scanned e (add dev 1) 0 s2)))))))))

; The function at off, its ids word ids, with its memory BARs placed
; from s's next on and its memory space and bus mastering turned on.
(def function_set_up ((e IoDevice) (dev int) (fn int) (off int) (ids int) (s Scan)) Scan
  (match s
    ((Scan next fs)
      (let class (class_of (device_read32 e (add off (cfg_class))))
        (let pin (interrupt_pin (device_read32 e (add off (cfg_interrupt))))
          (let quiet (device_write32 e (add off (cfg_command)) 0)
            (match (if (eq (header_type (device_read32 e (add off (cfg_header)))) 0)
                       (bars_placed e off 0 next (nil int) (nil int))
                       (Bars next (zeros 6) (zeros 6)))
              ((Bars next2 bases sizes)
                (let on (device_write32 e (add off (cfg_command)) (bit_or (command_memory) (command_master)))
                  (Scan next2 (cons (PciFunction (bdf_of 0 dev fn) (ids_vendor ids) (ids_device ids) class (virt_intx dev pin) bases sizes) fs)))))))))))

; BARs placed: where the next may go, and each BAR's base and size.
(data Bars (Bars int (list int) (list int)))

; BAR i on of the function at off placed from next, after the reversed
; bases and sizes: an I/O BAR, one not there, and one past the window
; left at 0 0, a 64-bit one taking BAR i + 1 too.
(def bars_placed ((e IoDevice) (off int) (i int) (next int) (bases (list int)) (sizes (list int))) Bars
  (if (ge i 6)
      (Bars next (rev bases) (rev sizes))
      (let at (add off (cfg_bar i))
        (let w (device_read32 e at)
          (if (bar_is_io w)
              (bars_placed e off (add i 1) next (cons 0 bases) (cons 0 sizes))
              (let wide (if (bar_is_64 w) (lt i 5) false)
                (let lo (bar_probed e at)
                  (let hi (if wide (bar_probed e (add at 4)) 0)
                    (bar_sized e off i wide (bar_size lo hi) next bases sizes)))))))))

; BAR i, of size, put at the first place from next it fits, and the
; BARs after it placed.
(def bar_sized ((e IoDevice) (off int) (i int) (wide bool) (size int) (next int) (bases (list int)) (sizes (list int))) Bars
  (let at (add off (cfg_bar i))
    (let base (bar_place next size)
      (if (if (eq size 0) true (not (in_window base size)))
          (bars_skipped e off i wide next bases sizes)
          (let a (device_write32 e at (bit_and base 4294967295))
            (let b (if wide (device_write32 e (add at 4) (bit_shr base 32)) 0)
              (if wide
                  (bars_placed e off (add i 2) (add base size) (cons 0 (cons base bases)) (cons 0 (cons size sizes)))
                  (bars_placed e off (add i 1) (add base size) (cons base bases) (cons size sizes)))))))))

; BAR i left at 0 0, and the next too if it is a 64-bit one's high half.
(def bars_skipped ((e IoDevice) (off int) (i int) (wide bool) (next int) (bases (list int)) (sizes (list int))) Bars
  (if wide
      (bars_placed e off (add i 2) next (cons 0 (cons 0 bases)) (cons 0 (cons 0 sizes)))
      (bars_placed e off (add i 1) next (cons 0 bases) (cons 0 sizes))))

; What the BAR word at at reads once written all 1s, which says its size.
(def bar_probed ((e IoDevice) (at int)) int
  (let w (device_write32 e at 4294967295)
    (device_read32 e at)))

; --------------------------------------------------------------- serving

; pci registered, and served with what was found.
(def serving ((fs (list PciFunction))) int
  (let port (port_new)
    (let r (name_register_or_why port "pci")
      (if (is_empty r) (serve fs port) (complain r)))))

; Each request answered, for ever.
(def serve ((fs (list PciFunction)) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from payload)
      (let s (request_answer payload (pci_answer fs (request_body payload)))
        (serve fs port)))))

; The answer to body: every function's line, those of a class, or why not.
(def pci_answer ((fs (list PciFunction)) (body (list int))) (list int)
  (if (eq body "devices")
      (functions_text fs 0 false (nil int))
      (match (request_numbers body)
        ((ReqBad why) (error_reply why))
        ((ReqNums op ns)
          (if (if (eq op "find") (eq (length ns) 1) false)
              (functions_text fs (head ns) true (nil int))
              (error_reply (append "no request " op)))))))

; The lines of fs, or of those of class if only, after the reversed acc.
(def functions_text ((fs (list PciFunction)) (class int) (only bool) (acc (list int))) (list int)
  (if (is_empty fs)
      (rev acc)
      (functions_text (tail fs) class only
        (match (head fs)
          ((PciFunction bdf vid did c irq bases sizes)
            (if (if only (not (eq c class)) false) acc (push (pci_function_line (head fs)) acc)))))))
