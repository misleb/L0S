; cfg.l0 -- PCI's configuration space (PCI 3.0, chapter 6), purely: where
; a function's 4 KB are in the ECAM, what its type 0 header's words
; say, how big a BAR is from what it reads back once written all 1s, where
; each memory BAR goes in the MMIO window, and which of the GIC's
; interrupts its INTx reaches on QEMU's virt board.

; ------------------------------------------------------------------ ECAM

; The offset of bus, device and function's configuration space in the
; ECAM: 1 MB a bus, 32 KB a device, 4 KB a function.
(def ecam_offset ((bus int) (dev int) (fn int)) int
  (bit_or (bit_shl bus 20) (bit_or (bit_shl dev 15) (bit_shl fn 12))))

; A BDF, as the pci protocol numbers a function.
(def bdf_of ((bus int) (dev int) (fn int)) int (bit_or (bit_shl bus 8) (bit_or (bit_shl dev 3) fn)))

; --------------------------------------------------------------- header

; The header's registers: the vendor and device ids, the command
; register, the revision and class, the header type, the six BARs from
; 0x10, and the interrupt pin.
(def cfg_ids () int 0)
(def cfg_command () int 4)
(def cfg_class () int 8)
(def cfg_header () int 12)              ; the header type is its byte 2
(def cfg_bar ((i int)) int (add 16 (mul 4 i)))
(def cfg_interrupt () int 60)           ; the pin is its byte 1

; The command register's Memory Space and Bus Master Enable.
(def command_memory () int 2)
(def command_master () int 4)

; The ids word's vendor, 0xFFFF where there is no function; its device.
(def ids_vendor ((w int)) int (bit_and w 65535))
(def ids_device ((w int)) int (bit_and (bit_shr w 16) 65535))
(def no_function ((w int)) bool (eq (ids_vendor w) 65535))

; The class word's class: base class, subclass, programming interface.
(def class_of ((w int)) int (bit_shr w 8))

; The header word's type, without its multifunction bit; whether the
; device has more functions than 0.
(def header_type ((w int)) int (bit_and (bit_shr w 16) 127))
(def multifunction ((w int)) bool (not (eq (bit_and (bit_shr w 16) 128) 0)))

; The interrupt word's pin: 1 to 4 for INTA to INTD, 0 for none.
(def interrupt_pin ((w int)) int (bit_and (bit_shr w 8) 255))

; ----------------------------------------------------------------- BARs

; Whether a BAR's word, as read, is an I/O BAR, bit 0; a 64-bit memory
; one, type 2 in bits 1 and 2.
(def bar_is_io ((w int)) bool (eq (bit_and w 1) 1))
(def bar_is_64 ((w int)) bool (eq (bit_and w 6) 4))

; A memory BAR's size from what its low word reads once written all 1s,
; and its high word's, for a 64-bit one (0 for a 32-bit one's): the
; lowest address bit that stuck. 0 for a BAR that is not there.
(def bar_size ((lo int) (hi int)) int
  (let mask (bit_or (bit_and lo 4294967280) (bit_shl hi 32))
    (if (eq mask 0) 0 (bit_and mask (neg mask)))))

; Where a BAR of size goes, at or after next: size-aligned, as a BAR must
; be.
(def bar_place ((next int) (size int)) int
  (if (le size 0) next (mul (div (add next (sub size 1)) size) size)))

; The 32-bit MMIO window of QEMU's virt board, where the BARs go.
(def window_base () int 268435456)      ; 0x10000000
(def window_size () int 788463616)      ; 0x2EFF0000

; Whether a BAR of size at base fits in the window.
(def in_window ((base int) (size int)) bool
  (le (add base size) (add (window_base) (window_size))))

; ------------------------------------------------------------ interrupts

; The GIC's interrupt a function's INTx reaches on QEMU's virt board,
; device dev of bus 0 with pin 1 to 4: its four INTx lines are SPIs 3 to
; 6, the GIC's 35 to 38, swizzled by slot; 0 for no pin.
(def virt_intx ((dev int) (pin int)) int
  (if (eq pin 0) 0 (add 35 (mod (add dev (sub pin 1)) 4))))
