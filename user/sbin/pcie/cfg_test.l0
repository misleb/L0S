; cfg_test.l0 -- configuration space read purely.

(def test_ecam_offset () int
  (add (check_int "00:02.0" (ecam_offset 0 2 0) 65536)
       (check_int "01:00.1" (ecam_offset 1 0 1) 1052672)))

(def test_bdf () int
  (check_int "00:02.0" (bdf_of 0 2 0) 16))

; qemu-xhci: vendor 0x1b36, device 0x000d; class 0x0C0330, revision 1.
(def test_ids () int
  (add (check_int "vendor" (ids_vendor 858934) 6966)            ; 0x000D1B36
       (add (check_int "device" (ids_device 858934) 13)
            (add (check_bool "none" (no_function 4294967295) true)
                 (check_int "class" (class_of 201535489) 787248)))))    ; 0x0C033001

(def test_header () int
  (add (check_int "type 0" (header_type 8388608) 0)              ; 0x00800000
       (add (check_bool "multifunction" (multifunction 8388608) true)
            (check_bool "single" (multifunction 0) false))))

(def test_pin () int
  (check_int "INTA" (interrupt_pin 256) 1))

; A 64-bit BAR of 16 KB reads back 0xFFFFC004 and 0xFFFFFFFF; a 32-bit
; one of 4 KB 0xFFFFF000; one that is not there 0.
(def test_bar_size () int
  (add (check_int "16 KB, 64 bits" (bar_size 4294950916 4294967295) 16384)
       (add (check_int "4 KB" (bar_size 4294963200 0) 4096)
            (check_int "none" (bar_size 0 0) 0))))

(def test_bar_kinds () int
  (add (check_bool "64" (bar_is_64 4294950916) true)
       (add (check_bool "32" (bar_is_64 4294963200) false)
            (check_bool "I/O" (bar_is_io 4294967265) true))))

(def test_bar_place () int
  (add (check_int "aligned already" (bar_place 268435456 16384) 268435456)
       (add (check_int "up to 16 KB" (bar_place 268439552 16384) 268451840)
            (check_int "1 MB" (bar_place 268451840 1048576) 269484032))))

; A BAR of 256 bytes, an SD host controller's, still takes a page of its
; own: placed page-aligned, and the next after its page.
(def test_bar_small () int
  (add (check_int "page-aligned" (bar_place 268435712 256) 268439552)        ; 0x10000100 to 0x10001000
       (check_int "a page" (bar_span 256) 4096)))

(def test_window () int
  (add (check_bool "the start" (in_window (window_base) 16384) true)
       (check_bool "past the end" (in_window 1056899072 4096) false)))

; Slot 2's INTA is the GIC's 37; slot 3's INTB wraps to 35.
(def test_intx () int
  (add (check_int "slot 2, INTA" (virt_intx 2 1) 37)
       (add (check_int "slot 3, INTB" (virt_intx 3 2) 35)
            (check_int "no pin" (virt_intx 2 0) 0))))

; Status 0x0010 in the command word's high half: a capabilities list,
; whose pointer 0x73 is 0x70 with its reserved bits off.
(def test_capabilities () int
  (add (check_bool "listed" (has_capabilities 1048576) true)
       (add (check_bool "none" (has_capabilities 7) false)
            (check_int "pointer" (capabilities_at 115) 112))))

; qemu-xhci's MSI, 0x00889005: id 5, the next at 0x90, Message Control
; 0x0088, 64-bit, 16 messages capable.
(def test_msi_capability () int
  (add (check_int "id" (cap_id 8949765) 5)
       (add (check_int "next" (cap_next 8949765) 144)
            (check_bool "64-bit" (msi_wide 8949765) true))))

; Enabled for one message: 0x00A89005, with Multiple Message Enable 2,
; becomes 0x00899005; a 32-bit capability's data is at 8.
(def test_msi_enabled () int
  (add (check_int "enabled" (msi_enabled 11046917) 9015301)
       (add (check_bool "32-bit" (msi_wide 36869) false)
            (check_int "data" (msi_data_at false) 8))))

; qemu-xhci's MSI-X: Message Control 0x000F, 16 entries, at 0x90, so
; 0x000F9011; enabled, 0x800F9011, and with its Function Mask set,
; 0x400F9011, enabled with the mask off. Its table is BAR 0's at 0x3000.
(def test_msix () int
  (add (check_int "enabled" (msix_enabled 1019921) 2148503569)
       (add (check_int "unmasked" (msix_enabled 1074761745) 2148503569)
            (add (check_int "BAR" (msix_bir 12288) 0)
                 (check_int "offset" (msix_offset 12288) 12288)))))

; The first function given an MSI is 80, the 64th 143, a 65th none.
(def test_virt_msi () int
  (add (check_int "first" (virt_msi 0) 80)
       (add (check_int "last" (virt_msi 63) 143)
            (check_int "past" (virt_msi 64) 0))))
