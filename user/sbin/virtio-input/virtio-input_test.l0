; The keymap's own tests are in user/lib/sys/keymap_test.l0.

; ------------------------------------------------------------------ finding

(def test_keyboard_name () int
  (add (check_bool "QEMU's" (is_keyboard_name "QEMU Virtio Keyboard") true)
       (check_bool "a tablet" (is_keyboard_name "QEMU Virtio Tablet") false)))

; ----------------------------------------------------------------- queue

(def test_buffer_descriptors () int
  (let b (bytes_from_list (buffer_descriptors 2550136832 0 (nil int)))
    (add (check_int "16 of 16 bytes" (bytes_len b) 256)
         (add (check_int "first buffer" (le_u32 b 0) 2550137856)          ; + 1024
              (add (check_int "8 bytes" (le_u32 b 8) 8)
                   (add (check_int "written" (le_u32 b 12) 2)
                        (check_int "last buffer" (le_u32 b 240) 2550137976)))))))  ; + 1024 + 15 * 8

(def test_avail_all () int
  (let b (bytes_from_list (avail_all))
    (add (check_int "flags, idx 16" (le_u32 b 0) 1048576)
         (add (check_int "entries" (bytes_len b) 36)
              (check_int "ring 15" (bytes_get b 34) 15)))))

; Under an operating system there are no transports to drive.
(def test_no_device () int
  (check_int "fails" (virtio_input) 1))

; ---------------------------------------------------------------- tablet

(def int_text ((n int)) (list int) (if (lt n 0) (cons 45 (digits (neg n))) (digits n)))

; A tablet's state as x,y buttons, then the wheel's turn as w dx,dy if
; it has turned, then report if one is due.
(def kind_text ((k Kind)) (list int)
  (match k
    ((Keys m) "keys")
    ((Tablet x y b dx dy)
      (append (digits x) (append "," (append (digits y) (append " " (append (digits b) (turn_text dx dy)))))))))

(def turn_text ((dx int) (dy int)) (list int)
  (if (if (eq dx 0) (eq dy 0) false) "" (append " w " (append (int_text dx) (append "," (int_text dy))))))

(def tablet_text ((p Pointed)) (list int)
  (match p ((Pointed k report) (append (kind_text k) (if report " report" "")))))

(def test_tablet_axes () int
  (add (check_str "x" (tablet_text (pointed (Tablet 0 0 0 0 0) 3 0 16000)) "16000,0 0")
       (check_str "y" (tablet_text (pointed (Tablet 5 0 0 0 0) 3 1 32767)) "5,32767 0")))

(def test_tablet_buttons () int
  (add (check_str "left down" (tablet_text (pointed (Tablet 1 2 0 0 0) 1 272 1)) "1,2 1")
       (add (check_str "right down" (tablet_text (pointed (Tablet 1 2 1 0 0) 1 273 1)) "1,2 3")
            (check_str "left up" (tablet_text (pointed (Tablet 1 2 3 0 0) 1 272 0)) "1,2 2"))))

(def test_tablet_report () int
  (add (check_str "syn" (tablet_text (pointed (Tablet 7 8 1 0 0) 0 0 0)) "7,8 1 report")
       (check_str "a key passes over" (tablet_text (pointed (Tablet 7 8 0 0 0) 1 30 1)) "7,8 0")))

; EV_REL, REL_WHEEL: turned away from you, 1, scrolls up, -1 down; the
; device writes -1 as the le32 4294967295.
(def test_tablet_wheel () int
  (add (check_str "away, up" (tablet_text (pointed (Tablet 1 2 0 0 0) 2 8 1)) "1,2 0 w 0,-1")
       (check_str "toward you, down" (tablet_text (pointed (Tablet 1 2 0 0 0) 2 8 4294967295)) "1,2 0 w 0,1")))

; REL_HWHEEL is to the right; turns in one report add up.
(def test_tablet_hwheel () int
  (add (check_str "right" (tablet_text (pointed (Tablet 1 2 0 0 0) 2 6 1)) "1,2 0 w 1,0")
       (check_str "twice down" (tablet_text (pointed (Tablet 1 2 0 0 1) 2 8 4294967295)) "1,2 0 w 0,2")))

; Another relative axis, REL_X, is passed over.
(def test_tablet_other_rel () int
  (check_str "REL_X" (tablet_text (pointed (Tablet 1 2 0 0 0) 2 0 5)) "1,2 0"))

; A report with the wheel turned tells it as a wheel notice, and then
; the turn is counted from 0; with none, there is no wheel notice.
(def test_wheel_of_report () int
  (add (check_bool "turned" (eq (wheel_of (Tablet 3 4 0 0 2)) (Some (wheel_notice (WheelEvent 3 4 0 2)))) true)
       (add (check_bool "not turned" (eq (wheel_of (Tablet 3 4 1 0 0)) ((None (list int)))) true)
            (check_str "counted from 0" (kind_text (unturned (Tablet 3 4 1 2 -1))) "3,4 1"))))

(def test_roles () int
  (add (check_str "keyboard by default" (match (role_of (nil (list int))) ((Role what name k) name)) "keyboard")
       (check_str "tablet" (match (role_of (split_spaces "tablet")) ((Role what name k) (append what (append " " name)))) "Tablet pointer")))

(def test_input_line () int
  (check_str "keyboard" (input_line "QEMU Virtio Keyboard" 29 "keyboard")
    "QEMU Virtio Keyboard, virtio-mmio 29 at 0x0a003a00, irq 77, serving keyboard"))
