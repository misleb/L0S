; zone_test.l0 -- tests of zone.l0: Pacific time's changes, in several
; years, against the tz database's America/Los_Angeles.

(def test_civil_days () int
  (add (check_int "the epoch" (civil_days 1970 1 1) 0)
       (add (check_int "a leap day" (civil_days 2000 2 29) 11016)
            (check_int "civil's inverse" (civil_days 2026 10 30) (div 1793400120 86400)))))

(def test_sunday_from () int
  (add (check_int "1970-01-04" (sunday_from 0) 3)
       (check_int "a Sunday is its own" (sunday_from 3) 3)))

; 2026's summer time: 2026-03-08 10:00 UTC to 2026-11-01 09:00 UTC.
(def test_pacific_2026 () int
  (add (check_int "begins" (pacific_summer_from 2026) 1772964000)
       (check_int "ends" (pacific_summer_until 2026) 1793523600)))

; 2024, a leap year, from March 10; 2025 from March 9; 2027 from the
; 14th, the latest a second Sunday can be.
(def test_pacific_other_years () int
  (add (check_int "2024 begins" (pacific_summer_from 2024) 1710064800)
       (add (check_int "2024 ends" (pacific_summer_until 2024) 1730624400)
            (add (check_int "2025 begins" (pacific_summer_from 2025) 1741514400)
                 (add (check_int "2025 ends" (pacific_summer_until 2025) 1762074000)
                      (check_int "2027 begins" (pacific_summer_from 2027) 1805018400))))))

(def test_pacific_2007 () int
  (add (check_int "begins" (pacific_summer_from 2007) 1173607200)
       (check_int "ends" (pacific_summer_until 2007) 1194166800)))

(def zone_is ((name (list int)) (z ClockZone) (minutes int) (until int)) int
  (add (check_int (append name ": minutes") (.minutes z) minutes)
       (check_int (append name ": until") (.until z) until)))

; Around March's change: PST until 10:00 UTC, PDT from it until November.
(def test_pacific_zone_march () int
  (add (zone_is "a second before" (pacific_zone 1772963999) -480 1772964000)
       (zone_is "at it" (pacific_zone 1772964000) -420 1793523600)))

; Around November's: PDT until 9:00 UTC, then PST until next March.
(def test_pacific_zone_november () int
  (add (zone_is "a second before" (pacific_zone 1793523599) -420 1793523600)
       (zone_is "at it" (pacific_zone 1793523600) -480 (pacific_summer_from 2027))))

; January, before any change in its year, and the last of December,
; after both.
(def test_pacific_zone_winter () int
  (add (zone_is "new year 2030" (pacific_zone 1893499200) -480 1899367200)
       (zone_is "2030's last second" (pacific_zone 1924991999) -480 (pacific_summer_from 2031))))

; The day the clock reads in its zone across the change: 1:59 PST is
; followed by 3:00 PDT.
(def test_pacific_local_jump () int
  (add (check_str "before" (clock_text (zone_local (pacific_zone 1772963940) 1772963940)) "Mar 8  01:59")
       (check_str "after" (clock_text (zone_local (pacific_zone 1772964000) 1772964000)) "Mar 8  03:00")))

(def test_clock_zone_at () int
  (zone_is "October 2026" (clock_zone_at 1793400120) -420 1793523600))
