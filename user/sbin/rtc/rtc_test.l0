(def test_lines () int
  (add (check_str "advanced" (alarm_lines 5 6) "rtc: alarm rang\nrtc: clock advanced\n")
       (check_str "stuck" (alarm_lines 5 5) "rtc: alarm rang\nrtc: clock did not advance\n")))

; Under an operating system there is no clock to drive.
(def test_no_device () int
  (check_int "fails" (rtc) 1))

; Nor is there a PL031 or a mailbox for rtc clock, which is no failure:
; every client of clock goes on without one.
(def test_clock_no_device () int
  (check_int "exits 0" (rtc_main (split_spaces "clock")) 0))

(def test_usage () int
  (check_int "an unknown mode" (rtc_main (split_spaces "alarm")) 1))

(def test_clock_requests () int
  (add (check_bool "listen" (clock_request "listen") true)
       (add (check_bool "time" (clock_request "time") true)
            (check_bool "not another" (clock_request "date") false))))

(def test_clock_answer () int
  (add (check_str "the time" (clock_answer 60 "time") "time 60")
       (check_str "another" (clock_answer 60 "date") "error: no request date")))

; zone answers Pacific's offset at the time asked, and when it changes:
; 1793400120 is 2026-10-30 22:42 UTC, in PDT until 2026-11-01 09:00 UTC.
(def test_clock_answer_zone () int
  (add (check_str "summer" (clock_answer 1793400120 "zone") "zone -420 1793523600")
       (check_str "winter" (clock_answer 1793523600 "zone") "zone -480 1805018400")))

; A zone request with a reply port is answered and adds no listener.
(def test_zone_not_listening () int
  (check_int "nothing added" (length (clock_asked 60 (request 5 "zone") (nil int))) 0))

; Under an operating system every send reads as a full queue, so a
; listener is kept, and the listeners keep their order.
(def test_listen_kept () int
  (let ls (clock_asked 60 (request 5 "listen") (cons 6 (nil int)))
    (check_str "added after" (unwords (numbers_words ls)) "6 5")))

; The alarm for the next minute: at 100 ns on clock_ns, 20 seconds before
; it, 100 + 20e9; one that rang early, at the second before, a second on,
; not at once.
(def test_minute_alarm () int
  (add (check_int "20 s on" (minute_alarm 100 40 60) 20000000100)
       (add (check_int "early" (minute_alarm 100 60 60) 1000000100)
            (check_int "past" (minute_alarm 100 61 60) 1000000100))))

; A request with no reply port is answered by nothing.
(def test_no_reply_port () int
  (check_int "nothing added" (length (clock_asked 60 "ab" (nil int))) 0))

; 1,760,000,000 seconds is 2025-10-09 08:53:20 UTC: clock_text's own tests
; pin its form; here only that the line carries it.
(def test_clock_line () int
  (add (check_true "start" (starts_with (clock_line 1760000000) "a PL031 at 0x09010000, irq 34, the time "))
       (check_true "end" (ends_with (clock_line 1760000000) ", serving clock"))))

; A set is not one of the requests clock_asked answers: clock_serve takes
; it first, and set with no number falls through to be refused.
(def test_clock_set_refused () int
  (check_str "no number" (clock_answer 60 "set x") "error: no request set x"))

; 1793318400 is 2026-10-30 00:00 UTC, and 0 is 1970's first moment.
(def test_set_line () int
  (add (check_str "written" (set_line 0 1793318400 true)
                  "the clock set to Oct 30  00:00 UTC, from Jan 1  00:00 UTC, and the RTC to it")
       (check_str "not" (set_line 0 1793318400 false)
                  "the clock set to Oct 30  00:00 UTC, from Jan 1  00:00 UTC")))
