; rtc.l0 -- a driver in user space for the board's PL031 real-time clock.
; Its module must be flagged dev.
;
;   rtc         maps the clock, sets its alarm a second ahead, and waits
;               for the kernel to pass on the alarm's interrupt as a
;               message
;   rtc clock   maps the clock and serves clock (user/lib/clock.l0): the
;               time, to whoever asks, and at the start of every minute
;               to each process listening. It waits for requests,
;               and for the kernel's alarm (call 297) at the start of
;               the next minute, and leaves the interrupt alone, so rtc
;               can still take it

(def rtc_base () int 151060480)     ; 0x09010000
(def rtc_irq () int 34)

; The PL031's registers, as offsets.
(def reg_data () int 0)             ; seconds
(def reg_match () int 4)            ; the alarm, in seconds
(def reg_mask () int 16)            ; 1: the alarm interrupts
(def reg_clear () int 28)           ; 1: the alarm's interrupt ends

(def alarm_lines ((t0 int) (t1 int)) (list int)
  (if (gt t1 t0)
      "rtc: alarm rang\nrtc: clock advanced\n"
      "rtc: alarm rang\nrtc: clock did not advance\n"))

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "rtc" why))

; What rtc clock says as it starts serving clock: the clock's address and
; interrupt, and the time it reads, s seconds since 1970 (the same, in UTC,
; as the top bar shows).
(def clock_line ((s int)) (list int)
  (append "a PL031 at 0x" (append (hex_digits (rtc_base) 8)
    (append ", irq " (append (digits (rtc_irq))
      (append ", the time " (append (clock_text s) ", serving clock")))))))

(def rtc () int
  (match (open_region (rtc_base) 4096)
    ((IoRegionFailed fault why) (complain (append "no clock: " why)))
    ((IoRegionOpened d)
      (let (port (port_new) b (irq_bind_or_why (rtc_irq) port))
        (if (is_empty b) (alarm d port) (complain b))))))

(def alarm ((d IoRegion) (port int)) int
  (let (t0 (region_get32 d (reg_data))
        c (region_set32 d (reg_clear) 1)
        m (region_set32 d (reg_match) (add t0 1))
        k (region_set32 d (reg_mask) 1)
        w (write_line "rtc: alarm set"))
    (rang d port t0 (port_receive port))))

(def rang ((d IoRegion) (port int) (t0 int) (msg Message)) int
  (if (not (is_irq_notice msg (rtc_irq)))
      (complain "expected the alarm's interrupt")
      (let (t1 (region_get32 d (reg_data))
            k (region_set32 d (reg_mask) 0)
            c (region_set32 d (reg_clear) 1)
            a (irq_ack (rtc_irq))
            w (write_str (alarm_lines t0 t1)))
        (match a
          ((IrqAcked) 0)
          ((IrqNotPending) (complain "irq_ack refused: the interrupt is not pending"))))))

; --------------------------------------------------------------- serving

(def rtc_main ((as (list (list int)))) int
  (if (is_empty as)
      (rtc)
      (and (eq (head as) "clock") (is_empty (tail as)))
      (rtc_clock)
      (complain "usage: rtc [clock]")))

; The clock rtc clock serves: a PL031, or the Raspberry Pi 5's RTC,
; which only its firmware reaches (firmware.l0).
(data Clock (Pl031Clock IoRegion) (FirmwareClock FwClock))

; A PL031's part number in its ID registers.
(def pl031_part () int 49)               ; 0x031

; Seconds since 1970, as c says.
(def clock_now ((c Clock)) int
  (match c ((Pl031Clock d) (region_get32 d (reg_data))) ((FirmwareClock f) (fw_time f))))

; The board's clock, found: a PL031 where QEMU's virt board has one, if
; the kernel gives it and its ID registers say PL031; else the
; firmware's, on a Pi 5; else none, which is no failure, as every
; client of clock goes on without one.
(def rtc_clock () int
  (match (open_region (rtc_base) 4096)
    ((IoRegionOpened d)
      (if (eq (primecell_part d) (pl031_part))
          (clock_started (Pl031Clock d) (clock_line (region_get32 d (reg_data))))
          (let c (close_region d) (firmware_clock))))
    ((IoRegionFailed fault why) (firmware_clock))))

; The firmware's clock served, or none, which is no failure.
(def firmware_clock () int
  (match (fw_clock_found)
    ((NoFw why) (info_as "rtc" (append "no clock on the board: " why)))
    ((FwFound f t) (clock_started (FirmwareClock f) (fw_clock_line t)))))

; clock served from c, once said as line.
(def clock_started ((c Clock) (line (list int))) int
  (let (port (port_new) r (name_register_or_why port "clock"))
    (if (is_empty r)
        (let n (info_as "rtc" line)
          (clock_serve c port (clock_alarmed c port) (nil int)))
        (complain r))))

; Each request answered as it comes, and the listeners told the time
; when the kernel's alarm rings at the start of a minute: due is when the
; next minute begins, as c counts, which the alarm is set for, and ls the
; ports listening. An alarm that rings before c has reached due, as one
; may if the board's clock and the kernel's drift apart, is set again.
(def clock_serve ((c Clock) (port int) (due int) (ls (list int))) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from b)
      (if (is_alarm_notice (Message from b))
          (let t (clock_now c)
            (if (lt t due)
                (let a (alarm_at port (minute_alarm (clock_ns) t due)) (clock_serve c port due ls))
                (clock_serve c port (clock_alarmed c port) (listeners_tell ls (time_notice t)))))
          (clock_serve c port due (clock_asked (clock_now c) (msg_text b) ls))))))

; When the next minute begins, as c counts, the kernel's alarm set for
; it on port.
(def clock_alarmed ((c Clock) (port int)) int
  (let (t (clock_now c)
        due (next_minute t)
        a (alarm_at port (minute_alarm (clock_ns) t due)))
    due))

; The time on clock_ns, now there, when the clock that says t now says
; due: the seconds between them later, and at least one, so an alarm
; that rang early does not ring again at once.
(def minute_alarm ((now int) (t int) (due int)) int
  (add now (mul (max 1 (sub due t)) 1000000000)))

; A request at t, answered: listen adds its reply port to ls.
(def clock_asked ((t int) (payload (list int)) (ls (list int))) (list int)
  (let body (request_body payload)
    (if (le (request_reply payload) 0)
        ls
        (let s (port_send (request_reply payload) (clock_answer t body))
          (if (eq body "listen") (listener_add ls (request_reply payload) s) ls)))))

; The answer to body at t: the time, or that there is no such request.
(def clock_answer ((t int) (body (list int))) (list int)
  (if (clock_request body) (time_notice t) (error_reply (append "no request " body))))

(def clock_request ((body (list int))) bool
  (any_eq body (split_spaces "listen time")))
