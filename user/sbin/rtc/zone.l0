; zone.l0 -- the zone rtc clock serves, its one place: US Pacific time,
; PST (UTC-8) and PDT (UTC-7), by the US rule since 2007, summer time
; from 2:00 local on the second Sunday of March to 2:00 local on the
; first Sunday of November. The rule is taken for every year, those
; before 2007 too. A configuration tool (roadmap 0029) will change it.

; The zone the clock is shown in when it says s.
(def clock_zone_at ((s int)) ClockZone (pacific_zone s))

; Pacific's offsets, in minutes east of UTC: standard time, and summer.
(def pacific_standard () int -480)
(def pacific_daylight () int -420)

; The day y-m-d is, counted from 1970-01-01, for a year from 1 on:
; Howard Hinnant's days_from_civil, civil's inverse.
(def civil_days ((y int) (m int) (d int)) int
  (let (y2 (if (le m 2) (sub y 1) y)
        era (div y2 400)
        yoe (sub y2 (mul era 400))
        mp (if (gt m 2) (sub m 3) (add m 9))
        doy (add (div (add (mul 153 mp) 2) 5) (sub d 1))
        doe (add (sub (add (mul yoe 365) (div yoe 4)) (div yoe 100)) doy))
    (sub (add (mul era 146097) doe) 719468)))

; The first Sunday on or after day n, n 0 or more: 1970-01-01 was a
; Thursday, so day n is (n + 4) mod 7 days after a Sunday.
(def sunday_from ((n int)) int (add n (mod (sub 7 (mod (add n 4) 7)) 7)))

; When summer time begins in year y, as the clock counts: 2:00 PST on
; the second Sunday of March, the first on or after the 8th, is 10:00
; UTC.
(def pacific_summer_from ((y int)) int
  (add (mul (sunday_from (civil_days y 3 8)) 86400) 36000))

; When it ends: 2:00 PDT on the first Sunday of November is 9:00 UTC.
(def pacific_summer_until ((y int)) int
  (add (mul (sunday_from (civil_days y 11 1)) 86400) 32400))

; The Pacific zone in force when the clock says s, 0 or more, and when
; it next changes.
(def pacific_zone ((s int)) ClockZone
  (match (civil (div s 86400))
    ((Civil y m d)
      (let (from (pacific_summer_from y) until (pacific_summer_until y))
        (if (lt s from) (ClockZone (pacific_standard) from)
            (lt s until) (ClockZone (pacific_daylight) until)
            (ClockZone (pacific_standard) (pacific_summer_from (add y 1))))))))
