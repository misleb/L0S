; firmware_test.l0 -- tests of the firmware's RTC messages.

(def words_text ((ws (list int))) (list int)
  (if (is_empty ws) "" (append (hex_digits (head ws) 8) (append " " (words_text (tail ws))))))

; 32 bytes, a request, GET_RTC_REG with 8 bytes of value, register 0.
(def test_rtc_request () int
  (check_str "eight words" (words_text (rtc_request (rtc_time_reg)))
    "00000020 00000000 00030087 00000008 00000000 00000000 00000000 00000000 "))

; The firmware's answer: the buffer's code 0x80000000, the tag's bit 31
; and its length, 8, and the time after the register.
(def answer ((code int) (tagcode int)) (list int)
  (cons 32 (cons code (cons (tag_get_rtc_reg) (cons 8 (cons tagcode (cons 0 (cons 1760000000 (cons 0 (nil int))))))))))

(def reply_text ((r (Option int))) (list int)
  (match r ((None) "none") ((Some t) (digits t))))

(def test_rtc_reply () int
  (check_str "the time" (reply_text (rtc_reply (answer 2147483648 2147483656))) "1760000000"))

(def test_rtc_reply_failed () int
  (add (check_str "the buffer refused" (reply_text (rtc_reply (answer 2147483649 2147483656))) "none")
       (add (check_str "the tag unanswered" (reply_text (rtc_reply (answer 2147483648 8))) "none")
            (check_str "too short" (reply_text (rtc_reply (cons 32 (nil int)))) "none"))))

(def test_fw_clock_line () int
  (check_true "where" (starts_with (fw_clock_line 0) "the Raspberry Pi 5's RTC, through the firmware's mailbox at 0x107c013880, the time ")))

; Under an operating system there is no mailbox.
(def test_fw_none () int
  (match (fw_clock_found)
    ((NoFw why) (check_str "why" why "no VideoCore mailbox on the board"))
    ((FwFound c t) (fail_because "none" "found one"))))
