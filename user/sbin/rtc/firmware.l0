; firmware.l0 -- the Raspberry Pi 5's real-time clock, which is in its
; power controller and which only the board's firmware reaches: asked for
; through the VideoCore mailbox (mailbox.l0) by the firmware's property
; interface, as Linux's rtc-rpi does. The messages are pure. None of it
; has run on a board.

; RPI_FIRMWARE_GET_RTC_REG, and the RTC's register RTC_TIME, seconds
; since 1970 (rtc-rpi.c).
(def tag_get_rtc_reg () int 196743)      ; 0x00030087
(def rtc_time_reg () int 0)

; The buffer asking for register reg: its size in bytes, the request's
; code, the tag, its value's 8 bytes, its own code, the register and room
; for its value, and the end tag.
(def rtc_request ((reg int)) (list int)
  (cons 32 (cons 0 (cons (tag_get_rtc_reg) (cons 8 (cons 0 (cons reg (cons 0 (cons 0 (nil int))))))))))

; What the firmware wrote back, the same eight words: the register's
; value, if the buffer and the tag both say they succeeded.
(def rtc_reply ((ws (list int))) (Option int)
  (if (not (eq (length ws) 8))
      ((None int))
      (property_answered ws)
      (Some (nth ws 6))
      ((None int))))

; ------------------------------------------------------------- asking

; The firmware's clock: the mailbox it is asked through.
(data FwClock (FwClock Mailbox))

; The firmware's clock found: the mailbox opened, and the clock
; answering; or why not.
(data FwFound (FwFound FwClock int) (NoFw (list int)))

; The firmware's clock, if the mailbox opens and the firmware answers.
(def fw_clock_found () FwFound
  (match (mailbox_open)
    ((NoMbox why) (NoFw why))
    ((MboxOpen mb)
      (let c (FwClock mb)
        (match (fw_rtc c (rtc_time_reg))
          ((None) (NoFw "the firmware does not answer for the RTC"))
          ((Some t) (FwFound c t)))))))

; The seconds since 1970 the firmware's clock says, or 0 if it does not
; answer.
(def fw_time ((c FwClock)) int
  (match (fw_rtc c (rtc_time_reg)) ((None) 0) ((Some t) t)))

; Register reg of the RTC, asked of the firmware.
(def fw_rtc ((c FwClock) (reg int)) (Option int)
  (match c
    ((FwClock mb)
      (match (mailbox_ask mb (rtc_request reg) 8)
        ((None) ((None int)))
        ((Some ws) (rtc_reply ws))))))

; What rtc clock says as it starts serving the firmware's clock.
(def fw_clock_line ((s int)) (list int)
  (append "the Raspberry Pi 5's RTC, through the firmware's mailbox at 0x"
    (append (hex_digits (mbox_base) 10) (append ", the time " (append (clock_text s) ", serving clock")))))
