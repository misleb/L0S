(def test_header () int
  (let b (bytes_from_list (blk_header (blk_out) 70000))
    (add (check_int "16 bytes" (bytes_len b) 16)
         (add (check_int "type" (le_u32 b 0) 1)
              (add (check_int "reserved" (le_u32 b 4) 0)
                   (check_int "sector" (le_u32 b 8) 70000))))))

(def run_text ((rs (list VirtqRun))) (list int)
  (if (is_empty rs)
      ""
      (match (head rs)
        ((VirtqRun a n) (append (digits a) (append "+" (append (digits n) (append " " (run_text (tail rs))))))))))

(def sample_addrs () (array int)
  (array_from (cons 40960 (cons 81920 (nil int))) 0))

; A page, then what is left: 5000 bytes are 4096 and 904.
(def test_runs () int
  (add (check_str "two pages" (run_text (blk_runs (sample_addrs) 5000)) "40960+4096 81920+904 ")
       (check_str "one sector" (run_text (blk_runs (sample_addrs) 512)) "40960+512 ")))

; Pages next to each other where the device sees them are one run.
(def test_runs_joined () int
  (check_str "one run" (run_text (blk_runs (array_from (cons 40960 (cons 45056 (nil int))) 0) 5000)) "40960+5000 "))

; Flags and next, as the word at 12 of a descriptor: flags, then next
; shifted 16. The header is NEXT to 1; data NEXT, and WRITE when reading,
; to 2; the status WRITE alone.
(def test_descriptors_reading () int
  (let b (bytes_from_list (blk_descriptors 1024 (blk_runs (sample_addrs) 512) true 1040))
    (add (check_int "three descriptors" (bytes_len b) 48)
         (add (check_int "header" (le_u32 b 12) 65537)
              (add (check_int "data, written" (le_u32 b 28) 131075)
                   (add (check_int "status address" (le_u32 b 32) 1040)
                        (check_int "status" (le_u32 b 44) 2)))))))

(def test_descriptors_writing () int
  (let b (bytes_from_list (blk_descriptors 1024 (blk_runs (sample_addrs) 5000) false 1040))
    (add (check_int "four descriptors" (bytes_len b) 64)
         (add (check_int "data, read" (le_u32 b 28) 131073)
              (add (check_int "the second page" (le_u32 b 32) 81920)
                   (check_int "status last, after 3" (le_u32 b 60) 2))))))

(def test_why () int
  (add (check_str "ok" (blk_why 0) "")
       (add (check_str "ioerr" (blk_why 1) "the disk failed the request")
            (add (check_str "unsupp" (blk_why 2) "the disk does not do that")
                 (check_str "never written" (blk_why 255) "the disk answered 255")))))

(def test_refusals () int
  (add (check_str "the last sector" (blk_refusal 2047 1 2048) "")
       (add (check_str "past the end" (blk_refusal 2047 2 2048) "past the disk's end, sector 2047")
            (add (check_str "none" (blk_refusal 0 0 2048) "a request moves 1 to 128 sectors")
                 (check_str "too many" (blk_refusal 0 129 2048) "a request moves 1 to 128 sectors")))))

; Eight sectors are a page.
(def test_pages () int
  (add (check_int "one" (blk_pages 1) 1)
       (add (check_int "eight" (blk_pages 8) 1)
            (add (check_int "nine" (blk_pages 9) 2)
                 (check_int "the most" (blk_pages (blk_max_sectors)) 16)))))

; A request's numbers are server.l0's request_numbers, which reads a
; negative one; a negative sector is refused here.
(def test_negative_refused () int
  (check_str "below 0" (blk_refusal -1 1 2048) "no sector below 0"))

; Under an operating system there are no transports to drive.
(def test_no_device () int
  (check_int "fails" (virtio_blk) 1))

; A flush moves no data: its header chains straight to the status.
(def test_descriptors_flush () int
  (let b (bytes_from_list (blk_descriptors 1024 (nil VirtqRun) false 1040))
    (add (check_int "two descriptors" (bytes_len b) 32)
         (add (check_int "header, next 1" (le_u32 b 12) 65537)
              (check_int "status" (le_u32 b 28) 2)))))

(def test_flush_header () int
  (let b (bytes_from_list (blk_header (blk_flush) 0))
    (add (check_int "type" (le_u32 b 0) 4)
         (check_int "sector" (le_u32 b 8) 0))))

; The driver asks for RO and FLUSH, bits 5 and 9.
(def test_wanted () int
  (add (check_int "both" (blk_wanted) 544)
       (add (check_bool "has flush" (blk_has 512 (blk_f_flush)) true)
            (check_bool "not ro" (blk_has 512 (blk_f_ro)) false))))

; A read-only disk refuses a write, before its sectors are looked at, and
; takes a read.
(def test_read_only () int
  (add (check_str "write" (blk_move_refusal (blk_out) 0 1 2048 (blk_f_ro)) "the disk is read-only")
       (add (check_str "past the end too" (blk_move_refusal (blk_out) 5000 1 2048 (blk_f_ro)) "the disk is read-only")
            (add (check_str "read" (blk_move_refusal (blk_in) 0 1 2048 (blk_f_ro)) "")
                 (check_str "writable" (blk_move_refusal (blk_out) 0 1 2048 (blk_f_flush)) "")))))

(def test_move_refusal_sectors () int
  (check_str "past the end" (blk_move_refusal (blk_in) 2047 2 2048 0) "past the disk's end, sector 2047"))

; A request is overdue only past 30 s, blk_patience_ns, after it was made.
(def test_overdue () int
  (add (check_bool "at 30 s" (blk_overdue 1000 (add 1000 30000000000)) false)
       (check_bool "just past" (blk_overdue 1000 (add 1001 30000000000)) true)))
