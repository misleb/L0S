; virtio-blk.l0 -- a disk driver for QEMU's virtio-blk, serving the disk
; protocol, user/lib/disk.l0: 512-byte sectors, read into and written
; from pages a client shares with it, and flushes of the disk's cache.
; Its module must be flagged dev.
;
; No sector passes through a message, or through the driver: a request
; names the client's pages, where they are mapped here, and the device
; reads or writes them itself, by DMA. The driver makes one request of
; the device at a time, and waits for the device's interrupt, which the
; kernel sends to a port of its own, so that the requests waiting on the
; other stay where they are. A request that takes more than 30 s leaves
; the disk taken to have stopped answering: it and every later one fail.
;
; It accepts two of the device's features, when it offers them: FLUSH,
; so that a flush empties the disk's write cache, and RO, so that it
; knows a disk is read-only and refuses its writes itself.

(def blk_device () int 2)           ; DeviceID of a block device

; ---------------------------------------------------------------- features

; VIRTIO_BLK_F_RO, bit 5, the disk is read-only; VIRTIO_BLK_F_FLUSH, bit
; 9, it has a write cache, which a flush request empties (virtio 1.2,
; section 5.2.3).
(def blk_f_ro () int 32)
(def blk_f_flush () int 512)

; The features the driver asks for.
(def blk_wanted () int (bit_or (blk_f_ro) (blk_f_flush)))

; Whether features, as negotiated, include f.
(def blk_has ((features int) (f int)) bool (not (eq (bit_and features f) 0)))

; ---------------------------------------------------------------- requests

; virtio-blk's request types and statuses (virtio 1.2, section 5.2.6).
(def blk_in () int 0)               ; read sectors from the disk
(def blk_out () int 1)              ; write sectors to it
(def blk_flush () int 4)            ; empty its write cache
(def blk_ok () int 0)
(def blk_ioerr () int 1)
(def blk_unsupp () int 2)

(def sector_size () int 512)

; The most sectors one request may move: 64 KB, 16 pages, so a chain is
; at most 18 descriptors, within the ring.
(def blk_max_sectors () int 128)

; A request's header: its type, a reserved word, and the first sector.
(def blk_header ((type int) (sector int)) (list int)
  (append (u32_le type) (append (u32_le 0) (le64 sector))))

; The n bytes of a client's buffer whose pages the device reaches at
; addrs, as runs, in order.
(def blk_runs ((addrs (array int)) (n int)) (list VirtqRun)
  (rev (virtq_page_runs addrs 0 n (nil VirtqRun))))

; A request's chain: the header at hdr, readable; each run of data, which
; the device writes when reading the disk; and the status byte at status,
; which it writes. A flush has no runs, so its header chains to the
; status at once.
(def blk_descriptors ((hdr int) (runs (list VirtqRun)) (reading bool) (status int)) (list int)
  (let flags (if reading (bit_or (desc_next) (desc_write)) (desc_next))
    (rev (push (descriptor status 1 (desc_write) 0)
               (virtq_push_chain runs flags 2 (push (descriptor hdr 16 (desc_next) 1) (nil int)))))))

; What the device's status byte says, as a reason; empty for ok.
(def blk_why ((status int)) (list int)
  (if (eq status (blk_ok)) ""
      (eq status (blk_ioerr)) "the disk failed the request"
      (eq status (blk_unsupp)) "the disk does not do that"
      (append "the disk answered " (digits status))))

; Why sectors from sector, count of them, cannot be moved on a disk of cap
; sectors; empty if they can.
(def blk_refusal ((sector int) (count int) (cap int)) (list int)
  (if (or (lt count 1) (gt count (blk_max_sectors)))
      (append "a request moves 1 to " (append (digits (blk_max_sectors)) " sectors"))
      (lt sector 0) "no sector below 0"
      (gt (add sector count) cap) (append "past the disk's end, sector " (digits (sub cap 1)))
      ""))

; Why a request of type cannot be made of a disk with features; empty if
; it can. A read-only disk takes no write.
(def blk_feature_refusal ((type int) (features int)) (list int)
  (if (and (eq type (blk_out)) (blk_has features (blk_f_ro)))
      "the disk is read-only"
      ""))

; The pages count sectors take.
(def blk_pages ((count int)) int (pages_for (mul count (sector_size))))

; ---------------------------------------------------------------- the queue

; The queue, in one DMA page: 16 descriptors at 0, the available ring at
; 256, the used ring at 512, the request's header at 1024 and its status
; at 1040.
(def ring_size () int 16)
(def avail_off () int (virtq_avail_off (ring_size)))
(def used_off () int (virtq_used_off (ring_size)))
(def header_off () int 1024)
(def status_off () int 1040)

; The driver: the transports' registers and the disk's transport, the
; queue's page and where the device reaches it, the disk's size in
; sectors, how many requests it has made, the features the device and it
; agreed on, the port the device's interrupt comes to, and whether the
; disk has stopped answering, a request outliving blk_patience_ns.
(data Blk (Blk IoRegion int IoRegion int int int int int bool))

; What came of a request: the driver after it, and why it failed, or
; empty.
(data BlkDone (BlkDone Blk (list int)))

; How long a request may take before the disk is taken to have stopped
; answering: 30 s, well past a flush of a slow host's cache.
(def blk_patience_ns () int 30000000000)

; Why every request fails once the disk has stopped answering.
(def blk_hung_why () (list int) "the disk stopped answering")

; Whether a request made at since is overdue at now.
(def blk_overdue ((since int) (now int)) bool (gt (sub now since) (blk_patience_ns)))

; type for count sectors from sector, the data at runs, made of the
; device and waited for; refused at once once the disk has stopped
; answering, since the request it never finished may still be in its
; queue.
(def blk_request ((b Blk) (type int) (sector int) (runs (list VirtqRun))) BlkDone
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (if hung
          (BlkDone b (blk_hung_why))
          (let (h (put_bytes q (header_off) (blk_header type sector))
                s (region_set8 q (status_off) 255)
                c (put_bytes q 0 (blk_descriptors (add qa (header_off)) runs (eq type (blk_in)) (add qa (status_off)))))
            (blk_queued b))))))

; The request at descriptor 0 made available and the device told.
(def blk_queued ((b Blk)) BlkDone
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (let n2 (virtq_offer d t 0 q (avail_off) (ring_size) n 0)
        (blk_finished (Blk d t q qa cap n2 fs ip hung) (clock_ns))))))

; The request made at since, waited for, and its status read: done once
; the used ring has it. Until then the device's interrupt port is looked
; at, yielding for virtq_spin_ns and then sleeping a millisecond at a
; time, as a receive cannot time out; an interrupt for a request already
; done may be waiting there too, and is ended like any other. A request
; overdue leaves the driver hung.
(def blk_finished ((b Blk) (since int)) BlkDone
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (let br (barrier)
        (if (eq (virtq_used_index q (used_off)) (bit_and n 65535))
            (let b2 (barrier) (BlkDone b (blk_why (region_get8 q (status_off)))))
            (match (port_try_receive ip)
              ((Message from mb)
                (let e (if (is_irq_notice (Message from mb) (transport_irq t)) (blk_interrupted d t) 0)
                  (blk_finished b since)))
              ((RecvFailed) (blk_waited b since (clock_ns)))))))))

; Nothing on the interrupt port at now: the driver hung if the request
; made at since is overdue, and otherwise waited a little and looked again.
(def blk_waited ((b Blk) (since int) (now int)) BlkDone
  (if (blk_overdue since now)
      (match b ((Blk d t q qa cap n fs ip hung) (BlkDone (Blk d t q qa cap n fs ip true) (blk_hung_why))))
      (let s (if (lt (sub now since) (virtq_spin_ns)) (l0s_yield) (sleep_ns 1000000))
        (blk_finished b since))))

; Transport t's interrupt ended: the device's status acknowledged, then
; the kernel's.
(def blk_interrupted ((d IoRegion) (t int)) int
  (let (st (region_get32 d (treg t (reg_interrupt_status)))
        a (region_set32 d (treg t (reg_interrupt_ack)) st)
        br (barrier))
    (match (irq_ack (transport_irq t)) ((IrqAcked) 0) ((IrqNotPending) 0))))

; ---------------------------------------------------------------- driving

; Fails, saying why.
(def complain ((why (list int))) int (fail_as "virtio-blk" why))

; What the driver says once it serves disk name: its size and sectors,
; read-only if the device is, and where it is.
(def disk_line ((name (list int)) (sectors int) (ro bool) (t int)) (list int)
  (append name (append ": a disk of " (append (format_size (mul sectors 512))
    (append ", " (append (digits sectors) (append " sectors"
      (append (if ro ", read-only" "") (append ", " (virtio_where t))))))))))

; The driver: the transports opened, and the first disk among them found.
(def virtio_blk () int
  (match (virtio_open)
    ((Err why) (complain why))
    ((Ok d) (found d (find_device d (blk_device) 0)))))

; No disk is no failure: the board was started without one.
(def found ((d IoRegion) (t int)) int
  (match (virtio_probe_features d t "the virtio-blk" "request" (ring_size) (blk_wanted))
    ((VirtioAbsent) (info_as "virtio-blk" "no virtio-blk on the board"))
    ((VirtioUnusable why) (complain why))
    ((VirtioReady t2)
      (match (virtq_mem 1 "the queue")
        ((NoVirtqMem why) (complain why))
        ((VirtqMem va q addrs)
          (started (Blk d t q (array_get addrs 0) (capacity d t) 0
                        (bit_and (blk_wanted) (device_features d t 0)) 0 false)))))))

; The disk's size in sectors: config's capacity, a le64 at its start.
(def capacity ((d IoRegion) (t int)) int
  (bit_or (region_get32 d (treg t (reg_config)))
          (bit_shl (region_get32 d (treg t (add (reg_config) 4))) 32)))

; The queue started, the device's interrupt bound to a port of its own,
; the device told the driver is ready, and the disk served.
(def started ((b Blk)) int
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (let (s (start_queue d t 0 (ring_size) qa (add qa (avail_off)) (add qa (used_off)))
            iport (port_new)
            why (irq_bind_or_why (transport_irq t) iport))
        (if (not (is_empty why))
            (complain why)
            (let o (driver_ok d t)
              (start_serving (Blk d t q qa cap n fs iport hung))))))))

; ---------------------------------------------------------------- serving

; Registers as the first diskN no one has, tells fs of it if fs is there
; yet, then answers each request, as disk.l0 makes them: ok, disk
; SECTORS 512, or error: WHY.
(def start_serving ((b Blk)) int
  (let port (port_new)
    (match (disk_register port)
      ((Err why) (complain (append "cannot register as a disk: " why)))
      ((Ok name)
        (let (n (match b ((Blk d t q qa cap nreq feats ip hung) (info_as "virtio-blk" (disk_line name cap (blk_has feats (blk_f_ro)) t))))
              a (fs_attach_disk name))
          (serve b port name))))))

; Each request on port, for the disk registered as name, answered, one
; at a time.
(def serve ((b Blk) (port int) (name (list int))) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from mb)
      (match (handle b name (msg_text_from mb 4))
        ((Served b2 reply)
          (let r (msg_answer mb reply)
            (serve b2 port name)))))))

; A request's body, the disk it names, then its op and its numbers,
; answered; one for another disk is refused.
(def handle ((b Blk) (name (list int)) (body (list int))) (Served Blk)
  (match (disk_asked body)
    ((DiskAsked asked rest)
      (if (not (eq asked name))
          (served_error b (append "no disk " (if (is_empty asked) "named" asked)))
          (match (request_numbers rest)
            ((ReqBad why) (served_error b why))
            ((ReqNums op ns) (requested b op ns (length ns))))))))

; The request op with its n numbers ns, answered.
(def requested ((b Blk) (op (list int)) (ns (list int)) (n int)) (Served Blk)
  (if (and (eq op "info") (eq n 0)) (info b)
      (and (eq op "read") (eq n 3)) (moved b (blk_in) (nth ns 0) (nth ns 1) (nth ns 2))
      (and (eq op "write") (eq n 3)) (moved b (blk_out) (nth ns 0) (nth ns 1) (nth ns 2))
      (and (eq op "flush") (eq n 0)) (flushed b)
      (served_error b (append "no request " op))))

; info: the disk's size, in sectors, and a sector's; and ro after them
; for a read-only disk.
(def info ((b Blk)) (Served Blk)
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (Served b (append "disk " (append (digits cap) (append " " (append (digits (sector_size))
                  (if (blk_has fs (blk_f_ro)) " ro" "")))))))))

; flush: what the disk's cache holds written to the disk itself. A disk
; with no cache, which offers no FLUSH, writes through, so has nothing to
; flush.
(def flushed ((b Blk)) (Served Blk)
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (if (not (blk_has fs (blk_f_flush)))
          (served_ok b)
          (blk_answered (blk_request b (blk_flush) 0 (nil VirtqRun)))))))

; A request's outcome, as the answer to it.
(def blk_answered ((r BlkDone)) (Served Blk)
  (match r ((BlkDone b2 err) (if (is_empty err) (served_ok b2) (served_error b2 err)))))

; read or write SECTOR COUNT VA: count sectors from sector moved, as type
; says, between the disk and the client's pages shared here at va.
(def moved ((b Blk) (type int) (sector int) (count int) (va int)) (Served Blk)
  (match b
    ((Blk d t q qa cap n fs ip hung)
      (let why (blk_move_refusal type sector count cap fs)
        (if (not (is_empty why))
            (served_error b why)
            (match (page_addresses va (blk_pages count))
              ((None) (served_error b "the buffer is not shared with the disk"))
              ((Some addrs)
                (blk_answered (blk_request b type sector (blk_runs addrs (mul count (sector_size))))))))))))

; Why a request of type for count sectors from sector cannot be made of a
; disk of cap sectors with features; empty if it can.
(def blk_move_refusal ((type int) (sector int) (count int) (cap int) (features int)) (list int)
  (let why (blk_feature_refusal type features)
    (if (is_empty why) (blk_refusal sector count cap) why)))
