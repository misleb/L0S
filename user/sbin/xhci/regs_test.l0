; regs_test.l0 -- the capability registers read.

; QEMU's qemu-xhci: HCSPARAMS1 0x08000840, 64 slots, 8 ports; HCCPARAMS1
; with xECP 0x20 u32s and 32-byte contexts.
(def test_qemu_params () int
  (add (check_int "slots" (max_slots_of 134219840) 64)
       (add (check_int "ports" (max_ports_of 134219840) 8)
            (add (check_int "xECP" (xecp_of 2097152) 128)
                 (check_int "contexts" (context_size_of 2097152) 32)))))

(def test_csz () int
  (check_int "64 bytes" (context_size_of 4) 64))

; Scratchpads: the high five bits at 21, the low at 27: 0x08200000 says
; 1 × 32 + 1 = 33.
(def test_scratchpads () int
  (add (check_int "33" (scratchpads_of 136314880) 33)
       (check_int "none" (scratchpads_of 15) 0)))

(def test_offsets () int
  (add (check_int "port 1" (op_portsc 1) 1024)
       (add (check_int "port 5" (op_portsc 5) 1088)
            (add (check_int "DBOFF" (dboff_of 8195) 8192) (check_int "RTSOFF" (rtsoff_of 4127) 4096)))))

; Supported Protocol: USB 3.0 (major 3 at bit 24), ports 5 to 8.
(def test_protocol () int
  (add (check_int "major" (protocol_major 50331650) 3)
       (add (check_int "first" (protocol_first_port 1029) 5)
            (check_int "count" (protocol_port_count 1029) 4))))

(def test_ports_marked () int
  (check_bool "5 to 8 USB 3" (eq (ports_marked (array_new 9 2) 3 5 4) (array_set (array_set (array_set (array_set (array_new 9 2) 5 3) 6 3) 7 3) 8 3)) true))

(def test_xcap () int
  (add (check_int "id" (xcap_id 1026) 2)
       (check_int "next, in bytes" (xcap_next 1026) 16)))
