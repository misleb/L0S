; port_test.l0 -- PORTSC read and written.

; A USB 2 port with a high-speed device just plugged in: CCS, PP, speed
; 3, CSC; 0x00020E01.
(def plugged () int 134657)

; Its reset done: CCS, PED, PP, speed 3, PRC; 0x00200E03.
(def reset_done () int 2100739)

(def test_neutral_keeps_power_and_speed () int
  (check_str "neutral" (hex_digits (port_neutral (plugged)) 8) "00000e01"))

; Writing back what was read would disable the port: PED is cleared by
; a 1.
(def test_neutral_drops_enabled () int
  (check_bool "PED cleared" (port_enabled (port_neutral (reset_done))) false))

(def test_clear () int
  (add (check_str "CSC cleared" (hex_digits (port_clear_write (plugged)) 8) "00020e01")
       (check_str "PRC cleared" (hex_digits (port_clear_write (reset_done)) 8) "00200e01")))

(def test_reset () int
  (check_str "PR and CSC" (hex_digits (port_reset_write (plugged)) 8) "00020e11"))

(def test_reading () int
  (add (check_bool "connected" (port_connected (plugged)) true)
       (add (check_bool "not enabled" (port_enabled (plugged)) false)
            (add (check_int "high speed" (port_speed (plugged)) 3)
                 (check_bool "changes" (port_has_changes (plugged)) true)))))

(def test_text () int
  (add (check_str "plugged" (portsc_text (plugged)) "ccs pp csc speed high")
       (check_str "reset" (portsc_text (reset_done)) "ccs ped pp prc speed high")))
