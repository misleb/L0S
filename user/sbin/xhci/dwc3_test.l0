; dwc3_test.l0 -- DWC3's global registers.

; After reset GCTL says device-or-host, 2 (0x2000), and other bits kept.
(def test_gctl_host () int
  (add (check_str "host" (hex_digits (gctl_host 8196) 4) "1004")      ; 0x2004 to 0x1004
       (check_str "already" (hex_digits (gctl_host 4096) 4) "1000")))

(def test_phys_awake () int
  (add (check_str "u2" (hex_digits (u2_awake 64) 1) "0")
       (check_str "u3, bit 1 kept" (hex_digits (u3_awake 131074) 1) "2")))

(def test_rp1 () int
  (add (check_str "usb0" (hex_digits (rp1_usb0) 0) "1f00200000")
       (add (check_str "usb1" (hex_digits (rp1_usb1) 0) "1f00300000")
            (check_str "dma" (hex_digits (rp1_dma_offset) 0) "1000000000"))))
