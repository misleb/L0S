; port.l0 -- a root hub port's PORTSC (xHCI 1.2, section 5.4.8), read
; and written purely. Writing it back as read would do harm: Port Enabled
; is cleared by writing it 1, which disables the port, and so are the
; change bits, which would be lost. So a write starts from the neutral
; value, what may be written back unchanged, and adds only what it
; means to do: clear the changes it has seen, or reset the port.

; Its bits: Current Connect Status, Port Enabled, Port Reset, Port Power,
; and the change bits of the connection, of being enabled, and of a
; reset's end.
(def portsc_ccs () int 1)
(def portsc_ped () int 2)
(def portsc_pr () int 16)
(def portsc_pp () int 512)
(def portsc_csc () int 131072)          ; bit 17
(def portsc_pec () int 262144)          ; bit 18
(def portsc_prc () int 2097152)         ; bit 21

; Every change bit, 17 to 23, each cleared by writing it 1.
(def portsc_changes () int 16646144)    ; 0x00FE0000

; The bits a write may give back as they were read: those only read
; (CCS, OCA, the speed, CAS, DR) and those kept until written (the link
; state, PP, the indicator, the wake enables); not PED, PR, LWS, the
; change bits or WPR, whose 1s act. 0x4F00FFE9.
(def portsc_kept () int 1325465577)

; v as a write leaves the port: changing nothing.
(def port_neutral ((v int)) int (bit_and v (portsc_kept)))

; The write that clears the changes v shows.
(def port_clear_write ((v int)) int (bit_or (port_neutral v) (bit_and v (portsc_changes))))

; The write that resets the port, clearing the changes too.
(def port_reset_write ((v int)) int (bit_or (port_clear_write v) (portsc_pr)))

; Whether v says a device is there; the port is enabled; it is being
; reset; the connection has changed; a reset has ended; anything has.
(def port_connected ((v int)) bool (not (eq (bit_and v (portsc_ccs)) 0)))
(def port_enabled ((v int)) bool (not (eq (bit_and v (portsc_ped)) 0)))
(def port_resetting ((v int)) bool (not (eq (bit_and v (portsc_pr)) 0)))
(def port_connect_changed ((v int)) bool (not (eq (bit_and v (portsc_csc)) 0)))
(def port_reset_changed ((v int)) bool (not (eq (bit_and v (portsc_prc)) 0)))
(def port_has_changes ((v int)) bool (not (eq (bit_and v (portsc_changes)) 0)))

; The speed of the device on the port, bits 10 to 13, as usbdesc.l0's
; speeds number it; 0 with none.
(def port_speed ((v int)) int (bit_and (bit_shr v 10) 15))

; v as words, for a line on the serial line: each of CCS, PED, PR, PP,
; CSC, PEC and PRC that is set, and the speed.
(def portsc_text ((v int)) (list int)
  (unwords (append (portsc_words v (split_spaces "ccs ped pr pp csc pec prc")
                                 (cons (portsc_ccs) (cons (portsc_ped) (cons (portsc_pr) (cons (portsc_pp)
                                 (cons (portsc_csc) (cons (portsc_pec) (cons (portsc_prc) (nil int))))))))
                                 (nil (list int)))
                   (cons (append "speed " (usb_speed_name (port_speed v))) (nil (list int))))))

; The names of the bits of v that are set, from names and their bits,
; before the reversed acc.
(def portsc_words ((v int) (names (list (list int))) (bits (list int)) (acc (list (list int)))) (list (list int))
  (if (or (is_empty names) (is_empty bits))
      (rev acc)
      (portsc_words v (tail names) (tail bits)
        (if (eq (bit_and v (head bits)) 0) acc (cons (head names) acc)))))
