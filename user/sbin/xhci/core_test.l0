; core_test.l0 -- a controller driven through what QEMU's qemu-xhci does
; when usb-kbd is plugged into its first port: the port reset, a slot,
; the device addressed, its descriptors read and its configuration set,
; its endpoint opened and a report read; and a stall, an unplug, and a
; full-speed device whose default endpoint is bigger than it first
; seems. Then bus.l0's requests over such a controller, and two
; controllers.

; ------------------------------------------------------------- fixtures

; 16 pages, page i at 0x80000000 + 4096 i; 4 the shell's.
(def pages () (array int) (pages_from (array_new 16 0) 0))

(def pages_from ((a (array int)) (i int)) (array int)
  (if (eq i (array_len a)) a (pages_from (array_set a i (add 2147483648 (mul 4096 i))) (add i 1))))

; A controller of 4 ports, 32-byte contexts.
(def fresh () Hc (hc_new 0 32 (pages) 4 4 1))

; PORTSC: a high-speed device plugged into a USB 2 port, CCS PP CSC;
; then its reset done, CCS PED PP PRC; and nothing there, PP CSC.
(def plugged () int 134657)
(def reset_done () int 2100739)
(def unplugged () int 131584)

; A Command Completion Event for slot, and a Transfer Event of endpoint
; dci of slot, with code and residual bytes.
(def cmd_done ((code int) (slot int)) Trb
  (Trb 0 (bit_shl code 24) (bit_or (bit_shl (trb_command_completion) 10) (bit_shl slot 24))))

(def xfer ((slot int) (dci int) (code int) (residual int)) Trb
  (Trb 0 (bit_or (bit_shl code 24) residual) (bit_or (bit_shl (trb_transfer_event) 10) (bit_or (bit_shl dci 16) (bit_shl slot 24)))))

; usb-kbd's descriptors (usbdesc_test.l0's).
(def kbd_device () (list int)
  (cons 18 (cons 1 (cons 0 (cons 2 (cons 0 (cons 0 (cons 0 (cons 64
  (cons 39 (cons 6 (cons 1 (cons 0 (cons 0 (cons 0 (cons 1 (cons 4 (cons 11 (cons 1 (nil int))))))))))))))))))))

(def kbd_config () (list int)
  (concat (cons (byte_words "9 2 34 0 1 1 6 160 50")
          (cons (byte_words "9 4 0 0 1 3 1 1 0")
          (cons (byte_words "9 33 17 1 0 1 34 63 0")
          (cons (byte_words "7 5 129 3 8 0 7") (nil (list int))))))))

; The bytes decimal words give.
(def byte_words ((s (list int))) (list int)
  (match (word_numbers (split_spaces s)) ((Some ns) ns) ((None) (nil int))))

; ----------------------------------------------------------------- acts

; Acts as words: put PAGE N for N u32s written, zero, bell SLOT TARGET,
; port P HEX, recheck, answer PORT TEXT, tell PORT TAG, notify TAG,
; listen, log TEXT.
(def acts_text ((acts (list Act))) (list int) (join_with "; " (acts_words acts (nil (list int)))))

(def acts_words ((acts (list Act)) (acc (list (list int)))) (list (list int))
  (if (is_empty acts) (rev acc) (acts_words (tail acts) (cons (act_text (head acts)) acc))))

(def act_text ((a Act)) (list int)
  (match a
    ((ActPut p ws) (append "put " (append (digits p) (append " " (digits (length ws))))))
    ((ActZero p) (append "zero " (digits p)))
    ((ActBell s t) (append "bell " (append (digits s) (append " " (digits t)))))
    ((ActPort p v) (append "port " (append (digits p) (append " " (hex_digits v 0)))))
    ((ActRecheck p) (append "recheck " (digits p)))
    ((ActAnswer p t) (append "answer " (append (digits p) (append " " t))))
    ((ActTell p t) (append "tell " (append (digits p) (append " " (take t 3)))))
    ((ActNotify t) (append "notify " (take t 3)))
    ((ActListen p) (append "listen " (digits p)))
    ((ActLog t) (append "log " t))))

(def did_text ((d Did)) (list int) (match d ((Did h acts) (acts_text acts))))
(def did_hc ((d Did)) Hc (match d ((Did h acts) h)))
(def did_acts ((d Did)) (list Act) (match d ((Did h acts) acts)))

(def want_text ((w Want)) (list int)
  (match w
    ((WantNothing) "nothing")
    ((WantBytes p off n) (unwords (cons "bytes" (numbers_words (cons p (cons off (cons n (nil int))))))))
    ((WantPortsc p) (append "portsc " (digits p)))))

; An event told with what the shell would read for it: bytes bs.
(def told ((h Hc) (t Trb) (bs (list int))) Did (hc_event h t (GotBytes bs)))

; ------------------------------------------------------------ the steps

; Plugged in: the change cleared, the USB 2 port reset.
(def s_plugged () Did (hc_port (fresh) 1 (plugged)))

; The reset done: the change cleared, Enable Slot on the command ring.
(def s_reset () Did (hc_port (did_hc (s_plugged)) 1 (reset_done)))

; Slot 1: the device's three pages cleared, the DCBAA pointing at its
; output context, Address Device with its input context.
(def s_slot () Did (told (did_hc (s_reset)) (cmd_done 1 1) (nil int)))

; Addressed: GET_DESCRIPTOR of 8 bytes on its default endpoint.
(def s_addressed () Did (told (did_hc (s_slot)) (cmd_done 1 1) (nil int)))

(def s_dev8 () Did (told (did_hc (s_addressed)) (xfer 1 1 1 0) (take (kbd_device) 8)))
(def s_dev18 () Did (told (did_hc (s_dev8)) (xfer 1 1 1 0) (kbd_device)))
(def s_cfg9 () Did (told (did_hc (s_dev18)) (xfer 1 1 1 0) (take (kbd_config) 9)))
(def s_cfg () Did (told (did_hc (s_cfg9)) (xfer 1 1 1 0) (kbd_config)))
(def s_ready () Did (told (did_hc (s_cfg)) (xfer 1 1 1 0) (nil int)))

(def ready () Hc (did_hc (s_ready)))

(def test_plugged () int
  (check_str "acts" (did_text (s_plugged)) "port 1 20e01; port 1 20e11"))

(def test_reset_done () int
  (check_str "acts" (did_text (s_reset)) "port 1 200e01; put 1 4; bell 0 0"))

; The pages after the shell's 4, in order: input context, output
; context, default endpoint.
(def test_slot () int
  (check_str "acts" (did_text (s_slot)) "zero 4; zero 5; zero 6; put 0 2; put 4 11; put 1 4; bell 0 0"))

; The setup, data and status stages, 12 u32s, and the doorbell of slot 1,
; endpoint 1.
(def test_addressed () int
  (check_str "acts" (did_text (s_addressed)) "put 6 12; bell 1 1"))

; The shell reads the 8 bytes from the buffer, the page's second half.
(def test_dev8_wants () int
  (check_str "want" (want_text (hc_wants (did_hc (s_addressed)) (xfer 1 1 1 0))) "bytes 6 2048 8"))

; A high-speed device's 64 is what it was given: no Evaluate Context,
; and the 18 bytes asked for.
(def test_dev8 () int
  (check_str "acts" (did_text (s_dev8)) "put 6 12; bell 1 1"))

; Asked for 9 bytes of the configuration, then all 34.
(def test_cfg_length () int
  (add (check_str "9" (want_text (hc_wants (did_hc (s_dev18)) (xfer 1 1 1 0))) "bytes 6 2048 9")
       (check_str "34" (want_text (hc_wants (did_hc (s_cfg9)) (xfer 1 1 1 0))) "bytes 6 2048 34")))

; SET_CONFIGURATION: setup and status only, 8 u32s.
(def test_set_configuration () int
  (check_str "acts" (did_text (s_cfg)) "put 6 8; bell 1 1"))

(def test_ready () int
  (check_str "acts" (did_text (s_ready)) "notify uat; log xhci 0: port 1: device 1 0627:0001 high keyboard"))

(def test_ready_notice () int
  (check_bool "attach" (eq (head (did_acts (s_ready))) (ActNotify (usb_attach_notice (UsbAttached 1 1575 1 3)))) true))

(def test_ready_list () int
  (add (check_int "one" (length (hc_ready (ready))) 1)
       (check_int "next number" (hc_next (ready)) 2)))

; A short data stage: the device gave 4 of 255 bytes; its status stage
; then completes it with those 4.
(def test_short_control () int
  (let d1 (hc_control (ready) 1 (usb_get_descriptor 3 0 255) (nil int) 255 40)
    (let d2 (told (did_hc d1) (xfer 1 1 13 251) (nil int))
      (add (check_str "short counted" (did_text d2) "")
           (check_str "want 4" (want_text (hc_wants (did_hc d2) (xfer 1 1 1 0))) "bytes 6 2048 4")))))

(def test_client_control () int
  (let d1 (hc_control (ready) 1 (usb_get_descriptor 3 0 4) (nil int) 4 40)
    (add (check_str "sent" (did_text d1) "put 6 12; bell 1 1")
         (check_str "answered" (did_text (told (did_hc d1) (xfer 1 1 1 0) (cons 4 (cons 3 (cons 9 (cons 4 (nil int))))))) "answer 40 04030904"))))

; A stall: the client told, the endpoint reset, then sent past the TD.
(def test_stall () int
  (let d1 (hc_control (ready) 1 (usb_setup 33 11 0 0 0) (nil int) 0 40)
    (let d2 (told (did_hc d1) (xfer 1 1 6 0) (nil int))
      (add (check_str "told, reset" (did_text d2) "answer 40 error: stall; put 1 4; bell 0 0")
           (check_str "then dequeue" (did_text (told (did_hc d2) (cmd_done 1 0) (nil int))) "put 1 4; bell 0 0")))))

; Two transfers: the second waits for the first.
(def test_control_queued () int
  (let d1 (hc_control (ready) 1 (usb_get_descriptor 3 0 4) (nil int) 4 40)
    (let d2 (hc_control (did_hc d1) 1 (usb_get_descriptor 3 1 4) (nil int) 4 41)
      (add (check_str "waits" (did_text d2) "")
           (check_str "then sent" (did_text (told (did_hc d2) (xfer 1 1 1 0) (cons 4 (nil int)))) "answer 40 04; put 6 12; bell 1 1")))))

(def test_control_no_device () int
  (check_str "refused" (did_text (hc_control (ready) 9 (usb_get_descriptor 1 0 18) (nil int) 18 40)) "answer 40 error: no such device"))

; ---------------------------------------------------------------- pipes

; Endpoint 0x81 opened: a page for its ring, Configure Endpoint; once
; done, the opener told ok, and a transfer queued at DCI 3.
(def s_open () Did (hc_open (ready) 1 129 77))
(def s_opened () Did (told (did_hc (s_open)) (cmd_done 1 1) (nil int)))

(def test_open () int
  (check_str "acts" (did_text (s_open)) "zero 7; put 4 11; put 1 4; bell 0 0"))

(def test_opened () int
  (check_str "acts" (did_text (s_opened)) "answer 77 ok; put 7 4; bell 1 3"))

; A report: 'a' held, usage 4; its 8 bytes read from the ring's page,
; told to the opener, and the next transfer queued.
(def test_report () int
  (let h (did_hc (s_opened))
    (add (check_str "want" (want_text (hc_wants h (xfer 1 3 1 0))) "bytes 7 2048 8")
         (check_str "acts" (did_text (told h (xfer 1 3 1 0) (cons 0 (cons 0 (cons 4 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (nil int)))))))))))
                    "tell 77 uin; put 7 4; bell 1 3"))))

(def test_open_twice () int
  (check_str "refused" (did_text (hc_open (did_hc (s_opened)) 1 129 78)) "answer 78 error: open already"))

(def test_open_out () int
  (check_str "refused" (did_text (hc_open (ready) 1 1 77)) "answer 77 error: no such endpoint"))

; Its opener gone: the endpoint dropped, its page given back once done.
(def test_opener_gone () int
  (let d (hc_opener_gone (did_hc (s_opened)) 77)
    (add (check_str "dropped" (did_text d) "put 4 6; put 1 4; bell 0 0")
         (check_int "page back" (length (hc_free (did_hc (told (did_hc d) (cmd_done 1 1) (nil int))))) 9))))

; --------------------------------------------------------------- unplug

; Unplugged: clients told, the slot given up, and its pages once done.
(def test_unplugged () int
  (let d (hc_port (did_hc (s_opened)) 1 (unplugged))
    (add (check_str "acts" (did_text d) "port 1 20200; notify udt; log xhci 0: port 1: device 1 gone; put 1 4; bell 0 0")
         (check_int "pages back" (length (hc_free (did_hc (told (did_hc d) (cmd_done 1 1) (nil int))))) 12))))

(def test_unplugged_answers () int
  (let d1 (hc_control (ready) 1 (usb_get_descriptor 3 0 4) (nil int) 4 40)
    (check_str "gone" (did_text (hc_port (did_hc d1) 1 (unplugged))) "port 1 20200; notify udt; log xhci 0: port 1: device 1 gone; answer 40 error: gone; put 1 4; bell 0 0")))

; ---------------------------------------------------- one at a time

; A second port while the first is being brought up waits, and is asked
; about again once the first is ready.
(def test_second_waits () int
  (let d (hc_port (did_hc (s_reset)) 2 (plugged))
    (add (check_str "waits" (did_text d) "port 2 20e01")
         (check_str "rechecked" (did_text (told (did_hc d) (cmd_done 1 1) (nil int))) "zero 4; zero 5; zero 6; put 0 2; put 4 11; put 1 4; bell 0 0"))))

(def test_second_rechecked () int
  (let h (did_hc (hc_port (did_hc (s_reset)) 2 (plugged)))
    (check_str "after ready" (did_text (told (did_hc (run_ready h)) (xfer 1 1 1 0) (nil int))) "notify uat; log xhci 0: port 1: device 1 0627:0001 high keyboard; recheck 2")))

; h, plugged and reset, carried to where SET_CONFIGURATION is sent.
(def run_ready ((h Hc)) Did
  (let a (told h (cmd_done 1 1) (nil int))
    (let b (told (did_hc a) (cmd_done 1 1) (nil int))
      (let c (told (did_hc b) (xfer 1 1 1 0) (take (kbd_device) 8))
        (let d (told (did_hc c) (xfer 1 1 1 0) (kbd_device))
          (let e (told (did_hc d) (xfer 1 1 1 0) (take (kbd_config) 9))
            (told (did_hc e) (xfer 1 1 1 0) (kbd_config))))))))

; ----------------------------------------------------------- full speed

; A full-speed device is given 8 for its default endpoint; its first 8
; bytes say 64, so Evaluate Context, and once done the 18 bytes.
(def test_full_speed () int
  (let h (did_hc (hc_port (did_hc (hc_port (fresh) 1 132609)) 1 2098691))     ; speed 1: 0x20601, 0x200603
    (let a (told (did_hc (told h (cmd_done 1 1) (nil int))) (cmd_done 1 1) (nil int))
      (let b (told (did_hc a) (xfer 1 1 1 0) (take (kbd_device) 8))
        (add (check_str "evaluate" (did_text b) "put 4 7; put 1 4; bell 0 0")
             (check_str "then 18" (did_text (told (did_hc b) (cmd_done 1 1) (nil int))) "put 6 12; bell 1 1"))))))

; A device that gives no descriptor is left alone until unplugged.
(def test_failed () int
  (let d (told (did_hc (s_addressed)) (xfer 1 1 4 0) (nil int))
    (add (check_str "given up" (did_text d) "log xhci 0: port 1: no device descriptor: failed 4; put 1 4; bell 0 0")
         (check_str "replugging needed" (did_text (hc_port (did_hc d) 1 (reset_done))) "port 1 200e01"))))

; A USB 3 port enabled as soon as its link is up: no reset.
(def test_usb3_enabled () int
  (check_str "slot at once" (did_text (hc_port (fresh) 3 135683)) "port 3 21201; put 1 4; bell 0 0"))     ; CCS PED PP CSC, speed 4: 0x21203

; ------------------------------------------------------------------ bus

; bus.l0's requests, routing and claims, here for these fixtures.

; The acts of a bus step, controller by controller: k: acts | ...
(def bus_text ((d BusDid)) (list int)
  (match d ((BusDid b gs) (join_with " | " (groups_text gs (nil (list int)))))))

(def groups_text ((gs (list HcActs)) (acc (list (list int)))) (list (list int))
  (if (is_empty gs)
      (rev acc)
      (match (head gs) ((HcActs k acts) (groups_text (tail gs) (cons (append (digits k) (append ": " (acts_text acts))) acc))))))

(def bus_of ((d BusDid)) Bus (match d ((BusDid b gs) b)))

; A bus of one controller with usb-kbd ready on it, as device 1.
(def one () Bus (bus_with_hc (bus_added (bus_new) (ready)) 0 (ready)))

(def asked ((b Bus) (reply int) (body (list int))) BusDid (bus_request b reply body))

(def test_bus_devices () int
  (check_str "one" (bus_text (asked (one) 40 "devices")) "-1: answer 40 1 1575 1 3\n"))

(def test_bus_listen () int
  (check_str "ok, then each device" (bus_text (asked (one) 41 "listen")) "-1: listen 41; tell 41 uat"))

(def test_bus_descriptor () int
  (check_str "hex" (bus_text (asked (one) 40 "descriptor 1")) "-1: answer 40 120100020000004027060100000001040b01"))

(def test_bus_no_device () int
  (add (check_str "none" (bus_text (asked (one) 40 "config 5")) "-1: answer 40 error: no such device")
       (check_str "no number" (bus_text (asked (one) 40 "config x")) "-1: answer 40 error: config's arguments must be numbers")))

(def test_bus_claim () int
  (let b (bus_of (asked (one) 40 "claim 1 0"))
    (add (check_str "another's" (bus_text (asked b 50 "claim 1 0")) "-1: answer 50 error: taken")
         (add (check_str "its own again" (bus_text (asked b 40 "claim 1 0")) "-1: answer 40 ok")
              (check_str "no interface 1" (bus_text (asked b 40 "claim 1 1")) "-1: answer 40 error: no such interface")))))

; Opening needs the endpoint's interface claimed by the asker.
(def test_bus_open_unclaimed () int
  (check_str "refused" (bus_text (asked (one) 40 "open 1 129")) "-1: answer 40 error: its interface is not claimed"))

(def test_bus_open_claimed () int
  (check_str "routed" (bus_text (asked (bus_of (asked (one) 40 "claim 1 0")) 40 "open 1 129")) "0: zero 7; put 4 11; put 1 4; bell 0 0"))

; SET_IDLE(0) to interface 0: OUT, no data; and GET_DESCRIPTOR of a
; string, IN.
(def test_bus_control () int
  (add (check_str "out" (bus_text (asked (one) 40 "control 1 33 10 0 0 0")) "0: put 6 8; bell 1 1")
       (check_str "in" (bus_text (asked (one) 40 "control 1 128 6 769 1033 255")) "0: put 6 12; bell 1 1")))

(def test_bus_control_bytes () int
  (add (check_str "LEN bytes" (bus_text (asked (one) 40 "control 1 33 9 512 0 2 1")) "-1: answer 40 error: LEN bytes, each 0 to 255")
       (check_str "sent" (bus_text (asked (one) 40 "control 1 33 9 512 0 1 1")) "0: put 6 1; put 6 12; bell 1 1")))

; Its port gone: its claim let go, so another may take it.
(def test_bus_gone () int
  (let b (bus_of (bus_gone (bus_of (asked (one) 40 "claim 1 0")) 40))
    (check_str "free" (bus_text (asked b 50 "claim 1 0")) "-1: answer 50 ok")))

; Two controllers: a device brought up on the second after one on the
; first is device 2.
(def test_bus_two_controllers () int
  (let b (bus_added (one) (hc_new 1 32 (pages) 4 4 1))
    (let s (bus_port b 1 1 (plugged))
      (let s2 (bus_port (bus_of s) 1 1 (reset_done))
        (let s3 (bus_event (bus_of s2) 1 (cmd_done 1 1) (GotNothing))
          (add (check_str "on controller 1" (bus_text s) "1: port 1 20e01; port 1 20e11")
               (check_int "numbered on" (bus_next (bus_of s3)) 3)))))))
