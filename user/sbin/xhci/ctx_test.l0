; ctx_test.l0 -- contexts as their u32s.

(def puts_hex ((ws (list W32))) (list int) (unwords (puts_hex_words ws (nil (list int)))))

(def puts_hex_words ((ws (list W32)) (acc (list (list int)))) (list (list int))
  (if (is_empty ws)
      (rev acc)
      (match (head ws) ((W32 off v) (puts_hex_words (tail ws) (cons (append (digits off) (append "=" (hex_digits v 0))) acc))))))

(def test_dci () int
  (add (check_int "default" (dci_of 0) 1)
       (add (check_int "0x81" (dci_of 129) 3)
            (add (check_int "0x02" (dci_of 2) 4) (check_int "0x8f" (dci_of 143) 31)))))

(def test_ep_type () int
  (add (check_int "control" (ep_type 0 false) 4)
       (add (check_int "interrupt IN" (ep_type 3 true) 7)
            (add (check_int "bulk OUT" (ep_type 2 false) 2) (check_int "bulk IN" (ep_type 2 true) 6)))))

; A full-speed keyboard's bInterval 10 ms is 80 × 125 µs, 2^6 = 64 the
; power of 2 below it; a high-speed one's bInterval 7 is 2^6 too.
(def test_interval () int
  (add (check_int "full speed, 10 ms" (ep_interval 1 3 10) 6)
       (add (check_int "high speed, 7" (ep_interval 3 3 7) 6)
            (add (check_int "full speed, 1 ms, at least 3" (ep_interval 1 3 1) 3)
                 (add (check_int "full speed, 255 ms, at most 10" (ep_interval 1 3 255) 10)
                      (check_int "bulk" (ep_interval 3 2 0) 0))))))

; A slot context in 32-byte contexts at 32: 1 entry, high speed (3 at
; bit 20), root port 2 at bit 16.
(def test_slot_context () int
  (check_str "words" (puts_hex (slot_context 32 3 1 2)) "32=8300000 36=20000 40=0 44=0"))

; The default endpoint of 64 bytes, its ring at 0x80002000 on the first
; pass: CErr 3, type 4, the ring's address with DCS.
(def test_ep0_context () int
  (check_str "words" (puts_hex (ep0_context 32 64 (ring_new 2 2147491840 127)))
             "64=0 68=400026 72=80002001 76=0 80=8"))

; Endpoint 0x81, interrupt IN of 8 bytes, Interval 6, in 64-byte
; contexts: at 64 × (1 + 3); its Max ESIT Payload 8.
(def test_interrupt_context () int
  (check_str "words" (puts_hex (ep_context 64 3 7 8 6 2147508224 1 8))
             "256=60000 260=8003e 264=80006001 268=0 272=80008"))

(def test_addr_words () int
  (check_str "64 bits" (puts_hex (addr_words 8 1099511631872)) "8=1000 12=100"))
