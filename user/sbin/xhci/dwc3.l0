; dwc3.l0 -- the Raspberry Pi 5's USB controllers: RP1's two Synopsys
; DWC3s, each an xHCI once its global registers put it in host mode,
; reached through the firmware's window onto RP1, which L0's runtime
; gives as a region. What their registers want, purely.
; None of this has run on a board: what Linux's dwc3 driver and RP1's
; device tree do is the guide, and the first run's checks are in the
; README.

; RP1's controllers in the CPU's map, as the firmware leaves RP1 when
; config.txt says pciex4_reset=0, and the bytes of each this driver maps:
; the xHCI's registers from 0 and DWC3's globals at 0xC100.
(def rp1_usb0 () int 133146083328)       ; 0x1F00200000
(def rp1_usb1 () int 133147131904)       ; 0x1F00300000
(def rp1_usb_bytes () int 65536)

; Where RP1 reaches the Pi's memory: at the CPU's own address, as the
; firmware leaves the PCIe controller (PCI 0 up to 64 GB onto RAM). With
; 0x10_0000_0000 added, as Linux's dma-ranges have it, the GEM's DMA went
; nowhere on a board run; the same controller serves these. Untried with
; a USB device.
(def rp1_dma_offset () int 0)

; DWC3's global registers: GCTL, and port 0's USB 2 PHY and USB 3 PIPE
; configuration.
(def dwc3_gctl () int 49424)             ; 0xC110
(def dwc3_gusb2phycfg () int 49664)      ; 0xC200
(def dwc3_gusb3pipectl () int 49856)     ; 0xC2C0

; GCTL with PRTCAPDIR, bits 12 and 13, saying host, 1.
(def gctl_host ((w int)) int (bit_or (bit_and w (bit_xor 12288 -1)) 4096))

; The PHYs with suspend off, as RP1's device tree's dis_u2_susphy and
; dis_u3_susphy quirks have them: GUSB2PHYCFG's SUSPHY is bit 6,
; GUSB3PIPECTL's bit 17.
(def u2_awake ((w int)) int (bit_and w (bit_xor 64 -1)))
(def u3_awake ((w int)) int (bit_and w (bit_xor 131072 -1)))
