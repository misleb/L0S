; xhci_test.l0 -- the driver's own words.

; Under an operating system there is no pci server.
(def test_no_pci () int
  (check_int "fails" (xhci) 1))

(def test_bring_line () int
  (check_str "QEMU's" (bring_line 0 256 8 64 0 32) "xhci 0: xHCI 1.00, 8 ports, 64 slots, 0 scratchpads, 32-byte contexts"))

; The event ring's table: one segment, the event ring's page, 256 TRBs;
; with scratchpads, the DCBAA's entry 0 and the array, page 4.
(def test_memory_words () int
  (let pages (array_from (cons 4096 (cons 8192 (cons 12288 (cons 16384 (cons 20480 (cons 24576 (nil int))))))) 0)
    (add (check_int "no scratchpads" (length (memory_words pages 0)) 1)
         (check_int "one" (length (memory_words pages 1)) 3))))

(def test_scratch_words () int
  (let pages (array_from (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 24576 (cons 28672 (nil int)))))))) 0)
    (check_bool "pages 5 and 6" (eq (scratch_words pages 2 0 (nil W32))
                                    (cons (W32 0 24576) (cons (W32 4 0) (cons (W32 8 28672) (cons (W32 12 0) (nil W32)))))) true)))

; The kernel's notice of 80 is controller 1's, whose interrupt is 80; a
; request, or a notice from any other sender, is none's.
(def test_noticed () int
  (let is (cons 36 (cons 80 (nil int)))
    (add (check_int "MSI 80" (noticed is 0 (irq_notice 80) 0) 1)
         (add (check_int "from a client" (noticed is 9 (irq_notice 80) 0) -1)
              (check_int "a request" (noticed is 0 "devices" 0) -1)))))

; A polled controller, 0, is never the one a notice names.
(def test_noticed_polled () int
  (check_int "none bound" (noticed (cons 0 (nil int)) 0 (irq_notice 0) 0) -1))

; Waiting needs every controller's interrupt; RP1's two have none.
(def test_all_bound () int
  (add (check_bool "both" (all_bound (cons 36 (cons 80 (nil int)))) true)
       (add (check_bool "one polled" (all_bound (cons 0 (cons 80 (nil int)))) false)
            (check_bool "no controller" (all_bound (nil int)) false))))

(def test_irq_line () int
  (add (check_str "taken" (irq_line 0 80 "") "xhci 0: interrupt 80")
       (check_str "polled" (irq_line 1 0 "it raises none") "xhci 1: polled, as it raises none")))

(def test_place_irqs () int
  (check_bool "pci's, then RP1's none"
    (eq (place_irqs (cons (Place 0 0 0 false 80) (cons (Place 0 0 0 true 0) (nil Place)))) (cons 80 (cons 0 (nil int)))) true))

(def test_shifted () int
  (check_bool "by RP1's offset" (eq (shifted_by (array_from (cons 4096 (nil int)) 0) (rp1_dma_offset) 0)
                                    (array_from (cons 68719480832 (nil int)) 0)) true))

; QEMU's 0x40, and a dead window's 0xAD, which is no word's start.
(def test_cap_length_ok () int
  (add (check_bool "qemu-xhci" (cap_length_ok 64) true)
       (add (check_bool "dead window" (cap_length_ok 173) false)
            (check_bool "too short" (cap_length_ok 16) false))))

(def test_bad_cap_length_text () int
  (check_str "dead" (bad_cap_length_text 133146083328 3735936685)
    "no xHCI at 0x1f00200000: its first word reads 0xdeaddead"))
