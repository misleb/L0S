; regs.l0 -- where an xHCI's registers are (xHCI 1.2, chapter 5), as
; offsets from the start of its MMIO space, and what its capability
; registers say, read from their words purely: the capability registers
; at 0, the operational ones CAPLENGTH after them, the runtime ones and
; the doorbells where RTSOFF and DBOFF say, and the extended
; capabilities, among them which ports are USB 2 and which USB 3.

; ------------------------------------------------------------ capability

; The capability registers, from the MMIO space's start.
(def cap_length () int 0)              ; CAPLENGTH, a byte; HCIVERSION, a u16 at 2
(def cap_hcsparams1 () int 4)
(def cap_hcsparams2 () int 8)
(def cap_hccparams1 () int 16)
(def cap_dboff () int 20)
(def cap_rtsoff () int 24)

; HCSPARAMS1: the device slots, bits 0 to 7, and the root hub's ports,
; bits 24 to 31.
(def max_slots_of ((p1 int)) int (bit_and p1 255))
(def max_ports_of ((p1 int)) int (bit_and (bit_shr p1 24) 255))

; HCSPARAMS2: the scratchpad buffers the controller wants of the driver,
; their count's high five bits at 21 and low five at 27.
(def scratchpads_of ((p2 int)) int
  (bit_or (bit_shl (bit_and (bit_shr p2 21) 31) 5) (bit_and (bit_shr p2 27) 31)))

; HCCPARAMS1: whether contexts are 64 bytes, CSZ at bit 2, else 32; and
; where the extended capabilities start, in bytes from the MMIO space's
; start, xECP at bits 16 to 31 in u32s, or 0 for none.
(def context_size_of ((c1 int)) int (if (eq (bit_and c1 4) 0) 32 64))
(def xecp_of ((c1 int)) int (mul 4 (bit_and (bit_shr c1 16) 65535)))

; DBOFF and RTSOFF, their reserved low bits cleared.
(def dboff_of ((v int)) int (bit_and v 4294967292))
(def rtsoff_of ((v int)) int (bit_and v 4294967264))

; ----------------------------------------------------------- operational

; The operational registers, from CAPLENGTH on.
(def op_usbcmd () int 0)
(def op_usbsts () int 4)
(def op_pagesize () int 8)
(def op_crcr () int 24)                ; 64 bits
(def op_dcbaap () int 48)              ; 64 bits
(def op_config () int 56)

; Port n's PORTSC, from 1, in the operational registers.
(def op_portsc ((n int)) int (add 1024 (mul 16 (sub n 1))))

; USBCMD's Run/Stop and Host Controller Reset; USBSTS's HCHalted,
; Host System Error, and Controller Not Ready.
(def cmd_run () int 1)
(def cmd_reset () int 2)
(def sts_halted () int 1)
(def sts_host_error () int 4)
(def sts_not_ready () int 2048)

; --------------------------------------------------------------- runtime

; Interrupter 0's registers, from the runtime registers' start: IMAN,
; IMOD, ERSTSZ, ERSTBA (64 bits), ERDP (64 bits, its Event Handler Busy
; at bit 3, cleared by writing 1).
(def rt_iman () int 32)
(def rt_imod () int 36)
(def rt_erstsz () int 40)
(def rt_erstba () int 48)
(def rt_erdp () int 56)
(def erdp_busy () int 8)

; Doorbell slot's register, from the doorbells' start: 0 the command
; ring's, n slot n's, written with the endpoint's DCI.
(def doorbell ((slot int)) int (mul 4 slot))

; ------------------------------------------------- extended capabilities

; An extended capability's id, bits 0 to 7 of its first word, and the
; next's, bits 8 to 15, in u32s from it, 0 for the last.
(def xcap_id ((w int)) int (bit_and w 255))
(def xcap_next ((w int)) int (mul 4 (bit_and (bit_shr w 8) 255)))

; Supported Protocol's id, and of its first word its major revision,
; bits 24 to 31: 2 for USB 2, 3 for USB 3; of its third, the first of
; its ports, bits 0 to 7, and how many, bits 8 to 15.
(def xcap_protocol () int 2)
(def protocol_major ((w0 int)) int (bit_and (bit_shr w0 24) 255))
(def protocol_first_port ((w2 int)) int (bit_and w2 255))
(def protocol_port_count ((w2 int)) int (bit_and (bit_shr w2 8) 255))

; majors, indexed by port from 1, with ports first up to first + count
; marked major.
(def ports_marked ((majors (array int)) (major int) (first int) (count int)) (array int)
  (if (if (le count 0) true (ge first (array_len majors)))
      majors
      (ports_marked (array_set majors first major) major (add first 1) (sub count 1))))
