; trb_test.l0 -- TRBs built and read back.

; The words of a TRB, in hex, as the spec's tables lay them out.
(def words_text ((t Trb)) (list int) (unwords (words_hex (trb_words t) (nil (list int)))))

(def words_hex ((ws (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty ws) (rev acc) (words_hex (tail ws) (cons (hex_digits (head ws) 8) acc))))

; Enable Slot: type 9 at bits 10 to 15, 0x2400.
(def test_enable_slot () int
  (check_str "words" (words_text (enable_slot_command)) "00000000 00000000 00000000 00002400"))

; Address Device of slot 3 from the input context at 0x80004000: type 11,
; 0x2c00, slot at bits 24 to 31.
(def test_address_device () int
  (check_str "words" (words_text (address_device_command 2147500032 3)) "80004000 00000000 00000000 03002c00"))

; GET_DESCRIPTOR(device, 8)'s setup stage: the packet as immediate data,
; 8 bytes, IDT (bit 6), type 2, TRT 3 for IN.
(def test_setup_in () int
  (check_str "words" (words_text (setup_trb (usb_get_descriptor 1 0 8) 8 true)) "01000680 00080000 00000008 00030840"))

; SET_CONFIGURATION(1) moves no data: TRT 0.
(def test_setup_none () int
  (check_str "words" (words_text (setup_trb (usb_setup 0 9 1 0 0) 0 false)) "00010900 00000000 00000008 00000840"))

; A data stage IN of 18 bytes at 0x80006800: ISP, DIR; type 3.
(def test_data_in () int
  (check_str "words" (words_text (data_trb 2147510272 18 true)) "80006800 00000000 00000012 00010c04"))

; Status: IOC, type 4, DIR for IN.
(def test_status_stage () int
  (add (check_str "in" (words_text (status_trb true)) "00000000 00000000 00000000 00011020")
       (check_str "out" (words_text (status_trb false)) "00000000 00000000 00000000 00001020")))

(def test_link () int
  (check_str "toggles" (words_text (link_trb 2147491840 false)) "80002000 00000000 00000000 00001802"))

(def test_cycle () int
  (add (check_int "set" (trb_cycle_of (trb_with_cycle (noop_command) 1)) 1)
       (check_int "cleared" (trb_cycle_of (trb_with_cycle (trb_with_cycle (noop_command) 1) 0)) 0)))

; A Transfer Event: slot 1, endpoint 3, Short Packet with 5 bytes left,
; as the controller writes it.
(def test_transfer_event () int
  (let t (trb_of_words 2147516416 0 218103813 17006593)          ; 0x0D000005, 0x01038001
    (add (check_int "type" (trb_type t) 32)
         (add (check_int "slot" (trb_slot t) 1)
              (add (check_int "endpoint" (trb_endpoint t) 3)
                   (add (check_int "code" (trb_code t) 13) (check_int "residual" (trb_residual t) 5)))))))

; A Port Status Change for port 2: its parameter's top byte.
(def test_port_event () int
  (check_int "port" (trb_port (trb_of_words 33554432 0 16777216 34817)) 2))

(def test_set_dequeue () int
  (check_str "words" (words_text (set_dequeue_command 1 1 2147491888 1)) "80002031 00000000 00000000 01014000"))
