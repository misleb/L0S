; usb-audio_test.l0 -- what usb-audio makes of a Blue Yeti Nano's audio
; function (uac_test.l0's descriptors): its line, the devices answer,
; the microphone it would listen to, the requests it would make, and
; when a silence ends. With no kernel there is no usb server.

; The bytes decimal words give.
(def nums ((s (list int))) (list int)
  (match (word_numbers (split_spaces s)) ((Some ns) ns) ((None) (nil int))))

; The Yeti Nano's audio function, as uac_test.l0 reads it.
(def yeti () Uac
  (uac_of (bytes_from_list (nums "9 2 232 0 4 1 0 192 49 9 4 0 0 0 1 1 0 0 10 36 1 0 1 72 0 2 1 2 12 36 2 2 1 1 0 2 3 0 0 0 10 36 6 6 2 1 3 0 0 0 9 36 3 4 1 3 0 6 0 12 36 2 1 1 2 0 2 3 0 0 0 10 36 6 5 1 1 3 0 0 0 9 36 3 3 1 1 0 5 0 9 4 1 0 0 1 2 0 0 9 4 1 1 1 1 2 0 0 7 36 1 2 1 1 0 14 36 2 1 2 3 24 2 68 172 0 128 187 0 9 5 1 1 32 1 1 0 0 7 37 1 1 0 0 0 9 4 2 0 0 1 2 0 0 9 4 2 1 1 1 2 0 0 7 36 1 3 1 1 0 14 36 2 1 2 3 24 2 68 172 0 128 187 0 9 5 130 1 38 1 1 0 0 7 37 1 1 0 0 0 9 4 3 0 2 3 0 0 0 9 33 17 1 0 1 34 172 0 7 5 131 3 64 0 10 7 5 3 3 64 0 10"))))

(def devs () (list AudDev) (cons (AudDev 4 (yeti)) (nil AudDev)))

; What it says on the serial line of the Yeti, device 4.
(def test_device_line () int
  (check_str "line" (device_line 4 (yeti)) "device 4: out speaker 2 24 44100,48000, in microphone 2 24 44100,48000"))

; The devices answer: a line a stream, its device and interface first.
(def test_devices () int
  (check_str "lines" (devices_text (devs)) "4 1 out speaker 2 24 44100,48000\n4 2 in microphone 2 24 44100,48000\n"))

; listen takes the microphone, interface 2, endpoint 0x82.
(def test_first_input () int
  (match (first_input (devs))
    ((None) (check_str "found" "none" "a microphone"))
    ((Some g) (add (check_int "device" (going_dev g) 4) (check_int "endpoint" (.ep (going_stream g)) 130)))))

; silence finds the speaker by its interface, 1, and not the microphone.
(def test_output_at () int
  (add (check_bool "speaker" (match (output_at (devs) 4 1) ((Some s) (eq (.ep s) 1)) ((None) false)) true)
       (check_bool "microphone" (match (output_at (devs) 4 2) ((Some s) true) ((None) false)) false)))

; SET_INTERFACE as the usb protocol's control request: interface 2 to
; setting 1; SET_CUR with its three bytes.
(def test_control_body () int
  (add (check_str "interface" (control_body 4 (uac_set_interface 2 1) (nil int)) "control 4 1 11 1 2 0")
       (check_str "rate" (control_body 4 (uac_set_rate 130) (uac_rate_bytes 48000)) "control 4 34 1 256 130 3 128 187 0")))

; A uin of the Yeti's microphone, packets of 294 bytes at most, holds 10.
(def test_batch () int
  (check_int "ten" (iso_batch_of (nth (.streams (yeti)) 1)) 10))

; A silence is due once its time has come, and not before.
(def test_silence_due () int
  (let gs (cons (GoingIn 4 (nth (.streams (yeti)) 1) 9) (cons (GoingOut 4 (head (.streams (yeti))) 8 30 1000) (nil Going)))
    (add (check_bool "before" (match (silence_due gs 999) ((Some g) true) ((None) false)) false)
         (check_int "at" (match (silence_due gs 1000) ((Some g) (going_dev g)) ((None) -1)) 4))))

; Under an operating system there is no usb server.
(def test_entry () int
  (check_int "fails" (usb_audio) 1))
