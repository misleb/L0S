; usb-audio_test.l0 -- what usb-audio makes of a Blue Yeti Nano's audio
; function (uac_test.l0's descriptors): its line, the names it attaches
; its streams under, the requests it would make, and the server's
; requests as it reads them. With no kernel there is no usb server.

; The bytes decimal words give.
(def nums ((s (list int))) (list int)
  (match (word_numbers (split_spaces s)) ((Some ns) ns) ((None) (nil int))))

; The Yeti Nano's audio function, as uac_test.l0 reads it.
(def yeti () Uac
  (uac_of (bytes_from_list (nums "9 2 232 0 4 1 0 192 49 9 4 0 0 0 1 1 0 0 10 36 1 0 1 72 0 2 1 2 12 36 2 2 1 1 0 2 3 0 0 0 10 36 6 6 2 1 3 0 0 0 9 36 3 4 1 3 0 6 0 12 36 2 1 1 2 0 2 3 0 0 0 10 36 6 5 1 1 3 0 0 0 9 36 3 3 1 1 0 5 0 9 4 1 0 0 1 2 0 0 9 4 1 1 1 1 2 0 0 7 36 1 2 1 1 0 14 36 2 1 2 3 24 2 68 172 0 128 187 0 9 5 1 1 32 1 1 0 0 7 37 1 1 0 0 0 9 4 2 0 0 1 2 0 0 9 4 2 1 1 1 2 0 0 7 36 1 3 1 1 0 14 36 2 1 2 3 24 2 68 172 0 128 187 0 9 5 130 1 38 1 1 0 0 7 37 1 1 0 0 0 9 4 3 0 2 3 0 0 0 9 33 17 1 0 1 34 172 0 7 5 131 3 64 0 10 7 5 3 3 64 0 10"))))

; The Yeti as device 4, 046d:0acf.
(def yeti_dev () AudDev (AudDev 4 1133 2767 (yeti)))

; What it says in the log of the Yeti, device 4.
(def test_device_line () int
  (check_str "line" (device_line 4 (yeti)) "device 4: out speaker 2 24 44100,48000, in microphone 2 24 44100,48000"))

; The names its streams are attached under: the ids and what each is;
; a second of the same gets -2.
(def test_stream_names () int
  (let (ss (.streams (yeti))
        name (stream_name (yeti_dev) (nth ss 1)))
    (add (check_str "microphone" name "usb-046d:0acf-microphone")
         (add (check_str "speaker" (stream_name (yeti_dev) (head ss)) "usb-046d:0acf-speaker")
              (check_str "second" (unique_name (cons (Attached 1 name 4 (nth ss 1)) (nil Attached)) name) "usb-046d:0acf-microphone-2")))))

; SET_INTERFACE as the usb protocol's control request: interface 2 to
; setting 1; SET_CUR with its three bytes.
(def test_control_body () int
  (add (check_str "interface" (control_body 4 (uac_set_interface 2 1) (nil int)) "control 4 1 11 1 2 0")
       (check_str "rate" (control_body 4 (uac_set_rate 130) (uac_rate_bytes 48000)) "control 4 34 1 256 130 3 128 187 0")))

; A stream going is found by its device and endpoint, and by its id.
(def test_going () int
  (let gs (cons (GoingIn 7 4 (nth (.streams (yeti)) 1)) (nil Going))
    (add (check_int "at" (match (going_at gs 4 130) ((Some g) (going_id g)) ((None) 0)) 7)
         (add (check_int "with" (match (going_with gs 7) ((Some g) (going_dev g)) ((None) 0)) 4)
              (check_int "less" (length (going_less gs 7)) 0)))))

; A ring for a quarter second: the Yeti's speaker, 6 bytes a frame at
; 48 kHz, 72,000 bytes, 18 pages and one more; QEMU's speaker, 4 bytes
; a frame, 48,000, 12 and one.
(def test_ring_pages () int
  (add (check_int "yeti" (ring_pages 48000 6) 19)
       (check_int "qemu" (ring_pages 48000 4) 13)))

; Under an operating system there is no usb server.
(def test_entry () int
  (check_int "fails" (usb_audio) 1))
