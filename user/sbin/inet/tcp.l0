; tcp.l0 -- TCP's state machine (RFC 9293) for inet, pure: a connection is
; a Conn, and each event, a segment arriving, the application sending or
; closing, a timer's deadline, takes it and the time and gives the Conn
; after it with the TcpActs it calls for, in order: segments to send, and
; what to tell the application. inet.l0 turns the acts into frames and
; notices and keeps the connections; nothing here touches the network.
;
; What it does: the three-way handshake, active and passive; sequence and
; acknowledgement numbers, with the data kept until it is acknowledged;
; a fixed receive window; retransmission after a timeout, doubling it each
; time, giving up after tcp_tries; a zero window probed; FIN, in both
; directions, every close of RFC 9293's state diagram but a simultaneous
; open; RST, checked against the window (RFC 5961); segments that arrive
; out of order, held within the window until what is missing before them
; comes. What it does not: the timeout is fixed rather than measured, an
; acknowledgement is sent for every segment (none are delayed), and there
; is no congestion control, selective acknowledgement, nor urgent data.

; ----------------------------------------------------------------- constants

; The window every segment offers: what inet will take beyond what it has
; acknowledged. It is never shrunk, since what arrives goes to the
; application at once.
(def tcp_window () int 8192)

; The most data in a segment inet offers to take, so that a frame is at
; most 1500 bytes; and what it assumes of a peer that gives none (RFC
; 9293, 3.7.1).
(def tcp_our_mss () int 1460)
(def tcp_default_mss () int 536)

; How long to wait for an acknowledgement before sending again, the first
; time and at most; how many times to send again before giving up; and how
; long a connection that ended waits, in TIME-WAIT, before it is gone.
(def tcp_rto_ns () int 1000000000)
(def tcp_rto_max_ns () int 16000000000)
(def tcp_tries () int 5)
(def tcp_time_wait_ns () int 4000000000)

; How much data the application may have inet hold, sent or not, for a
; connection.
(def tcp_send_limit () int 16384)

; What it must have fallen to, once a write was refused, before the
; application is told there is room again: half, so that it writes in
; runs rather than a piece at a time.
(def tcp_room_mark () int 8192)

; The states. A connection with no state is gone.
(def tcp_syn_sent () int 1)
(def tcp_syn_received () int 2)
(def tcp_established () int 3)
(def tcp_fin_wait_1 () int 4)
(def tcp_fin_wait_2 () int 5)
(def tcp_close_wait () int 6)
(def tcp_closing () int 7)
(def tcp_last_ack () int 8)
(def tcp_time_wait () int 9)
(def tcp_closed () int 10)

; A state's name, as RFC 9293 gives it.
(def tcp_state_name ((st int)) (list int)
  (nth (split_spaces "SYN-SENT SYN-RECEIVED ESTABLISHED FIN-WAIT-1 FIN-WAIT-2 CLOSE-WAIT CLOSING LAST-ACK TIME-WAIT CLOSED") (sub st 1)))

; ----------------------------------------------------------------- the state

; A connection's ends: its local port, the remote address and port, and the
; port and pid of the process whose it is.
(data TcpEnds (TcpEnds int int int int int))

; Its sequence numbers: the oldest not acknowledged (SND.UNA), the next to
; send (SND.NXT), the window the peer offers (SND.WND), the next to receive
; (RCV.NXT), and the most data the peer takes in a segment.
(data TcpSeqs (TcpSeqs int int int int int))

; Its retransmission timer: when it fires, or 0 if it is not running; the
; timeout now; and how many times it has fired for the same thing.
(data TcpTimer (TcpTimer int int int))

; A segment that came before the bytes ahead of it: its sequence number,
; its data, and whether a FIN follows them.
(data TcpHeld (TcpHeld int (list int) bool))

; A connection: its number, state, ends, sequence numbers and timer; the
; data sent or to send that is not acknowledged yet, from SND.UNA's byte
; (the SYN not counted); whether the application has closed it, so that
; a FIN follows the data; and the segments it holds that came out of
; order, until what is missing before them comes, in the order of their
; sequence numbers; and whether a write was refused for want of room,
; so that the application is told when there is some.
(data Conn (Conn int int TcpEnds TcpSeqs TcpTimer (list int) bool (list TcpHeld) bool))

; What a connection calls for: a segment to send to an address; the
; connection is open, for one this process started; it was accepted, for
; one a listener's; data came; the peer will send no more; the connection
; has ended as it should, though it waits in TIME-WAIT; or it is gone, and
; why, which is empty if the application has been told already; or an
; application refused a write may write again, so many bytes.
(data TcpAct (SendSeg int Seg) (ConnUp) (ConnAccepted) (GotData (list int)) (GotFin) (ConnOver) (ConnGone (list int)) (ConnRoom int))

; A connection and the acts it has called for so far, last first, while
; they are being made; in order once the event's function has returned.
(data TcpStep (TcpStep Conn (list TcpAct)))

; ----------------------------------------------------------------- accessors

; A connection's number, state, queue of data, whether it is closed, and
; the segments it holds.
(def c_id ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) id)))
(def c_state ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) state)))
(def c_queue ((c Conn)) (list int) (match c ((Conn id state ends seqs timer queue fin held wait) queue)))
(def c_fin ((c Conn)) bool (match c ((Conn id state ends seqs timer queue fin held wait) fin)))
(def c_held ((c Conn)) (list TcpHeld) (match c ((Conn id state ends seqs timer queue fin held wait) held)))

; The local port, the remote address and port, and the owner's port and pid.
(def c_lport ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match ends ((TcpEnds lport raddr rport owner pid) lport)))))
(def c_raddr ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match ends ((TcpEnds lport raddr rport owner pid) raddr)))))
(def c_rport ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match ends ((TcpEnds lport raddr rport owner pid) rport)))))
(def c_owner ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match ends ((TcpEnds lport raddr rport owner pid) owner)))))
(def c_pid ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match ends ((TcpEnds lport raddr rport owner pid) pid)))))

; SND.UNA, SND.NXT, SND.WND, RCV.NXT and the peer's segment size.
(def c_una ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match seqs ((TcpSeqs una nxt wnd rcv mss) una)))))
(def c_nxt ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match seqs ((TcpSeqs una nxt wnd rcv mss) nxt)))))
(def c_wnd ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match seqs ((TcpSeqs una nxt wnd rcv mss) wnd)))))
(def c_rcv ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match seqs ((TcpSeqs una nxt wnd rcv mss) rcv)))))
(def c_mss ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match seqs ((TcpSeqs una nxt wnd rcv mss) mss)))))

; The timer's deadline, timeout and tries.
(def c_deadline ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match timer ((TcpTimer deadline rto tries) deadline)))))
(def c_rto ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match timer ((TcpTimer deadline rto tries) rto)))))
(def c_tries ((c Conn)) int (match c ((Conn id state ends seqs timer queue fin held wait) (match timer ((TcpTimer deadline rto tries) tries)))))

; c in state s.
(def c_set_state ((c Conn) (s int)) Conn
  (match c ((Conn id state ends seqs timer queue fin held wait) (Conn id s ends seqs timer queue fin held wait))))

; c with its sequence numbers.
(def c_set_seqs ((c Conn) (una int) (nxt int) (wnd int) (rcv int) (mss int)) Conn
  (match c ((Conn id state ends seqs timer queue fin held wait) (Conn id state ends (TcpSeqs una nxt wnd rcv mss) timer queue fin held wait))))

; c with one of them changed.
(def c_set_una ((c Conn) (v int)) Conn (c_set_seqs c v (c_nxt c) (c_wnd c) (c_rcv c) (c_mss c)))
(def c_set_nxt ((c Conn) (v int)) Conn (c_set_seqs c (c_una c) v (c_wnd c) (c_rcv c) (c_mss c)))
(def c_set_wnd ((c Conn) (v int)) Conn (c_set_seqs c (c_una c) (c_nxt c) v (c_rcv c) (c_mss c)))
(def c_set_rcv ((c Conn) (v int)) Conn (c_set_seqs c (c_una c) (c_nxt c) (c_wnd c) v (c_mss c)))

; c with its timer.
(def c_set_timer ((c Conn) (deadline int) (rto int) (tries int)) Conn
  (match c ((Conn id state ends seqs timer queue fin held wait) (Conn id state ends seqs (TcpTimer deadline rto tries) queue fin held wait))))

; c with its queue of data, and whether it is closed.
(def c_set_queue ((c Conn) (q (list int)) (f bool)) Conn
  (match c ((Conn id state ends seqs timer queue fin held wait) (Conn id state ends seqs timer q f held wait))))

; c holding hs, the segments that came out of order.
(def c_set_held ((c Conn) (hs (list TcpHeld))) Conn
  (match c ((Conn id state ends seqs timer queue fin held wait) (Conn id state ends seqs timer queue fin hs wait))))

; Whether a write to c was refused for want of room, so that its owner
; waits to be told when there is some again.
(def c_wait ((c Conn)) bool (match c ((Conn id state ends seqs timer queue fin held wait) wait)))

; c with its owner waiting for room, or not.
(def c_set_wait ((c Conn) (w bool)) Conn
  (match c ((Conn id state ends seqs timer queue fin held wait) (Conn id state ends seqs timer queue fin held w))))

; The connection of a step, the step with another, and the step with an act.
(def step_conn ((st TcpStep)) Conn (match st ((TcpStep c acts) c)))
(def step_with ((st TcpStep) (c Conn)) TcpStep (match st ((TcpStep old acts) (TcpStep c acts))))
(def step_act ((st TcpStep) (a TcpAct)) TcpStep (match st ((TcpStep c acts) (TcpStep c (cons a acts)))))

; The step as it is returned: its acts in order.
(def step_done ((st TcpStep)) TcpStep (match st ((TcpStep c acts) (TcpStep c (rev acts)))))

; The acts of a step, in order, once it is done.
(def step_acts ((st TcpStep)) (list TcpAct) (match st ((TcpStep c acts) acts)))

; ------------------------------------------------------------------- derived

; Whether a state is one of those in the list of words ws.
(def state_in ((c Conn) (ws (list int))) bool
  (any_eq (digits (c_state c)) (split_spaces ws)))

; Whether the SYN is not acknowledged yet, and whether a FIN is sent and
; is not.
(def syn_pending ((c Conn)) bool (state_in c "1 2"))
(def fin_unacked ((c Conn)) bool (state_in c "4 7 8"))

; Whether the application's data may be sent: only after the handshake,
; and until the peer's FIN has been answered by ours.
(def can_send_data ((c Conn)) bool (state_in c "3 6"))

; Whether the application may give more data: from the start until it
; closes.
(def accepts_data ((c Conn)) bool (if (c_fin c) false (state_in c "1 2 3 6")))

; How much of the queue is sent and not acknowledged.
(def tcp_flight ((c Conn)) int
  (sub (seq_diff (c_nxt c) (c_una c)) (add (if (syn_pending c) 1 0) (if (fin_unacked c) 1 0))))

; How much of the queue is not sent yet.
(def tcp_unsent ((c Conn)) int (sub (length (c_queue c)) (tcp_flight c)))

; The most data a segment carries: what the peer takes, and no more than a
; frame holds.
(def tcp_segment_size ((c Conn)) int (min (c_mss c) (tcp_our_mss)))

; Whether the timer must be running: something is sent that is not
; acknowledged, or data waits for a window that has closed.
(def tcp_outstanding ((c Conn)) bool
  (if (not (eq (c_nxt c) (c_una c))) true (if (can_send_data c) (gt (tcp_unsent c) 0) false)))

; --------------------------------------------------------------- segments

; A segment of c's: flags, from sequence number seq, offering mss if not 0,
; carrying body, acknowledging all c has received.
(def tcp_seg ((c Conn) (flags int) (seq int) (mss int) (body (list int))) Seg
  (Seg (c_lport c) (c_rport c) seq (c_rcv c) flags (tcp_window) mss body))

; The step with a segment of its connection's to send.
(def say_seg ((st TcpStep) (flags int) (seq int) (mss int) (body (list int))) TcpStep
  (let c (step_conn st)
    (step_act st (SendSeg (c_raddr c) (tcp_seg c flags seq mss body)))))

; The step with an acknowledgement of all received to send.
(def say_ack ((st TcpStep)) TcpStep
  (say_seg st (tcp_ack) (c_nxt (step_conn st)) 0 (nil int)))

; The step with a reset to send, from sequence number seq.
(def say_rst ((st TcpStep) (seq int)) TcpStep
  (say_seg st (tcp_rst) seq 0 (nil int)))

; The step with its connection gone, and why.
(def say_gone ((st TcpStep) (why (list int))) TcpStep
  (step_act (step_with st (c_set_state (step_conn st) (tcp_closed))) (ConnGone why)))

; The step with its connection in TIME-WAIT, until now and tcp_time_wait_ns.
(def time_wait_timer ((st TcpStep) (now int)) TcpStep
  (step_with st (c_set_timer (c_set_state (step_conn st) (tcp_time_wait)) (add now (tcp_time_wait_ns)) (tcp_rto_ns) 0)))

; The same, the application told that it has ended: there is nothing more
; for it to wait for.
(def say_time_wait ((st TcpStep) (now int)) TcpStep
  (step_act (time_wait_timer st now) (ConnOver)))

; The segment that answers s, which no connection has: none to a reset,
; and otherwise a reset, as RFC 9293 3.10.7.1 has it. Its sequence number
; is s's acknowledgement if it has one, and otherwise it acknowledges all s
; takes up.
(def tcp_reset_for ((s Seg)) (Option Seg)
  (match s
    ((Seg sport dport seq ack flags window mss body)
      (if (seg_has s (tcp_rst))
          ((None Seg))
          (if (seg_has s (tcp_ack))
              (Some (Seg dport sport ack 0 (tcp_rst) 0 0 (nil int)))
              (Some (Seg dport sport 0 (seq_add seq (seg_space s)) (bit_or (tcp_rst) (tcp_ack)) 0 0 (nil int))))))))

; ------------------------------------------------------------------- opening

; The step that opens a connection numbered id from lport to rport at
; raddr, for the process whose port and pid are owner and pid, with first
; sequence number iss, at time now: a SYN is sent.
(def tcp_active ((id int) (owner int) (pid int) (lport int) (raddr int) (rport int) (iss int) (now int)) TcpStep
  (let c (Conn id (tcp_syn_sent) (TcpEnds lport raddr rport owner pid)
               (TcpSeqs iss (seq_add iss 1) 0 0 (tcp_default_mss))
               (TcpTimer (add now (tcp_rto_ns)) (tcp_rto_ns) 0) (nil int) false (nil TcpHeld) false)
    (step_done (say_seg (TcpStep c (nil TcpAct)) (tcp_syn) iss (tcp_our_mss) (nil int)))))

; The step that takes the SYN s, from raddr, to a port a listener holds,
; for it, as connection id, with first sequence number iss: a SYN and ACK
; is sent.
(def tcp_passive ((id int) (owner int) (pid int) (raddr int) (s Seg) (iss int) (now int)) TcpStep
  (match s
    ((Seg sport dport seq ack flags window mss body)
      (let c (Conn id (tcp_syn_received) (TcpEnds dport raddr sport owner pid)
                   (TcpSeqs iss (seq_add iss 1) window (seq_add seq 1) (if (gt mss 0) mss (tcp_default_mss)))
                   (TcpTimer (add now (tcp_rto_ns)) (tcp_rto_ns) 0) (nil int) false (nil TcpHeld) false)
        (step_done (say_seg (TcpStep c (nil TcpAct)) (bit_or (tcp_syn) (tcp_ack)) iss (tcp_our_mss) (nil int)))))))

; -------------------------------------------------------------------- timer

; The step after the event that took connection c from state old and
; SND.UNA oldest: the timer runs if something is outstanding, restarting
; whenever the peer acknowledged anything or the state changed, and is off
; if nothing is. TIME-WAIT's own deadline is left as it is.
(def tcp_settled ((st TcpStep) (now int) (oldest int) (old int)) TcpStep
  (let c (step_conn st)
    (if (eq (c_state c) (tcp_time_wait))
        st
        (if (not (tcp_outstanding c))
            (step_with st (c_set_timer c 0 (tcp_rto_ns) 0))
            (if (if (eq oldest (c_una c)) (eq old (c_state c)) false)
                (if (eq (c_deadline c) 0) (step_with st (c_set_timer c (add now (c_rto c)) (c_rto c) (c_tries c))) st)
                (step_with st (c_set_timer c (add now (tcp_rto_ns)) (tcp_rto_ns) 0)))))))

; ------------------------------------------------------------------ sending

; The step with every segment of data the window allows sent, then the FIN
; if the application has closed and all its data is sent. force says to
; send a byte even into a closed window, which is how one is probed.
(def tcp_pump ((st TcpStep) (force bool)) TcpStep
  (let c (step_conn st)
    (if (not (can_send_data c))
        st
        (let unsent (tcp_unsent c)
          (let room (let r (sub (c_wnd c) (tcp_flight c)) (if force (max r 1) r))
            (let n (min unsent (min room (tcp_segment_size c)))
              (if (gt n 0)
                  (tcp_pump (pumped st n (eq n unsent)) false)
                  (if (if (c_fin c) (eq unsent 0) false)
                      (finished st)
                      st))))))))

; The step with n bytes of the data not sent yet sent, as the end of what
; the application gave if last.
(def pumped ((st TcpStep) (n int) (last bool)) TcpStep
  (let c (step_conn st)
    (let body (take (drop_n (c_queue c) (tcp_flight c)) n)
      (say_seg (step_with st (c_set_nxt c (seq_add (c_nxt c) n)))
               (if last (bit_or (tcp_ack) (tcp_psh)) (tcp_ack)) (c_nxt c) 0 body))))

; The step with the FIN sent, after the last of the data: the connection
; waits for it to be acknowledged, and for the peer's, or only for the
; first, if the peer has finished already.
(def finished ((st TcpStep)) TcpStep
  (let c (step_conn st)
    (say_seg (step_with st (c_set_nxt (c_set_state c (if (eq (c_state c) (tcp_established)) (tcp_fin_wait_1) (tcp_last_ack))) (seq_add (c_nxt c) 1)))
             (bit_or (tcp_fin) (tcp_ack)) (c_nxt c) 0 (nil int))))

; Connection c given more data to send, at time now.
(def tcp_send ((c Conn) (now int) (body (list int))) TcpStep
  (let st (tcp_pump (TcpStep (c_set_queue c (append (c_queue c) body) (c_fin c)) (nil TcpAct)) false)
    (step_done (tcp_settled st now (c_una c) (c_state c)))))

; Whether connection c has room for n bytes more: what it holds, sent or
; not, stays within tcp_send_limit.
(def tcp_fits ((c Conn) (n int)) bool
  (le (add (length (c_queue c)) n) (tcp_send_limit)))

; Connection c refused a write for want of room: its application is told
; when there is room, at once if there is already as much as roomed
; waits for.
(def tcp_refuse ((c Conn)) TcpStep
  (step_done (roomed (TcpStep (c_set_wait c true) (nil TcpAct)))))

; Connection c closed by its application: its data is sent, then a FIN. One
; not yet open is simply gone.
(def tcp_close ((c Conn) (now int)) TcpStep
  (if (eq (c_state c) (tcp_syn_sent))
      (step_done (say_gone (TcpStep c (nil TcpAct)) "closed"))
      (let st (tcp_pump (TcpStep (c_set_queue c (c_queue c) true) (nil TcpAct)) false)
        (step_done (tcp_settled st now (c_una c) (c_state c))))))

; Connection c given up by its application, or by inet: a reset, if the
; peer knows of it, and it is gone.
(def tcp_abort ((c Conn) (why (list int))) TcpStep
  (let st (TcpStep c (nil TcpAct))
    (step_done (say_gone (if (eq (c_state c) (tcp_syn_sent)) st (say_seg st (bit_or (tcp_rst) (tcp_ack)) (c_nxt c) 0 (nil int))) why))))

; ---------------------------------------------------------------- the timer

; Connection c at time now: if its timer has run out, the first thing not
; acknowledged is sent again, with the timeout doubled, or the connection
; is given up for lack of an answer, or, in TIME-WAIT, gone.
(def tcp_tick ((c Conn) (now int)) TcpStep
  (let st (TcpStep c (nil TcpAct))
    (if (if (eq (c_deadline c) 0) true (lt now (c_deadline c)))
        st
        (if (eq (c_state c) (tcp_time_wait))
            (step_done (say_gone st ""))
            (if (ge (c_tries c) (tcp_tries))
                (step_done (say_gone (say_seg st (bit_or (tcp_rst) (tcp_ack)) (c_nxt c) 0 (nil int)) "timeout"))
                (step_done (timed_out st now)))))))

; The step with the timer's work done: what is not acknowledged sent
; again, and the timer set for twice as long.
(def timed_out ((st TcpStep) (now int)) TcpStep
  (let c (step_conn st)
    (let rto (min (mul 2 (c_rto c)) (tcp_rto_max_ns))
      (let st2 (sent_again st)
        (let c2 (step_conn st2)
          (step_with st2 (c_set_timer c2 (add now rto) rto (add (c_tries c) 1))))))))

; The step with what is sent and not acknowledged sent again: the SYN, or
; all the data from SND.UNA, or the FIN, or if there is none, a byte the
; window has not room for, which asks it to open.
(def sent_again ((st TcpStep)) TcpStep
  (let c (step_conn st)
    (if (eq (c_state c) (tcp_syn_sent))
        (say_seg st (tcp_syn) (c_una c) (tcp_our_mss) (nil int))
        (if (eq (c_state c) (tcp_syn_received))
            (say_seg st (bit_or (tcp_syn) (tcp_ack)) (c_una c) (tcp_our_mss) (nil int))
            (if (gt (tcp_flight c) 0)
                (resent st 0 (tcp_flight c))
                (if (fin_unacked c)
                    (say_seg st (bit_or (tcp_fin) (tcp_ack)) (c_una c) 0 (nil int))
                    (tcp_pump st true)))))))

; The step with the data from off bytes past SND.UNA to total bytes past it
; sent again, in segments.
(def resent ((st TcpStep) (off int) (total int)) TcpStep
  (if (ge off total)
      st
      (let c (step_conn st)
        (let n (min (sub total off) (tcp_segment_size c))
          (resent (say_seg st (tcp_ack) (seq_add (c_una c) off) 0 (take (drop_n (c_queue c) off) n)) (add off n) total)))))

; ------------------------------------------------------------------ arriving

; Connection c, at time now, given segment s of its peer's.
(def tcp_arrive ((c Conn) (now int) (s Seg)) TcpStep
  (let st (TcpStep c (nil TcpAct))
    (let st2 (if (eq (c_state c) (tcp_syn_sent)) (arrive_syn_sent st now s) (arrive_open st now s))
      (step_done (tcp_settled (tcp_pump st2 false) now (c_una c) (c_state c))))))

; The SEGMENT ARRIVES rules for SYN-SENT (RFC 9293, 3.10.7.3): an
; acknowledgement of the SYN, with or without a reset, is what is waited
; for. A SYN alone, a simultaneous open, is not answered.
(def arrive_syn_sent ((st TcpStep) (now int) (s Seg)) TcpStep
  (let c (step_conn st)
    (let acks (seg_has s (tcp_ack))
      (let ack (match s ((Seg sport dport seq a flags window mss body) a))
        (let ack_ok (if acks (if (seq_lt (c_una c) ack) (seq_le ack (c_nxt c)) false) false)
          (if (if acks (not ack_ok) false)
              (if (seg_has s (tcp_rst)) st (say_rst st ack))
              (if (seg_has s (tcp_rst))
                  (if ack_ok (say_gone st "refused") st)
                  (if (if ack_ok (seg_has s (tcp_syn)) false)
                      (opened st s)
                      st))))))))

; The step for a SYN and ACK s that acknowledges the SYN sent: the
; connection is open, and the SYN is acknowledged in its turn.
(def opened ((st TcpStep) (s Seg)) TcpStep
  (match s
    ((Seg sport dport seq ack flags window mss body)
      (let c (step_conn st)
        (let c2 (c_set_state (c_set_seqs c ack (c_nxt c) window (seq_add seq 1) (if (gt mss 0) mss (tcp_default_mss))) (tcp_established))
          (say_ack (step_act (step_with st c2) (ConnUp))))))))

; The rules for every other state (3.10.7.4): the segment must be in the
; window; then a reset, a SYN, its acknowledgement, its data and its FIN
; are dealt with, in that order.
(def arrive_open ((st TcpStep) (now int) (s Seg)) TcpStep
  (let c (step_conn st)
    (if (if (eq (c_state c) (tcp_syn_received)) (again_syn c s) false)
        (say_seg st (bit_or (tcp_syn) (tcp_ack)) (c_una c) (tcp_our_mss) (nil int))
        (if (not (acceptable c s))
            (unacceptable st now s)
            (if (seg_has s (tcp_rst))
                (reset_in st s)
                (if (seg_has s (tcp_syn))
                    (say_ack st)
                    (if (seg_has s (tcp_ack))
                        (acked st now s)
                        st)))))))

; Whether s is the SYN again that opened a connection in SYN-RECEIVED.
(def again_syn ((c Conn) (s Seg)) bool
  (match s
    ((Seg sport dport seq ack flags window mss body)
      (if (seg_has s (tcp_syn)) (eq seq (seq_add (c_rcv c) -1)) false))))

; Whether any of the sequence numbers s takes up is in the window, or if it
; takes up none, its own is (3.10.7.4).
(def acceptable ((c Conn) (s Seg)) bool
  (match s
    ((Seg sport dport seq ack flags window mss body)
      (let len (seg_space s)
        (if (eq len 0)
            (in_window c seq)
            (if (in_window c seq) true (in_window c (seq_add seq (sub len 1)))))))))

; Whether sequence number n is from RCV.NXT up to a window's end.
(def in_window ((c Conn) (n int)) bool
  (if (seq_le (c_rcv c) n) (seq_lt n (seq_add (c_rcv c) (tcp_window))) false))

; What a segment out of the window gets: an acknowledgement, of where its
; sender should go on from, unless it is a reset; and in TIME-WAIT, the
; wait begins again.
(def unacceptable ((st TcpStep) (now int) (s Seg)) TcpStep
  (if (seg_has s (tcp_rst))
      st
      (let st2 (say_ack st)
        (if (eq (c_state (step_conn st2)) (tcp_time_wait)) (time_wait_timer st2 now) st2))))

; A reset in the window: the connection is gone if it is exactly where
; the next byte is expected, and otherwise the sender is asked, by an
; acknowledgement, to say again (RFC 5961, 3.2).
(def reset_in ((st TcpStep) (s Seg)) TcpStep
  (let c (step_conn st)
    (if (eq (match s ((Seg sport dport seq ack flags window mss body) seq)) (c_rcv c))
        (say_gone st (if (eq (c_state c) (tcp_syn_received)) "refused" "reset"))
        (say_ack st))))

; The acknowledgement in s (3.10.7.4, the ACK field), and then its data.
(def acked ((st TcpStep) (now int) (s Seg)) TcpStep
  (let c (step_conn st)
    (let ack (match s ((Seg sport dport seq a flags window mss body) a))
      (if (eq (c_state c) (tcp_syn_received))
          (if (if (seq_lt (c_una c) ack) (seq_le ack (c_nxt c)) false)
              (received st now s (step_act (step_with st (c_set_state (c_set_seqs c ack (c_nxt c) (match s ((Seg sport dport seq a2 flags window mss body) window)) (c_rcv c) (c_mss c)) (tcp_established))) (ConnAccepted)))
              (say_rst st ack))
          (if (seq_lt (c_nxt c) ack)
              (say_ack st)
              (advanced st now s))))))

; The step for an acknowledgement that is not of something sent too soon:
; what it covers is dropped from the queue, the window is the one it
; offers, and a FIN of ours it covers moves the state on.
(def advanced ((st TcpStep) (now int) (s Seg))  TcpStep
  (let c (step_conn st)
    (match s
      ((Seg sport dport seq ack flags window mss body)
        (if (seq_lt ack (c_una c))
            (received st now s st)
            (let fin_acked (if (fin_unacked c) (eq ack (c_nxt c)) false)
              (let freed (min (length (c_queue c)) (sub (seq_diff ack (c_una c)) (if fin_acked 1 0)))
                (let c2 (c_set_wnd (c_set_una (c_set_queue c (drop_n (c_queue c) freed) (c_fin c)) ack) window)
                  (received st now s (finish_acked (roomed (step_with st c2)) now fin_acked))))))))))

; The step with the application told it may write again, if a write of
; its was refused and what inet holds has fallen to tcp_room_mark.
(def roomed ((st TcpStep)) TcpStep
  (let c (step_conn st)
    (if (if (c_wait c) (le (length (c_queue c)) (tcp_room_mark)) false)
        (step_act (step_with st (c_set_wait c false)) (ConnRoom (sub (tcp_send_limit) (length (c_queue c)))))
        st)))

; The step after our FIN was acknowledged, if it was: FIN-WAIT-1 waits
; for the peer's FIN, CLOSING's wait begins, and LAST-ACK is the end.
(def finish_acked ((st TcpStep) (now int) (fin_acked bool)) TcpStep
  (if (not fin_acked)
      st
      (let s (c_state (step_conn st))
        (if (eq s (tcp_fin_wait_1))
            (step_with st (c_set_state (step_conn st) (tcp_fin_wait_2)))
            (if (eq s (tcp_closing))
                (say_time_wait st now)
                (say_gone st "closed"))))))

; The data and FIN of s, once its acknowledgement has made st: only a
; connection that may still receive takes any, and only what fits the
; window; each segment is acknowledged. What is next in order is taken,
; with whatever held segments it reaches; a segment that starts further
; on is held until what is missing before it comes, and the
; acknowledgement, of what was next still, asks the peer for that.
(def received ((st TcpStep) (now int) (s Seg) (st2 TcpStep)) TcpStep
  (let c (step_conn st2)
    (if (not (state_in c "3 4 5"))
        st2
        (match s
          ((Seg sport dport seq ack flags window mss body)
            (if (if (is_empty body) (not (seg_has s (tcp_fin))) false)
                st2
                (if (lt (seq_diff (c_rcv c) seq) 0)
                    (say_ack (step_with st2 (tcp_hold c seq body (seg_has s (tcp_fin)))))
                    (taken st2 now (drop_n body (seq_diff (c_rcv c) seq)) (if (gt (seq_diff (c_rcv c) seq) (length body)) false (seg_has s (tcp_fin)))))))))))

; How many segments a connection holds out of order at most: past that,
; one more is dropped, and asked for again once those before it come.
(def tcp_held_limit () int 16)

; c holding the segment from seq of body, and whether a FIN follows it,
; which came before the bytes ahead of it: cut to the window, and kept in
; order among the others, unless c holds as many as it may already.
(def tcp_hold ((c Conn) (seq int) (body (list int)) (fin bool)) Conn
  (let room (sub (tcp_window) (seq_diff seq (c_rcv c)))
    (if (if (le room 0) true (ge (length (c_held c)) (tcp_held_limit)))
        c
        (let kept (take body room)
          (c_set_held c (held_insert (c_held c) (c_rcv c) (TcpHeld seq kept (if fin (eq (length kept) (length body)) false))))))))

; A held segment's sequence number.
(def held_seq ((h TcpHeld)) int (match h ((TcpHeld seq body fin) seq)))

; hs, in the order of their sequence numbers counted from rcv, with h in
; its place: after any that start where it does.
(def held_insert ((hs (list TcpHeld)) (rcv int) (h TcpHeld)) (list TcpHeld)
  (if (is_empty hs)
      (cons h hs)
      (if (lt (seq_diff (held_seq h) rcv) (seq_diff (held_seq (head hs)) rcv))
          (cons h hs)
          (cons (head hs) (held_insert (tail hs) rcv h)))))

; The data that follows on from the next byte once held segments are
; joined to it, whether a FIN follows that, and the segments still held.
(data TcpJoined (TcpJoined (list int) bool (list TcpHeld)))

; body, reversed in acc, up to sequence number next, and fin, with each
; of hs joined on that starts at or before next: the part of it past
; next, and its FIN. Joining stops at a gap, and at a FIN, after which
; nothing is held.
(def held_joined ((hs (list TcpHeld)) (next int) (acc (list int)) (fin bool)) TcpJoined
  (if (if fin true (is_empty hs))
      (TcpJoined (rev acc) fin (if fin (nil TcpHeld) hs))
      (match (head hs)
        ((TcpHeld seq body hfin)
          (let d (seq_diff next seq)
            (if (lt d 0)
                (TcpJoined (rev acc) false hs)
                (if (gt d (length body))
                    (held_joined (tail hs) next acc false)
                    (let part (drop_n body d)
                      (held_joined (tail hs) (seq_add next (length part)) (rev_onto part acc) hfin)))))))))

; The step for data the connection takes, from its next byte, and whether
; the FIN follows it, joined to what it holds that this reaches: what the
; window holds is given to the application, the FIN if all of it fits,
; and all is acknowledged.
(def taken ((st TcpStep) (now int) (body (list int)) (fin bool)) TcpStep
  (let c (step_conn st)
    (match (held_joined (c_held c) (seq_add (c_rcv c) (length body)) (rev body) fin)
      ((TcpJoined all fin1 rest)
        (let kept (take all (tcp_window))
          (let fin2 (if fin1 (eq (length kept) (length all)) false)
            (let c2 (c_set_held (c_set_rcv c (seq_add (c_rcv c) (add (length kept) (if fin2 1 0)))) rest)
              (let st2 (if (is_empty kept) (step_with st c2) (step_act (step_with st c2) (GotData kept)))
                (say_ack (if fin2 (fin_in st2 now) st2))))))))))

; The step after the peer's FIN: the application is told, and the state
; moves on, to waiting for the application to close, or to the end.
(def fin_in ((st TcpStep) (now int)) TcpStep
  (let c (step_conn st)
    (let s (c_state c)
      (let st2 (step_act st (GotFin))
        (if (eq s (tcp_established))
            (step_with st2 (c_set_state c (tcp_close_wait)))
            (if (eq s (tcp_fin_wait_1))
                (step_with st2 (c_set_state c (tcp_closing)))
                (say_time_wait st2 now)))))))
