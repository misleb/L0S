; dhcp.l0 -- DHCP's messages (RFC 2131, with the options of RFC 2132) as
; bytes, built and read, for inet's client: the DISCOVER and REQUEST a
; client sends, and the OFFER, ACK and NAK a server answers with. Pure,
; as packet.l0 is, which carries them in UDP, from port 68 to port 67. A
; message is BOOTP's 236 bytes (RFC 951), the magic cookie, and then
; options, each its code, its length and its data, ended by 255.

; ---------------------------------------------------------------- numbers

; The ports: a client's, and a server's.
(def dhcp_client_port () int 68)
(def dhcp_server_port () int 67)

; The message types, option 53's one byte.
(def dhcp_discover_type () int 1)
(def dhcp_offer_type () int 2)
(def dhcp_request_type () int 3)
(def dhcp_ack_type () int 5)
(def dhcp_nak_type () int 6)

; The options inet uses: the subnet mask, the routers, the name
; servers, the address a client asks for, the lease's time in seconds,
; the message's type, the server's identifier, and the list of options a
; client wants.
(def opt_mask () int 1)
(def opt_router () int 3)
(def opt_dns () int 6)
(def opt_requested () int 50)
(def opt_lease () int 51)
(def opt_type () int 53)
(def opt_server () int 54)
(def opt_wanted () int 55)

; The bytes before the options: BOOTP's 236 and the cookie's 4.
(def dhcp_fixed_len () int 240)

; ----------------------------------------------------------------- building

; An option: its code, its length, its data.
(def opt_bytes ((code int) (body (list int))) (list int)
  (cons code (cons (length body) body)))

; A message from a client whose Ethernet address is mac, the xid'th
; exchange, holding options: a request (op 1) for Ethernet (1, of 6
; bytes), no hops and no seconds, asking for its answers to be broadcast,
; since it has no address to be sent one at, with no addresses of its own
; yet, its hardware address padded to 16 bytes, no server's name and no
; file, then the cookie, the options, and the end.
(def dhcp_bytes ((xid int) (mac (list int)) (options (list int))) (list int)
  (dhcp_bytes_at xid mac 0 options))

; The same from a client at ciaddr, which has an address, 0 for one that
; has none: a client with an address is answered at it, so asks for no
; broadcast.
(def dhcp_bytes_at ((xid int) (mac (list int)) (ciaddr int) (options (list int))) (list int)
  (append (cons 1 (cons 1 (cons 6 (cons 0 (be32 xid)))))
    (append (be16 0) (append (be16 (if (eq ciaddr 0) 32768 0))     ; 0x8000: broadcast
      (append (be32 ciaddr) (append (zeros 12) (append mac (append (zeros 10)
        (append (zeros 192) (append (cons 99 (cons 130 (cons 83 (cons 99 (nil int)))))   ; 0x63825363
          (append options (cons 255 (nil int)))))))))))))

; The options a client lists to say what it wants of the server: its
; subnet mask, its router, and its name servers.
(def wanted_options () (list int)
  (opt_bytes (opt_wanted) (cons (opt_mask) (cons (opt_router) (cons (opt_dns) (nil int))))))

; A DISCOVER: a client finding a server, the xid'th time.
(def dhcp_discover ((xid int) (mac (list int))) (list int)
  (dhcp_bytes xid mac (append (opt_bytes (opt_type) (cons (dhcp_discover_type) (nil int))) (wanted_options))))

; A REQUEST of the address offered by a server: the address and the
; server's identifier, as a client selecting an offer sends it.
(def dhcp_request ((xid int) (mac (list int)) (offered int) (server int)) (list int)
  (dhcp_bytes xid mac
    (append (opt_bytes (opt_type) (cons (dhcp_request_type) (nil int)))
      (append (opt_bytes (opt_requested) (be32 offered))
        (append (opt_bytes (opt_server) (be32 server)) (wanted_options))))))

; A REQUEST to extend the lease of the address addr, as a client renewing
; or rebinding sends it (RFC 2131, 4.3.2): its own address in ciaddr, and
; neither the address asked for nor the server's identifier.
(def dhcp_renew ((xid int) (mac (list int)) (addr int)) (list int)
  (dhcp_bytes_at xid mac addr (append (opt_bytes (opt_type) (cons (dhcp_request_type) (nil int))) (wanted_options))))

; ------------------------------------------------------------------ reading

; An option read: its code and its data.
(data Opt (Opt int (list int)))

; A message read: its op, its xid, its type, the client's hardware
; address, the address it gives (yiaddr), and the address a request asks
; for, the mask, the first router, the server's identifier, the lease's
; seconds and the first name server its options hold, each 0 if it has
; none.
(data Dhcp (Dhcp int int int (list int) int int int int int int int))

; The options of b from i on, in order, up to the end option or the end
; of b; one whose length runs past the end of b is left out, and so is
; what follows it.
(def opts_of ((b bytes) (i int) (acc (list Opt))) (list Opt)
  (if (ge i (bytes_len b))
      (rev acc)
      (let code (bytes_get b i)
        (if (eq code 255) (rev acc)
            (eq code 0) (opts_of b (add i 1) acc)
            (ge (add i 1) (bytes_len b)) (rev acc)
            (let n (bytes_get b (add i 1))
              (if (gt (add (add i 2) n) (bytes_len b))
                  (rev acc)
                  (opts_of b (add (add i 2) n) (cons (Opt code (bytes_range b (add i 2) (add (add i 2) n))) acc))))))))

; The data of the first option with code in os, or none.
(def opt_find ((os (list Opt)) (code int)) (Option (list int))
  (if (is_empty os)
      ((None (list int)))
      (match (head os)
        ((Opt c body) (if (eq c code) (Some body) (opt_find (tail os) code))))))

; The address that begins the data of option code, or 0 if it is not
; there or holds less than four bytes.
(def opt_addr ((os (list Opt)) (code int)) int
  (match (opt_find os code)
    ((None) 0)
    ((Some body) (if (lt (length body) 4) 0 (be32_of body)))))

; The u32 that the first four bytes of xs are, most significant first;
; the caller has checked that they are there.
(def be32_of ((xs (list int))) int
  (bit_or (bit_shl (nth xs 0) 24) (bit_or (bit_shl (nth xs 1) 16) (bit_or (bit_shl (nth xs 2) 8) (nth xs 3)))))

; The message's type, option 53's byte, or -1 if there is none.
(def opt_type_of ((os (list Opt))) int
  (match (opt_find os (opt_type))
    ((None) -1)
    ((Some body) (if (eq (length body) 1) (head body) -1))))

; The message xs holds, or none if it is shorter than its fixed part,
; is not for Ethernet, lacks the cookie, or has no type.
(def dhcp_of ((xs (list int))) (Option Dhcp)
  (let b (bytes_from_list xs)
    (if (lt (bytes_len b) (dhcp_fixed_len)) ((None Dhcp))
        (not (and (eq (bytes_get b 1) 1) (eq (bytes_get b 2) 6))) ((None Dhcp))
        (not (eq (be32_at b 236) 1669485411)) ((None Dhcp))        ; 0x63825363
        (dhcp_read b (opts_of b (dhcp_fixed_len) (nil Opt))))))

; The rest of dhcp_of: b's fields, and its options os.
(def dhcp_read ((b bytes) (os (list Opt))) (Option Dhcp)
  (let type (opt_type_of os)
    (if (lt type 0)
        ((None Dhcp))
        (Some (Dhcp (bytes_get b 0) (be32_at b 4) type (bytes_range b 28 34) (be32_at b 16)
                    (opt_addr os (opt_requested)) (opt_addr os (opt_mask)) (opt_addr os (opt_router))
                    (opt_addr os (opt_server)) (opt_addr os (opt_lease)) (opt_addr os (opt_dns)))))))
