; hello.l0 -- the smallest process: says who it is and what it was given,
; and answers one line of console input. With a console driver running,
; it prompts and reads the line typed there; without one, it reads its
; standard input, the file the inittab names as stdin.

(def greeting ((pid int) (argv (list (list int)))) (list int)
  (let a (push "hello from pid " (nil int))
    (let b (push (digits pid) a)
      (let c (push (if (is_empty argv) ", no arguments" ", arguments:") b)
        (rev (push "\n" (push_words argv c)))))))

(def push_words ((ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws)
      acc
      (push_words (tail ws) (push (head ws) (push " " acc)))))

(def reply ((line (list int))) (list int)
  (if (is_empty line)
      "hello: no input\n"
      (append "hello: you said " (append (take_line line) "\n"))))

(def prompt () (list int) "hello: say something: ")

(def hello () int
  (let w (write_str (greeting (l0s_pid) (args)))
    (let console (console_port)
      (if (lt console 0)
          (write_str (reply (read_line)))
          (let p (write_str (prompt))
            (let f (file_flush (IoFile 1))                ; shown before the wait
              (write_str (reply (console_line_on console (port_new))))))))))
