(def test_greeting () int
  (add (check_str "args" (greeting 2 (split_spaces "a b")) "hello from pid 2, arguments: a b\n")
       (check_str "none" (greeting 1 (nil (list int))) "hello from pid 1, no arguments\n")))

(def test_reply () int
  (add (check_str "line" (reply "hi there\n") "hello: you said hi there\n")
       (check_str "end" (reply "") "hello: no input\n")))
