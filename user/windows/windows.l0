; windows.l0 -- lists the compositor's windows, front first, and where the
; pointer is: each window's id, title, x, y, width, height, and front for
; the one in front.

(def complain ((why (list int))) int
  (let w (write_err (append "windows: " (append why "\n"))) 1))

; The reply, ending with a newline.
(def listing ((r (list int))) (list int)
  (if (if (is_empty r) false (eq (head (rev r)) 10)) r (append r "\n")))

(def windows () int
  (match (compositor_open)
    ((NoCompositor why) (complain why))
    ((Compositor port rp pid)
      (let r (compositor_ask (Compositor port rp pid) "windows")
        (if (starts_with r "error: ")
            (complain (drop_n r 7))
            (write_str (listing r)))))))
