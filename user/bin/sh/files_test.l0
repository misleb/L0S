; files_test.l0 -- tests of the shell's commands on files.

; Paths as entry_paths gives an initramfs's: directories with a final /.
(def paths () (list (list int))
  (split_spaces "/bin/ /bin/cat /bin/sh /etc/ /etc/inittab /etc/motd"))

(def test_is_file_command () int
  (add (check_true "cp" (is_file_command "cp"))
       (check_bool "ps" (is_file_command "ps") false)))

(def test_ls_root () int
  (add (check_str "/" (ls_root "/" (paths)) "  Volumes/\n  bin/\n  etc/\n")
       (add (check_str "/bin" (ls_root "/bin" (paths)) "  cat\n  sh\n")
            (check_str "a file" (ls_root "/etc/motd" (paths)) "  /etc/motd\n"))))

(def test_ls_missing () int
  (check_str "none" (ls_root "/nothing" (paths)) "sh: ls: /nothing: no such file\n"))

; Under an operating system there is no kernel, so /Volumes is empty.
(def test_ls_volumes () int
  (add (check_str "/Volumes" (ls_one "/Volumes" (paths)) "")
       (check_str "a volume" (ls_one "/Volumes/data" (paths)) "sh: ls: /Volumes/data: no such file\n")))

(def test_paths_in () int
  (check_strs "paths" (paths_in "/Volumes/data" (cons (FsStat "a" 1) (cons (FsStat "b" 2) (nil FsStat))))
              (split_spaces "/Volumes/data/a /Volumes/data/b")))

(def test_usage () int
  (add (check_str "cat" (file_command "cat" (nil (list int)) (paths)) "sh: usage: cat FILE...\n")
       (add (check_str "write" (file_command "write" (nil (list int)) (paths)) "sh: usage: write FILE WORDS...\n")
            (check_str "cp" (file_command "cp" (split_spaces "a") (paths)) "sh: usage: cp FROM TO\n"))))

(def test_partition_usage () int
  (add (check_str "none" (file_command "partition" (nil (list int)) (paths)) "sh: usage: partition [DISK] SECTORS [START]\n")
       (add (check_str "not a number" (file_command "partition" (split_spaces "lots") (paths)) "sh: partition: lots: sectors are a number\n")
            (add (check_str "mkfs" (file_command "mkfs" (split_spaces "x") (paths)) "sh: usage: mkfs UUID LABEL [fat32]\n")
                 (check_str "not a UUID" (file_command "mkfs" (split_spaces "x data") (paths)) "sh: mkfs: x: not a UUID\n")))))

; Under an operating system there is no file server.
(def test_partition_no_server () int
  (add (check_str "partition" (file_command "partition" (split_spaces "100") (paths)) "sh: partition: disk0: no file server\n")
       (check_str "mkfs" (file_command "mkfs" (split_spaces "0199c82c-c07b-7123-8456-0123456789ab data") (paths))
                  "sh: mkfs: 0199c82c-c07b-7123-8456-0123456789ab: no file server\n")))

; A disk named first is the one partitioned; named alone, it is no
; partition.
(def test_partition_of_disk () int
  (add (check_str "of disk1" (file_command "partition" (split_spaces "disk1 100") (paths)) "sh: partition: disk1: no file server\n")
       (check_str "disk1 alone" (file_command "partition" (split_spaces "disk1") (paths)) "sh: usage: partition [DISK] SECTORS [START]\n")))

(def test_cat_missing () int
  (check_str "said" (cat_one "build/no-such-file") "sh: cat: build/no-such-file: no such file\n"))

; 190 clusters of data, 189 free: 760K, 4K used, 756K free.
(def test_df_line () int
  (check_str "data" (df_line "/Volumes/data" 190 189 1)
             "  /Volumes/data       760K      4K    756K      1\n"))

(def test_df_none () int
  (check_str "none" (df_text (nil (list int))) "sh: df: no volumes are mounted\n"))

(def test_volume_named () int
  (add (check_str "a label" (volume_named "data") "/Volumes/data")
       (check_str "a path" (volume_named "/Volumes/data/") "/Volumes/data")))

(def test_format_refused () int
  (add (check_str "no volume" (format_text (split_spaces "/etc")) "sh: format: /etc: not a volume\n")
       (check_str "not mounted" (format_text (split_spaces "data")) "sh: format: /Volumes/data: no such volume\n")))

; Under l0 test no volume is mounted, so unmount finds none; and it takes
; one volume.
(def test_unmount_refused () int
  (add (check_str "no volume" (unmount_text (split_spaces "/etc")) "sh: unmount: /etc: not a volume\n")
       (add (check_str "not mounted" (unmount_text (split_spaces "data")) "sh: unmount: /Volumes/data: no such volume\n")
            (check_str "one" (unmount_text (nil (list int))) "sh: usage: unmount VOLUME\n"))))

; relabel takes a volume and a label; with no file server, as under l0
; test, none serves it.
(def test_relabel_refused () int
  (add (check_str "no volume" (relabel_text (split_spaces "/etc notes")) "sh: relabel: /etc: not a volume\n")
       (add (check_str "not served" (relabel_text (split_spaces "data notes")) "sh: relabel: /Volumes/data: no file server serves it\n")
            (check_str "two words" (relabel_text (split_spaces "data")) "sh: usage: relabel VOLUME LABEL\n"))))

; The codes fs refuses with, in words.
(def test_unmounted () int
  (add (check_str "done" (unmounted "/Volumes/data" 0) "")
       (check_str "open" (unmounted "/Volumes/data" -4) "sh: unmount: /Volumes/data: a file is open\n")))

(def test_inside () int
  (check_str "into a volume" (inside "/Volumes/data" "/etc/motd") "/Volumes/data/motd"))

(def test_path_args_relative () int
  (add (check_strs "cat from /etc" (path_args "/etc" "cat" (split_spaces "motd ../bin/sh /x")) (split_spaces "/etc/motd /bin/sh /x"))
       (add (check_strs "cp both" (path_args "/home" "cp" (split_spaces "a b")) (split_spaces "/home/a /home/b"))
            (check_strs "write only the file" (path_args "/home" "write" (split_spaces "a b c")) (split_spaces "/home/a b c")))))

(def test_path_args_ls () int
  (add (check_strs "ls with none, at /" (path_args "/" "ls" (nil (list int))) (nil (list int)))
       (add (check_strs "ls with none, in /etc" (path_args "/etc" "ls" (nil (list int))) (split_spaces "/etc"))
            (check_strs "ls ." (path_args "/etc" "ls" (split_spaces ".")) (split_spaces "/etc")))))

; The commands of volumes take labels and numbers, not paths.
(def test_path_args_volumes () int
  (add (check_strs "format" (path_args "/etc" "format" (split_spaces "data")) (split_spaces "data"))
       (check_strs "partition" (path_args "/etc" "partition" (split_spaces "100")) (split_spaces "100"))))
