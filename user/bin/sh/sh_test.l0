(def describe ((c Command)) (list int)
  (match c
    ((CmdEnd) "end")
    ((CmdNothing) "nothing")
    ((CmdHelp) "help")
    ((CmdFile op ws) (append op (args_shown ws)))
    ((CmdCd dir) (append "cd " dir))
    ((CmdPwd) "pwd")
    ((CmdPs) "ps")
    ((CmdNames) "names")
    ((CmdUptime) "uptime")
    ((CmdDmesg) "dmesg")
    ((CmdRun what argv bg) (append "run " (append what (append (args_shown argv) (if bg " &" "")))))
    ((CmdUnknown what) (append "unknown " what))
    ((CmdWait pid) (append "wait " (digits pid)))
    ((CmdKill pid) (append "kill " (digits pid)))
    ((CmdSleep ms) (append "sleep " (digits ms)))
    ((CmdEcho ws) (append "echo " (digits (length ws))))
    ((CmdExit st) (append "exit " (digits st)))
    ((CmdReboot) "reboot")
    ((CmdBad why) (append "bad: " why))))

(def test_reboot () int
  (add (check_str "reboot" (parsed "reboot\r\n") "reboot")
       (check_str "with words" (parsed "reboot now\n") "bad: reboot takes nothing")))

(def parsed ((line (list int))) (list int)
  (describe (parse_command line)))

(def args_shown ((argv (list (list int)))) (list int)
  (if (is_empty argv) "" (append " [" (append (unwords argv) "]"))))

(def test_builtins () int
  (add (check_str "help" (parsed "help\n") "help")
       (add (check_str "ls" (parsed "ls\r\n") "ls")
            (add (check_str "echo" (parsed "echo a b\n") "echo 2")
                 (check_str "exit" (parsed "exit 3\n") "exit 3")))))

(def test_file_commands () int
  (add (check_str "ls a path" (parsed "ls /Volumes\n") "ls [/Volumes]")
       (add (check_str "write" (parsed "write /Volumes/data/a hi there\n") "write [/Volumes/data/a hi there]")
            (check_str "df" (parsed "df\n") "df"))))

(def test_ps_filing () int
  (check_str "a file server's answer" (state_text (state_filing) 12) "waiting for the file server on port 12"))

(def test_empty () int
  (add (check_str "end of input" (parsed "") "end")
       (check_str "blank" (parsed "   \n") "nothing")))

(def test_run () int
  (add (check_str "by name" (parsed "run hello\n") "run hello")
       (add (check_str "background" (parsed "run spin &\n") "run spin &")
            (check_str "a module named like a command" (parsed "run echo\n") "run echo"))))

; A module never runs without run, whether or not it is named like a
; command.
(def test_no_bare_modules () int
  (add (check_str "a module's name" (parsed "hello\n") "unknown hello")
       (add (check_str "a number" (parsed "3\n") "unknown 3")
            (check_str "echo is the command" (parsed "echo\n") "echo 0"))))

(def test_background_needs_run () int
  (add (check_str "spin &" (parsed "spin &\n") "bad: only run NAME & runs in the background")
       (check_str "echo hi &" (parsed "echo hi &\n") "bad: only run NAME & runs in the background")))

(def test_run_arguments () int
  (add (check_str "one" (parsed "run ping 5\n") "run ping [5]")
       (add (check_str "several" (parsed "run hello a b  c\n") "run hello [a b c]")
            (check_str "and &" (parsed "run nap 900 &\n") "run nap [900] &"))))

; Only a last & means the background; one anywhere else is an argument.
(def test_run_ampersand_inside () int
  (check_str "an argument" (parsed "run hello & x\n") "run hello [& x]"))

(def test_run_only_ampersand () int
  (check_str "nothing to run" (parsed "run &\n") "bad: run what?"))

(def test_unknown_line () int
  (add (check_str "a program" (unknown_line "hello" (names)) "sh: no command hello; to run the program, type run hello\n")
       (check_str "nothing" (unknown_line "wat" (names)) "sh: no command wat\n")))

(def test_numbers () int
  (add (check_str "wait" (parsed "wait 4\n") "wait 4")
       (add (check_str "sleep" (parsed "sleep 50\n") "sleep 50")
            (check_str "not a number" (parsed "wait x\n") "bad: wait takes a number"))))

(def test_bad () int
  (add (check_str "lone &" (parsed "&\n") "bad: only run NAME & runs in the background")
       (check_str "run nothing" (parsed "run\n") "bad: run what?")))

; The entries' paths as entry_paths gives them: entry 0 /bin/sh, 1
; /bin/uart, 2 /bin/hello, then the directory /etc and /etc/motd.
(def names () (list (list int)) (split_spaces "/bin/sh /bin/uart /bin/hello /etc/ /etc/motd"))

(def test_program_entry () int
  (add (check_int "a name is in /bin" (program_entry "hello" (names)) 2)
       (add (check_int "a path" (program_entry "/bin/uart" (names)) 1)
            (add (check_int "a relative path" (program_entry "bin/uart" (names)) 1)
                 (check_int "no such" (program_entry "nope" (names)) -1)))))

(def test_program_path () int
  (add (check_str "name" (program_path "hello") "/bin/hello")
       (check_str "path" (program_path "./etc/motd") "/etc/motd")))

(def test_unknown_app_program () int
  (add (check_str "an app's program" (unknown_line "vt" (split_spaces "/bin/sh /Applications/Terminal.app/vt"))
                  "sh: no command vt; to run the program, type run vt\n")
       (check_str "nothing by the name" (unknown_line "vt" (names)) "sh: no command vt\n")))

(def test_listing () int
  (check_str "files, sorted, no directories" (listing (names))
             "  /bin/hello\n  /bin/sh\n  /bin/uart\n  /etc/motd\n"))

(def test_cannot_start () int
  (add (check_str "not a program" (cannot_start "/etc/motd" (SpawnNotProgram)) "sh: /etc/motd is not a program\n")
       (check_str "other" (cannot_start "/bin/sh" (SpawnNoRoom)) "sh: cannot start /bin/sh: no room for another process\n")))

; No /etc/motd under l0 test, so nothing.
(def test_motd_missing () int
  (check_str "none" (motd) ""))

(def test_lines () int
  (add (check_str "quiet on 0" (exited_line 3 0) "")
       (add (check_str "status" (exited_line 3 1) "[pid 3 exited with 1]\n")
            (check_str "started" (started_line 4) "[pid 4 running]\n"))))

(def test_ps_parse () int
  (check_str "ps" (parsed "ps\n") "ps"))

(def test_dmesg_parse () int
  (check_str "dmesg" (parsed "dmesg\n") "dmesg"))

; Under an operating system there is no kernel, so there is no log.
(def test_dmesg_text () int
  (check_str "no kernel" (dmesg_text) ""))

(def test_ps_line () int
  (add (check_str "receiving" (ps_line 2 (ProcInfo (state_receiving) 0 1 1 30 1) "uart" 0 3 "console")
                  "    2       0    0   0.3  uart          console       waiting for a message on port 1\n")
       (check_str "running" (ps_line 1 (ProcInfo (state_running) 0 0 0 40 0) "sh" 2 1000 "-")
                  "    1       0    2 100.0  sh            -             running\n")))

; A process that has not run has no CPU yet.
(def test_ps_line_no_cpu () int
  (check_str "new" (ps_line 7 (ProcInfo (state_ready) 1 4 0 0 0) "spin" -1 0 "-")
             "    7       1    -   0.0  spin          -             ready\n"))

(def test_names_parse () int
  (add (check_str "names" (parsed "names\n") "names")
       (check_str "uptime" (parsed "uptime\n") "uptime")))

; A name's line: the name, its port, its owner's pid and program.
(def test_names_line () int
  (check_str "console" (names_line "console" 1 2 "uart") "console          1      2  uart\n"))

; Under an operating system the kernel says nothing of names or CPUs.
(def test_names_text_none () int
  (add (check_str "no names" (names_text) "NAME          PORT    PID  PROGRAM\n")
       (check_str "no uptime" (uptime_said) "sh: uptime: the kernel does not say\n")))

(def test_ps_states () int
  (add (check_str "ready" (state_text (state_ready) 0) "ready")
       (add (check_str "waiting" (state_text (state_waiting) 7) "waiting for pid 7")
            (check_str "sleeping" (state_text (state_sleeping) 0) "sleeping"))))

(def test_ps_hides_exited () int
  (check_str "exited" (ps_line 3 (ProcInfo (state_exited) 0 -1 0 0 0) "sh" 0 0 "-") ""))

; Under l0 test there is no kernel to name pid 3's program.
(def test_ps_unknown_program () int
  (check_str "?" (ps_line 3 (ProcInfo (state_ready) 1 9 0 20 0) (program_name 3) -1 0 "-") "    3       1    -   0.0  ?             -             ready\n"))

; The state starts under STATE, 54 bytes in, and the names served
; under SERVES, 40 in.
(def test_ps_header_lines_up () int
  (add (check_true "header" (starts_with (drop_n (ps_header) 54) "STATE"))
  (add (check_true "line" (starts_with (drop_n (ps_line 1 (ProcInfo (state_running) 0 0 0 40 0) "sh" 0 5 "console") 54) "running"))
  (add (check_true "SERVES" (starts_with (drop_n (ps_header) 40) "SERVES"))
       (check_true "served" (starts_with (drop_n (ps_line 1 (ProcInfo (state_running) 0 0 0 40 0) "sh" 0 5 "console") 40) "console"))))))

(def test_kill_parse () int
  (add (check_str "kill" (parsed "kill 5\n") "kill 5")
       (check_str "kill what" (parsed "kill\n") "bad: kill takes a number")))

(def test_interrupted_line () int
  (check_str "130" (exited_line 4 130) "[pid 4 interrupted]\n"))

(def event_name ((e Event)) (list int)
  (match e
    ((ELine l) (append "line " l))
    ((EInterrupt) "interrupt")
    ((EExit pid st) (append "exit " (digits pid)))
    ((EOther) "other")))

(def test_events () int
  (add (check_str "line" (event_name (event_of (message_new 2 "ls\n"))) "line ls\n")
       (add (check_str "ctrl-c" (event_name (event_of (message_new 2 (cons 3 (nil int))))) "interrupt")
            (add (check_str "exit" (event_name (event_of (message_new 0 (exit_notice 5 0)))) "exit 5")
                 (check_str "irq" (event_name (event_of (message_new 0 (irq_notice 3)))) "other")))))

(def test_end_event () int
  (check_str "end of input" (event_name (event_of (RecvFailed))) "line "))

(def test_killed_lines () int
  (add (check_str "done" (killed 4 (Killed)) "")
       (add (check_str "denied" (killed 4 (KillDenied)) "sh: pid 4 is a driver\n")
            (check_str "gone" (killed 4 (KillNoProc)) "sh: no process 4\n"))))

(def test_reaped_status () int
  (add (check_int "exited" (reaped_status (Reaped 3)) 3)
       (check_int "gone" (reaped_status (WaitNoProc)) 1)))

(def test_tty_name () int
  (add (check_str "the serial line's" (tty_name (nil (list int))) "console")
       (check_str "the display's" (tty_name (split_spaces "vt")) "vt")))

; How the shell's arguments are read, as text.
(def invoked ((argv (list int))) (list int)
  (match (invocation (split_spaces argv))
    ((ShTty name) (append "tty " name))
    ((ShLine line) (append "line " line))))

(def test_invocation_tty () int
  (add (check_str "none" (invoked "") "tty console")
       (check_str "named" (invoked "vt1") "tty vt1")))

(def test_invocation_line () int
  (add (check_str "words joined" (invoked "-c ls /etc") "line ls /etc")
       (add (check_str "quotes off" (invoked "-c \"ls /etc\"") "line ls /etc")
            (check_str "empty" (invoked "-c") "line "))))

(def test_unquoted_keeps () int
  (add (check_str "one quote" (unquoted "\"") "\"")
       (check_str "only one end" (unquoted "\"ls") "\"ls")))

(def test_said_status () int
  (add (check_int "a complaint" (said_status "sh: no command x\n") 1)
       (add (check_int "a listing" (said_status "  /etc/motd\n") 0)
            (check_int "nothing" (said_status "") 0))))

; Under an operating system there is no kernel: the line's run fails to
; find hello, so says so and gives 1; echo gives 0.
(def test_run_line () int
  (add (check_int "echo" (run_line "echo hi") 0)
       (check_int "unknown" (run_line "wat") 1)))

(def test_terminal_states () int
  (add (check_str "writing" (state_text (state_writing) 4) "writing to port 4")
       (check_str "reading" (state_text (state_reading) 9) "reading a line, to port 9")))

(def test_cd_pwd () int
  (add (check_str "cd a directory" (parsed "cd /etc\n") "cd /etc")
       (add (check_str "cd with none goes to /" (parsed "cd\n") "cd /")
            (add (check_str "cd with two" (parsed "cd a b\n") "bad: cd takes one directory")
                 (check_str "pwd" (parsed "pwd\n") "pwd")))))

; A name with a / is a path from the current directory; under an
; operating system that is /.
(def test_run_name () int
  (add (check_str "a bare name" (run_name "hello") "hello")
       (add (check_str "a path" (run_name "/bin/hello") "/bin/hello")
            (check_str "a relative path" (run_name "bin/hello") "/bin/hello"))))

; Under an operating system there is no directory to make current.
(def test_cd_text () int
  (check_str "no such directory" (cd_text "/etc") "sh: cd: /etc: no such directory\n"))
