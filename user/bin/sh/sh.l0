; sh.l0 -- the shell: reads commands from a terminal, a line at a time,
; and runs the initramfs's programs by name: run hello runs /bin/hello,
; and run /bin/hello the same; a name not in /bin may be in /sbin, or an
; app's program, and run Terminal runs the app in
; /Applications/Terminal.app, the program its manifest names. Its
; terminal is console, the serial line's,
; or the one its argument names, such as vt, the display's: sh vt. That
; terminal is its standard input, output, and error, and those of every
; program it runs. As pid 1, exit stops the system. At its start it shows
; /etc/motd, if there is one.
;
; A program runs only through run: a word that is not one of the shell's
; commands is an error, never a program, so no program can be mistaken
; for a command or a command for a program. The commands on files, as
; busybox has them (ls, cat, write, append, cp, mv, rm, df, format,
; partition, mkfs), are in files.l0.

(data Command
  (CmdEnd)                          ; input has ended
  (CmdNothing)                      ; an empty line
  (CmdHelp)
  (CmdFile (list int) (list (list int)))   ; a command on files, and its words
  (CmdCd (list int))                ; cd: the directory to make the current one
  (CmdPwd)
  (CmdPs)
  (CmdNames)                        ; names: every name registered, and who serves it
  (CmdUptime)                       ; uptime: the time since boot, the load, each CPU's use
  (CmdDmesg)                        ; dmesg: the kernel's log
  (CmdRun (list int) (list (list int)) bool)   ; run: a program by name or path, its
                                               ; arguments, and whether in the background
  (CmdUnknown (list int))           ; not a command
  (CmdWait int)
  (CmdKill int)
  (CmdSleep int)
  (CmdEcho (list (list int)))
  (CmdExit int)
  (CmdReboot)                       ; reboot: restart the board
  (CmdBad (list int)))              ; what to say about it

(def parse_command ((line (list int))) Command
  (if (is_empty line)
      (CmdEnd)
      (let words (split_spaces (strip_cr (take_line line)))
        (if (is_empty words)
            (CmdNothing)
            (parse_words (head words) (tail words))))))

(def parse_words ((w (list int)) (rest (list (list int)))) Command
  (if (eq w "run")
      (parse_run rest)
      (if (eq (last (cons w rest)) "&")
          (CmdBad "only run NAME & runs in the background")
          (parse_builtin w rest))))

; run NAME [ARG ...] [&]: the arguments, if any, in place of the ones the
; inittab gives the program; & last leaves it running.
(def parse_run ((rest (list (list int)))) Command
  (if (is_empty rest)
      (CmdBad "run what?")
      (if (eq (last rest) "&")
          (parse_run_words (drop_last rest) true)
          (parse_run_words rest false))))

(def parse_run_words ((words (list (list int))) (bg bool)) Command
  (if (is_empty words)
      (CmdBad "run what?")
      (CmdRun (head words) (tail words) bg)))

(def parse_builtin ((w (list int)) (rest (list (list int)))) Command
  (if (any_eq w (split_spaces "help ?")) (CmdHelp)
  (if (is_file_command w) (CmdFile w rest)
  (if (eq w "ps") (CmdPs)
  (if (eq w "names") (CmdNames)
  (if (eq w "uptime") (CmdUptime)
  (if (eq w "dmesg") (CmdDmesg)
  (if (eq w "echo") (CmdEcho rest)
  (if (eq w "exit") (parse_exit rest)
  (if (eq w "reboot") (if (is_empty rest) (CmdReboot) (CmdBad "reboot takes nothing"))
  (parse_directory w rest)))))))))))

; cd [DIR], / unless given, and pwd; any other word on to parse_numeric.
(def parse_directory ((w (list int)) (rest (list (list int)))) Command
  (if (eq w "pwd")
      (CmdPwd)
      (if (eq w "cd")
          (if (is_empty rest)
              (CmdCd "/")
              (if (is_empty (tail rest)) (CmdCd (head rest)) (CmdBad "cd takes one directory")))
          (parse_numeric w rest))))

; exit [STATUS], 0 unless given.
(def parse_exit ((rest (list (list int)))) Command
  (match (arg_number rest 0)
    ((Some n) (CmdExit n))
    ((None) (CmdBad "exit takes a number"))))

(def parse_numeric ((w (list int)) (rest (list (list int)))) Command
  (if (any_eq w (split_spaces "wait kill sleep"))
      (if (if (is_empty rest) true (not (is_number (head rest))))
          (CmdBad (append w " takes a number"))
          (numeric w (int_prefix (head rest) 0)))
      (CmdUnknown w)))

(def numeric ((w (list int)) (n int)) Command
  (if (eq w "wait") (CmdWait n) (if (eq w "kill") (CmdKill n) (CmdSleep n))))

; ---------------------------------------------------------------- files

; The files of the initramfs, each on a line, in order of path; the
; directories, whose paths end with /, left out.
(def listing ((paths (list (list int)))) (list int)
  (listing_of (sort (files_only paths (nil (list int)))) (nil int)))

(def files_only ((paths (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty paths)
      (rev acc)
      (files_only (tail paths) (if (is_dir_path (head paths)) acc (cons (head paths) acc)))))

(def is_dir_path ((path (list int))) bool
  (if (is_empty path) true (eq (last path) 47)))

(def listing_of ((paths (list (list int))) (acc (list int))) (list int)
  (if (is_empty paths)
      (rev acc)
      (listing_of (tail paths) (push "\n" (push (head paths) (push "  " acc))))))

; The message of the day, from /etc/motd, or nothing if there is none.
(def motd () (list int)
  (match (read_whole "/etc/motd")
    ((Err why) (nil int))
    ((Ok b) (bytes_to_list b))))

; ----------------------------------------------------------- processes

(def ps_header () (list int) "  PID  PARENT  CPU  %CPU  PROGRAM       SERVES        STATE\n")

; The line ps shows for pid, or nothing for one that has exited: its
; parent, the CPU it is on or last ran on (cpu_text), its % of one CPU
; in tenths, its program's name, the names it serves (serves_text), and
; its state.
(def ps_line ((pid int) (info ProcInfo) (name (list int)) (cpu int) (tenths int) (serves (list int))) (list int)
  (match info
    ((ProcInfo st parent m detail own shared)
      (if (eq st (state_exited))
          (nil int)
          (let a (push (pad_left (digits pid) 5) (nil int))
            (let b (push (pad_left (digits parent) 8) a)
              (let c (push (pad_left (cpu_text cpu) 5) b)
                (let d (push (pad_left (tenths_text tenths) 6) c)
                  (let e (push (pad_right name 12) (push "  " d))
                    (let f (push (pad_right serves 12) (push "  " e))
                      (rev (push "\n" (push (state_text st detail) (push "  " f))))))))))))))

; How long ps watches the processes to say each one's % of a CPU: 250 ms.
(def ps_window_ns () int 250000000)

; Every live process's line, as ps shows them after acc: each process's
; CPU time is read, and again ps_window_ns later, when the table is read
; again, so its %CPU is its use over that time, or over its life if it
; is newer; ps's own, though, is over its life, as it sleeps meanwhile.
; procs is the table read before.
(def ps_lines ((procs (list ProcLive)) (acc (list int))) (list int)
  (let before (cpu_seen procs)
    (let z (sleep_ns (ps_window_ns))
      (let now (procs_live)
        (ps_rows now before (cpu_seen now) (names_registered) acc)))))

; The lines of procs, after acc, by what was seen before and after.
(def ps_rows ((procs (list ProcLive)) (before CpuSeen) (after CpuSeen) (names (list NameEntry)) (acc (list int))) (list int)
  (if (is_empty procs)
      (rev_onto acc (nil int))
      (match (head procs)
        ((ProcLive pid info)
          (let c (ps_cpu pid)
            (match c
              ((ProcCpu t cpu age)
                (let tenths (if (eq pid (l0s_pid)) (cpu_tenths t age) (pid_tenths before after pid age))
                  (ps_rows (tail procs) before after names
                    (rev_onto (ps_line pid info (program_name pid) cpu tenths (serves_text (names_of_pid names pid))) acc))))))))))

; What the kernel says of pid's CPU time, or nothing yet if it says none.
(def ps_cpu ((pid int)) ProcCpu
  (match (proc_cpu pid) ((None) (ProcCpu 0 -1 0)) ((Some c) c)))

; What names says: every name registered, in order, its port, the pid
; whose port it is, and that pid's program.
(def names_text () (list int)
  (append "NAME          PORT    PID  PROGRAM\n" (names_lines (names_registered) (nil int))))

; The lines of entries, after the reversed acc.
(def names_lines ((entries (list NameEntry)) (acc (list int))) (list int)
  (if (is_empty entries)
      (rev acc)
      (match (head entries)
        ((NameEntry name port owner)
          (names_lines (tail entries) (push (names_line name port owner (program_name owner)) acc))))))

; One name's line, as names shows it.
(def names_line ((name (list int)) (port int) (owner int) (program (list int))) (list int)
  (append (pad_right name 12) (append (pad_left (digits port) 6) (append (pad_left (digits owner) 7)
    (append "  " (append program "\n"))))))

; What uptime says, the kernel asked twice, a second apart; or that it
; does not say.
(def uptime_said () (list int)
  (match (cpu_usage)
    ((None) "sh: uptime: the kernel does not say\n")
    ((Some a)
      (let z (sleep_ns 1000000000)
        (match (cpu_usage)
          ((None) "sh: uptime: the kernel does not say\n")
          ((Some b) (uptime_text a b)))))))

; What dmesg prints: the kernel's log, a line to each message, as klog.l0
; says it, after a note of how many were dropped if any were.
(def dmesg_text () (list int)
  (log_lines (log_all)))

(def help_text () (list int)
  "  ls [PATH ...]   every file, or what is in each directory; programs are\n                  in /bin, services in /sbin, apps in /Applications, and\n                  the disk's volumes in /Volumes\n  cat FILE ...    show files\n  write FILE WORDS ...\n                  make FILE hold WORDS, a line; append adds the line\n  cp FROM TO      copy a file, into TO if it is a directory\n  mv FROM TO      rename or move a file\n  rm FILE ...     remove files, and directories with nothing in them\n  mkdir DIR ...   make directories, on a volume\n  cd [DIR]        make DIR the current directory, / if none: a path with\n                  no / at the start is from it; pwd says which it is\n  pwd             the current directory\n  df              each volume's size, and the room left on it\n  format VOLUME   empty a volume, /Volumes/LABEL or LABEL\n  unmount VOLUME  take a volume away, until the disk is rescanned\n  relabel VOLUME LABEL\n                  rename a volume, mounting it at /Volumes/LABEL\n  partition SECTORS [START]\n                  a new partition on the disk; says its UUID\n  mkfs UUID LABEL [fat32]\n                  a new volume on that partition, at /Volumes/LABEL;\n                  fat32 makes it FAT32, which a Raspberry Pi boots from\n  ps              the processes running: the CPU each is on, its % of\n                  one CPU, the names it serves, and what it is doing\n  names           every name registered, its port, and who serves it\n  uptime          how long the system has run, its load, and each\n                  CPU's use over a second\n  dmesg           the kernel's log: what booted and what the drivers\n                  found, each line with its time since boot\n  run NAME [ARG ...] [&]\n                  run /bin/NAME, /sbin/NAME, or the program NAME in an\n                  app; an app, by its name, as run Terminal; or the\n                  program or app at NAME if it holds a /; with ARGs in\n                  place of its own; & leaves it running, and\n                  Ctrl-C ends one that is not\n  wait PID        wait for a process to exit; Ctrl-C stops waiting\n  kill PID        end a process, unless it is a driver\n  sleep MS        sleep for MS milliseconds\n  echo WORDS      print WORDS\n  exit [STATUS]   stop the system\n  reboot          restart the board, as its reset would\n")

(def banner () (list int)
  "L0S shell, on an L0 microkernel. Type help for the commands.\n")

(def prompt () (list int) "l0s> ")

(def exited_line ((pid int) (status int)) (list int)
  (if (eq status 0)
      (nil int)
      (if (eq status (killed_status))
          (append "[pid " (append (digits pid) " interrupted]\n"))
          (append "[pid " (append (digits pid) (append " exited with " (append (digits status) "]\n")))))))

(def started_line ((pid int)) (list int)
  (append "[pid " (append (digits pid) " running]\n")))

; ------------------------------------------------------------ the shell

; What arrives on the shell's port: a line from the console, with its
; newline, or empty at the end; a Ctrl-C; a process's exit; or anything
; else.
(data Event (ELine (list int)) (EInterrupt) (EExit int int) (EOther))

(def event_of ((m Message)) Event
  (match (exit_of m)
    ((Exited pid status) (EExit pid status))
    ((NotExit)
      (match m
        ((RecvFailed) (ELine (nil int)))
        ((Message from b)
          (if (eq from 0)
              (EOther)
              (if (msg_is b (cons 3 (nil int))) (EInterrupt) (ELine (msg_text b)))))))))

(def next_event ((port int)) Event
  (event_of (port_receive port)))

; What reading the console gave: a line, with its newline, or empty at
; the end; or that the terminal has gone, its process exited.
(data Read (ReadLine (list int)) (HungUp))

; The status of a shell whose terminal has gone, as by SIGHUP.
(def hangup_status () int 129)

; A line from the console, whose process is tty. A Ctrl-C while it is
; typed shows the prompt again; the request for the line still stands.
(def read_console ((console int) (port int) (tty int)) Read
  (if (eq (port_send console (request port "r")) (Sent)) (await_line port tty) (HungUp)))

(def await_line ((port int) (tty int)) Read
  (match (next_event port)
    ((ELine line) (ReadLine line))
    ((EInterrupt) (let p (say (prompt)) (await_line port tty)))
    ((EExit pid status) (if (eq pid tty) (HungUp) (await_line port tty)))
    ((EOther) (await_line port tty))))

; The pid of the terminal at console, which answers p at once, watched on
; port, so that its exit says the terminal has gone; or -1.
(def terminal_pid ((console int) (port int)) int
  (if (not (eq (port_send console (request port "p")) (Sent)))
      -1
      (let pid (answered_by port)
        (if (eq (proc_watch pid port) (Watched)) pid -1))))

; Who sends tty to port: what comes before it, a Ctrl-C, is dropped.
(def answered_by ((port int)) int
  (match (port_receive port)
    ((RecvFailed) -1)
    ((Message from b) (if (if (gt from 0) (msg_is b "tty") false) from (answered_by port)))))

; How waiting for a process ended: it exited with a status, or a Ctrl-C
; stopped the wait.
(data Waited (WaitedExit int) (WaitStopped))

; Waits on port for pid to exit. With kill, a Ctrl-C ends it, and its exit
; is still waited for; without, a Ctrl-C stops the wait.
(def await_exit ((port int) (pid int) (kill bool)) Waited
  (match (next_event port)
    ((EExit p status) (if (eq p pid) (WaitedExit status) (await_exit port pid kill)))
    ((EInterrupt)
      (if kill
          (let k (proc_kill pid) (await_exit port pid kill))
          (WaitStopped)))
    ((ELine line) (await_exit port pid kill))
    ((EOther) (await_exit port pid kill))))

; The terminal the shell runs on: the one named by its argument, console,
; the serial line's, unless given, such as vt, the display's.
(def tty_name ((argv (list (list int)))) (list int)
  (if (is_empty argv) "console" (head argv)))

; Finds its terminal and makes it its standard input, output, and error,
; and so those of every program it runs, then reads commands from it,
; until its input ends or the terminal's process exits.
(def shell () int
  (let name (tty_name (args))
    (match (name_wait name 10000000000)
      ((NotFound) (let w (write_err (append "sh: no terminal " (append name "\n"))) 1))
      ((Found console)
        (match (tty_set console)
          ((TtyNoPort) (let w (write_err (append "sh: terminal " (append name " is gone\n"))) 1))
          ((TtySet)
            (let port (port_new)
              (let i (port_send console (request port "i"))
                (let tty (terminal_pid console port)
                  (let m (say (motd))
                    (let w (say (banner))
                      (repl console port tty))))))))))))

; Prompts, reads a command from the terminal and does it, until its
; input ends or the terminal's process exits.
(def repl ((console int) (reply int) (tty int)) int
  (let p (say (prompt))
    (match (read_console console reply tty)
      ((HungUp) (hangup_status))
      ((ReadLine line) (obey console reply tty (parse_command line))))))

; Does cmd, then reads the next, or gives the status to exit with. A
; command that looks for files or programs looks anew each time, since /
; may be a volume, which changes; a program only where one can be,
; program_paths, and a file command only what it names (file_names).
(def obey ((console int) (reply int) (tty int) (cmd Command)) int
  (match cmd
    ((CmdEnd) (let w (say "\n") 0))
    ((CmdExit status) status)
    ((CmdReboot) (let w (say (append "sh: reboot: " (append (board_restart) "\n"))) (repl console reply tty)))
    ((CmdNothing) (repl console reply tty))
    ((CmdHelp) (let w (say (help_text)) (repl console reply tty)))
    ((CmdFile op ws) (let w (say (file_command op (path_args (getcwd) op ws) (file_names op ws))) (repl console reply tty)))
    ((CmdCd dir) (let w (say (cd_text dir)) (repl console reply tty)))
    ((CmdPwd) (let w (say (append (getcwd) "\n")) (repl console reply tty)))
    ((CmdPs) (let w (say (append (ps_header) (ps_lines (procs_live) (nil int)))) (repl console reply tty)))
    ((CmdNames) (let w (say (names_text)) (repl console reply tty)))
    ((CmdUptime) (let w (say (uptime_said)) (repl console reply tty)))
    ((CmdDmesg) (let w (say (dmesg_text)) (repl console reply tty)))
    ((CmdEcho ws) (let w (say (append (unwords ws) "\n")) (repl console reply tty)))
    ((CmdSleep ms) (let s (sleep_ns (mul ms 1000000)) (repl console reply tty)))
    ((CmdWait pid) (let w (say (wait_for reply pid)) (repl console reply tty)))
    ((CmdKill pid) (let w (say (killed pid (proc_kill pid))) (repl console reply tty)))
    ((CmdBad why) (let w (say (append "sh: " (append why "\n"))) (repl console reply tty)))
    ((CmdUnknown what) (let w (say (unknown_line what (program_paths))) (repl console reply tty)))
    ((CmdRun what argv bg) (let w (run_module reply (run_name what) argv bg (program_paths)) (repl console reply tty)))))

; What cd says: nothing once dir is the current directory, else why not.
(def cd_text ((dir (list int))) (list int)
  (match (chdir dir)
    ((ChdirDone) "")
    ((ChdirNoDir) (complaint "cd" dir (chdir_why (ChdirNoDir))))
    ((ChdirNotDir) (complaint "cd" dir (chdir_why (ChdirNotDir))))
    ((ChdirBad) (complaint "cd" dir (chdir_why (ChdirBad))))))

; The name run is given as it is looked for: a name with a / is a path,
; from the current directory, a bare name a program's or an app's.
(def run_name ((what (list int))) (list int)
  (if (any_eq 47 what) (path_abs what) what))

(def wait_for ((port int) (pid int)) (list int)
  (match (proc_watch pid port)
    ((Watched)
      (match (await_exit port pid false)
        ((WaitStopped) (append "[pid " (append (digits pid) " still running]\n")))
        ((WaitedExit st) (append "[pid " (append (digits pid) (append " exited with " (append (digits st) "]\n")))))))
    ((WatchNoProc) (append "sh: no process " (append (digits pid) "\n")))
    ((WatchFull) (append "sh: cannot wait for pid " (append (digits pid) ": too many ports watch it\n")))))

; What to say once kill has answered r.
(def killed ((pid int) (r Kill)) (list int)
  (match r
    ((Killed) (nil int))
    ((KillDenied) (append "sh: pid " (append (digits pid) " is a driver\n")))
    ((KillNoProc) (append "sh: no process " (append (digits pid) "\n")))))

; What to say of a word that is not a command: if a program has that
; name, how to run it.
(def unknown_line ((what (list int)) (paths (list (list int)))) (list int)
  (if (is_empty (app_program_path what paths))
      (append "sh: no command " (append what "\n"))
      (append "sh: no command " (append what (append "; to run the program, type run " (append what "\n"))))))

; Runs the program what names, or the app's: program_found's, or else
; that of the app whose bundle what names; a path on a volume, even
; while / is the initramfs.
(def run_module ((port int) (what (list int)) (argv (list (list int))) (bg bool) (paths (list (list int)))) int
  (let path (app_program_path what paths)
    (if (is_empty path)
        (say (append "sh: no program " (append (program_path_in what paths) "\n")))
        (match (spawn_path path (if (is_empty argv) ((None (list (list int)))) (Some argv)))
          ((Spawned pid)
            (if bg
                (say (started_line pid))
                (say (exited_line pid (foreground port pid)))))
          ((SpawnNoEntry) (say (cannot_start path (SpawnNoEntry))))
          ((SpawnNotProgram) (say (cannot_start path (SpawnNotProgram))))
          ((SpawnTooBig) (say (cannot_start path (SpawnTooBig))))
          ((SpawnNoRoom) (say (cannot_start path (SpawnNoRoom))))))))

; What to say of path not started, as spawning it answered s.
(def cannot_start ((path (list int)) (s Spawn)) (list int)
  (match s
    ((SpawnNotProgram) (append "sh: " (append path " is not a program\n")))
    ((Spawned pid) (nil int))
    ((SpawnNoEntry) (cannot_start_why path s))
    ((SpawnTooBig) (cannot_start_why path s))
    ((SpawnNoRoom) (cannot_start_why path s))))

; The same, saying why as spawn_why does.
(def cannot_start_why ((path (list int)) (s Spawn)) (list int)
  (append "sh: cannot start " (append path (append ": " (append (spawn_why s) "\n")))))

; Waits for pid, which a Ctrl-C ends, and gives its status. Unwatched, as
; when too many ports watch it, it is waited for without Ctrl-C; gone,
; its status is unknown, and taken as 1.
(def foreground ((port int) (pid int)) int
  (match (proc_watch pid port)
    ((Watched)
      (match (await_exit port pid true)
        ((WaitedExit st) st)
        ((WaitStopped) (killed_status))))
    ((WatchFull) (reaped_status (wait_pid pid)))
    ((WatchNoProc) (reaped_status (wait_pid pid)))))

; The status wait_pid gave, or 1 if there was no process to wait for.
(def reaped_status ((r Reaped)) int
  (match r ((Reaped st) st) ((WaitNoProc) 1)))
