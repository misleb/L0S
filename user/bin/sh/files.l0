; files.l0 -- the shell's commands on files, as busybox has them: ls,
; cat, write, append, cp, mv, rm, mkdir, df, format, unmount, partition
; and mkfs. They make the ordinary file calls, so they work on the
; initramfs, which refuses every change, and on the volumes under
; /Volumes, whose calls the kernel sends their file server; ls, mkdir,
; df, format, unmount, partition and mkfs ask the file server themselves
; (user/lib/fs.l0), since no call lists or makes a directory or makes a
; volume. Linked into sh.

; Whether w is one of these commands.
(def is_file_command ((w (list int))) bool
  (any_eq w (split_spaces "ls cat write append cp mv rm mkdir df format unmount partition mkfs")))

; The args of op with its paths made absolute from the current directory
; cwd, as every file command takes them: all of them for ls, cat, rm,
; mkdir, cp and mv, the first for write and append, none for the commands
; of volumes, whose words are labels and numbers. ls with none lists
; the current directory unless that is /, where it lists every file.
(def path_args ((cwd (list int)) (op (list int)) (args (list (list int)))) (list (list int))
  (if (any_eq op (split_spaces "cat rm mkdir cp mv"))
      (absolute_all cwd args)
      (if (eq op "ls")
          (if (is_empty args)
              (if (eq cwd "/") args (cons cwd (nil (list int))))
              (absolute_all cwd args))
          (if (if (any_eq op (split_spaces "write append")) (not (is_empty args)) false)
              (cons (absolute_in cwd (head args)) (tail args))
              args))))

; Each of paths absolute from cwd.
(def absolute_all ((cwd (list int)) (paths (list (list int)))) (list (list int))
  (if (is_empty paths)
      paths
      (cons (absolute_in cwd (head paths)) (absolute_all cwd (tail paths)))))

; path as it is if it starts with /, else from cwd, with its . and ..
; taken out.
(def absolute_in ((cwd (list int)) (path (list int))) (list int)
  (if (if (is_empty path) false (eq (head path) 47)) path (path_resolve cwd path)))

; What the command op, with args, says once it is done: its output, and
; a line for each complaint.
(def file_command ((op (list int)) (args (list (list int))) (names (list (list int)))) (list int)
  (if (eq op "ls") (ls_text args names)
  (if (eq op "cat") (cat_all args)
  (if (eq op "write") (write_words op args false)
  (if (eq op "append") (write_words op args true)
  (file_command_more op args))))))

(def file_command_more ((op (list int)) (args (list (list int)))) (list int)
  (if (eq op "cp") (two_paths op args)
  (if (eq op "mv") (two_paths op args)
  (if (eq op "rm") (rm_all args)
  (if (eq op "mkdir") (mkdir_all args)
  (file_command_rest op args))))))

; The commands of volumes.
(def file_command_rest ((op (list int)) (args (list (list int)))) (list int)
  (if (eq op "df") (df_text args)
  (if (eq op "partition") (partition_text args)
  (if (eq op "mkfs") (mkfs_text args)
  (if (eq op "unmount") (unmount_text args)
  (format_text args))))))

; A complaint about path, a line: sh: OP: PATH: WHY.
(def complaint ((op (list int)) (path (list int)) (why (list int))) (list int)
  (append "sh: " (append op (append ": " (append path (append ": " (append why "\n")))))))

; How op is used, as a complaint.
(def usage_of ((op (list int))) (list int)
  (append "sh: usage: " (append op (append " " (append (usage_words op) "\n")))))

(def usage_words ((op (list int))) (list int)
  (if (any_eq op (split_spaces "cat rm")) "FILE..."
  (if (eq op "mkdir") "DIRECTORY..."
  (if (any_eq op (split_spaces "write append")) "FILE WORDS..."
  (if (any_eq op (split_spaces "cp mv")) "FROM TO"
  (if (any_eq op (split_spaces "format unmount")) "VOLUME"
  (if (eq op "partition") "[DISK] SECTORS [START]"
  (if (eq op "mkfs") "UUID LABEL"
  ""))))))))

; ---------------------------------------------------------------------- ls

; ls: with no path, every file of the initramfs, then of each volume;
; else what each path is, a directory's names or a file's path.
(def ls_text ((args (list (list int))) (names (list (list int)))) (list int)
  (if (is_empty args)
      (append (listing names) (volumes_listing (fs_volumes)))
      (ls_each args names (nil int))))

(def ls_each ((args (list (list int))) (names (list (list int))) (acc (list int))) (list int)
  (if (is_empty args)
      (rev acc)
      (ls_each (tail args) names (push (ls_one (normal_path (head args)) names) acc))))

; Each volume's files, by path, a line each.
(def volumes_listing ((vols (list (list int)))) (list int)
  (if (is_empty vols)
      ""
      (append (match (fs_list (head vols))
                ((FsFiles files) (indented (paths_in (head vols) files)))
                ((FsListRefused code) (complaint "ls" (head vols) (io_error code))))
              (volumes_listing (tail vols)))))

; The files' paths, in dir.
(def paths_in ((dir (list int)) (files (list FsStat))) (list (list int))
  (if (is_empty files)
      (nil (list int))
      (match (head files) ((FsStat name size) (cons (append dir (cons 47 name)) (paths_in dir (tail files)))))))

(def stat_names ((files (list FsStat))) (list (list int))
  (if (is_empty files)
      (nil (list int))
      (match (head files) ((FsStat name size) (cons name (stat_names (tail files)))))))

; Each of ws on a line of its own, indented as ls lists.
(def indented ((ws (list (list int)))) (list int)
  (rev (indented_onto ws (nil int))))

(def indented_onto ((ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws) acc (indented_onto (tail ws) (push "\n" (push (head ws) (push "  " acc))))))

; What path is: /Volumes, a volume, a file on one, on the system volume
; when / is one, or the initramfs's.
(def ls_one ((path (list int)) (names (list (list int)))) (list int)
  (if (eq path "/Volumes")
      (indented (labels_of (fs_volumes)))
      (let vol (fs_volume_of (fs_server_path path))
        (if (is_empty vol)
            (ls_root path names)
            (match (fs_list path)
              ((FsFiles files) (indented (if (eq path "/") (sort (cons "Volumes/" (stat_names files))) (stat_names files))))
              ((FsListRefused code)
                (if (eq code -9)
                    (indented (cons path (nil (list int))))
                    (complaint "ls" path (io_error code)))))))))

; Each volume's label, as a directory in /Volumes.
(def labels_of ((vols (list (list int)))) (list (list int))
  (if (is_empty vols) (nil (list int)) (cons (append (base_name (head vols)) "/") (labels_of (tail vols)))))

; A path of the initramfs: a file, or a directory's names, and in / the
; volumes' directory too.
(def ls_root ((path (list int)) (names (list (list int)))) (list int)
  (if (any_eq path names)
      (indented (cons path (nil (list int))))
      (let kids (dir_children names path)
        (if (eq path "/")
            (indented (sort (cons "Volumes/" kids)))
            (if (if (is_empty kids) (not (any_eq (append path "/") names)) false)
                (complaint "ls" path (io_error -3))
                (indented kids))))))

; The names in directory dir among the initramfs's paths, sorted, each
; directory's with a final /.
(def dir_children ((names (list (list int))) (dir (list int))) (list (list int))
  (sort (children_of names (if (eq dir "/") "/" (append dir "/")) (nil (list int)))))

(def children_of ((names (list (list int))) (prefix (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty names)
      acc
      (let r (drop_n (head names) (length prefix))
        (children_of (tail names) prefix
                     (if (if (starts_with (head names) prefix) (is_child r) false) (cons r acc) acc)))))

; Whether r, a path after its directory, names something in it: not
; empty, and holding no / but a final one.
(def is_child ((r (list int))) bool
  (if (is_empty r)
      false
      (if (eq (head r) 47)
          false
          (let inner (if (eq (head (rev r)) 47) (tail (rev r)) (rev r))
            (not (any_eq 47 inner))))))

; --------------------------------------------------------------------- cat

(def cat_all ((args (list (list int)))) (list int)
  (if (is_empty args) (usage_of "cat") (rev (cat_onto args (nil int)))))

(def cat_onto ((args (list (list int))) (acc (list int))) (list int)
  (if (is_empty args) acc (cat_onto (tail args) (push (cat_one (head args)) acc))))

; The bytes of the file at path, or why they cannot be read.
(def cat_one ((path (list int))) (list int)
  (match (read_whole path)
    ((Ok b) (bytes_to_list b))
    ((Err why) (complaint "cat" path why))))

; ------------------------------------------------------------ write, append

; write FILE WORDS..., the words spaced and a newline after them, as the
; file's contents, or added to its end.
(def write_words ((op (list int)) (args (list (list int))) (appending bool)) (list int)
  (if (is_empty args)
      (usage_of op)
      (let text (if (is_empty (tail args)) "" (append (unwords (tail args)) "\n"))
        (put_text op (head args) (bytes_from_list text) appending))))

; b written to the file at path, anew or at its end: nothing, or why not.
(def put_text ((op (list int)) (path (list int)) (b bytes) (appending bool)) (list int)
  (match (if appending (open_appending path) (open_out path))
    ((IoFailed fault why) (complaint op path why))
    ((IoOpened f) (closed op path f (file_write_bytes f b 0 (bytes_len b))))))

; f, at path, closed once w is written, and anything lost said.
(def closed ((op (list int)) (path (list int)) (f IoFile) (w int)) (list int)
  (let why (done_why (file_close f))
    (if (is_empty why) "" (complaint op path why))))

; ------------------------------------------------------------------ cp, mv

(def two_paths ((op (list int)) (args (list (list int)))) (list int)
  (if (not (eq (length args) 2))
      (usage_of op)
      (if (eq op "cp")
          (copy_file (head args) (head (tail args)))
          (move_file (head args) (head (tail args)) false))))

; The file at from copied to to, or into to if it is a directory; a
; program's copy a program too.
(def copy_file ((from (list int)) (to (list int))) (list int)
  (match (read_whole from)
    ((Err why) (complaint "cp" from why))
    ((Ok b)
      (match (copy_to from to b true)
        ((CopyFailed why) why)
        ((CopyDone at) (if (path_is_program from) (marked at) ""))))))

; What came of a copy: the path written, or the complaint.
(data Copy (CopyDone (list int)) (CopyFailed (list int)))

(def copy_to ((from (list int)) (to (list int)) (b bytes) (into bool)) Copy
  (match (open_out to)
    ((IoFailed fault why)
      (if (if into (eq fault (CreateIsDirectory)) false)
          (copy_to from (inside to from) b false)
          (CopyFailed (complaint "cp" to why))))
    ((IoOpened f)
      (let c (closed "cp" to f (file_write_bytes f b 0 (bytes_len b)))
        (if (is_empty c) (CopyDone to) (CopyFailed c))))))

; The file at path marked a program: nothing, or why not.
(def marked ((path (list int))) (list int)
  (let code (fs_chmod path true)
    (if (eq code 0) "" (complaint "cp" path (append "not marked a program: " (io_error code))))))

; The path of from's name in directory dir.
(def inside ((dir (list int)) (from (list int))) (list int)
  (append dir (cons 47 (base_name from))))

; The file at from renamed to, or moved into to if it is a directory;
; from one file system to another, copied and then removed.
(def move_file ((from (list int)) (to (list int)) (inner bool)) (list int)
  (match (rename_file from to)
    ((Done) "")
    ((NotDone fault why)
      (if (if (not inner) (eq fault (RenameIsDirectory)) false)
          (move_file from (inside to from) true)
          (if (eq fault (RenameCrossDevice))
              (let c (copy_file from to)
                (if (is_empty c) (removed "mv" from) c))
              (complaint "mv" from why))))))

; ---------------------------------------------------------------------- rm

(def rm_all ((args (list (list int)))) (list int)
  (if (is_empty args) (usage_of "rm") (rev (rm_onto args (nil int)))))

(def rm_onto ((args (list (list int))) (acc (list int))) (list int)
  (if (is_empty args) acc (rm_onto (tail args) (push (removed "rm" (head args)) acc))))

; The file at path removed, or the directory, if nothing is in it:
; nothing, or why not.
(def removed ((op (list int)) (path (list int))) (list int)
  (let why (done_why (remove_file path))
    (if (is_empty why) "" (complaint op path why))))

; ------------------------------------------------------------------- mkdir

; mkdir DIRECTORY...: each made, empty, on a volume; the initramfs makes
; none.
(def mkdir_all ((args (list (list int)))) (list int)
  (if (is_empty args) (usage_of "mkdir") (rev (mkdir_onto args (nil int)))))

(def mkdir_onto ((args (list (list int))) (acc (list int))) (list int)
  (if (is_empty args) acc (mkdir_onto (tail args) (push (made_dir (normal_path (head args))) acc))))

; The directory at path made: nothing, or why not. Off the volumes, and
; while / is the initramfs, which changes nothing, it is denied.
(def made_dir ((path (list int))) (list int)
  (if (on_initramfs path)
      (complaint "mkdir" path (io_error -4))
      (let code (fs_mkdir path)
        (if (eq code 0) "" (complaint "mkdir" path (mkdir_why code))))))

(def mkdir_why ((code int)) (list int)
  (if (eq code -4) "it is there already, or cannot be made" (io_error code)))

; ---------------------------------------------------------------------- df

; df: each volume's size, the room its files take and what is free, in
; kilobytes of its clusters, and how many files it has.
(def df_text ((args (list (list int)))) (list int)
  (if (not (is_empty args))
      "sh: usage: df\n"
      (let vols (fs_volumes)
        (if (is_empty vols)
            "sh: df: no volumes are mounted\n"
            (append (df_row "VOLUME" "SIZE" "USED" "FREE" "FILES") (df_lines vols))))))

(def df_lines ((vols (list (list int)))) (list int)
  (if (is_empty vols)
      ""
      (append (match (fs_df (head vols))
                ((FsSpace sectors clusters free files) (df_line (head vols) clusters free files))
                ((FsSpaceRefused code) (complaint "df" (head vols) (io_error code))))
              (df_lines (tail vols)))))

; A volume's line: clusters of data, free, of 4 KB each.
(def df_line ((vol (list int)) (clusters int) (free int) (files int)) (list int)
  (df_row vol (kilobytes clusters) (kilobytes (sub clusters free)) (kilobytes free) (digits files)))

(def kilobytes ((clusters int)) (list int)
  (append (digits (mul clusters 4)) "K"))

(def df_row ((a (list int)) (b (list int)) (c (list int)) (d (list int)) (e (list int))) (list int)
  (append "  " (append (pad_right a 16) (append (pad_left b 8) (append (pad_left c 8) (append (pad_left d 8) (append (pad_left e 7) "\n")))))))

; ------------------------------------------------------------------ format

; format VOLUME: the volume, /Volumes/LABEL or its label, emptied.
(def format_text ((args (list (list int)))) (list int)
  (if (not (eq (length args) 1))
      (usage_of "format")
      (let vol (volume_named (head args))
        (if (not (eq (fs_volume_of vol) vol))
            (complaint "format" (head args) "not a volume")
            (if (eq vol (fs_system_volume))
                (complaint "format" vol "it is /, the system volume")
                (formatted vol (fs_format vol)))))))

; unmount VOLUME: the volume, /Volumes/LABEL or its label, taken away.
(def unmount_text ((args (list (list int)))) (list int)
  (if (not (eq (length args) 1))
      (usage_of "unmount")
      (let vol (volume_named (head args))
        (if (not (eq (fs_volume_of vol) vol))
            (complaint "unmount" (head args) "not a volume")
            (if (eq vol (fs_system_volume))
                (complaint "unmount" vol "it is /, the system volume")
                (unmounted vol (fs_unmount_volume vol)))))))

; What came of unmounting vol: nothing, or why it failed.
(def unmounted ((vol (list int)) (code int)) (list int)
  (if (eq code 0)
      ""
      (complaint "unmount" vol (if (eq code -4) "a file is open" (if (eq code -3) "no such volume" (io_error code))))))

; The volume w names: a path, or a label.
(def volume_named ((w (list int))) (list int)
  (if (starts_with w "/") (normal_path w) (append "/Volumes/" w)))

; --------------------------------------------------------------- partition

; partition [DISK] SECTORS [START]: a new partition on DISK, disk0 unless
; named, from START or where it first fits, its UUID said, for mkfs.
(def partition_text ((args (list (list int)))) (list int)
  (if (if (is_empty args) false (is_disk_word (head args)))
      (partition_of (head args) (tail args))
      (partition_of "disk0" args)))

; Whether w names a disk: disk and a number, as disk1.
(def is_disk_word ((w (list int))) bool
  (if (starts_with w "disk") (if (gt (length w) 4) (is_number (drop_n w 4)) false) false))

; partition's sectors and start, of the disk disk.
(def partition_of ((disk (list int)) (args (list (list int)))) (list int)
  (if (if (is_empty args) true (gt (length args) 2))
      (usage_of "partition")
      (if (not (if (is_number (head args)) (if (is_empty (tail args)) true (is_number (head (tail args)))) false))
          (complaint "partition" (head args) "sectors are a number")
          (partitioned disk (fs_partition_on (port_new) disk (int_prefix (head args) 0)
                                             (if (is_empty (tail args)) -1 (int_prefix (head (tail args)) 0)))))))

; What partition said of disk: the new partition's UUID, a line, or why
; not.
(def partitioned ((disk (list int)) (p FsPartition)) (list int)
  (match p
    ((FsPartitioned u) (append (uuid_text u) "\n"))
    ((FsPartitionRefused code why) (complaint "partition" disk (if (is_empty why) (io_error code) why)))))

; mkfs UUID LABEL: a new, empty volume on the partition with that UUID,
; mounted at /Volumes/LABEL.
(def mkfs_text ((args (list (list int)))) (list int)
  (if (not (eq (length args) 2))
      (usage_of "mkfs")
      (match (uuid_of_text (head args))
        ((None) (complaint "mkfs" (head args) "not a UUID"))
        ((Some u)
          (match (fs_mkfs_on (port_new) u (head (tail args)))
            ((FsMade label) "")
            ((FsMkfsRefused code why) (complaint "mkfs" (head args) (if (is_empty why) (io_error code) why))))))))

; What came of formatting vol: nothing, or why it failed.
(def formatted ((vol (list int)) (code int)) (list int)
  (if (eq code 0)
      ""
      (complaint "format" vol (if (eq code -4) "a file on it is open" (if (eq code -3) "no such volume" (io_error code))))))
