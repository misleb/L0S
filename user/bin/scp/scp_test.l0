; scp_test.l0 -- scp's options and places, and the scp protocol's lines
; and quoting.

; A place as text: user|host|path for one on a host, the path for one
; here.
(def place_text ((p Place)) (list int)
  (match p
    ((Remote u h path) (join_with "|" (cons u (cons h (cons path (nil (list int)))))))
    ((Local path) path)))

; The options of the words of s, as text, or why not.
(def opts_text ((s (list int))) (list int)
  (match (opts_of (split_spaces s))
    ((Err why) (append "! " why))
    ((Ok o) (join_with " " (cons (digits (.port o)) (cons (.key o) (cons (place_text (.from o)) (cons (place_text (.to o)) (nil (list int))))))))))

; A colon before any / makes a place remote; after one, a path here.
(def test_places () int
  (add (check_str "remote" (place_text (place_of "ann@h:dir/f")) "ann|h|dir/f")
       (add (check_str "no user" (place_text (place_of "h:f")) "|h|f")
            (check_str "local" (place_text (place_of "/Volumes/data/a:b")) "/Volumes/data/a:b"))))

(def test_opts () int
  (add (check_str "up" (opts_text "-P 2222 /etc/motd ann@h:up.txt") "2222  /etc/motd ann|h|up.txt")
       (check_str "down" (opts_text "-i /k ann@h:kept.txt /Volumes/data/") "22 /k ann|h|kept.txt /Volumes/data/")))

(def test_opts_refused () int
  (add (check_str "both here" (opts_text "/a /b") "! one of the two must be [USER@]HOST:PATH, the other a file here")
       (add (check_str "no user" (opts_text "/a h:b") "! a user is needed, as USER@HOST:PATH, and a path")
            (add (check_str "one" (opts_text "a@h:b") (append "! " (usage)))
                 (check_str "bad port" (opts_text "-P x /a a@h:b") "! not a port: x")))))

; ---------------------------------------------------------------- the protocol

(def test_c_line () int
  (add (check_str "made" (c_line 12 "up.txt") "C0644 12 up.txt\n")
       (match (c_line_of "C0600 4321 kept.txt")
         ((Ok cl) (add (check_int "size" (.size cl) 4321) (check_str "name" (.name cl) "kept.txt")))
         ((Err why) (fail_because "read" why)))))

(def test_c_line_refused () int
  (match (c_line_of "D0755 0 dir")
    ((Ok cl) (fail_because "D" "read as a file"))
    ((Err why) (check_str "why" why "the host sent something not a file: D0755 0 dir"))))

; A ' in a path is closed, escaped and opened again.
(def test_quoted () int
  (add (check_str "plain" (quoted "a b") "'a b'")
       (check_str "quote" (quoted "it's") "'it'\\''s'")))

; A destination ending in / takes the host's name for the file.
(def test_local_path () int
  (add (check_str "file" (local_path "/Volumes/data/x" "kept.txt") "/Volumes/data/x")
       (check_str "dir" (local_path "/Volumes/data/" "kept.txt") "/Volumes/data/kept.txt")))

; Under an operating system there is no terminal or network, nor are
; l0 test's arguments a copy.
(def test_no_network () int
  (check_int "fails" (scp) 1))
