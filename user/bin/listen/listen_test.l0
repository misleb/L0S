; listen_test.l0 -- listen's arguments and its refusals, without the
; model: what is asked, and no model.

; The ask as text, to compare.
(def ask_text ((a Ask)) (list int)
  (match a
    ((AskWrong why) (append "wrong: " why))
    ((AskHear fs m t) (append (unwords fs) (append " by " (append m (if t " timed" "")))))))

; Files alone are heard by the model in /etc.
(def test_ask_files () int
  (check_str "files" (ask_text (ask_of (cons "a.wav" (cons "b.wav" (nil (list int)))))) "a.wav b.wav by /Volumes/data/speech/whistle.cact"))

; -t, and a model of its own.
(def test_ask_timed () int
  (check_str "timed" (ask_text (ask_of (cons "-t" (cons "-m" (cons "m.cact" (cons "a.wav" (nil (list int)))))))) "a.wav by m.cact timed"))

; No file is told how to ask, with a model or without.
(def test_ask_wrong () int
  (add (check_str "none" (ask_text (ask_of (nil (list int)))) "wrong: usage: listen [-t] [-m MODEL] FILE.wav...")
       (check_str "model only" (ask_text (ask_of (cons "-m" (cons "m.cact" (nil (list int)))))) "wrong: usage: listen [-t] [-m MODEL] FILE.wav...")))

; A model that is not there is said, and listen fails.
(def test_no_model () int
  (check_int "fails" (listen_main (cons "-m" (cons "/nonexistent.cact" (cons "a.wav" (nil (list int)))))) 1))
