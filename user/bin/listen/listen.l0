; listen.l0 -- a WAV file's speech as text, heard by Whistle
; (speech/transcribe.l0), on the board itself:
;
;   listen FILE.wav...             each file's text, a line each, on
;                                  standard output
;   listen -m MODEL FILE.wav...    heard by the model at MODEL, not
;                                  /Volumes/data/speech/whistle.cact,
;                                  where the installer puts it
;   listen -t ...                  and on standard error how long the
;                                  model took to load and each file to
;                                  hear
;
; The model is loaded once, for every file. A file is 16 kHz, one
; channel of 16 bits, 0.1 s to 5 minutes, heard in windows of 30 s or
; less past 30 s (transcribe.l0). A failure is said on standard error,
; and it exits 1, after hearing the files before it.

; What ends listen, said as listen on standard error: 1.
(def complain ((why (list int))) int (complain_as "listen" why))

; Where the model is if no MODEL is given.
(def listen_model () (list int) "/Volumes/data/speech/whistle.cact")

; What the arguments ask: files heard, by the model at a path, and
; whether timed; or why they ask nothing.
(data Ask (AskHear (list (list int)) (list int) bool) (AskWrong (list int)))

; The arguments as is asked: -t, then -m MODEL, then the files.
(def ask_of ((as (list (list int)))) Ask
  (let (timed (and (not (is_empty as)) (eq (head as) "-t"))
        r1 (if timed (tail as) as)
        given (and (ge (length r1) 2) (eq (head r1) "-m"))
        files (if given (tail (tail r1)) r1))
    (if (is_empty files)
        (AskWrong "usage: listen [-t] [-m MODEL] FILE.wav...")
        (AskHear files (if given (nth r1 1) (listen_model)) timed))))

; What listen does with its arguments: the model loaded, then each file
; heard.
(def listen_main ((as (list (list int)))) int
  (match (ask_of as)
    ((AskWrong why) (complain why))
    ((AskHear files model timed)
      (let t0 (clock_ns)
        (match (read_whole model)
          ((Err why) (complain (append "the model, " (append model (append ": " why)))))
          ((Ok mb)
            (match (whistle_listener mb)
              ((Err why) (complain (append model (append ": " why))))
              ((Ok l)
                (let n (if timed (note_as "listen" (append "model loaded in " (append (digits (div (sub (clock_ns) t0) 1000000)) " ms"))) 0)
                  (hear_all l files timed))))))))))

; Each of files heard by l and its text written, until one fails.
(def hear_all ((l Listener) (files (list (list int))) (timed bool)) int
  (if (is_empty files)
      0
      (let path (head files)
        (match (read_whole path)
          ((Err why) (complain (append path (append ": " why))))
          ((Ok wb)
            (match (wav_speech wb)
              ((Err why) (complain (append path (append ": " why))))
              ((Ok xs)
                (let (t0 (clock_ns)
                      text (whistle_transcribe l xs)
                      t1 (clock_ns)
                      w (write_line text)
                      n (if timed (note_as "listen" (append path (append ": " (times_text (array_len xs) (sub t1 t0))))) 0))
                  (hear_all l (tail files) timed)))))))))

; How long a clip of n samples is, and took to hear, in milliseconds.
(def times_text ((n int) (heard int)) (list int)
  (append (digits (div (mul n 1000) 16000)) (append " ms of speech heard in " (append (digits (div heard 1000000)) " ms"))))

; listen's arguments, done.
(def listen () int (listen_main (args)))
