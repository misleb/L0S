; speak_test.l0 -- tests of speak: its arguments, its samples, and that
; with no files and no server it fails.

; The ask as words: exact, timed, voice, dict, out, then the text.
(def t_ask ((as (list int))) (list int)
  (match (speak_ask_of (split_spaces as))
    ((SpeakWrong why) why)
    ((SpeakAsk e t v d out ws) (unwords (cons (if e "exact" "noisy") (cons (if t "timed" "untimed") (cons v (cons d (cons (if (is_empty out) "aloud" out) ws)))))))))

(def test_ask_defaults () int
  (check_str "defaults" (t_ask "Hello there.")
             "noisy untimed /Volumes/data/speech/en_US-ljspeech-medium.onnx /Volumes/data/speech/cmudict.dict aloud Hello there."))

(def test_ask_options () int
  (check_str "options" (t_ask "-0 -t -v /v.onnx -d /c.dict -o /o.wav Hi")
             "exact timed /v.onnx /c.dict /o.wav Hi"))

(def test_ask_no_text () int
  (add (check_str "none" (t_ask "-0") (speak_usage))
       (check_str "no file" (t_ask "-o") (speak_usage))))

; Samples as 16-bit PCM bytes.
(def t_pcm ((vs (list int))) bytes
  (bytes_from_list (rev (t_pcm_from vs (nil int)))))
(def t_pcm_from ((vs (list int)) (acc (list int))) (list int)
  (if (is_empty vs) acc (t_pcm_from (tail vs) (speak_push_sample (head vs) acc))))

; A PCM's samples as words.
(def t_samples ((b bytes)) (list int)
  (unwords (t_samples_from b 0 (div (bytes_len b) 2))))
(def t_samples_from ((b bytes) (k int) (n int)) (list (list int))
  (if (ge k n) (nil (list int)) (cons (digits (speak_sample b k)) (t_samples_from b (add k 1) n))))

; Samples made and read back.
(def test_samples () int
  (check_str "back" (t_samples (t_pcm (cons 100 (cons -300 (cons 20 (nil int)))))) "100 -300 20"))

(def test_pcm_normalized () int
  (let a (Vt 2 1 (bytes_set_f32 (bytes_set_f32 (vt_zero_bytes 2) 0 0.5) 4 -0.25))
    (check_str "loudest full scale" (t_samples (piper_pcm a)) "32767 -16384")))

(def test_pcm_silence () int
  (check_str "silent" (t_samples (piper_pcm (vt_zeros 2 1))) "0 0"))

; Under an operating system there is no voice on a data volume.
(def test_speak_needs_voice () int
  (check_int "status" (speak_main (split_spaces "Hello.")) 1))
