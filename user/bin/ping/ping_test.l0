(def test_pong_line () int
  (add (check_str "reply" (pong_line (message_new 2 "ping 1")) "ping: echo (pid 2) said ping 1\n")
       (check_str "none" (pong_line (RecvFailed)) "ping: no reply\n")))

(def test_is_pong () int
  (add (check_bool "match" (is_pong (message_new 2 "ping 4") 4) true)
       (check_bool "other" (is_pong (message_new 2 "ping 4") 5) false)))

(def test_count () int
  (add (check_true "default" (eq (count_of (nil (list int))) (Some 3)))
       (add (check_true "given" (eq (count_of (split_spaces "12")) (Some 12)))
            (check_true "not a number" (eq (count_of (split_spaces "x")) ((None int)))))))
