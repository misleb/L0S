; sound_test.l0 -- what sound's arguments ask; with no kernel, no server.

(def ask_text ((a SoundAsk)) (list int)
  (match a
    ((SoundList) "list")
    ((SoundReload) "reload")
    ((SoundVolume id pct) (unwords (cons "volume" (numbers_words (cons id (cons pct (nil int)))))))
    ((SoundWrong why) (append "wrong: " why))))

(def test_ask () int
  (add (check_str "list" (ask_text (sound_ask_of (nil (list int)))) "list")
       (add (check_str "reload" (ask_text (sound_ask_of (split_spaces "reload"))) "reload")
            (add (check_str "volume" (ask_text (sound_ask_of (split_spaces "volume 1"))) "volume 1 -1")
                 (add (check_str "set" (ask_text (sound_ask_of (split_spaces "volume 1 40"))) "volume 1 40")
                      (check_str "wrong" (ask_text (sound_ask_of (split_spaces "volume x"))) (append "wrong: " (sound_usage))))))))

; Under an operating system there is no audio server.
(def test_entry () int
  (check_int "fails" (sound_main (nil (list int))) 1))
