; sound.l0 -- the audio server's devices and settings, from a shell
; (proto/audio.l0):
;
;   sound                   the devices, a line each: ID in|out NAME
;                           CHANS RATES, and default for the default of
;                           each kind; no devices if there are none
;   sound reload            /etc/audio read again by the server
;   sound volume ID [PCT]   device ID's volume, set to PCT first if given
;
; A failure is said on standard error, and it exits 1.

; What ends sound, said as sound on standard error: 1.
(def complain ((why (list int))) int (complain_as "sound" why))

; What the arguments ask: the devices, a reload, or a volume, its device
; and -1 or the percent to set; or why they ask nothing.
(data SoundAsk (SoundList) (SoundReload) (SoundVolume int int) (SoundWrong (list int)))

; The usage.
(def sound_usage () (list int) "usage: sound | sound reload | sound volume ID [PCT]")

; The arguments as is asked.
(def sound_ask_of ((as (list (list int)))) SoundAsk
  (let n (length as)
    (if (eq n 0) (SoundList)
        (and (eq n 1) (eq (head as) "reload")) (SoundReload)
        (and (or (eq n 2) (eq n 3)) (eq (head as) "volume"))
        (match (word_numbers (tail as))
          ((None) (SoundWrong (sound_usage)))
          ((Some ns) (SoundVolume (head ns) (nth_or ns 1 -1))))
        (SoundWrong (sound_usage)))))

; What sound does with its arguments.
(def sound_main ((as (list (list int)))) int
  (match (sound_ask_of as)
    ((SoundWrong why) (complain why))
    ((SoundList) (with_audio (SoundList)))
    ((SoundReload) (with_audio (SoundReload)))
    ((SoundVolume id pct) (with_audio (SoundVolume id pct)))))

; The server found, and what is asked done.
(def with_audio ((ask SoundAsk)) int
  (match (audio_open)
    ((NoAudio why) (complain why))
    ((Audio port rp pid)
      (let a (Audio port rp pid)
        (match ask
          ((SoundWrong why) (complain why))
          ((SoundList) (listed (audio_reply a "devices")))
          ((SoundReload) (done (audio_reload a)))
          ((SoundVolume id pct)
            (match (audio_volume a id pct)
              ((Err why) (complain why))
              ((Ok v) (let w (write_line (append "volume " (digits v))) 0)))))))))

; The devices answer written; nothing there said so.
(def listed ((r (list int))) int
  (if (starts_with r "error: ") (complain (drop r 7))
      (is_empty r) (let w (write_line "no devices") 0)
      (let w (write_str r) 0)))

; 0 if why is empty, else said.
(def done ((why (list int))) int (if (is_empty why) 0 (complain why)))
