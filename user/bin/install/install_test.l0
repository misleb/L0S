; install_test.l0 -- tests of what install copies, and where.

(def test_volume_named () int
  (add (check_str "a label" (volume_named "System") "/Volumes/System")
       (check_str "a path" (volume_named "/Volumes/System/") "/Volumes/System")))

; /, /Volumes and what is in it are not copied; everything else is, in
; order.
(def test_to_copy () int
  (check_strs "the rest"
              (to_copy (split_spaces "/ /bin/ /bin/sh /Volumes/ /Volumes/data/ /Volumes/data/a /etc/motd"))
              (split_spaces "/bin/ /bin/sh /etc/motd")))

(def test_target () int
  (add (check_str "a directory" (target "/Volumes/S" "/bin/") "/Volumes/S/bin")
       (check_str "a file" (target "/Volumes/S" "/bin/sh") "/Volumes/S/bin/sh")))

(def test_done_line () int
  (add (check_str "with its UUID" (done_line "/Volumes/S" 30 "018f-x")
                  "install: 30 files copied to /Volumes/S; boot it with root=018f-x\n")
       (check_str "none" (done_line "/Volumes/S" 1 "") "install: 1 files copied to /Volumes/S\n")))

(def test_uuid_of () int
  (check_str "S's" (uuid_of (cons (MountInfo "/" 0 "") (cons (MountInfo "/Volumes/S" 4 "u-1") (nil MountInfo))) "/Volumes/S") "u-1"))

; Under an operating system there is no kernel, so no volume to copy to.
(def test_no_volume () int
  (add (check_int "not a volume" (install_on "/etc") 1)
       (check_int "not mounted" (install_on "/Volumes/S") 1)))

; ------------------------------------------------------------------ --boot

; Only the files directly in /boot.
(def test_boot_files () int
  (check_strs "those of /boot"
              (boot_files "/boot/" (split_spaces "/bin/ /bin/sh /boot/ /boot/l0.img /boot/config.txt /boot/x/ /boot/x/y /bootx"))
              (split_spaces "/boot/l0.img /boot/config.txt")))

(def test_boot_dir () int
  (add (check_str "given" (boot_dir "/etc/boot") "/etc/boot/")
       (check_str "a final /" (boot_dir "/etc/boot/") "/etc/boot/")))

(def test_entry_name () int
  (add (check_str "a directory" (entry_name "/bin/") "bin")
       (check_str "a file" (entry_name "/etc/motd") "etc/motd")))

(def test_boot_line () int
  (add (check_str "said" (boot_line "/Volumes/BOOT" 3 70)
                  "install: 3 boot files and input.bin, an initramfs of 70 files, written to /Volumes/BOOT\n")
       (check_int "files" (file_count (split_spaces "/bin/ /bin/sh /etc/motd")) 2)))

; The archive of a directory and a file, here on the host, read back as
; the kernel reads an initramfs.
(def test_archive () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "a buffer" why))
    ((IoOpened f)
      (match (archive_to f (split_spaces "tools/ tools/deadline") 0)
        ((ArchiveStopped why) (fail_because "written" why))
        ((Archived n)
          (let b (bytes_from_list (buffer_contents f))
            (match (parse_initramfs b)
              ((Err why) (fail_because "read back" why))
              ((Ok es)
                (add (check_int "its size" n (bytes_len b))
                     (add (check_int "two" (array_len es) 2)
                          (check_str "the file's" (entry_path (array_get es 1)) "/tools/deadline")))))))))))

(def test_archive_missing () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "a buffer" why))
    ((IoOpened f)
      (match (archive_to f (split_spaces "/no/such/file") 0)
        ((ArchiveStopped why) (check_str "why" why "/no/such/file: no such file"))
        ((Archived n) (fail_because "stopped" "written"))))))

(def test_has_dtb () int
  (add (check_bool "C1's" (has_dtb (split_spaces "config.txt bcm2712-rpi-5-b.dtb")) true)
       (add (check_bool "D0's" (has_dtb (split_spaces "bcm2712d0-rpi-5-b.dtb")) true)
            (check_bool "none" (has_dtb (split_spaces "config.txt bcm2711-rpi-4-b.dtb overlays/")) false))))

(def test_dtb_note () int
  (add (check_str "has one" (dtb_note "/Volumes/B" true) "")
       (check_str "none" (dtb_note "/Volumes/B" false)
         "install: /Volumes/B: no bcm2712-rpi-5-b.dtb; copy the Pi 5's device trees there from Raspberry Pi OS's boot partition\n")))

; Under an operating system there is no kernel, so no volume to write.
(def test_boot_no_volume () int
  (check_int "not mounted" (boot_on "/Volumes/BOOT" "/boot/") 1))
