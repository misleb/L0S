; install_test.l0 -- tests of what install copies, and where.

(def test_volume_named () int
  (add (check_str "a label" (volume_named "System") "/Volumes/System")
       (check_str "a path" (volume_named "/Volumes/System/") "/Volumes/System")))

; /, /Volumes and what is in it are not copied; everything else is, in
; order.
(def test_to_copy () int
  (check_strs "the rest"
              (to_copy (split_spaces "/ /bin/ /bin/sh /Volumes/ /Volumes/data/ /Volumes/data/a /etc/motd"))
              (split_spaces "/bin/ /bin/sh /etc/motd")))

(def test_target () int
  (add (check_str "a directory" (target "/Volumes/S" "/bin/") "/Volumes/S/bin")
       (check_str "a file" (target "/Volumes/S" "/bin/sh") "/Volumes/S/bin/sh")))

(def test_done_line () int
  (add (check_str "with its UUID" (done_line "/Volumes/S" 30 "018f-x")
                  "install: 30 files copied to /Volumes/S; boot it with root=018f-x\n")
       (check_str "none" (done_line "/Volumes/S" 1 "") "install: 1 files copied to /Volumes/S\n")))

(def test_uuid_of () int
  (check_str "S's" (uuid_of (cons (MountInfo "/" 0 "") (cons (MountInfo "/Volumes/S" 4 "u-1") (nil MountInfo))) "/Volumes/S") "u-1"))

; Under an operating system there is no kernel, so no volume to copy to.
(def test_no_volume () int
  (add (check_int "not a volume" (install_on "/etc") 1)
       (check_int "not mounted" (install_on "/Volumes/S") 1)))
