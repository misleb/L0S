; install_test.l0 -- tests of what install copies, and where.

; /, /Volumes and what is in it are not copied; everything else is, in
; order.
(def test_to_copy () int
  (check_strs "the rest"
              (to_copy (split_spaces "/ /bin/ /bin/sh /Volumes/ /Volumes/data/ /Volumes/data/a /etc/motd"))
              (split_spaces "/bin/ /bin/sh /etc/motd")))

; install VOLUME leaves /boot and what is in it out too, but not a path
; that only begins with boot.
(def test_to_install () int
  (check_strs "the rest"
              (to_install (split_spaces "/ /boot/ /boot/l0.img /boot/config.txt /bin/ /bin/sh /bootstrap /Volumes/ /Volumes/a"))
              (split_spaces "/bin/ /bin/sh /bootstrap")))

(def test_target () int
  (add (check_str "a directory" (target "/Volumes/S" "/bin/") "/Volumes/S/bin")
       (check_str "a file" (target "/Volumes/S" "/bin/sh") "/Volumes/S/bin/sh")))

(def test_done_line () int
  (add (check_str "with its UUID" (done_line "/Volumes/S" 30 "018f-x")
                  "install: 30 files copied to /Volumes/S; boot it with root=018f-x\n")
       (check_str "none" (done_line "/Volumes/S" 1 "") "install: 1 files copied to /Volumes/S\n")))

; Under an operating system there is no kernel, so no volume to copy to.
(def test_no_volume () int
  (add (check_int "not a volume" (install_on "/etc") 1)
       (check_int "not mounted" (install_on "/Volumes/S") 1)))

; ------------------------------------------------------------------ --boot

; Only the files directly in /boot.
(def test_boot_files () int
  (check_strs "those of /boot"
              (boot_files "/boot/" (split_spaces "/bin/ /bin/sh /boot/ /boot/l0.img /boot/config.txt /boot/x/ /boot/x/y /bootx"))
              (split_spaces "/boot/l0.img /boot/config.txt")))

(def test_boot_dir () int
  (add (check_str "given" (boot_dir "/etc/boot") "/etc/boot/")
       (check_str "a final /" (boot_dir "/etc/boot/") "/etc/boot/")))

(def test_entry_name () int
  (add (check_str "a directory" (entry_name "/bin/") "bin")
       (check_str "a file" (entry_name "/etc/motd") "etc/motd")))

(def test_boot_line () int
  (add (check_str "said" (boot_line "/Volumes/BOOT" 3 70)
                  "install: 3 boot files and input.bin, an initramfs of 70 files, written to /Volumes/BOOT\n")
       (check_int "files" (file_count (split_spaces "/bin/ /bin/sh /etc/motd")) 2)))

; The archive of a directory and a file, here on the host, read back as
; the kernel reads an initramfs.
(def test_archive () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "a buffer" why))
    ((IoOpened f)
      (match (archive_to f (split_spaces "tools/ tools/deadline") 0)
        ((ArchiveStopped why) (fail_because "written" why))
        ((Archived n)
          (let b (bytes_from_list (buffer_contents f))
            (match (parse_initramfs b)
              ((Err why) (fail_because "read back" why))
              ((Ok es)
                (add (check_int "its size" n (bytes_len b))
                     (add (check_int "two" (array_len es) 2)
                          (check_str "the file's" (.path (array_get es 1)) "/tools/deadline")))))))))))

(def test_archive_missing () int
  (match (open_out_buffer)
    ((IoFailed fault why) (fail_because "a buffer" why))
    ((IoOpened f)
      (match (archive_to f (split_spaces "/no/such/file") 0)
        ((ArchiveStopped why) (check_str "why" why "/no/such/file: no such file"))
        ((Archived n) (fail_because "stopped" "written"))))))

(def test_has_dtb () int
  (add (check_bool "C1's" (has_dtb (split_spaces "config.txt bcm2712-rpi-5-b.dtb")) true)
       (add (check_bool "D0's" (has_dtb (split_spaces "bcm2712d0-rpi-5-b.dtb")) true)
            (check_bool "none" (has_dtb (split_spaces "config.txt bcm2711-rpi-4-b.dtb overlays/")) false))))

(def test_dtb_note () int
  (add (check_str "has one" (dtb_note "/Volumes/B" true) "")
       (check_str "none" (dtb_note "/Volumes/B" false)
         "install: /Volumes/B: no bcm2712-rpi-5-b.dtb; copy the Pi 5's device trees there from Raspberry Pi OS's boot partition\n")))

; Under an operating system there is no kernel, so no volume to write.
(def test_boot_no_volume () int
  (check_int "not mounted" (boot_on "/Volumes/BOOT" "/boot/" "" "") 1))

; Under an operating system no root is mounted either: refused before
; anything is written.
(def test_boot_no_root () int
  (check_int "not mounted" (boot_rooted "/Volumes/BOOT" "/boot/" "root") 1))

; What install --boot's words ask, as text: the volume, FROM and the
; root, or bad.
(def boot_words_text ((w (list int))) (list int)
  (match (boot_words (split_spaces w))
    ((BootBad) "bad")
    ((BootArgs v f r) (unwords (cons v (cons f (cons (if (is_empty r) "-" r) (nil (list int)))))))))

(def test_boot_words () int
  (add (check_str "the volume" (boot_words_text "BOOT") "BOOT /boot -")
       (add (check_str "and FROM" (boot_words_text "BOOT /etc/boot") "BOOT /etc/boot -")
            (check_str "a root after" (boot_words_text "BOOT --root root") "BOOT /boot root"))))

(def test_boot_words_root_anywhere () int
  (add (check_str "between" (boot_words_text "BOOT --root root /etc/boot") "BOOT /etc/boot root")
       (check_str "first" (boot_words_text "--root root BOOT") "BOOT /boot root")))

(def test_boot_words_bad () int
  (add (check_str "no volume" (boot_words_text "--root root") "bad")
       (add (check_str "no root after --root" (boot_words_text "BOOT --root") "bad")
            (add (check_str "two roots" (boot_words_text "BOOT --root a --root b") "bad")
                 (check_str "three words" (boot_words_text "BOOT a b") "bad")))))

(def test_root_why () int
  (add (check_str "the boot volume" (root_why "/Volumes/B" "/Volumes/B" "U")
         "/Volumes/B: the boot volume; the root is another, which install VOLUME fills")
       (check_str "not mounted" (root_why "/Volumes/B" "/Volumes/R" "U") "/Volumes/R: no such volume is mounted")))

(def test_root_line () int
  (check_str "said" (root_line "/Volumes/B" "/Volumes/R" "U") "install: /Volumes/B/cmdline.txt boots /Volumes/R, root=U\n"))

; ------------------------------------------------------------------- --net

; What net_words makes of w: the mode, the system and boot volumes, - for
; none, and progress if asked; or bad.
(def net_words_text ((w (list int))) (list int)
  (match (net_words (split_spaces w))
    ((NetBad) "bad")
    ((NetArgs a)
      (let (sys (.system a)
            boot (.boot a)
            order (if (is_empty (.order a)) (nil (list int)) (cons (.order a) (nil (list int))))
            rest (if (.progress a) (cons "progress" order) order))
        (unwords (cons (match (.mode a) ((RelFresh) "fresh") ((RelUpdate) "update"))
                   (cons (if (is_empty sys) "-" sys) (cons (if (is_empty boot) "-" boot) rest))))))))

(def test_net_words_order () int
  (add (check_str "sd,net" (net_words_text "fresh --boot B --boot-order sd,net S") "fresh S B 0xf21")
       (add (check_str "another order" (net_words_text "fresh --boot-order net S") "bad")
            (check_str "an unknown option" (net_words_text "update --force") "bad"))))

(def test_net_order_line () int
  (check_str "the image's"
    (net_order_line (RelVols "/Volumes/S" "/Volumes/bootfs" "/Volumes/data" "0xf21") false)
    "install: BOOT_ORDER=0xf21 in /Volumes/bootfs/pieeprom.upd, from the release image's configuration, as the firmware did not answer; the bootloader flashes it as the board next boots from the card\n"))

(def test_net_words () int
  (add (check_str "fresh" (net_words_text "fresh System") "fresh System -")
       (add (check_str "fresh, a boot volume first" (net_words_text "fresh --boot bootfs System") "fresh System bootfs")
            (check_str "update, nothing named" (net_words_text "update") "update - -"))))

(def test_net_words_progress () int
  (add (check_str "last" (net_words_text "update --progress") "update - - progress")
       (check_str "between" (net_words_text "fresh --progress --boot B S") "fresh S B progress")))

; A fetch the proxy went quiet on names its file and how much came: 2
; of the entry's 3 bytes; with no file, the plain line.
(def test_net_quiet_text () int
  (let (e (RelEntry "boot" 3 "" false "config.txt")
        s (RelStep e "/Volumes/bootfs/config.txt" (RelWrite))
        r (release_run_new (conn) "t" "pi5" (nil RelStep))
        f (RelFile (IoFile 2) (sha256_new) 2 200 s))
    (add (check_str "fetching" (net_quiet_text (.cur r (Some f)))
           "the proxy said nothing for 30 s, fetching boot/config.txt after 2 of 3 bytes")
         (check_str "none" (net_quiet_text r) "the proxy said nothing for 30 s"))))

; The step changes as a file is done or a megabyte comes, not between.
(def test_net_step () int
  (let r (release_run_new (conn) "t" "virt" (nil RelStep))
    (add (check_int "start" (net_step r) 0)
         (add (check_int "under a megabyte" (net_step (.got r 999999)) 0)
              (check_int "a file and 2 MB" (net_step (.files (.got r 2500000) 1)) 1000002)))))

(def test_net_words_bad () int
  (add (check_str "fresh needs a volume" (net_words_text "fresh") "bad")
       (add (check_str "no mode" (net_words_text "System") "bad")
            (add (check_str "two volumes" (net_words_text "update A B") "bad")
                 (check_str "--boot with none" (net_words_text "update --boot") "bad")))))

; An update with no volume named updates /, and finds its boot volume by
; its cmdline.txt; under an operating system there is no system volume,
; and no volume mounted.
(def test_net_vols () int
  (let v (net_vols (NetAsk (RelUpdate) "" "" false ""))
    (add (check_str "system" (.system v) "")
         (check_str "data" (.store v) "/Volumes/data"))))

(def test_net_done_text () int
  (check_str "said"
    (net_done_text (RelFresh) (RelVols "/Volumes/System" "" "/Volumes/data" "")
      (.got (.files (release_run_new (conn) "t" "virt" (nil RelStep)) 92) 17000000)
      "U" (cons "made memory/" (nil (list int))))
    "install: made memory/\ninstall: 92 files fetched, 17.0 MB, installed on /Volumes/System; boot it with root=U\n"))

; A connection, never used.
(def conn () HttpConn (HttpConn (Inet 1 2) 9 5 "h" 167772674 80 (http_read_new "GET") (http_open) ((None TcpRx)) ((None HttpTls))))

; Under an operating system there is no system volume to update.
(def test_net_no_system () int
  (check_int "update" (net_install (RelUpdate) (net_vols (NetAsk (RelUpdate) "" "" false "")) false) 1))
