; install.l0 -- install VOLUME: copies L0S, every directory and file of
; / but /Volumes and /boot (the Pi 5's boot files, which install --boot
; puts on the card's FAT32 partition), onto the volume VOLUME, a label or /Volumes/LABEL, and
; marks each program's copy a program, so that the volume can be booted
; from: boot, given root= and its partition's UUID, which install says,
; makes it /. It copies from wherever / is, the initramfs or another
; system volume, but never onto the one / is. What is on the volume
; already stays, but for files it copies over.
;
; install --boot VOLUME [FROM] makes VOLUME, a FAT32 volume, a Raspberry
; Pi 5's boot partition instead: the files of FROM, /boot unless given,
; which the Pi 5's initramfs holds as l0 card writes them (l0.img,
; config.txt, cmdline.txt) with the board's device trees, copied onto
; its root, and input.bin written
; beside them, an initramfs of every directory and file of / but
; /Volumes, written a file at a time, so that the card boots the system
; running now, /boot and all. With Raspberry Pi's firmware on the card's
; EEPROM, as a Pi 5's is, that is all a card needs. --root ROOT, a
; volume install VOLUME filled, anywhere after VOLUME, makes the card's
; cmdline.txt say root= and ROOT's UUID, its other words kept, so that
; boot makes ROOT /; it is checked before anything is written.
;
; install --net fresh [--boot BOOT] SYSTEM and install --net update
; [SYSTEM] install from the release the host's proxy serves instead
; (release.l0, roadmap 0027), for the board /etc/board names: a fresh
; install formats SYSTEM and BOOT, then writes the release's system and
; boot files, cmdline.txt booting SYSTEM, and on /Volumes/data the
; agent, speech and user directories, the model and the agent's home,
; an agent's file there kept; an update, of the system volume / is if
; none is named, writes the system and boot files again, the boot volume
; the one whose cmdline.txt boots SYSTEM, keeping that cmdline.txt and
; /etc/agent's config and token, fetches the model only if it differs,
; and keeps every agent's file there. Everything is checked first, and
; each file checked against its SHA-256 as it comes.

; Says why, as install, and fails.
(def complain ((why (list int))) int (complain_as "install" why))

; The paths of / to copy, of paths as root_paths gives them: all but /
; itself, and /Volumes/ and what is in it.
(def to_copy ((paths (list (list int)))) (list (list int))
  (if (is_empty paths)
      paths
      (let p (head paths)
        (if (or (eq p "/") (starts_with p "/Volumes/"))
            (to_copy (tail paths))
            (cons p (to_copy (tail paths)))))))

; The paths install VOLUME copies, of paths as root_paths gives them:
; to_copy's but /boot/ and what is in it, the Pi 5's boot files, which
; boot from the card's FAT32 partition, never from a volume.
(def to_install ((paths (list (list int)))) (list (list int))
  (filter_not_boot (to_copy paths)))

; paths but /boot/ and what is in it.
(def filter_not_boot ((paths (list (list int)))) (list (list int))
  (if (is_empty paths)
      paths
      (starts_with (head paths) "/boot/")
      (filter_not_boot (tail paths))
      (cons (head paths) (filter_not_boot (tail paths)))))

; Where path's copy goes on vol, /Volumes/LABEL: a directory's without
; its final /.
(def target ((vol (list int)) (path (list int))) (list int)
  (append vol (if (path_is_dir path) (drop_last path) path)))

; What install says once it has copied n files to vol, whose partition's
; UUID is u.
(def done_line ((vol (list int)) (n int) (u (list int))) (list int)
  (append "install: " (append (digits n) (append " files copied to " (append vol
    (if (is_empty u) "\n" (append "; boot it with root=" (append u "\n"))))))))

; ---------------------------------------------------------------- copying

; What copying came to: how many files, or why it stopped.
(data Copied (Copied int) (CopyStopped (list int)))

; Each of paths copied onto vol, n files so far.
(def copy_all ((vol (list int)) (paths (list (list int))) (n int)) Copied
  (if (is_empty paths)
      (Copied n)
      (let why (copy_one vol (head paths))
        (if (is_empty why)
            (copy_all vol (tail paths) (if (path_is_dir (head paths)) n (add n 1)))
            (CopyStopped why)))))

; path copied onto vol: a directory made, if it is not there, or a file
; written, and marked a program if it is one: nothing, or why not.
(def copy_one ((vol (list int)) (path (list int))) (list int)
  (let to (target vol path)
    (if (path_is_dir path)
        (let code (fs_mkdir to)
          (if (any_eq code (cons 0 (cons -4 (nil int)))) "" (append to (append ": " (io_error code)))))
        (match (read_whole path)
          ((Err why) (append path (append ": " why)))
          ((Ok b) (file_copied path to b))))))

; b, path's bytes, written to to, and marked a program if path is one.
(def file_copied ((path (list int)) (to (list int)) (b bytes)) (list int)
  (let why (write_whole to b)
    (if (not (is_empty why))
        (append to (append ": " why))
        (not (path_is_program path))
        ""
        (let code (fs_chmod to true)
          (if (eq code 0) "" (append to (append ": not marked a program: " (io_error code))))))))

; ------------------------------------------------------------ boot files

; The files of directory from, a path of / with its final /, among paths
; as root_paths gives them: those directly in it, not in a directory of
; its own.
(def boot_files ((from (list int)) (paths (list (list int)))) (list (list int))
  (if (is_empty paths)
      paths
      (let p (head paths)
        (if (and (starts_with p from) (and (not (path_is_dir p)) (not (contains (drop p (length from)) "/"))))
            (cons p (boot_files from (tail paths)))
            (boot_files from (tail paths))))))

; The directory from names, with its final /: /boot unless given.
(def boot_dir ((from (list int))) (list int)
  (let d (normal_path from)
    (if (eq d "/") d (append d "/"))))

; An archive entry's name for path, a path of /: without its first /, or
; a directory's final one.
(def entry_name ((path (list int))) (list int)
  (let p (if (path_is_dir path) (drop_last path) path)
    (if (starts_with p "/") (tail p) p)))

; An entry's mode: a directory's 040755, a program's 0100755, any other
; file's 0100644.
(def entry_mode_of ((path (list int))) int
  (if (path_is_dir path) 16877 (path_is_program path) 33261 33188))

; What install --boot says once it has copied n boot files to vol and
; written its initramfs of files files.
(def boot_line ((vol (list int)) (n int) (files int)) (list int)
  (append "install: " (append (digits n) (append " boot files and input.bin, an initramfs of " (append (digits files)
    (append " files, written to " (append vol "\n")))))))

; How many of paths, as root_paths gives them, are files.
(def file_count ((paths (list (list int)))) int
  (if (is_empty paths) 0 (add (if (path_is_dir (head paths)) 0 1) (file_count (tail paths)))))

; What writing the initramfs came to: its bytes, or why it stopped.
(data Archived (Archived int) (ArchiveStopped (list int)))

; The initramfs, input.bin, of paths, as root_paths gives them, written
; to f an entry at a time: a directory's header, or a file's header, its
; bytes, read whole one file at a time, and its padding; then the
; trailer. at is how many bytes are written so far.
(def archive_to ((f IoFile) (paths (list (list int))) (at int)) Archived
  (if (is_empty paths)
      (let (t (bytes_from_list (newc_trailer))
            w (file_write_bytes f t 0 (bytes_len t)))
        (Archived (add at (bytes_len t))))
      (let p (head paths)
        (if (path_is_dir p)
            (let (h (newc_head (entry_name p) (entry_mode_of p) 0)
                  w (file_write_bytes f h 0 (bytes_len h)))
              (archive_to f (tail paths) (add at (bytes_len h))))
            (match (read_whole p)
              ((Err why) (ArchiveStopped (append p (append ": " why))))
              ((Ok b) (archive_to f (tail paths) (add at (archive_file f p b)))))))))

; The entry of the file at p, its bytes b, written to f: its header, b,
; and its padding; how many bytes they are.
(def archive_file ((f IoFile) (p (list int)) (b bytes)) int
  (let (h (newc_head (entry_name p) (entry_mode_of p) (bytes_len b))
        z (newc_padding (bytes_len b))
        w1 (file_write_bytes f h 0 (bytes_len h))
        w2 (file_write_bytes f b 0 (bytes_len b))
        w3 (file_write_bytes f z 0 (bytes_len z)))
    (add (bytes_len h) (add (bytes_len b) (bytes_len z)))))

; Each of the files ps copied to vol's root, by its name, n so far.
(def boot_copied ((vol (list int)) (ps (list (list int))) (n int)) Copied
  (if (is_empty ps)
      (Copied n)
      (match (read_whole (head ps))
        ((Err why) (CopyStopped (append (head ps) (append ": " why))))
        ((Ok b)
          (let (to (append vol (append "/" (base_name (head ps))))
                why (write_whole to b))
            (if (is_empty why)
                (boot_copied vol (tail ps) (add n 1))
                (CopyStopped (append to (append ": " why)))))))))

; The Raspberry Pi 5's boot partition made of vol: each file of from
; copied onto it, the image, config.txt and cmdline.txt as l0 card
; writes them, and input.bin, an initramfs of every directory and file
; of / but /Volumes, so that the card boots the system running now;
; with u, a root's UUID, not empty, its cmdline.txt made to boot root,
; root=u.
(def boot_on ((vol (list int)) (from (list int)) (root (list int)) (u (list int))) int
  (let why (volume_why vol)
    (if (not (is_empty why))
        (complain why)
        (let (paths (root_paths)
              files (boot_files from paths))
          (if (is_empty files)
              (complain (append (drop_last from) ": no boot files; the Raspberry Pi 5's initramfs has them in /boot"))
              (match (boot_copied vol files 0)
                ((CopyStopped why2) (complain why2))
                ((Copied n)
                  (let why3 (if (is_empty u) "" (root_set vol u))
                    (if (is_empty why3)
                        (boot_archived vol n (to_copy paths) (if (is_empty u) "" (root_line vol root u)))
                        (complain why3))))))))))

; input.bin written to vol, of paths, once n boot files are copied, and
; then said, with rooted, what was said of the root, after.
(def boot_archived ((vol (list int)) (n int) (paths (list (list int))) (rooted (list int))) int
  (let out (append vol "/input.bin")
    (match (open_out out)
      ((IoFailed fault why) (complain (append out (append ": " why))))
      ((IoOpened f)
        (match (archive_to f paths 0)
          ((ArchiveStopped why) (let c (file_close f) (complain why)))
          ((Archived size)
            (let why (done_why (file_close f))
              (if (is_empty why)
                  (let w (say (append (boot_line vol n (file_count paths)) (append rooted (dtb_note vol (has_dtb (vol_names vol)))))) 0)
                  (complain (append out (append ": " why)))))))))))

; The names in vol's root, a directory's with its final /.
(def vol_names ((vol (list int))) (list (list int))
  (match (fs_list vol) ((FsListRefused code) (nil (list int))) ((FsFiles files) (stats_names files))))

; Whether names hold a Raspberry Pi 5's device tree, bcm2712*.dtb, which
; the firmware loads, and only Raspberry Pi gives.
(def has_dtb ((names (list (list int)))) bool
  (if (is_empty names)
      false
      (and (starts_with (head names) "bcm2712") (ends_with (head names) ".dtb")) true
      (has_dtb (tail names))))

; What install --boot says of vol's device tree: nothing if it has one;
; else that it must be copied there, as from a FROM that had none.
(def dtb_note ((vol (list int)) (has bool)) (list int)
  (if has
      ""
      (append "install: " (append vol ": no bcm2712-rpi-5-b.dtb; copy the Pi 5's device trees there from Raspberry Pi OS's boot partition\n"))))

; ---------------------------------------------------------------- running

; install VOLUME, install --boot VOLUME [FROM] [--root ROOT], or
; install --net fresh|update ..., as the arguments say.
(def install () int
  (if (and (ge (arg_count) 2) (eq (arg 0) "--boot"))
      (match (boot_words (args_list 1))
        ((BootBad) (complain "usage: install --boot VOLUME [FROM] [--root ROOT]"))
        ((BootArgs vol from root) (boot_rooted (volume_named vol) (boot_dir from) root)))
      (and (ge (arg_count) 1) (eq (arg 0) "--net"))
      (match (net_words (args_list 1))
        ((NetBad) (complain (net_usage)))
        ((NetArgs a) (net_install (.mode a) (net_vols a) (.progress a))))
      (not (eq (arg_count) 1))
      (complain "usage: install VOLUME, install --boot VOLUME [FROM] [--root ROOT], or install --net fresh|update ...")
      (install_on (volume_named (arg 0)))))

; ------------------------------------------------------- from the proxy

; How install --net is used.
(def net_usage () (list int)
  "usage: install --net fresh [--boot BOOT] [--boot-order sd,net] [--progress] SYSTEM, or install --net update [--boot-order sd,net] [--progress] [SYSTEM]")

; What install --net's words ask: the mode, the system volume and the
; boot volume, empty where none was named, whether to say each file's
; progress as it comes (--progress, for the Installer), and the boot
; order to set, BOOT_ORDER's value, empty for none.
(data NetAsk (NetAsk (mode RelMode) (system (list int)) (boot (list int)) (progress bool) (order (list int))))

; What the words ask, or that they are wrong.
(data NetAsked (NetArgs NetAsk) (NetBad))

; What ws, the words after --net, ask: fresh with a system volume, or
; update with one or none; --boot BOOT, --boot-order sd,net and
; --progress anywhere after the mode.
(def net_words ((ws (list (list int)))) NetAsked
  (if (is_empty ws)
      (NetBad)
      (let m (head ws)
        (if (eq m "fresh") (net_words_from (tail ws) (nil (list int)) (NetAsk (RelFresh) "" "" false ""))
            (eq m "update") (net_words_from (tail ws) (nil (list int)) (NetAsk (RelUpdate) "" "" false ""))
            (NetBad)))))

; net_words after the mode, with the plain words so far, reversed, and
; what the others asked, a.
(def net_words_from ((ws (list (list int))) (plain (list (list int))) (a NetAsk)) NetAsked
  (if (is_empty ws)
      (let ps (rev plain)
        (if (gt (length ps) 1) (NetBad)
            (and (is_empty ps) (eq (.mode a) (RelFresh))) (NetBad)
            (NetArgs (.system a (if (is_empty ps) "" (head ps))))))
      (eq (head ws) "--progress")
      (net_words_from (tail ws) plain (.progress a true))
      (and (eq (head ws) "--boot") (and (not (is_empty (tail ws))) (is_empty (.boot a))))
      (net_words_from (tail (tail ws)) plain (.boot a (head (tail ws))))
      (and (eq (head ws) "--boot-order") (and (not (is_empty (tail ws))) (eq (head (tail ws)) "sd,net")))
      (net_words_from (tail (tail ws)) plain (.order a (boot_order_sd_net)))
      (starts_with (head ws) "--")
      (NetBad)
      (net_words_from (tail ws) (cons (head ws) plain) a)))

; The volumes install --net writes, as a asks: an update's system volume
; / if none is named, and its boot volume the one whose cmdline.txt
; boots it.
(def net_vols ((a NetAsk)) RelVols
  (let (s (if (is_empty (.system a)) (fs_system_volume) (volume_named (.system a)))
        b (if (not (is_empty (.boot a))) (volume_named (.boot a))
              (eq (.mode a) (RelFresh)) ""
              (release_boot_of (fs_volumes) (uuid_of (mount_list) s))))
    (RelVols s b (release_data) (.order a))))

; install --net: the release for this board fetched from the proxy onto
; the volumes v, as m asks, each file's progress said if progress.
(def net_install ((m RelMode) (v RelVols) (progress bool)) int
  (let board (release_board)
    (if (is_empty (.system v))
        (complain "/ is the initramfs, not a system volume: name the volume to update")
        (let why (release_why m v board)
          (if (not (is_empty why))
              (complain why)
              (match (model_conf_read)
                ((Err why2) (complain why2))
                ((Ok c) (net_connected m v board c progress))))))))

; install --net once the proxy c names is known: the manifest fetched,
; the volumes formatted if fresh, and the plan said and carried out.
(def net_connected ((m RelMode) (v RelVols) (board (list int)) (c ModelConf) (progress bool)) int
  (match (http_connect (inet_open) (port_new) (.host c) (.port c))
    ((Err why) (complain (append "the proxy at " (append (.host c) (append ": " why)))))
    ((Ok conn)
      (match (release_listed conn (.token c) board)
        ((Err why) (complain why))
        ((Ok l)
          (let (lacks (release_lacks v (.es l))
                why (if (not (is_empty lacks)) lacks
                        (eq m (RelFresh)) (net_formatted v)
                        ""))
            (if (not (is_empty why))
                (complain why)
                (let (ss (release_plan m v (.es l))
                      w (say (append "install: " (release_plan_text ss))))
                  (net_ran m v (net_fetched (release_run_new (.conn l) (.token c) board ss) progress -1))))))))))

; v's volumes formatted, said first: empty, or why not.
(def net_formatted ((v RelVols)) (list int)
  (let w (say (append "install: " (release_format_text v)))
    (release_formatted v)))

; r carried to its end: its next file asked for, and its connection's
; parts waited for and read, until every file is fetched or it stops;
; if progress, a line said as each file begins and at each megabyte,
; said the step it last said.
(def net_fetched ((r RelRun) (progress bool) (said int)) RelRun
  (let (r1 (release_next r)
        step (net_step r1)
        w (if (and progress (and (not (eq step said)) (not (release_ended r1))))
              (say (append "install: " (append (release_progress_text r1) "\n")))
              0))
    (if (release_ended r1)
        r1
        (match r1
          ((RelRun conn token board todo cur files count got total why)
            (match (http_next conn (add (clock_ns) (release_idle_ns)))
              ((HttpGot c2 ps)
                (let r2 (RelRun c2 token board todo cur files count got total why)
                  (if (is_empty ps)
                      (release_stopped r2 "the proxy said nothing for 30 s")
                      (net_fetched (release_heard r2 ps) progress step))))))))))

; Where r is, as progress counts it: the files done, and the megabytes
; come, made one number that changes when either does.
(def net_step ((r RelRun)) int
  (add (mul (.files r) 1000000) (div (.got r) 1000000)))

; install --net once r has ended: if every file came, a fresh install's
; cmdline.txt made to boot the system volume, the data volume's
; directories and the agent's home made, and the boot order set, if
; asked; then said.
(def net_ran ((m RelMode) (v RelVols) (r RelRun)) int
  (if (not (is_empty (.why r)))
      (complain (.why r))
      (let (u (uuid_of (mount_list) (.system v))
            why (if (eq m (RelFresh)) (release_rooted v u) ""))
        (if (not (is_empty why))
            (complain why)
            (match (release_data_made v)
              ((Err why2) (complain why2))
              ((Ok done)
                (match (net_ordered v)
                  ((Err why3) (complain why3))
                  ((Ok said) (let w (say (append (net_done_text m v r u done) said)) 0)))))))))

; The boot order v asks set, if it asks one: the update of the release's
; pieeprom.bin, fetched to the system volume, written to the boot
; volume, its configuration the bootloader's own if the firmware says
; it, else the image's. What is said of it, or why it could not be.
(def net_ordered ((v RelVols)) (Result (list int) (list int))
  (if (is_empty (.order v))
      ((Ok (list int) (list int)) "")
      (let p (release_eeprom_place v)
        (match (read_whole p)
          ((Err why) ((Err (list int) (list int)) (append p (append ": " why))))
          ((Ok b)
            (match (boot_conf b)
              ((Err why) ((Err (list int) (list int)) (append p (append ": " why))))
              ((Ok bc)
                (let ts (ee_update_ts (ee_clock_seconds) (ee_last_update))
                  (match (boot_order_written b (.text bc) (.order v) ts (.boot v))
                    ((Err why) ((Err (list int) (list int)) why))
                    ((Ok ps) ((Ok (list int) (list int)) (net_order_line v (.running bc)))))))))))))

; What install --net says once the boot order's update is on v's boot
; volume, its configuration the running one or the image's.
(def net_order_line ((v RelVols) (running bool)) (list int)
  (append "install: BOOT_ORDER=" (append (.order v) (append " in " (append (.boot v)
    (append "/pieeprom.upd, from " (append (if running "the bootloader's own configuration" "the release image's configuration, as the firmware did not answer")
      "; the bootloader flashes it as the board next boots from the card\n")))))))

; What install --net says at its end: what the agent's home made, the
; files fetched, and the root to boot.
(def net_done_text ((m RelMode) (v RelVols) (r RelRun) (u (list int)) (done (list (list int)))) (list int)
  (append (net_lines done)
    (append "install: " (append (digits (.files r)) (append " files fetched, " (append (format_size (.got r))
      (append (if (eq m (RelFresh)) ", installed on " ", updated on ") (append (.system v)
        (if (is_empty u) "\n" (append "; boot it with root=" (append u "\n")))))))))))

; Each of ls, said by install, a line each.
(def net_lines ((ls (list (list int)))) (list int)
  (if (is_empty ls) "" (append "install: " (append (head ls) (append "\n" (net_lines (tail ls)))))))

; The arguments from i on, as a list.
(def args_list ((i int)) (list (list int))
  (if (ge i (arg_count)) (nil (list int)) (cons (arg i) (args_list (add i 1)))))

; What install --boot's words after --boot ask: the volume, FROM, /boot
; unless given, and the root volume named by --root, empty for none,
; which may come anywhere after the volume.
(data BootAsked (BootArgs (list int) (list int) (list int)) (BootBad))

; What ws, the words after --boot, ask.
(def boot_words ((ws (list (list int)))) BootAsked
  (boot_words_from ws (nil (list int)) ""))

; boot_words, with the words not --root's, plain, and root so far.
(def boot_words_from ((ws (list (list int))) (plain (list (list int))) (root (list int))) BootAsked
  (if (is_empty ws)
      (let ps (rev plain)
        (if (is_empty ps) (BootBad)
            (gt (length ps) 2) (BootBad)
            (BootArgs (head ps) (if (is_empty (tail ps)) "/boot" (nth ps 1)) root)))
      (eq (head ws) "--root")
      (if (or (is_empty (tail ws)) (not (is_empty root)))
          (BootBad)
          (boot_words_from (tail (tail ws)) plain (head (tail ws))))
      (boot_words_from (tail ws) (cons (head ws) plain) root)))

; What install --boot says of the root it set: the file, the volume and
; its UUID.
(def root_line ((vol (list int)) (root (list int)) (u (list int))) (list int)
  (append "install: " (append vol (append "/cmdline.txt boots " (append root (append ", root=" (append u "\n")))))))

; Why root may not be the root the card boots, or empty: a mounted
; volume with a UUID, not vol, the boot partition itself.
(def root_why ((vol (list int)) (root (list int)) (u (list int))) (list int)
  (if (eq root vol)
      (append root ": the boot volume; the root is another, which install VOLUME fills")
      (eq (fs_port_of root) 0)
      (append root ": no such volume is mounted")
      (is_empty u)
      (append root ": it has no partition UUID to boot it by")
      ""))

; boot_on, and with a root, cmdline.txt made to boot it: the root
; checked first, before anything is written.
(def boot_rooted ((vol (list int)) (from (list int)) (root (list int))) int
  (if (is_empty root)
      (boot_on vol from "" "")
      (let (r (volume_named root)
            u (uuid_of (mount_list) r)
            why (root_why vol r u))
        (if (is_empty why) (boot_on vol from r u) (complain why)))))

; vol's cmdline.txt, or none, made to boot root=u: why not, or empty.
(def root_set ((vol (list int)) (u (list int))) (list int)
  (let (p (append vol "/cmdline.txt")
        old (match (read_whole p) ((Err why) "") ((Ok b) (bytes_to_list b)))
        why (write_whole p (bytes_from_list (cmdline_rooted old u))))
    (if (is_empty why) "" (append p (append ": " why)))))

; Why install may not write to vol, or empty: it must be a mounted
; volume, and not /.
(def volume_why ((vol (list int))) (list int)
  (if (not (eq (fs_volume_of vol) vol))
      (append vol ": not a volume")
      (eq (fs_port_of vol) 0)
      (append vol ": no such volume is mounted")
      (eq vol (fs_system_volume))
      (append vol ": it is /, which install copies")
      ""))

; L0S copied onto vol, if it is a mounted volume, and not /.
(def install_on ((vol (list int))) int
  (let why (volume_why vol)
    (if (not (is_empty why))
        (complain why)
        (match (copy_all vol (to_install (root_paths)) 0)
          ((CopyStopped why2) (complain why2))
          ((Copied n) (let w (say (done_line vol n (uuid_of (mount_list) vol))) 0))))))
