(def echo_text ((e Echo)) (list int)
  (match e ((Echo s stop) (append (if stop "stop " "go ") s))))

(def test_printable () int
  (add (check_str "a" (echo_text (echo_of (KeyEvent 30 1 97 0))) "go a")
       (add (check_str "repeat" (echo_text (echo_of (KeyEvent 30 2 97 0))) "go a")
            (check_str "space" (echo_text (echo_of (KeyEvent 57 1 32 0))) "go  "))))

(def test_release () int
  (check_str "nothing" (echo_text (echo_of (KeyEvent 30 0 0 0))) "go "))

(def test_enter_and_backspace () int
  (add (check_str "enter" (echo_text (echo_of (KeyEvent 28 1 10 0))) "go \n")
       (check_str "backspace" (echo_text (echo_of (KeyEvent 14 1 8 0))) "go \x08 \x08")))

(def test_esc_stops () int
  (check_str "esc" (echo_text (echo_of (KeyEvent 1 1 27 0))) "stop \n"))

(def test_no_character () int
  (add (check_str "shift" (echo_text (echo_of (KeyEvent 42 1 0 0))) "go ")
       (check_str "tab" (echo_text (echo_of (KeyEvent 15 1 9 0))) "go ")))

; Ctrl-K types 11, echoed ^K; Alt-x types x, echoed M-x; both, M-^K.
(def test_modifiers () int
  (add (check_str "ctrl-k" (echo_text (echo_of (KeyEvent 37 1 11 2))) "go ^K")
       (add (check_str "alt-x" (echo_text (echo_of (KeyEvent 45 1 120 4))) "go M-x")
            (check_str "ctrl-alt-k" (echo_text (echo_of (KeyEvent 37 1 11 6))) "go M-^K"))))

; Alt with a key that types nothing echoes nothing, as Alt alone.
(def test_alt_alone () int
  (check_str "alt" (echo_text (echo_of (KeyEvent 56 1 0 4))) "go "))

; Under an operating system there is no keyboard driver.
(def test_no_keyboard () int
  (check_int "fails" (keys) 1))
