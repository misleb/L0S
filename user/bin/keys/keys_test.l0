(def echo_text ((e Echo)) (list int)
  (match e ((Echo s stop) (append (if stop "stop " "go ") s))))

(def test_printable () int
  (add (check_str "a" (echo_text (echo_of (KeyEvent 30 1 97))) "go a")
       (add (check_str "repeat" (echo_text (echo_of (KeyEvent 30 2 97))) "go a")
            (check_str "space" (echo_text (echo_of (KeyEvent 57 1 32))) "go  "))))

(def test_release () int
  (check_str "nothing" (echo_text (echo_of (KeyEvent 30 0 0))) "go "))

(def test_enter_and_backspace () int
  (add (check_str "enter" (echo_text (echo_of (KeyEvent 28 1 10))) "go \n")
       (check_str "backspace" (echo_text (echo_of (KeyEvent 14 1 8))) "go \x08 \x08")))

(def test_esc_stops () int
  (check_str "esc" (echo_text (echo_of (KeyEvent 1 1 27))) "stop \n"))

(def test_no_character () int
  (add (check_str "shift" (echo_text (echo_of (KeyEvent 42 1 0))) "go ")
       (check_str "ctrl-c" (echo_text (echo_of (KeyEvent 46 1 3))) "go ")))

; Under an operating system there is no keyboard driver.
(def test_no_keyboard () int
  (check_int "fails" (keys) 1))
