; keys.l0 -- echoes keys typed in QEMU's window, for checking the keyboard
; driver: listens to user/virtio-input, and writes each printable
; character as its key goes down or repeats, a newline for Enter, and
; rubs out one for Backspace, to its standard output: its shell's
; terminal. Esc ends it, as Ctrl-C at that terminal does.

(def banner () (list int) "keys: type in QEMU's window; Esc ends\n")

; What a key event echoes, and whether it ends the program.
(data Echo (Echo (list int) bool))

(def echo_of ((ev KeyEvent)) Echo
  (match ev
    ((KeyEvent code value ch)
      (if (eq value 0)
          (Echo "" false)
          (if (eq ch 27) (Echo "\n" true)
          (if (eq ch 10) (Echo "\n" false)
          (if (eq ch 8) (Echo "\x08 \x08" false)
          (if (is_printable ch)
              (Echo (cons ch (nil int)) false)
              (Echo "" false)))))))))

(def complain ((why (list int))) int (complain_as "keys" why))

(def keys () int
  (let port (port_new)
    (match (keyboard_listen port)
      ((Listening pid) (let b (say (banner)) (echo_keys port)))
      ((NoDriver) (complain "no keyboard; is virtio-input running?"))
      ((ListenRefused) (complain "the keyboard would not send its keys")))))

(def echo_keys ((port int)) int
  (match (key_event_of (port_receive port))
    ((None) (echo_keys port))
    ((Some ev)
      (match (echo_of ev)
        ((Echo s stop) (let w (say s) (if stop 0 (echo_keys port))))))))
