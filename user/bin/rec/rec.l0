; rec.l0 -- records from a microphone into a WAV file, through the audio
; server (proto/audio.l0); and lists the sound devices:
;
;   rec list                            the devices, as sound lists them
;   rec FILE SECONDS [RATE [CHANS [ID]]]
;                                       SECONDS of the default input, or
;                                       of device ID, at RATE (48000 if
;                                       none) of CHANS channels (2 if
;                                       none), written to FILE as a WAV
;                                       file of 16-bit samples; 16000 1
;                                       records what Whistle hears
;
; The server converts what the microphone gives to the rate and channels
; asked. A microphone that sends less than asked within SECONDS and 3
; more is said so, and what it sent written. A failure is said on
; standard error, and it exits 1.

; What ends rec, said as rec on standard error: 1.
(def complain ((why (list int))) int (complain_as "rec" why))

; The most seconds one recording takes: 10 minutes.
(def rec_most_seconds () int 600)

; The rate and channels asked when none are given.
(def rec_default_rate () int 48000)
(def rec_default_chans () int 2)

; How long past its time a recording waits for the samples: 3 s.
(def rec_grace_ns () int 3000000000)

; What the arguments ask: the devices; a recording, its file, seconds,
; rate, channels and device; or why they ask nothing.
(data Ask (AskList) (AskRecord (list int) int int int int) (AskWrong (list int)))

; The arguments as is asked.
(def ask_of ((as (list (list int)))) Ask
  (let n (length as)
    (if (and (eq n 1) (eq (head as) "list")) (AskList)
        (or (lt n 2) (gt n 5)) (AskWrong (rec_usage))
        (match (word_numbers (tail as))
          ((None) (AskWrong (rec_usage)))
          ((Some ns)
            (let s (head ns)
              (if (or (lt s 1) (gt s (rec_most_seconds)))
                  (AskWrong (append "SECONDS is 1 to " (digits (rec_most_seconds))))
                  (AskRecord (head as) s (nth_or ns 1 (rec_default_rate)) (nth_or ns 2 (rec_default_chans)) (nth_or ns 3 0)))))))))

; The usage.
(def rec_usage () (list int) "usage: rec list | rec FILE SECONDS [RATE [CHANS [ID]]]")

; What rec does with its arguments.
(def rec_main ((as (list (list int)))) int
  (match (ask_of as)
    ((AskWrong why) (complain why))
    ((AskList) (with_audio (ListDo)))
    ((AskRecord path s rate chans dev) (with_audio (RecordDo path s rate chans dev)))))

; What to do once the server is found.
(data Do (ListDo) (RecordDo (list int) int int int int))

; The server found, and d done.
(def with_audio ((d Do)) int
  (match (audio_open)
    ((NoAudio why) (complain why))
    ((Audio port rp pid)
      (let a (Audio port rp pid)
        (match d
          ((ListDo) (listed (audio_reply a "devices")))
          ((RecordDo path s rate chans dev) (recording a path s rate chans dev)))))))

; The devices answer written; nothing there said so.
(def listed ((r (list int))) int
  (if (starts_with r "error: ") (complain (drop r 7))
      (is_empty r) (let w (write_line "no devices") 0)
      (let w (write_str r) 0)))

; ----------------------------------------------------------------- record

; s seconds of input dev at rate of chans recorded to path: listen
; asked, the samples gathered as they come until there are enough or
; the time and grace are up, stop asked, and the file written.
(def recording ((a Audio) (path (list int)) (s int) (rate int) (chans int) (dev int)) int
  (match (audio_listen a rate chans dev)
    ((Err why) (complain why))
    ((Ok f)
      (match a
        ((NoAudio why) (complain why))
        ((Audio port rp pid)
          (let (want (mul (mul s (.rate f)) (pcm_frame_bytes f))
                deadline (add (clock_ns) (add (mul s 1000000000) (rec_grace_ns)))
                al (alarm_at rp deadline)
                got (gathered rp want 0 (nil bytes))
                st (audio_stop a))
            (written path f s want got)))))))

; Samples gathered from rp until want bytes have come or the alarm
; rings: the pieces, newest first, and how many bytes.
(data Got (Got (pieces (list bytes)) (n int)))

; gathered's loop: n bytes so far in pieces, newest first.
(def gathered ((rp int) (want int) (n int) (pieces (list bytes))) Got
  (if (ge n want)
      (Got pieces n)
      (match (port_receive rp)
        ((RecvFailed) (Got pieces n))
        ((Message from b)
          (if (audio_is_pcm b)
              (let p (bytes_slice b (audio_pcm_at) (bytes_len b))
                (gathered rp want (add n (bytes_len p)) (cons p pieces)))
              (is_alarm_notice (Message from b))
              (Got pieces n)
              (gathered rp want n pieces))))))

; What was gathered, g, written to path as a WAV file of format f, cut
; to want bytes; s seconds said, or what came if less, and 1 then.
(def written ((path (list int)) (f PcmFormat) (s int) (want int) (g Got)) int
  (let (b (rec_wav f want g)
        w (write_whole path b))
    (if (not (is_empty w))
        (complain (append path (append ": " w)))
        (lt (.n g) want)
        (complain (append "the microphone sent " (append (digits (.n g)) (append " of " (append (digits want) (append " bytes; wrote them to " path))))))
        (let l (write_line (rec_line path f s)) 0))))

; The WAV file of what g gathered, its whole frames, at most want bytes,
; after a header of f.
(def rec_wav ((f PcmFormat) (want int) (g Got)) bytes
  (let (all (bytes_concat (rev (.pieces g)))
        fb (pcm_frame_bytes f)
        n (mul (div (min want (bytes_len all)) (max fb 1)) fb))
    (bytes_concat (cons (bytes_from_list (wav_header_sized (.rate f) (.chans f) (.size f) n))
                    (cons (bytes_slice all 0 n) (nil bytes))))))

; What rec says of a recording: recorded S s at RATE Hz, CH channels of
; BITS bits, to PATH.
(def rec_line ((path (list int)) (f PcmFormat) (s int)) (list int)
  (append "recorded " (append (digits s) (append " s at " (append (digits (.rate f))
    (append " Hz, " (append (digits (.chans f)) (append " channels of " (append (digits (mul 8 (.size f)))
      (append " bits, to " path))))))))))
