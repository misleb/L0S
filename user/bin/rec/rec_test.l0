; rec_test.l0 -- what rec's arguments ask, the WAV file it makes of
; what a microphone sent, and what it says; with no kernel, no mic.

(def bb ((s (list int))) bytes (bytes_from_list s))

; Its arguments, each kind, and those that ask nothing.
(def ask_text ((a Ask)) (list int)
  (match a
    ((AskList) "list")
    ((AskSilence ws) (unwords (cons "silence" ws)))
    ((AskRecord p s r) (unwords (cons "record" (cons p (numbers_words (cons s (cons r (nil int))))))))
    ((AskWrong why) (append "wrong: " why))))

(def test_ask () int
  (add (check_str "list" (ask_text (ask_of (cons "list" (nil (list int))))) "list")
       (add (check_str "record" (ask_text (ask_of (split_spaces "a.wav 5"))) "record a.wav 5 48000")
            (add (check_str "rate" (ask_text (ask_of (split_spaces "a.wav 5 16000"))) "record a.wav 5 16000")
                 (add (check_str "silence" (ask_text (ask_of (split_spaces "silence 1 2 500"))) "silence 1 2 500")
                      (check_str "too long" (ask_text (ask_of (split_spaces "a.wav 900"))) "wrong: SECONDS is 1 to 600"))))))

; What came, two pieces, 2 channels of 3 bytes, 6 bytes a frame: 8 bytes
; asked of 14 come is cut to 6, a whole frame, after the 44 of the
; header, which says 24 bits and a data chunk of 6.
(def test_wav () int
  (let (f (MicFormat 48000 2 3)
        w (rec_wav f 8 (Got (cons (bb "ghijklmn") (cons (bb "abcdef") (nil bytes))) 14)))
    (add (check_int "length" (bytes_len w) 50)
         (add (check_str "samples" (bytes_to_list (bytes_slice w 44 50)) "abcdef")
              (add (check_int "bits" (le_u16_at w 34) 24)
                   (check_int "data" (le_u32 w 40) 6))))))

(def test_line () int
  (check_str "line" (rec_line "/Volumes/data/a.wav" (MicFormat 48000 2 3) 5)
    "recorded 5 s at 48000 Hz, 2 channels of 24 bits, to /Volumes/data/a.wav"))

; Under an operating system there is no mic.
(def test_entry () int
  (check_int "fails" (rec_main (cons "list" (nil (list int)))) 1))
