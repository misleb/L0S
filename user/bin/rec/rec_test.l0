; rec_test.l0 -- what rec's arguments ask, the WAV file it makes of
; what a microphone sent, and what it says; with no kernel, no server.

(def bb ((s (list int))) bytes (bytes_from_list s))

; Its arguments, each kind, and those that ask nothing.
(def ask_text ((a Ask)) (list int)
  (match a
    ((AskList) "list")
    ((AskRecord p s r c d) (unwords (cons "record" (cons p (numbers_words (cons s (cons r (cons c (cons d (nil int))))))))))
    ((AskWrong why) (append "wrong: " why))))

(def test_ask () int
  (add (check_str "list" (ask_text (ask_of (cons "list" (nil (list int))))) "list")
       (add (check_str "record" (ask_text (ask_of (split_spaces "a.wav 5"))) "record a.wav 5 48000 2 0")
            (add (check_str "format" (ask_text (ask_of (split_spaces "a.wav 5 16000 1 3"))) "record a.wav 5 16000 1 3")
                 (add (check_str "words" (ask_text (ask_of (split_spaces "a.wav x"))) (append "wrong: " (rec_usage)))
                      (check_str "too long" (ask_text (ask_of (split_spaces "a.wav 900"))) "wrong: SECONDS is 1 to 600"))))))

; What came, two pieces, 2 channels of 2 bytes, 4 bytes a frame: 6 bytes
; asked of 14 come is cut to 4, a whole frame, after the 44 of the
; header, which says 16 bits and a data chunk of 4.
(def test_wav () int
  (let (f (PcmFormat 48000 2 2)
        w (rec_wav f 6 (Got (cons (bb "ghijklmn") (cons (bb "abcdef") (nil bytes))) 14)))
    (add (check_int "length" (bytes_len w) 48)
         (add (check_str "samples" (bytes_to_list (bytes_slice w 44 48)) "abcd")
              (add (check_int "bits" (le_u16_at w 34) 16)
                   (check_int "data" (le_u32 w 40) 4))))))

(def test_line () int
  (check_str "line" (rec_line "/Volumes/data/a.wav" (PcmFormat 16000 1 2) 5)
    "recorded 5 s at 16000 Hz, 1 channels of 16 bits, to /Volumes/data/a.wav"))

; Under an operating system there is no audio server.
(def test_entry () int
  (check_int "fails" (rec_main (cons "list" (nil (list int)))) 1))
