; build/sample/bin/x, "hi", is made by make test before l0 test runs.

(def catted ((paths (list (list int)))) (list int)
  (match (open_out_buffer)
    ((IoFailed fault why) why)
    ((IoOpened out)
      (let (bad (cat_all paths out 0)
            got (buffer_contents out)
            c (file_close out))
        (append got (append "|" (digits bad)))))))

(def test_cat_one () int
  (check_str "contents" (catted (split_spaces "build/sample/bin/x")) "hi|0"))

(def test_cat_in_order () int
  (check_str "twice" (catted (split_spaces "build/sample/bin/x build/sample/bin/x")) "hihi|0"))

(def test_cat_missing () int
  (check_str "the rest still written" (catted (split_spaces "build/nope build/sample/bin/x")) "hi|1"))

(def test_cat_error () int
  (check_str "message" (cat_error "/etc/nope" "no such file") "cat: /etc/nope: no such file\n"))
