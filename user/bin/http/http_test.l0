; http_test.l0 -- tests of http.l0: the URLs and options it takes, the
; request it makes, and how it writes a head, an event and JSON.

; A URL as text: the server, port, path and host, or why not.
(def url_text ((r (Result Url (list int)))) (list int)
  (match r
    ((Err why) (append "error: " why))
    ((Ok u) (match u ((Url server port path host) (unwords (cons server (cons (digits port) (cons path (cons host (nil (list int))))))))))))

(def test_url_plain () int
  (check_str "http://" (url_text (url_of "http://10.0.2.2/index.html")) "10.0.2.2 80 /index.html 10.0.2.2"))

(def test_url_port () int
  (check_str "a port" (url_text (url_of "http://10.0.2.2:8080/a/b?c=d")) "10.0.2.2 8080 /a/b?c=d 10.0.2.2:8080"))

; The scheme and the path may be left out.
(def test_url_short () int
  (add (check_str "no scheme" (url_text (url_of "10.0.2.2:81/x")) "10.0.2.2 81 /x 10.0.2.2:81")
       (check_str "no path" (url_text (url_of "10.0.2.2")) "10.0.2.2 80 / 10.0.2.2")))

; A name is kept, for inet's name server to resolve when the page is
; fetched.
(def test_url_name () int
  (check_str "a name" (url_text (url_of "http://example.com:8080/")) "example.com 8080 / example.com:8080"))

(def test_url_refused () int
  (add (check_str "not a name" (url_text (url_of "http://a..b/")) "error: not a name or an address: a..b")
       (add (check_str "https" (url_text (url_of "https://10.0.2.2/")) "error: only http:// is spoken")
            (add (check_str "port 0" (url_text (url_of "10.0.2.2:0/")) "error: a port is 1 to 65535")
                 (check_str "not a port" (url_text (url_of "10.0.2.2:x/")) "error: not a port: x")))))

; ------------------------------------------------------------------ options

; Options as text: i j e for those given, the body, the headers, the URL.
(def opts_text ((r (Result Opts (list int)))) (list int)
  (match r
    ((Err why) (append "error: " why))
    ((Ok o)
      (match o
        ((Opts show json events body hs url)
          (unwords (cons (if show "i" "-") (cons (if json "j" "-") (cons (if events "e" "-")
            (cons (match body ((Some b) b) ((None) "none"))
              (cons (digits (length hs)) (cons url (nil (list int))))))))))))))

(def test_opts_plain () int
  (check_str "a URL" (opts_text (opts_of (cons "10.0.2.2/x" (nil (list int))))) "- - - none 0 10.0.2.2/x"))

(def test_opts_all () int
  (check_str "each" (opts_text (opts_of (split_spaces "-i -j -e -d {\"a\":1} -H X-A:b -H X-B:c 10.0.2.2/x")))
             "i j e {\"a\":1} 2 10.0.2.2/x"))

(def test_opts_refused () int
  (add (check_str "no URL" (opts_text (opts_of (split_spaces "-i"))) "error: http [-i] [-j] [-e] [-d BODY] [-H NAME:VALUE]... URL")
       (add (check_str "no value" (opts_text (opts_of (split_spaces "x -d"))) "error: -d needs a value")
            (add (check_str "no colon" (opts_text (opts_of (split_spaces "-H X x"))) "error: not NAME:VALUE: X")
                 (check_str "two URLs" (opts_text (opts_of (split_spaces "a b"))) "error: http [-i] [-j] [-e] [-d BODY] [-H NAME:VALUE]... URL")))))

; The options of a line of words, or none.
(def opts_or ((s (list int))) Opts
  (match (opts_of (split_spaces s)) ((Ok o) o) ((Err why) (Opts false false false ((None (list int))) (nil HttpHeader) why))))

; ------------------------------------------------------------------ requests

; GET, or POST with a body, as JSON unless a -H says otherwise.
(def test_request () int
  (add (check_str "GET" (bytes_to_list (http_request (opts_method (opts_or "h/p")) "h" "/p" (request_headers (opts_or "h/p")) (post_body (opts_or "h/p"))))
                  "GET /p HTTP/1.1\r\nHost: h\r\nUser-Agent: l0s-http\r\n\r\n")
       (check_str "POST" (bytes_to_list (http_request (opts_method (opts_or "-d [1] h/p")) "h" "/p" (request_headers (opts_or "-d [1] h/p")) (post_body (opts_or "-d [1] h/p"))))
                  "POST /p HTTP/1.1\r\nHost: h\r\nUser-Agent: l0s-http\r\nContent-Type: application/json\r\nContent-Length: 3\r\n\r\n[1]")))

(def test_request_typed () int
  (check_str "the given type" (bytes_to_list (http_request "POST" "h" "/" (request_headers (opts_or "-H Content-Type:text/plain -d x h/")) (post_body (opts_or "-d x h/"))))
             "POST / HTTP/1.1\r\nHost: h\r\nUser-Agent: l0s-http\r\nContent-Type: text/plain\r\nContent-Length: 1\r\n\r\nx"))

; ------------------------------------------------------------------ writing

(def test_head_text () int
  (check_str "the head" (head_text 200 "OK" (cons (HttpHeader "Content-Length" "2") (cons (HttpHeader "X-A" "b") (nil HttpHeader))))
             "200 OK\nContent-Length: 2\nX-A: b\n\n"))

; An event's line, its data's newlines as spaces.
(def test_event_line () int
  (check_str "a line" (event_line (SseEvent (bytes_from_list "tick") (bytes_from_list "a\nb"))) "tick a b\n"))

(def test_json_line () int
  (add (check_str "compact" (match (json_line (bytes_from_list "{ \"a\" : [1, 2] }")) ((Ok b) (bytes_to_list b)) ((Err why) why)) "{\"a\":[1,2]}\n")
       (check_str "not JSON" (match (json_line (bytes_from_list "{\"a\":}")) ((Ok b) (bytes_to_list b)) ((Err why) why)) "not JSON: at 5: not a value")))

(def test_served () int
  (add (check_bool "200" (served 200) true)
       (add (check_bool "299" (served 299) true)
            (check_bool "404" (served 404) false))))

; A part that says the response failed ends the command with 1.
(def test_part_failed () int
  (match (got_part (opts_or "h/") (Got 0 (nil int) (nil bytes) (sse_new)) (HttpFailed "the connection reset"))
    ((Step g st) (check_int "failed" st 1))))

; For -j a body's pieces are kept, not written, until the end.
(def test_part_json_kept () int
  (match (got_part (opts_or "-j h/") (Got 200 "OK" (nil bytes) (sse_new)) (HttpBody (bytes_from_list "[1")))
    ((Step g st)
      (match g ((Got code reason pieces sse) (add (check_int "goes on" st -1) (check_int "kept" (length pieces) 1)))))))

; A status that is not 2xx fails, once the body is over.
(def test_part_end_404 () int
  (match (got_part (opts_or "h/") (Got 404 "Not Found" (nil bytes) (sse_new)) (HttpEnd true))
    ((Step g st) (check_int "failed" st 1))))

; Under an operating system there is no network, nor l0 test's arguments a
; URL.
(def test_no_network () int
  (add (check_int "no arguments" (http) 1)
       (match (url_of "10.0.2.2/")
         ((Err why) (fail_because "url" why))
         ((Ok u) (check_int "no inet" (fetch (inet_open) 0 (opts_or "10.0.2.2/") u) 1)))))
