; http.l0 -- asks a server over HTTP/1.1, through the network stack's
; TCP, with the client library (proto/httpc.l0):
;
;   http [-i] [-j] [-e] [-d BODY] [-H NAME:VALUE]... [http://]HOST[:PORT][/PATH]
;                           GET of PATH (/ if none) of the server at
;                           HOST, port 80 if none, or with -d a POST of
;                           BODY, as application/json unless a -H names
;                           the Content-Type; the body written to
;                           standard output as each piece comes. -i
;                           writes the head first; -j reads the body as
;                           JSON and writes it back compact on one line,
;                           or says where it is not JSON and fails; -e
;                           reads it as an event stream, and writes a
;                           line EVENT DATA for each event as it comes,
;                           its data's newlines as spaces
;
; HOST is a name, which inet's name server resolves, or an address
; dotted. A header is one word, NAME:VALUE, as the shell does not quote.
; It sends one request and reads the one response, whose end, by its
; length, its last chunk or the connection's close, ends it; it does not
; follow a redirect. A status other than 2xx is said on standard error
; and fails the command, after the body.

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "http" why))

; How long to wait for the server to say anything more.
(def idle_ns () int 10000000000)

; ---------------------------------------------------------------------- URLs

; A page asked for: the server, its name or its address dotted, and its
; port, the path, and the host as the request names it.
(data Url (Url (list int) int (list int) (list int)))

; The URL s names, which may leave out the http://.
(def url_of ((s (list int))) (Result Url (list int))
  (let rest (if (starts_with s "http://") (drop_n s 7) s)
    (if (contains (up_to 47 rest) "/")
        ((Err Url (list int)) "no path to a page here")
        (if (if (starts_with rest "https://") true (contains (up_to 47 rest) "@"))
            ((Err Url (list int)) "only http:// is spoken")
            (url_parts (up_to 47 rest) (let p (drop_n rest (length (up_to 47 rest))) (if (is_empty p) "/" p)))))))

; The URL of a host and port as hostport, `ADDR` or `ADDR:PORT`, and path.
(def url_parts ((hostport (list int)) (path (list int))) (Result Url (list int))
  (let server (up_to 58 hostport)
    (if (not (dns_name_ok server))
        ((Err Url (list int)) (append "not a name or an address: " server))
        (let after (drop_n hostport (length server))
          (if (is_empty after)
              ((Ok Url (list int)) (Url server 80 path hostport))
              (match (word_number (drop_n after 1))
                ((None) ((Err Url (list int)) (append "not a port: " (drop_n after 1))))
                ((Some port)
                  (if (if (ge port 1) (le port 65535) false)
                      ((Ok Url (list int)) (Url server port path hostport))
                      ((Err Url (list int)) "a port is 1 to 65535")))))))))

; ------------------------------------------------------------------ options

; What was asked: whether to write the head, read the body as JSON, or
; as events; the body to post, if any; the headers given; and the URL.
(data Opts (Opts bool bool bool (Option (list int)) (list HttpHeader) (list int)))

; How the command is used.
(def usage () (list int) "http [-i] [-j] [-e] [-d BODY] [-H NAME:VALUE]... URL")

; The options the words ws give, or why they give none.
(def opts_of ((ws (list (list int)))) (Result Opts (list int))
  (opts_from ws (Opts false false false ((None (list int))) (nil HttpHeader) (nil int))))

; The rest of opts_of, after o so far.
(def opts_from ((ws (list (list int))) (o Opts)) (Result Opts (list int))
  (match o
    ((Opts show json events body hs url)
      (if (is_empty ws)
          (if (is_empty url) ((Err Opts (list int)) (usage)) ((Ok Opts (list int)) (Opts show json events body (rev hs) url)))
          (let w (head ws)
            (if (eq w "-i") (opts_from (tail ws) (Opts true json events body hs url))
            (if (eq w "-j") (opts_from (tail ws) (Opts show true events body hs url))
            (if (eq w "-e") (opts_from (tail ws) (Opts show json true body hs url))
            (if (if (eq w "-d") true (eq w "-H")) (opts_valued w (tail ws) o)
            (if (if (is_empty url) (not (starts_with w "-")) false) (opts_from (tail ws) (Opts show json events body hs w))
            ((Err Opts (list int)) (usage))))))))))))

; The option w, -d or -H, and its value, the first of ws.
(def opts_valued ((w (list int)) (ws (list (list int))) (o Opts)) (Result Opts (list int))
  (if (is_empty ws)
      ((Err Opts (list int)) (append w " needs a value"))
      (match o
        ((Opts show json events body hs url)
          (if (eq w "-d")
              (opts_from (tail ws) (Opts show json events (Some (head ws)) hs url))
              (let c (find_index 58 (head ws))
                (if (le c 0)
                    ((Err Opts (list int)) (append "not NAME:VALUE: " (head ws)))
                    (opts_from (tail ws) (Opts show json events body (cons (HttpHeader (take (head ws) c) (http_trim (drop_n (head ws) (add c 1)))) hs) url)))))))))

; The index of the first c in s, or -1.
(def find_index ((c int) (s (list int))) int (find_from c s 0))
(def find_from ((c int) (s (list int)) (i int)) int
  (if (is_empty s) -1 (if (eq (head s) c) i (find_from c (tail s) (add i 1)))))

; The method o asks with: POST with a body, GET without.
(def opts_method ((o Opts)) (list int)
  (match o ((Opts show json events body hs url) (match body ((Some b) "POST") ((None) "GET")))))

; The headers o's request sends: a User-Agent, then a Content-Type of
; application/json for a body unless one is given, then those given.
(def request_headers ((o Opts)) (list HttpHeader)
  (match o
    ((Opts show json events body hs url)
      (let typed (match body
                   ((None) hs)
                   ((Some b) (match (http_header hs "Content-Type")
                               ((Some t) hs)
                               ((None) (cons (HttpHeader "Content-Type" "application/json") hs)))))
        (cons (HttpHeader "User-Agent" "l0s-http") typed)))))

; o's body, as bytes; none is empty.
(def post_body ((o Opts)) bytes
  (match o ((Opts show json events body hs url) (match body ((Some b) (bytes_from_list b)) ((None) (bytes_from_list (nil int)))))))

; ------------------------------------------------------------------ writing

; A response's head as -i writes it: its status and reason, each header
; NAME: VALUE, and a blank line.
(def head_text ((code int) (reason (list int)) (hs (list HttpHeader))) (list int)
  (rev (push "\n" (head_lines hs (push "\n" (push reason (push " " (push (digits code) (nil int)))))))))

; Each of hs as a line, onto acc, reversed.
(def head_lines ((hs (list HttpHeader)) (acc (list int))) (list int)
  (if (is_empty hs)
      acc
      (match (head hs) ((HttpHeader n v) (head_lines (tail hs) (push "\n" (push v (push ": " (push n acc)))))))))

; An event's line: its name, a space, its data with newlines as spaces.
(def event_line ((e SseEvent)) (list int)
  (append (bytes_to_list (sse_name e)) (cons 32 (append (spaced (bytes_to_list (sse_data e)) (nil int)) "\n"))))

; s with each newline a space.
(def spaced ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s) (rev acc) (spaced (tail s) (cons (if (eq (head s) 10) 32 (head s)) acc))))

; The JSON body b, written back compact on a line; or why it is not JSON.
(def json_line ((b bytes)) (Result bytes (list int))
  (match (json_whole b 0 (bytes_len b))
    ((Err why) ((Err bytes (list int)) (append "not JSON: " why)))
    ((Ok v) ((Ok bytes (list int)) (bytes_concat (cons (json_bytes v) (cons (bytes_from_list "\n") (nil bytes))))))))

; Whether a status code says the request was served.
(def served ((code int)) bool (if (ge code 200) (lt code 300) false))

; s on standard output.
(def out_text ((s (list int))) int (out_bytes (bytes_from_list s)))

; b on standard output.
(def out_bytes ((b bytes)) int (file_write_bytes (IoFile 1) b 0 (bytes_len b)))

; What was written delivered, so it shows as it comes.
(def out_flush () int (if (is_done (file_flush (IoFile 1))) 0 1))

; ---------------------------------------------------------------- the response

; How far the response has come: its status and reason, 0 until its head
; has come; the JSON body's pieces so far, reversed; and the event
; stream's reader.
(data Got (Got int (list int) (list bytes) Sse))

; What a part did to the response: the response after it, and -1 while
; more is to come, or the command's exit status once it is over.
(data Step (Step Got int))

; g after part p, for o: the step, with -1 while more is to come, or the
; exit status once the response is over.
(def got_part ((o Opts) (g Got) (p HttpPart)) Step
  (match g
    ((Got code reason pieces sse)
      (match p
        ((HttpHead c r hs)
          (let w (if (opts_show o) (out_text (head_text c r hs)) 0) (Step (Got c r pieces sse) -1)))
        ((HttpBody d) (got_body o g d))
        ((HttpEnd keep) (Step g (got_end o g)))
        ((HttpBad why) (Step g (complain why)))
        ((HttpFailed why) (Step g (complain why)))))))

; Whether o writes the head, reads JSON, reads events.
(def opts_show ((o Opts)) bool (match o ((Opts show json events body hs url) show)))
(def opts_json ((o Opts)) bool (match o ((Opts show json events body hs url) json)))
(def opts_events ((o Opts)) bool (match o ((Opts show json events body hs url) events)))

; A piece d of the body: kept for JSON, read for events, each event's
; line written and delivered, or written as it is.
(def got_body ((o Opts) (g Got) (d bytes)) Step
  (match g
    ((Got code reason pieces sse)
      (if (opts_json o)
          (Step (Got code reason (cons d pieces) sse) -1)
          (if (opts_events o)
              (match (sse_more sse d 0 (bytes_len d))
                ((SseMore s2 es)
                  (let w (write_events es)
                    (Step (Got code reason pieces s2) -1))))
              (let w (out_bytes d) (Step g -1)))))))

; Each of es's lines written, and delivered.
(def write_events ((es (list SseEvent))) int
  (if (is_empty es) (out_flush) (let w (out_text (event_line (head es))) (write_events (tail es)))))

; The response over: the JSON written, or why it is not; then the status
; said if it is not 2xx.
(def got_end ((o Opts) (g Got)) int
  (match g
    ((Got code reason pieces sse)
      (let st (if (opts_json o)
                  (match (json_line (bytes_concat (rev pieces)))
                    ((Ok b) (out_bytes b))
                    ((Err why) (let f (out_flush) (complain why))))
                  0)
        (let f (out_flush)
          (if (not (eq st 0))
              st
              (if (served code) 0 (complain (append (digits code) (append " " reason))))))))))

; ------------------------------------------------------------------- asking

; What the arguments ask.
(def http () int
  (match (opts_of (args))
    ((Err why) (complain why))
    ((Ok o)
      (match o
        ((Opts show json events body hs u)
          (match (url_of u)
            ((Err why) (complain why))
            ((Ok url) (fetch (inet_open) (port_new) o url))))))))

; o asked of the server url names, through inet n, its notices to np.
(def fetch ((n Inet) (np int) (o Opts) (u Url)) int
  (match u
    ((Url server port path host)
      (match (http_connect n np server port)
        ((Err why) (complain why))
        ((Ok c)
          (match (http_ask c (opts_method o) path (request_headers o) (post_body o))
            ((HttpGot c2 parts) (fed o c2 (Got 0 (nil int) (nil bytes) (sse_new)) parts))))))))

; parts dealt with in order, then the next waited for, until the
; response is over: the exit status.
(def fed ((o Opts) (c HttpConn) (g Got) (parts (list HttpPart))) int
  (if (is_empty parts)
      (match (http_next c (add (clock_ns) (idle_ns)))
        ((HttpGot c2 ps)
          (if (is_empty ps)
              (let r (http_close c2) (let f (out_flush) (complain "the server did not answer")))
              (fed o c2 g ps))))
      (match (got_part o g (head parts))
        ((Step g2 st)
          (if (lt st 0)
              (fed o c g2 (tail parts))
              (let r (http_close c) st))))))
