; tftp_test.l0 -- tests of tftp.l0: its packets, as RFC 1350 lays them out.

(def test_rrq () int
  (check_str "opcode 1, the file, octet" (rrq "a.txt") (append (cons 0 (cons 1 "a.txt")) (cons 0 (append "octet" (cons 0 (nil int)))))))

(def test_ack () int
  (check_str "opcode 4, block 258" (ack 258) (cons 0 (cons 4 (cons 1 (cons 2 (nil int)))))))

(def packet_text ((p Packet)) (list int)
  (match p
    ((Block n bs) (append "block " (append (digits n) (append " " bs))))
    ((Failure msg) (append "failure " msg))
    ((Strange) "strange")))

(def test_packet_of () int
  (add (check_str "data" (packet_text (packet_of (cons 0 (cons 3 (cons 0 (cons 7 "abc")))))) "block 7 abc")
       (add (check_str "an error" (packet_text (packet_of (append (cons 0 (cons 5 (cons 0 (cons 1 "File not found")))) (cons 0 (nil int)))))
                       "failure File not found")
            (check_str "an ack" (packet_text (packet_of (ack 1))) "strange"))))

; An empty last block is a block too: a file of 512 bytes ends with one.
(def test_empty_block () int
  (check_str "block 2" (packet_text (packet_of (cons 0 (cons 3 (cons 0 (cons 2 (nil int))))))) "block 2 "))

; Under an operating system, l0 test's arguments are no address.
(def test_bad_arguments () int
  (check_int "fails" (tftp) 1))
