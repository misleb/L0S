; agent_test.l0 -- what agent writes for each notice, and what a line
; typed means.

(def bb ((s (list int))) bytes (bytes_from_list s))

; An event shown, as text: what is written, then | and s if the console
; is then at a line's start, d if the turn is done.
(def shown_text ((e AgentEvent) (at_start bool)) (list int)
  (match (shown e at_start)
    ((Shown out start done) (append (bytes_to_list out) (append "|" (append (if start "s" "") (if done "d" "")))))))

(def test_text () int
  (add (check_str "piece" (shown_text (AgentText(bb "Made it")) true) "Made it|")
       (check_str "ends a line" (shown_text (AgentText(bb "done.\n")) false) "done.\n|s")))

(def test_text_empty () int
  (check_str "empty" (shown_text (AgentText(bb "")) true) "|s"))

(def test_tool () int
  (add (check_str "at start" (shown_text (AgentTool"make_dir" (bb "{\"path\":\"notes\"}")) true) "[make_dir {\"path\":\"notes\"}]\n|s")
       (check_str "after text" (shown_text (AgentTool"sh" (bb "{}")) false) "\n[sh {}]\n|s")))

(def test_result () int
  (add (check_str "ok" (shown_text (AgentResult"run" false (bb "exit 0\nhi")) true) "[ok]\n|s")
       (check_str "failed" (shown_text (AgentResult"run" true (bb "exit 1\nhello: no")) true) "[failed: exit 1]\n|s")))

(def test_compacted () int
  (check_str "compacted" (shown_text (AgentCompacted 120000 9000) false) "\n[compacted]\n|s"))

(def test_error () int
  (check_str "error" (shown_text (AgentError(bb "Overloaded")) true) "agent: Overloaded\n|s"))

(def test_done () int
  (add (check_str "after text" (shown_text (AgentDone"end_turn") false) "\n|sd")
       (check_str "at start" (shown_text (AgentDone"stopped") true) "|sd")))

; What the person said is on the console already, as they typed it, and
; the conversation so far is not shown.
(def test_said_opened () int
  (add (check_str "said" (shown_text (AgentSaid "app" (bb "hi")) true) "|s")
       (check_str "opened" (shown_text (AgentOpened false) false) "|")))

(def typed_text ((t Typed)) (list int)
  (match t ((TypedEnd) "end") ((TypedClear) "clear") ((TypedBlank) "blank") ((TypedSay s) (append "say " s))))

(def test_typed () int
  (add (check_str "say" (typed_text (typed_of "make a note\n")) "say make a note")
       (add (check_str "exit" (typed_text (typed_of " /exit \n")) "end")
            (add (check_str "end" (typed_text (typed_of "")) "end")
                 (check_str "blank" (typed_text (typed_of "  \n")) "blank")))))

(def test_typed_clear () int
  (add (check_str "clear" (typed_text (typed_of "/clear\n")) "clear")
       (check_str "said" (typed_text (typed_of "/clear it all\n")) "say /clear it all")))

; Under an operating system there is no kernel.
(def test_no_kernel () int
  (check_int "fails" (agent) 1))
