; home_test.l0 -- agent's commands on the home: the history's lines, the
; backup's archive read back as an archive, and what backup and restore
; say.

(def hb ((s (list int))) bytes (bytes_from_list s))

; Two entries, and only one path's.
(def test_history_lines () int
  (let es (cons (HistEntry 1 0 "5.1" "new" "/h/a") (cons (HistEntry 2 0 "5.1" "changed" "/h/b") (nil HistEntry)))
    (add (check_str "all" (history_lines es "" (nil int)) "1  -  5.1  new  /h/a\n2  -  5.1  changed  /h/b\n")
         (check_str "one" (history_lines es "/h/b" (nil int)) "2  -  5.1  changed  /h/b\n"))))

; The archive of a directory and a file in it, read back: the directory
; first, then the file, its bytes in place.
(def test_archive () int
  (let a (archive_of (cons (Held "memory" ((None bytes))) (cons (Held "memory/MEMORY.md" (Some (hb "# Memory\n"))) (nil Held))))
    (match (parse_initramfs a)
      ((Err why) (fail_because "parsed" why))
      ((Ok es)
        (let (d (array_get es 0) f (array_get es 1))
          (add (check_str "dir" (append (.path d) (if (entry_is_dir d) "/" "")) "/memory/")
               (add (check_str "file" (.path f) "/memory/MEMORY.md")
                    (check_str "its bytes" (bytes_to_list (bytes_slice a (.start f) (.end f))) "# Memory\n"))))))))

; An empty home is an archive of no entries, the trailer alone.
(def test_archive_empty () int
  (match (parse_initramfs (archive_of (nil Held)))
    ((Err why) (fail_because "parsed" why))
    ((Ok es) (check_int "entries" (array_len es) 0))))

(def test_held_count () int
  (check_int "files" (held_files_count (cons (Held "d" ((None bytes))) (cons (Held "d/f" (Some (hb "x"))) (nil Held))) 0) 1))

; 2048 bytes is format_size's 2.0 KB.
(def test_backup_line () int
  (check_str "said" (backup_line "/Volumes/data/agent" 3 2 2048)
    (append "backed up /Volumes/data/agent: 3 files and 2 directories, " (append (format_size 2048) " to the host\n"))))

(def test_restore_line () int
  (check_str "said" (restore_line (Restored 2 5 1 (nil int))) "restored 2 files (5 the same already) and 1 directories\n"))

(def test_left_lines () int
  (check_str "left"
    (left_lines "/h" (cons (Held "a" (Some (hb "x"))) (cons (Held "b" (Some (hb "y"))) (nil Held))) (cons "a" (nil (list int))) (nil int))
    "left as it was, not in the backup: /h/b\n"))

; The history's own files are not said, as the restore adds to them.
(def test_left_not_history () int
  (check_str "none" (left_lines "/h" (cons (Held ".history/7" (Some (hb "x"))) (nil Held)) (nil (list int)) (nil int)) ""))

; Under an operating system there is no kernel: the history of a home
; that is not there is none, said.
(def test_no_history () int
  (check_int "status" (history_said "build/agent_home_test_none" (nil (list int))) 0))
