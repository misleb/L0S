; play_test.l0 -- tests of play.l0.

(def test_usage () int
  (check_int "status" (play_main (nil (list int))) 1))

(def test_no_file () int
  (check_int "status" (play_main (cons "/no/such.wav" (nil (list int)))) 1))

(def test_bad_wav () int
  (check_int "status" (play_wav (bytes_from_list "nope") (parse_wav (bytes_from_list "nope"))) 1))

(def test_rate_refused () int
  (let b (bytes_from_list (append (wav_header 22050 2 4) "abcd"))
    (check_int "status" (play_wav b (parse_wav b)) 1)))

; Under an operating system there is no audio driver.
(def test_no_driver () int
  (let b (bytes_from_list (append (wav_header 48000 2 4) "abcd"))
    (check_int "status" (play_wav b (parse_wav b)) 1)))
