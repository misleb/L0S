; play.l0 -- plays a WAV file of 16-bit PCM, one channel or two, at any
; rate from 8 to 192 kHz, through the audio server (audio.l0): a stream
; opened at the file's rate and channels on the default output, or on
; the device given, its samples offered a buffer at a time through
; pages shared with the server, each offer again from where the server
; stopped taking, until all are taken and played. The server converts
; them to the output's rate and mixes them with whatever else plays. A
; file it cannot play, or no server, is said on standard error, and it
; exits 1.
;
;   play FILE [ID]    FILE on the default output, or on device ID, as
;                     sound lists them

; What ends play, said as play on standard error: 1.
(def complain ((why (list int))) int (complain_as "play" why))

; Pages in the buffer the samples go through: 16 KB, 4096 stereo frames.
(def play_pages () int 4)

; Plays the file its first argument names, on the device its second
; names if it does.
(def play_main ((as (list (list int)))) int
  (if (or (is_empty as) (or (gt (length as) 2) (and (eq (length as) 2) (not (is_number (nth as 1))))))
      (complain "usage: play FILE [ID]")
      (match (read_whole (head as))
        ((Err why) (complain (append (head as) (append ": " why))))
        ((Ok b) (play_wav b (parse_wav b) (if (eq (length as) 2) (int_prefix (nth as 1) 0) 0))))))

; The sound w of b played on device dev, 0 for the default: 0, or 1 if
; it cannot be.
(def play_wav ((b bytes) (w Wav) (dev int)) int
  (match w
    ((WavBad why) (complain why))
    ((Wav rate chans s e)
      (if (not (pcm_format_ok (PcmFormat rate chans 2)))
          (complain (append "a WAV file at " (append (digits rate) " Hz; 8000 to 192000 are played")))
          (match (audio_open)
            ((NoAudio why) (complain why))
            ((Audio port rp pid) (play_at (Audio port rp pid) b rate chans s e dev)))))))

; The samples of b from s up to e played at rate on a stream of chans
; channels on dev: opened, played whole, drained and closed.
(def play_at ((a Audio) (b bytes) (rate int) (chans int) (s int) (e int) (dev int)) int
  (match (audio_stream a rate chans dev)
    ((Err why) (complain why))
    ((Ok n)
      (match (audio_buffer a (play_pages))
        ((NoAudioBuf why) (complain why))
        ((AudioBuf va pages there r)
          (let (why (audio_play_all a (AudioBuf va pages there r) n b s e (wav_frame_bytes chans))
                why2 (if (is_empty why) (audio_drained a n) why)
                c (audio_close a n))
            (if (is_empty why2) 0 (complain why2))))))))
