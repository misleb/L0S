; hello.l0 -- the smallest process: says who it is and what it was given,
; and answers one line of input: its terminal's, if it has one (a shell
; gives it its own); else, with a console driver running,
; it prompts and reads the line typed there; without one, it reads its
; standard input, the file the inittab names as stdin.

(def greeting ((pid int) (argv (list (list int)))) (list int)
  (let (a (push "hello from pid " (nil int))
        b (push (digits pid) a)
        c (push (if (is_empty argv) ", no arguments" ", arguments:") b))
    (rev (push "\n" (push_words argv c)))))

(def push_words ((ws (list (list int))) (acc (list int))) (list int)
  (if (is_empty ws)
      acc
      (push_words (tail ws) (push (head ws) (push " " acc)))))

(def reply ((line (list int))) (list int)
  (if (is_empty line)
      "hello: no input\n"
      (append "hello: you said " (append (take_line line) "\n"))))

(def prompt () (list int) "hello: say something: ")

; With a terminal, as a shell gives the programs it runs, the line is
; read from it, its standard input: so a program agentd runs, on a
; terminal of agentd's with no input, reads none, and never takes a
; line typed at the console.
(def hello () int
  (let w (write_str (greeting (l0s_pid) (args)))
    (match (tty_get)
      ((Terminal t) (let (p (write_str (prompt)) f (file_flush (IoFile 1))) (write_str (reply (read_line)))))
      ((KernelTerminal)
        (match (console_port)
          ((NotFound) (write_str (reply (read_line))))
          ((Found console)
            (let (p (write_str (prompt))
                  f (file_flush (IoFile 1)))                  ; shown before the wait
              (write_str (reply (console_line_on console (port_new)))))))))))
