(def count_text ((r (Result int (list int)))) (list int)
  (match r ((Ok n) (digits n)) ((Err why) why)))

(def test_count () int
  (add (check_str "default" (count_text (random_count (nil (list int)))) "16")
       (add (check_str "given" (count_text (random_count (split_spaces "4"))) "4")
            (check_str "not a number" (count_text (random_count (split_spaces "x"))) "the count is a number"))))

(def test_count_refused () int
  (check_str "too many" (count_text (random_count (split_spaces "2000"))) "a request asks for 1 to 1024 bytes"))

(def test_line () int
  (check_str "hex" (random_line (cons 1 (cons 254 (nil int)))) "01fe\n"))

; Under an operating system there is no random.
(def test_no_random () int
  (check_int "fails" (random) 1))
