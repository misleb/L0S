; random.l0 -- writes N bytes of randomness, 16 if not given, 1 to 1024,
; as hex digits and a newline: what random, the entropy device's driver,
; gives (user/lib/proto/random.l0), or why it gives none, waiting a
; moment for the driver to register.

; The bytes argv asks for, 16 if none; or why they are not a count.
(def random_count ((argv (list (list int)))) (Result int (list int))
  (match (arg_number argv 16)
    ((None) ((Err int (list int)) "the count is a number"))
    ((Some n)
      (let why (random_refusal n)
        (if (is_empty why) ((Ok int (list int)) n) ((Err int (list int)) why))))))

; bs as the line written: their hex digits, and a newline.
(def random_line ((bs (list int))) (list int)
  (append (drop_n (random_reply bs) 7) "\n"))

; How long it waits for the driver to register random: a second, which a
; driver started with it at boot takes much less than.
(def random_wait_ns () int 1000000000)

; The bytes the arguments ask for, written as a line; 1, and why, if
; there are none.
(def random () int
  (match (random_count (args))
    ((Err why) (complain_as "random" why))
    ((Ok n)
      (match (random_bytes_waiting (port_new) n (random_wait_ns))
        ((Err why) (complain_as "random" why))
        ((Ok bs) (let w (write_str (random_line bs)) 0))))))
