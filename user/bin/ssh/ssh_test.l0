; ssh_test.l0 -- ssh's options, and what a pty's output shows on a
; terminal of lines.

; The options of the words of s, as text: port, key, user, host and the
; command, or why not.
(def opts_text ((s (list int))) (list int)
  (match (opts_of (split_spaces s))
    ((Err why) (append "! " why))
    ((Ok o) (join_with "|" (cons (digits (.port o)) (cons (.key o) (cons (.user o) (cons (.host o) (cons (join_with " " (.cmd o)) (nil (list int)))))))))))

(def test_opts_user_host () int
  (check_str "user@host" (opts_text "ann@example.com") "22||ann|example.com|"))

; The flags come before the host; the words after it are the command,
; even those that look like flags.
(def test_opts_flags_and_command () int
  (check_str "flags" (opts_text "-p 2222 -i /k -l bob h ls -l /") "2222|/k|bob|h|ls -l /"))

; The last @ divides the user from the host.
(def test_opts_last_at () int
  (check_str "a@b@h" (opts_text "a@b@h") "22||a@b|h|"))

(def test_opts_refused () int
  (add (check_str "no user" (opts_text "example.com") "! a user is needed: ssh USER@HOST, or -l USER")
       (add (check_str "no host" (opts_text "-p 22") "! ssh [-p PORT] [-i KEY] [-l USER] [USER@]HOST [COMMAND...]")
            (add (check_str "bad port" (opts_text "-p 70000 a@h") "! not a port: 70000")
                 (check_str "bad flag" (opts_text "-x a@h") "! ssh [-p PORT] [-i KEY] [-l USER] [USER@]HOST [COMMAND...]")))))

; What the bytes of s show, from plain text.
(def shown_text ((s (list int))) (list int)
  (let b (bytes_from_list s)
    (.out (shown (at_text) b 0 (bytes_len b)))))

; A prompt with bracketed paste turned on, colors and a title: the
; text alone, carriage returns and the bell gone.
(def test_shown_drops_sequences () int
  (add (check_str "csi" (shown_text "\x1b[?2004h$ ls\r\n") "$ ls\n")
       (add (check_str "colors" (shown_text "\x1b[01;34mdir\x1b[0m\r\n") "dir\n")
            (add (check_str "title" (shown_text "\x1b]0;user@host: ~\x07ok\x07\n") "ok\n")
                 (check_str "charset" (shown_text "\x1b(Bx\x1b=y") "xy")))))

; A sequence cut between two pieces is dropped whole: the filter's place
; carries over.
(def test_shown_across_pieces () int
  (let (b (bytes_from_list "a\x1b[3")
        s1 (shown (at_text) b 0 (bytes_len b))
        c (bytes_from_list "1mb")
        s2 (shown (.at s1) c 0 (bytes_len c)))
    (check_str "pieces" (append (.out s1) (.out s2)) "ab")))

; An OSC ended by ESC \ rather than BEL.
(def test_shown_osc_st () int
  (check_str "st" (shown_text "\x1b]2;t\x1b\\z") "z"))

; Under an operating system there is no terminal or network, nor are
; l0 test's arguments a host.
(def test_no_network () int
  (check_int "fails" (ssh) 255))
