; net_test.l0 -- tests of net.l0: its arguments, and what it shows.

(def gw () int 167772674)           ; 10.0.2.2

(def ping_text ((p PingArgs)) (list int)
  (match p
    ((PingBad why) why)
    ((PingArgs quiet dst count)
      (append (if quiet "quiet " "") (append (ip_text dst) (append " " (digits count)))))))

(def test_ping_args () int
  (add (check_str "3 by default" (ping_text (ping_args (cons "10.0.2.2" (nil (list int))))) "10.0.2.2 3")
       (check_str "quiet, 5" (ping_text (ping_args (cons "-q" (cons "10.0.2.2" (cons "5" (nil (list int))))))) "quiet 10.0.2.2 5")))

(def test_ping_args_bad () int
  (add (check_str "none" (ping_text (ping_args (nil (list int)))) "net ping [-q] ADDR [COUNT]")
       (add (check_str "a name" (ping_text (ping_args (cons "gateway" (nil (list int))))) "not an address: gateway")
            (check_str "none at all" (ping_text (ping_args (cons "10.0.2.2" (cons "0" (nil (list int)))))) "the count is at least 1"))))

(def test_reply_line () int
  (check_str "as ping shows it" (reply_line (gw) 2 (Replied (Pong (gw) 2 255 64) 5150000))
             "64 bytes from 10.0.2.2: seq 2 ttl 255 time 5.1 ms\n"))

(def test_no_reply_line () int
  (add (check_str "lost" (reply_line (gw) 3 (NoReply)) "no reply from 10.0.2.2: seq 3\n")
       (check_str "refused" (reply_line (gw) 3 (Refused "no route")) "net: no route\n")))

; Tenths of a millisecond, truncated: 999999 ns is 0.9.
(def test_tenths () int
  (add (check_str "under one" (tenths_ms 999999) "0.9")
       (check_str "over ten" (tenths_ms 12345678) "12.3")))

(def test_summary () int
  (check_str "counted" (ping_summary 3 2) "3 sent, 2 received"))

(def test_info_lines () int
  (check_str "as ifconfig" (info_lines (InetInfo 167772687 4294967040 (gw) (repeat 6 1)))
             "inet 10.0.2.15 netmask 255.255.255.0 gateway 10.0.2.2\nether 01:01:01:01:01:01\n"))

(def test_datagram_line () int
  (check_str "a dot for what does not print" (datagram_line (Datagram (gw) 69 7 "a\tb"))
             "from 10.0.2.2:69: a.b\n"))

; Under an operating system there is no stack.
(def test_no_inet () int
  (check_int "fails" (show_info (inet_open)) 1))

(def test_echoed () int
  (add (check_int "the count, said" (echoed 17 "closed") 0)
       (check_int "reset" (echoed 3 "reset") 1)))

; Under an operating system there is no stack to listen to, and a
; port is a number.
(def test_echo_no_inet () int
  (add (check_int "no stack" (echo_on "7") 1)
       (check_int "not a number" (echo_on "x") 1)))
