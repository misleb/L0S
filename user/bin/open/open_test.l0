; open_test.l0 -- open's arguments.

(def test_open_usage () int
  (add (check_str "no app" (open_usage (nil (list int))) "usage: open APP [ARG ...]")
       (check_str "an app" (open_usage (split_spaces "files /Volumes")) "")))

; With no app it says how it is used, and fails.
(def test_open_nothing () int
  (check_int "fails" (open_app (nil (list int))) 1))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (open_app (split_spaces "files")) 1))
