; open.l0 -- open APP [ARG ...]: the app launched, as the launcher
; launches it, through the compositor's launch: the one running asked to
; open the ARGs, paths or URLs, or else started with them, and its window
; brought to the front. APP is the app's name as the launcher shows it,
; its bundle's name, or its exec. run starts a program; open launches an
; app.

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "open" why))

; What open is told to do with argv: why it cannot, if it is given no
; app; else nothing to say.
(def open_usage ((argv (list (list int)))) (list int)
  (if (is_empty argv) "usage: open APP [ARG ...]" ""))

; The app argv names launched with the rest of argv; 0 once the
; compositor has, or 1 and why not.
(def open_app ((argv (list (list int)))) int
  (let u (open_usage argv)
    (if (not (is_empty u))
        (complain u)
        (match (compositor_open)
          ((NoCompositor why) (complain why))
          ((Compositor port rp pid s)
            (let e (compositor_launch (Compositor port rp pid s) (head argv) (tail argv))
              (if (is_empty e) 0 (complain e))))))))
