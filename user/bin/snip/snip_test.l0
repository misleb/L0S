; snip_test.l0 -- what snip's arguments ask, the default file's name, and
; a capture's words as a PNG's rows; with no kernel, no compositor.

(def ask_text ((a SnipAsk)) (list int)
  (match a
    ((SnipScreen f) (append "screen " f))
    ((SnipArea r f) (unwords (cons "area" (append (numbers_words (cons (.x r) (cons (.y r) (cons (.w r) (cons (.h r) (nil int))))))
                                                 (cons f (nil (list int)))))))
    ((SnipWrong why) (append "wrong: " why))))

(def test_ask_screen () int
  (add (check_str "none" (ask_text (snip_ask_of (nil (list int)))) "screen ")
       (check_str "file" (ask_text (snip_ask_of (split_spaces "/x.png"))) "screen /x.png")))

(def test_ask_area () int
  (add (check_str "area" (ask_text (snip_ask_of (split_spaces "1 2 30 40"))) "area 1 2 30 40 ")
       (check_str "file" (ask_text (snip_ask_of (split_spaces "1 2 30 40 /x.png"))) "area 1 2 30 40 /x.png")))

(def test_ask_wrong () int
  (add (check_str "words" (ask_text (snip_ask_of (split_spaces "a b c d"))) (append "wrong: " (snip_usage)))
       (add (check_str "empty" (ask_text (snip_ask_of (split_spaces "0 0 0 5"))) "wrong: a rectangle's width and height are at least 1")
            (check_str "count" (ask_text (snip_ask_of (split_spaces "1 2"))) (append "wrong: " (snip_usage))))))

; 2026-11-06 is day 20763 from 1970; 14:03:22 is 50602 s into it.
(def test_name () int
  (check_str "name" (snip_name (add (mul 20763 86400) 50602)) "Screenshot-2026-11-06-14-03-22.png"))

; Two pixels a row, two rows: each word's b, g, r become r, g, b, its
; fourth byte dropped.
(def test_rows () int
  (let (px (bytes_from_list (cons 1 (cons 2 (cons 3 (cons 0 (cons 4 (cons 5 (cons 6 (cons 0
             (cons 7 (cons 8 (cons 9 (cons 0 (cons 10 (cons 11 (cons 12 (cons 0 (nil int))))))))))))))))))
        rows (snip_rows px 2 2))
    (add (check_str "row 0" (bytes_to_list (head rows)) (cons 3 (cons 2 (cons 1 (cons 6 (cons 5 (cons 4 (nil int))))))))
         (check_str "row 1" (bytes_to_list (head (tail rows))) (cons 9 (cons 8 (cons 7 (cons 12 (cons 11 (cons 10 (nil int)))))))))))

; Under an operating system there is no compositor.
(def test_entry () int
  (check_int "fails" (snip_main (nil (list int))) 1))

(def test_said () int
  (check_str "said" (snip_said "/a.png" 640 400 1234) "saved /a.png, 640 x 400, 1234 bytes"))
