; fonts_test.l0 -- tests of fonts.l0: what it writes from font's replies.

(def test_listed () int
  (match (fonts_text "faces code sans" "builds 1 pages 3 128\ncode 16 9224 2")
    ((Ok t) (check_str "text" t "faces: code sans\nstrikes built: 1, pages used: 3 of 128\ncode 16         9224 bytes      held by 2\n"))
    ((Err why) (fail_because "written" why))))

(def test_listed_none () int
  (match (fonts_text "faces code" "builds 0")
    ((Ok t) (check_str "text" t "faces: code\nstrikes built: 0\n"))
    ((Err why) (fail_because "written" why))))

(def test_refused () int
  (match (fonts_text "error: lost" "builds 0")
    ((Ok t) (fail_because "written" "an error as faces"))
    ((Err why) (check_str "why" why "lost"))))

(def test_strike_line () int
  (match (strike_line (font_strike_reply 4096 128 8192 3 "code 16"))
    ((Ok t) (check_str "line" t "code 16: 3 pages\n"))
    ((Err why) (fail_because "written" why))))

(def test_strike_line_refused () int
  (match (strike_line (font_strike_error "serif 16" "no face serif"))
    ((Ok t) (fail_because "refused" t))
    ((Err why) (check_str "why" why "serif 16: no face serif"))))

; The strikes asked, two words each.
(def test_strike_keys () int
  (add (check_str "two" (match (strike_keys (split_spaces "sans 100 code 16")) ((Some ks) (join_with "," ks)) ((None) "none")) "sans 100,code 16")
       (add (check_str "odd" (match (strike_keys (split_spaces "sans 100 code")) ((Some ks) (join_with "," ks)) ((None) "none")) "none")
            (check_str "no height" (match (strike_keys (split_spaces "sans x")) ((Some ks) (join_with "," ks)) ((None) "none")) "none"))))

; Under an operating system there is no font service.
(def test_no_service () int
  (check_int "fails" (fonts) 1))
