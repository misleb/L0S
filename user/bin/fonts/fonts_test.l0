; fonts_test.l0 -- tests of fonts.l0: what it writes from font's replies.

(def test_listed () int
  (match (fonts_text "faces code sans" "builds 1\ncode 16 9224 2")
    ((Ok t) (check_str "text" t "faces: code sans\nstrikes built: 1\ncode 16         9224 bytes      shared with 2\n"))
    ((Err why) (fail_because "written" why))))

(def test_listed_none () int
  (match (fonts_text "faces code" "builds 0")
    ((Ok t) (check_str "text" t "faces: code\nstrikes built: 0\n"))
    ((Err why) (fail_because "written" why))))

(def test_refused () int
  (match (fonts_text "error: lost" "builds 0")
    ((Ok t) (fail_because "written" "an error as faces"))
    ((Err why) (check_str "why" why "lost"))))

(def test_strike_line () int
  (match (strike_line "code" 16 (FontStrike 4096 3))
    ((Ok t) (check_str "line" t "code 16: 3 pages\n"))
    ((Err why) (fail_because "written" why))))

; Under an operating system there is no font service.
(def test_no_service () int
  (check_int "fails" (fonts) 1))
