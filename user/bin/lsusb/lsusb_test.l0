; lsusb_test.l0 -- a device's line.

; usb-kbd's configuration: one boot keyboard interface.
(def kbd_config () (list int)
  (concat (cons (bytes_of "9 2 34 0 1 1 6 160 50") (cons (bytes_of "9 4 0 0 1 3 1 1 0")
          (cons (bytes_of "9 33 17 1 0 1 34 63 0") (cons (bytes_of "7 5 129 3 8 0 7") (nil (list int))))))))

(def bytes_of ((s (list int))) (list int)
  (match (word_numbers (split_spaces s)) ((Some ns) ns) ((None) (nil int))))

(def test_line () int
  (check_str "keyboard" (device_line (UsbAttached 1 1575 1 3) ((Ok (list int) (list int)) (kbd_config)))
             "1 0627:0001 high keyboard\n"))

(def test_line_no_config () int
  (check_str "why" (device_line (UsbAttached 2 1575 1 1) ((Err (list int) (list int)) "gone"))
             "2 0627:0001 full (gone)\n"))

; Under an operating system there is no usb server.
(def test_no_usb () int
  (check_int "fails" (lsusb) 1))
