; lsusb.l0 -- lists the USB devices the usb server (xhci) has brought
; up, a line each: its number, its vendor and product ids, its speed,
; and what each of its interfaces is:
;
;   1 0627:0001 high keyboard
;   2 0627:0001 high mouse
;
; Nothing when there are none.

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "lsusb" why))

; The devices asked for, and each one's configuration.
(def lsusb () int
  (match (usb_open)
    ((NoUsb why) (complain why))
    ((Usb port rp)
      (let r (usb_ask (Usb port rp) "devices")
        (if (starts_with r "error: ")
            (complain (drop r 7))
            (say (devices_listed (Usb port rp) (usb_devices_of r) (nil int))))))))

; Each device's line, after the reversed acc.
(def devices_listed ((u Usb) (ds (list UsbAttached)) (acc (list int))) (list int)
  (if (is_empty ds)
      (rev acc)
      (devices_listed u (tail ds) (push (device_line (head ds) (usb_config u (usb_attached_dev (head ds)))) acc))))

; A device's number.
(def usb_attached_dev ((a UsbAttached)) int (match a ((UsbAttached dev vid pid speed) dev)))

; A device's line, from its configuration, or why there is none.
(def device_line ((a UsbAttached) (cfg (Result (list int) (list int)))) (list int)
  (match a
    ((UsbAttached dev vid pid speed)
      (append (unwords (cons (digits dev) (cons (append (usb_id_text vid) (append ":" (usb_id_text pid)))
                       (cons (usb_speed_name speed) (cfg_words cfg)))))
              "\n"))))

; What each interface is, or why the configuration could not be read.
(def cfg_words ((cfg (Result (list int) (list int)))) (list (list int))
  (match cfg
    ((Err why) (cons (append "(" (append why ")")) (nil (list int))))
    ((Ok bs)
      (match (usb_config_of bs)
        ((Err why) (cons (append "(" (append why ")")) (nil (list int))))
        ((Ok c) (match c ((UsbConfig v t ifs) (names_of ifs (nil (list int))))))))))

; Each interface's name, after the reversed acc.
(def names_of ((ifs (list UsbInterface)) (acc (list (list int)))) (list (list int))
  (if (is_empty ifs) (rev acc) (names_of (tail ifs) (cons (usb_interface_name (head ifs)) acc))))
