(def reply_text ((r Reply)) (list int)
  (match r
    ((Drawn) "done")
    ((Said s) (append "said " s))
    ((Failed why) (append "failed " why))))

(def test_reply_of () int
  (add (check_str "ok" (reply_text (reply_of "ok")) "done")
       (add (check_str "size" (reply_text (reply_of "size 1280 800")) "said 1280x800")
            (check_str "font" (reply_text (reply_of "font 8 16")) "said 8x16"))))

(def test_reply_of_errors () int
  (add (check_str "error" (reply_text (reply_of "error: no command blah")) "failed no command blah")
       (check_str "other" (reply_text (reply_of "huh")) "failed the compositor said huh")))

(def test_usage_lists_commands () int
  (add (check_true "line" (starts_with (drop_n (usage) 28) "  line"))
       (check_int "a header, 13 commands, 5 on their arguments" (newlines (usage) 0) 19)))

(def newlines ((s (list int)) (n int)) int
  (if (is_empty s) n (newlines (tail s) (if (eq (head s) 10) (add n 1) n))))

; Under an operating system there is no kernel, so no compositor.
(def test_no_compositor () int
  (check_true "fails" (eq (compositor_open) (NoCompositor "no compositor; is wm running?"))))
