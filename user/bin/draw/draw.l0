; draw.l0 -- paints the desktop, behind the windows: sends the compositor,
; user/wm, the command its arguments make, as desktop CMD, and says what
; came back. The commands, and their colors, are the toolkit's
; (user/lib/ui/draw_cmd.l0): render.l0's shapes, the toolkit's rounded
; rectangles and buttons, and Adwaita's palette by name. A command is
; parsed here first, so a mistake is told without asking the compositor.
; The compositor draws, and shows the change before it answers.
;
;   run draw line 0 0 1279 799 red
;   run draw circle 640 400 200 cyan
;   run draw round 100 100 300 200 12 blue_3

(def usage () (list int)
  (append "usage: draw COMMAND, one of\n"
  (append "  line X0 Y0 X1 Y1 [COLOR]   a line, both ends included\n"
  (append "  circle CX CY R [COLOR]     a circle's outline\n"
  (append "  disc CX CY R [COLOR]       a filled circle\n"
  (append "  rect X Y W H [COLOR]       a rectangle's outline\n"
  (append "  fill X Y W H [COLOR]       a filled rectangle\n"
  (append "  clear [COLOR]              the whole desktop, black unless given\n"
  (append "  char X Y CODE [COLOR]      a character, 8 by 16, its code 32 to 126\n"
  (append "  round X Y W H R [COLOR]    a filled rectangle, its corners of radius R\n"
  (append "  button X Y KIND LABEL      a button: regular, flat, suggested, destructive\n"
  (append "  splash [PERCENT]           the wallpaper, as bright as given\n"
  (append "  restore X Y W H            the wallpaper back, as splash last drew it\n"
  (append "  size                       print the desktop's width and height\n"
  (append "  font                       print a character's width and height\n"
  (append "Pixels count from 0, 0 at the top left. COLOR is white unless given:\n"
  (append "white black red green blue yellow cyan magenta amber gray, RRGGBB, or\n"
  (append "Adwaita's: blue_1 to blue_5, and green_, yellow_, orange_, red_, purple_,\n"
  (append "brown_, light_, and dark_ the same; accent destructive success warning error.\n"
          "Commands separated by ; are done together, and shown at once.\n")))))))))))))))))))

; What a reply means: done, a size to print, or why not.
(data Reply (Drawn) (Said (list int)) (Failed (list int)))

(def reply_of ((payload (list int))) Reply
  (if (eq payload "ok")
      (Drawn)
      (if (if (starts_with payload "size ") true (starts_with payload "font "))
          (Said (size_line (drop_n payload 5)))
          (Failed (wm_error payload)))))

; "1280 800" as 1280x800.
(def size_line ((wh (list int))) (list int)
  (let ws (split_spaces wh)
    (if (eq (length ws) 2) (append (head ws) (append "x" (head (tail ws)))) wh)))

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "draw" why))

(def draw () int
  (let argv (args)
    (if (is_empty argv)
        (write_str (usage))
        (match (ui_parse_draw argv)
          ((Err why) (complain why))
          ((Ok d)
            (match (compositor_open)
              ((NoCompositor why) (complain why))
              ((Compositor port rp pid)
                (told (reply_of (compositor_ask (Compositor port rp pid) (append "desktop " (unwords argv))))))))))))

(def told ((r Reply)) int
  (match r
    ((Drawn) 0)
    ((Said line) (write_line line))
    ((Failed why) (complain why))))
