(def test_report () int
  (add (check_str "long enough" (nap_report 20 20000000) "nap: slept at least 20 ms\n")
       (check_str "early" (nap_report 20 5) "nap: woke early, after 5 ns\n")))

(def test_ms () int
  (add (check_true "default" (eq (nap_ms (nil (list int))) (Some 20)))
       (add (check_true "given" (eq (nap_ms (split_spaces "50")) (Some 50)))
            (check_true "not a number" (eq (nap_ms (split_spaces "x")) ((None int)))))))
