(def cmd_text ((c DiskCmd)) (list int)
  (match c
    ((DInfo) "info")
    ((DRead s k) (append "read " (append (digits s) (append " " (digits k)))))
    ((DWrite s text) (append "write " (append (digits s) (append " " text))))
    ((DZero s k) (append "zero " (append (digits s) (append " " (digits k)))))
    ((DBad why) (append "bad: " why))))

; zero SECTOR [COUNT]: one sector unless a count is given, of 1 to 128.
(def test_zero_commands () int
  (add (check_str "one" (cmd "zero 2048") "zero 2048 1")
       (add (check_str "eight" (cmd "zero 2048 8") "zero 2048 8")
            (check_str "too many" (cmd "zero 0 129") "bad: zeros is 1 to 128 sectors"))))

(def test_zeroed_line () int
  (add (check_str "one" (zeroed_line 7 1) "disk: zeroed 1 sector from 7\n")
       (check_str "eight" (zeroed_line 2048 8) "disk: zeroed 8 sectors from 2048\n")))

(def cmd ((s (list int))) (list int) (cmd_text (command_of (split_spaces s))))

(def test_commands () int
  (add (check_str "info" (cmd "info") "info")
       (add (check_str "one sector" (cmd "read 3") "read 3 1")
            (add (check_str "eight" (cmd "read 3 8") "read 3 8")
                 (check_str "words" (cmd "write 1 hello disk") "write 1 hello disk\n")))))

(def test_bad_commands () int
  (add (check_str "no count" (cmd "read 3 0") "bad: a read is 1 to 128 sectors")
       (add (check_str "not a number" (cmd "read x") "bad: a sector and a count are numbers")
            (add (check_str "nothing to write" (cmd "write 1") (append "bad: " (drop_last (usage))))
                 (check_str "unknown" (cmd "erase 1") (append "bad: " (drop_last (usage))))))))

; 511 bytes of words and a newline are 512, a sector; one more is too many.
(def test_too_many_words () int
  (add (check_str "a sector's worth" (cmd_text (command_of (cons "write" (cons "0" (cons (letters 511) (nil (list int))))))) (append "write 0 " (append (letters 511) "\n")))
       (check_str "over" (cmd_text (command_of (cons "write" (cons "0" (cons (letters 512) (nil (list int))))))) "bad: the words are over 512 bytes")))

(def letters ((n int)) (list int) (if (le n 0) (nil int) (cons 120 (letters (sub n 1)))))

(def test_sector_of () int
  (add (check_int "a sector" (length (sector_of "hi\n")) 512)
       (check_int "zeros after" (head (drop_n (sector_of "hi\n") 3)) 0)))

; mkdisk's sector 0, as disk read 0 shows it.
(def test_dump () int
  (check_str "a sector"
    (dump 0 (sector_of "L0S disk\n"))
    (append "00000000  4c 30 53 20 64 69 73 6b  0a 00 00 00 00 00 00 00  |L0S disk........|\n"
    (append "00000010  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|\n"
            "*\n00000200\n"))))

; A short last line is padded, so its text lines up.
(def test_dump_short () int
  (check_str "three bytes from 512"
    (dump 512 "abc")
    "00000200  61 62 63                                          |abc|\n00000203\n"))

; A line again after others is shown again.
(def test_dump_repeat_after () int
  (check_int "zeros, *, the x line, zeros, the end" (length (split_lines (dump 0 (append (zeros 32) (append "x" (zeros 31)))))) 5))

(def split_lines ((s (list int))) (list (list int))
  (split_at_newlines s (nil int) (nil (list int))))

(def split_at_newlines ((s (list int)) (cur (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (rev acc)
      (if (eq (head s) 10)
          (split_at_newlines (tail s) (nil int) (cons (rev cur) acc))
          (split_at_newlines (tail s) (cons (head s) cur) acc))))

; Under an operating system there is no disk.
(def test_no_disk () int
  (add (check_int "fails" (obey (DInfo) "") 1)
       (check_int "nor disk1" (obey (DInfo) "disk1") 1)))

(def test_disk_line () int
  (add (check_str "a disk" (disk_line "disk1" (Disk "disk1" 5 6 7 2048)) "disk1 2048 sectors\n")
       (check_str "none" (disk_line "disk2" (NoDisk "no disk disk2")) "disk2: no disk disk2\n")))
