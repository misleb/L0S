; disk.l0 -- looks at and writes a disk's sectors, through the disk
; protocol, user/lib/disk.l0: disk0's, or, given its name first, as disk
; disk1 info, another's:
;
;   disk list                  every disk there is, a line each: its name
;                              and size
;   disk [NAME] info           the disk's size
;   disk [NAME] read SECTOR [COUNT]
;                              COUNT sectors from SECTOR, 1 unless given,
;                              shown as hexdump -C shows bytes
;   disk [NAME] write SECTOR WORDS
;                              WORDS, spaced, and a newline, written as
;                              sector SECTOR, the rest of it zeros

(def usage () (list int)
  "usage: disk list | disk [NAME] info | disk [NAME] read SECTOR [COUNT] | disk [NAME] write SECTOR WORDS...\n")

; Fails, saying why.
(def complain ((why (list int))) int (complain_as "disk" why))

; ---------------------------------------------------------------- commands

; What the arguments ask: the disk's size, count sectors from a sector,
; text written as a sector; or why they ask nothing.
(data DiskCmd (DInfo) (DRead int int) (DWrite int (list int)) (DBad (list int)))

; The command argv, not empty, gives.
(def command_of ((argv (list (list int)))) DiskCmd
  (let op (head argv)
    (let n (length argv)
      (if (if (eq op "info") (eq n 1) false) (DInfo)
      (if (if (eq op "read") (if (eq n 2) true (eq n 3)) false) (read_of (tail argv))
      (if (if (eq op "write") (ge n 3) false) (write_of (head (tail argv)) (tail (tail argv)))
      (DBad (drop_last (usage)))))))))

; read SECTOR [COUNT].
(def read_of ((ws (list (list int)))) DiskCmd
  (let count (if (is_empty (tail ws)) "1" (head (tail ws)))
    (if (not (if (is_number (head ws)) (is_number count) false))
        (DBad "a sector and a count are numbers")
        (let k (int_prefix count 0)
          (if (if (lt k 1) true (gt k (disk_max_sectors)))
              (DBad (append "a read is 1 to " (append (digits (disk_max_sectors)) " sectors")))
              (DRead (int_prefix (head ws) 0) k))))))

; write SECTOR WORDS..., the words spaced and ended by a newline.
(def write_of ((sector (list int)) (words (list (list int)))) DiskCmd
  (let text (append (unwords words) "\n")
    (if (not (is_number sector))
        (DBad "a sector is a number")
        (if (gt (length text) (disk_sector_size))
            (DBad (append "the words are over " (append (digits (disk_sector_size)) " bytes")))
            (DWrite (int_prefix sector 0) text)))))

; text as a sector: zeros after it.
(def sector_of ((text (list int))) (list int)
  (append text (zeros (sub (disk_sector_size) (length text)))))

; ------------------------------------------------------------------ dumping

; bs as hexdump -C shows them, from offset base: 16 bytes a line, a line
; the same as the one before it shown as *, and the offset after the
; last.
(def dump ((base int) (bs (list int))) (list int)
  (concat (rev (cons (offset_line (add base (length bs))) (dump_lines base bs (nil int) false (nil (list int)))))))

; The lines of bs from offset at, prev the line before and starred
; whether a * stands for the lines since it, onto acc, newest first.
(def dump_lines ((at int) (bs (list int)) (prev (list int)) (starred bool) (acc (list (list int)))) (list (list int))
  (if (is_empty bs)
      acc
      (let line (take bs 16)
        (let rest (drop_n bs 16)
          (if (eq line prev)
              (dump_lines (add at 16) rest line true (if starred acc (cons "*\n" acc)))
              (dump_lines (add at 16) rest line false (cons (hex_line at line) acc)))))))

; The last line: the offset after the bytes.
(def offset_line ((at int)) (list int) (append (hex_digits at 8) "\n"))

; One line: the offset, the bytes in two groups of eight, and them as
; text, a dot for what does not print.
(def hex_line ((at int) (line (list int))) (list int)
  (append (hex_digits at 8)
          (append "  "
                  (append (hex_bytes (take line 8))
                          (append " "
                                  (append (hex_bytes (drop_n line 8))
                                          (append (spaces (mul 3 (sub 16 (length line))))
                                                  (append " |" (append (shown line) "|\n")))))))))

; Each byte in two hex digits, and a space.
(def hex_bytes ((bs (list int))) (list int)
  (if (is_empty bs) "" (append (hex_digits (head bs) 2) (append " " (hex_bytes (tail bs))))))

; The bytes as text: those that print, and a dot for each other.
(def shown ((bs (list int))) (list int)
  (if (is_empty bs) "" (cons (if (is_printable (head bs)) (head bs) 46) (shown (tail bs)))))

; ----------------------------------------------------------------- running

; The tool: usage with no arguments, the disks listed, else what they
; ask done, of the disk they name first or disk0.
(def disk () int
  (let argv (args)
    (if (is_empty argv)
        (write_str (usage))
        (if (eq argv (cons "list" (nil (list int))))
            (write_str (disks_listed (disk_names) (nil int)))
            (if (is_disk_name (head argv))
                (obey (command_of (tail argv)) (head argv))
                (obey (command_of argv) ""))))))

; Each disk's line: its name and size in sectors, after the reversed acc.
(def disks_listed ((names (list (list int))) (acc (list int))) (list int)
  (if (is_empty names)
      (rev acc)
      (disks_listed (tail names) (push (disk_line (head names) (disk_open_named (head names))) acc))))

; A disk's line in the list.
(def disk_line ((name (list int)) (d Disk)) (list int)
  (match d
    ((NoDisk why) (append name (append ": " (append why "\n"))))
    ((Disk nm port rp pid n) (append name (append " " (append (digits n) " sectors\n"))))))

; Does c, with the disk name, disk0 if empty, if it needs one.
(def obey ((c DiskCmd) (name (list int))) int
  (match c
    ((DBad why) (complain why))
    ((DInfo) (with_disk c (opened name)))
    ((DRead s k) (with_disk c (opened name)))
    ((DWrite s text) (with_disk c (opened name)))))

; The disk name, or disk0, waited for, if empty.
(def opened ((name (list int))) Disk
  (if (is_empty name) (disk_open) (disk_open_named name)))

; c done with d, the disk, if there is one.
(def with_disk ((c DiskCmd) (d Disk)) int
  (match d
    ((NoDisk why) (complain why))
    ((Disk name port rp pid n)
      (match c
        ((DInfo) (write_str (append "disk: " (append (digits n) (append " sectors of " (append (digits (disk_sector_size)) " bytes\n"))))))
        ((DRead s k) (read_out d s k (disk_buffer d k)))
        ((DWrite s text) (written d s text (disk_buffer d 1)))
        ((DBad why) (complain why))))))

; k sectors from s read through b, and shown.
(def read_out ((d Disk) (s int) (k int) (b DiskBuf)) int
  (match b
    ((NoDiskBuf why) (complain why))
    ((DiskBuf va n there r)
      (let why (disk_read d b s k)
        (if (is_empty why)
            (write_str (dump (mul s (disk_sector_size)) (disk_get b (mul k (disk_sector_size)))))
            (complain why))))))

; text written through b as sector s.
(def written ((d Disk) (s int) (text (list int)) (b DiskBuf)) int
  (match b
    ((NoDiskBuf why) (complain why))
    ((DiskBuf va n there r)
      (let p (disk_put b (sector_of text))
        (let why (disk_write d b s 1)
          (if (is_empty why)
              (write_str (append "disk: wrote sector " (append (digits s) "\n")))
              (complain why)))))))
