; disks.l0 -- Disks, as GNOME Disks is: a window showing the disk, its
; partitions and the volumes on them. A sidebar of drives; the selected
; drive's model, size and partitioning; a bar of its partitions and the
; free space between them, each as wide as its share of the disk; and the
; selected one's size, usage, contents, type and place.
;
; It reads the partition table and each partition's first sector itself,
; through the disk protocol (user/lib/disk.l0), so a partition no server
; serves still shows; and asks the file server (user/lib/fs.l0) how full
; each mounted volume is. Refresh has the file server read the disk again
; and mount what is new, as it does at the start; Format Volume empties a
; volume, once a dialog has asked. It keeps one reply port for the file
; server, and one buffer shared with the disk's driver, for as long as it
; runs.

; ------------------------------------------------------------------ model

; What a partition holds: a volume of L0S's file system, mounted, with
; its label, clusters of data, those free, and files; one no server
; serves, with its label; or anything else, and why it is no volume.
(data DkContent (DkVolume (list int) int int int) (DkUnmounted (list int)) (DkUnknown (list int)))

; A part of the disk: a partition, its number in the table from 1, first
; sector, sectors, its entry in the table, and what it holds; or free
; space, its first sector and sectors.
(data DkSeg (DkPart int int int GptPart DkContent) (DkFree int int))

; The drive: its sectors, whether it has a partition table, and its parts
; in order; or why there is none.
(data DkDrive (DkDrive int bool (list DkSeg)) (DkNoDrive (list int)))

; A dialog over the window: none, or asking whether to format a label.
(data DkDialog (DkNoDialog) (DkConfirm (list int)))

; The window's state: the drive, the selected part's key, the dialog, and
; a line saying what was last done.
(data Disks (Disks DkDrive (list int) DkDialog (list int)))

; A sector's bytes.
(def dk_sector () int 512)

; The prefixes of the sidebar's and the bar's actions.
(def dk_side () (list int) "side")
(def dk_vols () (list int) "vols")

; A part's key in the bar: its number, or free and its first sector.
(def dk_key ((s DkSeg)) (list int)
  (match s
    ((DkPart n start count ty c) (digits n))
    ((DkFree start count) (append "free." (digits start)))))

; ------------------------------------------------------------------ parts

; A partition as the table has it, with its number, to sort by start.
(data DkAt (DkAt int int GptPart))

; The parts of a disk of sectors whose table lists parts, each with what
; contents says it holds, in order: free space wherever no partition is,
; in the sectors the GPT leaves partitions, past the table and before
; its backup.
(def dk_segments ((sectors int) (parts (list GptPart)) (contents (list DkContent))) (list DkSeg)
  (dk_segs_from (sort (dk_numbered parts 1 (nil DkAt))) contents (gpt_first_usable) (add (gpt_last_usable sectors) 1) (nil DkSeg)))

; Each partition with its number, from n, onto acc.
(def dk_numbered ((parts (list GptPart)) (n int) (acc (list DkAt))) (list DkAt)
  (if (is_empty parts)
      acc
      (dk_numbered (tail parts) (add n 1) (cons (DkAt (gpt_part_start (head parts)) n (head parts)) acc))))

; The parts from sector at on, to end, of the partitions ats, sorted,
; onto acc.
(def dk_segs_from ((ats (list DkAt)) (contents (list DkContent)) (at int) (end int) (acc (list DkSeg))) (list DkSeg)
  (if (is_empty ats)
      (rev (if (lt at end) (cons (DkFree at (sub end at)) acc) acc))
      (match (head ats)
        ((DkAt start n p)
          (let count (gpt_part_sectors p)
            (let gap (if (gt start at) (cons (DkFree at (sub start at)) acc) acc)
              (dk_segs_from (tail ats) contents (max at (add start count)) end
                            (cons (DkPart n start count p (dk_nth contents (sub n 1))) gap))))))))

; What partition i, from 0, holds; unknown if it was not read.
(def dk_nth ((cs (list DkContent)) (i int)) DkContent
  (if (is_empty cs) (DkUnknown "not read") (if (eq i 0) (head cs) (dk_nth (tail cs) (sub i 1)))))

; What a partition's first sector, read as bs, says it holds, mounted if
; space is the answer of df: a volume of L0S's file system, or not.
(def dk_content_of ((bs (list int)) (space FsSpace)) DkContent
  (match (vol_super_of (bytes_from_list bs))
    ((VolNotSuper why) (DkUnknown why))
    ((VolSuper label l)
      (match space
        ((FsSpace sectors clusters free files) (DkVolume label clusters free files))
        ((FsSpaceRefused code) (DkUnmounted label))))))

; ------------------------------------------------------------------- text

; A size as GNOME says it: bytes below 1000, and above, to a tenth, in
; kB, MB or GB, of 1000 each.
(def dk_size_text ((bytes int)) (list int)
  (if (lt bytes 1000)
      (append (digits bytes) " bytes")
      (if (lt bytes 1000000)
          (dk_tenths bytes 1000 " kB")
          (if (lt bytes 1000000000) (dk_tenths bytes 1000000 " MB") (dk_tenths bytes 1000000000 " GB")))))

; bytes in units, to the nearest tenth, and the unit's name.
(def dk_tenths ((bytes int) (unit int) (name (list int))) (list int)
  (let t (div (add (mul bytes 10) (div unit 2)) unit)
    (append (digits (div t 10)) (append "." (append (digits (mod t 10)) name)))))

; A size, and its bytes, a comma every three digits: 1.0 MB (1,048,576
; bytes).
(def dk_size_long ((bytes int)) (list int)
  (if (lt bytes 1000)
      (dk_size_text bytes)
      (append (dk_size_text bytes) (append " (" (append (dk_grouped bytes) " bytes)")))))

; n in digits, a comma before every three from the end.
(def dk_grouped ((n int)) (list int)
  (if (lt n 1000)
      (digits n)
      (append (dk_grouped (div n 1000)) (append "," (dk_three (mod n 1000))))))

; n, below 1000, in three digits.
(def dk_three ((n int)) (list int)
  (if (lt n 10) (append "00" (digits n)) (if (lt n 100) (append "0" (digits n)) (digits n))))

; What a partition's type is called.
(def dk_type_text ((ty Uuid)) (list int)
  (if (eq ty (gpt_l0fs_type)) "L0FS" (uuid_text ty)))

; The bytes of sectors.
(def dk_bytes ((sectors int)) int (mul sectors (dk_sector)))

; A part's title and line in the bar.
(def dk_seg_title ((s DkSeg)) (list int)
  (match s
    ((DkFree start count) "Free Space")
    ((DkPart n start count ty c)
      (match c
        ((DkVolume label cl fr fi) label)
        ((DkUnmounted label) label)
        ((DkUnknown why) (append "Partition " (digits n)))))))

; A part's line: its size, and what it holds.
(def dk_seg_line ((s DkSeg)) (list int)
  (match s
    ((DkFree start count) (dk_size_text (dk_bytes count)))
    ((DkPart n start count ty c)
      (append (dk_size_text (dk_bytes count))
              (match c ((DkVolume l a b e) " L0FS") ((DkUnmounted l) " L0FS") ((DkUnknown why) " Unknown"))))))

; What a partition holds, in words.
(def dk_contents_text ((c DkContent)) (list int)
  (match c
    ((DkVolume label cl fr fi) (append "L0FS version 1 - Mounted at /Volumes/" label))
    ((DkUnmounted label) "L0FS version 1 - Not Mounted")
    ((DkUnknown why) (append "Unknown - " why))))

; How full a volume is: used, then free.
(def dk_usage_text ((clusters int) (free int)) (list int)
  (append (dk_size_text (mul (sub clusters free) (vol_cluster_size)))
          (append " used, " (append (dk_size_text (mul free (vol_cluster_size))) " free"))))

; How much of a volume is used, in percent: at least 1 if any is, so
; that the level bar shows it.
(def dk_used_pct ((clusters int) (free int)) int
  (if (le clusters 0)
      0
      (let used (sub clusters free)
        (if (le used 0) 0 (max 1 (div (mul used 100) clusters))))))

; ------------------------------------------------------------------ state

; The window's first state: the drive, its first volume selected.
(def dk_new ((d DkDrive)) Disks (Disks d (dk_first_key d) (DkNoDialog) ""))

; The key of the drive's first volume, or of its first part.
(def dk_first_key ((d DkDrive)) (list int)
  (match d
    ((DkNoDrive why) "")
    ((DkDrive n gpt segs) (dk_first_part segs (if (is_empty segs) "" (dk_key (head segs)))))))

; The key of the first partition among segs, or fallback.
(def dk_first_part ((segs (list DkSeg)) (fallback (list int))) (list int)
  (if (is_empty segs)
      fallback
      (match (head segs)
        ((DkPart n start count ty c) (dk_key (head segs)))
        ((DkFree start count) (dk_first_part (tail segs) fallback)))))

; The drive's parts, none if there is no drive; and the selected key.
(def dk_segs ((m Disks)) (list DkSeg)
  (match m ((Disks d sel dlg st) (match d ((DkDrive n gpt segs) segs) ((DkNoDrive why) (nil DkSeg))))))

(def dk_selected ((m Disks)) (list int) (match m ((Disks d sel dlg st) sel)))

; The selected part, if there is one by that key.
(def dk_selected_seg ((m Disks)) (Option DkSeg)
  (dk_seg_keyed (dk_segs m) (dk_selected m)))

; The part of segs whose key is key, if one is.
(def dk_seg_keyed ((segs (list DkSeg)) (key (list int))) (Option DkSeg)
  (if (is_empty segs) ((None DkSeg)) (if (eq (dk_key (head segs)) key) (Some (head segs)) (dk_seg_keyed (tail segs) key))))

; The label of the selected part, if it is a mounted volume, which only
; can be formatted; else empty.
(def dk_formattable ((m Disks)) (list int)
  (match (dk_selected_seg m)
    ((None) "")
    ((Some s)
      (match s
        ((DkFree start count) "")
        ((DkPart n start count ty c) (match c ((DkVolume label a b e) label) ((DkUnmounted l) "") ((DkUnknown w) "")))))))

; The window's state with the drive read again: its selection kept if
; the part is still there, and a line saying what happened.
(def dk_rescanned ((m Disks) (d DkDrive) (status (list int))) Disks
  (match m
    ((Disks old sel dlg st)
      (let m2 (Disks d sel (DkNoDialog) status)
        (match (dk_selected_seg m2)
          ((Some s) m2)
          ((None) (Disks d (dk_first_key d) (DkNoDialog) status)))))))

; ----------------------------------------------------------------- update

; The state after an action, or a key, that needs nothing read or written:
; selecting, opening the dialog and closing it. Refreshing and formatting
; are done by the loop, which reads and writes the disk.
(def dk_update ((m Disks) (action (list int)) (ev UiEvent)) Disks
  (match m
    ((Disks d sel dlg st)
      (let vk (ui_select_key (dk_vols) action)
        (if (not (is_empty vk))
            (Disks d vk dlg st)
            (if (eq action "app.format")
                (let label (dk_formattable m) (if (is_empty label) m (Disks d sel (DkConfirm label) st)))
                (if (eq action "dialog.cancel")
                    (Disks d sel (DkNoDialog) st)
                    (dk_keyed m ev))))))))

; A key: Esc closes the dialog; Left and Right move along the bar while
; there is none.
(def dk_keyed ((m Disks) (ev UiEvent)) Disks
  (match m
    ((Disks d sel dlg st)
      (match ev
        ((UiKey k)
          (match k
            ((KeyEvent code value ch)
              (if (eq value 0)
                  m
                  (match dlg
                    ((DkConfirm label) (if (eq code (ui_key_esc)) (Disks d sel (DkNoDialog) st) m))
                    ((DkNoDialog) (Disks d (ui_segbar_key (dk_segments_of m) sel code) dlg st)))))))
        ((UiPress x y b) m) ((UiRelease x y b) m) ((UiMotion x y b) m) ((UiLeave) m)
        ((UiFocus f) m) ((UiScroll x y dx dy) m) ((UiExit p s) m) ((UiOther f p) m)))))

; ------------------------------------------------------------------- view

; The window: the sidebar, a line, and the drive's pane; under the
; dialog, if one is open.
(def dk_view ((m Disks)) UiWidget
  (match m
    ((Disks d sel dlg st)
      (let page (UiBox (UiH) 0 (cons (UiSidebar (ui_sidebar_w) (dk_side_rows d) (dk_side) "0")
                                     (cons (UiSeparator (UiV))
                                           (cons (UiExpand (dk_pane m)) (nil UiWidget)))))
        (match dlg
          ((DkNoDialog) page)
          ((DkConfirm label) (UiModal page (dk_alert label))))))))

; The dialog asking whether to format label.
(def dk_alert ((label (list int))) UiWidget
  (ui_alert "Format Volume?" (cons (append "Every file on " (append label " will be lost.")) (nil (list int)))
            (cons (UiButton "dialog.cancel" "" "Cancel" (UiBtnRegular) true)
                  (cons (UiButton "dialog.format" "" "Format" (UiBtnDestructive) true) (nil UiWidget)))))

; The sidebar's rows: the drive, if there is one.
(def dk_side_rows ((d DkDrive)) (list UiSideRow)
  (match d
    ((DkNoDrive why) (nil UiSideRow))
    ((DkDrive n gpt segs) (cons (UiSideRow "0" "drive-harddisk" (dk_drive_title n) "virtio-blk") (nil UiSideRow)))))

; A drive's name, as GNOME Disks makes one: its size, and Disk.
(def dk_drive_title ((sectors int)) (list int) (append (dk_size_text (dk_bytes sectors)) " Disk"))

; The drive's pane, 18 in: its name and Refresh; its properties; the bar
; of its parts and Format Volume; the selected part's properties; and the
; line saying what was done. A status page if there is no drive.
(def dk_pane ((m Disks)) UiWidget
  (match m
    ((Disks d sel dlg st)
      (match d
        ((DkNoDrive why) (UiStatusPage "drive-harddisk" "No Disks" why))
        ((DkDrive n gpt segs)
          (UiPad (ui_space_l) (ui_space_l)
            (UiBox (UiV) (ui_space_m)
              (cons (dk_heading n)
              (cons (UiProps (dk_drive_props n gpt))
              (cons (UiLabel "Volumes" (UiHeading) (UiStart))
              (cons (UiSegmentBar (dk_vols) (dk_ui_segments segs (nil UiSegment)) sel (ui_segbar_h))
              (cons (UiBox (UiH) (ui_space_s)
                      (cons (UiButton "app.format" "" "Format Volume..." (UiBtnRegular) (not (is_empty (dk_formattable m))))
                            (nil UiWidget)))
              (cons (UiProps (dk_seg_props (dk_selected_seg m)))
              (cons (UiExpand (UiSpace 0 0))
              (cons (UiLabel st (UiDimmed) (UiStart)) (nil UiWidget))))))))))))))))

; The drive's name, large, and Refresh at the row's end.
(def dk_heading ((n int)) UiWidget
  (UiBox (UiH) (ui_space_s)
    (cons (UiLabel (dk_drive_title n) (UiLarge) (UiStart))
          (cons (UiExpand (UiSpace 0 0))
                (cons (UiButton "app.refresh" "view-refresh" "Refresh" (UiBtnFlat) true) (nil UiWidget))))))

; The drive's properties: its partitioning, a GPT if it has a table.
(def dk_drive_props ((n int) (gpt bool)) (list UiProp)
  (cons (UiProp "Model" (dk_value "virtio-blk disk"))
        (cons (UiProp "Size" (dk_value (dk_size_long (dk_bytes n))))
              (cons (UiProp "Partitioning" (dk_value (if gpt "GUID Partition Table" "None")))
                    (nil UiProp)))))

; A property's value: text.
(def dk_value ((s (list int))) UiWidget (UiLabel s (UiBody) (UiStart)))

; The parts as the bar shows them, each as wide as its sectors: a
; partition plain, free space muted, as GNOME Disks has them.
(def dk_ui_segments ((segs (list DkSeg)) (acc (list UiSegment))) (list UiSegment)
  (if (is_empty segs)
      (rev acc)
      (let s (head segs)
        (dk_ui_segments (tail segs)
          (cons (UiSegment (dk_key s) (match s ((DkPart n st c t x) c) ((DkFree st c) c)) (dk_seg_title s) (dk_seg_line s)
                           (match s ((DkPart n st c t x) (UiSegPlain)) ((DkFree st c) (UiSegMuted))))
                acc)))))

; The selected part's properties.
(def dk_seg_props ((s (Option DkSeg))) (list UiProp)
  (match s
    ((None) (nil UiProp))
    ((Some seg)
      (match seg
        ((DkFree start count)
          (cons (UiProp "Size" (dk_value (dk_size_long (dk_bytes count))))
                (cons (UiProp "Contents" (dk_value "Unallocated Space"))
                      (cons (UiProp "Location" (dk_value (dk_location start count))) (nil UiProp)))))
        ((DkPart n start count ty c)
          (cons (UiProp "Size" (dk_value (dk_size_long (dk_bytes count))))
                (append (dk_usage_props c)
                        (cons (UiProp "Contents" (dk_value (dk_contents_text c)))
                              (cons (UiProp "Partition Type" (dk_value (dk_type_text (gpt_part_type ty))))
                                    (cons (UiProp "Partition UUID" (dk_value (uuid_text (gpt_part_uuid ty))))
                                          (cons (UiProp "Device" (dk_value (append "Partition " (digits n))))
                                                (cons (UiProp "Location" (dk_value (dk_location start count))) (nil UiProp)))))))))))))

; How full a mounted volume is, and its files; nothing for any other.
(def dk_usage_props ((c DkContent)) (list UiProp)
  (match c
    ((DkVolume label clusters free files)
      (cons (UiProp "Usage" (UiBox (UiH) (ui_space_m)
                              (cons (UiLevel (dk_used_pct clusters free) 160)
                                    (cons (dk_value (dk_usage_text clusters free)) (nil UiWidget)))))
            (cons (UiProp "Files" (dk_value (digits files))) (nil UiProp))))
    ((DkUnmounted label) (nil UiProp))
    ((DkUnknown why) (nil UiProp))))

; Where a part is: its first and last sectors.
(def dk_location ((start int) (count int)) (list int)
  (append "Sectors " (append (digits start) (append "-" (digits (sub (add start count) 1))))))

; The bar's parts, as the view has them, for the keys that move along it.
(def dk_segments_of ((m Disks)) (list UiSegment) (dk_ui_segments (dk_segs m) (nil UiSegment)))

; --------------------------------------------------------------- the disk

; What the window reads and writes through: the disk, a buffer shared
; with its driver, and a port for the file server's replies.
(data DkIo (DkIo Disk DiskBuf int) (DkNoIo (list int)))

; The disk opened, its buffer made, and the reply port: once, since a
; process can open only so many regions.
(def dk_io () DkIo
  (match (disk_open)
    ((NoDisk why) (DkNoIo why))
    ((Disk port rp pid n)
      (match (disk_buffer (Disk port rp pid n) (gpt_entry_sectors))
        ((NoDiskBuf why) (DkNoIo why))
        ((DiskBuf va pages there r) (DkIo (Disk port rp pid n) (DiskBuf va pages there r) (port_new)))))))

; The drive as it is now: its GPT read, and each partition's first
; sector, and asked how full it is if it is a volume. A disk with no
; table, or a bad one, is all free space.
(def dk_read ((io DkIo)) DkDrive
  (match io
    ((DkNoIo why) (DkNoDrive why))
    ((DkIo d b rp)
      (match (dk_table d b)
        ((GptBad why) (DkDrive (disk_sectors d) false (dk_segments (disk_sectors d) (nil GptPart) (nil DkContent))))
        ((GptGot t)
          (let parts (gpt_parts t)
            (DkDrive (disk_sectors d) true (dk_segments (disk_sectors d) parts (dk_contents d b rp parts (nil DkContent))))))))))

; The disk's GPT, from its header at sector 1 and the entries it names.
(def dk_table ((d Disk) (b DiskBuf)) GptRead
  (match (dk_sectors_bytes d b 1 1)
    ((DkBytesNot why) (GptBad why))
    ((DkBytes hb)
      (match (gpt_header_of (bytes_from_list hb))
        ((GptNone) (GptBad "no partition table"))
        ((GptNotHeader why) (GptBad why))
        ((GptHeader du at count ecrc)
          (match (dk_sectors_bytes d b at (div (mul count (gpt_entry_size)) (dk_sector)))
            ((DkBytesNot why) (GptBad why))
            ((DkBytes es) (gpt_disk_of (GptHeader du at count ecrc) (bytes_from_list es)))))))))

; Sectors read, or why not.
(data DkSectorBytes (DkBytes (list int)) (DkBytesNot (list int)))

; count sectors from sector, read through b.
(def dk_sectors_bytes ((d Disk) (b DiskBuf) (sector int) (count int)) DkSectorBytes
  (let why (disk_read d b sector count)
    (if (is_empty why) (DkBytes (disk_get b (mul count (dk_sector)))) (DkBytesNot why))))

; What each partition of parts holds, onto acc.
(def dk_contents ((d Disk) (b DiskBuf) (rp int) (parts (list GptPart)) (acc (list DkContent))) (list DkContent)
  (if (is_empty parts)
      (rev acc)
      (dk_contents d b rp (tail parts)
        (cons (match (dk_sectors_bytes d b (gpt_part_start (head parts)) 1)
                ((DkBytesNot why) (DkUnknown why))
                ((DkBytes bs) (dk_content_of bs (dk_space rp bs))))
              acc))))

; How full the volume whose first sector is bs is, by df, if it is one.
(def dk_space ((rp int) (bs (list int))) FsSpace
  (match (vol_super_of (bytes_from_list bs))
    ((VolNotSuper why) (FsSpaceRefused -3))
    ((VolSuper label l) (fs_df_on rp (append "/Volumes/" label)))))

; The port the file server's replies come to, 0 for none.
(def dk_rp ((io DkIo)) int (match io ((DkIo d b rp) rp) ((DkNoIo why) 0)))

; Refresh: the file server's volumes read again and mounted, then the
; drive.
(def dk_refreshed ((io DkIo) (m Disks)) Disks
  (dk_rescanned m (dk_read io)
    (match (fs_rescan_on (dk_rp io))
      ((FsRescanned labels) (append "Refreshed: " (append (digits (length labels)) (if (eq (length labels) 1) " volume" " volumes"))))
      ((FsRescanRefused code) (append "The disk was read again; the file server would not: " (dk_fs_why code))))))

; The dialog's volume formatted, then everything read again.
(def dk_formatted ((io DkIo) (m Disks)) Disks
  (match m
    ((Disks d sel dlg st)
      (match dlg
        ((DkNoDialog) m)
        ((DkConfirm label)
          (let code (fs_format_on (dk_rp io) (append "/Volumes/" label))
            (dk_rescanned m (dk_read io)
              (if (eq code 0) (append "Formatted " label) (append "Could not format " (append label (append ": " (dk_fs_why code))))))))))))

; What a file server's code says.
(def dk_fs_why ((code int)) (list int)
  (if (eq code -4) "a file on it is open"
  (if (eq code -3) "no file server serves it"
  (append "error " (digits code)))))

; ------------------------------------------------------------------- loop

; why said on standard error, and a failure.
(def dk_complain ((why (list int))) int
  (let w (write_err (append "disks: " (append why "\n"))) 1))

; The window opened, the disk read, and the window served until it is
; closed.
(def disks () int
  (match (ui_open "Disks" 880 520)
    ((UiOpenFailed why) (dk_complain why))
    ((UiOpenedWin w)
      (let io (dk_io)
        (let m (dk_new (dk_read io))
          (dk_loop (ui_present w (dk_view m)) io m))))))

; Each event routed, the state changed, and the window repainted.
(def dk_loop ((w UiWin) (io DkIo) (m Disks)) int
  (match (port_receive (ui_win_port w))
    ((RecvFailed) (dk_complain "lost its port"))
    ((Message from payload)
      (let ev (ui_event_of w (Message from payload))
        (match (ui_route w ev)
          ((UiRouted w2 action)
            (let m2 (dk_acted io m action ev)
              (dk_loop (ui_present w2 (dk_view m2)) io m2))))))))

; The state after action: refreshing and formatting read and write the
; disk; the rest is dk_update.
(def dk_acted ((io DkIo) (m Disks) (action (list int)) (ev UiEvent)) Disks
  (if (eq action "app.refresh")
      (dk_refreshed io m)
      (if (eq action "dialog.format")
          (dk_formatted io m)
          (dk_update m action ev))))
