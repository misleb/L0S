; The demo's disk, as tools/mkdisk makes it: 2048 sectors, data at 8 for
; 1528, scratch at 1536 for 512; data mounted with 190 clusters, 160 of
; them free, and 2 files; scratch not mounted.
(def demo_parts () (list VolPart)
  (cons (VolPart 76 8 1528) (cons (VolPart 76 1536 512) (nil VolPart))))

(def demo_contents () (list DkContent)
  (cons (DkVolume "data" 190 160 2) (cons (DkUnmounted "scratch") (nil DkContent))))

(def demo_drive () DkDrive (DkDrive 2048 (dk_segments 2048 (demo_parts) (demo_contents))))

(def demo () Disks (dk_new (demo_drive)))

(def seg_text ((s DkSeg)) (list int)
  (match s
    ((DkFree start count) (append "free " (append (digits start) (append "+" (digits count)))))
    ((DkPart n start count ty c) (append (digits n) (append " " (append (digits start) (append "+" (digits count))))))))

(def segs_text ((ss (list DkSeg))) (list int)
  (if (is_empty ss) "" (append (seg_text (head ss)) (append ", " (segs_text (tail ss))))))

; ----------------------------------------------------------------- parts

; Sector 0 is the table; 1 to 7 are no partition's.
(def test_demo_segments () int
  (check_str "the gap, then the two" (segs_text (dk_segments 2048 (demo_parts) (demo_contents)))
             "free 1+7, 1 8+1528, 2 1536+512, "))

; Out of order in the table, with room between and after them.
(def test_gaps () int
  (check_str "sorted, with every gap"
    (segs_text (dk_segments 1000 (cons (VolPart 76 500 100) (cons (VolPart 76 1 99) (nil VolPart))) (nil DkContent)))
    "2 1+99, free 100+400, 1 500+100, free 600+400, "))

(def test_empty_disk () int
  (check_str "all free" (segs_text (dk_segments 2048 (nil VolPart) (nil DkContent))) "free 1+2047, "))

(def test_keys () int
  (add (check_str "a partition" (dk_key (DkPart 2 1536 512 76 (DkUnmounted "s"))) "2")
       (check_str "free space" (dk_key (DkFree 1 7)) "free.1")))

; A sector that is no volume's.
(def test_content_unknown () int
  (match (dk_content_of (zeros 512) (FsSpaceRefused -3))
    ((DkUnknown why) (pass "unknown"))
    ((DkVolume l a b c) (fail_because "zeros" "a volume"))
    ((DkUnmounted l) (fail_because "zeros" "a volume"))))

(def test_content_volume () int
  (add (match (dk_content_of (vol_super "data" (vol_layout 1528)) (FsSpace 1528 190 160 2))
         ((DkVolume l a b c) (check_str "mounted" l "data"))
         ((DkUnmounted l) (fail_because "data" "not mounted"))
         ((DkUnknown why) (fail_because "data" why)))
       (match (dk_content_of (vol_super "scratch" (vol_layout 512)) (FsSpaceRefused -3))
         ((DkUnmounted l) (check_str "not mounted" l "scratch"))
         ((DkVolume l a b c) (fail_because "scratch" "mounted"))
         ((DkUnknown why) (fail_because "scratch" why)))))

; ------------------------------------------------------------------ text

(def test_size_text () int
  (add (check_str "bytes" (dk_size_text 512) "512 bytes")
       (add (check_str "free space" (dk_size_text 3584) "3.6 kB")
            (add (check_str "data" (dk_size_text 782336) "782.3 kB")
                 (check_str "the disk" (dk_size_text 1048576) "1.0 MB")))))

(def test_size_long () int
  (add (check_str "grouped" (dk_size_long 1048576) "1.0 MB (1,048,576 bytes)")
       (add (check_str "zeros kept" (dk_size_long 1002003) "1.0 MB (1,002,003 bytes)")
            (check_str "small" (dk_size_long 512) "512 bytes"))))

(def test_titles () int
  (add (check_str "a volume" (dk_seg_title (DkPart 1 8 1528 76 (DkVolume "data" 190 160 2))) "data")
       (add (check_str "unknown" (dk_seg_title (DkPart 3 8 10 131 (DkUnknown "no"))) "Partition 3")
            (add (check_str "its line" (dk_seg_line (DkPart 1 8 1528 76 (DkVolume "data" 190 160 2))) "782.3 kB L0FS")
                 (check_str "free" (dk_seg_line (DkFree 1 7)) "3.6 kB")))))

(def test_types () int
  (add (check_str "L0S's" (dk_type_text 76) "L0S (0x4C)")
       (check_str "another" (dk_type_text 131) "0x83")))

; 30 clusters of 4096 used, 160 free.
(def test_usage () int
  (add (check_str "used, free" (dk_usage_text 190 160) "122.9 kB used, 655.4 kB free")
       (add (check_int "percent" (dk_used_pct 190 160) 15)
            (add (check_int "a cluster shows" (dk_used_pct 190 189) 1)
                 (add (check_int "empty" (dk_used_pct 190 190) 0)
                      (check_int "none" (dk_used_pct 0 0) 0))))))

; ------------------------------------------------------------------ state

(def test_first_selected () int
  (add (check_str "the first volume, past the gap" (dk_selected (demo)) "1")
       (check_str "free space if that is all" (dk_selected (dk_new (DkDrive 10 (dk_segments 10 (nil VolPart) (nil DkContent))))) "free.1")))

(def none () UiEvent (UiLeave))

(def key ((code int)) UiEvent (UiKey (KeyEvent code 1 0)))

(def test_select () int
  (add (check_str "clicked" (dk_selected (dk_update (demo) "vols.select.2" (none))) "2")
       (add (check_str "left" (dk_selected (dk_update (demo) "" (key (ui_key_left)))) "free.1")
            (check_str "right" (dk_selected (dk_update (demo) "" (key (ui_key_right)))) "2"))))

(def dialog_of ((m Disks)) (list int)
  (match m ((Disks d sel dlg st) (match dlg ((DkNoDialog) "none") ((DkConfirm l) l)))))

(def test_format_dialog () int
  (let m (dk_update (demo) "app.format" (none))
    (add (check_str "asks of data" (dialog_of m) "data")
         (add (check_str "cancelled" (dialog_of (dk_update m "dialog.cancel" (none))) "none")
              (add (check_str "Esc" (dialog_of (dk_update m "" (key (ui_key_esc)))) "none")
                   (check_str "no moving along the bar under it" (dk_selected (dk_update m "" (key (ui_key_right)))) "1"))))))

; Only a mounted volume can be formatted.
(def test_formattable () int
  (add (check_str "data" (dk_formattable (demo)) "data")
       (add (check_str "scratch, not mounted" (dk_formattable (dk_update (demo) "vols.select.2" (none))) "")
            (add (check_str "free space" (dk_formattable (dk_update (demo) "vols.select.free.1" (none))) "")
                 (check_str "no dialog for it" (dialog_of (dk_update (dk_update (demo) "vols.select.2" (none)) "app.format" (none))) "none")))))

(def test_rescanned_keeps () int
  (add (check_str "still there" (dk_selected (dk_rescanned (dk_update (demo) "vols.select.2" (none)) (demo_drive) "ok")) "2")
       (check_str "gone: the first" (dk_selected (dk_rescanned (dk_update (demo) "vols.select.2" (none))
                                                              (DkDrive 2048 (dk_segments 2048 (nil VolPart) (nil DkContent))) "ok")) "free.1")))

; ------------------------------------------------------------------- view

; Every text painted.
(def texts ((ns (list UiNode))) (list int)
  (if (is_empty ns) "" (match (head ns) ((UiNode r ops a f) (append (op_texts ops) (texts (tail ns)))))))

(def op_texts ((ops (list UiPaint))) (list int)
  (if (is_empty ops)
      ""
      (append (match (head ops)
                ((UiPText r s a c b sc) (append s "|"))
                ((UiPFill r c) "") ((UiPRound r rad c u) "") ((UiPIcon x y n c sc) ""))
              (op_texts (tail ops)))))

(def laid ((m Disks)) (list UiNode) (ui_layout_window (dk_view m) 880 520 (ui_state_new (UiLight))))

(def has_target ((ns (list UiNode)) (action (list int))) bool
  (if (is_empty ns) false (if (eq (ui_node_action (head ns)) action) true (has_target (tail ns) action))))

(def has_text ((s (list int)) (t (list int))) bool
  (if (is_empty s) false (if (starts_with s t) true (has_text (tail s) t))))

(def test_view_drive () int
  (let t (texts (laid (demo)))
    (add (check_bool "its title" (has_text t "1.0 MB Disk|") true)
         (add (check_bool "its size" (has_text t "1.0 MB (1,048,576 bytes)|") true)
              (check_bool "its table" (has_text t "Master Boot Record|") true)))))

(def test_view_volume () int
  (let t (texts (laid (demo)))
    (add (check_bool "contents" (has_text t "L0FS version 1 - Mounted at /Volumes/data|") true)
         (add (check_bool "usage" (has_text t "122.9 kB used, 655.4 kB free|") true)
              (add (check_bool "type" (has_text t "L0S (0x4C)|") true)
                   (check_bool "where" (has_text t "Sectors 8-1535|") true))))))

(def test_view_targets () int
  (let ns (laid (demo))
    (add (check_bool "the drive" (has_target ns "side.select.0") true)
         (add (check_bool "each part" (has_target ns "vols.select.free.1") true)
              (add (check_bool "refresh" (has_target ns "app.refresh") true)
                   (check_bool "format, for data" (has_target ns "app.format") true))))))

(def test_view_format_insensitive () int
  (check_bool "not for free space" (has_target (laid (dk_update (demo) "vols.select.free.1" (none))) "app.format") false))

(def test_view_dialog () int
  (let ns (laid (dk_update (demo) "app.format" (none)))
    (add (check_bool "the dialog's button" (has_target ns "dialog.format") true)
         (add (check_bool "nothing beneath it" (has_target ns "app.refresh") false)
              (check_bool "what it asks" (has_text (texts ns) "Every file on data will be lost.|") true)))))

(def test_view_no_disk () int
  (check_bool "a status page" (has_text (texts (laid (dk_new (DkNoDrive "no disk; is virtio-blk running?")))) "No Disks|") true))

; Under an operating system there is no compositor.
(def test_no_compositor () int
  (check_int "fails" (disks) 1))
