; init.l0 -- a first process: starts the programs its arguments name, as
; the shell's run does, /bin/NAME or a path, and waits for each in order.
; A name followed by & is started and not waited for, as a server is. It
; exits 0 if everything it waited for did, and 1 otherwise.

; A program to start, and whether to wait for it.
(data Job (Job (list int) bool))

(def job_of ((word (list int))) Job
  (if (if (is_empty word) false (eq (head (rev word)) 38))
      (Job (rev (tail (rev word))) false)
      (Job word true)))

(def jobs_of ((argv (list (list int)))) (list Job)
  (if (is_empty argv) (nil Job) (cons (job_of (head argv)) (jobs_of (tail argv)))))

; What init says of starting name: its pid, or why it did not start.
(def started_line ((name (list int)) (s Spawn)) (list int)
  (match s
    ((Spawned pid) (append "init: " (append name (append " is pid " (append (digits pid) "\n")))))
    ((SpawnNoEntry) (not_started name s))
    ((SpawnNotProgram) (not_started name s))
    ((SpawnTooBig) (not_started name s))
    ((SpawnNoRoom) (not_started name s))))

(def not_started ((name (list int)) (s Spawn)) (list int)
  (append "init: " (append name (append " did not start: " (append (spawn_why s) "\n")))))

; What init says once it has waited for pid.
(def exited_line ((pid int) (r Reaped)) (list int)
  (match r
    ((Reaped status) (append "init: pid " (append (digits pid) (append " exited with " (append (digits status) "\n")))))
    ((WaitNoProc) (append "init: pid " (append (digits pid) " is gone\n")))))

; Writes s and delivers it at once, so what init says appears when it
; says it, not when it exits.
(def say ((s (list int))) int
  (let w (write_str s)
    (let f (file_flush (IoFile 1))
      0)))

; A started job: how starting it went, and whether to wait for it.
(data Started (Started Spawn bool))

(def start_all ((jobs (list Job)) (paths (list (list int))) (acc (list Started))) (list Started)
  (if (is_empty jobs)
      (rev acc)
      (match (head jobs)
        ((Job name wait)
          (let e (program_entry name paths)
            (let s (if (lt e 0) (SpawnNoEntry) (spawn_entry e))
              (let w (say (started_line name s))
                (start_all (tail jobs) paths (cons (Started s wait) acc)))))))))

; Waits for each started job to be waited for, and returns how many
; failed, a job that did not start among them.
(def wait_all ((ss (list Started)) (bad int)) int
  (if (is_empty ss)
      bad
      (match (head ss)
        ((Started s wait)
          (match s
            ((Spawned pid)
              (if wait
                  (let r (wait_pid pid)
                    (let w (say (exited_line pid r))
                      (wait_all (tail ss) (if (eq r (Reaped 0)) bad (add bad 1)))))
                  (wait_all (tail ss) bad)))
            ((SpawnNoEntry) (wait_all (tail ss) (add bad 1)))
            ((SpawnNotProgram) (wait_all (tail ss) (add bad 1)))
            ((SpawnTooBig) (wait_all (tail ss) (add bad 1)))
            ((SpawnNoRoom) (wait_all (tail ss) (add bad 1))))))))

(def init () int
  (let bad (wait_all (start_all (jobs_of (args)) (entry_paths) (nil Started)) 0)
    (let w (write_line (if (eq bad 0) "init: done" "init: something failed"))
      (if (eq bad 0) 0 1))))
