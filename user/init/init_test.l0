(def job_text ((j Job)) (list int)
  (match j ((Job name wait) (append name (if wait " wait" " background")))))

(def test_jobs () int
  (let js (jobs_of (split_spaces "hello echo& /bin/ping"))
    (add (check_int "count" (length js) 3)
         (add (check_str "first" (job_text (head js)) "hello wait")
              (add (check_str "second" (job_text (head (tail js))) "echo background")
                   (check_str "a path" (job_text (head (tail (tail js)))) "/bin/ping wait"))))))

(def test_lines () int
  (add (check_str "started" (started_line "echo" (Spawned 5)) "init: echo is pid 5\n")
       (add (check_str "failed" (started_line "nope" (SpawnNoEntry)) "init: nope did not start: no such program\n")
            (check_str "exited" (exited_line 5 (Reaped 0)) "init: pid 5 exited with 0\n"))))

(def test_lines_refused () int
  (add (check_str "no room" (started_line "echo" (SpawnNoRoom)) "init: echo did not start: no room for another process\n")
       (check_str "gone" (exited_line 5 (WaitNoProc)) "init: pid 5 is gone\n")))
