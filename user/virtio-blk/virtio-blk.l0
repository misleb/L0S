; virtio-blk.l0 -- a disk driver for QEMU's virtio-blk, serving the disk
; protocol, user/lib/disk.l0: 512-byte sectors, read into and written
; from pages a client shares with it. Its module must be flagged dev.
;
; No sector passes through a message, or through the driver: a request
; names the client's pages, where they are mapped here, and the device
; reads or writes them itself, by DMA. The driver makes one request of
; the device at a time, and waits for it as virtq_wait does.

(def blk_device () int 2)           ; DeviceID of a block device

; ---------------------------------------------------------------- requests

; virtio-blk's request types and statuses (virtio 1.2, section 5.2.6).
(def blk_in () int 0)               ; read sectors from the disk
(def blk_out () int 1)              ; write sectors to it
(def blk_ok () int 0)
(def blk_ioerr () int 1)
(def blk_unsupp () int 2)

(def sector_size () int 512)

; The most sectors one request may move: 64 KB, 16 pages, so a chain is
; at most 18 descriptors, within the ring.
(def blk_max_sectors () int 128)

; A request's header: its type, a reserved word, and the first sector.
(def blk_header ((type int) (sector int)) (list int)
  (append (u32_le type) (append (u32_le 0) (le64 sector))))

; A piece of a client's buffer as the device reaches it: where, and how
; many bytes.
(data BlkRun (BlkRun int int))

; The n bytes of a buffer whose pages the device reaches at addrs, a run
; a page.
(def blk_runs ((addrs (array int)) (n int)) (list BlkRun)
  (blk_runs_from addrs n 0 (nil BlkRun)))

; The same, from page i, onto acc.
(def blk_runs_from ((addrs (array int)) (n int) (i int) (acc (list BlkRun))) (list BlkRun)
  (let off (mul i (page_size))
    (if (ge off n)
        (rev acc)
        (blk_runs_from addrs n (add i 1)
                       (cons (BlkRun (array_get addrs i) (min (page_size) (sub n off))) acc)))))

; A request's chain: the header at hdr, readable; each run of data, which
; the device writes when reading the disk; and the status byte at status,
; which it writes.
(def blk_descriptors ((hdr int) (runs (list BlkRun)) (reading bool) (status int)) (list int)
  (append (descriptor hdr 16 (desc_next) 1)
          (blk_run_descriptors runs (if reading (bit_or (desc_next) (desc_write)) (desc_next)) 2 status (nil (list int)))))

; Each run's descriptor, flags as given, chained from next, then the
; status's; acc holds those made, newest first.
(def blk_run_descriptors ((runs (list BlkRun)) (flags int) (next int) (status int) (acc (list (list int)))) (list int)
  (if (is_empty runs)
      (concat_all (rev (cons (descriptor status 1 (desc_write) 0) acc)))
      (match (head runs)
        ((BlkRun addr len)
          (blk_run_descriptors (tail runs) flags (add next 1) status (cons (descriptor addr len flags next) acc))))))

; The lists of xss, one after another.
(def concat_all ((xss (list (list int)))) (list int)
  (if (is_empty xss) (nil int) (append (head xss) (concat_all (tail xss)))))

; What the device's status byte says, as a reason; empty for ok.
(def blk_why ((status int)) (list int)
  (if (eq status (blk_ok)) ""
  (if (eq status (blk_ioerr)) "the disk failed the request"
  (if (eq status (blk_unsupp)) "the disk does not do that"
  (append "the disk answered " (digits status))))))

; Why sectors from sector, count of them, cannot be moved on a disk of cap
; sectors; empty if they can.
(def blk_refusal ((sector int) (count int) (cap int)) (list int)
  (if (if (lt count 1) true (gt count (blk_max_sectors)))
      (append "a request moves 1 to " (append (digits (blk_max_sectors)) " sectors"))
      (if (lt sector 0)
          "no sector below 0"
          (if (gt (add sector count) cap)
              (append "past the disk's end, sector " (digits (sub cap 1)))
              ""))))

; The pages count sectors take.
(def blk_pages ((count int)) int
  (div (add (mul count (sector_size)) (sub (page_size) 1)) (page_size)))

; ---------------------------------------------------------------- the queue

; The queue, in one DMA page: 16 descriptors at 0, the available ring at
; 256, the used ring at 512, the request's header at 1024 and its status
; at 1040.
(def ring_size () int 16)
(def avail_off () int 256)
(def used_off () int 512)
(def header_off () int 1024)
(def status_off () int 1040)

; The driver: the transports' registers and the disk's transport, the
; queue's page and where the device reaches it, the disk's size in
; sectors, and how many requests it has made.
(data Blk (Blk IoDevice int IoDevice int int int))

; What came of a request: the driver after it, and why it failed, or
; empty.
(data BlkDone (BlkDone Blk (list int)))

; type for count sectors from sector, the data at runs, made of the
; device and waited for.
(def blk_request ((b Blk) (type int) (sector int) (runs (list BlkRun))) BlkDone
  (match b
    ((Blk d t q qa cap n)
      (let h (put_bytes q (header_off) (blk_header type sector))
        (let s (device_write8 q (status_off) 255)
          (let c (put_bytes q 0 (blk_descriptors (add qa (header_off)) runs (eq type (blk_in)) (add qa (status_off))))
            (blk_queued b)))))))

; The request at descriptor 0 made available and the device told.
(def blk_queued ((b Blk)) BlkDone
  (match b
    ((Blk d t q qa cap n)
      (let slot (device_write16 q (add (avail_off) (add 4 (mul 2 (mod n (ring_size))))) 0)
        (let br (barrier)
          (let i (device_write16 q (add (avail_off) 2) (bit_and (add n 1) 65535))
            (let br2 (barrier)
              (let k (notify d t 0)
                (blk_finished (Blk d t q qa cap (add n 1)) (clock_ns))))))))))

; The request made at since, waited for, and its status read.
(def blk_finished ((b Blk) (since int)) BlkDone
  (match b
    ((Blk d t q qa cap n)
      (if (virtq_wait q (used_off) n since)
          (BlkDone b (blk_why (device_read8 q (status_off))))
          (BlkDone b "the disk did not answer")))))

; ---------------------------------------------------------------- driving

(def complain ((why (list int))) int
  (let w (write_err (append "virtio-blk: " (append why "\n"))) 1))

; The driver: the transports opened, and the first disk among them found.
(def virtio_blk () int
  (match (open_device (virtio_base) (virtio_span))
    ((DeviceFailed fault why) (complain (append "no virtio-mmio transports: " why)))
    ((DeviceOpened d) (found d (find_device d (blk_device) 0)))))

; No disk is no failure: the board was started without one.
(def found ((d IoDevice) (t int)) int
  (if (lt t 0)
      (let w (write_err "virtio-blk: no virtio-blk on the board\n") 0)
      (if (not (is_modern d t))
          (complain "the virtio-blk's transport is legacy, not version 2")
          (if (not (negotiate d t))
              (complain "the virtio-blk refused its features")
              (if (lt (queue_max d t 0) (ring_size))
                  (complain "the request queue is too small")
                  (with_queue d t (dma_alloc 1)))))))

; The disk's size in sectors: config's capacity, a le64 at its start.
(def capacity ((d IoDevice) (t int)) int
  (bit_or (device_read32 d (treg t (reg_config)))
          (bit_shl (device_read32 d (treg t (add (reg_config) 4))) 32)))

; The queue's page, as dma_alloc answered a, opened and found where the
; device reaches it.
(def with_queue ((d IoDevice) (t int) (a DmaAlloc)) int
  (match a
    ((DmaPages va)
      (match (dma_open va 1)
        ((DeviceFailed fault why) (complain (append "cannot reach the queue: " why)))
        ((DeviceOpened q)
          (match (dma_address va)
            ((DmaAddress qa) (started (Blk d t q qa (capacity d t) 0)))
            ((DmaAddressDenied) (complain "the device cannot reach the queue: this program may not drive devices"))
            ((NotDma) (complain "the device cannot reach the queue: it is not DMA memory"))))))
    ((DmaDenied) (no_dma (DmaDenied)))
    ((DmaTooMany) (no_dma (DmaTooMany)))
    ((DmaNoRoom) (no_dma (DmaNoRoom)))))

; Fails, as dma_alloc answered a.
(def no_dma ((a DmaAlloc)) int
  (complain (append "no memory for the queue: " (dma_alloc_why a))))

; The queue started, the device told the driver is ready, and the disk
; served.
(def started ((b Blk)) int
  (match b
    ((Blk d t q qa cap n)
      (let s (start_queue d t 0 (ring_size) qa (add qa (avail_off)) (add qa (used_off)))
        (let o (driver_ok d t)
          (start_serving b))))))

; ---------------------------------------------------------------- serving

; Registers as disk, then answers each request, as disk.l0 makes them:
; ok, disk SECTORS 512, or error: WHY.
(def start_serving ((b Blk)) int
  (let port (port_new)
    (match (name_register port "disk")
      ((Registered) (serve b port))
      ((RegisterNoPort) (unregistered (RegisterNoPort)))
      ((RegisterTaken) (unregistered (RegisterTaken)))
      ((RegisterTooLong) (unregistered (RegisterTooLong))))))

; Fails, as name_register answered r.
(def unregistered ((r Registration)) int
  (complain (append "cannot register as disk: " (registration_why r))))

; Each request on port answered, one at a time.
(def serve ((b Blk) (port int)) int
  (match (port_receive port)
    ((RecvFailed) (complain "lost its port"))
    ((Message from payload)
      (match (handle b (split_spaces (request_body payload)))
        ((Handled b2 reply)
          (let r (port_send (request_reply payload) reply)
            (serve b2 port)))))))

; The driver after a request, and the reply to it.
(data Handled (Handled Blk (list int)))

; The reply that a request failed, and why.
(def failed ((b Blk) (why (list int))) Handled (Handled b (append "error: " why)))

; A request's words: its op, then its numbers.
(def handle ((b Blk) (words (list (list int)))) Handled
  (if (is_empty words)
      (failed b "no request")
      (let op (head words)
        (match (numbers_of (tail words) (nil int))
          ((None) (failed b (append op "'s arguments must be numbers")))
          ((Some ns) (requested b op ns (length ns)))))))

; Words as decimal numbers, of any size, since an address is one; or none
; if one is not.
(def numbers_of ((ws (list (list int))) (acc (list int))) (Option (list int))
  (if (is_empty ws)
      (Some (rev acc))
      (if (is_number (head ws))
          (numbers_of (tail ws) (cons (int_prefix (head ws) 0) acc))
          ((None (list int))))))

; Whether w is a decimal number: digits, at least one.
(def is_number ((w (list int))) bool
  (if (is_empty w) false (all_digits w)))

(def all_digits ((w (list int))) bool
  (if (is_empty w) true (if (if (ge (head w) 48) (le (head w) 57) false) (all_digits (tail w)) false)))

; Number i of ns, from 0.
(def nth_num ((ns (list int)) (i int)) int
  (if (eq i 0) (head ns) (nth_num (tail ns) (sub i 1))))

; The request op with its n numbers ns, answered.
(def requested ((b Blk) (op (list int)) (ns (list int)) (n int)) Handled
  (if (if (eq op "info") (eq n 0) false) (info b)
  (if (if (eq op "read") (eq n 3) false) (moved b (blk_in) (nth_num ns 0) (nth_num ns 1) (nth_num ns 2))
  (if (if (eq op "write") (eq n 3) false) (moved b (blk_out) (nth_num ns 0) (nth_num ns 1) (nth_num ns 2))
  (failed b (append "no request " op))))))

; info: the disk's size, in sectors, and a sector's.
(def info ((b Blk)) Handled
  (match b
    ((Blk d t q qa cap n)
      (Handled b (append "disk " (append (digits cap) (append " " (digits (sector_size)))))))))

; read or write SECTOR COUNT VA: count sectors from sector moved, as type
; says, between the disk and the client's pages shared here at va.
(def moved ((b Blk) (type int) (sector int) (count int) (va int)) Handled
  (match b
    ((Blk d t q qa cap n)
      (let why (blk_refusal sector count cap)
        (if (not (is_empty why))
            (failed b why)
            (match (page_addresses va (blk_pages count))
              ((None) (failed b "the buffer is not shared with the disk"))
              ((Some addrs)
                (match (blk_request b type sector (blk_runs addrs (mul count (sector_size))))
                  ((BlkDone b2 err) (if (is_empty err) (Handled b2 "ok") (failed b2 err)))))))))))
