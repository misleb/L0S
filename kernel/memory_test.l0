(def area_code ((a Area)) int
  (match a ((AreaImage) 0) ((AreaHeap) 1) ((AreaStack) 2) ((AreaDevice) 3) ((AreaOutside) 4)))

(def at ((off int)) int (add (user_base) off))

; As process.l0 makes one from an ELF: a page of code, a page between
; segments the image does not have, a page of rodata, and two of data,
; then the heap from 0xC0005000.
(def elf () Layout
  (Layout (cons (Span (at 0) (at 4096) 2)
            (cons (Span (at 8192) (at 12288) 0)
              (cons (Span (at 12288) (at 20480) 1) (nil Span))))
          (at 20480)))

; As asm.l0's programs are laid out: a page of code, and bss to the heap
; at 0xC0400000.
(def big_heap () int 3225419776)

(def big () Layout
  (Layout (cons (Span (at 0) (at 4096) 2) (cons (Span (at 4096) (big_heap) 1) (nil Span))) (big_heap)))

(def test_areas () int
  (add (check_int "below" (area_code (area_of (big) 4096)) 4)
       (add (check_int "entry" (area_code (area_of (big) (user_base))) 0)
            (add (check_int "heap" (area_code (area_of (big) (big_heap))) 1)
                 (add (check_int "stack top byte" (area_code (area_of (big) (sub (stack_top) 1))) 2)
                      (add (check_int "device" (area_code (area_of (big) (stack_top))) 3)
                           (check_int "above" (area_code (area_of (big) (user_limit))) 4)))))))

(def test_elf_areas () int
  (add (check_int "data" (area_code (area_of (elf) (at 16384))) 0)
       (check_int "heap after the data" (area_code (area_of (elf) (at 20480))) 1)))

(def test_page_of () int
  (add (check_int "aligned" (page_of 8192) 8192)
       (check_int "inside" (page_of 12287) 8192)))

; A HeapRun as "from to", offsets from the heap of big.
(def run_text ((r HeapRun)) (list int)
  (match r ((HeapRun from to)
    (if (eq from to) "none" (append (digits (sub from (big_heap))) (append " " (digits (sub to (big_heap)))))))))

(def test_heap_run_whole_pages () int
  (add (check_str "two pages" (run_text (heap_run (big) (big_heap) 8192)) "0 8192")
       (check_str "rounded in" (run_text (heap_run (big) (add (big_heap) 1) 12288)) "4096 12288")))

(def test_heap_run_none () int
  (add (check_str "part of a page" (run_text (heap_run (big) (big_heap) 4095)) "none")
       (add (check_str "no length" (run_text (heap_run (big) (big_heap) 0)) "none")
            (check_str "wraps" (run_text (heap_run (big) (big_heap) -1)) "none"))))

; A range reaching past the heap keeps only its part: from the image's
; start it begins at the heap, and up to the stack's top it ends at
; heap_limit, 0xD8000000, 0x17C00000 past 0xC0400000.
(def test_heap_run_clipped () int
  (add (check_str "from the image" (run_text (heap_run (big) (user_base) 4202496)) "0 8192")
       (add (check_str "into the stack" (run_text (heap_run (big) (big_heap) 671088640)) "0 398458880")
            (check_str "the stack alone" (run_text (heap_run (big) (heap_limit) 4096)) "none"))))

(def test_demand_perm () int
  (add (check_int "bss" (demand_perm (big) (at 40960)) 1)
       (add (check_int "heap" (demand_perm (big) (big_heap)) 1)
            (check_int "device" (demand_perm (big) (stack_top)) -1))))

; A page of a segment not mapped yet is its bss, mapped with the
; segment's perm on demand; a page between segments never is.
(def test_elf_demand_perm () int
  (add (check_int "between" (demand_perm (elf) (at 4096)) -1)
       (add (check_int "bss" (demand_perm (elf) (at 16384)) 1)
            (check_int "heap" (demand_perm (elf) (at 20480)) 1))))

(def test_span_perm () int
  (add (check_int "rodata" (span_perm (elf) (at 8200)) 0)
       (add (check_int "data's last byte" (span_perm (elf) (at 20479)) 1)
            (add (check_int "between" (span_perm (elf) (at 4096)) -1)
                 (check_int "past" (span_perm (elf) (at 20480)) -1)))))

(def test_may_write () int
  (add (check_bool "code" (may_write (elf) (user_base)) false)
       (add (check_bool "between" (may_write (elf) (at 4096)) false)
            (add (check_bool "rodata" (may_write (elf) (at 8192)) false)
                 (check_bool "data" (may_write (elf) (at 12288)) true)))))

(def test_may_write_elsewhere () int
  (add (check_bool "heap" (may_write (elf) (at 20480)) true)
       (add (check_bool "stack" (may_write (elf) (sub (stack_top) 8)) true)
            (check_bool "below" (may_write (elf) 4096) false))))

(def test_range_pages () int
  (add (check_int "none" (length (range_pages (user_base) 0)) 0)
       (add (check_int "one" (length (range_pages (user_base) 4096)) 1)
            (check_int "straddles" (length (range_pages (add (user_base) 4095) 2)) 2))))

(def mapped_first () (Map int int)
  (map_put ((MapEmpty int int)) (user_base) 7))

(def test_plan_mapped () int
  (match (range_plan (big) (mapped_first) (add (user_base) 10) 100 false)
    ((PlanMap ps) (check_int "nothing to map" (length ps) 0))
    ((PlanBad) (fail_because "plan" "refused"))))

; Read from the code into the bss, whose first page is mapped then.
(def test_plan_demand () int
  (match (range_plan (big) (mapped_first) (add (user_base) 4000) 200 false)
    ((PlanMap ps) (check_str "second page" (map_show ps) (map_show (cons (add (user_base) 4096) (nil int)))))
    ((PlanBad) (fail_because "plan" "refused"))))

(def map_show ((ps (list int))) (list int)
  (if (is_empty ps) "" (append (hex_digits (head ps) 0) (append " " (map_show (tail ps))))))

(def test_plan_refuses () int
  (add (check_true "below user range" (is_bad (range_plan (big) (mapped_first) 4096 10 false)))
       (add (check_true "device page" (is_bad (range_plan (big) (mapped_first) (stack_top) 1 false)))
            (add (check_true "past the end" (is_bad (range_plan (big) (mapped_first) (sub (user_limit) 2) 4 false)))
                 (check_true "negative count" (is_bad (range_plan (big) (mapped_first) (user_base) -1 false)))))))

(def test_plan_huge () int
  (check_true "wraps nothing" (is_bad (range_plan (big) (mapped_first) (user_base) 9223372036854775807 false))))

; An ELF's code page, mapped: the kernel reads it, as for a write call,
; but never writes it, as for a read call.
(def test_plan_elf_code () int
  (add (check_bool "read" (is_bad (range_plan (elf) (mapped_first) (user_base) 16 false)) false)
       (check_bool "written" (is_bad (range_plan (elf) (mapped_first) (user_base) 16 true)) true)))

; A copy into the data that runs on through its bss into the heap maps
; the bss's page and the heap's.
(def test_plan_elf_into_heap () int
  (match (range_plan (elf) (map_put (mapped_first) (at 12288) 8) (at 16000) 4800 true)
    ((PlanMap ps) (check_str "bss and heap" (map_show ps) (map_show (cons (at 16384) (cons (at 20480) (nil int))))))
    ((PlanBad) (fail_because "plan" "refused"))))

; A page between an ELF's segments, which it never had, is not mapped.
(def test_plan_elf_gap () int
  (check_true "between segments" (is_bad (range_plan (elf) (mapped_first) (at 4096) 8 false))))

(def is_bad ((p Plan)) bool
  (match p ((PlanMap ps) false) ((PlanBad) true)))

(def test_region_plan () int
  (match (region_plan (dev_pages_new) 151060496 4)        ; 0x09010010
    ((RegionAt va rest addr)
      (add (check_int "va" va (stack_top))
           (add (check_int "top" (dev_top rest) (add (stack_top) 4096))
                (check_int "addr" addr (add (stack_top) 16)))))
    ((RegionRefused code) (fail_because "region" (digits code)))))

(def test_region_straddles () int
  (match (region_plan (dev_pages_new) 4095 2)
    ((RegionAt va rest addr) (check_int "two pages" (sub (dev_top rest) va) 8192))
    ((RegionRefused code) (fail_because "region" (digits code)))))

; A pool whose top is the last page below user_limit, and none free.
(def pool_last () DevPages (DevPages (sub (user_limit) 4096) (nil DevRun)))

(def test_region_refused () int
  (add (check_int "empty" (refused (region_plan (dev_pages_new) 0 0)) -3)
       (add (check_int "negative base" (refused (region_plan (dev_pages_new) -4096 16)) -3)
            (check_int "out of room" (refused (region_plan (pool_last) 0 8192)) -5))))

(def test_dma_plan () int
  (match (dma_plan (dev_pages_new) 3)
    ((DmaAt va after rest)
      (add (check_int "va" va (stack_top))
           (add (check_int "after" after (add (stack_top) 12288))
                (check_int "top" (dev_top rest) after))))
    ((DmaRefused code) (fail_because "dma" (digits code)))))

(def dma_refused ((p DmaPlan)) int
  (match p ((DmaAt va after rest) 0) ((DmaRefused code) code)))

(def test_dma_plan_refused () int
  (add (check_int "none" (dma_refused (dma_plan (dev_pages_new) 0)) -4)
       (add (check_int "over the limit" (dma_refused (dma_plan (dev_pages_new) 16385)) -4)
            (add (check_int "at the limit" (dma_refused (dma_plan (dev_pages_new) 16384)) 0)
                 (check_int "out of room" (dma_refused (dma_plan (pool_last) 2)) -5)))))

(def refused ((p RegionPlan)) int
  (match p ((RegionAt va rest addr) 0) ((RegionRefused code) code)))

; ------------------------------------------------------------ device pages

; Device page i, from stack_top, and i pages' bytes.
(def dp ((i int)) int (add (stack_top) (mul i 4096)))
(def pgs ((i int)) int (mul i 4096))

; pool as text, in pages from stack_top: its top, then each free run.
(def pool_show ((pool DevPages)) (list int)
  (match pool
    ((DevPages top runs) (append (digits (div (sub top (stack_top)) 4096)) (runs_show runs)))))

(def runs_show ((runs (list DevRun))) (list int)
  (if (is_empty runs)
      ""
      (match (head runs)
        ((DevRun from to)
          (append " " (append (digits (div (sub from (stack_top)) 4096))
                              (append "-" (append (digits (div (sub to (stack_top)) 4096)) (runs_show (tail runs))))))))))

; span bytes taken from pool: where, or -1.
(def taken_at ((t DevTake)) int (match t ((DevTaken va rest) va) ((DevFull) -1)))

; The pool after span bytes are taken, or pool itself if they are not.
(def taken_pool ((pool DevPages) (span int)) DevPages
  (match (dev_take pool span) ((DevTaken va rest) rest) ((DevFull) pool)))

; Pages 0-2, 2-5 and 5-6 given, as three dma_allocs of 2, 3 and 1.
(def three () DevPages (taken_pool (taken_pool (taken_pool (dev_pages_new) (pgs 2)) (pgs 3)) (pgs 1)))

(def test_dev_take_new () int
  (add (check_int "at the first device page" (taken_at (dev_take (dev_pages_new) (pgs 2))) (dp 0))
       (check_str "three given" (pool_show (three)) "6")))

; The first given up, out of order: a run below top, and given again.
(def test_dev_give_out_of_order () int
  (let p (dev_give (three) (dp 0) (pgs 2))
    (add (check_str "a run" (pool_show p) "6 0-2")
         (add (check_int "given again" (taken_at (dev_take p (pgs 2))) (dp 0))
              (check_str "and gone" (pool_show (taken_pool p (pgs 2))) "6")))))

; Given up in the middle and then below: one run, joined.
(def test_dev_give_joins () int
  (check_str "joined" (pool_show (dev_give (dev_give (three) (dp 2) (pgs 3)) (dp 0) (pgs 2))) "6 0-5"))

; The last given back lowers top through every run it reaches.
(def test_dev_give_lowers_top () int
  (let p (dev_give (dev_give (three) (dp 0) (pgs 2)) (dp 2) (pgs 3))
    (add (check_str "the last, after the others" (pool_show (dev_give p (dp 5) (pgs 1))) "0")
         (check_str "the last alone" (pool_show (dev_give (three) (dp 5) (pgs 1))) "5"))))

; Runs apart, highest first; a take goes to the first that holds it,
; else to top.
(def test_dev_take_fits () int
  (let p (dev_give (dev_give (three) (dp 0) (pgs 2)) (dp 3) (pgs 1))
    (add (check_str "apart" (pool_show p) "6 3-4 0-2")
         (add (check_int "two pages, the lower run" (taken_at (dev_take p (pgs 2))) (dp 0))
              (add (check_int "one, the higher" (taken_at (dev_take p (pgs 1))) (dp 3))
                   (check_int "three, at top" (taken_at (dev_take p (pgs 3))) (dp 6)))))))

; Part of a run taken leaves the rest of it.
(def test_dev_take_part () int
  (check_str "the rest" (pool_show (taken_pool (dev_give (three) (dp 0) (pgs 2)) (pgs 1))) "6 1-2"))

; A run too small and no room above top: full.
(def test_dev_full () int
  (check_int "full" (taken_at (dev_take (dev_give (pool_last) (dp 0) (pgs 1)) (pgs 2))) -1))

; Pages given up out of order are given again, where once only the last
; given were. 96 takes of 1 MB fill 96 MB, pages 0 to 24576; giving back
; every other one, from the first, leaves 48 holes below top, as none
; reaches it; a 1 MB take goes to the highest, the 95th's place, page
; 94 * 256; and 48 of them fill every hole, leaving top where it was.
(def test_dev_holes_reused () int
  (let filled (take_n (dev_pages_new) 96 (pgs 256))
    (let holed (give_every_other filled 0 96 (pgs 256))
      (add (check_int "48 runs" (dev_run_count holed) 48)
           (add (check_int "a hole" (taken_at (dev_take holed (pgs 256))) (dp (mul 94 256)))
                (check_str "holes filled" (pool_show (take_n holed 48 (pgs 256))) (digits (mul 96 256))))))))

; pool after n takes of span bytes.
(def take_n ((pool DevPages) (n int) (span int)) DevPages
  (if (eq n 0) pool (take_n (taken_pool pool span) (sub n 1) span)))

; pool with the even ones of n runs of span bytes from stack_top, from
; the ith, given back.
(def give_every_other ((pool DevPages) (i int) (n int) (span int)) DevPages
  (if (ge i n)
      pool
      (give_every_other (dev_give pool (add (stack_top) (mul i span)) span) (add i 2) n span)))

; ---------------------------------------------- device pages, at random

; A few hundred seeded takes and gives against the obvious version, a
; set of pages: every take lands on pages none holds and below
; user_limit, and once all is given back the pool is new again.
(def test_dev_random () int
  (dev_walk (dev_pages_new) (nil DevRun) 12345 400 0))

; The walk: held, the ranges taken and not given; s the seed; left steps
; to go; bad the count of failures so far.
(def dev_walk ((pool DevPages) (held (list DevRun)) (s int) (left int) (bad int)) int
  (if (eq left 0)
      (add bad (check_str "all given back" (pool_show (give_all pool held)) "0"))
      (let s1 (rand_next s)
        (if (if (is_empty held) true (lt (rand_below s1 3) 2))
            (let span (pgs (add 1 (rand_below (rand_next s1) 8)))
              (match (dev_take pool span)
                ((DevFull) (dev_walk pool held (rand_next s1) (sub left 1) (add bad 1)))
                ((DevTaken va rest)
                  (dev_walk rest (cons (DevRun va (add va span)) held) (rand_next s1) (sub left 1)
                            (add bad (check_bool "apart" (overlaps held va (add va span)) false))))))
            (let i (rand_below (rand_next s1) (length held))
              (match (nth held i)
                ((DevRun from to)
                  (dev_walk (dev_give pool from (sub to from)) (drop_nth held i) (rand_next s1) (sub left 1) bad))))))))

; Whether any of held shares a page with from up to to.
(def overlaps ((held (list DevRun)) (from int) (to int)) bool
  (if (is_empty held)
      false
      (match (head held)
        ((DevRun a b) (if (if (lt a to) (lt from b) false) true (overlaps (tail held) from to))))))

; pool with every one of held given back.
(def give_all ((pool DevPages) (held (list DevRun))) DevPages
  (if (is_empty held)
      pool
      (match (head held) ((DevRun a b) (give_all (dev_give pool a (sub b a)) (tail held))))))

; xs without its ith.
(def drop_nth ((xs (list DevRun)) (i int)) (list DevRun)
  (if (eq i 0) (tail xs) (cons (head xs) (drop_nth (tail xs) (sub i 1)))))

; ----------------------------------------------------------------- freeing

; A heap page, a stack page, and two device pages of a process.
(def heap_page () int (big_heap))
(def stack_page () int (sub (stack_top) 4096))
(def dev_page ((i int)) int (add (stack_top) (mul i 4096)))

(def pages_of ((vas (list int)) (fs (list int)) (m (Map int int))) (Map int int)
  (if (is_empty vas) m (pages_of (tail vas) (tail fs) (map_put m (head vas) (head fs)))))

(def private_pages () (Map int int)
  (pages_of (cons (user_base) (cons (heap_page) (cons (stack_page) (nil int))))
            (cons 10 (cons 11 (cons 12 (nil int)))) ((MapEmpty int int))))

; private_pages, and frames 20 and 21 at device pages.
(def device_pages () (Map int int)
  (map_put (map_put (private_pages) (dev_page 0) 20) (dev_page 1) 21))

(def map_digits ((ns (list int))) (list (list int))
  (if (is_empty ns) (nil (list int)) (cons (digits (head ns)) (map_digits (tail ns)))))

; The frames a release frees, in order, as digits.
(def freed ((r Released)) (list (list int))
  (match r ((Released m fs) (map_digits (sort fs)))))

(def left ((r Released)) Mem
  (match r ((Released m fs) m)))

(def test_mem_share_counts () int
  (add (check_int "never mapped" (mem_count (mem_new) 20) 0)
       (check_int "twice" (mem_count (mem_share (mem_share (mem_new) 20) 20) 20) 2)))

; A process's own frames are freed at once.
(def test_release_private () int
  (check_strs "image, heap, stack" (freed (mem_release (mem_new) (private_pages) false))
              (cons "10" (cons "11" (cons "12" (nil (list int)))))))

; A shared frame is freed once no live process maps it: 21, mapped once,
; but not 20, which another process maps too.
(def shared_twice () Mem
  (mem_share (mem_share (mem_share (mem_new) 20) 21) 20))

(def test_release_shared () int
  (let r (mem_release (shared_twice) (device_pages) false)
    (add (check_strs "freed" (freed r) (cons "10" (cons "11" (cons "12" (cons "21" (nil (list int)))))))
         (add (check_int "20 mapped once more" (mem_count (left r) 20) 1)
              (check_int "21 counted no more" (mem_count (left r) 21) 0)))))

(def test_release_last_sharer () int
  (let r (mem_release (mem_share (mem_new) 20) (map_put ((MapEmpty int int)) (dev_page 0) 20) false)
    (add (check_strs "freed" (freed r) (cons "20" (nil (list int))))
         (check_int "counted no more" (mem_count (left r) 20) 0))))

; A frame mapped twice in one process, as shm_share to itself maps it,
; counts both.
(def test_release_shared_with_itself () int
  (let pages (map_put (map_put ((MapEmpty int int)) (dev_page 0) 20) (dev_page 1) 20)
    (check_strs "freed once" (freed (mem_release (mem_share (mem_share (mem_new) 20) 20) pages false))
                (cons "20" (nil (list int))))))

; A driver's frames at its device pages are never freed, and stay
; counted, so no later release frees them either: its device may still
; read and write them.
(def test_release_driver () int
  (let r (mem_release (shared_twice) (device_pages) true)
    (add (check_strs "only its own" (freed r) (cons "10" (cons "11" (cons "12" (nil (list int))))))
         (add (check_int "20 still counted" (mem_count (left r) 20) 2)
              (check_int "21 still counted" (mem_count (left r) 21) 1)))))

; A driver and another process map 21; the driver ends first, then the
; other.
(def test_release_after_driver () int
  (let r (mem_release (left (mem_release (mem_share (shared_twice) 21) (device_pages) true))
                      (map_put ((MapEmpty int int)) (dev_page 0) 21) false)
    (add (check_int "21 not freed" (length (freed r)) 0)
         (check_int "the driver's mapping still counted" (mem_count (left r) 21) 1))))

(def test_unshare_not_last () int
  (match (mem_unshare (mem_share (mem_share (mem_new) 20) 20) 20)
    ((Unshared m last) (add (check_bool "not the last" last false) (check_int "one left" (mem_count m 20) 1)))))

(def test_unshare_last () int
  (match (mem_unshare (mem_share (mem_new) 20) 20)
    ((Unshared m last) (add (check_bool "the last" last true) (check_int "counted no more" (mem_count m 20) 0)))))

; Frames 20 and 21 are shared, 20 by two mappings: two frames, each
; counted once; once both of 20's are gone, one.
(def test_shared_frames () int
  (add (check_int "none" (mem_shared_frames (mem_new)) 0)
       (add (check_int "20 and 21" (mem_shared_frames (shared_twice)) 2)
            (match (mem_unshare (shared_twice) 21)
              ((Unshared m last) (check_int "20 alone" (mem_shared_frames m) 1))))))
