; asm.l0 -- just enough aarch64 to write the threads the kernel's tests
; run: each function is one instruction's 32-bit word, code_bytes lays
; the words out as bytes, and code wraps them in an ELF, as spec section
; 10.3 lays a program's image out. Linked only into tests.

(def movz ((d int) (imm int)) int              ; movz xd, #imm
  (bit_or 3531603968 (bit_or (bit_shl (bit_and imm 65535) 5) d)))          ; 0xD2800000

(def movz_hi ((d int) (imm int)) int           ; movz xd, #imm, lsl 16
  (bit_or 3533701120 (bit_or (bit_shl (bit_and imm 65535) 5) d)))          ; 0xD2A00000

; movz xd, #imm, lsl 32: imm in bits 32 to 47, as the high user range's
; addresses need, 0x2000000000 being (movz_hi32 d 32).
(def movz_hi32 ((d int) (imm int)) int
  (bit_or 3535798272 (bit_or (bit_shl (bit_and imm 65535) 5) d)))          ; 0xD2C00000

(def movn ((d int) (imm int)) int              ; movn xd, #imm: the bits of imm turned over
  (bit_or 2457862144 (bit_or (bit_shl (bit_and imm 65535) 5) d)))          ; 0x92800000

(def add_imm ((d int) (n int) (imm int)) int   ; add xd, xn, #imm, for imm below 4096
  (bit_or 2432696320 (bit_or (bit_shl (bit_and imm 4095) 10) (bit_or (bit_shl n 5) d))))  ; 0x91000000

(def add_imm_hi ((d int) (n int) (imm int)) int   ; add xd, xn, #imm, lsl 12: imm pages
  (bit_or 2436890624 (bit_or (bit_shl (bit_and imm 4095) 10) (bit_or (bit_shl n 5) d))))  ; 0x91400000

(def subs_imm ((d int) (n int) (imm int)) int  ; subs xd, xn, #imm, for imm below 4096
  (bit_or 4043309056 (bit_or (bit_shl (bit_and imm 4095) 10) (bit_or (bit_shl n 5) d))))  ; 0xF1000000

(def add_reg ((d int) (n int) (m int)) int     ; add xd, xn, xm
  (bit_or 2332033024 (bit_or (bit_shl m 16) (bit_or (bit_shl n 5) d))))   ; 0x8B000000

(def mov_reg ((d int) (m int)) int             ; mov xd, xm
  (bit_or 2852127712 (bit_or (bit_shl m 16) d)))                           ; 0xAA0003E0

(def cbnz ((t int) (off int)) int              ; cbnz xt, off instructions from here
  (bit_or 3036676096 (bit_or (bit_shl (bit_and off 524287) 5) t)))         ; 0xB5000000

(def svc () int 3556769793)                    ; svc #0, 0xD4000001
(def b_self () int 335544320)                  ; b ., 0x14000000
(def ldr_x0_x1 () int 4181721120)              ; ldr x0, [x1], 0xF9400020
(def ldr_x0_x1_8 () int 4181722144)            ; ldr x0, [x1, #8], 0xF9400420
(def ldr_x0_x1_16 () int 4181723168)           ; ldr x0, [x1, #16], 0xF9400820
(def ldr_w0_x1_4 () int 3107980320)            ; ldr w0, [x1, #4], 0xB9400420: a u32
(def str_x0_x1 () int 4177526816)              ; str x0, [x1], 0xF9000020
(def push_x0 () int 4162785248)                ; str x0, [sp, #-16]!, 0xF81F0FE0
(def ldr_x0_sp () int 4181722080)              ; ldr x0, [sp], 0xF94003E0
(def mov_x19_x0 () int 2852127731)             ; mov x19, x0, 0xAA0003F3
(def mov_x0_x19 () int 2853372896)             ; mov x0, x19, 0xAA1303E0
(def mov_x1_x19 () int 2853372897)             ; mov x1, x19, 0xAA1303E1

; A call: x8 is n, then svc.
(def call_words ((n int)) (list int)
  (cons (movz 8 n) (cons (svc) (nil int))))

; Exits with whatever x0 holds.
(def exit_x0 () (list int) (call_words (sys_exit)))

; The instructions as bytes, each least significant byte first.
(def code_bytes ((ws (list int))) (list int)
  (if (is_empty ws) (nil int) (append (u32_le (head ws)) (code_bytes (tail ws)))))

; The instructions as a program's image: program's ELF of them.
(def code ((ws (list int))) (list int) (program (code_bytes ws)))

; Where the heap of a program's image starts, 0xC0400000, as the tests
; reach it: past a bss as big as the 4 MB images had before they were
; ELFs.
(def program_heap () int 3225419776)

; An ELF whose code, readable and executable, is bs, at user_base, and
; whose bss, readable and writable, runs from the next page to
; program_heap. The kernel maps the bss's pages as they are touched, as
; the heap's.
(def program ((bs (list int))) (list int)
  (let bss (add (user_base) (mul (pages_for (length bs)) 4096))
    (elf_image (em_aarch64) (user_base)
               (cons (Part (user_base) (pf_rx) bs (length bs)) (cons (Part bss (pf_rw) "" (sub (program_heap) bss)) (nil Part))))))

; ---------------------------------------------------------------- ELF

; A segment of an ELF image the tests build: its address, its p_flags,
; its bytes, and its size in memory, which the bytes may be short of.
(data Part (Part int int (list int) int))

(def pf_rx () int 5)                 ; PF_R | PF_X: code
(def pf_r () int 4)                  ; PF_R: rodata
(def pf_rw () int 6)                 ; PF_R | PF_W: data and bss
(def pf_rwx () int 7)                ; what spec section 10.3 never allows

(def em_aarch64 () int 183)
(def em_riscv () int 243)

; An ELF image for e_machine m, entered at entry, of these segments, as
; spec section 10.3 lays one out: the ELF header and the program headers
; in the first page, and each segment's bytes from the next page on.
(def elf_image ((m int) (entry int) (parts (list Part))) (list int)
  (let n (length parts)
    (concat (cons (elf_header m entry n)
              (cons (elf_phdrs parts 4096 (nil (list int)))
                (cons (zeros (sub 4096 (add 64 (mul n 56))))
                  (cons (elf_bodies parts (nil (list int))) (nil (list int)))))))))

; The 64 bytes of an ELF header for n program headers right after it.
(def elf_header ((m int) (entry int) (n int)) (list int)
  (concat (cons (cons 127 (cons 69 (cons 76 (cons 70 (cons 2 (cons 1 (cons 1 (zeros 9))))))))   ; \x7FELF, 64-bit, LSB, v1
            (cons (le16 2) (cons (le16 m) (cons (u32_le 1) (cons (le64 entry)
              (cons (le64 64) (cons (le64 0) (cons (u32_le 0)
                (cons (le16 64) (cons (le16 56) (cons (le16 n) (cons (zeros 6) (nil (list int))))))))))))))))

; The program headers of parts, the first one's bytes at off.
(def elf_phdrs ((parts (list Part)) (off int) (acc (list (list int)))) (list int)
  (if (is_empty parts)
      (concat (rev acc))
      (match (head parts)
        ((Part va flags bs msz)
          (elf_phdrs (tail parts) (add off (mul (pages_for (length bs)) 4096))
                     (cons (elf_phdr 1 flags off va (length bs) msz) acc))))))

; A program header of type t.
(def elf_phdr ((t int) (flags int) (off int) (va int) (fsz int) (msz int)) (list int)
  (concat (cons (u32_le t) (cons (u32_le flags) (cons (le64 off) (cons (le64 va) (cons (le64 va)
            (cons (le64 fsz) (cons (le64 msz) (cons (le64 4096) (nil (list int))))))))))))

; Each part's bytes, padded to whole pages.
(def elf_bodies ((parts (list Part)) (acc (list (list int)))) (list int)
  (if (is_empty parts)
      (concat (rev acc))
      (match (head parts)
        ((Part va flags bs msz)
          (elf_bodies (tail parts)
                      (cons (zeros (sub (mul (pages_for (length bs)) 4096) (length bs))) (cons bs acc)))))))

; An ELF for this CPU of one code segment of these instructions, at
; user_base, and more segments after it.
(def elf_code ((ws (list int)) (more (list Part))) (list int)
  (let bs (code_bytes ws)
    (elf_image (em_aarch64) (user_base) (cons (Part (user_base) (pf_rx) bs (length bs)) more))))

; A program for an initramfs: flags, and its image.
(data Raw (Raw int (list int)))

(def flag_dev () int 1)              ; dev in the inittab
(def flag_boot () int 2)             ; start in the inittab

; An initramfs whose programs are these: program i at /bin/rawi, entry
; i, mode 0755 (33261), and an /etc/inittab that starts the ones flagged
; boot, in order, and lets the ones flagged dev drive devices.
(def raw_initramfs ((mods (list Raw))) bytes
  (raw_initramfs_with mods (nil RawFile) ""))

; A file besides the programs: its name in the archive, mode, and
; contents.
(data RawFile (RawFile (list int) int (list int)))

; The same, with files after the programs, before /etc/inittab, so the
; programs keep their entries; and more lines at the inittab's end.
(def raw_initramfs_with ((mods (list Raw)) (files (list RawFile)) (more (list int))) bytes
  (bytes_from_list
    (append (raw_programs mods 0)
      (append (raw_files files)
        (append (newc_entry "etc/inittab" 33188 (append (raw_inittab mods 0 (nil int)) more))
          (newc_trailer))))))

(def raw_name ((i int)) (list int) (append "bin/raw" (digits i)))

(def raw_programs ((mods (list Raw)) (i int)) (list int)
  (if (is_empty mods)
      (nil int)
      (match (head mods)
        ((Raw flags img) (append (newc_entry (raw_name i) 33261 img) (raw_programs (tail mods) (add i 1)))))))

(def raw_files ((files (list RawFile))) (list int)
  (if (is_empty files)
      (nil int)
      (match (head files)
        ((RawFile name mode contents) (append (newc_entry name mode contents) (raw_files (tail files)))))))

(def raw_inittab ((mods (list Raw)) (i int) (acc (list int))) (list int)
  (if (is_empty mods)
      (rev acc)
      (match (head mods)
        ((Raw flags img)
          (let a (if (eq (bit_and flags (flag_boot)) 0) acc (push (append "start /" (append (raw_name i) "\n")) acc))
            (raw_inittab (tail mods) (add i 1)
                         (if (eq (bit_and flags (flag_dev)) 0) a (push (append "dev /" (append (raw_name i) "\n")) a))))))))

; Boots one program, started at boot, of these instructions.
(def boot_words ((flags int) (ws (list int))) int
  (boot (raw_initramfs (cons (Raw (bit_or flags (flag_boot)) (code ws)) (nil Raw)))))
