(def three () (list Sleeper)
  (sleep_add (sleep_add (sleep_add (nil Sleeper) 300 1) 100 2) 200 3))

(def pids ((ss (list Sleeper))) (list int)
  (if (is_empty ss) (nil int) (match (head ss) ((Sleeper t p) (cons p (pids (tail ss)))))))

(def test_sorted () int
  (check_str "soonest first" (pids (three)) (cons 2 (cons 3 (cons 1 (nil int))))))

(def test_ties_by_pid () int
  (check_str "pid order" (pids (sleep_add (sleep_add (nil Sleeper) 5 9) 5 4)) (cons 4 (cons 9 (nil int)))))

(def test_wake_due () int
  (match (wake_due (three) 200)
    ((Woken ps left)
      (add (check_str "woken" ps (cons 2 (cons 3 (nil int))))
           (check_str "left" (pids left) (cons 1 (nil int)))))))

(def test_wake_none () int
  (match (wake_due (three) 99)
    ((Woken ps left) (add (check_int "none" (length ps) 0) (check_int "all left" (length left) 3)))))

(def test_remove () int
  (check_str "without 3" (pids (sleep_remove (three) 3)) (cons 2 (cons 1 (nil int)))))

(def test_deadline () int
  (add (check_int "no sleepers" (slice_deadline (nil Sleeper) 1000) (add 1000 (slice_ns)))
       (add (check_int "sleeper first" (slice_deadline (three) 0) 100)
            (check_int "slice first" (slice_deadline (sleep_add (nil Sleeper) 99999999999 1) 0) (slice_ns)))))

(def test_soonest () int
  (add (check_int "none" (soonest (nil Sleeper)) -1)
       (check_int "first" (soonest (three)) 100)))
