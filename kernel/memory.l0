; memory.l0 -- what each address of a process is for, and so what the
; kernel may map there, and which frames processes share. Pure: it
; decides, and process.l0 maps.

; The parts of a process's address range, from the bottom: its image, its
; heap, its stack, its device pages, and outside, below user_base or from
; user_limit.
(data Area (AreaImage) (AreaHeap) (AreaStack) (AreaDevice) (AreaOutside))

; Where a process's image lies, its ELF's segments (spec section 10.3):
; their spans, each the pages from a page up to another, mapped with a
; perm, and the first page of its heap. A segment's pages that hold its
; file's bytes are mapped as it loads; the rest, its bss, as each is
; first touched, as the heap's are.
(data Span (Span int int int))
(data Layout (Layout (list Span) int))

; The first page of l's heap, just past its image.
(def layout_heap ((l Layout)) int (match l ((Layout spans heap) heap)))

; The perm of the span of l holding va, or -1 if none does.
(def span_perm ((l Layout) (va int)) int
  (match l ((Layout spans heap) (perm_in spans va))))

; The perm of the first of spans holding va, or -1 if none does.
(def perm_in ((spans (list Span)) (va int)) int
  (if (is_empty spans)
      -1
      (match (head spans)
        ((Span from to perm)
          (if (if (ge va from) (lt va to) false) perm (perm_in (tail spans) va))))))

; Which part of a process laid out as l address va is in.
(def area_of ((l Layout) (va int)) Area
  (if (lt va (user_base))
      (AreaOutside)
      (if (lt va (layout_heap l))
          (AreaImage)
          (if (lt va (heap_limit))
              (AreaHeap)
              (if (lt va (stack_top))
                  (AreaStack)
                  (if (lt va (user_limit)) (AreaDevice) (AreaOutside)))))))

; Whether va is above the stack, where only devices and DMA pages are.
(def in_device_area ((va int)) bool
  (if (ge va (stack_top)) (lt va (user_limit)) false))

; A process's pages: the frame each page of it maps, and how many of
; them are at its device pages, counted as pages are put and removed, so
; that its shared pages are counted without walking them all; at 4K a
; process maps tens of thousands, and walking them for proc_info and
; mem_info held every CPU's calls for 100 ms (roadmap 0038).
(data Pages (Pages (Map int int) int))

; No pages.
(def pages_new () Pages (Pages ((MapEmpty int int)) 0))

; The pages of map m, its device pages counted once.
(def pages_from_map ((m (Map int int))) Pages (Pages m (device_keys (map_keys m) 0)))

; n and how many of vas are at device pages.
(def device_keys ((vas (list int)) (n int)) int
  (if (is_empty vas) n (device_keys (tail vas) (if (in_device_area (head vas)) (add n 1) n))))

; The page -> frame map of ps, and how many of them are at device pages.
(def pages_map ((ps Pages)) (Map int int) (match ps ((Pages m n) m)))
(def pages_device ((ps Pages)) int (match ps ((Pages m n) n)))

; The frame ps has at page va, if any, and whether it has one.
(def pages_get ((ps Pages) (va int)) (Option int) (map_get (pages_map ps) va))
(def pages_has ((ps Pages) (va int)) bool (map_has (pages_map ps) va))

; ps with frame f at page va, in place of any it had there. The count is
; taken before the put, so the put is the map's last use and changes it in
; place rather than copying it whole.
(def pages_put ((ps Pages) (va int) (f int)) Pages
  (match ps
    ((Pages m n)
      (let n2 (if (map_has m va) n (if (in_device_area va) (add n 1) n))
        (Pages (map_put m va f) n2)))))

; ps without page va, the count taken first as pages_put's is.
(def pages_remove ((ps Pages) (va int)) Pages
  (match ps
    ((Pages m n)
      (let n2 (if (map_has m va) (if (in_device_area va) (sub n 1) n) n)
        (Pages (map_remove m va) n2)))))

; The address of the page holding va: va rounded down to a page.
(def page_of ((va int)) int
  (bit_and va (bit_xor (sub (page_size) 1) -1)))

; The heap pages from a page up to another, which the release call (spec
; section 10.3's 12) gives back: empty when the two are equal.
(data HeapRun (HeapRun int int))

; The whole pages of the heap of a process laid out as l that lie in the
; len bytes from base, whatever base and len a process passes: none for a
; len below 1, or a range that wraps or lies outside the heap.
(def heap_run ((l Layout) (base int) (len int)) HeapRun
  (if (if (lt len 1) true (lt base 0))
      (HeapRun 0 0)
      (let from (max (layout_heap l) (page_of (add base (sub (page_size) 1))))
        (let to (min (heap_limit) (page_of (add base len)))
          (if (lt from to) (HeapRun from to) (HeapRun 0 0))))))

; How few frames the host may have left before the kernel acts on every
; release: 32768 pages, 128 MB, a tenth of what QEMU's board starts with.
(def release_floor () int 32768)

; The fewest pages a release must name for the kernel to act on it while
; frames are plenty: 4096, 16 MB. Install's copy onto a RAM volume, timed
; on 1 and 2 CPUs, took 47 and 92 s acting on runs from 64 KB, 27 and
; 35 s from 1 MB, and 24 and 27 s from 16 MB, as when keeping them all.
(def release_run_min () int 4096)

; Whether the kernel unmaps the n pages a release names, with free frames
; left: when they are a run of release_run_min or more, or free is at or
; below release_floor, or the host cannot say (-3 off the board). A
; shorter run stays mapped, since a runtime that frees a small block
; mostly fills those pages again soon, and unmapping them costs a fault
; then and a TLB flush on every CPU now: install's copy onto a RAM
; volume faulted 2 million times so, and took twice as long on several
; CPUs as on one. A page kept is named again when it next comes free,
; and no page named can be taken back later, since the runtime may have
; filled it since; so a large block freed comes back at once, and a
; process gives back its small ones once memory runs low.
(def release_unmaps ((free int) (n int)) bool
  (if (lt free 0) true (if (ge n (release_run_min)) true (le free (release_floor)))))

; The permissions of a zeroed page the kernel maps at va of a process
; laid out as l when it is first touched, or -1 if nothing is mapped there
; on demand: in the image, its segment's, for a page of its bss, and none
; between segments; the heap and stack only readable and writable.
(def demand_perm ((l Layout) (va int)) int
  (match (area_of l va)
    ((AreaImage) (span_perm l va))
    ((AreaHeap) 1)
    ((AreaStack) 1)
    ((AreaDevice) -1)
    ((AreaOutside) -1)))

; Whether the kernel may copy into page va of a process laid out as l,
; as the process itself may write it: not into its code or rodata. Every
; page above the image a process has is writable.
(def may_write ((l Layout) (va int)) bool
  (match (area_of l va)
    ((AreaImage) (let p (span_perm l va) (if (lt p 0) false (eq (bit_and p 1) 1))))
    ((AreaHeap) true)
    ((AreaStack) true)
    ((AreaDevice) true)
    ((AreaOutside) false)))

; The pages that hold the n bytes from va, lowest first; none when n is 0.
(def range_pages ((va int) (n int)) (list int)
  (if (le n 0)
      (nil int)
      (pages_down (page_of (add va (sub n 1))) (page_of va) (nil int))))

; The pages from first up to p onto acc, lowest first, working down from p.
(def pages_down ((p int) (first int) (acc (list int))) (list int)
  (if (lt p first)
      acc
      (pages_down (sub p (page_size)) first (cons p acc))))

; What the kernel must do before copying the n bytes from va of a process
; laid out as l, whose frames are pages, out of it, or into it if write:
; map the pages listed, which are not mapped yet and may be mapped on
; demand; or refuse, because some byte is outside the user range, on a
; device, nowhere a page may be mapped, or, to write, where the process
; may not write.
(data Plan (PlanMap (list int)) (PlanBad))

; The Plan for copying the n bytes from va: nothing to map for none, a
; refusal for a negative n or bytes outside the user range.
(def range_plan ((l Layout) (pages (Map int int)) (va int) (n int) (write bool)) Plan
  (if (lt n 0)
      (PlanBad)
      (if (eq n 0)
          (PlanMap (nil int))
          (if (if (lt va (user_base)) true (gt n (sub (user_limit) va)))
              (PlanBad)
              (plan_pages l pages (range_pages va n) write (nil int))))))

; The rest of range_plan, page by page through ps: each unmapped page onto
; acc, or a refusal at the first the copy may not write or no page may be
; mapped at on demand.
(def plan_pages ((l Layout) (pages (Map int int)) (ps (list int)) (write bool) (acc (list int))) Plan
  (if (is_empty ps)
      (PlanMap (rev acc))
      (if (if write (not (may_write l (head ps))) false)
          (PlanBad)
          (if (map_has pages (head ps))
              (plan_pages l pages (tail ps) write acc)
              (if (lt (demand_perm l (head ps)) 0)
                  (PlanBad)
                  (plan_pages l pages (tail ps) write (cons (head ps) acc)))))))

; ------------------------------------------------------------ device pages

; A process's device pages, from stack_top up to user_limit, as given
; and given up: top, the first page never given, and below it the runs
; of pages given up again, each the pages from a page up to another,
; highest first, none touching another or ending at top. Pages given up
; in any order are given again, so a process that maps and unmaps never
; runs out while its memory is freed.
(data DevRun (DevRun int int))
(data DevPages (DevPages int (list DevRun)))

; A new process's device pages: none given yet.
(def dev_pages_new () DevPages (DevPages (stack_top) (nil DevRun)))

; The first page of pool never given.
(def dev_top ((pool DevPages)) int (match pool ((DevPages top runs) top)))

; How many runs of pages given up pool has below its top.
(def dev_run_count ((pool DevPages)) int (match pool ((DevPages top runs) (length runs))))

; span bytes of pages taken from a pool: the first, and the pool without
; them; or none, no run nor the pages from top below user_limit holding
; them.
(data DevTake (DevTaken int DevPages) (DevFull))

; span bytes, a whole number of pages, taken from pool: from the start of
; the first run, highest first, that holds them, or else from top.
(def dev_take ((pool DevPages) (span int)) DevTake
  (match pool
    ((DevPages top runs)
      (match (take_run runs span (nil DevRun))
        ((RunTaken va rest) (DevTaken va (DevPages top rest)))
        ((RunNone)
          (if (gt (add top span) (user_limit))
              (DevFull)
              (DevTaken top (DevPages (add top span) runs))))))))

; A run's pages taken: the first, and the runs left; or none that held
; them.
(data RunTake (RunTaken int (list DevRun)) (RunNone))

; The first of runs holding span bytes, its start taken and the rest of
; it kept, the runs passed over onto acc, highest first in reverse.
(def take_run ((runs (list DevRun)) (span int) (acc (list DevRun))) RunTake
  (if (is_empty runs)
      (RunNone)
      (match (head runs)
        ((DevRun from to)
          (if (lt (sub to from) span)
              (take_run (tail runs) span (cons (head runs) acc))
              (RunTaken from (runs_onto acc (if (eq (sub to from) span)
                                                (tail runs)
                                                (cons (DevRun (add from span) to) (tail runs))))))))))

; The runs acc, reversed, in front of rest.
(def runs_onto ((acc (list DevRun)) (rest (list DevRun))) (list DevRun)
  (if (is_empty acc) rest (runs_onto (tail acc) (cons (head acc) rest))))

; pool with the span bytes of pages from va given up, joined to any run
; they touch, and top lowered to the run that then ends at it.
(def dev_give ((pool DevPages) (va int) (span int)) DevPages
  (if (le span 0)
      pool
      (match pool
        ((DevPages top runs) (dev_lower top (give_run runs va (add va span) (nil DevRun)))))))

; The pages from from up to to put into runs, highest first, joined with
; those they touch, the runs above them onto acc in reverse.
(def give_run ((runs (list DevRun)) (from int) (to int) (acc (list DevRun))) (list DevRun)
  (if (is_empty runs)
      (runs_onto acc (cons (DevRun from to) (nil DevRun)))
      (match (head runs)
        ((DevRun a b)
          (if (gt a to)
              (give_run (tail runs) from to (cons (head runs) acc))
              (if (lt b from)
                  (runs_onto acc (cons (DevRun from to) runs))
                  (give_run (tail runs) (min a from) (max b to) acc)))))))

; The pool of top and runs, its highest run dropped and top lowered to
; its start if the run ends at top.
(def dev_lower ((top int) (runs (list DevRun))) DevPages
  (if (is_empty runs)
      (DevPages top runs)
      (match (head runs)
        ((DevRun from to) (if (ge to top) (DevPages from (tail runs)) (DevPages top runs))))))

; Where the region system call maps the len bytes of device memory from
; base, taken from the device pages pool: at va, pool then without them,
; and the process reaches base at addr. Or the call's result when it
; maps nothing: -3 for a range no device could hold, -5 when the
; process's device pages have run out.
(data RegionPlan (RegionAt int DevPages int) (RegionRefused int))

; The RegionPlan for len bytes from base: refused for under a byte, a
; negative base, over 4 GB, or a base past 2^48; the pages spanned taken
; from pool if they fit.
(def region_plan ((pool DevPages) (base int) (len int)) RegionPlan
  (if (if (lt len 1) true (if (lt base 0) true (if (gt len 4294967296) true (gt base 281474976710656))))
      (RegionRefused -3)
      (match (dev_take pool (add (sub (page_of (add base (sub len 1))) (page_of base)) (page_size)))
        ((DevFull) (RegionRefused -5))
        ((DevTaken va rest) (RegionAt va rest (add va (sub base (page_of base))))))))

; What the unregion call (spec section 10.3's 13) gives back of the len
; bytes at addr, which region gave for a range of device memory: the
; pages from va, span bytes of them, to unmap and give to the pool; or
; nothing. A region over a process's own DMA or shared pages mapped
; nothing, and nothing is given back of it.
(data UnregionPlan (UnregionAt int int) (UnregionNone))

; The UnregionPlan for len bytes at addr, of a process whose frames are
; pages and whose device pages are pool: the pages they span, if each is
; one the region call mapped device memory at, one pool has given that
; holds no frame of pages; none for anything else, under a byte or over
; 4 GB, or outside the device pages.
(def unregion_plan ((pool DevPages) (pages (Map int int)) (addr int) (len int)) UnregionPlan
  (if (if (lt len 1) true (gt len 4294967296))
      (UnregionNone)
      (let from (page_of addr)
        (let to (add (page_of (add addr (sub len 1))) (page_size))
          (if (if (in_device_area from) (if (gt to from) (le to (dev_top pool)) false) false)
              (if (dev_all_device pool pages from to) (UnregionAt from (sub to from)) (UnregionNone))
              (UnregionNone))))))

; Whether each page from va up to to holds device memory: pool has given
; it, in no run of pages given up, and it holds no frame of pages.
(def dev_all_device ((pool DevPages) (pages (Map int int)) (va int) (to int)) bool
  (if (ge va to)
      true
      (if (if (map_has pages va) true (dev_given_up pool va))
          false
          (dev_all_device pool pages (add va (page_size)) to))))

; Whether page va lies in one of pool's runs of pages given up.
(def dev_given_up ((pool DevPages) (va int)) bool
  (match pool ((DevPages top runs) (in_runs runs va))))

; Whether va lies in one of runs.
(def in_runs ((runs (list DevRun)) (va int)) bool
  (if (is_empty runs)
      false
      (match (head runs)
        ((DevRun from to) (if (if (ge va from) (lt va to) false) true (in_runs (tail runs) va))))))

; Where the dma_alloc call maps n pages of memory a device can reach,
; taken from the device pages pool: at va, through the page before
; after, pool then without them. Or the call's result when it maps
; nothing: err_too_big for fewer than one page or more than dma_limit,
; err_fault when the process's device pages have run out.
(data DmaPlan (DmaAt int int DevPages) (DmaRefused int))

; The DmaPlan for n pages, taken from pool if they fit.
(def dma_plan ((pool DevPages) (n int)) DmaPlan
  (if (if (lt n 1) true (gt n (dma_limit)))
      (DmaRefused (err_too_big))
      (match (dev_take pool (mul n (page_size)))
        ((DevFull) (DmaRefused (err_fault)))
        ((DevTaken va rest) (DmaAt va (add va (mul n (page_size))) rest)))))

; ----------------------------------------------------------------- freeing

; When a process ends, the kernel frees its space (spec section 6.13's
; space_free), and then every frame of it no space maps any more
; (frame_free). A frame of its heap or stack, or of its image's data, is
; its alone, so it is freed at once. A frame at its device pages, DMA or
; shared, may be mapped by other processes too, and so may one of its
; image's code or rodata (an ImageSeg's), so it is freed once the last of
; them has ended, the kernel counting each mapping, since frame_free of a
; frame still mapped is a runtime error. A driver's frames at its device
; pages are never freed: its device may still read and write them, and
; only a driver could stop it.

; A read-only segment of an image that processes running it share: its
; address, its bytes in the file, its perm, the frames of its pages in
; order, and the spaces of the live processes that map them.
(data ImageSeg (ImageSeg int int int (list int) (list int)))

; For each frame mapped at device pages or shared as an image's, how many
; mappings of it live processes have, a driver's device pages counting
; for good; the image segments shared, by the hash of their bytes; and
; the file windows.
(data Mem (Mem (Map int int) (Map int (list ImageSeg)) (list Window)))

; The counts before any process maps a device page: none.
(def mem_new () Mem (Mem ((MapEmpty int int)) ((MapEmpty int (list ImageSeg))) (nil Window)))

; How many frames m counts mappings of: every shared, DMA and image frame
; shared still given, each once, however many processes map it.
(def mem_shared_frames ((m Mem)) int (match m ((Mem counts imgs wins) (map_size counts))))

; How many mappings of frame f m counts, 0 for a frame it does not know.
(def mem_count ((m Mem) (f int)) int
  (match m ((Mem counts imgs wins) (match (map_get counts f) ((Some n) n) ((None) 0)))))

; How many of pages, a process's in space s, are of an image segment s
; shares, outside its device pages, and frames m counts: the only shared
; pages a process has but its device pages, as only those and image
; segments' frames are counted.
(def mem_image_pages ((m Mem) (s int) (pages (Map int int))) int
  (match m ((Mem counts imgs wins) (seg_lists_pages (map_values imgs) s pages m 0))))

; n and the pages of space s's segments among lists, as mem_image_pages.
(def seg_lists_pages ((lists (list (list ImageSeg))) (s int) (pages (Map int int)) (m Mem) (n int)) int
  (if (is_empty lists) n (seg_lists_pages (tail lists) s pages m (segs_pages (head lists) s pages m n))))

; n and the pages of those of segs space s shares.
(def segs_pages ((segs (list ImageSeg)) (s int) (pages (Map int int)) (m Mem) (n int)) int
  (if (is_empty segs)
      n
      (segs_pages (tail segs) s pages m
        (match (head segs)
          ((ImageSeg va len perm fs ss)
            (if (any_eq s ss) (seg_pages_from pages m (page_of va) (add va len) n) n))))))

; n and how many pages from page va up to end pages maps, outside the
; device pages, to a frame m counts.
(def seg_pages_from ((pages (Map int int)) (m Mem) (va int) (end int) (n int)) int
  (if (ge va end)
      n
      (seg_pages_from pages m (add va (page_size)) end
        (if (in_device_area va)
            n
            (match (map_get pages va) ((Some f) (if (gt (mem_count m f) 0) (add n 1) n)) ((None) n))))))

; m with one more mapping of f at a live process's device pages, or of
; an image segment's.
(def mem_share ((m Mem) (f int)) Mem
  (let n (mem_count m f)
    (match m ((Mem counts imgs wins) (Mem (map_put counts f (add n 1)) imgs wins)))))

; m with one more mapping of each of fs.
(def mem_share_all ((m Mem) (fs (list int))) Mem
  (if (is_empty fs) m (mem_share_all (mem_share m (head fs)) (tail fs))))

; ---------------------------------------------------------- shared images

; The segments m shares whose bytes hash to key and which lie at va, len
; bytes of the file, with perm: those whose bytes may be the same, which
; the kernel compares to be sure.
(def mem_image_candidates ((m Mem) (key int) (va int) (len int) (perm int)) (list ImageSeg)
  (match m
    ((Mem counts imgs wins)
      (match (map_get imgs key)
        ((None) (nil ImageSeg))
        ((Some segs) (segs_at segs va len perm (nil ImageSeg)))))))

; Those of segs that lie at va, len bytes of the file, with perm, onto
; acc, in order.
(def segs_at ((segs (list ImageSeg)) (va int) (len int) (perm int) (acc (list ImageSeg))) (list ImageSeg)
  (if (is_empty segs)
      (rev acc)
      (segs_at (tail segs) va len perm (if (image_seg_at (head segs) va len perm) (cons (head segs) acc) acc))))

; Whether g lies at va, len bytes of the file, with perm.
(def image_seg_at ((g ImageSeg) (va int) (len int) (perm int)) bool
  (match g ((ImageSeg gva glen gperm fs ss) (if (eq gva va) (if (eq glen len) (eq gperm perm) false) false))))

; The frames of g's pages, in order.
(def image_seg_frames ((g ImageSeg)) (list int) (match g ((ImageSeg va len perm fs ss) fs)))

; A space that maps g, to compare its bytes with: the first of them.
(def image_seg_space ((g ImageSeg)) int (match g ((ImageSeg va len perm fs ss) (head ss))))

; m with space s mapping the frames of g too, which hashes to key: a
; mapping more of each.
(def mem_image_join ((m Mem) (key int) (g ImageSeg) (s int)) Mem
  (match (mem_share_all m (image_seg_frames g))
    ((Mem counts imgs wins)
      (match (map_get imgs key)
        ((None) (Mem counts imgs wins))
        ((Some segs) (Mem counts (map_put imgs key (segs_joined segs g s (nil ImageSeg))) wins))))))

; segs onto acc, in order, with s among the spaces of the one that is g.
(def segs_joined ((segs (list ImageSeg)) (g ImageSeg) (s int) (acc (list ImageSeg))) (list ImageSeg)
  (if (is_empty segs)
      (rev acc)
      (segs_joined (tail segs) g s (cons (image_seg_joined (head segs) g s) acc))))

; h, with s among its spaces if it is g.
(def image_seg_joined ((h ImageSeg) (g ImageSeg) (s int)) ImageSeg
  (if (eq h g) (match h ((ImageSeg va len perm fs ss) (ImageSeg va len perm fs (cons s ss)))) h))

; m sharing a new segment, hashing to key, at va, len bytes of the file,
; with perm, its pages' frames fs, which space s alone maps so far.
(def mem_image_new ((m Mem) (key int) (va int) (len int) (perm int) (fs (list int)) (s int)) Mem
  (match (mem_share_all m fs)
    ((Mem counts imgs wins)
      (let segs (match (map_get imgs key) ((None) (nil ImageSeg)) ((Some gs) gs))
        (Mem counts (map_put imgs key (cons (ImageSeg va len perm fs (cons s (nil int))) segs)) wins)))))

; m once space s maps no segment: s taken from each, and a segment no
; space maps any more forgotten. Its frames' counts are mem_release's.
(def mem_image_leave ((m Mem) (s int)) Mem
  (match m
    ((Mem counts imgs wins)
      (Mem counts (images_without imgs (map_keys imgs) s) wins))))

; imgs with s taken from the segments at keys, and a key with none left
; dropped.
(def images_without ((imgs (Map int (list ImageSeg))) (keys (list int)) (s int)) (Map int (list ImageSeg))
  (if (is_empty keys)
      imgs
      (match (map_get imgs (head keys))
        ((None) (images_without imgs (tail keys) s))
        ((Some segs)
          (let left (segs_without segs s (nil ImageSeg))
            (images_without (if (is_empty left) (map_remove imgs (head keys)) (map_put imgs (head keys) left))
                            (tail keys) s))))))

; segs with s taken from each, onto acc, those left with no space dropped.
(def segs_without ((segs (list ImageSeg)) (s int) (acc (list ImageSeg))) (list ImageSeg)
  (if (is_empty segs)
      (rev acc)
      (match (head segs)
        ((ImageSeg va len perm fs ss)
          (let ss2 (without s ss (nil int))
            (segs_without (tail segs) s (if (is_empty ss2) acc (cons (ImageSeg va len perm fs ss2) acc))))))))

; How many segments m shares.
(def mem_image_count ((m Mem)) int
  (match m ((Mem counts imgs wins) (sum_lengths (map_values imgs) 0))))

; n and the lengths of each of ls.
(def sum_lengths ((ls (list (list ImageSeg))) (n int)) int
  (if (is_empty ls) n (sum_lengths (tail ls) (add n (length (head ls))))))

; What a process's end leaves to do: m without its mappings, and the
; frames to free once its space is.
(data Released (Released Mem (list int)))

; For a process whose frames are pages, which drove devices if dev.
(def mem_release ((m Mem) (pages (Map int int)) (dev bool)) Released
  (release_pages m pages (map_keys pages) dev (nil int)))

; The rest of mem_release, through the pages at vas: a frame below the
; device pages onto acc to free, unless it is an image's shared, when it
; has one mapping fewer; one at them kept for a driver, else one mapping
; of it fewer.
(def release_pages ((m Mem) (pages (Map int int)) (vas (list int)) (dev bool) (acc (list int))) Released
  (if (is_empty vas)
      (Released m acc)
      (match (map_get pages (head vas))
        ((None) (release_pages m pages (tail vas) dev acc))
        ((Some f)
          (if (not (in_device_area (head vas)))
              (if (gt (mem_count m f) 0)
                  (release_shared m pages (tail vas) dev f acc)
                  (release_pages m pages (tail vas) dev (cons f acc)))
              (if dev
                  (release_pages m pages (tail vas) dev acc)
                  (release_shared m pages (tail vas) dev f acc)))))))

; The same, one mapping of shared frame f fewer, and f to free if it was
; the last.
(def release_shared ((m Mem) (pages (Map int int)) (vas (list int)) (dev bool) (f int) (acc (list int))) Released
  (match (mem_unshare m f)
    ((Unshared m2 last) (release_pages m2 pages vas dev (if last (cons f acc) acc)))))

; m with one mapping of shared frame f fewer, as when a process unmaps it
; or has it taken back, and whether it was the last, so f is to be freed.
(data Unshared (Unshared Mem bool))

; One mapping of f taken from m: its count one less, or f dropped from m
; at its last.
(def mem_unshare ((m Mem) (f int)) Unshared
  (let n (mem_count m f)
    (match m
      ((Mem counts imgs wins)
        (if (gt n 1)
            (Unshared (Mem (map_put counts f (sub n 1)) imgs wins) false)
            (Unshared (Mem (map_remove counts f) imgs wins) true))))))

; ---------------------------------------------------------------- windows

; A file window: pages the kernel maps into a file server's device pages
; for one client's file calls to it, which the kernel copies a call's
; bytes through (spec, The kernel). Its client's pid, the server's pid
; and port, where the server reaches it, and the server's space. The
; server unmaps it once told its client has exited; the kernel forgets it
; then, when the server ends, and when the server unmaps any page of it
; or has one taken back, so that a window the kernel keeps is always
; mapped whole, in a space still the server's, for space_read and
; space_write, which reach only what is mapped. The copies need no look
; at the server's record, which is out of the table while it makes the
; call that answers a read.
(data Window (Window int int int int int))

; The pages of a window: 64 KB, as many as a disk request moves.
(def window_pages () int 16)

; m's windows.
(def mem_windows ((m Mem)) (list Window) (match m ((Mem counts imgs wins) wins)))

; m with its windows ws.
(def mem_with_windows ((m Mem) (ws (list Window))) Mem
  (match m ((Mem counts imgs wins) (Mem counts imgs ws))))

; Where the server at port reaches client's window, or -1 if client has
; none to it.
(def mem_window_at ((m Mem) (client int) (port int)) int
  (window_va (mem_windows m) client port))

; The rest of mem_window_at, among ws.
(def window_va ((ws (list Window)) (client int) (port int)) int
  (if (is_empty ws)
      -1
      (match (head ws)
        ((Window c sp p va s) (if (if (eq c client) (eq p port) false) va (window_va (tail ws) client port))))))

; The server's pid client's window to port has, or -1 if it has none.
(def mem_window_server ((m Mem) (client int) (port int)) int
  (window_server (mem_windows m) client port))

; The rest of mem_window_server, among ws.
(def window_server ((ws (list Window)) (client int) (port int)) int
  (if (is_empty ws)
      -1
      (match (head ws)
        ((Window c sp p va s) (if (if (eq c client) (eq p port) false) sp (window_server (tail ws) client port))))))

; The space of the server of client's window to port, or -1 if it has
; none.
(def mem_window_space ((m Mem) (client int) (port int)) int
  (window_space_of (mem_windows m) client port))

; The rest of mem_window_space, among ws.
(def window_space_of ((ws (list Window)) (client int) (port int)) int
  (if (is_empty ws)
      -1
      (match (head ws)
        ((Window c sp p va s) (if (if (eq c client) (eq p port) false) s (window_space_of (tail ws) client port))))))

; The bytes a window holds.
(def window_bytes () int (mul (window_pages) 4096))

; m without the windows server sp no longer maps whole in pages, which
; it has unmapped a page of, or had one taken back.
(def mem_windows_mapped ((m Mem) (sp int) (pages (Map int int))) Mem
  (mem_with_windows m (windows_mapped (mem_windows m) sp pages)))

; The rest of mem_windows_mapped, among ws.
(def windows_mapped ((ws (list Window)) (sp int) (pages (Map int int))) (list Window)
  (if (is_empty ws)
      ws
      (match (head ws)
        ((Window c s2 p va s)
          (if (if (eq s2 sp) (not (pages_all pages va (window_pages))) false)
              (windows_mapped (tail ws) sp pages)
              (cons (head ws) (windows_mapped (tail ws) sp pages)))))))

; Whether pages maps each of the n pages from va.
(def pages_all ((pages (Map int int)) (va int) (n int)) bool
  (if (le n 0) true (if (map_has pages va) (pages_all pages (add va (page_size)) (sub n 1)) false)))

; m with w.
(def mem_window_add ((m Mem) (w Window)) Mem
  (mem_with_windows m (cons w (mem_windows m))))

; m without client's window to port, taken back before its server knew.
(def mem_window_drop ((m Mem) (client int) (port int)) Mem
  (mem_with_windows m (window_without (mem_windows m) client port)))

; ws without client's window to port.
(def window_without ((ws (list Window)) (client int) (port int)) (list Window)
  (if (is_empty ws)
      ws
      (match (head ws)
        ((Window c sp p va s)
          (if (if (eq c client) (eq p port) false)
              (tail ws)
              (cons (head ws) (window_without (tail ws) client port)))))))

; m without the windows pid is the client or the server of, pid having
; ended.
(def mem_windows_forget ((m Mem) (pid int)) Mem
  (mem_with_windows m (windows_not (mem_windows m) pid)))

; ws without those pid is the client or the server of.
(def windows_not ((ws (list Window)) (pid int)) (list Window)
  (if (is_empty ws)
      ws
      (match (head ws)
        ((Window c sp p va s)
          (if (if (eq c pid) true (eq sp pid))
              (windows_not (tail ws) pid)
              (cons (head ws) (windows_not (tail ws) pid)))))))
