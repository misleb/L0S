; process.l0 -- a process: its address space, its registers, the frames
; mapped into it, and what it waits for. The functions here make and map
; and copy, and check first, so nothing a process asks for can make the
; kernel fail at run time.

; What a process is doing when it is not running.
(data State
  (Ready)                      ; it may run
  (Receiving int int int)      ; waiting on a port: port, buf, max
  (ReceivingSet int int int)   ; waiting on any port of its set: how many it holds, buf, max
  (Waiting int)                ; waiting for a pid to exit
  (Sleeping)                   ; waiting for its time, on the sleepers list
  (Blocked int)                ; waiting for room on its terminal's or file server's port, to make its call again
  (ReadingTty int int int)     ; waiting for a line from its terminal: the reply port, buf, n
  (AwaitingFs int int int int int)) ; waiting for a file server's answer: its port, the reply port, what for, buf, n

; A file a process has open: its entry in the initramfs, and how far it
; has read; or a file of a volume, the port of the server that has it
; open, and the server's handle for it.
(data Open (Open int int) (OpenRemote int int))

; Every file a process has open, by stream, and the next stream to give.
(data Files (Files (Map int Open) int))

; A process's terminal: the port its standard input, output, and error
; go to, 0 for the kernel's own, the serial line and the inittab's stdin;
; the port its terminal's lines come back on, 0 until it first reads;
; and the last line it read, with how much of it it has had, so the rest
; is read from it in place.
(data Tty (Tty int int bytes int))

; A new process's terminal: the kernel's own, no reply port yet, and no
; line left over.
(def tty_none () Tty (Tty 0 0 (bytes_from_list (nil int)) 0))

; What a process is doing, the pid that spawned it, 0 for the kernel,
; the ports to tell when it exits, its arguments, its open files, its
; terminal, where its image lies, and its current directory.
(data Life (Life State int (list int) (list (list int)) Files Tty Layout (list int)))

; pid, entry index of its program, space, context, page -> frame for
; every frame mapped, its device pages given and free, and its life.
(data Proc (Proc int int int (array int) (Map int int) DevPages Life))

; p's pid, the entry index of its program, its space, and its state.
(def proc_pid ((p Proc)) int (match p ((Proc pid m s c pages dev st) pid)))
(def proc_module ((p Proc)) int (match p ((Proc pid m s c pages dev st) m)))
(def proc_space ((p Proc)) int (match p ((Proc pid m s c pages dev st) s)))
(def proc_state ((p Proc)) State
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) st)))))

; The pid that spawned p, 0 for the kernel.
(def proc_parent ((p Proc)) int
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) parent)))))

; The ports to tell when p exits, the latest added first.
(def proc_watchers ((p Proc)) (list int)
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) ws)))))

; p's arguments.
(def proc_args ((p Proc)) (list (list int))
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) args)))))

; Where p's image lies, and so what may be mapped where.
(def proc_layout ((p Proc)) Layout
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) lay)))))

; p, with port told when it exits.
(def proc_watch ((p Proc) (port int)) Proc
  (match p
    ((Proc pid m s c pages dev life)
      (match life ((Life st parent ws args fs tty lay cwd) (Proc pid m s c pages dev (Life st parent (cons port ws) args fs tty lay cwd)))))))

; ------------------------------------------------------------- terminal

; p's terminal.
(def proc_tty ((p Proc)) Tty
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) tty)))))

; p with tty as its terminal.
(def proc_set_tty ((p Proc) (tty Tty)) Proc
  (match p
    ((Proc pid m s c pages dev life)
      (match life ((Life st parent ws args fs old lay cwd)(Proc pid m s c pages dev (Life st parent ws args fs tty lay cwd)))))))

; ------------------------------------------------- current directory

; p's current directory: an absolute path, "/" for a new process's, with
; no final / but for that.
(def proc_cwd ((p Proc)) (list int)
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) cwd)))))

; p with cwd as its current directory.
(def proc_set_cwd ((p Proc) (cwd (list int))) Proc
  (match p
    ((Proc pid m s c pages dev life)
      (match life ((Life st parent ws args fs tty lay old) (Proc pid m s c pages dev (Life st parent ws args fs tty lay cwd)))))))

; The port p's terminal is, 0 for the kernel's own.
(def proc_tty_port ((p Proc)) int (match (proc_tty p) ((Tty port reply rest off) port)))

; p, to make the call it trapped with again when it next runs: its pc
; back on the svc.
(def proc_rewind ((p Proc)) Proc
  (match p ((Proc pid m s c pages dev st) (Proc pid m s (array_set c 32 (sub (array_get c 32) 4)) pages dev st))))

; ------------------------------------------------------------ open files

; A new process's files: none open, and stream 3 next, after standard
; input, output, and error.
(def files_none () Files (Files ((MapEmpty int Open)) 3))

; The files p has open.
(def proc_files ((p Proc)) Files
  (match p ((Proc pid m s c pages dev life) (match life ((Life st parent ws args fs tty lay cwd) fs)))))

; p with fs as its open files.
(def proc_set_files ((p Proc) (fs Files)) Proc
  (match p
    ((Proc pid m s c pages dev life)
      (match life ((Life st parent ws args old tty lay cwd)(Proc pid m s c pages dev (Life st parent ws args fs tty lay cwd)))))))

; p with entry e open on a new stream, and the stream; or -5, open_limit
; files being open already.
(data Opened (Opened Proc int))

; p with initramfs entry e open on its next stream, read from the start.
(def proc_open ((p Proc) (e int)) Opened
  (match (proc_files p)
    ((Files open next)
      (if (ge (map_size open) (open_limit))
          (Opened p -5)
          (Opened (proc_set_files p (Files (map_put open next (Open e 0)) (add next 1))) next)))))

; p with handle h of the file server at port open on a new stream, and
; the stream; or -5, as proc_open.
(def proc_open_remote ((p Proc) (port int) (h int)) Opened
  (match (proc_files p)
    ((Files open next)
      (if (ge (map_size open) (open_limit))
          (Opened p -5)
          (Opened (proc_set_files p (Files (map_put open next (OpenRemote port h)) (add next 1))) next)))))

; Whether p has open_limit files open, and can open no more.
(def proc_files_full ((p Proc)) bool
  (match (proc_files p) ((Files open next) (ge (map_size open) (open_limit)))))

; The file p has open on stream s, if it has one.
(def proc_open_file ((p Proc) (s int)) (Option Open)
  (match (proc_files p) ((Files open next) (map_get open s))))

; p, having read stream s up to offset.
(def proc_seek ((p Proc) (s int) (e int) (offset int)) Proc
  (match (proc_files p)
    ((Files open next) (proc_set_files p (Files (map_put open s (Open e offset)) next)))))

; p without stream s, and whether it had it open.
(data ClosedFile (ClosedFile Proc bool))

; p with stream s closed, if it was open.
(def proc_close ((p Proc) (s int)) ClosedFile
  (match (proc_files p)
    ((Files open next)
      (if (map_has open s)
          (ClosedFile (proc_set_files p (Files (map_remove open s) next)) true)
          (ClosedFile p false)))))

; p's record for proc_info: running, if it is the process asking.
(def proc_info_record ((p Proc) (mem Mem) (running bool)) (list int)
  (let st (proc_state p)
    (match (proc_page_counts p mem)
      ((PageCounts own shared)
        (proc_record (if running (state_running) (state_code st)) (proc_parent p) (proc_module p)
                     (if running 0 (state_detail st)) own shared)))))

; How many pages p has mapped of its own, and how many it may share: those
; at its device pages, which are shared or DMA memory, and its image's
; shared code and rodata.
(data PageCounts (PageCounts int int))

; p's pages, counted as PageCounts says, by what mem counts.
(def proc_page_counts ((p Proc) (mem Mem)) PageCounts
  (let pages (proc_pages p)
    (let shared (count_shared_pages pages (map_keys pages) mem 0)
      (PageCounts (sub (map_size pages) shared) shared))))

; n and how many of the pages vas are device pages, or frames mem counts.
(def count_shared_pages ((pages (Map int int)) (vas (list int)) (mem Mem) (n int)) int
  (if (is_empty vas)
      n
      (count_shared_pages pages (tail vas) mem
        (if (if (in_device_area (head vas)) true
                (match (map_get pages (head vas)) ((Some f) (gt (mem_count mem f) 0)) ((None) false)))
            (add n 1)
            n))))

; The code proc_info gives for state s (abi.l0's state_*): a terminal
; write blocked for room is state_writing, a file server's answer awaited
; state_filing.
(def state_code ((s State)) int
  (match s
    ((Ready) (state_ready))
    ((Receiving port buf max) (state_receiving))
    ((ReceivingSet n buf max) (state_receiving_set))
    ((Waiting pid) (state_waiting))
    ((Sleeping) (state_sleeping))
    ((Blocked port) (state_writing))
    ((ReadingTty reply buf n) (state_reading))
    ((AwaitingFs server reply op buf n) (state_filing))))

; What a state waits on: a port, a pid, or nothing. A terminal read's is
; the port its line comes back on; a file server's answer's, the server's
; port.
(def state_detail ((s State)) int
  (match s
    ((Ready) 0)
    ((Receiving port buf max) port)
    ((ReceivingSet n buf max) n)
    ((Waiting pid) pid)
    ((Sleeping) 0)
    ((Blocked port) port)
    ((ReadingTty reply buf n) reply)
    ((AwaitingFs server reply op buf n) server)))

; p answering its call with v as its result.
(def proc_answer ((p Proc) (v int)) Proc
  (match p ((Proc pid m s c pages dev st) (Proc pid m s (answer c v) pages dev st))))

; p in state st.
(def proc_set_state ((p Proc) (st State)) Proc
  (match p
    ((Proc pid m s c pages dev life)
      (match life ((Life old parent ws args fs tty lay cwd)(Proc pid m s c pages dev (Life st parent ws args fs tty lay cwd)))))))

; A word of p's registers.
(def proc_reg ((p Proc) (i int)) int
  (match p ((Proc pid m s c pages dev st) (array_get c i))))

; ---------------------------------------------------------------- creating

; What the kernel makes of a program's image: an ELF of spec section
; 10.3, its entry, its segments, and where its heap starts; or one it
; refuses, with the code it answers, err_denied: not an ELF, one the
; section does not allow, or one for another CPU.
(data Image (ElfImage int (list ElfSeg) int) (BadImage int))

; The image that is the bytes of input from start up to end.
(def image_of ((input bytes) (start int) (end int)) Image
  (match (elf_read input start end (elf_machine (machine)))
    ((Elf entry segs heap) (ElfImage entry segs heap))
    ((ElfRefused why) (BadImage (err_denied)))))

; The most bytes a program's file has, whatever it holds: 64 MB, an ELF's
; symbols and all, which the kernel copies whole out of a process that
; starts a program from its own memory (spawn_image).
(def image_file_room () int 67108864)

; A process made, or none, the host having run out or the image refused.
(data Created (Created Proc) (CreateFailed))

; A new process pid, spawned by parent, running module index m with
; args, whose image is img, the bytes of input from start up to end,
; mapped as img says, ready to run from its entry, its terminal the port
; tty. If the host runs out part way, what was made is freed. A BadImage
; makes nothing.
(def proc_create ((pid int) (parent int) (m int) (args (list (list int))) (tty int) (input bytes) (start int) (end int) (img Image)) Created
  (let s (space_new)
    (if (lt s 0)
        (CreateFailed)
        (match img
          ((ElfImage entry segs heap)
            (proc_loaded pid parent m args tty s entry (Layout (spans_of segs) heap)
                         (load_segs s input start segs ((MapEmpty int int)))))
          ((BadImage code) (let f (space_free s) (CreateFailed)))))))

; The rest of proc_create, once its segments are loaded into space s, or
; failed to be: the process, with its registers set to start at entry on
; an empty stack; or, after a failure, s and the frames mapped so far
; freed.
(def proc_loaded ((pid int) (parent int) (m int) (args (list (list int))) (tty int) (s int) (entry int) (lay Layout) (l Load)) Created
  (match l
    ((ImageLoaded pages)
      (Created (Proc pid m s (user_context entry (stack_top)) pages (dev_pages_new)
                     (Life (Ready) parent (nil int) args (files_none)
                           (match (tty_none) ((Tty none reply rest off) (Tty tty reply rest off))) lay "/"))))
    ((ImageFailed pages)
      (let f (free_space s (map_values pages)) (CreateFailed)))))

; The spans an ELF's segments are mapped as: each the pages it covers,
; with its perm.
(def spans_of ((segs (list ElfSeg))) (list Span)
  (if (is_empty segs)
      (nil Span)
      (match (head segs)
        ((ElfSeg off va fsz msz perm)
          (cons (Span va (mul (pages_for (add va msz)) (page_size)) perm) (spans_of (tail segs)))))))

; Pages mapped for an image, page -> frame: all it needs, or those mapped
; before the host ran out.
(data Load (ImageLoaded (Map int int)) (ImageFailed (Map int int)))

; Each of an ELF's segments, the image's bytes of input from start: the
; pages that hold its file bytes mapped with its perm, and those bytes
; copied in, the rest of the pages zero, as fresh frames are. Its pages
; past them, its bss, are mapped as they are first touched.
(def load_segs ((s int) (input bytes) (start int) (segs (list ElfSeg)) (pages (Map int int))) Load
  (if (is_empty segs)
      (ImageLoaded pages)
      (match (head segs)
        ((ElfSeg off va fsz msz perm)
          (match (map_pages s va (add va fsz) perm pages)
            ((ImageLoaded more)
              (let w (space_write s va input (add start off) (add start (add off fsz)))
                (load_segs s input start (tail segs) more)))
            ((ImageFailed more) (ImageFailed more)))))))

; Fresh zeroed frames at the pages from page va up to end, with perm.
(def map_pages ((s int) (va int) (end int) (perm int) (pages (Map int int))) Load
  (if (ge va end)
      (ImageLoaded pages)
      (let f (map_frame s va perm)
        (if (lt f 0)
            (ImageFailed pages)
            (map_pages s (add va (page_size)) end perm (map_put pages va f))))))

; The bytes of the kernel's own heap kept free when it gives a page: enough
; to finish the call that asked for it and to end the process, so that a
; page the heap could not record is refused, as one no frame is left for,
; rather than the kernel stopping with heap exhausted (spec 6.19). Ending
; a process lists every page it held, twice (mem_release), and heap_left
; counts free bytes, not the largest block, which on a heap full of page
; records lie in pieces: test_heap_runs_low on a 96 MB heap stopped with
; 38 MB free under a reserve of 32 MB, and survived one of 40. This is
; one of 64.
(def heap_reserve () int 67108864)

; Whether the kernel's heap has heap_reserve to spare, or is the host's,
; with no fixed size (heap_left is -3).
(def heap_has_room () bool
  (let left (heap_left)
    (or (lt left 0) (ge left (heap_reserve)))))

; A fresh zeroed frame mapped at page va of space s with perm, and its
; number, or a negative code if the host has none left, or no memory for
; the tables the mapping needs, when the frame is freed again; -5, as
; frame_new's none left, while the kernel's heap is down to its reserve.
(def map_frame ((s int) (va int) (perm int)) int
  (if (not (heap_has_room))
      -5
      (let f (frame_new)
        (if (lt f 0)
            f
            (let r (space_map s va f perm)
              (if (lt r 0) (let g (frame_free f) r) f))))))

; Space s given back, and then each of fs, which s alone mapped.
(def free_space ((s int) (fs (list int))) int
  (let r (space_free s) (free_frames fs)))

; Each of the frames fs given back; 0.
(def free_frames ((fs (list int))) int
  (if (is_empty fs) 0 (let r (frame_free (head fs)) (free_frames (tail fs)))))

; mem once p has ended, which drove devices if dev: its space given back,
; and every frame of it no other space maps, its image's shared segments
; no longer its.
(def proc_release ((mem Mem) (p Proc) (dev bool)) Mem
  (match p
    ((Proc pid m s c pages next st)
      (match (mem_release mem pages dev)
        ((Released m2 fs) (let f (free_space s fs) (mem_image_leave m2 s)))))))

; ---------------------------------------------------------------- sharing

; Processes running the same program share its code and rodata. Once a
; new process's image is loaded, each of its read-only segments is
; compared with those mem shares at the same address, of the same length
; and perm, whose bytes hash alike: read out of the new space and out of
; one that maps the other, the two compared whole, so no hash decides.
; If one is the same, the new space maps its frames instead, and the
; fresh ones are freed; if none is, the new segment is shared from then
; on. A segment of the data, which a process writes, is its own.

; The most bytes of a segment shared: 8 MB. Comparing reads it into the
; kernel's heap twice; a larger one is the process's own.
(def share_max_bytes () int 8388608)

; mem and p, just made from img, with p's read-only segments shared with
; other processes' that are the same, or shared from now on; unless the
; boot arguments hold noshare, when each keeps its own.
(def proc_share_image ((mem Mem) (p Proc) (img Image)) Allocated
  (if (any_eq "noshare" (boot_args))
      (Allocated mem p)
      (match img
        ((ElfImage entry segs heap) (share_segs mem p segs))
        ((BadImage code) (Allocated mem p)))))

; Each of segs shared, if it is read-only, has bytes in the file, and is
; no more than share_max_bytes of them.
(def share_segs ((mem Mem) (p Proc) (segs (list ElfSeg))) Allocated
  (if (is_empty segs)
      (Allocated mem p)
      (match (head segs)
        ((ElfSeg off va fsz msz perm)
          (if (if (eq (bit_and perm 1) 0) (if (gt fsz 0) (le fsz (share_max_bytes)) false) false)
              (match (share_seg mem p va fsz perm) ((Allocated m2 p2) (share_segs m2 p2 (tail segs))))
              (share_segs mem p (tail segs)))))))

; The segment at va, its fsz bytes of the file, with perm, shared: its
; bytes read and hashed, and compared with each candidate's.
(def share_seg ((mem Mem) (p Proc) (va int) (fsz int) (perm int)) Allocated
  (let b (space_read (proc_space p) va fsz)
    (let key (hash b)
      (share_with mem p va fsz perm key b (mem_image_candidates mem key va fsz perm)))))

; The rest of share_seg, through the candidates gs: p mapping the first
; whose bytes are b; or, if none are, its own frames shared from now on.
(def share_with ((mem Mem) (p Proc) (va int) (fsz int) (perm int) (key int) (b bytes) (gs (list ImageSeg))) Allocated
  (if (is_empty gs)
      (Allocated (mem_image_new mem key va fsz perm (seg_frames (proc_pages p) va (add va fsz) (nil int)) (proc_space p)) p)
      (if (eq (space_read (image_seg_space (head gs)) va fsz) b)
          (Allocated (mem_image_join mem key (head gs) (proc_space p)) (proc_remap p va (image_seg_frames (head gs)) perm))
          (share_with mem p va fsz perm key b (tail gs)))))

; The frames at the pages from page va up to end, in order, after the
; reversed acc.
(def seg_frames ((pages (Map int int)) (va int) (end int) (acc (list int))) (list int)
  (if (ge va end)
      (rev acc)
      (seg_frames pages (add va (page_size)) end
                  (match (map_get pages va) ((Some f) (cons f acc)) ((None) acc)))))

; p mapping fs at the pages from page va with perm, in place of its own
; frames there, which are freed. A page is mapped again where its table
; already is, so space_map needs no memory; were it ever refused, the
; page's own frame is mapped back and kept, and only that frame of the
; shared segment is counted once too often, so never freed.
(def proc_remap ((p Proc) (va int) (fs (list int)) (perm int)) Proc
  (if (is_empty fs)
      p
      (match p
        ((Proc pid m s c pages dev st)
          (match (map_get pages va)
            ((None) (proc_remap p (add va (page_size)) (tail fs) perm))
            ((Some old)
              (let u (space_unmap s va)
                (let r (space_map s va (head fs) perm)
                  (if (lt r 0)
                      (let r2 (space_map s va old perm) (proc_remap p (add va (page_size)) (tail fs) perm))
                      (let f (frame_free old)
                        (proc_remap (Proc pid m s c (map_put pages va (head fs)) dev st)
                                    (add va (page_size)) (tail fs) perm)))))))))))

; --------------------------------------------------------------- touching

; A process with the pages asked for mapped; or refused, one of them not
; to be mapped or the host having no frame for it, with those mapped
; before it.
(data Paged (Paged Proc) (PageRefused Proc))

; p with a zeroed frame at the page holding va, if a page may be mapped
; there on demand and the host has a frame for it.
(def proc_demand ((p Proc) (va int)) Paged
  (match p
    ((Proc pid m s c pages dev st)
      (let page (page_of va)
        (let perm (match st ((Life state parent ws args fs tty lay cwd) (demand_perm lay page)))
          (if (if (map_has pages page) true (lt perm 0))
              (PageRefused (Proc pid m s c pages dev st))
              (let f (map_frame s page perm)
                (if (lt f 0)
                    (PageRefused (Proc pid m s c pages dev st))
                    (Paged (Proc pid m s c (map_put pages page f) dev st))))))))))

; p with every page of the n bytes from va mapped, so the kernel can copy
; them out of it, or into it if write, or refused if any may not be.
(def proc_prepare ((p Proc) (va int) (n int) (write bool)) Paged
  (match p
    ((Proc pid m s c pages dev st)
      (match (range_plan (match st ((Life state parent ws args fs tty lay cwd) lay)) pages va n write)
        ((PlanBad) (PageRefused (Proc pid m s c pages dev st)))
        ((PlanMap todo) (demand_all (Proc pid m s c pages dev st) todo))))))

; p with each of the pages todo mapped on demand, in order, stopping at
; the first refused.
(def demand_all ((p Proc) (todo (list int))) Paged
  (if (is_empty todo)
      (Paged p)
      (match (proc_demand p (head todo))
        ((Paged q) (demand_all q (tail todo)))
        ((PageRefused q) (PageRefused q)))))

; --------------------------------------------------------------- copying

; Bytes copied out of a process, and it with the pages they needed
; mapped; or a refusal.
(data CopiedOut (CopiedOut Proc bytes) (CopyOutBad Proc))

; The n bytes of p from va, if p may give them.
(def proc_copy_out ((p Proc) (va int) (n int)) CopiedOut
  (match (proc_prepare p va n false)
    ((PageRefused q) (CopyOutBad q))
    ((Paged q) (CopiedOut q (space_read (proc_space q) va n)))))

; A process with bytes copied into it, or a refusal; either way with any
; pages mapped on the way.
(data CopiedIn (CopiedIn Proc) (CopyInBad Proc))

; p with bytes i up to j of b copied to va, if p may take them there: not
; into its code or rodata, which it may not write itself.
(def proc_copy_in ((p Proc) (va int) (b bytes) (i int) (j int)) CopiedIn
  (match (proc_prepare p va (sub j i) true)
    ((PageRefused q) (CopyInBad q))
    ((Paged q) (let w (space_write (proc_space q) va b i j) (CopiedIn q)))))

; ---------------------------------------------------------------- devices

; p with the device range of the region call mapped, answered with where
; p reaches it, or with the code that says why not.
(def proc_region ((p Proc) (base int) (len int)) Proc
  (match p
    ((Proc pid m s c pages dev st)
      (match (region_plan dev base len)
        ((RegionRefused code) (Proc pid m s (answer c code) pages dev st))
        ((RegionAt va next addr)
          (let r (space_map_device s va base len)
            (if (eq r 0)
                (Proc pid m s (answer c addr) pages next st)
                (Proc pid m s (answer c r) pages dev st))))))))

; -------------------------------------------------------------------- DMA

; Memory a device reads and writes itself is frames, mapped at device
; pages, above the stack, where nothing else is kept in pages: so a page
; there that pages holds is a DMA page.
(def is_dma_page ((pages (Map int int)) (page int)) bool
  (if (in_device_area page) (map_has pages page) false))

; p with n zeroed frames mapped at free device pages of its, answered
; with the first page's address, or with the code that says why not. A
; frame mapped before they ran out stays mapped until p ends; the pages
; past it are free again.
(data Allocated (Allocated Mem Proc))

; The dma_alloc call of n pages, as Allocated says, its pages counted in
; mem.
(def proc_dma_alloc ((mem Mem) (p Proc) (n int)) Allocated
  (match p
    ((Proc pid m s c pages dev st)
      (match (dma_plan dev n)
        ((DmaRefused code) (Allocated mem (Proc pid m s (answer c code) pages dev st)))
        ((DmaAt va after rest) (dma_map_pages mem (Proc pid m s c pages rest st) va va after))))))

; The rest of proc_dma_alloc, from page va to after: a fresh frame at
; each, read-write, and p answered with first at the end, or with
; err_fault where the host ran out, the pages from there given back.
(def dma_map_pages ((mem Mem) (p Proc) (first int) (va int) (after int)) Allocated
  (if (ge va after)
      (Allocated mem (proc_answer p first))
      (match p
        ((Proc pid m s c pages dev st)
          (let f (map_frame s va 1)
            (if (lt f 0)
                (Allocated mem (Proc pid m s (answer c (err_fault)) pages (dev_give dev va (sub after va)) st))
                (dma_map_pages (mem_share mem f) (Proc pid m s c (map_put pages va f) dev st)
                               first (add va (page_size)) after)))))))

; q, a file server, with n fresh zeroed frames mapped at free device
; pages of its, read-write and counted in mem as shared, for a client's
; window: where q reaches the first; or err_fault if its device pages
; have no room or the host ran out, every page mapped so far given back.
; q's call is not answered: the window is the kernel's.
(def proc_window_alloc ((mem Mem) (q Proc) (n int)) Shared
  (match q
    ((Proc pid m s c pages dev st)
      (match (dma_plan dev n)
        ((DmaRefused code) (ShareRefused mem q code))
        ((DmaAt va after rest) (window_map_pages mem (Proc pid m s c pages rest st) va va after))))))

; The rest of proc_window_alloc, from page va to after.
(def window_map_pages ((mem Mem) (q Proc) (first int) (va int) (after int)) Shared
  (if (ge va after)
      (Shared mem q first)
      (match q
        ((Proc pid m s c pages dev st)
          (let f (map_frame s va 1)
            (if (lt f 0)
                (match (proc_unmap mem (Proc pid m s c pages (dev_give dev va (sub after va)) st) first (div (sub va first) (page_size)))
                  ((Unmapped m2 q2) (ShareRefused m2 q2 (err_fault))))
                (window_map_pages (mem_share mem f) (Proc pid m s c (map_put pages va f) dev st)
                                  first (add va (page_size)) after)))))))

; The frames of p's n DMA pages from page va, oldest first, or none if
; one is not a DMA page of p's.
(def dma_frames ((p Proc) (va int) (n int) (acc (list int))) (Option (list int))
  (if (eq n 0)
      (Some (rev acc))
      (match p
        ((Proc pid m s c pages dev st)
          (if (not (is_dma_page pages va))
              ((None (list int)))
              (match (map_get pages va)
                ((Some f) (dma_frames p (add va (page_size)) (sub n 1) (cons f acc)))
                ((None) ((None (list int))))))))))

; q with frames mapped at free device pages of its, for memory another
; process shares with it: where q reaches the first; or the code that
; says why not.
(data Shared (Shared Mem Proc int) (ShareRefused Mem Proc int))

; The perm a shared page is mapped with: 1, read-write, as shm_share
; maps it; or 0, read only, as shm_share_read does, where a write faults.
(def share_rw () int 1)
(def share_ro () int 0)

; q with the frames fs mapped with perm, as Shared says: refused with
; err_too_big for too many, err_fault when its device pages have run out.
(def proc_map_shared ((mem Mem) (q Proc) (fs (list int)) (perm int)) Shared
  (match q
    ((Proc pid m s c pages dev st)
      (match (dma_plan dev (length fs))
        ((DmaRefused code) (ShareRefused mem q (if (eq code (err_too_big)) (err_too_big) (err_fault))))
        ((DmaAt va after rest) (map_shared mem (Proc pid m s c pages rest st) va va fs perm))))))

; The rest of proc_map_shared, from page va: each of fs mapped there in
; turn with perm and counted in mem, or err_fault at the first the host
; cannot map, the pages from there given back.
(def map_shared ((mem Mem) (q Proc) (first int) (va int) (fs (list int)) (perm int)) Shared
  (if (is_empty fs)
      (Shared mem q first)
      (match q
        ((Proc pid m s c pages dev st)
          (if (lt (space_map s va (head fs) perm) 0)
              (ShareRefused mem (Proc pid m s c pages (dev_give dev va (mul (length fs) (page_size))) st) (err_fault))
              (map_shared (mem_share mem (head fs)) (Proc pid m s c (map_put pages va (head fs)) dev st)
                          first (add va (page_size)) (tail fs) perm))))))

; ------------------------------------------------------------ taking back

; p without its DMA or shared page at va, frame f: unmapped, and f freed
; if no other mapping of it is left. Only frames at device pages are
; ever shared, so only those are taken back while a process runs.
(data Unmapped (Unmapped Mem Proc))

; Taking back page va, frame f, of p.
(def unmap_shared ((mem Mem) (p Proc) (va int) (f int)) Unmapped
  (match p
    ((Proc pid m s c pages dev st)
      (let u (space_unmap s va)
        (match (mem_unshare mem f)
          ((Unshared m2 last)
            (let g (if last (frame_free f) 0)
              (Unmapped m2 (Proc pid m s c (map_remove pages va) dev st)))))))))

; p without its n DMA or shared pages from page va, which dma_frames has
; found are all p's, and with them free device pages again, in whatever
; order they were given, so a process that maps and unmaps reuses its
; pages rather than running out.
(def proc_unmap ((mem Mem) (p Proc) (va int) (n int)) Unmapped
  (match (unmap_range mem p va n)
    ((Unmapped m2 q)
      (match q
        ((Proc pid m s c pages dev st)
          (Unmapped m2 (Proc pid m s c pages (dev_give dev va (mul n (page_size))) st)))))))

; The rest of proc_unmap: each of the n pages from va taken back that p
; has mapped, the others passed over.
(def unmap_range ((mem Mem) (p Proc) (va int) (n int)) Unmapped
  (if (eq n 0)
      (Unmapped mem p)
      (match (map_get (proc_pages p) va)
        ((None) (unmap_range mem p (add va (page_size)) (sub n 1)))
        ((Some f)
          (match (unmap_shared mem p va f)
            ((Unmapped m2 q) (unmap_range m2 q (add va (page_size)) (sub n 1))))))))

; p without the frames at the whole pages of its heap in the len bytes
; from base, which its runtime has freed (spec section 10.3's release):
; each unmapped and freed, a heap frame being p's alone, and its page
; mapped zeroed again when next touched. Pages it has not touched, and any
; outside its heap, are passed over. It walks the run's pages or p's
; mapped ones, whichever are fewer, so naming the whole heap costs no more
; than p has mapped.
(def proc_heap_release ((p Proc) (base int) (len int)) Proc
  (match p
    ((Proc pid m s c pages dev st)
      (match (heap_run (match st ((Life state parent ws args fs tty lay cwd) lay)) base len)
        ((HeapRun from to)
          (Proc pid m s c
                (if (gt (div (sub to from) (page_size)) (map_size pages))
                    (heap_unmap_each s pages (map_keys pages) from to)
                    (heap_unmap s pages from to))
                dev st))))))

; The rest of proc_heap_release by the run: pages without each page from
; va up to end that space s maps.
(def heap_unmap ((s int) (pages (Map int int)) (va int) (end int)) (Map int int)
  (if (ge va end)
      pages
      (heap_unmap s (heap_unmap_page s pages va) (add va (page_size)) end)))

; The rest of proc_heap_release by the mapped pages: pages without each of
; vas from from up to to.
(def heap_unmap_each ((s int) (pages (Map int int)) (vas (list int)) (from int) (to int)) (Map int int)
  (if (is_empty vas)
      pages
      (let va (head vas)
        (heap_unmap_each s
                         (if (if (ge va from) (lt va to) false) (heap_unmap_page s pages va) pages)
                         (tail vas) from to))))

; pages without page va, if space s maps it there: unmapped, and its
; frame freed.
(def heap_unmap_page ((s int) (pages (Map int int)) (va int)) (Map int int)
  (match (map_get pages va)
    ((None) pages)
    ((Some f)
      (let u (space_unmap s va)
        (let g (frame_free f) (map_remove pages va))))))

; Every page p has mapped, page -> frame.
(def proc_pages ((p Proc)) (Map int int) (match p ((Proc pid m s c pages dev st) pages)))

; q without every mapping it has, at its device pages, of the frames fs,
; and how many there were.
(data Revoked (Revoked Mem Proc int))

; The shm_revoke call's work in q, as Revoked says.
(def proc_revoke ((mem Mem) (q Proc) (fs (list int))) Revoked
  (revoke_pages mem q (set_of fs ((MapEmpty int bool))) (map_keys (proc_pages q)) 0))

; acc with each of fs in it, as a set.
(def set_of ((fs (list int)) (acc (Map int bool))) (Map int bool)
  (if (is_empty fs) acc (set_of (tail fs) (map_put acc (head fs) true))))

; The rest of proc_revoke, through q's pages vas: each at its device
; pages whose frame is in fs taken back, and free for q again, n
; counting them.
(def revoke_pages ((mem Mem) (q Proc) (fs (Map int bool)) (vas (list int)) (n int)) Revoked
  (if (is_empty vas)
      (Revoked mem q n)
      (let va (head vas)
        (match (map_get (proc_pages q) va)
          ((None) (revoke_pages mem q fs (tail vas) n))
          ((Some f)
            (if (if (in_device_area va) (map_has fs f) false)
                (match (unmap_shared mem q va f)
                  ((Unmapped m2 q2) (revoke_pages m2 (proc_give_page q2 va) fs (tail vas) (add n 1))))
                (revoke_pages mem q fs (tail vas) n)))))))

; p with its device page va free again.
(def proc_give_page ((p Proc) (va int)) Proc
  (match p ((Proc pid m s c pages dev st) (Proc pid m s c pages (dev_give dev va (page_size)) st))))

; p answered with where a device reaches the DMA page holding va, or
; err_no_port if it has none there.
(def proc_dma_address ((p Proc) (va int)) Proc
  (match p
    ((Proc pid m s c pages dev st)
      (let page (page_of va)
        (if (not (is_dma_page pages page))
            (Proc pid m s (answer c (err_no_port)) pages dev st)
            (match (map_get pages page)
              ((Some f) (Proc pid m s (answer c (frame_address f)) pages dev st))
              ((None) (Proc pid m s (answer c (err_no_port)) pages dev st))))))))

; What dma_addresses gives p for at most n of its pages from the one
; holding va on: where a device reaches each, a u64, least significant
; byte first, up to the first that is not one of its DMA pages; nothing
; if that one is not.
(def proc_dma_addresses ((p Proc) (va int) (n int)) (list int)
  (match p
    ((Proc pid m s c pages dev st)
      (rev (dma_addresses_onto pages (page_of va) n (nil int))))))

; proc_dma_addresses's loop: each page's address onto acc, its bytes
; reversed, n pages at most from page.
(def dma_addresses_onto ((pages (Map int int)) (page int) (n int) (acc (list int))) (list int)
  (if (if (le n 0) true (not (is_dma_page pages page)))
      acc
      (match (map_get pages page)
        ((None) acc)
        ((Some f) (dma_addresses_onto pages (add page (page_size)) (sub n 1) (u64_bytes_onto (frame_address f) acc))))))

; How many of n of p's DMA pages from the one holding va on were synced
; in direction dir, 1 to 3, frame_sync's: up to the first that is not a
; DMA page.
(def proc_dma_sync ((p Proc) (va int) (n int) (dir int)) int
  (match p
    ((Proc pid m s c pages dev st) (dma_synced pages (page_of va) n dir 0))))

; proc_dma_sync's loop: each page's frame synced from page, count so far.
(def dma_synced ((pages (Map int int)) (page int) (n int) (dir int) (count int)) int
  (if (if (le n 0) true (not (is_dma_page pages page)))
      count
      (match (map_get pages page)
        ((None) count)
        ((Some f) (let z (frame_sync f dir) (dma_synced pages (add page (page_size)) (sub n 1) dir (add count 1)))))))

; The 8 bytes of a, least significant first, onto acc reversed: the most
; significant ends up first.
(def u64_bytes_onto ((a int) (acc (list int))) (list int)
  (u64_bytes_from a 0 acc))

; u64_bytes_onto's loop, from byte i.
(def u64_bytes_from ((a int) (i int) (acc (list int))) (list int)
  (if (eq i 8) acc (u64_bytes_from a (add i 1) (cons (bit_and (bit_shr a (mul 8 i)) 255) acc))))

; p once its runtime has closed the region of len bytes at addr (spec
; section 10.3's unregion): the device memory region mapped there
; unmapped, and its pages given back to p's device pages, as
; unregion_plan says. Anything else is passed over, as the call answers
; 0 whatever it does.
(def proc_unregion ((p Proc) (addr int) (len int)) Proc
  (match p
    ((Proc pid m s c pages dev st)
      (match (unregion_plan dev pages addr len)
        ((UnregionNone) p)
        ((UnregionAt va span)
          (let u (unmap_device_pages s va (add va span))
            (Proc pid m s c pages (dev_give dev va span) st)))))))

; Each page of space s from va up to end unmapped; 0.
(def unmap_device_pages ((s int) (va int) (end int)) int
  (if (ge va end) 0 (let u (space_unmap s va) (unmap_device_pages s (add va (page_size)) end))))

; p answering the region call for len bytes from base, in its device
; area: base itself, where it reaches them already, if every page of them
; is a DMA page, and -3 as for any range no device holds otherwise.
(def proc_dma_region ((p Proc) (base int) (len int)) Proc
  (if (if (lt len 1) true (gt len 4294967296))
      (proc_answer p -3)
      (match p
        ((Proc pid m s c pages dev st)
          (if (all_dma pages (page_of base) (page_of (add base (sub len 1))))
              (Proc pid m s (answer c base) pages dev st)
              (Proc pid m s (answer c -3) pages dev st))))))

; Whether every page from page to last is a DMA page in pages.
(def all_dma ((pages (Map int int)) (page int) (last int)) bool
  (if (gt page last)
      true
      (if (is_dma_page pages page) (all_dma pages (add page (page_size)) last) false)))
