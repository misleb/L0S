; kernel_test.l0 -- the kernel on this host, which has no user mode: what
; can be checked without running a thread. kernel_virt_test.l0 runs them.

(def test_kill_message () int
  (check_str "message" (kill_message "crash" 3 "fault at 0x10")
             "l0s: process 3 (crash) killed: fault at 0x10\n"))

(def test_boot_refuses_garbage () int
  (check_int "status" (boot (bytes_from_list "nonsense")) 1))

(def test_boot_needs_inittab () int
  (check_int "status" (boot (bytes_from_list (append (newc_entry "bin/sh" 33261 "SH") (newc_trailer)))) 1))

(def test_boot_refuses_bad_inittab () int
  (check_int "status"
    (boot (bytes_from_list (append (newc_entry "etc/inittab" 33188 "start /bin/none\n") (newc_trailer))))
    1))

; Here space_new gives -3, so nothing starts.
(def test_boot_without_user_mode () int
  (check_int "status" (boot (raw_initramfs (cons (Raw (flag_boot) (code (exit_x0))) (nil Raw)))) 1))

(def test_parent_path () int
  (add (check_str "file" (parent_path "/bin/sh") "/bin")
       (add (check_str "top" (parent_path "/sh") "/")
            (check_str "root" (parent_path "/") "/"))))

(def test_raw_inittab () int
  (check_str "starts and devs"
    (raw_inittab (cons (Raw (bit_or (flag_boot) (flag_dev)) "") (cons (Raw 0 "") (cons (Raw (flag_boot) "") (nil Raw)))) 0 (nil int))
    "start /bin/raw0\ndev /bin/raw0\nstart /bin/raw2\n"))

(def test_ready () int
  (add (check_bool "ready" (is_ready (Ready)) true)
       (check_bool "receiving" (is_ready (Receiving 1 2 3)) false)))

(def test_code () int
  (check_str "svc" (code_bytes (cons (svc) (nil int))) (cons 1 (cons 0 (cons 0 (cons 212 (nil int)))))))

(def test_loop_words () int
  (add (check_int "add x1, x1, #1, lsl 12" (add_imm_hi 1 1 1) 2436891681)      ; 0x91400421
       (add (check_int "subs x2, x2, #1" (subs_imm 2 2 1) 4043310146)          ; 0xF1000442
            (add (check_int "add x3, x3, x0" (add_reg 3 3 0) 2332033123)       ; 0x8B000063
                 (add (check_int "mov x0, x3" (mov_reg 0 3) 2852324320)         ; 0xAA0303E0
                      (check_int "cbnz x2, -3" (cbnz 2 -3) 3053453218))))))     ; 0xB5FFFFA2

(def test_add_imm () int
  (check_int "add x1, x1, #40" (add_imm 1 1 40) 2432737313))         ; 0x9100A021

(def test_movz () int
  (add (check_int "movz x8, #3" (movz 8 3) 3531604072)              ; 0xD2800068
       (check_int "movz x1, #0xC040, lsl 16" (movz_hi 1 49216) 3535276033)))  ; 0xD2B80801

; The boot lines, for a board of aarch64 with two boot arguments, 190000
; pages free (190000 * 4096 = 778.2 MB), a 1.2 MB initramfs of 84
; entries and 13 programs to start.
(def banner_text () (list int)
  (join_with "\n" (banner_lines 1 (split_spaces "root=abc scale=2") 190000 1200000 84 13)))

(def test_banner_cpu_and_arguments () int
  (check_true "first line"
    (starts_with (banner_text) "l0s: aarch64, booted with root=abc scale=2\nl0s: memory: 190000 pages free, 778.2 MB\n")))

(def test_banner_layout () int
  (add (check_true "images" (contains (banner_text) "images and heaps from 0xc0000000 to 0xd8000000"))
       (check_true "device pages" (contains (banner_text) "stacks below 0xe8000000, device and DMA pages to 0x100000000"))))

(def test_banner_limits_and_initramfs () int
  (add (check_true "limits" (contains (banner_text) "l0s: limits: 255 processes, 10 ms slices, ports of 32 messages of up to 4096 bytes"))
       (check_true "initramfs" (ends_with (banner_text) "l0s: initramfs: 1.2 MB, 84 entries, 13 programs to start"))))

(def test_banner_without_arguments () int
  (add (check_str "none" (boot_arguments_text (nil (list int))) ", booted with no arguments")
       (check_str "unknown cpu" (cpu_name 0) "an unknown CPU")))

(def test_banner_no_user_mode () int
  (check_str "memory" (memory_text -3) "l0s: memory: no user mode"))

(def test_kill_text () int
  (check_str "text" (kill_text "crash" 3 "fault at 0x10") "l0s: process 3 (crash) killed: fault at 0x10"))
