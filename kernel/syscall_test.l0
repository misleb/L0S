; A context as a thread leaves it making call n with x0 to x2.
(def trapped ((n int) (a int) (b int) (c int)) (array int)
  (array_set (array_set (array_set (array_set (user_context (user_base) (stack_top)) 8 n) 0 a) 1 b) 2 c))

(def call_code ((call Call)) (list int)
  (match call
    ((CRead s b n) (append "read " (digits n)))
    ((CWrite s b n) (append "write " (digits s)))
    ((CExit st) (append "exit " (digits st)))
    ((COpen path len m) (append "open " (append (digits len) (append " mode " (digits m)))))
    ((CClose s) (append "close " (digits s)))
    ((CRename f fl t tl) (append "rename " (append (digits fl) (append " " (digits tl)))))
    ((CRemove path len) (append "remove " (digits len)))
    ((CArgCount) "arg_count")
    ((CArg i b n) (append "arg " (digits i)))
    ((CRegion b l) (append "region " (digits l)))
    ((CYield) "yield")
    ((CPid) "pid")
    ((CPortNew) "port_new")
    ((CSend p b l) (append "send " (digits p)))
    ((CReceive p b m w) (append (if w "receive " "try_receive ") (digits m)))
    ((CRegister p b l) (append "register " (digits l)))
    ((CLookup b l) (append "lookup " (digits l)))
    ((CSpawn m) (append "spawn " (digits m)))
    ((CWait p) (append "wait " (digits p)))
    ((CSleepUntil t) (append "sleep " (digits t)))
    ((CIrqBind i p) (append "irq_bind " (digits i)))
    ((CIrqAck i) (append "irq_ack " (digits i)))
    ((CModuleName i b m) (append "module_name " (digits i)))
    ((CKill pid) (append "kill " (digits pid)))
    ((CWatch pid port) (append "watch " (append (digits pid) (append " " (digits port)))))
    ((CSpawnArgs m b l) (append "spawn_args " (append (digits m) (append " " (digits l)))))
    ((CProcInfo pid b m) (append "proc_info " (digits pid)))
    ((CDmaAlloc n) (append "dma_alloc " (digits n)))
    ((CDmaAddress va) (append "dma_address " (digits va)))
    ((CShmAlloc n) (append "shm_alloc " (digits n)))
    ((CShmShare va n pid) (append "shm_share " (append (digits n) (append " to " (digits pid)))))
    ((CTtySet port) (append "tty_set " (digits port)))
    ((CTtyGet) "tty_get")
    ((CProcSlot i) (append "proc_slot " (digits i)))
    ((CShmUnmap va n) (append "shm_unmap " (digits n)))
    ((CShmRevoke va n pid) (append "shm_revoke " (append (digits n) (append " from " (digits pid)))))
    ((CMount port b l) (append "fs_mount " (append (digits port) (append " " (digits l)))))
    ((CMountAt i b m) (append "mount_at " (append (digits i) (append " " (digits m)))))
    ((CBootArgs b m) (append "boot_args " (digits m)))
    ((CRootSwitch b l) (append "root_switch " (digits l)))
    ((CSpawnImage b l) (append "spawn_image " (digits l)))
    ((CUnknown n) (append "unknown " (digits n)))))

(def decoded ((n int) (a int) (b int) (c int)) (list int)
  (call_code (decode n (trapped n a b c))))

(def test_abi_calls () int
  (add (check_str "write" (decoded 2 1 99 5) "write 1")
       (add (check_str "exit" (decoded 3 7 0 0) "exit 7")
            (add (check_str "open" (decoded 4 0 3 2) "open 3 mode 2")
                 (check_str "region" (decoded 10 151060480 4096 0) "region 4096")))))

(def test_abi_rest () int
  (add (check_str "read" (decoded 1 0 99 64) "read 64")
       (add (check_str "arg" (decoded 9 2 99 64) "arg 2")
            (check_str "unknown" (decoded 11 0 0 0) "unknown 11"))))

(def test_abi_files () int
  (add (check_str "close" (decoded 5 4 0 0) "close 4")
       (add (check_str "remove" (decoded 7 99 9 0) "remove 9")
            (check_str "rename" (call_code (decode 6 (array_set (trapped 6 99 5 98) 3 7))) "rename 5 7"))))

(def test_own_calls () int
  (add (check_str "send" (decoded 259 4 99 5) "send 4")
       (add (check_str "receive" (decoded 260 4 99 4100) "receive 4100")
            (add (check_str "try" (decoded 261 4 99 8) "try_receive 8")
                 (check_str "lookup" (decoded 263 0 99 4) "lookup 4")))))

(def test_own_procs () int
  (add (check_str "spawn" (decoded 264 2 0 0) "spawn 2")
       (add (check_str "irq_ack" (decoded 268 34 0 0) "irq_ack 34")
            (check_str "past the end" (decoded 300 0 0 0) "unknown 300"))))

(def test_module_name () int
  (check_str "269" (decoded 269 2 99 64) "module_name 2"))

(def test_jobs () int
  (add (check_str "kill" (decoded 270 4 0 0) "kill 4")
       (add (check_str "watch" (decoded 271 4 2 0) "watch 4 2")
            (add (check_str "spawn_args" (decoded 272 3 99 12) "spawn_args 3 12")
                 (check_str "proc_info" (decoded 273 5 99 16) "proc_info 5")))))

(def test_dma () int
  (add (check_str "dma_alloc" (decoded 274 8 0 0) "dma_alloc 8")
       (add (check_str "dma_address" (decoded 275 3892314112 0 0) "dma_address 3892314112")
            (check_str "after" (decoded 288 0 0 0) "unknown 288"))))

(def test_shm () int
  (add (check_str "shm_alloc" (decoded 278 4 0 0) "shm_alloc 4")
       (check_str "shm_share" (decoded 279 3892314112 4 7) "shm_share 4 to 7")))

(def test_tty () int
  (add (check_str "tty_set" (decoded 276 3 0 0) "tty_set 3")
       (check_str "tty_get" (decoded 277 0 0 0) "tty_get")))

(def test_shm_take_back () int
  (add (check_str "shm_unmap" (decoded 281 3892314112 2 0) "shm_unmap 2")
       (check_str "shm_revoke" (decoded 282 3892314112 2 5) "shm_revoke 2 from 5")))

(def test_proc_slot () int
  (check_str "proc_slot" (decoded 280 5 0 0) "proc_slot 5"))

(def test_mounts () int
  (add (check_str "fs_mount" (decoded 283 7 3892314112 4) "fs_mount 7 4")
       (add (check_str "mount_at" (decoded 284 1 3892314112 64) "mount_at 1 64")
            (check_str "past them" (decoded 288 0 0 0) "unknown 288"))))

; The calls of booting from a volume: the buffer is the second register,
; its length the third.
(def test_root_calls () int
  (add (check_str "boot_args" (decoded 285 0 3892314112 4096) "boot_args 4096")
       (add (check_str "root_switch" (decoded 286 0 3892314112 6) "root_switch 6")
            (check_str "spawn_image" (decoded 287 0 3892314112 70000) "spawn_image 70000"))))

(def test_answer () int
  (check_int "x0" (array_get (answer (trapped 257 0 0 0) 9) 0) 9))
