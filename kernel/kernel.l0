; kernel.l0 -- the kernel: every process, what they wait for, the ports
; between them, and the loop that runs them. One process runs at a time,
; for a slice of 10 ms or until it makes a call that waits; while it runs
; it is held here, out of the table, and goes back when it stops.

; A slot of the table: nothing, a process, or one that has exited.
(data Slot (Free) (Live Proc) (Dead Gone))

; A process that has exited: its status, its parent's pid, and whether
; the status was given to anyone, by a wait or an exit notice. Its slot
; is kept until a new process needs it, and given first to those of
; processes no one will ask about (pids.l0).
(data Gone (Gone (status int) (parent int) (told bool)))

; An interrupt bound to a port: the pid that bound it, the port, and
; whether it is taken, waiting for that pid's irq_ack. One its driver let
; go is kept as pid 0's, port -1, held taken once it comes, since it
; can't be disabled and a device left raising it would take it again at
; once, for ever, and leave CPU 0 nothing else; the next to bind it
; ends it.
(data Irq (Irq int int bool))

; Whether b is a driver's, not one let go.
(def irq_owned ((b Irq)) bool (match b ((Irq owner port taken) (gt owner 0))))

; How many of bs are drivers'.
(def irqs_owned ((bs (list Irq))) int
  (if (is_empty bs) 0 (add (if (irq_owned (head bs)) 1 0) (irqs_owned (tail bs)))))

; The initramfs: its bytes and entries; for each entry, whether it may
; drive devices and its default arguments, as the inittab says; the entry
; processes read as standard input, or -1; how far into it they have
; read; and the path of each process started from an image of its own
; (spawn_image), by pid, as entries name the rest. Once a volume is /,
; the bytes are given up, none, and the stdin entry with them; the
; entries stay, to name the processes started from them, and to say
; which drive devices and what arguments a path gets. It holds the log
; of messages too (log.l0), which outlives the initramfs.
(data Boot (Boot (input bytes) (entries (array Entry)) (devs (array bool)) (defaults (array (list (list int)))) (stdin int) (pos int) (names (Map int (list int))) (log KLog)))

; Every slot of the table, the pids ready to run in order, the ports, the
; sleepers, the bound interrupts, the initramfs, the pid each slot holds,
; how many mappings each shared frame has, and which processes the other
; CPUs hold. A process out on another CPU stays Live in its slot, so that
; other processes' calls find it; the one whose trap is being handled is
; out of the table, as on one CPU.
(data Kernel (Kernel (slots (array Slot)) (ready (Queue int)) (ipc Ipc) (sleepers (list Sleeper)) (irqs (Map int Irq)) (boot Boot) (pids Pids) (mem Mem) (cpus Cpus)))

; What happens after a process traps: it goes on running; it goes back
; to the table, ready or waiting; it has gone; or the system stops.
(data Step (Resume Kernel Proc) (Park Kernel Proc) (Next Kernel) (Halt int))

; The kernel at boot, before anything starts: every slot Free, nothing
; ready, no ports, sleepers or interrupts, the initramfs input, its
; entries es, as the inittab's c configures them, and every CPU there is,
; holding nothing.
(def kernel_new ((input bytes) (es (array Entry)) (c Config)) Kernel
  (match c
    ((Config launches devs defaults stdin)
      (Kernel (array_new 256 (Free)) (Queue (nil int) (nil int)) (ipc_new) (nil Sleeper)
              ((MapEmpty int Irq)) (Boot input es devs defaults stdin 0 ((MapEmpty int (list int))) (klog_new)) (pids_new) (mem_new) (cpus_from (cpu_count) (clock_ns))))))

; ------------------------------------------------------------- the fields

; How many of k's interrupts are bound to a driver.
(def k_irq_count ((k Kernel)) int (match k ((Kernel slots ready ipc ss irqs boot next mem cpus) (irqs_owned (map_values irqs)))))

; ------------------------------------------------------------ CPU time
;
; What the kernel counts of the CPUs' use (usage.l0), each updated with
; the record taken apart, so that its arrays change in place.

; k with pid's run on CPU cpu, from since to now, counted: a turn on CPU
; 0, its calls included, or a run on one CPU from its pick to its park.
(def k_charge ((k Kernel) (pid int) (cpu int) (since int)) Kernel
  (let t (sub (clock_ns) since)
    (match k
      ((Kernel slots ready ipc ss irqs boot next mem cpus)
        (Kernel slots ready ipc ss irqs boot next mem (cpus_charge cpus pid cpu t))))))

; k with CPU 0's wait, from since to now, counted.
(def k_waited ((k Kernel) (since int)) Kernel
  (let t (sub (clock_ns) since)
    (match k
      ((Kernel slots ready ipc ss irqs boot next mem cpus)
        (Kernel slots ready ipc ss irqs boot next mem (cpus_waited cpus t))))))

; k with its load sampled, if a tick is due at now: the ready queue and
; the threads out on other CPUs. CPU 0 runs nothing as it samples.
(def k_tick ((k Kernel) (now int)) Kernel
  (if (usage_due (.usage (.cpus k)) now)
      (let n (k_ready_count k)
        (match k
          ((Kernel slots ready ipc ss irqs boot next mem cpus)
            (Kernel slots ready ipc ss irqs boot next mem (cpus_tick cpus now n)))))
      k))

; When the kernel's wait must end: at the soonest sleeper's time, or the
; load's next tick, whichever comes first, so that a tick is not missed.
(def k_wake_at ((k Kernel)) int
  (let (tick (usage_next_tick (.usage (.cpus k))) s (soonest (.sleepers k)))
    (if (lt s 0) tick (min s tick))))

; Entry i of the initramfs, which must be one (is_entry).
(def k_entry ((k Kernel) (i int)) Entry (array_get (.entries (.boot k)) i))

; Whether the inittab lets entry i drive devices.
(def k_entry_dev ((k Kernel) (i int)) bool (array_get (.devs (.boot k)) i))

; The arguments the inittab gives entry i when started without any.
(def k_entry_args ((k Kernel) (i int)) (list (list int)) (array_get (.defaults (.boot k)) i))

; Whether i is the index of an entry of the initramfs.
(def is_entry ((k Kernel) (i int)) bool
  (and (not (lt i 0)) (lt i (array_len (.entries (.boot k))))))

; Whether k still holds the initramfs's bytes: until a volume is /.
(def k_held ((k Kernel)) bool
  (gt (bytes_len (.input (.boot k))) 0))

; k with the initramfs's bytes given up, and so its stdin file.
(def k_free_initramfs ((k Kernel)) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match boot
        ((Boot input es devs defaults stdin cur names klog)
          (Kernel slots ready ipc ss irqs (Boot (bytes_from_list (nil int)) es devs defaults -1 0 names klog) next mem cpus))))))

; The path of p's program: its entry's, or its image's, as spawn_image
; was given it.
(def k_proc_path ((k Kernel) (p Proc)) (list int)
  (if (is_entry k (.module p))
      (.path (k_entry k (.module p)))
      (match (map_get (.names (.boot k)) (.pid p))
        ((Some path) path)
        ((None) "?"))))

; k with pid's image's path forgotten, pid having ended.
(def k_forget_name ((k Kernel) (pid int)) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match boot
        ((Boot input es devs defaults stdin cur names klog)
          (Kernel slots ready ipc ss irqs (Boot input es devs defaults stdin cur (map_remove names pid) klog) next mem cpus))))))

; k with its log replaced.
(def k_with_log ((k Kernel) (log KLog)) Kernel (.boot k (.log (.boot k) log)))

; k with a message logged by pid (0 for the kernel) at level, of text
; with no newline, stamped with the time. Any level but debug is written
; to the kernel's standard error too, a line each, at once, as the kernel
; has always reported: so the serial line shows it before any process
; has started, and a log nobody has read loses nothing.
(def k_note ((k Kernel) (pid int) (level int) (text (list int))) Kernel
  (let (t (max 0 (clock_ns)) short (take text (log_text_max)) w (k_echo level short))
    (k_with_log k (klog_add (.log (.boot k)) pid level short t))))

; Writes a line of text to the kernel's standard error, delivered at
; once, unless level is debug and the boot arguments hold no debug; 0.
(def k_echo ((level int) (text (list int))) int
  (if (or (lt level (log_debug)) (any_eq "debug" (boot_args)))
      (let (w (write_err (append text "\n")) f (file_flush (IoFile 2))) 0)
      0))

; The arguments the inittab gives the program at path, if it names it.
(def k_path_args((k Kernel) (path (list int))) (list (list int))
  (let e (entry_index (.entries (.boot k)) path)
    (if (lt e 0) (nil (list int)) (k_entry_args k e))))

; k with interrupt n bound as b.
(def with_irq ((k Kernel) (n int) (b Irq)) Kernel
  (.irqs k (map_put (.irqs k) n b)))

; k with interrupt n bound to nothing.
(def without_irq ((k Kernel) (n int)) Kernel
  (.irqs k (map_remove (.irqs k) n)))

; What interrupt n is bound to, if anything.
(def k_irq ((k Kernel) (n int)) (Option Irq)
  (match k ((Kernel slots ready ipc ss irqs boot next mem cpus) (map_get irqs n))))

; Whether the ready queue holds a pid, one it will drop included.
(def k_waiting ((k Kernel)) bool
  (match k ((Kernel slots ready ipc ss irqs boot next mem cpus) (not (queue_is_empty ready)))))

; Whether pid runs on CPU 0, as cpus_here says, with k's ready queue.
(def k_here ((k Kernel) (pid int)) bool
  (cpus_here (.cpus k) pid (k_waiting k)))

; How many pids the ready queue holds, those it will drop included.
(def k_ready_count ((k Kernel)) int
  (match k ((Kernel slots ready ipc ss irqs boot next mem cpus) (queue_size ready))))

; Whether a pid on the ready queue would be handed to another CPU, and
; one has room for it: read from the queue and the CPUs' table alone,
; with no slot taken or put back, as many_spread does for each.
(def k_spreads ((k Kernel)) bool
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match ready ((Queue front back) (cpus_spreads cpus front back))))))

; k with pid last on the ready queue.
(def push_ready ((k Kernel) (pid int)) Kernel
  (.ready k (queue_push (.ready k) pid)))

; Whether pid is the one its slot holds, or last held: a pid from an
; earlier turn of the slot, or never given, names nothing, so every
; function below takes it as a Free slot's, and changes nothing for it.
(def k_current ((k Kernel) (pid int)) bool
  (match k ((Kernel slots ready ipc ss irqs boot pids mem cpus) (pid_current pids pid))))

; k with s in pid's slot.
(def put_slot ((k Kernel) (pid int) (s Slot)) Kernel
  (if (not (k_current k pid))
      k
      (.slots k (array_set (.slots k) (slot_of pid) s))))

; k with pid's slot taken out, left Free, and the slot.
(data TakenSlot (TakenSlot Kernel Slot))

; pid's slot taken out of k, as TakenSlot says.
(def take_slot ((k Kernel) (pid int)) TakenSlot
  (if (not (k_current k pid))
      (TakenSlot k (Free))
      (match k
        ((Kernel slots ready ipc ss irqs boot next mem cpus)
          (let s (array_get slots (slot_of pid))
            (TakenSlot (Kernel (array_set slots (slot_of pid) (Free)) ready ipc ss irqs boot next mem cpus) s))))))

; What pid's slot holds, without taking it.
(data Look (LookFree) (LookLive) (LookDead int))

; What pid's slot holds: nothing, a live process, or one that exited,
; with its status.
(def look ((k Kernel) (pid int)) Look
  (if (not (k_current k pid))
      (LookFree)
      (match k
        ((Kernel slots ready ipc ss irqs boot next mem cpus)
          (match (array_get slots (slot_of pid))
            ((Free) (LookFree))
            ((Live p) (LookLive))
            ((Dead g) (LookDead (.status g))))))))

; The pid slot i holds, or last held, 0 for none yet.
(def k_pid_at ((k Kernel) (i int)) int
  (match k ((Kernel slots ready ipc ss irqs boot pids mem cpus) (pid_at pids i))))

; p back in its slot, and on the ready queue if it is ready.
(def park ((k Kernel) (p Proc)) Kernel
  (let (pid (.pid p) ready (is_ready (proc_state p)) k2 (put_slot k pid (Live p)))
    (if ready (push_ready k2 pid) k2)))

; q back in its slot as it was. Unlike park, never queues it: a process
; already ready is on the ready queue once already.
(def restore ((k Kernel) (q Proc)) Kernel
  (put_slot k (.pid q) (Live q)))

; ------------------------------------------------------- memory, through k

; What process.l0 does with shared frames, given the counts k keeps of
; their mappings, and k with those updated.
(def k_dma_alloc ((k Kernel) (p Proc) (n int)) Step
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (proc_dma_alloc mem p n)
        ((Allocated m2 q) (Resume (Kernel slots ready ipc ss irqs boot next m2 cpus) q))))))

; q with fs mapped at its next device pages, and its answer: where, or
; the code that says why not.
(data KShared (KShared Kernel Proc int))

; proc_map_shared through k, as KShared says, each page with perm.
(def k_map_shared ((k Kernel) (q Proc) (fs (list int)) (perm int)) KShared
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (proc_map_shared mem q fs perm)
        ((Shared m2 q2 v) (KShared (Kernel slots ready ipc ss irqs boot next m2 cpus) q2 v))
        ((ShareRefused m2 q2 code) (KShared (Kernel slots ready ipc ss irqs boot next m2 cpus) q2 code))))))

; q without its n DMA or shared pages from page va, through k, and q
; back in its slot.
(def k_unmapped ((k Kernel) (q Proc) (va int) (n int)) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (proc_unmap mem q va n)
        ((Unmapped m2 q2) (restore (Kernel slots ready ipc ss irqs boot next m2 cpus) q2))))))

; ----------------------------------------------------- ports, through k

; Taken apart and built again, as k_dma_alloc does memory, so that the
; ports change in place: k with them read through a field, and still
; held by k, would be copied whole.

; A port made for owner through k: its number, and k with it.
(data KPort (KPort int Kernel))

; ipc_port_new through k.
(def k_port_new ((k Kernel) (owner int)) KPort
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (ipc_port_new ipc owner)
        ((NewPort r i2) (KPort r (Kernel slots ready i2 ss irqs boot next mem cpus)))))))

; What a call that registers on behalf of pid came to through k: its
; result, and k after it.
(data KRegistered (KRegistered int Kernel))

; f, ipc_set_ports or ipc_unregister, done on k's ports for pid with arg.
(def k_registered ((k Kernel) (f (fn (Ipc int (list int)) Registered)) (pid int) (arg (list int))) KRegistered
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (f ipc pid arg)
        ((Registered code i2) (KRegistered code (Kernel slots ready i2 ss irqs boot next mem cpus)))))))

; What taking pid's thread back from its CPU came to through k: k
; without it, and where it was; or k as it was if it was not out.
(data KBack (KBack Kernel OnCpu) (KNotOut Kernel))

; cpus_back through k.
(def k_cpus_back ((k Kernel) (pid int) (now int)) KBack
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (cpus_back cpus pid now)
        ((CpuNotOut c) (KNotOut (Kernel slots ready ipc ss irqs boot next mem c)))
        ((CpuBack c on) (KBack (Kernel slots ready ipc ss irqs boot next mem c) on))))))

; ------------------------------------------------------------ file windows

; A file window (memory.l0's Window) is made for a client the first time
; it opens a file on a volume whose server is another live process: its
; pages mapped into the server, and the server told by a window_notice,
; before the open's request, on the same port. The kernel will copy the
; client's file data through it (roadmap 0023). The server unmaps it once
; the client exits, which it watches; the kernel forgets it then, and when
; the server ends.

; What making a client's window to a server came to: k, ready for the
; client's request; or the code its open is refused with.
(data Windowed (WinReady Kernel) (WinRefused Kernel int))

; p's window to the server at port server, made if it has none and needs
; one: none is made for a port no live process owns, whose request fails
; anyway, nor for p's own, whose request waits for itself.
(def windowed ((k Kernel) (p Proc) (server int)) Windowed
  (let owner (ipc_owner (.ipc k) server)
    (if (or (lt owner 1) (eq owner (.pid p))) (WinReady k)
        (ge (mem_window_at (.mem k) (.pid p) server) 0) (WinReady k)
        (window_made k (.pid p) owner server))))

; client's window mapped into owner, the server at port server, and told
; to it; err_fault if owner has no room for it, or the kernel is out of
; frames or near its heap's reserve; ready, with none, if owner is not
; live.
(def window_made ((k Kernel) (client int) (owner int) (server int)) Windowed
  (match (take_slot k owner)
    ((TakenSlot k2 s)
      (match s
        ((Free) (WinReady (put_slot k2 owner (Free))))
        ((Dead g) (WinReady (put_slot k2 owner (Dead g))))
        ((Live q)
          (match (proc_window_alloc (.mem k2) q (window_pages))
            ((ShareRefused m2 q2 code) (WinRefused (restore (.mem k2 m2) q2) code))
            ((Shared m2 q2 va)
              (window_told (restore (.mem k2 (mem_window_add m2 (Window client owner server va (.space q2)))) q2)
                           client owner server va))))))))

; k once the server at port server is sent client's window notice: or,
; if its queue has no room or it has gone, the window taken back, so
; that the open's request, which fails as the notice did, finds none.
(def window_told ((k Kernel) (client int) (owner int) (server int) (va int)) Windowed
  (match (k_send k server (Msg 0 (bytes_from_list (window_notice client va (window_pages)))))
    ((KSent k2 code)
      (if (eq code 0) (WinReady k2) (WinReady (window_undone k2 client owner server va))))))

; client's window at va of owner, the server at port server, unmapped
; from owner and forgotten.
(def window_undone ((k Kernel) (client int) (owner int) (server int) (va int)) Kernel
  (let k1 (.mem k (mem_window_drop (.mem k) client server))
    (match (take_slot k1 owner)
      ((TakenSlot k2 s)
        (match s
          ((Live q) (k_unmapped k2 q va (window_pages)))
          ((Free) (put_slot k2 owner (Free)))
          ((Dead g) (put_slot k2 owner (Dead g))))))))

; Where client's window to the server at port is: the server's space and
; the window's first page; or none. A window the kernel keeps is mapped
; whole (memory.l0's Window), so space_read and space_write reach it.
(data WinSpace (WinSpace Space int) (NoWinSpace))

; client's window to port, as WinSpace says.
(def window_space ((k Kernel) (client int) (port int)) WinSpace
  (let s (mem_window_space (.mem k) client port)
    (if (lt (.id s) 0) (NoWinSpace) (WinSpace s (mem_window_at (.mem k) client port)))))

; k without the windows q serves that it no longer maps whole, once it
; has unmapped pages or had them taken back.
(def windows_kept ((k Kernel) (q Proc)) Kernel
  (.mem k (mem_windows_mapped (.mem k) (.pid q) (proc_pages q))))

; k with p's space and frames freed, p having ended.
(def k_release ((k Kernel) (p Proc)) Kernel
  (let dev (proc_dev k p)
    (match k
      ((Kernel slots ready ipc ss irqs boot next mem cpus)
        (Kernel slots ready ipc ss irqs boot next (proc_release mem p dev) cpus)))))

; Whether a process in state s may run.
(def is_ready ((s State)) bool
  (match s ((Ready) true) ((Receiving port buf max) false) ((ReceivingSet n buf max) false) ((Waiting pid) false) ((Sleeping) false)
           ((Blocked port) false) ((ReadingTty reply buf n) false) ((AwaitingFs server reply op buf n) false)))

; pid, if it is blocked for room on a port, made ready to make its call
; again: its pc is back on the svc, so it has no answer.
(def unblock ((k Kernel) (pid int)) Kernel
  (match (take_slot k pid)
    ((TakenSlot k2 s)
      (match s
        ((Live p)
          (match (proc_state p)
            ((Blocked port) (park k2 (proc_set_state p (Ready))))
            ((Ready) (restore k2 p))
            ((Receiving port buf max) (restore k2 p))
            ((ReceivingSet n buf max) (restore k2 p))
            ((Waiting on) (restore k2 p))
            ((Sleeping) (restore k2 p))
            ((ReadingTty reply buf n) (restore k2 p))
            ((AwaitingFs server reply op buf n) (restore k2 p))))
        ((Free) (put_slot k2 pid (Free)))
        ((Dead st) (put_slot k2 pid (Dead st)))))))

; Each of pids unblocked, in order.
(def unblock_all ((k Kernel) (pids (list int))) Kernel
  (if (is_empty pids) k (unblock_all (unblock k (head pids)) (tail pids))))

; pid, if it is waiting, made ready with v as its call's result.
(def wake ((k Kernel) (pid int) (v int)) Kernel
  (match (take_slot k pid)
    ((TakenSlot k2 s)
      (match s
        ((Live p)
          (if (is_ready (proc_state p))
              (restore k2 p)
              (park k2 (proc_set_state (proc_answer p v) (Ready)))))
        ((Free) (put_slot k2 pid (Free)))
        ((Dead st) (put_slot k2 pid (Dead st)))))))

; Each of pids woken, in order, with 0 as its call's result; a negative
; one is an alarm (alarm_key), whose port is sent the alarm notice.
(def wake_all ((k Kernel) (pids (list int))) Kernel
  (if (is_empty pids)
      k
      (wake_all (if (lt (head pids) 0) (alarm_sent k (sub 0 (head pids))) (wake k (head pids) 0))
                (tail pids))))

; k with the alarm notice sent to port, which is dropped if its queue is
; full or it is gone.
(def alarm_sent ((k Kernel) (port int)) Kernel
  (match (k_send k port (Msg 0 (bytes_from_list (alarm_notice))))
    ((KSent k2 code) k2)))

; k with every sleeper whose time has come by now woken, with 0.
(def wake_sleepers ((k Kernel) (now int)) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (wake_due ss now)
        ((Woken pids left) (wake_all (Kernel slots ready ipc left irqs boot next mem cpus) pids))))))

; ------------------------------------------------------------- messages

; k with m queued on port, and any process waiting there given it: the
; send's result, 0 or an error, and k after it.
(data KSent (KSent Kernel int))

; m sent to port, as KSent says: err_no_port or err_full if it cannot be
; queued.
(def k_send ((k Kernel) (port int) (m Msg)) KSent
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (ipc_enqueue ipc port m)
        ((Sent i2) (KSent (notify (Kernel slots ready i2 ss irqs boot next mem cpus) port) 0))
        ((SendFailed code i2) (KSent (Kernel slots ready i2 ss irqs boot next mem cpus) code))))))

; The oldest message on port copied into p at buf, if one is waiting:
; the receive's result, the bytes written or an error, with the message
; dropped unless it was too big for max.
(data Taking (Took Kernel Proc int) (NoMessage Kernel Proc))

; A receive into p of the message waiting on port, as Taking says:
; err_too_big, the message kept, if its header and payload are over max.
(def try_take ((k Kernel) (p Proc) (port int) (buf int) (max int)) Taking
  (match (ipc_peek (.ipc k) port)
    ((None) (NoMessage k p))
    ((Some m)
      (match m
        ((Msg from payload)
          (if (gt (add (header_len) (bytes_len payload)) max)
              (Took k p (err_too_big))
              (take_into (with_ipc_dropped k port) p buf from payload)))))))

; k without the oldest message on port, and so with room on it: every
; process blocked for room there made ready to try again.
(def with_ipc_dropped ((k Kernel) (port int)) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (ipc_unblock_all (ipc_drop ipc port) port)
        ((Unblocked pids i2) (unblock_all (Kernel slots ready i2 ss irqs boot next mem cpus) pids))))))

; The rest of try_take, the message dropped: its header, the sender from
; as a u32, and then payload, copied into p at buf; the bytes written, or
; err_fault if p may not take them there.
(def take_into ((k Kernel) (p Proc) (buf int) (from int) (payload bytes)) Taking
  (match (proc_copy_in p buf (bytes_from_list (u32_le from)) 0 (header_len))
    ((CopyInBad q) (Took k q (err_fault)))
    ((CopiedIn q)
      (match (proc_copy_in q (add buf (header_len)) payload 0 (bytes_len payload))
        ((CopyInBad r) (Took k r (err_fault)))
        ((CopiedIn r) (Took k r (add (header_len) (bytes_len payload))))))))

; A receive into p of the oldest message waiting on any port of p's set,
; as try_take answers, with the port it came on after the payload, a
; u32: err_too_big, the message kept, if the three are over max.
(def try_take_set ((k Kernel) (p Proc) (buf int) (max int)) Taking
  (match (ipc_oldest (.ipc k) (ipc_set_of (.ipc k) (.pid p)))
    ((None) (NoMessage k p))
    ((Some port)
      (match (ipc_peek (.ipc k) port)
        ((None) (NoMessage k p))
        ((Some m)
          (match m
            ((Msg from payload)
              (if (gt (add (mul 2 (header_len)) (bytes_len payload)) max)
                  (Took k p (err_too_big))
                  (match (take_into (with_ipc_dropped k port) p buf from payload)
                    ((NoMessage k2 q) (NoMessage k2 q))
                    ((Took k2 q v) (port_after k2 q buf v port)))))))))))

; The rest of try_take_set: port written as a u32 at buf plus v, after
; the v bytes take_into wrote, if it wrote them; the bytes written in
; all, or err_fault.
(def port_after ((k Kernel) (p Proc) (buf int) (v int) (port int)) Taking
  (if (lt v 0)
      (Took k p v)
      (match (proc_copy_in p (add buf v) (bytes_from_list (u32_le port)) 0 (header_len))
        ((CopyInBad q) (Took k q (err_fault)))
        ((CopiedIn q) (Took k q (add v (header_len)))))))

; port's owner, if it is waiting on port, given what waits there.
(def notify ((k Kernel) (port int)) Kernel
  (let owner (ipc_owner (.ipc k) port)
    (if (lt owner 1)
        k
        (match (take_slot k owner)
          ((TakenSlot k2 s)
            (match s
              ((Live q) (notify_proc k2 q port))
              ((Free) (put_slot k2 owner (Free)))
              ((Dead st) (put_slot k2 owner (Dead st)))))))))

; The rest of notify, for the owner q, out of its slot: given the
; message if it is receiving on port, or on a set that holds port (the
; oldest across the set, which may be another's), its line if it reads its terminal
; with port as the reply port, or its answer if it awaits a file server
; with it; put back as it was otherwise.
(def notify_proc ((k Kernel) (q Proc) (port int)) Kernel
  (match (proc_state q)
    ((Receiving on buf max)
      (if (eq on port)
          (match (try_take k q port buf max)
            ((Took k2 r v) (park k2 (proc_set_state (proc_answer r v) (Ready))))
            ((NoMessage k2 r) (restore k2 r)))
          (restore k q)))
    ((ReceivingSet n buf max)
      (if (any_eq port (ipc_set_of (.ipc k) (.pid q)))
          (match (try_take_set k q buf max)
            ((Took k2 r v) (park k2 (proc_set_state (proc_answer r v) (Ready))))
            ((NoMessage k2 r) (restore k2 r)))
          (restore k q)))
    ((ReadingTty reply buf n)
      (if (eq reply port) (tty_line_in k q port buf n) (restore k q)))
    ((AwaitingFs server reply op buf n)
      (if (eq reply port) (fs_reply_in k q server reply op buf n) (restore k q)))
    ((Ready) (restore k q))
    ((Waiting pid) (restore k q))
    ((Sleeping) (restore k q))
    ((Blocked on) (restore k q))))

; -------------------------------------------------------------- processes

; k with entry m started as a new process: its pid, or an error.
(data Spawned (Spawned Kernel int))

; Entry m started by parent, with args if given, and otherwise with the
; arguments the inittab gives it, and the terminal tty, its parent's:
; err_no_port if there is no entry m, or the initramfs has been given up,
; err_denied if it is not a program, or not an ELF the kernel loads,
; err_fault if no process can be made.
(def spawn ((k Kernel) (m int) (parent int) (args (Option (list (list int)))) (tty int)) Spawned
  (if (or (not (is_entry k m)) (not (k_held k))) (Spawned k (err_no_port))
      (not (entry_is_exec (k_entry k m))) (Spawned k (err_denied))
      (spawn_from k m parent (args_or args (k_entry_args k m)) tty (.input (.boot k)) (.start (k_entry k m)) (.end (k_entry k m)))))

; A new process of module m, an entry, or -1 for an image of its own,
; whose image is the bytes of input from start up to end. It takes the
; slot pick_slot chooses, never that of parent, which is running, and so
; out of the table; err_fault if every slot is live, or what image_of
; refuses the image with.
(def spawn_from ((k Kernel) (m int) (parent int) (args (list (list int))) (tty int) (input bytes) (start int) (end int)) Spawned
  (let img (image_of input start end)
    (match img
      ((BadImage code) (Spawned k code))
      ((ElfImage entry segs heap) (spawn_slot k m parent args tty input start end img)))))

; The rest of spawn_from, once img is an ELF: the slot for it chosen, or
; err_fault if every slot is live.
(def spawn_slot ((k Kernel) (m int) (parent int) (args (list (list int))) (tty int) (input bytes) (start int) (end int) (img Image)) Spawned
  (let s (pick_slot (slot_kinds k parent) (.pids k) (slot_of parent))
    (if (lt s 0)
        (Spawned k (err_fault))
        (spawn_in k s m parent args tty input start end img))))

; The rest of spawn_slot, in slot s: the process made with the slot's
; next pid, put in s and on the ready queue, and s given that pid; or
; err_fault if the host has no room for it.
(def spawn_in ((k Kernel) (s int) (m int) (parent int) (args (list (list int))) (tty int) (input bytes) (start int) (end int) (img Image)) Spawned
  (match k
    ((Kernel slots ready ipc ss irqs boot pids mem cpus)
      (let pid (pid_next_in pids s)
        (match (proc_create pid parent m args tty input start end img)
          ((CreateFailed) (Spawned (Kernel slots ready ipc ss irqs boot pids mem cpus) (err_fault)))
          ((Created p0)
            (match (proc_share_image mem p0 img)
              ((Allocated m2 p)
                (Spawned (Kernel (array_set slots s (Live p)) (queue_push ready pid) ipc ss irqs boot (pids_give pids s) m2
                                 (cpus_started cpus pid (clock_ns)))
                         pid)))))))))

; What each slot holds, as pick_slot sees it, while running runs.
(def slot_kinds ((k Kernel) (running int)) (array int)
  (fill_kinds k running 1 (array_new (add (max_procs) 1) (kind_live))))

; The rest of slot_kinds: each slot's kind from i, set in acc.
(def fill_kinds ((k Kernel) (running int) (i int) (acc (array int))) (array int)
  (if (gt i (max_procs))
      acc
      (fill_kinds k running (add i 1) (array_set acc i (slot_kind k running i)))))

; What slot i holds, as pick_slot sees it, while running runs: an exited
; process is spare if its status was given or its parent has gone, and
; kept otherwise.
(def slot_kind ((k Kernel) (running int) (i int)) int
  (match k
    ((Kernel slots ready ipc ss irqs boot pids mem cpus)
      (match (array_get slots i)
        ((Free) (kind_free))
        ((Live p) (kind_live))
        ((Dead g)
          (match g
            ((Gone st parent told)
              (if (or told (parent_gone k running parent)) (kind_spare) (kind_kept)))))))))

; Whether parent, of a process that has exited, can no longer ask for its
; status: the kernel, which never does, or a process that has gone.
(def parent_gone ((k Kernel) (running int) (parent int)) bool
  (if (eq parent 0) true
      (eq parent running) false
      (not (eq (look k parent) (LookLive)))))

; The arguments given, or otherwise if none were.
(def args_or ((given (Option (list (list int)))) (otherwise (list (list int)))) (list (list int))
  (match given ((Some args) args) ((None) otherwise)))

; p has ended with status: its ports, names, sleep, and interrupts go,
; and whoever waits for it is told.
(def exit_proc ((k Kernel) (p Proc) (status int)) Step
  (let (pid (.pid p) k2 (end_proc (exit_noted k p status) p status))
    (if (eq pid 1) (Halt status) (Next k2))))

; k with p's end logged as a warning when its status is neither 0, a
; program's own failure, 1, nor a kill's, 139, which kill logs: a runtime
; error's 70, a machine exception's 99.
(def exit_noted ((k Kernel) (p Proc) (status int)) Kernel
  (if (any_eq status (cons 0 (cons 1 (cons 139 (nil int)))))
      k
      (k_note k 0 (log_warn) (exit_text (base_name (k_proc_path k p)) (.pid p) status))))

; "l0s: process PID (NAME) exited with status STATUS".
(def exit_text ((name (list int)) (pid int) (status int)) (list int)
  (append "l0s: process " (append (digits pid) (append " (" (append name
    (append ") exited with status " (digits status)))))))

; k with p ended: its slot Dead with status, its space and frames kept to
; give again, its ports, names, sleep, and interrupts gone, its windows
; forgotten, those it was the client of and those it served, those
; waiting for it woken, and those watching told.
(def end_proc ((k Kernel) (p Proc) (status int)) Kernel
  (let (pid (.pid p)
        ws (.watchers (.state p))
        ns (irq_numbers k)
        k0 (.cpus (.mem k (mem_windows_forget (.mem k) pid)) (cpus_forget (.cpus k) pid))
        k1 (release_irqs (k_forget_name (k_forget (k_release k0 p) pid) pid) pid ns)
        k2 (.sleepers k1 (sleep_remove (.sleepers k1) pid))
        told (if (is_empty ws) (has_waiter k2 pid 1) true)
        k3 (wake_waiters (put_slot k2 pid (Dead (Gone status (.parent (.state p)) told))) pid (wait_word status) 1))
    (tell_exit k3 ws pid status)))

; Whether a process from slot i on waits for pid.
(def has_waiter ((k Kernel) (pid int) (i int)) bool
  (if (gt i (max_procs)) false
      (waits_for k i pid) true
      (has_waiter k pid (add i 1))))

; Whether the process in slot i is live and waiting for pid.
(def waits_for ((k Kernel) (i int) (pid int)) bool
  (match k
    ((Kernel slots ready ipc ss irqs boot pids mem cpus)
      (match (array_get slots i)
        ((Free) false)
        ((Dead g) false)
        ((Live q) (eq (proc_state q) (Waiting pid)))))))

; k with pid's status marked as given to someone, if it has exited.
(def mark_told ((k Kernel) (pid int)) Kernel
  (match (take_slot k pid)
    ((TakenSlot k2 s)
      (match s
        ((Dead g) (match g ((Gone st parent told) (put_slot k2 pid (Dead (Gone st parent true))))))
        ((Live q) (restore k2 q))
        ((Free) (put_slot k2 pid (Free)))))))

; pid's exit notice, with status, sent from the kernel to each of ports;
; one that cannot take it goes without.
(def tell_exit ((k Kernel) (ports (list int)) (pid int) (status int)) Kernel
  (if (is_empty ports)
      k
      (match (k_send k (head ports) (Msg 0 (bytes_from_list (exit_notice pid status))))
        ((KSent k2 code) (tell_exit k2 (tail ports) pid status)))))

; k without pid's ports, and so with every process blocked for room on
; one of them made ready, to write to the kernel's own instead, every
; process reading a line from one of them given the end of input, and
; every process waiting for one of them as a file server answered -5.
(def k_forget ((k Kernel) (pid int)) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (let (gone (ipc_owned ipc pid)
            blocked (ipc_blocked_by ipc pid)
            k2 (unblock_all (Kernel slots ready (ipc_forget ipc pid) ss irqs boot next mem cpus) blocked))
        (if (is_empty gone) k2 (end_reads k2 gone 1))))))

; Each process from slot i on reading from a terminal whose port is among
; gone, its read answered as the end of input; and each waiting for a
; file server whose port is among them, answered -5.
(def end_reads ((k Kernel) (gone (list int)) (i int)) Kernel
  (if (gt i (max_procs))
      k
      (end_reads (end_read k gone (k_pid_at k i)) gone (add i 1))))

; The rest of end_reads, for pid: its terminal read answered 0, or its
; file server's request given up, its reply port closed and the call
; answered -5, if the port it waits on is among gone; left as it was
; otherwise.
(def end_read ((k Kernel) (gone (list int)) (pid int)) Kernel
  (match (take_slot k pid)
    ((TakenSlot k2 s)
      (match s
        ((Live q)
          (match (proc_state q)
            ((ReadingTty reply buf n)
              (if (any_eq (proc_tty_port q) gone)
                  (park k2 (proc_set_state (proc_answer q 0) (Ready)))
                  (restore k2 q)))
            ((AwaitingFs server reply op buf n)
              (if (any_eq server gone)
                  (park (.ipc k2 (ipc_close (.ipc k2) pid reply)) (proc_set_state (proc_answer (fs_closing q op buf) -5) (Ready)))
                  (restore k2 q)))
            ((Ready) (restore k2 q))
            ((Receiving port buf max) (restore k2 q))
            ((ReceivingSet n buf max) (restore k2 q))
            ((Waiting on) (restore k2 q))
            ((Sleeping) (restore k2 q))
            ((Blocked port) (restore k2 q))))
        ((Free) (put_slot k2 pid (Free)))
        ((Dead st) (put_slot k2 pid (Dead st)))))))

; Every interrupt bound to a port.
(def irq_numbers ((k Kernel)) (list int)
  (match k ((Kernel slots ready ipc ss irqs boot next mem cpus) (map_keys irqs))))

; k with each of the interrupts ns that pid bound released.
(def release_irqs ((k Kernel) (pid int) (ns (list int))) Kernel
  (if (is_empty ns)
      k
      (release_irqs (release_irq k pid (head ns)) pid (tail ns))))

; k with interrupt n let go, if pid bound it: kept as pid 0's, and if it
; was taken and not yet acknowledged, held so, not ended, as its device
; may still raise it (Irq).
(def release_irq ((k Kernel) (pid int) (n int)) Kernel
  (match (k_irq k n)
    ((None) k)
    ((Some b)
      (match b
        ((Irq owner port taken)
          (if (not (eq owner pid))
              k
              (with_irq k n (Irq 0 -1 taken))))))))

; Every process from slot i on that waits for pid, given status.
(def wake_waiters ((k Kernel) (pid int) (status int) (i int)) Kernel
  (if (gt i (max_procs))
      k
      (wake_waiters (wake_if_waiting k (k_pid_at k i) pid status) pid status (add i 1))))

; The process with pid i, if it is live and waits for pid, given status.
(def wake_if_waiting ((k Kernel) (i int) (pid int) (status int)) Kernel
  (match (look k i)
    ((LookFree) k)
    ((LookDead st) k)
    ((LookLive)
      (match (take_slot k i)
        ((TakenSlot k2 s)
          (match s
            ((Live q) (wake_proc_if_waiting k2 q pid status))
            ((Free) (put_slot k2 i (Free)))
            ((Dead st) (put_slot k2 i (Dead st)))))))))

; The rest of wake_if_waiting, for q, out of its slot: made ready with
; status as its wait's result if it waits for pid, put back as it was
; otherwise.
(def wake_proc_if_waiting ((k Kernel) (q Proc) (pid int) (status int)) Kernel
  (match (proc_state q)
    ((Waiting on)
      (if (eq on pid)
          (park k (proc_set_state (proc_answer q status) (Ready)))
          (restore k q)))
    ((Ready) (restore k q))
    ((Receiving port buf max) (restore k q))
    ((ReceivingSet n buf max) (restore k q))
    ((Sleeping) (restore k q))
    ((Blocked port) (restore k q))
    ((ReadingTty reply buf n) (restore k q))
    ((AwaitingFs server reply op buf n) (restore k q))))

; p ended by the kernel, for why, as a fault ends a process on Unix.
(def kill ((k Kernel) (p Proc) (why (list int))) Step
  (exit_proc (k_note k 0 (log_error) (kill_text (base_name (k_proc_path k p)) (.pid p) why)) p 139))

; The line the kernel writes when it kills process pid, named name, for
; why: "l0s: process PID (NAME) killed: WHY".
(def kill_message ((name (list int)) (pid int) (why (list int))) (list int)
  (append (kill_text name pid why) "\n"))

; kill_message without its newline, the text the kernel logs.
(def kill_text ((name (list int)) (pid int) (why (list int))) (list int)
  (let (a (push "l0s: process " (nil int))
        b (push (digits pid) a)
        c (push (append " (" (append name ") killed: ")) b))
    (rev (push why c))))

; ------------------------------------------------------------------ calls

; p running on, its call answered with v.
(def resume_with ((k Kernel) (p Proc) (v int)) Step
  (Resume k (proc_answer p v)))

; Whether p may drive devices: a program of the initramfs's with a dev
; line; never one started from an image of its own.
(def proc_dev ((k Kernel) (p Proc)) bool
  (and (is_entry k (.module p)) (k_entry_dev k (.module p))))

; The region call: device memory for a dev module, mapped where its
; device pages are next free, or, for a range starting at a DMA page of
; its own, the DMA pages it has there. A base in the high user range that
; is no page of p's is a device's, as on a board whose devices lie there.
(def do_region ((k Kernel) (p Proc) (base int) (len int)) Proc
  (if (and (in_device_area base) (proc_has_page p (page_of base))) (proc_dma_region p base len)
      (proc_dev k p) (proc_region p base len)
      (proc_answer p -3)))

; p's n DMA or shared pages from va mapped into pid's next device pages
; too, the same frames, with perm, share_rw for shm_share and share_ro
; for shm_share_read: where pid reaches them, or err_too_big for n below
; 1 or over dma_limit, err_fault if they are not p's or pid has no room,
; err_no_port if there is no such process.
(def do_shm_share ((k Kernel) (p Proc) (va int) (n int) (pid int) (perm int)) Step
  (if (or (lt n 1) (gt n (dma_limit)))
      (resume_with k p (err_too_big))
      (match (dma_frames p (page_of va) n (nil int))
        ((None) (resume_with k p (err_fault)))
        ((Some fs)
          (if (eq pid (.pid p))
              (match (k_map_shared k p fs perm)
                ((KShared k2 p2 v) (resume_with k2 p2 v)))
              (not (is_pid pid)) (resume_with k p (err_no_port))
              (share_into k p pid fs perm))))))

; The rest of do_shm_share for another process pid: the frames fs mapped
; into it with perm, and p answered with where pid reaches them, or why
; not; err_no_port if pid is not live.
(def share_into ((k Kernel) (p Proc) (pid int) (fs (list int)) (perm int)) Step
  (match (take_slot k pid)
    ((TakenSlot k2 s)
      (match s
        ((Live q)
          (match (k_map_shared k2 q fs perm)
            ((KShared k3 q2 v) (resume_with (restore k3 q2) p v))))
        ((Free) (resume_with (put_slot k2 pid (Free)) p (err_no_port)))
        ((Dead st) (resume_with (put_slot k2 pid (Dead st)) p (err_no_port)))))))

; p's n DMA or shared pages from va unmapped, each frame freed once no
; other process maps it: 0, or err_too_big for n below 1 or over
; dma_limit, err_fault if any of them is not p's, when none is unmapped.
; A driver may give its pages up too: that it does says its device is
; done with them. A file window of p's with a page among them is
; forgotten, as one taken back from p by shm_revoke is.
(def do_shm_unmap ((k Kernel) (p Proc) (va int) (n int)) Step
  (if (or (lt n 1) (gt n (dma_limit)))
      (resume_with k p (err_too_big))
      (match (dma_frames p (page_of va) n (nil int))
        ((None) (resume_with k p (err_fault)))
        ((Some fs)
          (match k
            ((Kernel slots ready ipc ss irqs boot pids mem cpus)
              (match (proc_unmap mem p (page_of va) n)
                ((Unmapped m2 q) (resume_with (windows_kept (Kernel slots ready ipc ss irqs boot pids m2 cpus) q) q 0)))))))))

; Every mapping pid has of p's n DMA or shared pages from va taken back:
; how many, or err_too_big for n as above, err_fault if any of them is not
; p's, err_no_port if there is no such process, err_denied if it is p, or
; drives devices, since its device may have been given their addresses.
(def do_shm_revoke ((k Kernel) (p Proc) (va int) (n int) (pid int)) Step
  (if (or (lt n 1) (gt n (dma_limit)))
      (resume_with k p (err_too_big))
      (match (dma_frames p (page_of va) n (nil int))
        ((None) (resume_with k p (err_fault)))
        ((Some fs)
          (if (eq pid (.pid p)) (resume_with k p (err_denied))
              (not (is_pid pid)) (resume_with k p (err_no_port))
              (revoke_from k p pid fs))))))

; The rest of do_shm_revoke for another process pid: its mappings of the
; frames fs taken back, and p answered with how many; err_denied if pid
; drives devices, err_no_port if it is not live.
(def revoke_from ((k Kernel) (p Proc) (pid int) (fs (list int))) Step
  (match (take_slot k pid)
    ((TakenSlot k2 s)
      (match s
        ((Live q)
          (if (proc_dev k2 q)
              (resume_with (restore k2 q) p (err_denied))
              (match k2
                ((Kernel slots ready ipc ss irqs boot pids mem cpus)
                  (match (proc_revoke mem q fs)
                    ((Revoked m2 q2 count)
                      (resume_with (restore (windows_kept (Kernel slots ready ipc ss irqs boot pids m2 cpus) q2) q2) p count)))))))
        ((Free) (resume_with (put_slot k2 pid (Free)) p (err_no_port)))
        ((Dead st) (resume_with (put_slot k2 pid (Dead st)) p (err_no_port)))))))

; The call p trapped with, numbered n, read from its registers.
(def proc_decode ((p Proc) (n int)) Call
  (match p ((Proc pid m s c pages dev st) (decode n c))))

; What follows p's call: each call to its do_* handler, or answered here
; when that takes a line. An unknown call is answered -5; dma_alloc and
; dma_address are refused, err_denied, to a process that may not drive
; devices.
(def dispatch ((k Kernel) (p Proc) (call Call)) Step
  (match call
    ((CRead s buf n) (do_read k p s buf n))
    ((CWrite s buf n) (do_write k p s buf n))
    ((CExit st) (exit_proc k p st))
    ((COpen path len mode) (do_open k p path len mode))
    ((CClose s) (do_close k p s))
    ((CRename from flen to tlen) (do_rename k p from flen to tlen))
    ((CRemove path len) (do_remove k p path len))
    ((CArgCount) (resume_with k p (length (.args (.state p)))))
    ((CArg i buf n) (do_arg k p i buf n))
    ((CRegion base len) (Resume k (do_region k p base len)))
    ((CRelease base len) (resume_with k (if (release_unmaps (frame_free_count) (div len (page_size))) (proc_heap_release p base len) p) 0))
    ((CUnregion addr len) (resume_with k (proc_unregion p addr len) 0))
    ((CYield) (Park k (proc_answer p 0)))
    ((CPid) (resume_with k p (.pid p)))
    ((CPortNew) (do_port_new k p))
    ((CSend port buf len) (do_send k p port buf len))
    ((CReceive port buf max wait) (do_receive k p port buf max wait))
    ((CPortSet buf len) (do_port_set k p buf len))
    ((CReceiveSet buf max wait) (do_receive_set k p buf max wait))
    ((CUnregister buf len) (do_unregister k p buf len))
    ((CRegister port buf len) (do_register k p port buf len))
    ((CLookup buf len) (do_lookup k p buf len))
    ((CSpawn m) (match (spawn k m (.pid p) ((None (list (list int)))) (proc_tty_port p)) ((Spawned k2 pid) (spawn_answered k2 p pid))))
    ((CSpawnArgs m buf len) (do_spawn_args k p m buf len))
    ((CProcInfo pid buf max) (do_proc_info k p pid buf max))
    ((CDmaAlloc n) (if (proc_dev k p) (k_dma_alloc k p n) (resume_with k p (err_denied))))
    ((CDmaAddress va) (Resume k (if (proc_dev k p) (proc_dma_address p va) (proc_answer p (err_denied)))))
    ((CDmaAddresses va buf room) (do_dma_addresses k p va buf room))
    ((CDmaSync va n dir) (do_dma_sync k p va n dir))
    ((CShmAlloc n) (k_dma_alloc k p n))
    ((CShmShare va n pid) (do_shm_share k p va n pid (share_rw)))
    ((CShmShareRead va n pid) (do_shm_share k p va n pid (share_ro)))
    ((CTtySet port) (do_tty_set k p port))
    ((CTtyGet) (resume_with k p (proc_tty_port p)))
    ((CProcSlot i) (do_proc_slot k p i))
    ((CShmUnmap va n) (do_shm_unmap k p va n))
    ((CShmRevoke va n pid) (do_shm_revoke k p va n pid))
    ((CMount port buf len) (do_mount k p port buf len))
    ((CMountAt i buf max) (do_mount_at k p i buf max))
    ((CUnmount port buf len) (do_unmount k p port buf len))
    ((CBootArgs buf max) (give_record k p (encode_args (boot_args)) buf max))
    ((CMemInfo buf max) (give_record k p (k_mem_record k p) buf max))
    ((CRootSwitch buf len) (do_root_switch k p buf len))
    ((CSpawnImage buf len) (do_spawn_image k p buf len))
    ((CChdir buf len) (do_chdir k p buf len))
    ((CGetCwd buf max) (give_record k p (.cwd (.state p)) buf max))
    ((CLogWrite level buf len) (do_log_write k p level buf len))
    ((CLogRead seq buf max) (do_log_read k p seq buf max))
    ((CCpuUsage pid buf max) (do_cpu_usage k p pid buf max))
    ((CNameList i buf max) (do_name_list k p i buf max))
    ((CWait pid) (do_wait k p pid))
    ((CSleepUntil t) (do_sleep k p t))
    ((CIrqBind irq port) (do_irq_bind k p irq port))
    ((CIrqAck irq) (do_irq_ack k p irq))
    ((CModuleName i buf max) (do_module_name k p i buf max))
    ((CEntrySize i) (do_entry_size k p i))
    ((CAlarm port t) (do_alarm k p port t))
    ((CReboot) (do_reboot k p))
    ((CKill pid) (do_kill k p pid))
    ((CWatch pid port) (do_watch k p pid port))
    ((CUnknown n) (resume_with k p -5))))

; ------------------------------------------------------------------ files

; Stream 0 is the inittab's stdin file, read from where any process last
; read it to; streams from 3 are files p opened, each read from where p
; last read it to, a volume's by asking its server. The answer is how
; many bytes were copied to buf, 0 at the end, or -5.
(def do_read ((k Kernel) (p Proc) (s int) (buf int) (n int)) Step
  (if (lt n 0) (resume_with k p -5)
      (eq s 0) (if (eq (proc_tty_port p) 0) (read_stdin k p buf n) (read_tty k p buf n))
      (match (proc_open_file p s)
        ((None) (resume_with k p -5))
        ((Some f)
          (match f
            ((Open e offset) (read_open k p s e offset buf n))
            ((OpenRemote port h) (read_remote k p port h buf n)))))))

; Standard input from the inittab's stdin file, for a process on the
; kernel's own terminal: up to n bytes, and io_chunk at most, from where
; any process last read it to, copied to buf; 0 at its end, or with no
; stdin file; -5 if p may not take them at buf.
(def read_stdin ((k Kernel) (p Proc) (buf int) (n int)) Step
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match boot
        ((Boot input es devs defaults stdin cur names klog)
          (if (lt stdin 0)
              (resume_with (Kernel slots ready ipc ss irqs (Boot input es devs defaults stdin cur names klog) next mem cpus) p 0)
              (let (e (array_get es stdin)
                    from (add (.start e) cur)
                    cnt (min n (min (io_chunk) (sub (.end e) from))))
                (match (proc_copy_in p buf input from (add from cnt))
                  ((CopyInBad q)
                    (resume_with (Kernel slots ready ipc ss irqs (Boot input es devs defaults stdin cur names klog) next mem cpus) q -5))
                  ((CopiedIn q)
                    (resume_with (Kernel slots ready ipc ss irqs (Boot input es devs defaults stdin (add cur cnt) names klog) next mem cpus)
                                 q cnt))))))))))

; A file of the initramfs, opened before it was given up, reads as at its
; end from then on.
(def read_open ((k Kernel) (p Proc) (s int) (e int) (offset int) (buf int) (n int)) Step
  (if (k_held k) (read_held k p s e offset buf n) (resume_with k p 0)))

; The rest of read_open, while the initramfs is held: up to n bytes of
; entry e, and io_chunk at most, from offset, copied to buf and stream s
; moved past them; their count, 0 at its end, or -5 if p may not take
; them at buf.
(def read_held ((k Kernel) (p Proc) (s int) (e int) (offset int) (buf int) (n int)) Step
  (let (entry (k_entry k e)
        from (add (.start entry) offset)
        cnt (min n (min (io_chunk) (sub (.end entry) from))))
    (match (proc_copy_in p buf (.input (.boot k)) from (add from cnt))
      ((CopyInBad q) (resume_with k q -5))
      ((CopiedIn q) (resume_with k (proc_seek q s e (add offset cnt)) cnt)))))

; A path p gives, made absolute, or none if p may not give it: past
; path_limit, or not p's to read.
(data PathGot (PathGot Proc (list int)) (PathBad Proc))

; The path of len bytes p gives at buf, made absolute from p's current
; directory, with its . and .. taken out: PathBad if it is over path_limit
; once it is.
(def path_from ((p Proc) (buf int) (len int)) PathGot
  (if (or (lt len 0) (gt len (path_limit)))
      (PathBad p)
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (PathBad q))
        ((CopiedOut q b) (path_resolved q (path_resolve (.cwd (.state q)) (bytes_to_list b)))))))

; q's path, which path_resolve gave, unless it is over path_limit.
(def path_resolved ((q Proc) (path (list int))) PathGot
  (if (gt (length path) (path_limit)) (PathBad q) (PathGot q path)))

; Opens the file at path, by where the mount table puts it: the
; initramfs's (open_root), a volume's, whose server is asked, or none.
; /Volumes is a directory, -8; in it there is nothing to read, -3, and
; nothing can be made, -4; and in a volume not mounted, -3 or -9.
(def do_open ((k Kernel) (p Proc) (buf int) (len int) (mode int)) Step
  (match (path_from p buf len)
    ((PathBad q) (resume_with k q -5))
    ((PathGot q path)
      (if (not (any_eq mode (cons 1 (cons 2 (cons 3 (nil int))))))
          (resume_with k q -5)
          (match (mount_where (.mounts (.ipc k)) path)
            ((InRoot) (open_root k q path mode))
            ((InVolumes) (resume_with k q -8))
            ((InNothing direct) (resume_with k q (if (eq mode 1) -3 direct -4 -9)))
            ((InServer port asked) (open_remote k q port asked mode)))))))

; Opens the initramfs's file at path. To read, mode 1: a new stream, or -3
; if there is no such file, -8 if it is a directory, -5 if p has
; open_limit open. To write, modes 2 and 3: never, since the initramfs is
; read-only, so -8 for a directory, -4 where the directory it would be in
; exists, and -9 where it does not.
(def open_root ((k Kernel) (q Proc) (path (list int)) (mode int)) Step
  (let e (entry_index (.entries (.boot k)) path)
    (if (eq mode 1)
        (open_to_read k q e)
        (resume_with k q (if (and (ge e 0) (entry_is_dir (k_entry k e))) -8
                             (has_dir k (parent_path path)) -4
                             -9)))))

; The rest of open_root, to read entry e, -1 for none: as open_root
; says, and -5 too for an entry that is neither a file nor a directory.
(def open_to_read ((k Kernel) (p Proc) (e int)) Step
  (if (lt e 0) (resume_with k p -3)
      (entry_is_dir (k_entry k e)) (resume_with k p -8)
      (not (entry_is_file (k_entry k e))) (resume_with k p -5)
      (match (proc_open p e)
        ((Opened q s) (resume_with k q s)))))

; Whether path is a directory: the root always, as an archive need not
; list it.
(def has_dir ((k Kernel) (path (list int))) bool
  (or (eq path "/")
      (let e (entry_index (.entries (.boot k)) path)
        (and (not (lt e 0)) (entry_is_dir (k_entry k e))))))

; Makes the directory at the len bytes at buf, from p's current directory,
; its new one: 0, or -3 if there is none, -9 if it is a file, -5 if the
; path is not p's to give or is over path_limit. The initramfs's, /Volumes
; and a volume's root the kernel knows; anything in a volume its server
; says, with a stat, p waiting for it.
(def do_chdir ((k Kernel) (p Proc) (buf int) (len int)) Step
  (match (path_from p buf len)
    ((PathBad q) (resume_with k q -5))
    ((PathGot q path)
      (if (eq path "/")
          (resume_with k (proc_set_cwd q path) 0)
          (match (mount_where (.mounts (.ipc k)) path)
            ((InRoot) (chdir_root k q path))
            ((InVolumes) (resume_with k (proc_set_cwd q path) 0))
            ((InNothing direct) (resume_with k q -3))
            ((InServer port asked) (ask_fs k q port (fs_op_cd) buf len (append "stat " asked))))))))

; The rest of do_chdir for path in the initramfs: its current directory if
; it is one there, else -9 for a file, -3 for nothing.
(def chdir_root ((k Kernel) (q Proc) (path (list int))) Step
  (if (has_dir k path)
      (resume_with k (proc_set_cwd q path) 0)
      (resume_with k q (if (lt (entry_index (.entries (.boot k)) path) 0) -3 -9))))

; The directory path is in: "/bin" for "/bin/sh", "/" for "/sh".
(def parent_path ((path (list int))) (list int)
  (let up (drop_slashes (drop_to_slash (rev path)))
    (if (is_empty up) "/" (rev up))))

; s from its first slash on, or empty if it has none.
(def drop_to_slash ((s (list int))) (list int)
  (if (is_empty s) s (eq (head s) 47) s (drop_to_slash (tail s))))

; Closes stream s: 0, or -5 if it is not open; a volume's file is closed
; by its server too, whose answer is the call's, and the stream goes once
; the server has answered, or gone.
(def do_close ((k Kernel) (p Proc) (s int)) Step
  (match (proc_open_file p s)
    ((None) (resume_with k p -5))
    ((Some f)
      (match f
        ((Open e offset) (match (proc_close p s) ((ClosedFile q was) (resume_with k q 0))))
        ((OpenRemote port h) (ask_fs k p port (fs_op_close) s 0 (append "close " (digits h))))))))

; Renames the file at from to to: within the initramfs, never; within a
; volume, by its server; between the two, or two volumes, -10; and as
; rename_route says for /Volumes and what is in no volume.
(def do_rename ((k Kernel) (p Proc) (from int) (flen int) (to int) (tlen int)) Step
  (match (path_from p from flen)
    ((PathBad q) (resume_with k q -5))
    ((PathGot q a)
      (match (path_from q to tlen)
        ((PathBad r) (resume_with k r -5))
        ((PathGot r b)
          (let (ms (.mounts (.ipc k))
                wa (mount_where ms a)
                wb (mount_where ms b)
                route (rename_route wa wb))
            (if (lt route 0) (resume_with k r route)
                (eq route 0) (resume_with k r (if (lt (entry_index (.entries (.boot k)) a) 0) -3 -4))
                (ask_fs k r route (fs_op_word) 0 0
                        (append "rename " (append (where_path wa a) (cons 32 (where_path wb b))))))))))))

; Removes the file at path: nothing in the initramfs can be, -3 if there
; is no file by the name, -8 for a directory, and otherwise -4; a
; volume's, by its server.
(def do_remove ((k Kernel) (p Proc) (buf int) (len int)) Step
  (match (path_from p buf len)
    ((PathBad q) (resume_with k q -5))
    ((PathGot q path)
      (match (mount_where (.mounts (.ipc k)) path)
        ((InRoot)
          (let e (entry_index (.entries (.boot k)) path)
            (resume_with k q (if (lt e 0) -3 (entry_is_dir (k_entry k e)) -8 -4))))
        ((InVolumes) (resume_with k q -8))
        ((InNothing direct) (resume_with k q -3))
        ((InServer port asked) (ask_fs k q port (fs_op_word) 0 0 (append "remove " asked)))))))

; Standard output and error go to p's terminal, or are the kernel's own
; if it has none, or its terminal has gone. Streams from 3 are written
; only if they are a volume's file, by its server.
(def do_write ((k Kernel) (p Proc) (s int) (buf int) (n int)) Step
  (if (lt n 0) (resume_with k p -5)
      (not (any_eq s (cons 1 (cons 2 (nil int))))) (write_stream k p s buf n)
      (or (eq (proc_tty_port p) 0) (lt (ipc_owner (.ipc k) (proc_tty_port p)) 1)) (write_own k p s buf n)
      (eq n 0) (resume_with k p 0)
      (write_tty k p (proc_tty_port p) buf n)))

; The rest of do_write, for stream s from 3: a volume's file written by
; its server, or -5 for one not open or the initramfs's.
(def write_stream ((k Kernel) (p Proc) (s int) (buf int) (n int)) Step
  (match (proc_open_file p s)
    ((None) (resume_with k p -5))
    ((Some f)
      (match f
        ((Open e offset) (resume_with k p -5))
        ((OpenRemote port h) (write_remote k p port h buf n))))))

; ---------------------------------------------------------------- volumes

; A volume's files are its server's, which the kernel asks on a
; process's behalf with the fs protocol's requests (user/lib/proto/fs.l0), sent
; as from the process, so the server knows whose handles they are. Each
; reply begins with a word, s32, then the bytes of a read; the process
; waits for it on a port made for that one reply.

; What a process waiting for a file server does with its answer: opens a
; stream on the handle, takes a read's bytes, takes a write's count,
; closes the stream its buf names, takes the word, or makes the directory
; a stat says is one its current directory.
(def fs_op_open () int 1)
(def fs_op_read () int 2)
(def fs_op_write () int 3)
(def fs_op_close () int 4)
(def fs_op_word () int 5)
(def fs_op_cd () int 6)       ; its buf and n the path's, which a directory makes the new current one
(def fs_op_wread () int 7)    ; a read whose bytes the server put in the client's window

; The most bytes a read reply carries: a message, less its word.
(def fs_chunk () int (sub (max_message) 4))

; body sent to the server at port as p's request, its reply to a port
; made for it, and p waiting for the reply, to do op with it, buf and n;
; if the server's queue is full, p blocked until there is room, to make
; its call again; or -5 if the server has gone.
(def ask_fs ((k Kernel) (p Proc) (server int) (op int) (buf int) (n int) (body (list int))) Step
  (ask_fs_data k p server op buf n body (bytes_from_list (nil int))))

; ask_fs with tail_bytes, copied from p, after body's text: joined once,
; with no list of them.
(def ask_fs_data ((k Kernel) (p Proc) (server int) (op int) (buf int) (n int) (body (list int)) (tail_bytes bytes)) Step
  (match (k_port_new k (.pid p))
    ((KPort r k1)
      (match (k_send k1 server (Msg (.pid p) (bytes_concat (cons (bytes_from_list (request_to r body)) (cons tail_bytes (nil bytes))))))
        ((KSent k2 code)
          (if (eq code 0)
              (Park k2 (proc_set_state p (AwaitingFs server r op buf n)))
              (let k3 (.ipc k2 (ipc_close (.ipc k2) (.pid p) r))
                (if (eq code (err_full)) (block_on k3 p server) (resume_with k3 p -5)))))))))

; A volume's file opened: a stream, once its server says, or -5 if p has
; open_limit open already; p's window to the server made first, if it
; has none, or the code why not.
(def open_remote ((k Kernel) (p Proc) (server int) (path (list int)) (mode int)) Step
  (if (proc_files_full p)
      (resume_with k p -5)
      (match (windowed k p server)
        ((WinRefused k2 code) (resume_with k2 p code))
        ((WinReady k2) (ask_fs k2 p server (fs_op_open) 0 0 (append "open " (append (digits mode) (cons 32 path))))))))

; At most n bytes of handle h read into buf, as the server gives them:
; through p's window to it, up to 64 KB, the server putting them there
; and the kernel copying them to buf once it answers; or, with no window,
; in the reply, at most a message's worth.
(def read_remote ((k Kernel) (p Proc) (server int) (h int) (buf int) (n int)) Step
  (if (eq n 0)
      (resume_with k p 0)
      (match (window_space k (.pid p) server)
        ((WinSpace s va)
          (ask_fs k p server (fs_op_wread) buf (min n (window_bytes))
                  (append "readw " (append (digits h) (cons 32 (digits (min n (window_bytes))))))))
        ((NoWinSpace)
          (ask_fs k p server (fs_op_read) buf n
                  (append "read " (append (digits h) (cons 32 (digits (min n (fs_chunk)))))))))))

; As much of the n bytes at buf as a request holds written to handle h:
; up to 64 KB copied into p's window to the server, which takes them from
; there; or, with no window, a message's worth after the request's text.
(def write_remote ((k Kernel) (p Proc) (server int) (h int) (buf int) (n int)) Step
  (if (eq n 0)
      (resume_with k p 0)
      (match (window_space k (.pid p) server)
        ((WinSpace s va) (write_windowed k p server h buf n s va))
        ((NoWinSpace) (write_messaged k p server h buf n)))))

; write_remote through the window at va of the server's space s.
(def write_windowed ((k Kernel) (p Proc) (server int) (h int) (buf int) (n int) (s Space) (va int)) Step
  (let cnt (min n (window_bytes))
    (match (proc_copy_out p buf cnt)
      ((CopyOutBad q) (resume_with k q -5))
      ((CopiedOut q b)
        (let w (space_write (.id s) va b 0 cnt)
          (ask_fs k q server (fs_op_write) 0 cnt (append "writew " (append (digits h) (cons 32 (digits cnt))))))))))

; write_remote in the request's message.
(def write_messaged ((k Kernel) (p Proc) (server int) (h int) (buf int) (n int)) Step
  (let (prefix (append "write " (append (digits h) " "))
        cnt (min n (sub (sub (max_message) 4) (length prefix))))
    (match (proc_copy_out p buf cnt)
      ((CopyOutBad q) (resume_with k q -5))
      ((CopiedOut q b) (ask_fs_data k q server (fs_op_write) 0 cnt prefix b)))))

; q, waiting for the server at server, given its reply on reply now that
; one has come: from the server's owner, or else dropped and q left
; waiting, since anyone may send to any port.
(def fs_reply_in ((k Kernel) (q Proc) (server int) (reply int) (op int) (buf int) (n int)) Kernel
  (match (ipc_peek (.ipc k) reply)
    ((None) (restore k q))
    ((Some m)
      (match m
        ((Msg from payload)
          (if (not (eq from (ipc_owner (.ipc k) server)))
              (restore (.ipc k (ipc_drop (.ipc k) reply)) q)
              (let (pid (.pid q)
                    q2 (proc_set_state (if (eq op (fs_op_wread))
                                           (fs_wread_in k q server buf n payload)
                                           (fs_answered q server op buf n payload))
                                       (Ready)))
                (park (.ipc k (ipc_close (.ipc k) pid reply)) q2))))))))

; q answered for a read through its window to the server, whose reply b
; says how many bytes it put there: those copied from the window to buf,
; at most n; -5 if the reply is not one, or the window is gone.
(def fs_wread_in ((k Kernel) (q Proc) (server int) (buf int) (n int) (b bytes)) Proc
  (if (lt (bytes_len b) 4)
      (proc_answer q -5)
      (let w (s32 (le_u32 b 0))
        (if (lt w 1) (proc_answer q (if (lt w -10) -5 w))
            (gt w n) (proc_answer q -5)
            (match (window_space k (.pid q) server)
              ((NoWinSpace) (proc_answer q -5))
              ((WinSpace s va)
                (match (proc_copy_in q buf (space_read (.id s) va w) 0 w)
                  ((CopyInBad r) (proc_answer r -5))
                  ((CopiedIn r) (proc_answer r w)))))))))

; q answered as the server's reply b says, for op: -5 if it is not one.
; A close's stream goes whatever the answer.
(def fs_answered ((q0 Proc) (server int) (op int) (buf int) (n int) (b bytes)) Proc
  (let q (fs_closing q0 op buf)
    (if (lt (bytes_len b) 4)
        (proc_answer q -5)
        (fs_worded q server op buf n b (s32 (le_u32 b 0))))))

; q, without stream s if op is a close.
(def fs_closing ((q Proc) (op int) (s int)) Proc
  (if (eq op (fs_op_close)) (match (proc_close q s) ((ClosedFile r was) r)) q))

; q answered for op, the reply b's word being w.
(def fs_worded ((q Proc) (server int) (op int) (buf int) (n int) (b bytes) (w int)) Proc
  (if (lt w 0) (proc_answer q (if (lt w -10) -5 w))
      (eq op (fs_op_open)) (match (proc_open_remote q server w) ((Opened r s) (proc_answer r s)))
      (eq op (fs_op_read)) (fs_read_in q buf n w b)
      (eq op (fs_op_write)) (proc_answer q (if (or (lt w 1) (gt w n)) -5 w))
      (eq op (fs_op_cd)) (fs_cd_in q buf n b)
      (proc_answer q w)))

; q answered for a chdir whose path is the n bytes at buf, the server's
; stat reply b saying what is there: the path q's current directory if it
; is a directory, else -9; -5 if q may not give the path any more.
(def fs_cd_in ((q Proc) (buf int) (n int) (b bytes)) Proc
  (match (path_from q buf n)
    ((PathBad r) (proc_answer r -5))
    ((PathGot r path)
      (if (and (eq (bytes_len b) 7) (bytes_is_at b 4 "dir"))
          (proc_answer (proc_set_cwd r path) 0)
          (proc_answer r -9)))))

; q given the w bytes of a read's reply b after its word, at most n, at
; buf: how many, or -5 if q may not take them there.
(def fs_read_in ((q Proc) (buf int) (n int) (w int) (b bytes)) Proc
  (let cnt (min w (min n (sub (bytes_len b) 4)))
    (match (proc_copy_in q buf b 4 (add 4 cnt))
      ((CopyInBad r) (proc_answer r -5))
      ((CopiedIn r) (proc_answer r cnt)))))

; The volume LABEL, the len bytes at buf being UUID LABEL, its
; partition's UUID first, or LABEL alone, mounted from port, p's, at
; /Volumes/LABEL: 0, or err_no_port if port is not p's, err_taken if
; label is mounted already, err_fault if it is no label, the UUID is
; none, or p may not give them.
(def do_mount ((k Kernel) (p Proc) (port int) (buf int) (len int)) Step
  (if (or (lt len 1) (gt len 52))
      (resume_with k p (err_fault))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (match (mount_name_of (bytes_to_list b))
            ((MountNameBad) (resume_with k q (err_fault)))
            ((MountName uuid label)
              (match (ipc_mount (.ipc k) (.pid q) port label uuid)
                ((Registered code i2)
                  (resume_with (if (eq code 0) (k_note (.ipc k i2) 0 (log_info) (append "l0s: /Volumes/" (append label " mounted"))) (.ipc k i2)) q code)))))))))

; The volume at /Volumes/LABEL, the len bytes at buf, which port, p's,
; mounted, unmounted: 0, or err_no_port if port is not p's or mounted no
; such volume, err_denied for the system volume, and err_fault if it is
; no label or p may not give it. Calls on its files go nowhere from then
; on: a path in it is in no volume.
(def do_unmount ((k Kernel) (p Proc) (port int) (buf int) (len int)) Step
  (if (or (lt len 1) (gt len 15))
      (resume_with k p (err_fault))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (match (ipc_unmount (.ipc k) (.pid q) port (bytes_to_list b))
            ((Registered code i2)
              (resume_with (if (eq code 0) (k_note (.ipc k i2) 0 (log_info) (append "l0s: /Volumes/" (append (bytes_to_list b) " unmounted"))) (.ipc k i2)) q code)))))))

; The volume label, the len bytes at buf, made /, and the initramfs given
; up: 0, or err_denied if p's program is not the initramfs's, err_taken
; if / is a volume already, err_no_port if label is not mounted, and
; err_fault if it is no label or p may not give it.
(def do_root_switch ((k Kernel) (p Proc) (buf int) (len int)) Step
  (if (or (lt len 1) (gt len 15)) (resume_with k p (err_fault))
      (not (is_entry k (.module p))) (resume_with k p (err_denied))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (match (ipc_root (.ipc k) (bytes_to_list b))
            ((Registered code i2)
              (if (eq code 0)
                  (resume_with (k_note (k_free_initramfs (.ipc k i2)) 0 (log_info) (append "l0s: / is the volume " (append (bytes_to_list b) ", and the initramfs is given up"))) q 0)
                  (resume_with k q code))))))))

; The board's boot arguments, split at spaces.
(def boot_args () (list (list int))
  (boot_args_from (sub (arg_count) 1) (nil (list int))))

; The boot arguments from 0 to i, onto acc, working down from i.
(def boot_args_from ((i int) (acc (list (list int)))) (list (list int))
  (if (lt i 0) acc (boot_args_from (sub i 1) (cons (arg i) acc))))

; A program started from the len bytes at buf, as spawn_image_bytes lays
; them out: its path, its arguments, then its image. Its pid; or
; err_too_big if they are over the room a program's file, a path and a
; message of arguments take; err_fault if p may not give them, or they
; are not laid out so; err_denied for no image at all; or what spawn_from
; gives, err_denied for an image that is not an ELF the kernel loads.
; Given no arguments it gets the inittab's for its path; it never drives
; devices.
(def do_spawn_image ((k Kernel) (p Proc) (buf int) (len int)) Step
  (if (lt len 8) (resume_with k p (err_fault))
      (gt len (add (add 8 (path_limit)) (add (max_message) (image_file_room)))) (resume_with k p (err_too_big))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b) (spawn_image_of k q b)))))

; The rest of do_spawn_image, its bytes b copied out: the path's length,
; a u32, and the path, then the arguments' length, a u32, and the
; arguments, each checked to lie within b; err_fault if not, or for a
; path of none or over path_limit, or arguments over max_message.
(def spawn_image_of ((k Kernel) (p Proc) (b bytes)) Step
  (let pl (le_u32 b 0)
    (if (or (lt pl 1) (or (gt pl (path_limit)) (not (has b 4 (add pl 4)))))
        (resume_with k p (err_fault))
        (let (al (le_u32 b (add 4 pl)) at (add 8 pl))
          (if (or (gt al (max_message)) (not (has b at al)))
              (resume_with k p (err_fault))
              (spawn_image_args k p b (normal_path (bytes_range b 4 (add 4 pl))) at (add at al)))))))

; The image of b from start, its path and its encoded arguments, the
; bytes of b from at up to start, read in place; none for the inittab's.
(def spawn_image_args ((k Kernel) (p Proc) (b bytes) (path (list int)) (at int) (start int)) Step
  (let size (sub (bytes_len b) start)
    (if (lt size 1) (resume_with k p (err_denied))
        (eq at start) (spawned_image k p b path (k_path_args k path) start)
        (match (decode_args_in b at start)
          ((None) (resume_with k p (err_fault)))
          ((Some args) (spawned_image k p b path args start))))))

; The image of b from start started as a child of p, with args, on p's
; terminal: p answered with its pid, which k then names by path, or with
; spawn_from's refusal.
(def spawned_image ((k Kernel) (p Proc) (b bytes) (path (list int)) (args (list (list int))) (start int)) Step
  (match (spawn_from k -1 (.pid p) args (proc_tty_port p) b start (bytes_len b))
    ((Spawned k2 pid)
      (spawn_answered (if (gt pid 0) (k_name_put k2 pid path) k2) p pid))))

; p answered with the pid of the child it spawned, which gets p's
; current directory, or with the refusal pid is; and p given a slice
; from now. Loading an image takes the kernel long, under TCG most of a
; slice, and that is not p's time: charged to it, p would lose the
; processor as the call returned, and its child run before p's next
; step, as often as not a line saying what it started.
(def spawn_answered ((k Kernel) (p Proc) (pid int)) Step
  (let t (timer_at (slice_deadline (.sleepers k) (clock_ns)))
    (resume_with (k_child_cwd k pid (.cwd (.state p))) p pid)))

; k with the new process pid's current directory cwd, its parent's; as
; it was if pid is an error, not a process.
(def k_child_cwd ((k Kernel) (pid int) (cwd (list int))) Kernel
  (if (lt pid 1)
      k
      (match k
        ((Kernel slots ready ipc ss irqs boot next mem cpus)
          (match (array_get slots (slot_of pid))
            ((Live c) (put_slot k pid (Live (proc_set_cwd c cwd))))
            ((Free) k)
            ((Dead st) k))))))

; k knowing pid's image's path.
(def k_name_put ((k Kernel) (pid int) (path (list int))) Kernel
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match boot
        ((Boot input es devs defaults stdin cur names klog)
          (Kernel slots ready ipc ss irqs (Boot input es devs defaults stdin cur (map_put names pid path) klog) next mem cpus))))))

; Where a device reaches each of p's DMA pages from va's on, copied to
; buf, as many as room holds, a u64 each, dma_limit at most: how many
; bytes, 0 if va's page is not one; err_denied to a process that may not
; drive devices, err_fault if p may not take them at buf. One call for a
; buffer of thousands of pages, which dma_address takes one at a time.
(def do_dma_addresses ((k Kernel) (p Proc) (va int) (buf int) (room int)) Step
  (if (not (proc_dev k p))
      (resume_with k p (err_denied))
      (give_record k p (proc_dma_addresses p va (min (dma_limit) (div (max 0 room) 8))) buf (max 0 room))))

; n of p's DMA pages from va's on, dma_limit at most, made to agree
; between the CPU's caches and memory, as a device that does not see
; the caches needs (frame_sync): dir 1 cleans, before the device reads;
; 2 invalidates, before p reads what it wrote; 3 does both. How many,
; up to the first that is not a DMA page, 0 if va's is not; err_denied to
; a process that may not drive devices, err_fault for any other dir,
; checked before frame_sync could refuse it.
(def do_dma_sync ((k Kernel) (p Proc) (va int) (n int) (dir int)) Step
  (if (not (proc_dev k p)) (resume_with k p (err_denied))
      (and (ge dir 1) (le dir 3)) (resume_with k p (proc_dma_sync p va (min (dma_limit) (max 0 n)) dir))
      (resume_with k p (err_fault))))

; Mount i's record copied to buf, if it fits in max: its length, or
; err_no_port if there is no mount i, err_too_big if it does not fit.
(def do_mount_at ((k Kernel) (p Proc) (i int) (buf int) (max int)) Step
  (match (mounts_at (.mounts (.ipc k)) i)
    ((None) (resume_with k p (err_no_port)))
    ((Some m) (give_record k p (mount_record m) buf max))))

; Standard output or error s on the kernel's own: up to n bytes at buf,
; and io_chunk at most, written and flushed; how many, or -5 if p may not
; give them.
(def write_own ((k Kernel) (p Proc) (s int) (buf int) (n int)) Step
  (let cnt (min n (io_chunk))
    (match (proc_copy_out p buf cnt)
      ((CopyOutBad q) (resume_with k q -5))
      ((CopiedOut q b)
        (let (w (write_bytes s b 0 cnt) f (flush s))
          (resume_with k q cnt))))))

; The most one write sends a terminal: a message, less its request's
; reply port and its w.
(def tty_chunk () int (sub (max_message) 5))

; As much of the n bytes at buf as a message holds, sent to the terminal
; at port t as (request 0 (cons w bytes)): how many, or, if t's queue is
; full, p blocked until there is room, to write again.
(def write_tty ((k Kernel) (p Proc) (t int) (buf int) (n int)) Step
  (let cnt (min n (tty_chunk))
    (match (proc_copy_out p buf cnt)
      ((CopyOutBad q) (resume_with k q -5))
      ((CopiedOut q b)
        (match (k_send k t (Msg (.pid q) (bytes_concat (cons (bytes_from_list (append (u32_le 0) "w")) (cons b (nil bytes))))))
          ((KSent k2 code)
            (if (eq code 0) (resume_with k2 q cnt)
                (eq code (err_full)) (block_on k2 q t)
                (resume_with k2 q -7))))))))

; p waiting for room on port, to make its call again then.
(def block_on ((k Kernel) (p Proc) (port int)) Step
  (Park (.ipc k (ipc_block (.ipc k) port (.pid p))) (proc_set_state (proc_rewind p) (Blocked port))))

; Standard input from p's terminal: what is left of the last line it
; sent, or the next, which p's terminal is asked for and p waits for. A
; terminal that has gone reads as the end of input.
(def read_tty ((k Kernel) (p Proc) (buf int) (n int)) Step
  (match (.tty (.state p))
    ((Tty t reply rest off)
      (if (gt (bytes_len rest) off) (resume_line k p buf n rest off)
          (or (eq n 0) (lt (ipc_owner (.ipc k) t) 1)) (resume_with k p 0)
          (eq (ipc_owner (.ipc k) reply) (.pid p)) (ask_line k p t reply buf n)
          (match (k_port_new k (.pid p))
            ((KPort r k1)
              (ask_line k1 (proc_set_tty p (Tty t r rest off)) t r buf n)))))))

; The rest of read_tty: a line asked of the terminal at port t, "r", to
; come back on reply, and p reading it; if t's queue is full, p blocked
; until there is room, to read again; if t cannot be sent to, the end
; of input.
(def ask_line ((k Kernel) (p Proc) (t int) (reply int) (buf int) (n int)) Step
  (match (k_send k t (Msg (.pid p) (bytes_from_list (request_to reply "r"))))
    ((KSent k2 code)
      (if (eq code 0) (Park k2 (proc_set_state p (ReadingTty reply buf n)))
          (eq code (err_full)) (block_on k2 p t)
          (resume_with k2 p 0)))))

; A request as l0s.l0's request makes one: the reply port, then the body.
(def request_to ((reply int) (body (list int))) (list int)
  (append (u32_le reply) body))

; p reading line from off into buf: as much as n holds, copied from line
; in place, the line kept with how much has been read, for its next read
; to go on from, and how many as its answer; or -5 if it may not take
; them there.
(def line_given ((p Proc) (buf int) (n int) (line bytes) (off int)) Proc
  (let cnt (min n (sub (bytes_len line) off))
    (match (proc_copy_in p buf line off (add off cnt))
      ((CopyInBad q) (proc_answer q -5))
      ((CopiedIn q)
        (match (.tty (.state q))
          ((Tty t reply rest o)
            (proc_answer (proc_set_tty q (Tty t reply line (add off cnt))) cnt)))))))

; p running on, given line from off as line_given says.
(def resume_line ((k Kernel) (p Proc) (buf int) (n int) (line bytes) (off int)) Step
  (Resume k (line_given p buf n line off)))

; q, waiting for its terminal's line on reply, given it now that one has
; come: an empty line is the end of input.
(def tty_line_in ((k Kernel) (q Proc) (reply int) (buf int) (n int)) Kernel
  (match (ipc_peek (.ipc k) reply)
    ((None) (restore k q))
    ((Some m)
      (match m
        ((Msg from payload)
          (park (with_ipc_dropped k reply) (proc_set_state (line_given q buf n payload 0) (Ready))))))))

; p's terminal set to port, 0 for the kernel's own: 0, or err_no_port if
; there is no such port. Its children, from now on, get it too.
(def do_tty_set ((k Kernel) (p Proc) (port int)) Step
  (if (and (not (eq port 0)) (lt (ipc_owner (.ipc k) port) 1))
      (resume_with k p (err_no_port))
      (match (.tty (.state p))
        ((Tty t reply rest off) (resume_with k (proc_set_tty p (Tty port reply (bytes_from_list (nil int)) 0)) 0)))))

; Argument i of p's, as much as n holds copied to buf: its whole length,
; or -5 for no argument i, a negative n, or a buf p may not take it at.
(def do_arg ((k Kernel) (p Proc) (i int) (buf int) (n int)) Step
  (let args (.args (.state p))
    (if (or (lt i 0) (or (ge i (length args)) (lt n 0)))
        (resume_with k p -5)
        (let a (nth args i)
          (match (proc_copy_in p buf (bytes_from_list a) 0 (min n (length a)))
            ((CopyInBad q) (resume_with k q -5))
            ((CopiedIn q) (resume_with k q (length a))))))))

; Module m started with the arguments p sends, as encode_args writes
; them: its pid, or err_too_big if they are over max_message bytes,
; err_fault if p may not give them or they are not arguments, or what
; spawn gives.
(def do_spawn_args ((k Kernel) (p Proc) (m int) (buf int) (len int)) Step
  (if (lt len 0) (resume_with k p (err_fault))
      (gt len (max_message)) (resume_with k p (err_too_big))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (match (decode_args b)
            ((None) (resume_with k q (err_fault)))
            ((Some args)
              (match (spawn k m (.pid q) (Some args) (proc_tty_port q))
                ((Spawned k2 pid) (spawn_answered k2 q pid)))))))))

; The len bytes at buf logged as a message of p's, at level: the number
; it was given, or err_fault for a level that is none, or a buffer p may
; not give, or err_too_big for more than log_text_max bytes. A newline in
; it, or at its end, makes no new line (log_clean).
(def do_log_write ((k Kernel) (p Proc) (level int) (buf int) (len int)) Step
  (if (not (log_level_ok level)) (resume_with k p (err_fault))
      (lt len 0) (resume_with k p (err_fault))
      (gt len (log_text_max)) (resume_with k p (err_too_big))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (resume_with (k_note k (.pid q) level (log_clean (bytes_to_list b))) q (.count (.log (.boot k))))))))

; How the CPUs are used, copied to buf: with pid 0 the system's
; cpu_record, else pid's proc_cpu_record, pid live or p itself; its
; length, or err_no_port for no such live process, err_too_big if it is
; over max, err_fault if p may not take it at buf.
(def do_cpu_usage ((k Kernel) (p Proc) (pid int) (buf int) (max int)) Step
  (if (eq pid 0) (give_record k p (usage_record (.usage (.cpus k)) (clock_ns)) buf max)
      (not (is_pid pid)) (resume_with k p (err_no_port))
      (or (eq pid (.pid p)) (eq (look k pid) (LookLive)))
      (give_record k p (usage_proc_record (.usage (.cpus k)) pid (cpus_where (.cpus k) pid) (clock_ns)) buf max)
      (resume_with k p (err_no_port))))

; The names registered from the i-th on, in order, as many whole
; name_records as max holds, copied to buf: their length, 0 past the
; last, or err_fault for an i below 0 or a buf p may not take them at,
; err_too_big for a max below 0.
(def do_name_list ((k Kernel) (p Proc) (i int) (buf int) (max int)) Step
  (if (lt i 0) (resume_with k p (err_fault))
      (lt max 0) (resume_with k p (err_too_big))
      (give_record k p (ipc_name_records (.ipc k) i max) buf max)))

; The messages of the log numbered seq or more, as many whole ones as max
; holds, copied to buf as klog.l0 lays them out: their length, 0 if
; there are none, or err_too_big for a max below 0, err_fault if p may
; not take them at buf.
(def do_log_read ((k Kernel) (p Proc) (seq int) (buf int) (max int)) Step
  (if (lt max 0)
      (resume_with k p (err_too_big))
      (give_record k p (klog_from (.log (.boot k)) seq max) buf max)))

; pid's record, then its program's path, copied to buf, as much as max
; holds: its length, or err_no_port if pid was never used, err_too_big
; if not even the record fits. The caller is the only process running,
; and is out of the table while it runs, so its own record is made from
; p. An exited process's has no path.
(def do_proc_info ((k Kernel) (p Proc) (pid int) (buf int) (max int)) Step
  (if (not (is_pid pid)) (resume_with k p (err_no_port))
      (eq pid (.pid p)) (give_cut k p (append (proc_info_record p (.mem k) true) (k_proc_path k p)) buf max)
      (match (record_of k pid)
        ((None) (resume_with k p (err_no_port)))
        ((Some r) (give_cut k p r buf max)))))

; The proc_info record of pid, a process in the table: a live one's,
; running if it is out on another CPU, then its path; an exited one's, state_exited and its status; or none,
; if pid's slot is Free or now holds another.
(def record_of ((k Kernel) (pid int)) (Option (list int))
  (if (not (k_current k pid))
      ((None (list int)))
      (match k
        ((Kernel slots ready ipc ss irqs boot next mem cpus)
          (match (array_get slots (slot_of pid))
            ((Free) ((None (list int))))
            ((Live q) (Some (append (proc_info_record q mem (cpus_out cpus pid)) (k_proc_path k q))))
            ((Dead g) (Some (proc_record (state_exited) 0 -1 (.status g) 0 0))))))))

; The frames processes have been given: each live process's own pages,
; p's among them, as it is out of the table while it runs, and every
; shared, DMA or shared image frame once. An exited process's were freed
; as it ended.
(def k_used_frames ((k Kernel) (p Proc)) int
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (used_from slots mem 0 (add (mem_shared_frames mem) (own_pages p mem))))))

; The mem_record mem_info gives p: the pages processes can have, those
; given and those the host has left (spec 6.13's frame_free_count) or
; the pool holds zeroed, and how many are given. The host's page tables
; take from what is left, so the total moves as they come and go, and
; grows once the initramfs's raw copy joins the pool.
(def k_mem_record ((k Kernel) (p Proc)) (list int)
  (let used (k_used_frames k p)
    (mem_record (add used (add (max 0 (frame_free_count)) (mem_pooled (.mem k)))) used)))

; n and the own pages of every live process from slot i on.
(def used_from ((slots (array Slot)) (mem Mem) (i int) (n int)) int
  (if (ge i (array_len slots))
      n
      (used_from slots mem (add i 1)
        (match (array_get slots i)
          ((Live q) (add n (own_pages q mem)))
          ((Free) n)
          ((Dead g) n)))))

; The pages p has of its own, which it alone maps, by what mem counts.
(def own_pages ((p Proc) (mem Mem)) int
  (match (proc_page_counts p mem) ((PageCounts own shared) own)))

; A record r copied to buf, as much of it as max holds past its first
; proc_record_len bytes, which must fit.
(def give_cut ((k Kernel) (p Proc) (r (list int)) (buf int) (max int)) Step
  (if (lt max (proc_record_len))
      (resume_with k p (err_too_big))
      (give_record k p (take r max) buf max)))

; A record r copied to buf whole: its length, or err_too_big if it is
; over max, err_fault if p may not take it at buf.
(def give_record ((k Kernel) (p Proc) (r (list int)) (buf int) (max int)) Step
  (if (gt (length r) max)
      (resume_with k p (err_too_big))
      (match (proc_copy_in p buf (bytes_from_list r) 0 (length r))
        ((CopyInBad q) (resume_with k q (err_fault)))
        ((CopiedIn q) (resume_with k q (length r))))))

; A new port that p owns: its number.
(def do_port_new ((k Kernel) (p Proc)) Step
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (ipc_port_new ipc (.pid p))
        ((NewPort port i2) (resume_with (Kernel slots ready i2 ss irqs boot next mem cpus) p port))))))

; Whether pid could name a process: one of its slot's turns.
(def is_pid ((pid int)) bool
  (and (not (lt pid 1)) (not (eq (slot_of pid) 0))))

; The pid slot i holds, live or exited, or last held; 0 if it never held
; one; err_no_port for no slot i.
(def do_proc_slot ((k Kernel) (p Proc) (i int)) Step
  (if (or (lt i 1) (gt i (max_procs)))
      (resume_with k p (err_no_port))
      (resume_with k p (k_pid_at k i))))

; Ends pid, any process but p itself, with killed_status. A driver, a
; program with a dev line, cannot be: the system needs its devices. One
; out on another CPU is marked, and ends when its thread comes back,
; within its slice; p is answered 0 at once.
(def do_kill ((k Kernel) (p Proc) (pid int)) Step
  (if (not (is_pid pid))
      (resume_with k p (err_no_port))
      (match (look k pid)
        ((LookFree) (resume_with k p (err_no_port)))
        ((LookDead st) (resume_with k p (err_no_port)))
        ((LookLive)
          (match (take_slot k pid)
            ((TakenSlot k2 s)
              (match s
                ((Live q)
                  (if (proc_dev k2 q) (resume_with (restore k2 q) p (err_denied))
                      (cpus_out (.cpus k2) pid)
                      (let k3 (restore k2 q) (resume_with (.cpus k3 (cpus_doom (.cpus k3) pid)) p 0))
                      (killed_by k2 p q)))
                ((Free) (resume_with (put_slot k2 pid (Free)) p (err_no_port)))
                ((Dead st) (resume_with (put_slot k2 pid (Dead st)) p (err_no_port))))))))))

; q ended by p, and p answered 0; or the system stopped, as when pid 1
; exits, if q is pid 1.
(def killed_by ((k Kernel) (p Proc) (q Proc)) Step
  (let k2 (end_proc k q (killed_status))
    (if (eq (.pid q) 1) (Halt (killed_status)) (resume_with k2 p 0))))

; Has port, which must be p's, told when pid exits: at once, if it has.
(def do_watch ((k Kernel) (p Proc) (pid int) (port int)) Step
  (if (or (not (is_pid pid)) (not (eq (ipc_owner (.ipc k) port) (.pid p))))
      (resume_with k p (err_no_port))
      (match (look k pid)
        ((LookFree) (resume_with k p (err_no_port)))
        ((LookDead st) (resume_with (mark_told (tell_exit k (cons port (nil int)) pid st) pid) p 0))
        ((LookLive)
          (match (take_slot k pid)
            ((TakenSlot k2 s)
              (match s
                ((Live q) (watch_live k2 p q port))
                ((Free) (resume_with (put_slot k2 pid (Free)) p (err_no_port)))
                ((Dead st) (resume_with (put_slot k2 pid (Dead st)) p (err_no_port))))))))))

; The rest of do_watch, for q live and out of its slot: port added to
; its watchers, unless it is one already: 0, or err_full if q has
; watch_limit watchers.
(def watch_live ((k Kernel) (p Proc) (q Proc) (port int)) Step
  (if (any_eq port (.watchers (.state q))) (resume_with (restore k q) p 0)
      (ge (length (.watchers (.state q))) (watch_limit)) (resume_with (restore k q) p (err_full))
      (resume_with (restore k (proc_watch q port)) p 0)))

; An entry's path as call 269 gives it: a directory's with a final /, so
; a caller can tell directories from files, and a program's followed by
; a NUL and x, so that a copy of it can be marked one too.
(def shown_path ((e Entry)) (list int)
  (if (and (entry_is_dir e) (not (eq (.path e) "/"))) (append (.path e) "/")
      (entry_is_exec e) (append (.path e) (cons 0 "x"))
      (.path e)))

; The name of module i, its shown_path, copied to buf if it fits in max:
; its length, or err_no_port if there is no module i or the initramfs
; has been given up, err_too_big if it does not fit, err_fault if p may
; not take it at buf.
(def do_module_name ((k Kernel) (p Proc) (i int) (buf int) (max int)) Step
  (if (or (not (is_entry k i)) (not (k_held k)))
      (resume_with k p (err_no_port))
      (let name (shown_path (k_entry k i))
        (if (gt (length name) max)
            (resume_with k p (err_too_big))
            (match (proc_copy_in p buf (bytes_from_list name) 0 (length name))
              ((CopyInBad q) (resume_with k q (err_fault)))
              ((CopiedIn q) (resume_with k q (length name))))))))

; How many bytes module i's contents are, 0 for a directory's: what a
; file manager shows of the initramfs's files; or err_no_port if there
; is no module i or the initramfs has been given up, as do_module_name
; answers.
(def do_entry_size ((k Kernel) (p Proc) (i int)) Step
  (if (or (not (is_entry k i)) (not (k_held k)))
      (resume_with k p (err_no_port))
      (resume_with k p (if (entry_is_dir (k_entry k i)) 0 (entry_size (k_entry k i))))))

; The len bytes at buf sent to port as from p: 0, or err_fault for a
; negative len or bytes p may not give, err_too_big for over
; max_message, or what k_send refuses.
(def do_send ((k Kernel) (p Proc) (port int) (buf int) (len int)) Step
  (if (lt len 0) (resume_with k p (err_fault))
      (gt len (max_message)) (resume_with k p (err_too_big))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (match (k_send k port (Msg (.pid q) b))
            ((KSent k2 code) (resume_with k2 q code)))))))

; The oldest message on port, p's, copied to buf, as try_take says; or,
; with none waiting, p waiting for one if wait, and err_taken at once if
; not; err_no_port if port is not p's.
(def do_receive ((k Kernel) (p Proc) (port int) (buf int) (max int) (wait bool)) Step
  (if (not (eq (ipc_owner (.ipc k) port) (.pid p)))
      (resume_with k p (err_no_port))
      (match (try_take k p port buf max)
        ((Took k2 q v) (resume_with k2 q v))
        ((NoMessage k2 q)
          (if wait
              (Park k2 (proc_set_state q (Receiving port buf max)))
              (resume_with k2 q (err_taken)))))))

; p's set of ports to wait on, the len bytes at buf, a u32 each, in place
; of any it had: 0; err_fault for a negative len or bytes p may not give;
; err_too_big for none, more than port_set_limit, or a len not a whole
; number of u32s; or ipc_set_ports' refusal, the set as it was.
(def do_port_set ((k Kernel) (p Proc) (buf int) (len int)) Step
  (if (lt len 0) (resume_with k p (err_fault))
      (or (lt len 4) (or (gt len (mul 4 (port_set_limit))) (not (eq (mod len 4) 0))))
      (resume_with k p (err_too_big))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (resume_with k q (err_fault)))
        ((CopiedOut q b)
          (match (k_registered k ipc_set_ports (.pid q) (u32s_of b 0 (nil int)))
            ((KRegistered code k1) (resume_with k1 q code)))))))

; The u32s of b from byte i on, in order, after the reversed acc.
(def u32s_of ((b bytes) (i int) (acc (list int))) (list int)
  (if (gt (add i 4) (bytes_len b))
      (rev acc)
      (u32s_of b (add i 4) (cons (le_u32 b i) acc))))

; The oldest message on any port of p's set copied to buf, as
; try_take_set says; or, with none waiting, p waiting for one if wait,
; and err_taken at once if not; err_no_port if p has no set.
(def do_receive_set ((k Kernel) (p Proc) (buf int) (max int) (wait bool)) Step
  (let n (length (ipc_set_of (.ipc k) (.pid p)))
    (if (eq n 0)
        (resume_with k p (err_no_port))
        (match (try_take_set k p buf max)
          ((Took k2 q v) (resume_with k2 q v))
          ((NoMessage k2 q)
            (if wait
                (Park k2 (proc_set_state q (ReceivingSet n buf max)))
                (resume_with k2 q (err_taken))))))))

; The name at buf unregistered, if a port of p's holds it: as
; ipc_unregister answers, or name_from's refusal.
(def do_unregister ((k Kernel) (p Proc) (buf int) (len int)) Step
  (match (name_from p buf len)
    ((NameBad q code) (resume_with k q code))
    ((Named q name)
      (match (k_registered k ipc_unregister (.pid q) name)
        ((KRegistered code k1) (resume_with k1 q code))))))

; A name, copied out of p, or why not.
(data Named (Named Proc (list int)) (NameBad Proc int))

; The name of len bytes p gives at buf: err_fault for a negative len or
; bytes p may not give, err_too_big for over 256.
(def name_from ((p Proc) (buf int) (len int)) Named
  (if (lt len 0) (NameBad p (err_fault))
      (gt len 256) (NameBad p (err_too_big))
      (match (proc_copy_out p buf len)
        ((CopyOutBad q) (NameBad q (err_fault)))
        ((CopiedOut q b) (Named q (bytes_to_list b))))))

; The name at buf registered for port, p's: as ipc_register answers, or
; name_from's refusal.
(def do_register ((k Kernel) (p Proc) (port int) (buf int) (len int)) Step
  (match (name_from p buf len)
    ((NameBad q code) (resume_with k q code))
    ((Named q name)
      (match k
        ((Kernel slots ready ipc ss irqs boot next mem cpus)
          (match (ipc_register ipc (.pid q) port name)
            ((Registered code i2) (resume_with (Kernel slots ready i2 ss irqs boot next mem cpus) q code))))))))

; The port registered as the name at buf, or err_no_port, or name_from's
; refusal.
(def do_lookup ((k Kernel) (p Proc) (buf int) (len int)) Step
  (match (name_from p buf len)
    ((NameBad q code) (resume_with k q code))
    ((Named q name) (resume_with k q (ipc_lookup (.ipc k) name)))))

; pid's exit status, as its wait_word: at once, and marked told, if it
; has exited; once it exits, p waiting, if it is live; err_no_port if
; there is no such process.
(def do_wait ((k Kernel) (p Proc) (pid int)) Step
  (if (not (is_pid pid))
      (resume_with k p (err_no_port))
      (match (look k pid)
        ((LookDead st) (resume_with (mark_told k pid) p (wait_word st)))
        ((LookLive) (Park k (proc_set_state p (Waiting pid))))
        ((LookFree) (resume_with k p (err_no_port))))))

; p asleep until t on the clock, then answered 0; at once if t has come.
(def do_sleep ((k Kernel) (p Proc) (t int)) Step
  (if (le t (clock_ns))
      (resume_with k p 0)
      (Park (.sleepers k (sleep_add (.sleepers k) t (.pid p)))
            (proc_set_state (proc_answer p 0) (Sleeping)))))

; The alarm for port, p's, set to send its notice at t on the clock, in
; place of any it had, or at once if t has come: 0, or err_no_port if the
; port is not p's.
(def do_alarm ((k Kernel) (p Proc) (port int) (t int)) Step
  (if (not (eq (ipc_owner (.ipc k) port) (.pid p)))
      (resume_with k p (err_no_port))
      (let k1 (.sleepers k (sleep_remove (.sleepers k) (alarm_key port)))
        (if (le t (clock_ns))
            (resume_with (alarm_sent k1 port) p 0)
            (resume_with (.sleepers k1 (sleep_add (.sleepers k1) t (alarm_key port))) p 0)))))

; The board restarted for p, as Shut Down stops it, with nothing told
; first: the restart logged, and then L0's board_reset, which drains the
; serial line and does not return where the board restarts, as on the Pi
; 5 and the aarch64 virt board. Where it returns, the board gives no way
; to restart it, and p is answered err_denied.
(def do_reboot ((k Kernel) (p Proc)) Step
  (let (k2 (k_note k 0 (log_info) (reboot_text (base_name (k_proc_path k p)) (.pid p))) r (board_reset))
    (resume_with (k_note k2 0 (log_warn) "l0s: this board cannot be restarted") p (err_denied))))

; What the kernel says as name, pid, restarts the board.
(def reboot_text ((name (list int)) (pid int)) (list int)
  (append "l0s: restarting the board, as " (append name (append " (pid " (append (digits pid) ") asked")))))

; Interrupt irq enabled and bound to port, p's, its notices sent there:
; 0, or err_denied if p may not drive devices or irq is below 1,
; err_no_port if port is not p's, err_taken if irq is bound already, or
; interrupt_enable's code.
(def do_irq_bind ((k Kernel) (p Proc) (irq int) (port int)) Step
  (if (or (not (proc_dev k p)) (lt irq 1)) (resume_with k p (err_denied))
      (not (eq (ipc_owner (.ipc k) port) (.pid p))) (resume_with k p (err_no_port))
      (match (k_irq k irq)
        ((Some b)
          (if (irq_owned b)
              (resume_with k p (err_taken))
              (match b
                ((Irq owner old taken)
                  (let d (if taken (interrupt_done irq) 0)
                    (resume_with (with_irq k irq (Irq (.pid p) port false)) p 0))))))
        ((None)
          (let r (interrupt_enable irq)
            (if (lt r 0)
                (resume_with k p r)
                (resume_with (with_irq k irq (Irq (.pid p) port false)) p 0)))))))

; Interrupt irq, taken and bound by p, ended, so it can come again: 0,
; or err_no_port if it is not p's or not taken.
(def do_irq_ack ((k Kernel) (p Proc) (irq int)) Step
  (match (k_irq k irq)
    ((None) (resume_with k p (err_no_port)))
    ((Some b)
      (match b
        ((Irq owner port taken)
          (if (and (eq owner (.pid p)) taken)
              (let d (interrupt_done irq)
                (resume_with (with_irq k irq (Irq owner port false)) p 0))
              (resume_with k p (err_no_port))))))))

; ------------------------------------------------------------------ traps

; What follows p's trap t: a call dispatched; a page touched that is not
; mapped, mapped on demand, or p killed if it may not be; a fault, p
; killed; the timer, p's slice over; a device's interrupt, its notice
; sent, and p parked. The pool of zeroed frames is given back first if
; frames are running short (k_pool_kept).
(def on_trap ((k0 Kernel) (p Proc) (t Trap)) Step
  (let k (k_pool_kept k0)
  (match t
    ((TrapCall n) (dispatch k p (proc_decode p n)))
    ((TrapMissing va)
      (match (proc_demand p va)
        ((Paged q) (Resume k q))
        ((PageRefused q) (kill k q (append "no memory at 0x" (hex_digits va 0))))))
    ((TrapFault esr far)
      (kill k p (append "fault at 0x" (append (hex_digits far 0) (append ", syndrome 0x" (hex_digits esr 0))))))
    ((TrapInterrupt n)
      (if (eq n 0)
          (let (a (timer_at -1) d (interrupt_done 0)) (Park k p))
          (Park (device_irq k n) p))))))

; k with its pool of zeroed frames given back, each frame freed, once
; fewer frames are left than the pool's floor (memory.l0's
; pool_released), so that the pool never holds what a process needs.
(def k_pool_kept ((k Kernel)) Kernel
  (if (pool_released (mem_pooled (.mem k)) (frame_free_count))
      (match (mem_pool_drain (.mem k))
        ((PoolDrained m2 fs) (let f (free_frames fs) (.mem k m2))))
      k))

; Whether k has frames to make for its pool while it is idle: only with
; pool_heap_room past its heap's reserve, so that on a small heap the
; pool is never made, and what runs out first, and is refused, is as it
; would be without one (test_heap_runs_low).
(def k_pool_wants ((k Kernel)) bool
  (and (ge (heap_left) (add (heap_reserve) (pool_heap_room)))
       (gt (pool_wanted (mem_pooled (.mem k)) (frame_free_count)) 0)))

; The heap past its reserve the pool is made with: 32 MB.
(def pool_heap_room () int 33554432)

; k with a chunk of zeroed frames made for its pool, as many as
; pool_wanted says, or fewer if the host runs out.
(def k_pool_filled ((k Kernel)) Kernel
  (let fs (frames_made (pool_wanted (mem_pooled (.mem k)) (frame_free_count)) (nil int))
    (.mem k (mem_pool_put (.mem k) fs (length fs)))))

; n zeroed frames made onto acc, or as many as the host had.
(def frames_made ((n int) (acc (list int))) (list int)
  (if (le n 0)
      acc
      (let f (frame_new)
        (if (lt f 0) acc (frames_made (sub n 1) (cons f acc))))))

; Interrupt n, taken: a notice to the port it is bound to, and taken until
; its driver acks it; or, its driver gone or none ever, held taken until
; one binds it (Irq), not ended to come again at once.
(def device_irq ((k Kernel) (n int)) Kernel
  (match (k_irq k n)
    ((None) (with_irq k n (Irq 0 -1 true)))
    ((Some b)
      (match b
        ((Irq owner port taken)
          (if (not (irq_owned b))
              (with_irq k n (Irq 0 -1 true))
          (match (k_send (with_irq k n (Irq owner port true)) port (Msg 0 (bytes_from_list (irq_notice n))))
            ((KSent k2 code) k2))))))))

; ------------------------------------------------------------------- loop

; Runs the next ready process, or waits for something to make one ready,
; until pid 1 exits; and returns its status.
; Its run counts from when it was picked (step).
(def schedule ((k Kernel)) int
  (if (cpus_many (.cpus k))
      (many_schedule k)
      (let now (clock_ns)
        (match (take_ready (k_tick (wake_sleepers k now) now))
          ((Picked k2 p)
            (let t (timer_at (slice_deadline (.sleepers k2) now))
              (run_proc k2 p now)))
          ((NonePicked k2) (idle k2))))))

; The next process to run, taken out of the table, or none ready.
(data Picked (Picked Kernel Proc) (NonePicked Kernel))

; The first pid on the ready queue whose process is live and ready, and
; not out on another CPU: one that is not, or has gone, is dropped from
; the queue.
(def take_ready ((k Kernel)) Picked
  (match k
    ((Kernel slots ready ipc ss irqs boot next mem cpus)
      (match (queue_pop ready)
        ((PopEmpty) (NonePicked (Kernel slots (Queue (nil int) (nil int)) ipc ss irqs boot next mem cpus)))
        ((Popped pid rest)
          (match (take_slot (Kernel slots rest ipc ss irqs boot next mem cpus) pid)
            ((TakenSlot k2 s)
              (match s
                ((Live p)
                  (if (and (is_ready (proc_state p)) (not (cpus_out (.cpus k2) pid)))
                      (Picked k2 p)
                      (take_ready (restore k2 p))))
                ((Free) (take_ready (put_slot k2 pid (Free))))
                ((Dead st) (take_ready (put_slot k2 pid (Dead st))))))))))))

; p run until it traps, and on from there: the status pid 1 exits with.
; It was picked to run at since.
(def run_proc ((k Kernel) (p Proc) (since int)) int
  (match p
    ((Proc pid m s c pages dev st)
      (let (r (user_run (.id s) c) t (trap_of r))
        (step (on_trap k (Proc pid m s r pages dev st) t) pid since)))))

; Carrying on after s, for pid, picked to run at since: the same process
; run again, or the next one scheduled, pid's run from since counted as
; on CPU 0, its calls included, with one look at the clock, not one a
; trap; or the status the system stops with. A pid that ended meanwhile
; is counted too, in a slot its next process starts afresh.
(def step ((s Step) (pid int) (since int)) int
  (match s
    ((Resume k p) (run_proc k p since))
    ((Park k p) (schedule (park (k_charge k pid 0 since) p)))
    ((Next k) (schedule (k_charge k pid 0 since)))
    ((Halt status) status)))

; Nothing is ready: wait for the timer, for the soonest sleeper or the
; load's tick, or a device, unless nothing could ever come; the wait
; counted as CPU 0's.
(def idle ((k Kernel)) int
  (if (and (is_empty (.sleepers k)) (eq (k_irq_count k) 0))
      (stuck k "l0s: deadlock: every process waits for something that cannot happen")
      (k_pool_wants k) (schedule (k_pool_filled k))
      (let (t (timer_at (k_wake_at k))
            t0 (clock_ns)
            n (interrupt_wait)
            k1 (k_waited k t0))
        (if (eq n 0) (let (a (timer_at -1) d (interrupt_done 0)) (schedule k1))
            (gt n 0) (schedule (device_irq k1 n))
            (stuck k1 "l0s: no interrupt can come")))))

; why logged as an error, and 124, the status the system stops with when
; nothing can ever run again.
(def stuck ((k Kernel) (why (list int))) int
  (let k2 (k_note k 0 (log_error) why) 124))

; ------------------------------------------------------------- other CPUs
;
; With more than one CPU (spec 6.18), CPU 0 is the kernel, and hands the
; others their threads. Each pass takes back every thread they hold that
; has trapped, and handles the traps together; then wakes the sleepers
; due, hands the ready processes to the CPUs that have room, and waits for
; the next trap or interrupt. The traps come back through the runtime's
; rings in memory, with no interrupt between CPUs. A brief thread, one
; passing messages, CPU 0 runs itself between passes (cpus_keeps), as on
; one CPU, since a call there costs less than a hand-off and back.

; One pass of CPU 0's loop, as above, until pid 1 exits; and its status.
(def many_schedule ((k Kernel)) int
  (if (cpus_busy (.cpus k))
      (let a (cpu_trapped)
        (if (eq (array_len a) 0)
            (many_fill (k_woken k))
            (many_back k (cpu_trapped_of a))))
      (many_fill (k_woken k))))

; k with the sleepers due woken, and the load sampled if its tick is.
(def k_woken ((k Kernel)) Kernel
  (let now (clock_ns) (k_tick (wake_sleepers k now) now)))

; The thread t taken back: its process, out of the table, given the
; context it came back with, and on as many_trap says; or, if the kernel
; handed no such pid out, nothing.
(def many_back ((k Kernel) (t CpuTrapped)) int
  (match t
    ((CpuTrapped ctx cpu pid)
      (match (k_cpus_back k pid (clock_ns))
        ((KNotOut k1) (many_schedule k1))
        ((KBack k1 on)
          (match (take_slot k1 pid)
            ((TakenSlot k2 s)
              (match s
                ((Live p) (many_trap k2 (.context p ctx) on))
                ((Free) (many_schedule (put_slot k2 pid (Free))))
                ((Dead st) (many_schedule (put_slot k2 pid (Dead st))))))))))))

; p back from the CPU on says, after its trap: ended, if it was killed
; while out; its slice over, and parked, if that CPU's timer ended it,
; an interrupt that CPU took and ended itself, so CPU 0 ends none; and
; otherwise handled as on one CPU.
(def many_trap ((k Kernel) (p Proc) (on OnCpu)) int
  (if (.doomed on)
      (let n (cpus_out_count (.cpus k)) (many_step (killed_out k p) on n))
      (let t (trap_of (.context p))
        (if (trap_is_interrupt t)
            (many_schedule (park k p))
            (let n (cpus_out_count (.cpus k)) (many_step (on_trap k p t) on n))))))

; status, the system's, once the n threads out on other CPUs have come
; back, each at its trap or its slice's end, and been taken back: so a
; kernel that stops leaves no thread running for the next boot to take
; back as its own, as the board tests boot the kernel again and again in
; one program.
(def many_halt ((n int) (status int)) int
  (if (le n 0)
      status
      (let a (cpu_trapped)
        (if (eq (array_len a) 0)
            (let w (cpu_wait) (many_halt n status))
            (many_halt (sub n 1) status)))))

; Whether t is an interrupt's, not a call's or a fault's.
(def trap_is_interrupt ((t Trap)) bool
  (match t
    ((TrapCall n) false)
    ((TrapMissing va) false)
    ((TrapFault esr far) false)
    ((TrapInterrupt n) true)))

; p, killed while out on another CPU, ended now it is back; or the system
; stopped, if p is pid 1, as killed_by does.
(def killed_out ((k Kernel) (p Proc)) Step
  (let k2 (end_proc k p (killed_status))
    (if (eq (.pid p) 1) (Halt (killed_status)) (Next k2))))

; Carrying on after s, for a thread that ran where on says: one that goes
; on as many_go says, with what is left of its slice; then on with the
; pass; or the status the system stops with, once the n threads out on
; other CPUs as the trap came are back (many_halt).
(def many_step ((s Step) (on OnCpu) (n int)) int
  (match s
    ((Resume k p) (many_go k p (.cpu on) (Turn (.deadline on) -1 0)))
    ((Park k p) (many_schedule (park k p)))
    ((Next k) (many_schedule k))
    ((Halt status) (many_halt n status))))

; A process's time to run: the end of its slice, then, for a turn on CPU
; 0, the turn's end, which CPU 0's timer is set to, and when it began; or
; -1 and 0 if it has no turn there yet.
(data Turn (Turn int int int))

; p, which goes on, in its turn: put on the ready queue if its slice or
; its turn on CPU 0 is over; run on CPU 0 if cpus_here says, once the
; ready processes that are not brief are handed out (many_spread), unless
; another CPU's thread has trapped meanwhile, which is taken back first,
; p queued; or else handed to a CPU with room, prefer first, or queued if
; none has.
(def many_go ((k Kernel) (p Proc) (prefer int) (turn Turn)) int
  (match turn
    ((Turn deadline own start)
      (let now (clock_ns)
        (if (or (ge now deadline) (and (ge own 0) (ge now own)))
            (many_schedule (park (k_turn_over k (.pid p) turn) p))
            (k_here k (.pid p))
            (let (k2 (many_spread_some k) a (cpu_trapped))
              (if (eq (array_len a) 0)
                  (if (lt own 0) (many_own_turn k2 p deadline) (many_own k2 p turn))
                  (many_back (park (k_turn_over k2 (.pid p) turn) p) (cpu_trapped_of a))))
            (let (i (cpus_pick (.cpus k) prefer now) k1 (k_turn_over k (.pid p) turn))
              (if (eq i 0)
                  (many_schedule (park k1 p))
                  (match (many_hand k1 p i deadline) ((Handed k2 ok) (many_schedule k2))))))))))

; k with pid's turn on CPU 0 counted, from its start to now, if it had
; one (own not -1); else k. A turn's calls are counted as its.
(def k_turn_over ((k Kernel) (pid int) (turn Turn)) Kernel
  (match turn ((Turn deadline own start) (if (lt own 0) k (k_charge k pid 0 start)))))

; k with a run of t ns by pid's thread on CPU 0 kept, if it is news
; (cpus_run_news); else k itself, rebuilt not at all.
(def k_ran ((k Kernel) (pid int) (t int)) Kernel
  (if (cpus_run_news (.cpus k) pid t) (.cpus k (cpus_ran (.cpus k) pid t)) k))

; p given a turn on CPU 0 from now, CPU 0's timer set to its end, as
; cpus_own_deadline says, its slice's end at deadline at the latest; and
; run there.
(def many_own_turn ((k Kernel) (p Proc) (deadline int)) int
  (let (now (clock_ns)
        own (cpus_own_deadline now deadline (soonest (.sleepers k)))
        t (timer_at own))
    (many_own k p (Turn deadline own now))))

; p run on CPU 0 itself, in its turn there, until it traps, or CPU 0's
; timer ends the turn; and on from there as many_own_step says. Nothing
; else is looked at or kept for a run that traps of itself, as on one
; CPU: each look at the clock or the kernel's record costs on QEMU, and
; a process passing messages runs thousands of times a second. Only a
; turn the timer ended says how long p ran, all the turn's runs together
; (k_ran): one of cpus_keep_ns or more, and p is handed out next if
; another process waits for CPU 0. The timer is set once a turn, not
; before each run: setting it costs a few µs on QEMU.
(def many_own ((k Kernel) (p Proc) (turn Turn)) int
  (match p
    ((Proc pid m s c pages dev st)
      (let (r (user_run (.id s) c) t (trap_of r) n (cpus_out_count (.cpus k)))
        (many_own_step (on_trap (many_timed k pid t turn) (Proc pid m s r pages dev st) t) turn n pid)))))

; k with how long pid ran in its turn kept, if t, its trap, is the
; timer's, which ended it; else k.
(def many_timed ((k Kernel) (pid int) (t Trap) (turn Turn)) Kernel
  (match t
    ((TrapInterrupt n)
      (if (eq n 0) (match turn ((Turn deadline own start) (k_ran k pid (sub (clock_ns) start)))) k))
    ((TrapCall n) k)
    ((TrapMissing va) k)
    ((TrapFault esr far) k)))

; Carrying on after s, for a thread CPU 0 ran itself in its turn: run
; again at once if no CPU holds a thread, as on one CPU, since none can
; have trapped meanwhile; else as many_go says, CPU 0 preferred by none;
; or on with the pass; or the status the system stops with, once the n
; threads out on other CPUs are back (many_halt). n is counted before the
; trap is handled, not the kernel kept to count it after: a value that
; still holds the kernel's record while on_trap rebuilds it makes every
; change copy the record's arrays whole, which cost t-ping 0.3 s. A run
; the timer ended was parked by on_trap, its interrupt ended. A process
; woken meanwhile that would be handed out waits for p to stop, or its
; turn to end: each look at the ready queue costs a µs or more, and p may
; make thousands of calls. pid is p's: a turn that ends is counted as
; its (k_turn_over), with one look at the clock.
(def many_own_step ((s Step) (turn Turn) (n int) (pid int)) int
  (match s
    ((Resume k p)
      (if (cpus_busy (.cpus k))
          (many_go k p 0 turn)
          (many_own k p turn)))
    ((Park k p) (many_schedule (park (k_turn_over k pid turn) p)))
    ((Next k) (many_schedule (k_turn_over k pid turn)))
    ((Halt status) (many_halt n status))))

; k after handing p's thread to a CPU, back in its slot, and whether the
; CPU took it; if it had no room after all, p parked instead.
(data Handed (Handed Kernel bool))

; p's thread handed to CPU i, to run until it traps or deadline, as
; Handed says.
(def many_hand ((k Kernel) (p Proc) (i int) (deadline int)) Handed
  (match p
    ((Proc pid m s c pages dev st)
      (if (eq (cpu_run i (.id s) c deadline pid) 0)
          (let k1 (restore k (Proc pid m s c pages dev st))
            (Handed (.cpus k1 (cpus_place (.cpus k1) i pid deadline (clock_ns))) true))
          (Handed (park k (Proc pid m s c pages dev st)) false)))))

; The ready processes, each with a slice of its own: the first that
; cpus_here keeps run on CPU 0, and every other handed to a CPU with
; room, those before it as cpus_here says and those after it all
; (many_spread_all), so that processes ready together run together; then
; a wait. Each pid on the queue as the pass began is looked at once, so
; one behind others no CPU has room for still runs.
(def many_fill ((k Kernel)) int
  (many_fill_from k (k_ready_count k)))

; k after many_spread over its whole ready queue, if k_spreads says one
; would be handed out; else k, at no cost, as it is between most of a
; brief thread's calls: taking each pid off the queue and putting it
; back costs several µs on QEMU, more than the call.
(def many_spread_some ((k Kernel)) Kernel
  (if (k_spreads k) (many_spread k (k_ready_count k)) k))

; k with the ready processes that are not brief handed to the CPUs with
; room, each with a slice of its own, n pids of the queue looked at; the
; rest queued again in the order they were. So a process woken to compute
; starts on another CPU at once, not once CPU 0's own run ends.
(def many_spread ((k Kernel) (n int)) Kernel
  (if (le n 0)
      k
      (match (take_ready k)
        ((NonePicked k2) k2)
        ((Picked k2 p)
          (if (cpus_keeps (.cpus k2) (.pid p))
              (many_spread (park k2 p) (sub n 1))
              (let i (cpus_pick (.cpus k2) 0 (clock_ns))
                (if (eq i 0)
                    (many_spread (park k2 p) (sub n 1))
                    (match (many_hand k2 p i (add (clock_ns) (slice_ns)))
                      ((Handed k3 ok) (many_spread k3 (sub n 1)))))))))))

; The rest of many_fill, n pids of the queue left to look at.
(def many_fill_from ((k Kernel) (n int)) int
  (if (le n 0)
      (many_idle k)
      (match (take_ready k)
        ((NonePicked k2) (many_idle k2))
        ((Picked k2 p)
          (if (k_here k2 (.pid p))
              (many_own_turn (many_spread_rest k2) p (add (clock_ns) (slice_ns)))
              (let i (cpus_pick (.cpus k2) 0 (clock_ns))
                (if (eq i 0)
                    (many_fill_from (park k2 p) (sub n 1))
                    (match (many_hand k2 p i (add (clock_ns) (slice_ns)))
                      ((Handed k3 ok) (if ok (many_fill_from k3 (sub n 1)) (many_idle k3)))))))))))

; k with every process on its ready queue handed to a CPU with room, if
; any is ready and any has room, as many_spread_all does; else k.
(def many_spread_rest ((k Kernel)) Kernel
  (if (k_waiting k)
      (if (cpus_room (.cpus k)) (many_spread_all k (k_ready_count k)) k)
      k))

; k with each of n pids of its ready queue handed to a CPU with room, by
; cpus_pick, brief or not, each with a slice of its own; those no CPU has
; room for queued again in the order they were.
(def many_spread_all ((k Kernel) (n int)) Kernel
  (if (le n 0)
      k
      (match (take_ready k)
        ((NonePicked k2) k2)
        ((Picked k2 p)
          (let i (cpus_pick (.cpus k2) 0 (clock_ns))
            (if (eq i 0)
                (many_spread_all (park k2 p) (sub n 1))
                (match (many_hand k2 p i (add (clock_ns) (slice_ns)))
                  ((Handed k3 ok) (many_spread_all k3 (sub n 1))))))))))

; Nothing more to hand out: wait for a CPU's trap, the timer for the
; soonest sleeper or the load's tick, or a device, unless nothing could
; ever come; the wait counted as CPU 0's.
(def many_idle ((k Kernel)) int
  (if (and (not (cpus_busy (.cpus k))) (and (is_empty (.sleepers k)) (eq (k_irq_count k) 0)))
      (stuck k "l0s: deadlock: every process waits for something that cannot happen")
      (k_pool_wants k) (many_schedule (k_pool_filled k))
      (let (t (timer_at (k_wake_at k))
            t0 (clock_ns)
            n (cpu_wait)
            k1 (k_waited k t0))
        (if (eq n -1) (many_schedule k1)
            (eq n 0) (let (a (timer_at -1) d (interrupt_done 0)) (many_schedule k1))
            (gt n 0) (many_schedule (device_irq k1 n))
            (stuck k1 "l0s: no interrupt can come")))))

; ------------------------------------------------------------------- boot

; Each start line of the inittab, in order: the first is pid 1.
(def start_all ((k Kernel) (ls (list Launch))) Kernel
  (if (is_empty ls)
      k
      (match (head ls)
        ((Launch e args)
          (match (spawn k e 0 args 0)
            ((Spawned k2 pid)
              (if (lt pid 0)
                  (start_all (k_note k2 0 (log_error) (append "l0s: cannot start " (append (.path (k_entry k2 e)) (append ": " (digits pid))))) (tail ls))
                  (start_all (k_note k2 0 (log_debug) (append "l0s: pid " (append (digits pid) (append ": " (.path (k_entry k2 e)))))) (tail ls)))))))))

; why written to standard error as the kernel's, "l0s: WHY"; 1, the
; status to stop with.
(def complain ((why (list int))) int
  (let w (write_err (append "l0s: " (append why "\n"))) 1))

; Boots the initramfs in input as its /etc/inittab says, and runs it
; until pid 1 exits.
(def boot ((input bytes)) int
  (match (parse_initramfs input)
    ((Err why) (complain why))
    ((Ok es)
      (let t (entry_index es (inittab_path))
        (if (or (lt t 0) (not (entry_is_file (array_get es t))))
            (complain "initramfs: no /etc/inittab")
            (match (parse_inittab (bytes_range input (.start (array_get es t)) (.end (array_get es t))))
              ((Err why) (complain why))
              ((Ok init)
                (match (resolve_init init es)
                  ((Err why) (complain why))
                  ((Ok config) (boot_config input es config))))))))))

; The CPU's name, for the first line of boot: what (machine) says.
(def cpu_name ((m int)) (list int)
  (if (eq m 1) "aarch64" (eq m 2) "riscv64" "an unknown CPU"))

; The lines the kernel logs as it boots, each "l0s: ...": the CPU and
; the boot arguments args, the pages of memory free, how many CPUs, n,
; and which run processes, how processes' memory is laid out, the
; kernel's limits, and the initramfs, of size bytes and entries entries,
; with starts programs to start. All of it is what the kernel can learn:
; L0 has no builtin for the board's RAM, its image, its timer or its
; interrupt controller.
(def banner_lines ((m int) (args (list (list int))) (free int) (n int) (size int) (entries int) (starts int)) (list (list int))
  (cons (append "l0s: " (append (cpu_name m) (boot_arguments_text args)))
  (cons (memory_text free)
  (cons (cpus_text n)
  (cons (append "l0s: processes: images and heaps from 0x" (append (hex_digits (user_base) 0)
          (append " to 0x" (append (hex_digits (heap_limit) 0)
            (append ", stacks below 0x" (append (hex_digits (stack_top) 0)
              (append ", device, DMA and shared pages from 0x" (append (hex_digits (dev_base) 0)
                (append " to 0x" (hex_digits (dev_limit) 0))))))))))
  (cons (append "l0s: limits: " (append (digits (max_procs)) (append " processes, " (append (digits (div (slice_ns) 1000000))
          (append " ms slices, ports of " (append (digits (queue_limit)) (append " messages of up to " (append (digits (max_message)) " bytes"))))))))
  (cons (append "l0s: initramfs: " (append (format_size size) (append ", " (append (digits entries)
          (append " entries, " (append (digits starts) " programs to start"))))))
  (nil (list int)))))))))

; The boot line for n CPUs: "l0s: 1 CPU, running every process", or
; "l0s: N CPUs: the kernel and brief processes on CPU 0, the rest on
; CPUs 1 to N-1".
(def cpus_text ((n int)) (list int)
  (if (le n 1)
      "l0s: 1 CPU, running every process"
      (append "l0s: " (append (digits n) (append " CPUs: the kernel and brief processes on CPU 0, the rest on CPUs 1 to " (digits (sub n 1)))))))

; ", booted with ARGS" for boot arguments, or ", booted with no arguments".
(def boot_arguments_text ((args (list (list int)))) (list int)
  (if (is_empty args)
      ", booted with no arguments"
      (append ", booted with " (unwords args))))

; The line about memory: the pages free, and their size; nothing known
; where the host has no user mode (-3).
(def memory_text ((free int)) (list int)
  (if (lt free 0)
      "l0s: memory: no user mode"
      (append "l0s: memory: " (append (digits free) (append " pages free, " (format_size (mul free 4096)))))))

; k with each line logged by the kernel at info.
(def k_notes ((k Kernel) (lines (list (list int)))) Kernel
  (if (is_empty lines)
      k
      (k_notes (k_note k 0 (log_info) (head lines)) (tail lines))))

; The rest of boot, the inittab resolved as config: the timer's interrupt
; enabled, the board described, every start line started, and the loop
; run if pid 1 is live; pid 1's status if it has exited already, or 1 if
; nothing started.
(def boot_config ((input bytes) (es (array Entry)) (config Config)) int
  (match config
    ((Config launches devs defaults stdin)
      (let (e (interrupt_enable 0)
            k (start_all (k_notes (kernel_new input es config)
                          (banner_lines (machine) (boot_args) (frame_free_count) (cpu_count) (bytes_len input) (array_len es) (length launches)))
                        launches))
        (match (look k 1)
          ((LookLive) (schedule k))
          ((LookFree) (complain "nothing could be started"))
          ((LookDead st) st))))))

; The kernel's first act: on a board with RP1, its Ethernet stopped from
; writing to memory before any is given (rp1.l0), and said so; then
; kernel_main.
(def kernel_start () int
  (let (ncr (rp1_quiet) w (if (ge ncr 0) (k_echo (log_info) (rp1_quiet_text ncr)) 0))
    (kernel_main)))

; The kernel's main: the initramfs read from standard input, as l0 boot
; gives it, and booted; 1 if it cannot be read.
(def kernel_main () int
  (match (read_input)
    ((IoReadFailed code) (complain (append "reading the initramfs: " (io_error code))))
    ((IoBytes input) (boot input))))
