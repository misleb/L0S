; kernel_virt_test.l0 -- the kernel run on the board, with threads of a
; few instructions each: l0 test --target virt. Each test runs the
; kernel's own boot on an initramfs, built by asm.l0's raw_initramfs, and
; checks the status pid 1 exits with.

(def test_exit_status () int
  (check_int "exit 7" (boot_words 0 (cons (movz 0 7) (exit_x0))) 7))

; A store to the heap faults, and the kernel maps a zeroed page there.
(def test_heap_on_demand () int
  (check_int "stored and loaded"
    (boot_words 0 (cons (movz_hi 1 49216) (cons (movz 0 9) (cons (str_x0_x1) (cons (movz 0 0) (cons (ldr_x0_x1) (exit_x0)))))))
    9))

(def test_stack_on_demand () int
  (check_int "pushed" (boot_words 0 (cons (push_x0) (cons (movz 0 5) (exit_x0)))) 5))

; A load below the user range: the kernel kills the thread, and status 139.
(def test_fault_kills () int
  (check_int "killed" (boot_words 0 (cons (movz 1 16) (cons (ldr_x0_x1) (exit_x0)))) 139))

(def test_bad_buffer () int
  (check_int "write from 0x10"
    (boot_words 0 (cons (movz 0 1) (cons (movz 1 16) (cons (movz 2 5) (append (call_words 2) (exit_x0))))))
    -5))

(def test_device_buffer () int
  (check_int "write from a device page"
    (boot_words 0 (cons (movz 0 1) (cons (movz_hi 1 59392) (cons (movz 2 1) (append (call_words 2) (exit_x0))))))
    -5))

(def test_write_other_stream () int
  (check_int "stream 7"
    (boot_words 0 (cons (movz 0 7) (cons (movz_hi 1 49152) (cons (movz 2 1) (append (call_words 2) (exit_x0))))))
    -5))

(def test_write_nothing () int
  (check_int "zero bytes"
    (boot_words 0 (cons (movz 0 1) (cons (movz_hi 1 49152) (cons (movz 2 0) (append (call_words 2) (exit_x0))))))
    0))

(def test_unknown_call () int
  (check_int "call 99" (boot_words 0 (append (call_words 99) (exit_x0))) -5))

(def test_open_no_files () int
  (check_int "open to read" (boot_words 0 (cons (movz 2 1) (append (call_words 4) (exit_x0)))) -3))

; The PL031's registers, 0x09010000, mapped above 0xE8000000.
(def region_words () (list int)
  (cons (movz_hi 0 2305) (cons (movz 1 4096) (append (call_words 10) (exit_x0)))))

(def test_region_denied () int
  (check_int "nodev" (boot_words 0 (region_words)) -3))

(def test_region_dev () int
  (check_int "dev" (boot_words (flag_dev) (region_words)) (stack_top)))

; The PL031's region, then unregion of len bytes at what it gave, kept
; in x19, then words.
(def unregion_words ((len int) (ws (list int))) (list int)
  (cons (movz_hi 0 2305) (cons (movz 1 4096) (append (call_words 10)
    (cons (mov_x19_x0) (cons (mov_x0_x19) (cons (movz 1 len) (append (call_words 13) ws))))))))

; The region's page is given back, so the same range opened again is
; mapped where the first was.
(def test_unregion_reused () int
  (check_int "the same page again"
    (boot_words (flag_dev) (unregion_words 4096 (cons (movz_hi 0 2305) (cons (movz 1 4096) (append (call_words 10) (exit_x0))))))
    (stack_top)))

; Unregion answers 0, of a region's whole length or not.
(def test_unregion_answer () int
  (add (check_int "the region" (boot_words (flag_dev) (unregion_words 4096 (exit_x0))) 0)
       (check_int "nothing there" (boot_words 0 (cons (movz 0 0) (cons (movz 1 1) (append (call_words 13) (exit_x0))))) 0)))

; A region's pages unmapped: a read of one faults, so the process is
; killed, status 139, as test_fault_kills is, not the 7 it would exit
; with.
(def test_unregion_unmapped () int
  (check_int "faulted"
    (boot_words (flag_dev) (unregion_words 4096 (cons (mov_x1_x19) (cons (ldr_x0_x1) (cons (movz 0 7) (exit_x0))))))
    139))

; A region over a DMA page mapped nothing, so unregion gives nothing
; back: the next DMA page comes after it.
(def test_unregion_dma () int
  (check_int "past the first"
    (boot_words (flag_dev) (dma_words 1 (cons (mov_x0_x19) (cons (movz 1 4096) (append (call_words 10)
      (cons (mov_x0_x19) (cons (movz 1 4096) (append (call_words 13)
        (cons (movz 0 1) (append (call_words (call_dma_alloc)) (exit_x0)))))))))))
    (add (stack_top) 4096)))

; --------------------------------------------------------------------- DMA

; dma_alloc of n pages, then words, with the first page's address in x19.
(def dma_words ((n int) (ws (list int))) (list int)
  (cons (movz 0 n) (append (call_words (call_dma_alloc)) (cons (mov_x19_x0) ws))))

(def test_dma_denied () int
  (check_int "nodev" (boot_words 0 (dma_words 1 (cons (mov_x0_x19) (exit_x0)))) (err_denied)))

(def test_dma_alloc () int
  (check_int "at the first device page" (boot_words (flag_dev) (dma_words 2 (cons (mov_x0_x19) (exit_x0)))) (stack_top)))

(def test_dma_alloc_none () int
  (check_int "0 pages" (boot_words (flag_dev) (dma_words 0 (cons (mov_x0_x19) (exit_x0)))) (err_too_big)))

; The address of the page x19 plus off, which is below 4096 twice over.
(def dma_address_words ((off int)) (list int)
  (cons (add_imm 0 19 (div off 2)) (cons (add_imm 0 0 (sub off (div off 2)))
    (append (call_words (call_dma_address)) (exit_x0)))))

; Whether a is a page of the board's frame windows (spec 10.3): past the
; image up to the heap, 0x40080000 to 0x58000000, or past the heap up to
; the stack, 0x98000000 to 0xB0000000.
(def in_frame_pool ((a int)) int
  (add (check_int "page aligned" (mod a 4096) 0)
       (check_true "in the frame pool"
         (if (if (ge a 1074266112) (lt a 1476395008) false)
             true
             (if (ge a 2550136832) (lt a 2952790016) false)))))

(def test_dma_address () int
  (in_frame_pool (boot_words (flag_dev) (dma_words 2 (dma_address_words 16)))))

(def test_dma_address_per_page () int
  (let a (boot_words (flag_dev) (dma_words 2 (dma_address_words 0)))
    (let b (boot_words (flag_dev) (dma_words 2 (dma_address_words 4096)))
      (add (in_frame_pool b) (check_true "another frame" (not (eq a b)))))))

(def test_dma_address_heap () int
  (check_int "not DMA"
    (boot_words (flag_dev) (cons (movz_hi 0 49216) (append (call_words (call_dma_address)) (exit_x0))))   ; 0xC0400000
    (err_no_port)))

(def test_dma_address_past () int
  (check_int "past the pages" (boot_words (flag_dev) (dma_words 1 (dma_address_words 4096))) (err_no_port)))

; dma_addresses from va, the pages' addresses written into the heap at
; 0xC0400000 with room for max bytes, then an exit with the count, or as
; load says.
(def dma_addresses_at ((va (list int)) (max int) (load (list int))) (list int)
  (append va (cons (movz_hi 1 49216) (cons (movz 2 max)
    (append (call_words (call_dma_addresses)) (append load (exit_x0)))))))

; The same from x19, the first page dma_words gave.
(def dma_addresses_words ((max int) (load (list int))) (list int)
  (dma_addresses_at (cons (mov_x0_x19) (nil int)) max load))

(def test_dma_addresses () int
  (add (check_int "two pages, 8 bytes each" (boot_words (flag_dev) (dma_words 2 (dma_addresses_words 64 (nil int)))) 16)
       (check_int "as many as there is room for" (boot_words (flag_dev) (dma_words 2 (dma_addresses_words 12 (nil int)))) 8)))

; dma_sync of n pages from x19, the first page dma_words gave, in
; direction dir, then an exit with its answer.
(def dma_sync_words ((n int) (dir int)) (list int)
  (cons (mov_x0_x19) (cons (movz 1 n) (cons (movz 2 dir) (append (call_words (call_dma_sync)) (exit_x0))))))

(def test_dma_sync () int
  (add (check_int "both pages, cleaned" (boot_words (flag_dev) (dma_words 2 (dma_sync_words 2 1))) 2)
       (add (check_int "invalidated" (boot_words (flag_dev) (dma_words 2 (dma_sync_words 2 2))) 2)
            (check_int "up to the last DMA page" (boot_words (flag_dev) (dma_words 2 (dma_sync_words 5 3))) 2))))

; Refused: a direction not 1 to 3, a process that may not drive
; devices; and a page that is not DMA is none synced.
(def test_dma_sync_refused () int
  (add (check_int "direction 4" (boot_words (flag_dev) (dma_words 1 (dma_sync_words 1 4))) (err_fault))
       (add (check_int "direction 0" (boot_words (flag_dev) (dma_words 1 (dma_sync_words 1 0))) (err_fault))
            (add (check_int "nodev" (boot_words 0 (cons (movz_hi 0 49216) (cons (movz 1 1) (cons (movz 2 1) (append (call_words (call_dma_sync)) (exit_x0)))))) (err_denied))
                 (check_int "the heap, not DMA" (boot_words (flag_dev) (cons (movz_hi 0 49216) (cons (movz 1 1) (cons (movz 2 1) (append (call_words (call_dma_sync)) (exit_x0)))))) 0)))))

; Each a page of the frame pool, and each page its own frame. (Which
; frames a boot gives depends on the program's size, so the addresses
; are not compared with another boot's.)
(def test_dma_addresses_frames () int
  (let a (boot_words (flag_dev) (dma_words 2 (dma_addresses_words 64 (first_words))))
    (let b (boot_words (flag_dev) (dma_words 2 (dma_addresses_words 64 (second_words))))
      (add (in_frame_pool a) (add (in_frame_pool b) (check_true "two frames" (not (eq a b))))))))

(def test_dma_addresses_refused () int
  (add (check_int "nodev" (boot_words 0 (dma_addresses_at (cons (movz_hi 0 49216) (nil int)) 64 (nil int))) (err_denied))
       (check_int "the heap is no DMA page: nothing" (boot_words (flag_dev) (dma_addresses_at (cons (movz_hi 0 49216) (nil int)) 64 (nil int))) 0)))

; The region call over len bytes from x19.
(def dma_region_words ((len int)) (list int)
  (cons (mov_x0_x19) (cons (movz 1 len) (append (call_words 10) (exit_x0)))))

(def test_dma_region () int
  (check_int "where it is" (boot_words (flag_dev) (dma_words 2 (dma_region_words 8192))) (stack_top)))

(def test_dma_region_past () int
  (check_int "one page too many" (boot_words (flag_dev) (dma_words 1 (dma_region_words 8192))) -3))

(def test_dma_region_none () int
  (check_int "no DMA pages"
    (boot_words (flag_dev) (cons (movz_hi 0 59392) (cons (movz 1 4096) (append (call_words 10) (exit_x0)))))   ; 0xE8000000
    -3))

; ----------------------------------------------------------- shared memory

; shm_alloc of n pages, then words, with the first page's address in x19.
(def shm_words ((n int) (ws (list int))) (list int)
  (cons (movz 0 n) (append (call_words (call_shm_alloc)) (cons (mov_x19_x0) ws))))

(def test_shm_alloc_nodev () int
  (check_int "any process" (boot_words 0 (shm_words 1 (cons (mov_x0_x19) (exit_x0)))) (stack_top)))

; shm_share of x19's n pages with pid, then the answer as the status.
(def share_words ((n int) (pid int)) (list int)
  (cons (mov_x0_x19) (cons (movz 1 n) (cons (movz 2 pid) (append (call_words (call_shm_share)) (exit_x0))))))

(def test_shm_share_self () int
  (check_int "a second view, at the next device page"
    (boot_words 0 (shm_words 1 (share_words 1 1))) (add (stack_top) 4096)))

(def test_shm_share_no_pid () int
  (check_int "no pid 9" (boot_words 0 (shm_words 1 (share_words 1 9))) (err_no_port)))

(def test_shm_share_not_mine () int
  (check_int "two pages, one shared memory" (boot_words 0 (shm_words 1 (share_words 2 1))) (err_fault)))

(def test_shm_share_none () int
  (check_int "0 pages" (boot_words 0 (shm_words 1 (share_words 0 1))) (err_too_big)))

; pid 1 stores 7 in its shared page, shares it with pid 2, and waits for
; it; pid 2 loads its first device page, the same memory, and exits with
; what it holds.
(def sharer () (list int)
  (shm_words 1 (cons (movz 0 7) (cons (mov_x1_x19) (cons (str_x0_x1) (share_and_wait))))))

(def share_and_wait () (list int)
  (cons (mov_x0_x19) (cons (movz 1 1) (cons (movz 2 2)
    (append (call_words (call_shm_share)) (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0))))))))

(def reader () (list int)
  (cons (movz_hi 1 59392) (cons (ldr_x0_x1) (exit_x0))))   ; 0xE8000000

(def test_shm_shared_between () int
  (check_int "pid 2 read what pid 1 wrote"
    (boot (raw_initramfs (cons (Raw (flag_boot) (code (sharer)))
                               (cons (Raw (flag_boot) (code (reader))) (nil Raw)))))
    7))

; ---------------------------------------------------------------- terminals

(def test_tty_get_none () int
  (check_int "the kernel's own" (boot_words 0 (append (call_words (call_tty_get)) (exit_x0))) 0))

(def test_tty_set_missing () int
  (check_int "no port 99" (boot_words 0 (cons (movz 0 99) (append (call_words (call_tty_set)) (exit_x0)))) (err_no_port)))

; A new port as the thread's own terminal, in x19, then words.
(def own_tty_words ((ws (list int))) (list int)
  (append (call_words (call_port_new))
    (cons (mov_x19_x0) (append (call_words (call_tty_set)) ws))))

(def test_tty_get_set () int
  (check_int "its port" (boot_words 0 (own_tty_words (append (call_words (call_tty_get)) (exit_x0)))) 1))

; Two bytes of the image written to standard output.
(def write_two () (list int)
  (cons (movz 0 1) (cons (movz_hi 1 49152) (cons (movz 2 2) (call_words 2)))))

(def test_tty_write () int
  (check_int "two written" (boot_words 0 (own_tty_words (append (write_two) (exit_x0)))) 2))

; What the terminal gets: the writer's pid, then reply port 0, w, and the
; two bytes.
(def test_tty_write_message () int
  (check_int "4 and 7 bytes"
    (boot_words 0 (own_tty_words (append (write_two)
      (cons (mov_x0_x19) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_try_receive)) (exit_x0))))))))
    11))

; Reading standard input waits for the terminal's line: here nothing can
; send one, so the kernel finds the deadlock.
(def test_tty_read_waits () int
  (check_int "deadlock"
    (boot_words 0 (own_tty_words (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words 1) (exit_x0)))))))
    124))

(def test_pid () int
  (check_int "pid 1" (boot_words 0 (append (call_words (call_pid)) (exit_x0))) 1))

; Sends 8 bytes of its own code to its own port, and receives them into
; the heap: the header's 4 bytes and the 8.
(def test_send_to_self () int
  (check_int "received"
    (boot_words 0
      (append (call_words (call_port_new))
        (cons (mov_x19_x0) (cons (movz_hi 1 49152) (cons (movz 2 8)
          (append (call_words (call_send))
            (cons (mov_x0_x19) (cons (movz_hi 1 49216) (cons (movz 2 64)
              (append (call_words (call_receive)) (exit_x0)))))))))))
    12))

(def test_too_small () int
  (check_int "max below the message"
    (boot_words 0
      (append (call_words (call_port_new))
        (cons (mov_x19_x0) (cons (movz_hi 1 49152) (cons (movz 2 8)
          (append (call_words (call_send))
            (cons (mov_x0_x19) (cons (movz_hi 1 49216) (cons (movz 2 6)
              (append (call_words (call_receive)) (exit_x0)))))))))))
    (err_too_big)))

(def test_try_receive_empty () int
  (check_int "nothing waiting"
    (boot_words 0
      (append (call_words (call_port_new))
        (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_try_receive)) (exit_x0))))))
    (err_taken)))

(def test_receive_not_owner () int
  (check_int "no port 5"
    (boot_words 0 (cons (movz 0 5) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_receive)) (exit_x0))))))
    (err_no_port)))

(def test_send_too_big () int
  (check_int "4097 bytes"
    (boot_words 0 (cons (movz 0 1) (cons (movz_hi 1 49152) (cons (movz 2 4097) (append (call_words (call_send)) (exit_x0))))))
    (err_too_big)))

; Waits on its own port with nothing that could send to it.
(def test_deadlock () int
  (check_int "deadlock"
    (boot_words 0 (append (call_words (call_port_new)) (cons (movz 2 8) (append (call_words (call_receive)) (cons (b_self) (nil int))))))
    124))

; Module 1 spins for ever; pid 1 yields to it, and gets the processor back
; only because the timer takes it from the spinner.
(def test_preemption () int
  (check_int "back after the spinner"
    (boot (raw_initramfs (cons (Raw (flag_boot) (code (cons (movz 0 1) (append (call_words (call_spawn))
                                                     (append (call_words (call_yield))
                                                       (cons (movz 0 3) (exit_x0)))))))
                      (cons (Raw 0 (code (cons (b_self) (nil int)))) (nil Raw)))))
    3))

(def test_wait_child () int
  (check_int "child's status"
    (boot (raw_initramfs (cons (Raw (flag_boot) (code (cons (movz 0 1) (append (call_words (call_spawn))
                                                     (append (call_words (call_wait)) (exit_x0))))))
                      (cons (Raw 0 (code (cons (movz 0 42) (exit_x0)))) (nil Raw)))))
    42))

; A child that exits with -1: wait answers its wait_word, 0xFFFFFFFF, so
; it is never err_no_port, which is -1 too.
(def test_wait_child_minus_one () int
  (check_int "child's status -1"
    (boot (raw_initramfs (cons (Raw (flag_boot) (code (cons (movz 0 1) (append (call_words (call_spawn))
                                                     (append (call_words (call_wait)) (exit_x0))))))
                      (cons (Raw 0 (code (cons (movn 0 0) (exit_x0)))) (nil Raw)))))
    4294967295))

(def test_spawn_bad_index () int
  (check_int "module 7" (boot_words 0 (cons (movz 0 7) (append (call_words (call_spawn)) (exit_x0)))) (err_no_port)))

(def test_wait_self () int
  (check_int "pid 1 waits on itself" (boot_words 0 (cons (movz 0 1) (append (call_words (call_wait)) (exit_x0)))) (err_no_port)))

(def test_sleep_in_past () int
  (check_int "at once" (boot_words 0 (cons (movz 0 1) (append (call_words (call_sleep_until)) (exit_x0)))) 0))

; Entry 0's path is /bin/raw0, a program: 9 bytes, then a NUL and x,
; copied to the heap.
(def test_module_name () int
  (check_int "/bin/raw0"
    (boot_words 0 (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_module_name)) (exit_x0))))))
    11))

; A file that is not a program has no x: /etc/motd, entry 2 after
; /bin/raw0 and /etc.
(def test_module_name_file () int
  (check_int "/etc/motd"
    (files_boot (cons (movz 0 2) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_module_name)) (exit_x0))))) "" "")
    9))

(def test_module_name_missing () int
  (check_int "no module 4"
    (boot_words 0 (cons (movz 0 4) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_module_name)) (exit_x0))))))
    (err_no_port)))

(def test_module_name_too_small () int
  (check_int "max 2"
    (boot_words 0 (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 2) (append (call_words (call_module_name)) (exit_x0))))))
    (err_too_big)))

(def test_irq_bind_denied () int
  (check_int "nodev"
    (boot_words 0 (append (call_words (call_port_new)) (cons (mov_x19_x0) (cons (movz 0 34) (cons (mov_x1_x19) (append (call_words (call_irq_bind)) (exit_x0)))))))
    (err_denied)))

(def test_irq_ack_unbound () int
  (check_int "not bound" (boot_words (flag_dev) (cons (movz 0 34) (append (call_words (call_irq_ack)) (exit_x0)))) (err_no_port)))

; ------------------------------------------------------------------- fuzz

; Nothing a thread puts in its registers can make the kernel fail: a
; thread that makes hundreds of calls with random words, below, inside,
; and above the user range, negative and huge, still reaches its exit.
; Calls that wait, or end the thread, are left out, and writes go to
; standard error.

(def fuzz_calls () (list int)
  (numbers (split_spaces "1 2 4 5 6 7 8 9 10 11 99 256 257 258 259 261 262 263 267 268 269 270 271 272 273 274 275 276 277 278 279 290 291 300")))

(def numbers ((ws (list (list int)))) (list int)
  (if (is_empty ws) (nil int) (cons (int_prefix (head ws) 0) (numbers (tail ws)))))

(def fuzz_reg ((s int) (d int)) int
  (let kind (rand_below s 4)
    (let v (rand_below (rand_next s) 65536)
      (if (eq kind 0) (movz d v)
      (if (eq kind 1) (movz_hi d v)
      (if (eq kind 2) (movn d v)
      (fuzz_special (rand_next s) d)))))))

; Words that land where the kernel must decide: the devices' bases, the
; edges of the user range, and small counts and interrupt numbers.
(def fuzz_special ((s int) (d int)) int
  (let i (rand_below s 13)
    (if (lt i 7)
        (movz_hi d (nth (numbers (split_spaces "2304 2305 2560 49152 49216 59392 65535")) i))
        (movz d (nth (numbers (split_spaces "0 1 2 8 34 4096")) (sub i 7))))))

; One call's instructions, reversed onto acc.
(def fuzz_call ((s int) (acc (list int))) (list int)
  (let n (nth (fuzz_calls) (rand_below s (length (fuzz_calls))))
    (let x0 (if (eq n 2) (movz 0 2) (fuzz_reg (rand_next s) 0))
      (let x1 (fuzz_reg (rand_next (rand_next (rand_next s))) 1)
        (let x2 (fuzz_reg (rand_next (rand_next (rand_next (rand_next (rand_next s))))) 2)
          (cons (svc) (cons (movz 8 n) (cons x2 (cons x1 (cons x0 acc))))))))))

(def fuzz_code ((s int) (n int) (acc (list int))) (list int)
  (if (eq n 0)
      (rev_onto acc (cons (movz 0 0) (exit_x0)))
      (fuzz_code (rand_next (rand_next (rand_next (rand_next (rand_next (rand_next (rand_next s)))))))
                 (sub n 1) (fuzz_call s acc))))

(def test_fuzz_a () int
  (check_int "survived" (boot_words 0 (fuzz_code 1 300 (nil int))) 0))

(def test_fuzz_b () int
  (check_int "survived" (boot_words 0 (fuzz_code 77 300 (nil int))) 0))

(def test_fuzz_c () int
  (check_int "survived" (boot_words 0 (fuzz_code 4242 300 (nil int))) 0))

; The same for a module that may drive devices, so the region and
; interrupt calls get past their first check.
(def test_fuzz_dev () int
  (check_int "survived" (boot_words (flag_dev) (fuzz_code 9 300 (nil int))) 0))

; A message sent to a process that is already ready must not put it on
; the ready queue twice: if it were, the second turn would resume it while
; it waits on its port, with a stale x0. Here pid 2 makes port 1 and
; yields; pid 1 sends to it while it is ready, then waits for it. Pid 2
; takes the message and waits again, for ever, so pid 1 never wakes.
(def test_ready_once () int
  (check_int "deadlock, not a stale resume"
    (boot (raw_initramfs
            (cons (Raw (flag_boot)
                    (code (cons (movz 0 1) (append (call_words (call_spawn))
                            (cons (mov_x19_x0) (append (call_words (call_yield))
                              (cons (movz 0 1) (cons (movz_hi 1 49152) (cons (movz 2 8) (append (call_words (call_send))
                                (cons (mov_x0_x19) (append (call_words (call_wait)) (exit_x0)))))))))))))
              (cons (Raw 0
                      (code (append (call_words (call_port_new)) (append (call_words (call_yield))
                              (cons (movz 0 1) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_receive))
                                (cons (movz 0 1) (append (call_words (call_receive)) (exit_x0)))))))))))
                    (nil Raw)))))
    124))

; ------------------------------------------------------------ jobs

(def spinner () Raw (Raw 0 (code (cons (b_self) (nil int)))))

(def exits_with ((n int)) Raw (Raw 0 (code (cons (movz 0 n) (exit_x0)))))

(def first ((ws (list int))) Raw (Raw (flag_boot) (code ws)))

(def boot_mods ((mods (list Raw))) int (boot (raw_initramfs mods)))

; Spawns module 1, a spinner, as pid 2, kills it, and exits with what
; waiting for it gives.
(def test_kill_child () int
  (check_int "killed"
    (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn))
                       (cons (movz 0 2) (append (call_words (call_kill))
                         (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0))))))))
               (cons (spinner) (nil Raw))))
    (killed_status)))

(def test_kill_answers_zero () int
  (check_int "kill's result"
    (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn))
                       (cons (movz 0 2) (append (call_words (call_kill)) (exit_x0))))))
               (cons (spinner) (nil Raw))))
    0))

; Pid 1 spawns module 1 as pid 2 and module 2 as pid 3, then exits with
; what waiting for pid w gives.
(def spawn_two_wait ((w int) (two Raw)) int
  (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn))
                     (cons (movz 0 2) (append (call_words (call_spawn))
                       (cons (movz 0 w) (append (call_words (call_wait)) (exit_x0))))))))
             (cons two (cons (sibling_killer) (nil Raw))))))

; Kills pid 2, and exits with the result.
(def sibling_killer () Raw
  (Raw 0 (code (cons (movz 0 2) (append (call_words (call_kill)) (exit_x0))))))

; Pid 3 kills pid 2, its sibling, not its child.
(def test_kill_sibling () int
  (add (check_int "kill's result" (spawn_two_wait 3 (spinner)) 0)
       (check_int "the sibling's status" (spawn_two_wait 2 (spinner)) (killed_status))))

; Pid 2 kills pid 1, its parent, which stops the system with pid 1's
; status.
(def test_kill_pid_one () int
  (check_int "the system's status"
    (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn))
                       (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0))))))
               (cons (Raw 0 (code (cons (movz 0 1) (append (call_words (call_kill)) (exit_x0))))) (nil Raw))))
    (killed_status)))

; A driver, a program with a dev line, cannot be killed.
(def test_kill_driver () int
  (check_int "denied" (spawn_two_wait 3 (Raw (flag_dev) (code (cons (b_self) (nil int))))) (wait_word (err_denied))))

(def test_kill_self () int
  (check_int "pid 1 is not its own child"
    (boot_words 0 (cons (movz 0 1) (append (call_words (call_kill)) (exit_x0))))
    (err_no_port)))

;; Short sequences, so the tests below read as steps.
(def spawn_words ((m int)) (list int) (cons (movz 0 m) (call_words (call_spawn))))
(def watch_words ((pid int) (port int)) (list int) (cons (movz 0 pid) (cons (movz 1 port) (call_words (call_watch)))))

; Receives on port into the heap, with call n, and exits with the count.
(def receive_exit ((n int) (port int)) (list int)
  (cons (movz 0 port) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words n) (exit_x0))))))

; Watches pid 2 on port 1 before it runs, and receives its notice: the
; header and 12 bytes.
(def test_watch_exit () int
  (check_int "notice"
    (boot_mods (cons (first (append (spawn_words 1)
                              (append (call_words (call_port_new))
                                (append (watch_words 2 1) (receive_exit (call_receive) 1)))))
               (cons (exits_with 7) (nil Raw))))
    16))

; The same, watching after it has exited: the notice comes at once.
(def test_watch_dead () int
  (check_int "notice"
    (boot_mods (cons (first (append (spawn_words 1)
                              (append (call_words (call_yield))
                                (append (call_words (call_port_new))
                                  (append (watch_words 2 1) (receive_exit (call_try_receive) 1))))))
               (cons (exits_with 7) (nil Raw))))
    16))

(def test_watch_foreign_port () int
  (check_int "port 9 is no one's"
    (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn))
                       (cons (movz 0 2) (cons (movz 1 9) (append (call_words (call_watch)) (exit_x0)))))))
               (cons (spinner) (nil Raw))))
    (err_no_port)))

; ------------------------------------------------------- spawn_args

; Exits with how many arguments it was given.
(def arg_counter () Raw (Raw 0 (code (append (call_words (sys_arg_count)) (exit_x0)))))

; Spawns module m with the len bytes stored right after its ten words of
; code, waits for it, and exits with its status.
(def spawn_args_words ((m int) (len int)) (list int)
  (cons (movz 0 m) (cons (movz_hi 1 49152) (cons (add_imm 1 1 40) (cons (movz 2 len)
    (append (call_words (call_spawn_args)) (append (call_words (call_wait)) (exit_x0))))))))

(def spawner ((m int) (extra (list int)) (len int)) Raw
  (Raw (flag_boot) (program (append (code_bytes (spawn_args_words m len)) extra))))

; The same, but exits with what spawn_args gave, for a spawn that fails:
; eight words of code.
(def spawn_try_words ((m int) (len int)) (list int)
  (cons (movz 0 m) (cons (movz_hi 1 49152) (cons (add_imm 1 1 32) (cons (movz 2 len)
    (append (call_words (call_spawn_args)) (exit_x0)))))))

(def spawn_tryer ((m int) (extra (list int)) (len int)) Raw
  (Raw (flag_boot) (program (append (code_bytes (spawn_try_words m len)) extra))))

(def test_spawn_args () int
  (check_int "two arguments"
    (boot_mods (cons (spawner 1 (encode_args (split_spaces "a bc")) (length (encode_args (split_spaces "a bc"))))
                     (cons (arg_counter) (nil Raw))))
    2))

(def test_spawn_args_none () int
  (check_int "no arguments"
    (boot_mods (cons (spawner 1 (encode_args (nil (list int))) 4) (cons (arg_counter) (nil Raw))))
    0))

(def test_spawn_args_malformed () int
  (check_int "argc 2, one argument"
    (boot_mods (cons (spawn_tryer 1 (append (u32_le 2) (append (u32_le 1) "a")) 9) (cons (arg_counter) (nil Raw))))
    (err_fault)))

(def test_spawn_args_too_big () int
  (check_int "4097 bytes"
    (boot_mods (cons (spawn_tryer 1 (encode_args (nil (list int))) 4097) (cons (arg_counter) (nil Raw))))
    (err_too_big)))

(def test_spawn_args_no_module () int
  (check_int "module 9"
    (boot_mods (cons (spawn_tryer 9 (encode_args (nil (list int))) 4) (cons (arg_counter) (nil Raw))))
    (err_no_port)))

(def test_spawn_args_bad_buffer () int
  (check_int "from below the user range"
    (boot_words 0 (cons (movz 0 0) (cons (movz 1 16) (cons (movz 2 4) (append (call_words (call_spawn_args)) (exit_x0))))))
    (err_fault)))

; Plain spawn still gives a program the inittab's arguments for it: none,
; for a raw program.
(def test_spawn_keeps_inittab_args () int
  (check_int "the inittab's"
    (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn)) (append (call_words (call_wait)) (exit_x0)))))
                     (cons (arg_counter) (nil Raw))))
    0))

; -------------------------------------------------------- proc_info

; Asks for pid's record into the heap, with room for max, then exits with
; the count, or with the record's first or second 8 bytes, as load says.
(def info_words ((pid int) (max int) (load (list int))) (list int)
  (cons (movz 0 pid) (cons (movz_hi 1 49216) (cons (movz 2 max)
    (append (call_words (call_proc_info)) (append load (exit_x0)))))))

(def first_words () (list int) (cons (ldr_x0_x1) (nil int)))
(def second_words () (list int) (cons (ldr_x0_x1_8) (nil int)))
(def third_words () (list int) (cons (ldr_x0_x1_16) (nil int)))

; Two u32s as the 8 bytes a load gives: low, then high.
(def words ((low int) (high int)) int (bit_or low (bit_shl high 32)))

; The record, then its program's path, /bin/raw0: as much as there is
; room for, past the record.
(def test_info_length () int
  (add (check_int "24 bytes and the path" (boot_words 0 (info_words 1 64 (nil int))) 33)
       (add (check_int "the record alone" (boot_words 0 (info_words 1 24 (nil int))) (proc_record_len))
            (check_int "not even that" (boot_words 0 (info_words 1 23 (nil int))) (err_too_big)))))

; Its own pages: none yet, as the heap's the record is written to is
; mapped once the record is made; and none at its device pages, but its
; code's one page, which another process running it would share.
(def test_info_own_pages () int
  (let r (boot_words 0 (info_words 1 64 (third_words)))
    (add (check_int "none of its own" (bit_and r 4294967295) 0)
         (check_int "its code, shared" (bit_shr r 32) 1))))

; Three pages of shared memory first: three at its device pages, and its
; code's.
(def test_info_shared_pages () int
  (check_int "three shared, and its code"
    (bit_shr (boot_words 0 (shm_words 3 (info_words 1 64 (third_words)))) 32)
    4))

; An exited process has no pages.
(def test_info_exited_pages () int
  (check_int "none"
    (boot_mods (cons (first (append (spawn_words 1) (append (call_words (call_yield)) (info_words 2 64 (third_words)))))
                     (cons (exits_with 7) (nil Raw))))
    0))

; ------------------------------------------------------------ mem_info

; Asks for the memory record into the heap, with room for max, then
; exits with the count, or with the record, as load says.
(def mem_words ((max int) (load (list int))) (list int)
  (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 max)
    (append (call_words (call_mem_info)) (append load (exit_x0)))))))

(def test_mem_info_length () int
  (add (check_int "the record" (boot_words 0 (mem_words 64 (nil int))) (mem_record_len))
       (check_int "no room" (boot_words 0 (mem_words 7 (nil int))) (err_too_big))))

; The pool is the frame windows less the image, the device tree and the
; page tables: at most 383.5 MB and 384 MB, 196,480 pages, and with a
; small image, over 750 MB, 192,000 pages.
(def test_mem_info_total () int
  (let total (bit_and (boot_words 0 (mem_words 8 (first_words))) 4294967295)
    (add (check_true "over 750 MB" (gt total 192000))
         (check_true "within the windows" (le total 196480)))))

; The process's own pages are given, and so are the pages it shares:
; with four shared first, four more than without.
(def test_mem_info_used () int
  (let alone (bit_shr (boot_words 0 (mem_words 8 (first_words))) 32)
    (add (check_true "some given" (gt alone 0))
         (check_int "four more"
           (sub (bit_shr (boot_words 0 (shm_words 4 (mem_words 8 (first_words)))) 32) alone)
           4))))

; The frames given once pid 1 has spawned each of ms, which have not yet
; run, so only their images' pages are mapped: the high word of
; mem_info's first.
(def used_after_spawns ((ms (list Raw))) int
  (bit_shr (boot_mods (cons (first (append (spawns_of 1 (length ms)) (mem_words 8 (first_words)))) ms)) 32))

; Spawns of modules i up to n.
(def spawns_of ((i int) (n int)) (list int)
  (if (gt i n) (nil int) (append (spawn_words i) (spawns_of (add i 1) n))))

; A spinner whose code differs from spinner's, by a word before its loop.
(def other_spinner () Raw (Raw 0 (code (cons (movz 0 1) (cons (b_self) (nil int))))))

; A second process running the same program maps its code's frame, so
; takes none; one running another program takes one of its own.
(def test_image_shared () int
  (let one (used_after_spawns (cons (spinner) (nil Raw)))
    (add (check_int "the same program" (sub (used_after_spawns (cons (spinner) (cons (spinner) (nil Raw)))) one) 0)
         (check_int "another" (sub (used_after_spawns (cons (spinner) (cons (other_spinner) (nil Raw)))) one) 1))))

; Two processes of the same bytes are shared by what they hold, not by
; their path: modules 1 and 2 are both spinners.
(def test_image_shared_by_bytes () int
  (check_int "one frame for both"
    (sub (used_after_spawns (cons (spinner) (cons (spinner) (cons (spinner) (nil Raw)))))
         (used_after_spawns (cons (spinner) (nil Raw))))
    0))

; A shared code frame comes back once the last process running it ends:
; two children of one program spawned and waited for leave what pid 1
; alone uses.
(def test_image_shared_freed () int
  (let alone (bit_shr (boot_words 0 (mem_words 8 (first_words))) 32)
    (check_int "as before"
      (bit_shr (boot_mods (cons (first (append (repeat_words 2 (cons (movz 0 1) (append (call_words (call_spawn)) (call_words (call_wait)))))
                                               (mem_words 8 (first_words))))
                                (cons (exits_with 7) (nil Raw))))
               32)
      alone)))

; A buffer the process may not write is refused.
(def test_mem_info_bad_buffer () int
  (check_int "below the user range"
    (boot_words 0 (cons (movz 0 0) (cons (movz 1 16) (cons (movz 2 8) (append (call_words (call_mem_info)) (exit_x0))))))
    (err_fault)))

(def test_info_self () int
  (check_int "running, from the kernel" (boot_words 0 (info_words 1 64 (first_words))) (words (state_running) 0)))

(def test_info_ready () int
  (check_int "ready, from pid 1"
    (boot_mods (cons (first (append (spawn_words 1) (info_words 2 64 (first_words))))
                     (cons (spinner) (nil Raw))))
    (words (state_ready) 1)))

; Pid 2 waits on port 1; pid 1 yields to let it, then asks.
(def receiver () Raw
  (Raw 0 (code (append (call_words (call_port_new)) (cons (movz 2 8) (append (call_words (call_receive)) (exit_x0)))))))

(def test_info_receiving () int
  (check_int "receiving"
    (boot_mods (cons (first (append (spawn_words 1) (append (call_words (call_yield)) (info_words 2 64 (first_words)))))
                     (cons (receiver) (nil Raw))))
    (words (state_receiving) 1)))

(def test_info_receiving_detail () int
  (check_int "module 1, on port 1"
    (boot_mods (cons (first (append (spawn_words 1) (append (call_words (call_yield)) (info_words 2 64 (second_words)))))
                     (cons (receiver) (nil Raw))))
    (words 1 1)))

(def test_info_exited () int
  (check_int "exited"
    (boot_mods (cons (first (append (spawn_words 1) (append (call_words (call_yield)) (info_words 2 64 (first_words)))))
                     (cons (exits_with 7) (nil Raw))))
    (words (state_exited) 0)))

(def test_info_exited_status () int
  (check_int "no module, status 7"
    (boot_mods (cons (first (append (spawn_words 1) (append (call_words (call_yield)) (info_words 2 64 (second_words)))))
                     (cons (exits_with 7) (nil Raw))))
    (words 4294967295 7)))

(def test_info_unused () int
  (check_int "pid 9" (boot_words 0 (info_words 9 64 (nil int))) (err_no_port)))

(def test_info_too_small () int
  (check_int "max 8" (boot_words 0 (info_words 1 8 (nil int))) (err_too_big)))

; ------------------------------------------------------------- files

; A program of these instructions, padded to 1024 bytes, then data: the
; paths it opens, which data_words puts the address of in a register.
(def with_data ((ws (list int)) (d (list int))) (list int)
  (program (append (pad_to 1024 (code_bytes ws)) d)))

(def pad_to ((n int) (s (list int))) (list int)
  (append s (zeros (sub n (length s)))))

; xd = the address of byte at of the data.
(def data_words ((d int) (at int)) (list int)
  (cons (movz_hi d 49152) (cons (add_imm d d (add 1024 at)) (nil int))))

; Opens the len bytes of path at data byte at, with mode: x0 is the stream.
(def open_words ((at int) (len int) (mode int)) (list int)
  (append (data_words 0 at) (cons (movz 1 len) (cons (movz 2 mode) (call_words (sys_open))))))

; Reads up to 64 bytes of stream x19 into the heap: x0 is the count.
(def read_x19 () (list int)
  (cons (mov_x0_x19) (cons (movz_hi 1 49216) (cons (movz 2 64) (call_words (sys_read))))))

; An initramfs of one program, these instructions with this data, and a
; directory /etc holding /etc/motd, "hello\n": entries 0, 1, 2, and the
; inittab 3.
(def files_boot ((ws (list int)) (d (list int)) (more (list int))) int
  (boot (raw_initramfs_with (cons (Raw (flag_boot) (with_data ws d)) (nil Raw))
                            (cons (RawFile "etc" 16877 "") (cons (RawFile "etc/motd" 33188 "hello\n") (nil RawFile)))
                            more)))

(def test_open () int
  (check_int "stream 3" (files_boot (append (open_words 0 9 1) (exit_x0)) "/etc/motd" "") 3))

(def test_open_relative () int
  (check_int "from the root" (files_boot (append (open_words 0 8 1) (exit_x0)) "etc/motd" "") 3))

(def test_read () int
  (check_int "6 bytes"
    (files_boot (append (open_words 0 9 1) (cons (mov_x19_x0) (append (read_x19) (exit_x0)))) "/etc/motd" "")
    6))

(def test_read_to_end () int
  (check_int "then 0"
    (files_boot (append (open_words 0 9 1) (cons (mov_x19_x0) (append (read_x19) (append (read_x19) (exit_x0)))))
                "/etc/motd" "")
    0))

(def test_read_not_open () int
  (check_int "stream 9"
    (files_boot (cons (movz 19 9) (append (read_x19) (exit_x0))) "" "")
    -5))

(def test_open_missing () int
  (check_int "-3" (files_boot (append (open_words 0 9 1) (exit_x0)) "/etc/nope" "") -3))

(def test_open_directory () int
  (check_int "-8" (files_boot (append (open_words 0 4 1) (exit_x0)) "/etc" "") -8))

(def test_open_to_write () int
  (check_int "read-only: -4" (files_boot (append (open_words 0 9 2) (exit_x0)) "/etc/motd" "") -4))

(def test_open_to_write_no_directory () int
  (check_int "-9" (files_boot (append (open_words 0 8 3) (exit_x0)) "/nodir/x" "") -9))

(def test_open_bad_path () int
  (check_int "from 0x10"
    (files_boot (cons (movz 0 16) (cons (movz 1 4) (cons (movz 2 1) (append (call_words (sys_open)) (exit_x0))))) "" "")
    -5))

(def test_close () int
  (check_int "0"
    (files_boot (append (open_words 0 9 1) (append (call_words (sys_close)) (exit_x0))) "/etc/motd" "")
    0))

(def test_close_twice () int
  (check_int "-5"
    (files_boot (append (open_words 0 9 1)
                  (cons (mov_x19_x0) (append (call_words (sys_close)) (cons (mov_x0_x19) (append (call_words (sys_close)) (exit_x0))))))
                "/etc/motd" "")
    -5))

(def repeat_words ((n int) (ws (list int))) (list int)
  (if (eq n 0) (nil int) (append ws (repeat_words (sub n 1) ws))))

(def test_open_limit () int
  (check_int "the 17th"
    (files_boot (append (repeat_words 17 (open_words 0 9 1)) (exit_x0)) "/etc/motd" "")
    -5))

(def test_open_limit_last_fits () int
  (check_int "the 16th, stream 18"
    (files_boot (append (repeat_words 16 (open_words 0 9 1)) (exit_x0)) "/etc/motd" "")
    18))

; x0 and x1 the path at data byte at, of len bytes, then call n.
(def path_call ((at int) (len int) (n int)) (list int)
  (append (data_words 0 at) (cons (movz 1 len) (append (call_words n) (exit_x0)))))

(def test_rename () int
  (add (check_int "an existing file" (files_boot (path_call 0 9 (sys_rename)) "/etc/motd" "") -4)
       (check_int "a missing file" (files_boot (path_call 0 9 (sys_rename)) "/etc/nope" "") -3)))

(def test_remove () int
  (add (check_int "an existing file" (files_boot (path_call 0 9 (sys_remove)) "/etc/motd" "") -4)
       (check_int "a directory" (files_boot (path_call 0 4 (sys_remove)) "/etc" "") -8)))

(def test_stdin () int
  (check_int "the inittab's stdin"
    (files_boot (cons (movz 19 0) (append (read_x19) (exit_x0))) "" "stdin /etc/motd\n")
    6))

(def test_stdin_none () int
  (check_int "empty"
    (files_boot (cons (movz 19 0) (append (read_x19) (exit_x0))) "" "")
    0))

(def test_spawn_not_a_program () int
  (add (check_int "a text file" (files_boot (cons (movz 0 2) (append (call_words (call_spawn)) (exit_x0))) "" "") (err_denied))
       (check_int "a directory" (files_boot (cons (movz 0 1) (append (call_words (call_spawn)) (exit_x0))) "" "") (err_denied))))

; ----------------------------------------------------------------- volumes

; A new port in x19, the len bytes at data byte at mounted from it as a
; volume's label, then ws.
(def mount_words ((at int) (len int) (ws (list int))) (list int)
  (append (call_words (call_port_new))
    (cons (mov_x19_x0) (append (data_words 1 at) (cons (movz 2 len) (append (call_words (call_fs_mount)) ws))))))

; Mounts the label at data byte at, of len bytes, from port n.
(def mount_from ((n int) (at int) (len int)) (list int)
  (cons (movz 0 n) (append (data_words 1 at) (cons (movz 2 len) (append (call_words (call_fs_mount)) (exit_x0))))))

(def test_mount () int
  (check_int "mounted" (files_boot (mount_words 0 4 (exit_x0)) "data" "") 0))

(def test_mount_not_yours () int
  (check_int "port 5" (files_boot (mount_from 5 0 4) "data" "") (err_no_port)))

(def test_mount_bad_label () int
  (add (check_int "a slash" (files_boot (mount_words 0 3 (exit_x0)) "a/b" "") (err_fault))
       (add (check_int "empty" (files_boot (mount_words 0 0 (exit_x0)) "" "") (err_fault))
            (check_int "16 bytes" (files_boot (mount_words 0 16 (exit_x0)) "abcdefghijklmnop" "") (err_fault)))))

(def test_mount_taken () int
  (check_int "data twice"
    (files_boot (mount_words 0 4 (cons (mov_x0_x19) (append (data_words 1 0) (cons (movz 2 4) (append (call_words (call_fs_mount)) (exit_x0))))))
                "data" "")
    (err_taken)))

; The len bytes at data byte at unmounted as a volume's label from the
; port in x19, then ws.
(def unmount_words ((at int) (len int) (ws (list int))) (list int)
  (cons (mov_x0_x19) (append (data_words 1 at) (cons (movz 2 len) (append (call_words (call_fs_unmount)) ws)))))

; Mounted, then unmounted by the port that mounted it.
(def test_unmount () int
  (check_int "unmounted" (files_boot (mount_words 0 4 (unmount_words 0 4 (exit_x0))) "data" "") 0))

; Once unmounted it is gone from the table: there is no mount 1.
(def test_unmount_gone () int
  (check_int "no mount 1" (files_boot (mount_words 0 4 (unmount_words 0 4 (mount_at_words 1 64))) "data" "") (err_no_port)))

; A label not mounted, another port's volume, and no label are refused.
(def test_unmount_refused () int
  (add (check_int "not mounted" (files_boot (mount_words 0 4 (unmount_words 4 5 (exit_x0))) "dataother" "") (err_no_port))
       (add (check_int "port 5" (files_boot (mount_words 0 4 (cons (movz 0 5) (append (data_words 1 0) (cons (movz 2 4) (append (call_words (call_fs_unmount)) (exit_x0)))))) "data" "") (err_no_port))
            (check_int "16 bytes" (files_boot (mount_words 0 4 (unmount_words 0 16 (exit_x0))) "abcdefghijklmnop" "") (err_fault)))))

; Mount i's record copied to the heap, max bytes at most: its length.
(def mount_at_words ((i int) (max int)) (list int)
  (cons (movz 0 i) (cons (movz_hi 1 49216) (cons (movz 2 max) (append (call_words (call_mount_at)) (exit_x0))))))

(def test_mount_at () int
  (add (check_int "the initramfs: a port and /" (files_boot (mount_at_words 0 64) "" "") 5)
       (check_int "data: a port and /Volumes/data" (files_boot (mount_words 0 4 (mount_at_words 1 64)) "data" "") 17)))

(def test_mount_at_refused () int
  (add (check_int "no mount 1" (files_boot (mount_at_words 1 64) "" "") (err_no_port))
       (check_int "max 4" (files_boot (mount_at_words 0 4) "" "") (err_too_big))))

(def test_open_volumes_dir () int
  (check_int "a directory" (files_boot (append (open_words 0 8 1) (exit_x0)) "/Volumes" "") -8))

(def test_open_unmounted () int
  (add (check_int "to read" (files_boot (append (open_words 0 15 1) (exit_x0)) "/Volumes/data/a" "") -3)
       (add (check_int "to write" (files_boot (append (open_words 0 15 2) (exit_x0)) "/Volumes/data/a" "") -9)
            (check_int "in /Volumes" (files_boot (append (open_words 0 10 3) (exit_x0)) "/Volumes/a" "") -4))))

(def test_remove_unmounted () int
  (check_int "no such file" (files_boot (path_call 0 15 (sys_remove)) "/Volumes/data/a" "") -3))

; A process that opens a file of a volume it mounted itself waits for its
; own answer, which it can never give.
(def test_open_routed_waits () int
  (check_int "deadlock"
    (files_boot (mount_words 0 4 (append (open_words 8 15 1) (exit_x0))) (append (pad_to 8 "data") "/Volumes/data/a") "")
    124))

; pid 1 mounts data and receives the request pid 2's open makes, then
; exits with its length: the sender's pid, the reply port, and open 1
; /Volumes/data/a.
(def test_open_routed_request () int
  (check_int "30 bytes"
    (boot (raw_initramfs (cons (Raw (flag_boot) (with_data (mount_words 0 4 (receive_words (exit_x0))) "data"))
                               (cons (Raw (flag_boot) (with_data (append (open_words 0 15 1) (exit_x0)) "/Volumes/data/a")) (nil Raw)))))
    30))

; Receives on x19's port into the heap, then ws.
(def receive_words ((ws (list int))) (list int)
  (cons (mov_x0_x19) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_receive)) ws)))))

; The server, pid 1, answers handle 7, the u32 at its data byte 8, to the
; reply port the request names, then waits for pid 2 and exits with its
; status: the new stream, 3.
(def test_open_routed () int
  (check_int "stream 3"
    (boot (raw_initramfs (cons (Raw (flag_boot) (with_data (mount_words 0 4 (receive_words (answer_words 8))) (append (pad_to 8 "data") (u32_le 7))))
                               (cons (Raw (flag_boot) (with_data (append (open_words 0 15 1) (exit_x0)) "/Volumes/data/a")) (nil Raw)))))
    3))

; The 4 bytes at data byte at sent to the reply port of the request in
; the heap, then pid 2 waited for, and its status the exit's.
(def answer_words ((at int)) (list int)
  (cons (movz_hi 1 49216) (cons (ldr_w0_x1_4)
    (append (data_words 1 at) (cons (movz 2 4) (append (call_words (call_send))
      (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0)))))))))

; pid 1 yields, so pid 2 mounts data first, then opens a file of it; pid
; 2 takes the request and exits without answering, and pid 1's open is
; answered -5.
(def test_open_server_gone () int
  (check_int "-5"
    (boot (raw_initramfs (cons (Raw (flag_boot) (with_data (append (call_words (call_yield)) (append (open_words 0 15 1) (exit_x0))) "/Volumes/data/a"))
                               (cons (Raw (flag_boot) (with_data (mount_words 0 4 (receive_words (cons (movz 0 0) (exit_x0)))) "data")) (nil Raw)))))
    -5))

; ----------------------------------------------------------------- freeing

; Spawns module m and waits for it, n times over, then exits with the
; last one's status.
(def spawn_wait_times ((n int) (m int)) (list int)
  (append (repeat_words n (cons (movz 0 m) (append (call_words (call_spawn)) (call_words (call_wait)))))
          (exit_x0)))

; Stores 7 at the start of each of n heap pages, from 0xC0400000, then
; words.
(def touch_words ((n int) (ws (list int))) (list int)
  (cons (movz 0 7) (cons (movz_hi 1 49216) (cons (movz 2 n)
    (cons (str_x0_x1) (cons (add_imm_hi 1 1 1) (cons (subs_imm 2 2 1) (cons (cbnz 2 -3) ws))))))))

(def toucher ((n int)) Raw (Raw 0 (code (touch_words n (cons (movz 0 0) (exit_x0))))))

; The same, with a shared page too, so that its space maps something
; above the stack and is given up when it ends, its frames freed.
(def shm_toucher ((n int)) Raw
  (Raw 0 (code (touch_words n (cons (movz 0 1) (append (call_words (call_shm_alloc)) (cons (movz 0 0) (exit_x0))))))))

; Exits with the sum of the first word of each of n heap pages.
(def summer ((n int)) Raw
  (Raw 0 (code (cons (movz 3 0) (cons (movz_hi 1 49216) (cons (movz 2 n)
    (cons (ldr_x0_x1) (cons (add_reg 3 3 0) (cons (add_imm_hi 1 1 1) (cons (subs_imm 2 2 1) (cons (cbnz 2 -4)
      (cons (mov_reg 0 3) (exit_x0)))))))))))))

; Module 1 runs, then module 2, and pid 1 exits with module 2's status.
(def one_then_two () Raw
  (first (append (repeat_words 1 (cons (movz 0 1) (append (call_words (call_spawn)) (call_words (call_wait)))))
                 (spawn_wait_times 1 2))))

; A process that runs after another has ended may be given the frames the
; first one freed, but zeroed: nothing the first one stored is left.
(def test_freed_frames_zeroed () int
  (check_int "sum of 8 pages"
    (boot_mods (cons (one_then_two) (cons (toucher 8) (cons (summer 8) (nil Raw)))))
    0))

; The same when the first one shared a page too, so its frames are freed
; by way of the count of shared mappings.
(def test_freed_shared_zeroed () int
  (check_int "sum of 8 pages"
    (boot_mods (cons (one_then_two) (cons (shm_toucher 8) (cons (summer 8) (nil Raw)))))
    0))

; Sixteen processes of 64 MB each, one after another: 262,144 frames, more
; than the board's 196,480 at most, so each must be given what the ones
; before it freed.
(def test_freed_heap_suffices () int
  (check_int "the last one's status"
    (boot_mods (cons (first (spawn_wait_times 16 1)) (cons (toucher 16384) (nil Raw))))
    0))

; Shares 16 MB, a quarter of the most one call gives, four times over, and exits with
; where the last is.
(def shm_hog () Raw
  (Raw 0 (code (append (repeat_words 4 (cons (movz 0 4096) (call_words (call_shm_alloc)))) (exit_x0)))))

; n shares of 16 MB each, the last one's answer in x0, then words.
(def shm_16s ((n int) (ws (list int))) (list int)
  (append (repeat_words n (cons (movz 0 4096) (call_words (call_shm_alloc)))) ws))

; What the tests of sixteen 64 MB processes rely on: as much at once runs
; out of frames. One process has only 384 MB of device pages, so pid 1
; shares 368 MB and then spawns a child that holds 64 MB of heap and
; tries for 368 MB more: 800 MB, 204,800 frames, more than the pool, and
; the child exits with its last share's answer.
(def test_frames_run_out () int
  (check_int "the child's last 16 MB"
    (boot_mods (cons (first (shm_16s 23 (spawn_wait_times 1 1)))
                     (cons (Raw 0 (code (touch_words 16384 (shm_16s 23 (exit_x0))))) (nil Raw))))
    (wait_word (err_fault))))

(def test_device_pages_suffice () int
  (check_int "368 MB of device pages"
    (boot_words 0 (append (repeat_words 23 (cons (movz 0 4096) (call_words (call_shm_alloc)))) (exit_x0)))
    (add (stack_top) (mul 22 16777216))))

; One call shares as much as dma_limit, 64 MB, the most a 4K screen's
; buffer needs; a page more is refused.
(def test_shm_alloc_limit () int
  (add (check_int "64 MB"
         (boot_words 0 (cons (movz 0 16384) (append (call_words (call_shm_alloc)) (exit_x0))))
         (stack_top))
       (check_int "a page more"
         (boot_words 0 (cons (movz 0 16385) (append (call_words (call_shm_alloc)) (exit_x0))))
         (err_too_big))))

; The same with shared frames: sixteen processes that share 64 MB each.
(def test_freed_shared_suffices () int
  (check_int "the last one's last 16 MB"
    (boot_mods (cons (first (spawn_wait_times 16 1)) (cons (shm_hog) (nil Raw))))
    (add (stack_top) (mul 3 16777216))))

; Spaces are given back: 300 processes in a row that each share a page,
; more than the board's 255 spaces, all run, and the last is pid 303.
; Before L0 could free a space, the 255th was refused.
(def shm_child () Raw
  (Raw 0 (code (cons (movz 0 1) (append (call_words (call_shm_alloc)) (cons (movz 0 0) (exit_x0)))))))

(def test_spaces_given_back () int
  (check_int "the 300th pid"
    (boot_mods (cons (first (spawn_wait_loop 300 1 (cons (mov_reg 0 20) (exit_x0)))) (cons (shm_child) (nil Raw))))
    303))

; A shared frame outlives the process it was shared with: pid 2 maps pid
; 1's page and exits, and pid 1 still reads its 7 there. Freeing the frame
; at pid 2's end would stop the kernel with frame still mapped.
(def share_wait_reload () (list int)
  (cons (mov_x0_x19) (cons (movz 1 1) (cons (movz 2 2)
    (append (call_words (call_shm_share)) (cons (movz 0 2) (append (call_words (call_wait))
      (cons (mov_x1_x19) (cons (ldr_x0_x1) (exit_x0))))))))))

(def test_shared_frame_outlives_sharer () int
  (check_int "pid 1's page after pid 2 ended"
    (boot (raw_initramfs (cons (Raw (flag_boot) (code (shm_words 1 (cons (movz 0 7) (cons (mov_x1_x19) (cons (str_x0_x1) (share_wait_reload)))))))
                               (cons (Raw (flag_boot) (code (reader))) (nil Raw)))))
    7))

; ------------------------------------------------------------ taking back

; shm_unmap of x19's n pages, then words.
(def unmap_words ((n int) (ws (list int))) (list int)
  (cons (mov_x0_x19) (cons (movz 1 n) (append (call_words (call_shm_unmap)) ws))))

; shm_revoke of x19's n pages from pid, then words.
(def revoke_words ((n int) (pid int) (ws (list int))) (list int)
  (cons (mov_x0_x19) (cons (movz 1 n) (cons (movz 2 pid) (append (call_words (call_shm_revoke)) ws)))))

(def test_shm_unmap () int
  (check_int "given up" (boot_words 0 (shm_words 2 (unmap_words 2 (exit_x0)))) 0))

; Touching a page given up ends the process, as touching any device page
; nothing is mapped at does.
(def test_shm_unmap_then_touch () int
  (check_int "killed"
    (boot_words 0 (shm_words 1 (unmap_words 1 (cons (mov_x1_x19) (cons (ldr_x0_x1) (exit_x0))))))
    139))

(def test_shm_unmap_refused () int
  (add (check_int "not its pages"
         (boot_words 0 (cons (movz_hi 0 59392) (cons (movz 1 1) (append (call_words (call_shm_unmap)) (exit_x0)))))
         (err_fault))
       (check_int "no pages" (boot_words 0 (shm_words 1 (unmap_words 0 (exit_x0)))) (err_too_big))))

; One process shares 16 MB and gives it up, 60 times over: 960 MB, more
; than the board's frames and than its 384 MB of device pages, so both
; the memory and the pages must come back each time. The last 16 MB is
; where the first was.
(def test_shm_unmap_frees_memory () int
  (check_int "the 60th 16 MB"
    (boot_words 0 (append (repeat_words 60 (shm_words 4096 (unmap_words 4096 (nil int)))) (cons (mov_x0_x19) (exit_x0))))
    (stack_top)))

; The same given up out of order: each time 16 MB, then a page above it
; kept, then the 16 MB given up, 60 times over. Were only the last pages
; given reused, the 16 MBs would take 960 MB of device pages; as the
; hole below the page is given again, every 16 MB is where the first
; was, and the pages kept take 60 pages more.
(def test_shm_unmap_out_of_order () int
  (check_int "the 60th 16 MB, under the pages kept"
    (boot_words 0 (append (repeat_words 60 (shm_words 4096 (cons (mov_reg 20 19) (shm_words 1 (cons (mov_reg 19 20) (unmap_words 4096 (nil int)))))))
                          (cons (mov_x0_x19) (exit_x0))))
    (stack_top)))

; Pid 1 shares a page with pid 2, then takes it back.
(def sharing_revoker ((pid int) (ws (list int))) Raw
  (Raw (flag_boot) (code (shm_words 1 (cons (movz 0 7) (cons (mov_x1_x19) (cons (str_x0_x1)
    (cons (mov_x0_x19) (cons (movz 1 1) (cons (movz 2 2) (append (call_words (call_shm_share))
      (revoke_words 1 pid ws))))))))))))

(def spinner_at_boot ((flags int)) Raw (Raw (bit_or flags (flag_boot)) (code (cons (b_self) (nil int)))))

(def test_shm_revoke () int
  (check_int "pid 2's one mapping"
    (boot (raw_initramfs (cons (sharing_revoker 2 (exit_x0)) (cons (spinner_at_boot 0) (nil Raw)))))
    1))

; Pid 2, which reads the page once pid 1 waits, finds it gone, and is
; ended for touching it: what test_shm_shared_between reads as 7.
(def test_shm_revoke_takes_back () int
  (check_int "pid 2's status"
    (boot (raw_initramfs (cons (sharing_revoker 2 (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0))))
                               (cons (Raw (flag_boot) (code (reader))) (nil Raw)))))
    139))

(def test_shm_revoke_refused () int
  (add (check_int "a driver"
         (boot (raw_initramfs (cons (sharing_revoker 2 (exit_x0)) (cons (spinner_at_boot (flag_dev)) (nil Raw)))))
         (err_denied))
       (add (check_int "itself"
              (boot (raw_initramfs (cons (sharing_revoker 1 (exit_x0)) (cons (spinner_at_boot 0) (nil Raw)))))
              (err_denied))
            (check_int "no such pid"
              (boot (raw_initramfs (cons (sharing_revoker 9 (exit_x0)) (cons (spinner_at_boot 0) (nil Raw)))))
              (err_no_port)))))

; --------------------------------------------------------- heap released

; release (spec section 10.3's call 12) of x0 and x1 as words sets them,
; then ws.
(def release_words ((x0 int) (x1 int) (ws (list int))) (list int)
  (cons x0 (cons x1 (append (call_words (sys_release)) ws))))

; 9 stored at the heap's first page, 0xC0400000, x1 left there, then ws.
(def store_9_words ((ws (list int))) (list int)
  (cons (movz_hi 1 49216) (cons (movz 0 9) (cons (str_x0_x1) ws))))

; The heap's first word loaded and exited with.
(def load_heap_exit () (list int)
  (cons (movz_hi 1 49216) (cons (ldr_x0_x1) (exit_x0))))

(def test_release_answers () int
  (check_int "0"
    (boot_words 0 (store_9_words (release_words (movz_hi 0 49216) (movz 1 4096) (exit_x0))))
    0))

; A page released is unmapped, and the next touch maps a zeroed one.
(def test_release_zeroes () int
  (check_int "read back"
    (boot_words 0 (store_9_words (release_words (movz_hi 0 49216) (movz 1 4096) (load_heap_exit))))
    0))

; Only whole pages of the heap are released: 4095 bytes hold none, a
; length that wraps names nothing, and the code, bss and stack are
; passed over, so the thread runs on and its pushed word is kept.
(def test_release_passes_over () int
  (add (check_int "part of a page"
         (boot_words 0 (store_9_words (release_words (movz_hi 0 49216) (movz 1 4095) (load_heap_exit))))
         9)
       (add (check_int "a length that wraps"
              (boot_words 0 (store_9_words (release_words (movz_hi 0 49216) (movn 1 0) (load_heap_exit))))
              9)
            (check_int "code, bss and stack"
              (boot_words 0 (cons (movz 0 5) (cons (push_x0)
                (release_words (movz_hi 0 49152) (movz_hi 1 10240)
                  (cons (ldr_x0_sp) (exit_x0))))))
              5))))

; Released frames are the board's again. Pid 1 touches 256 MB of heap,
; releases it, shares 368 MB, and spawns a child that touches 256 MB:
; 880 MB if the heap's frames were kept, more than the board holds (see
; test_frames_run_out), and 624 MB as they are given back, so the child
; exits 0 rather than being ended for want of a frame.
(def test_release_frees_memory () int
  (check_int "the child's status"
    (boot_mods (cons (first (touch_words 65535 (release_words (movz_hi 0 49216) (movz_hi 1 4096)
                              (shm_16s 23 (spawn_wait_times 1 1)))))
                     (cons (toucher 65535) (nil Raw))))
    0))

; ------------------------------------------------------------------- pids

; Spawns module m and waits for it, n times over, the last pid in x20,
; then words.
(def spawn_wait_loop ((n int) (m int) (ws (list int))) (list int)
  (cons (movz 19 n)
    (cons (movz 0 m) (append (call_words (call_spawn))
      (cons (mov_reg 20 0) (append (call_words (call_wait))
        (cons (subs_imm 19 19 1) (cons (cbnz 19 -7) ws))))))))

; 300 processes, one after another: more than the table's 255 slots, so
; slots are reused, and the last one still runs and exits with 42.
(def test_more_than_255 () int
  (check_int "the last one's status"
    (boot_mods (cons (first (spawn_wait_loop 300 1 (exit_x0))) (cons (exits_with 42) (nil Raw))))
    42))

; Children 1 to 254 take slots 2 to 255, as pids 2 to 255; then slot 2
; again, as pid 258, and so on: the 300th is pid 303, in slot 47.
(def test_reused_slot_new_pid () int
  (check_int "the 300th pid"
    (boot_mods (cons (first (spawn_wait_loop 300 1 (cons (mov_reg 0 20) (exit_x0)))) (cons (exits_with 0) (nil Raw))))
    303))

(def test_proc_slot () int
  (check_int "slot 2, given twice"
    (boot_mods (cons (first (spawn_wait_loop 255 1 (cons (movz 0 2) (append (call_words (call_proc_slot)) (exit_x0)))))
                     (cons (exits_with 0) (nil Raw))))
    258))

(def test_proc_slot_bad () int
  (add (check_int "slot 0" (boot_words 0 (cons (movz 0 0) (append (call_words (call_proc_slot)) (exit_x0)))) (err_no_port))
       (check_int "never given" (boot_words 0 (cons (movz 0 9) (append (call_words (call_proc_slot)) (exit_x0)))) 0)))

; Once its slot is given again, an old pid names nothing: waiting for pid
; 2 after 255 children is refused, not a wait for pid 258.
(def test_old_pid_names_nothing () int
  (check_int "wait for pid 2"
    (boot_mods (cons (first (spawn_wait_loop 255 1 (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0)))))
                     (cons (exits_with 0) (nil Raw))))
    (err_no_port)))

; A status no one has asked for outlasts those that were: pid 1 starts
; pid 2, which exits with 7, then 300 more, each waited for; their slots
; are given again and again, but pid 2's is not, so waiting for it still
; gives 7.
(def test_untold_status_kept () int
  (check_int "pid 2's status"
    (boot_mods (cons (first (cons (movz 0 2) (append (call_words (call_spawn))
                              (spawn_wait_loop 300 1 (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0)))))))
                     (cons (exits_with 0) (cons (exits_with 7) (nil Raw)))))
    7))

; ------------------------------------------------- booting from a volume

; A partition's UUID, as fs mounts its volume with it.
(def sys_uuid () (list int) "018f0000-0000-7000-8000-000000000001")

; The UUID, a space, and data: 41 bytes.
(def uuid_data () (list int) (append (sys_uuid) " data"))

(def test_mount_uuid () int
  (add (check_int "mounted" (files_boot (mount_words 0 41 (exit_x0)) (uuid_data) "") 0)
       (check_int "the record: a port, /Volumes/data, NUL and the UUID"
                  (files_boot (mount_words 0 41 (mount_at_words 1 64)) (uuid_data) "") 54)))

(def test_mount_bad_uuid () int
  (check_int "not a UUID" (files_boot (mount_words 0 9 (exit_x0)) "1234 data" "") (err_fault)))

; root_switch of the len bytes at data byte at, then ws.
(def root_words ((at int) (len int) (ws (list int))) (list int)
  (cons (movz 0 0) (append (data_words 1 at) (cons (movz 2 len) (append (call_words (call_root_switch)) ws)))))

; data, with its UUID, mounted and made /: mount 0's record is then /,
; NUL and the UUID, from the server's port.
(def test_root_switch () int
  (add (check_int "made /" (files_boot (mount_words 0 41 (root_words 37 4 (exit_x0))) (uuid_data) "") 0)
       (check_int "mount 0" (files_boot (mount_words 0 41 (root_words 37 4 (mount_at_words 0 64))) (uuid_data) "") 42)))

(def test_root_switch_refused () int
  (add (check_int "no such volume" (files_boot (root_words 0 4 (exit_x0)) "data" "") (err_no_port))
       (add (check_int "twice" (files_boot (mount_words 0 41 (root_words 37 4 (root_words 37 4 (exit_x0)))) (uuid_data) "") (err_taken))
            (check_int "no label" (files_boot (root_words 0 0 (exit_x0)) "data" "") (err_fault)))))

; Once / is a volume, the initramfs is given up: no entry can be spawned
; or named.
(def test_root_frees () int
  (add (check_int "spawn"
                  (files_boot (mount_words 0 41 (root_words 37 4 (append (spawn_words 0) (exit_x0)))) (uuid_data) "")
                  (err_no_port))
       (check_int "module_name"
                  (files_boot (mount_words 0 41 (root_words 37 4 (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_module_name)) (exit_x0)))))))
                              (uuid_data) "")
                  (err_no_port))))

; A process started before the initramfs is given up runs on after: pid
; 1 spawns pid 2, makes data /, and waits for it, which exits with 42.
(def test_root_keeps_running () int
  (check_int "pid 2's status"
    (boot (raw_initramfs (cons (Raw (flag_boot) (with_data (append (spawn_words 1) (mount_words 0 41 (root_words 37 4 (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0))))))
                                                           (uuid_data)))
                               (cons (exits_with 42) (nil Raw)))))
    42))

; A file of the initramfs opened before reads as ended after: its stream
; kept in x20 while mount_words takes x19.
(def test_root_open_file_ends () int
  (check_int "read nothing"
    (files_boot (append (open_words 41 9 1)
                        (cons (mov_reg 20 0) (mount_words 0 41 (root_words 37 4 (cons (mov_reg 19 20) (append (read_x19) (exit_x0)))))))
                (append (uuid_data) "/etc/motd") "")
    0))

; The board's boot arguments: l0 test boots with the test's name, so
; argc, its length and test_boot_args, 22 bytes.
(def test_boot_args () int
  (check_int "one argument"
    (boot_words 0 (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 64) (append (call_words (call_boot_args)) (exit_x0))))))
    22))

; ------------------------------------------------------------ spawn_image

; What spawn_image takes: the path's length and the path, the arguments'
; length and the arguments, encoded, then the image.
(def image_bytes ((path (list int)) (args (list int)) (image (list int))) (list int)
  (append (u32_le (length path)) (append path (append (u32_le (length args)) (append args image)))))

; spawn_image of the len bytes at data byte 0, then ws, pid or code in x0.
(def image_words ((len int) (ws (list int))) (list int)
  (cons (movz 0 0) (append (data_words 1 0) (cons (movz 2 len) (append (call_words (call_spawn_image)) ws)))))

; Spawns the image b from pid 1's data, waits for it, and exits with its
; status, or with the refusal.
(def image_boot ((b (list int))) int
  (files_boot (image_words (length b) (append (call_words (call_wait)) (exit_x0))) b ""))

(def test_spawn_image () int
  (check_int "exits 9" (image_boot (image_bytes "/bin/x" "" (code (cons (movz 0 9) (exit_x0))))) 9))

(def test_spawn_image_args () int
  (add (check_int "two given" (image_boot (image_bytes "/bin/x" (encode_args (split_spaces "a b")) (code (append (call_words (sys_arg_count)) (exit_x0))))) 2)
       (check_int "none, the inittab's" (image_boot (image_bytes "/bin/x" "" (code (append (call_words (sys_arg_count)) (exit_x0))))) 0)))

; An image never drives a device, nor makes / a volume.
(def test_spawn_image_no_dev () int
  (add (check_int "region" (image_boot (image_bytes "/bin/x" "" (code (region_words)))) (wait_word -3))
       (check_int "root_switch" (image_boot (image_bytes "/bin/x" "" (with_data (root_words 0 4 (exit_x0)) "data"))) (wait_word (err_denied)))))

(def test_spawn_image_refused () int
  (add (check_int "too short" (files_boot (image_words 4 (exit_x0)) "abcd" "") (err_fault))
       (add (check_int "no path" (files_boot (image_words 12 (exit_x0)) (image_bytes "" "" (zeros 4)) "") (err_fault))
            (add (check_int "no image" (files_boot (image_words 14 (exit_x0)) (image_bytes "/bin/x" "" "") "") (err_denied))
                 (check_int "bad arguments" (files_boot (image_words 20 (exit_x0)) (image_bytes "/bin/x" "ab" "abcd") "") (err_fault))))))

; Its process is named by its path: the record and /bin/x, while it runs.
(def test_spawn_image_named () int
  (let b (image_bytes "/bin/x" "" (code (cons (b_self) (nil int))))
    (check_int "24 and 6" (files_boot (image_words (length b) (info_words 2 64 (nil int))) b "") 30)))

(def test_spawn_image_elf () int
  (check_int "exits 9" (image_boot (image_bytes "/bin/x" "" (elf_code (cons (movz 0 9) (exit_x0)) (nil Part)))) 9))

; An ELF the kernel does not load: spawn_image's own answer.
(def test_spawn_image_elf_refused () int
  (let b (image_bytes "/bin/x" "" (elf_image (em_aarch64) (user_base) (cons (Part (user_base) (pf_rwx) (code_bytes (exit_x0)) 8) (nil Part))))
    (check_int "writable code" (files_boot (image_words (length b) (exit_x0)) b "") (err_denied))))

; ------------------------------------------------------------------- ELF

; Boots one ELF program, started at boot.
(def boot_elf ((img (list int))) int
  (boot (raw_initramfs (cons (Raw (flag_boot) img) (nil Raw)))))

; x1 = user_base plus n pages.
(def page_words ((n int)) (list int)
  (cons (movz_hi 1 49152) (cons (add_imm_hi 1 1 n) (nil int))))

(def test_elf_exit () int
  (check_int "exit 7" (boot_elf (elf_code (cons (movz 0 7) (exit_x0)) (nil Part))) 7))

; Its code is readable: the second instruction's word, ldr w0, [x1, #4].
(def test_elf_code_readable () int
  (check_int "ldr w0, [x1, #4]"
    (boot_elf (elf_code (cons (movz_hi 1 49152) (cons (ldr_w0_x1_4) (exit_x0))) (nil Part)))
    (ldr_w0_x1_4)))

; But not writable: a store to it is a fault, which kills the process.
(def test_elf_code_not_writable () int
  (check_int "killed"
    (boot_elf (elf_code (cons (movz_hi 1 49152) (cons (str_x0_x1) (cons (movz 0 7) (exit_x0)))) (nil Part)))
    139))

; Its rodata, "hello" a page in, is readable but not writable.
(def rodata () (list Part) (cons (Part (add (user_base) 4096) (pf_r) "hello" 5) (nil Part)))

(def test_elf_rodata () int
  (add (check_int "the o of hello" (boot_elf (elf_code (append (page_words 1) (cons (ldr_w0_x1_4) (exit_x0))) (rodata))) 111)
       (check_int "a store killed" (boot_elf (elf_code (append (page_words 1) (cons (str_x0_x1) (exit_x0))) (rodata))) 139)))

; Data's bytes are its file's, and its bss, 6 MB past the 4 MB a raw image
; may have, is zero and writable to its last page, 0xC0600000.
(def big_data () (list Part) (cons (Part (add (user_base) 4096) (pf_rw) "abcd*" 6291456) (nil Part)))

(def test_elf_data () int
  (check_int "the *" (boot_elf (elf_code (append (page_words 1) (cons (ldr_w0_x1_4) (exit_x0))) (big_data))) 42))

(def test_elf_big_bss () int
  (check_int "stored and loaded"
    (boot_elf (elf_code (append (page_words 1536) (cons (ldr_x0_x1) (cons (movz 0 9) (cons (str_x0_x1) (cons (movz 0 0) (cons (ldr_x0_x1) (exit_x0)))))))
                        (big_data)))
    9))

; The heap starts at the page after the image, here its one page of code,
; and is mapped on demand there.
(def test_elf_heap_after_image () int
  (check_int "stored and loaded"
    (boot_elf (elf_code (append (page_words 1) (cons (movz 0 9) (cons (str_x0_x1) (cons (movz 0 0) (cons (ldr_x0_x1) (exit_x0)))))) (nil Part)))
    9))

; The kernel copies a name into its data, and not into its code: -5.
(def name_words ((pages int)) (list int)
  (cons (movz 0 0) (append (page_words pages) (cons (movz 2 64) (append (call_words (call_module_name)) (exit_x0))))))

(def test_elf_copy_in () int
  (add (check_int "into the data" (boot_elf (elf_code (name_words 1) (big_data))) 11)
       (check_int "into the code" (boot_elf (elf_code (name_words 0) (nil Part))) (err_fault))))

; Pid 1 spawns module 1 and exits with what spawning it gives.
(def spawn_one ((img (list int))) int
  (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn)) (append (call_words (call_wait)) (exit_x0)))))
                   (cons (Raw 0 img) (nil Raw)))))

(def test_elf_spawned () int
  (check_int "its status" (spawn_one (elf_code (cons (movz 0 42) (exit_x0)) (nil Part))) 42))

(def spawned_why ((img (list int))) int
  (boot_mods (cons (first (cons (movz 0 1) (append (call_words (call_spawn)) (exit_x0))))
                   (cons (Raw 0 img) (nil Raw)))))

(def test_elf_other_cpu_refused () int
  (check_int "not a program"
    (spawned_why (elf_image (em_riscv) (user_base) (cons (Part (user_base) (pf_rx) (code_bytes (exit_x0)) 8) (nil Part))))
    (err_denied)))

; A raw image, as toolchains wrote them before ELF, is no program.
(def test_raw_image_refused () int
  (check_int "not a program" (spawned_why (code_bytes (cons (movz 0 42) (exit_x0)))) (err_denied)))

(def test_elf_malformed_refused () int
  (add (check_int "cut short" (spawned_why (take (elf_code (exit_x0) (nil Part)) 4100)) (err_denied))
       (check_int "only a header" (spawned_why (take (elf_code (exit_x0) (nil Part)) 64)) (err_denied))))

; ---------------------------------------------------- current directory

; The len bytes at data byte at made the current directory, then ws.
(def chdir_words ((at int) (len int) (ws (list int))) (list int)
  (cons (movz 0 0) (append (data_words 1 at) (cons (movz 2 len) (append (call_words (call_chdir)) ws)))))

; The current directory copied to the heap, max bytes at most, and the
; length exited with.
(def getcwd_words ((max int)) (list int)
  (cons (movz 0 0) (cons (movz_hi 1 49216) (cons (movz 2 max) (append (call_words (call_getcwd)) (exit_x0))))))

(def test_cwd_at_boot () int
  (check_int "/" (files_boot (getcwd_words 64) "" "") 1))

(def test_chdir_then_open () int
  (check_int "motd, from /etc: stream 3"
    (files_boot (chdir_words 0 4 (append (open_words 4 4 1) (exit_x0))) "/etcmotd" "") 3))

(def test_chdir_refused () int
  (add (check_int "no such directory" (files_boot (chdir_words 0 5 (exit_x0)) "/nope" "") -3)
       (check_int "a file" (files_boot (chdir_words 0 9 (exit_x0)) "/etc/motd" "") -9)))

(def test_chdir_too_long () int
  (check_int "1025 bytes" (files_boot (chdir_words 0 1025 (exit_x0)) "" "") -5))

(def test_chdir_bad_buffer () int
  (check_int "from below the user range"
    (boot_words 0 (cons (movz 0 0) (cons (movz 1 16) (cons (movz 2 4) (append (call_words (call_chdir)) (exit_x0)))))) -5))

; Its . and .. taken out, the new directory is as long as its text.
(def test_chdir_dots () int
  (add (check_int "/etc/.. is /" (files_boot (chdir_words 0 7 (getcwd_words 64)) "/etc/.." "") 1)
       (add (check_int "/etc/../etc/. is /etc" (files_boot (chdir_words 0 13 (getcwd_words 64)) "/etc/../etc/." "") 4)
            (check_int "past the top" (files_boot (chdir_words 0 6 (getcwd_words 64)) "/../.." "") 1))))

; A relative path goes from the current directory, and .. leaves it.
(def test_chdir_relative () int
  (add (check_int "/etc, then .. is /" (files_boot (chdir_words 0 4 (chdir_words 4 2 (getcwd_words 64))) "/etc.." "") 1)
       (check_int "/etc, then motd is a file" (files_boot (chdir_words 0 4 (chdir_words 4 4 (exit_x0))) "/etcmotd" "") -9)))

(def test_chdir_volumes () int
  (check_int "/Volumes is one" (files_boot (chdir_words 0 8 (getcwd_words 64)) "/Volumes" "") 8))

(def test_chdir_unmounted () int
  (check_int "no volume data" (files_boot (chdir_words 0 13 (exit_x0)) "/Volumes/data" "") -3))

(def test_getcwd_short () int
  (check_int "room for 2 of /etc" (files_boot (chdir_words 0 4 (getcwd_words 2)) "/etc" "") (err_too_big)))

; rename and remove take the same relative paths as open.
(def test_chdir_remove () int
  (add (check_int "motd, an existing file" (files_boot (chdir_words 0 4 (path_call 4 4 (sys_remove))) "/etcmotd" "") -4)
       (check_int "nope, a missing one" (files_boot (chdir_words 0 4 (path_call 4 4 (sys_remove))) "/etcnope" "") -3)))

; A child, started by spawn, spawn_args or spawn_image, has its parent's
; current directory: /etc, four bytes, which it exits with.
(def cwd_child () Raw (Raw 0 (code (getcwd_words 64))))

(def cwd_files () (list RawFile) (cons (RawFile "etc" 16877 "") (nil RawFile)))

(def test_chdir_inherited_spawn () int
  (check_int "its child's /etc"
    (boot (raw_initramfs_with
            (cons (Raw (flag_boot) (with_data (chdir_words 0 4 (append (spawn_words 1) (append (call_words (call_wait)) (exit_x0)))) "/etc"))
                  (cons (cwd_child) (nil Raw)))
            (cwd_files) ""))
    4))

(def test_chdir_inherited_spawn_args () int
  (check_int "its child's /etc"
    (boot (raw_initramfs_with
            (cons (Raw (flag_boot)
                    (with_data (chdir_words 0 4 (cons (movz 0 1) (append (data_words 1 8) (cons (movz 2 4)
                                  (append (call_words (call_spawn_args)) (append (call_words (call_wait)) (exit_x0)))))))
                               (append (pad_to 8 "/etc") (encode_args (nil (list int))))))
                  (cons (cwd_child) (nil Raw)))
            (cwd_files) ""))
    4))

(def test_chdir_inherited_spawn_image () int
  (let b (image_bytes "/bin/x" "" (code (getcwd_words 64)))
    (check_int "its child's /etc"
      (files_boot (chdir_words 0 4 (cons (movz 0 0) (append (data_words 1 4) (cons (movz 2 (length b))
                    (append (call_words (call_spawn_image)) (append (call_words (call_wait)) (exit_x0)))))))
                  (append "/etc" b) "")
      4)))

; ---------------------------------------------- chdir in a volume

; pid 1 mounts data and answers the one request pid 2's chdir makes with
; the len bytes at its data byte 8, the reply's word, 0, and what stat
; says; pid 2 exits with chdir's answer, or, with getcwd, the length of
; its directory after.
(def chdir_served ((reply (list int)) (client (list int))) int
  (boot (raw_initramfs (cons (Raw (flag_boot) (with_data (mount_words 0 4 (receive_words (stat_answer_words (length reply)))) (append (pad_to 8 "data") reply)))
                             (cons (Raw (flag_boot) (with_data client "/Volumes/data/a")) (nil Raw))))))

; The len bytes at data byte 8 sent to the reply port of the request in
; the heap, then pid 2 waited for, and its status the exit's.
(def stat_answer_words ((len int)) (list int)
  (cons (movz_hi 1 49216) (cons (ldr_w0_x1_4)
    (append (data_words 1 8) (cons (movz 2 len) (append (call_words (call_send))
      (cons (movz 0 2) (append (call_words (call_wait)) (exit_x0)))))))))

(def test_chdir_served_dir () int
  (add (check_int "a directory: 0" (chdir_served (append (u32_le 0) "dir") (chdir_words 0 15 (exit_x0))) 0)
       (check_int "and the directory is its own: 15 bytes"
         (chdir_served (append (u32_le 0) "dir") (chdir_words 0 15 (getcwd_words 64))) 15)))

(def test_chdir_served_file () int
  (check_int "a file: -9" (chdir_served (append (u32_le 0) "file 1 -") (chdir_words 0 15 (exit_x0))) (wait_word -9)))

(def test_chdir_served_missing () int
  (check_int "the server says -3" (chdir_served (u32_le -3) (chdir_words 0 15 (exit_x0))) (wait_word -3)))

; pid 1 yields, so pid 2 mounts data first; pid 2 takes pid 1's request
; and exits without answering: pid 1's chdir is answered -5.
(def test_chdir_server_gone () int
  (check_int "-5"
    (boot (raw_initramfs (cons (Raw (flag_boot) (with_data (append (call_words (call_yield)) (chdir_words 0 15 (exit_x0))) "/Volumes/data/a"))
                               (cons (Raw (flag_boot) (with_data (mount_words 0 4 (receive_words (cons (movz 0 0) (exit_x0)))) "data")) (nil Raw)))))
    -5))
