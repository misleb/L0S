; mounts_test.l0 -- tests of the mount table and where a path's file is.

; A partition's UUID, as fs mounts it.
(def sys_uuid () (list int) "018f0000-0000-7000-8000-000000000001")

; The initramfs, then data from port 5 and scratch from port 9.
(def two () (list Mount)
  (cons (MountRoot) (cons (MountServer "data" "" 5) (cons (MountServer "scratch" (sys_uuid) 9) (nil Mount)))))

; two with scratch made /.
(def switched () (list Mount)
  (match (mount_root (two) "scratch") ((MountAdded ms) ms) ((MountRefused code) (two))))

; Where path is in ms, as text.
(def where_in ((ms (list Mount)) (path (list int))) (list int)
  (match (mount_where ms path)
    ((InRoot) "root")
    ((InVolumes) "volumes")
    ((InServer port p) (append "server " (append (digits port) (append " " p))))
    ((InNothing direct) (if direct "nothing, in /Volumes" "nothing"))))

(def where_text ((path (list int))) (list int) (where_in (two) path))

(def test_where_root () int
  (add (check_str "/etc/motd" (where_text "/etc/motd") "root")
       (add (check_str "/" (where_text "/") "root")
            (check_str "a name like it" (where_text "/Volumesx") "root"))))

(def test_where_volumes () int
  (check_str "/Volumes" (where_text "/Volumes") "volumes"))

(def test_where_server () int
  (add (check_str "a file" (where_text "/Volumes/data/notes") "server 5 /Volumes/data/notes")
       (add (check_str "the volume" (where_text "/Volumes/scratch") "server 9 /Volumes/scratch")
            (check_str "deeper" (where_text "/Volumes/data/a/b") "server 5 /Volumes/data/a/b"))))

(def test_where_nothing () int
  (add (check_str "in /Volumes" (where_text "/Volumes/notes") "nothing, in /Volumes")
       (check_str "in no volume" (where_text "/Volumes/other/notes") "nothing")))

; Once scratch is /, every path but /Volumes's is scratch's, asked for in
; /Volumes/scratch; and scratch is there too.
(def test_where_switched () int
  (add (check_str "/etc/motd" (where_in (switched) "/etc/motd") "server 9 /Volumes/scratch/etc/motd")
       (add (check_str "/" (where_in (switched) "/") "server 9 /Volumes/scratch")
            (add (check_str "in /Volumes" (where_in (switched) "/Volumes/scratch/a") "server 9 /Volumes/scratch/a")
                 (check_str "data" (where_in (switched) "/Volumes/data/a") "server 5 /Volumes/data/a")))))

; Where a rename from a to b goes, on the two volumes.
(def route ((a (list int)) (b (list int))) int
  (rename_route (mount_where (two) a) (mount_where (two) b)))

(def test_rename_route () int
  (add (check_int "the initramfs" (route "/etc/a" "/etc/b") 0)
       (add (check_int "within data" (route "/Volumes/data/a" "/Volumes/data/b") 5)
            (check_int "data to scratch" (route "/Volumes/data/a" "/Volumes/scratch/a") -10))))

(def test_rename_route_between () int
  (add (check_int "to the initramfs" (route "/Volumes/data/a" "/etc/a") -10)
       (add (check_int "from it" (route "/etc/a" "/Volumes/data/a") -10)
            (check_int "from nowhere" (route "/Volumes/x/a" "/Volumes/data/a") -3))))

(def test_rename_route_volumes () int
  (add (check_int "to /Volumes" (route "/Volumes/data/a" "/Volumes") -8)
       (add (check_int "into /Volumes" (route "/Volumes/data/a" "/Volumes/a") -4)
            (add (check_int "to no volume" (route "/Volumes/data/a" "/Volumes/x/a") -9)
                 (check_int "/Volumes itself" (route "/Volumes" "/Volumes/data/a") -4)))))

; On the system volume, a rename from / into its own volume is one file
; system, and to another is not.
(def test_rename_route_switched () int
  (add (check_int "/ to its volume" (rename_route (mount_where (switched) "/a") (mount_where (switched) "/Volumes/scratch/b")) 9)
       (check_int "/ to data" (rename_route (mount_where (switched) "/a") (mount_where (switched) "/Volumes/data/b")) -10)))

(def test_new () int
  (check_true "the initramfs alone" (eq (mounts_new) (cons (MountRoot) (nil Mount)))))

(def test_add () int
  (match (mount_add (mounts_new) "data" (sys_uuid) 5)
    ((MountAdded ms) (check_true "after the root" (eq ms (cons (MountRoot) (cons (MountServer "data" (sys_uuid) 5) (nil Mount))))))
    ((MountRefused code) (fail_because "add" (digits code)))))

(def test_add_refused () int
  (add (check_int "taken" (refusal (two) "data") (err_taken))
       (add (check_int "a slash" (refusal (two) "a/b") (err_fault))
            (add (check_int "empty" (refusal (two) "") (err_fault))
                 (check_int "16 letters" (refusal (two) "abcdefghijklmnop") (err_fault))))))

; Why label cannot be mounted on ms, or 0 if it can.
(def refusal ((ms (list Mount)) (label (list int))) int
  (match (mount_add ms label "" 7) ((MountAdded m2) 0) ((MountRefused code) code)))

(def test_root () int
  (check_true "scratch at /, and in /Volumes"
              (eq (switched) (cons (MountSystem "scratch" (sys_uuid) 9) (cons (MountServer "data" "" 5) (cons (MountServer "scratch" (sys_uuid) 9) (nil Mount)))))))

; / is made a volume once, and only one that is mounted.
(def test_root_refused () int
  (add (check_int "again" (match (mount_root (switched) "data") ((MountAdded ms) 0) ((MountRefused code) code)) (err_taken))
       (check_int "no such volume" (match (mount_root (two) "other") ((MountAdded ms) 0) ((MountRefused code) code)) (err_no_port))))

(def test_root_is_initramfs () int
  (add (check_true "before" (root_is_initramfs (two)))
       (check_bool "after" (root_is_initramfs (switched)) false)))

(def test_without () int
  (check_true "scratch's port gone" (eq (mounts_without (two) (cons 9 (cons 3 (nil int))))
                                        (cons (MountRoot) (cons (MountServer "data" "" 5) (nil Mount))))))

; The system volume's server gone: / stays, though nothing answers there,
; and only its place in /Volumes goes.
(def test_without_system () int
  (check_true "/ kept" (eq (mounts_without (switched) (cons 9 (nil int)))
                           (cons (MountSystem "scratch" (sys_uuid) 9) (cons (MountServer "data" "" 5) (nil Mount))))))

; The code mount_remove refuses with, or 0 and the table it leaves.
(def removed ((r MountAdd)) (list Mount)
  (match r ((MountAdded ms) ms) ((MountRefused code) (cons (MountServer "refused" (digits code) code) (nil Mount)))))

; A volume unmounted by the port that mounted it: only it goes.
(def test_remove () int
  (check_true "scratch gone" (eq (removed (mount_remove (two) "scratch" 9))
                                 (cons (MountRoot) (cons (MountServer "data" "" 5) (nil Mount))))))

; Another port's volume, one not mounted, and no label at all are
; refused.
(def test_remove_refused () int
  (add (check_true "not its port" (eq (removed (mount_remove (two) "scratch" 5)) (removed (MountRefused (err_no_port)))))
       (add (check_true "not mounted" (eq (removed (mount_remove (two) "other" 9)) (removed (MountRefused (err_no_port)))))
            (check_true "no label" (eq (removed (mount_remove (two) "a b" 9)) (removed (MountRefused (err_fault))))))))

; The system volume is / for good: neither it nor its place in /Volumes
; is unmounted.
(def test_remove_system () int
  (add (check_true "kept" (eq (removed (mount_remove (switched) "scratch" 9)) (removed (MountRefused (err_denied)))))
       (check_true "but data goes" (eq (removed (mount_remove (switched) "data" 5))
                                       (cons (MountSystem "scratch" (sys_uuid) 9) (cons (MountServer "scratch" (sys_uuid) 9) (nil Mount)))))))

(def test_at () int
  (add (check_true "0 the root" (eq (mounts_at (two) 0) (Some (MountRoot))))
       (add (check_true "2 scratch" (eq (mounts_at (two) 2) (Some (MountServer "scratch" (sys_uuid) 9))))
            (add (check_true "none at 3" (eq (mounts_at (two) 3) ((None Mount))))
                 (check_true "none at -1" (eq (mounts_at (two) -1) ((None Mount))))))))

(def test_record () int
  (add (check_str "data" (mount_record (MountServer "data" "" 5)) (append (u32_le 5) "/Volumes/data"))
       (add (check_str "the root" (mount_record (MountRoot)) (append (u32_le 0) "/"))
            (check_str "the system volume" (mount_record (MountSystem "scratch" (sys_uuid) 9))
                       (append (u32_le 9) (append "/" (cons 0 (sys_uuid))))))))

(def test_name_of () int
  (add (check_true "a label" (eq (mount_name_of "data") (MountName "" "data")))
       (add (check_true "a UUID and a label" (eq (mount_name_of (append (sys_uuid) " sys")) (MountName (sys_uuid) "sys")))
            (check_true "not a UUID" (eq (mount_name_of "abc sys") (MountNameBad))))))
