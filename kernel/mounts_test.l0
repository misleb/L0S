; mounts_test.l0 -- tests of the mount table and where a path's file is.

; The initramfs, then data from port 5 and scratch from port 9.
(def two () (list Mount)
  (cons (MountRoot) (cons (MountServer "data" 5) (cons (MountServer "scratch" 9) (nil Mount)))))

; Where path is, as text.
(def where_text ((path (list int))) (list int)
  (match (mount_where (two) path)
    ((InRoot) "root")
    ((InVolumes) "volumes")
    ((InServer port) (append "server " (digits port)))
    ((InNothing direct) (if direct "nothing, in /Volumes" "nothing"))))

(def test_where_root () int
  (add (check_str "/etc/motd" (where_text "/etc/motd") "root")
       (add (check_str "/" (where_text "/") "root")
            (check_str "a name like it" (where_text "/Volumesx") "root"))))

(def test_where_volumes () int
  (check_str "/Volumes" (where_text "/Volumes") "volumes"))

(def test_where_server () int
  (add (check_str "a file" (where_text "/Volumes/data/notes") "server 5")
       (add (check_str "the volume" (where_text "/Volumes/scratch") "server 9")
            (check_str "deeper" (where_text "/Volumes/data/a/b") "server 5"))))

(def test_where_nothing () int
  (add (check_str "in /Volumes" (where_text "/Volumes/notes") "nothing, in /Volumes")
       (check_str "in no volume" (where_text "/Volumes/other/notes") "nothing")))

; Where a rename from a to b goes, on the two volumes.
(def route ((a (list int)) (b (list int))) int
  (rename_route (mount_where (two) a) (mount_where (two) b)))

(def test_rename_route () int
  (add (check_int "the initramfs" (route "/etc/a" "/etc/b") 0)
       (add (check_int "within data" (route "/Volumes/data/a" "/Volumes/data/b") 5)
            (check_int "data to scratch" (route "/Volumes/data/a" "/Volumes/scratch/a") -10))))

(def test_rename_route_between () int
  (add (check_int "to the initramfs" (route "/Volumes/data/a" "/etc/a") -10)
       (add (check_int "from it" (route "/etc/a" "/Volumes/data/a") -10)
            (check_int "from nowhere" (route "/Volumes/x/a" "/Volumes/data/a") -3))))

(def test_rename_route_volumes () int
  (add (check_int "to /Volumes" (route "/Volumes/data/a" "/Volumes") -8)
       (add (check_int "into /Volumes" (route "/Volumes/data/a" "/Volumes/a") -4)
            (add (check_int "to no volume" (route "/Volumes/data/a" "/Volumes/x/a") -9)
                 (check_int "/Volumes itself" (route "/Volumes" "/Volumes/data/a") -4)))))

(def test_new () int
  (check_true "the initramfs alone" (eq (mounts_new) (cons (MountRoot) (nil Mount)))))

(def test_add () int
  (match (mount_add (mounts_new) "data" 5)
    ((MountAdded ms) (check_true "after the root" (eq ms (cons (MountRoot) (cons (MountServer "data" 5) (nil Mount))))))
    ((MountRefused code) (fail_because "add" (digits code)))))

(def test_add_refused () int
  (add (check_int "taken" (refusal (two) "data") (err_taken))
       (add (check_int "a slash" (refusal (two) "a/b") (err_fault))
            (add (check_int "empty" (refusal (two) "") (err_fault))
                 (check_int "16 letters" (refusal (two) "abcdefghijklmnop") (err_fault))))))

; Why label cannot be mounted on ms, or 0 if it can.
(def refusal ((ms (list Mount)) (label (list int))) int
  (match (mount_add ms label 7) ((MountAdded m2) 0) ((MountRefused code) code)))

(def test_without () int
  (check_true "scratch's port gone" (eq (mounts_without (two) (cons 9 (cons 3 (nil int))))
                                        (cons (MountRoot) (cons (MountServer "data" 5) (nil Mount))))))

(def test_at () int
  (add (check_true "0 the root" (eq (mounts_at (two) 0) (Some (MountRoot))))
       (add (check_true "2 scratch" (eq (mounts_at (two) 2) (Some (MountServer "scratch" 9))))
            (add (check_true "none at 3" (eq (mounts_at (two) 3) ((None Mount))))
                 (check_true "none at -1" (eq (mounts_at (two) -1) ((None Mount))))))))

(def test_record () int
  (add (check_str "data" (mount_record (MountServer "data" 5)) (append (u32_le 5) "/Volumes/data"))
       (check_str "the root" (mount_record (MountRoot)) (append (u32_le 0) "/"))))
