; usage.l0 -- how the CPUs are used: each process's CPU time, the CPU it
; last ran on, and when it started; each CPU's busy time; CPU 0's time
; waiting; and the load averages, as Unix keeps them. Pure: the kernel
; reads the clock and says what ran where and for how long, and cpus.l0
; keeps this beside what it handed where.

; What the kernel counts: when it started counting, at boot; by slot of
; the process table, each process's CPU time in ns, the CPU it last ran
; on (-1 for none yet), and when it started; by CPU, the time each was
; busy with a process, and when the process it is running began to run
; there (cpus_place, cpus_back); the time CPU 0 spent waiting; and the
; load: the averages over 1, 5 and 15 minutes, in fixed point of
; usage_fixed, then when they are next sampled.
(data Usage (Usage (start int) (times (array int)) (last (array int)) (born (array int)) (busy (array int)) (from (array int)) (waited int) (load (array int))))

; The slots a process table has, as pids.l0's slot_of numbers them: 0 to
; 255, a pid's low 8 bits.
(def usage_slots () int 256)
(def usage_slot ((pid int)) int (bit_and pid 255))

; How often the load is sampled: every 5 s, as Unix does.
(def usage_tick_ns () int 5000000000)

; The load averages' fixed point: 11 bits, 1.0 as 2048; and each
; average's decay over one tick, 2048 / e^(5/60), e^(5/300) and e^(5/900),
; Linux's EXP_1, EXP_5 and EXP_15.
(def usage_fixed () int 2048)
(def usage_exp ((i int)) int (if (eq i 0) 1884 (eq i 1) 2014 2037))

; The counts for cpus CPUs, started at now: nothing run, the load 0.
(def usage_new ((cpus int) (now int)) Usage
  (let n (max cpus 1)
    (Usage now (array_new (usage_slots) 0) (array_new (usage_slots) -1) (array_new (usage_slots) now)
           (array_new n 0) (array_new n now) 0
           (array_set (array_new 4 0) 3 (add now (usage_tick_ns))))))

; ----------------------------------------------------------------- readers

; How many CPUs u counts.
(def usage_cpus ((u Usage)) int (match u ((Usage at times last born busy from waited load) (array_len busy))))

; pid's CPU time, in ns.
(def usage_time ((u Usage) (pid int)) int
  (match u ((Usage at times last born busy from waited load) (array_get times (usage_slot pid)))))

; The CPU pid last ran on, -1 if it has not run.
(def usage_last ((u Usage) (pid int)) int
  (match u ((Usage at times last born busy from waited load) (array_get last (usage_slot pid)))))

; When pid started.
(def usage_born ((u Usage) (pid int)) int
  (match u ((Usage at times last born busy from waited load) (array_get born (usage_slot pid)))))

; How long CPU i was busy with processes, in ns; 0 for no CPU i.
(def usage_busy ((u Usage) (i int)) int
  (match u
    ((Usage at times last born busy from waited load)
      (if (or (lt i 0) (ge i (array_len busy))) 0 (array_get busy i)))))

; The load average i (0 over 1 minute, 1 over 5, 2 over 15), in fixed
; point of usage_fixed.
(def usage_load ((u Usage) (i int)) int
  (match u ((Usage at times last born busy from waited load) (array_get load i))))

; When the load is next sampled.
(def usage_next_tick ((u Usage)) int (usage_load u 3))

; ----------------------------------------------------------------- counting

; u with pid started at now, in its slot: no time, no CPU yet.
(def usage_started ((u Usage) (pid int) (now int)) Usage
  (match u
    ((Usage at times last born busy from waited load)
      (let s (usage_slot pid)
        (Usage at (array_set times s 0) (array_set last s -1) (array_set born s now) busy from waited load)))))

; u with t ns more of pid's run on CPU cpu: its time, its last CPU, and
; that CPU's busy time. A t below 0, or a CPU u does not count, adds
; nothing.
(def usage_charge ((u Usage) (pid int) (cpu int) (t int)) Usage
  (match u
    ((Usage at times last born busy from waited load)
      (if (or (lt t 0) (or (lt cpu 0) (ge cpu (array_len busy))))
          (Usage at times last born busy from waited load)
          (let s (usage_slot pid)
            (Usage at (array_set times s (add (array_get times s) t)) (array_set last s cpu) born
                   (array_set busy cpu (add (array_get busy cpu) t)) from waited load))))))

; u with a thread handed at now to CPU cpu, which held none if idle: the
; thread begins to run there now. A CPU already holding one runs it
; first, and the new one from that one's return (usage_back).
(def usage_placed ((u Usage) (cpu int) (now int) (idle bool)) Usage
  (match u
    ((Usage at times last born busy from waited load)
      (if (or (not idle) (or (lt cpu 0) (ge cpu (array_len busy))))
          (Usage at times last born busy from waited load)
          (Usage at times last born busy (array_set from cpu now) waited load)))))

; u with pid's thread back at now from CPU cpu, where it was handed at
; handed: charged from the later of handed and the return of the thread
; before it there, to now; and the CPU's next thread running from now.
(def usage_back ((u Usage) (pid int) (cpu int) (handed int) (now int)) Usage
  (if (or (lt cpu 0) (ge cpu (usage_cpus u)))
      u
      (let began (max handed (usage_from u cpu))
        (match (usage_charge u pid cpu (sub now began))
          ((Usage at times last born busy from waited load)
            (Usage at times last born busy (array_set from cpu now) waited load))))))

; When CPU i's thread began to run there.
(def usage_from ((u Usage) (i int)) int
  (match u ((Usage at times last born busy from waited load) (array_get from i))))

; u with t ns more of CPU 0 waiting.
(def usage_wait ((u Usage) (t int)) Usage
  (.waited u (add (.waited u) (max 0 t))))

; ------------------------------------------------------------------- load

; Whether the load is due to be sampled at now.
(def usage_due ((u Usage) (now int)) bool (ge now (usage_next_tick u)))

; One average's next value, as Linux's calc_load: load decayed by e,
; with n threads ready or running, each 1.0, rounded up while the load
; rises.
(def load_next ((load int) (e int) (n int)) int
  (let (active (mul (max 0 n) (usage_fixed))
        v (add (mul load e) (mul active (sub (usage_fixed) e))))
    (div (if (ge active load) (add v (sub (usage_fixed) 1)) v) (usage_fixed))))

; u with the load sampled at now, n threads ready or running: once for
; each tick due by now, at most usage_ticks_max of them, each with n, as
; the kernel waits for each tick (spec kernel.md) and so misses none
; while anything runs.
(def usage_tick ((u Usage) (now int) (n int)) Usage
  (usage_ticks u now n (usage_ticks_max)))

; At most this many ticks are caught up at once: 15 minutes of them, by
; when every average has forgotten what came before.
(def usage_ticks_max () int 180)

; usage_tick's loop: each tick due by now sampled, at most left more.
(def usage_ticks ((u Usage) (now int) (n int) (left int)) Usage
  (if (or (le left 0) (not (usage_due u now)))
      (usage_skip u now)
      (usage_ticks (usage_sampled u n) now n (sub left 1))))

; u with its next tick after now, if it was due, for ticks too many to
; catch up.
(def usage_skip ((u Usage) (now int)) Usage
  (if (usage_due u now)
      (match u
        ((Usage at times last born busy from waited load)
          (Usage at times last born busy from waited (array_set load 3 (add now (usage_tick_ns))))))
      u))

; u with one tick's sample of n threads taken, and the next tick set.
(def usage_sampled ((u Usage) (n int)) Usage
  (match u
    ((Usage at times last born busy from waited load)
      (let (a (load_next (array_get load 0) (usage_exp 0) n)
            b (load_next (array_get load 1) (usage_exp 1) n)
            c (load_next (array_get load 2) (usage_exp 2) n)
            t (add (array_get load 3) (usage_tick_ns)))
        (Usage at times last born busy from waited
               (array_set (array_set (array_set (array_set load 0 a) 1 b) 2 c) 3 t))))))

; ---------------------------------------------------------------- records

; The cpu_record of u at now, abi.l0's: the load, the time since u
; started, CPU 0's time waiting, and each CPU's busy time.
(def usage_record ((u Usage) (now int)) (list int)
  (cpu_record (usage_load u 0) (usage_load u 1) (usage_load u 2) (max 0 (sub now (.start u)))
              (.waited u) (usage_busy_list u 0 (nil int))))

; Each CPU's busy time, from CPU i on, after the reversed acc.
(def usage_busy_list ((u Usage) (i int) (acc (list int))) (list int)
  (if (ge i (usage_cpus u))
      (rev acc)
      (usage_busy_list u (add i 1) (cons (usage_busy u i) acc))))

; The proc_cpu_record of pid at now, abi.l0's: its CPU time, cpu, the
; CPU it is on or last ran on, and how long it has run.
(def usage_proc_record ((u Usage) (pid int) (cpu int) (now int)) (list int)
  (proc_cpu_record (usage_time u pid) cpu (max 0 (sub now (usage_born u pid)))))
