; log_test.l0 -- tests of log.l0: numbering, dropping the oldest, and reading from a number.

; A ring of the messages "m0", "m1", ... n of them, one a second, by pid 3.
(def filled ((n int)) KLog (filled_from (klog_new) 0 n))

(def filled_from ((log KLog) (i int) (n int)) KLog
  (if (ge i n)
      log
      (filled_from (klog_add log 3 (log_info) (append "m" (digits i)) (mul i 1000000000)) (add i 1) n)))

; The sequence numbers of the records in bytes, as text.
(def numbers_of ((bs (list int))) (list int)
  (numbers_text (log_records_of (bytes_from_list bs)) (nil int)))

(def numbers_text ((rs (list LogRecord)) (acc (list int))) (list int)
  (if (is_empty rs)
      (rev acc)
      (match (head rs)
        ((LogRecord seq ns pid level text) (numbers_text (tail rs) (push (append (digits seq) ",") acc))))))

(def test_count () int
  (add (check_int "empty" (.count (klog_new)) 0)
       (check_int "three" (.count (filled 3)) 3)))

(def test_all () int
  (check_str "numbers" (numbers_of (klog_from (filled 3) 0 4096)) "0,1,2,"))

(def test_from_middle () int
  (check_str "numbers" (numbers_of (klog_from (filled 5) 3 4096)) "3,4,"))

(def test_past_end () int
  (check_int "none" (length (klog_from (filled 2) 2 4096)) 0))

(def test_empty_ring () int
  (check_int "none" (length (klog_from (klog_new) 0 4096)) 0))

; Each "mN" record is 21 + 2 bytes, so max 46 holds two and 45 only one.
(def test_max () int
  (add (check_str "two" (numbers_of (klog_from (filled 5) 0 46)) "0,1,")
       (check_str "one" (numbers_of (klog_from (filled 5) 0 45)) "0,")))

(def test_too_small () int
  (check_int "none" (length (klog_from (filled 5) 0 22)) 0))

; Long messages of 1000 bytes take 1021 each, so 65536 holds 64, and the
; ring keeps the newest 64 of 100.
(def test_drops_oldest () int
  (let (log (long_filled (klog_new) 0 100)
        rs (log_records_of (bytes_from_list (klog_from log 0 1000000))))
    (match (head rs)
      ((LogRecord seq ns pid level text)
        (add (check_int "oldest" seq 36)
             (add (check_int "kept" (length rs) 64)
                  (check_int "count" (.count log) 100)))))))

(def long_filled ((log KLog) (i int) (n int)) KLog
  (if (ge i n)
      log
      (long_filled (klog_add log 0 (log_info) (repeat 1000 120) i) (add i 1) n)))

; Two of 40000 bytes are over the cap: the older goes, the newer stays.
(def test_keeps_newest () int
  (let (log (klog_add (klog_add (klog_new) 0 (log_info) (repeat 40000 120) 0) 0 (log_info) (repeat 40000 121) 1)
        rs (log_records_of (bytes_from_list (klog_from log 0 1000000))))
    (add (check_int "kept" (length rs) 1)
         (check_int "the newer" (match (head rs) ((LogRecord seq ns pid level text) seq)) 1))))
