; cpus_test.l0 -- the table of what the other CPUs hold: l0 test.

; A time no CPU of a new table has been active near.
(def later () int 1000000000)

; c with pid handed to CPU i at t, and taken back at t2.
(def ran_on ((c Cpus) (i int) (pid int) (t int) (t2 int)) Cpus
  (match (cpus_back (cpus_place c i pid 0 t) pid t2)
    ((CpuBack c2 p) c2)
    ((CpuNotOut c2) c2)))

(def test_one_cpu () int
  (add (check_bool "one is not many" (cpus_many (cpus_new 1)) false)
       (check_int "nothing to pick" (cpus_pick (cpus_new 1) 0 (later)) 0)))

(def test_none_counts_as_one () int
  (check_int "at least one" (.count (cpus_new 0)) 1))

(def test_pick_lowest_idle () int
  (check_int "CPU 1" (cpus_pick (cpus_new 4) 0 (later)) 1))

(def test_pick_prefers_its_own () int
  (check_int "CPU 3" (cpus_pick (cpus_new 4) 3 (later)) 3))

; An idle CPU is taken before the busy one the thread ran on.
(def test_pick_idle_first () int
  (check_int "CPU 2" (cpus_pick (cpus_place (cpus_new 4) 1 5 0 0) 1 (later)) 2))

; Every CPU holds one: the second place goes to the one preferred.
(def test_pick_second_place () int
  (let c (cpus_place (cpus_place (cpus_place (cpus_new 4) 1 5 0 0) 2 6 0 0) 3 7 0 0)
    (check_int "CPU 2" (cpus_pick c 2 (later)) 2)))

(def test_pick_full () int
  (let c (cpus_place (cpus_place (cpus_new 2) 1 5 0 0) 1 6 0 0)
    (check_int "no room" (cpus_pick c 1 (later)) 0)))

; Pid 5 last ran 100 µs, and is handed to CPU 1 again at 1,000,000: at
; 1,100,000 the next goes behind it, before idle CPUs 2 and 3; 500 µs
; and 1 ns after it was handed, CPU 1 is quiet, and idle CPU 3 is taken.
(def test_pick_behind_brief () int
  (let c (cpus_place (ran_on (cpus_new 4) 1 5 0 100000) 1 5 0 1000000)
    (add (check_int "behind it" (cpus_pick c 3 1100000) 1)
         (check_int "quiet" (cpus_pick c 3 1500001) 3))))

; Nothing goes behind a thread with no run yet, or one that last ran
; 1 ms and 1 ns, which may be computing.
(def test_pick_not_behind_long () int
  (let (fresh (cpus_place (cpus_new 4) 1 5 0 1000000)
        long (cpus_place (ran_on (cpus_new 4) 1 5 0 1000001) 1 5 0 1000000))
    (add (check_int "no run yet" (cpus_pick fresh 3 1100000) 3)
         (check_int "a long run" (cpus_pick long 3 1100000) 3))))

; Of two CPUs active within the window, the later; and one with no room
; is passed over, however recent.
(def test_pick_latest_with_room () int
  (let c (ran_on (ran_on (cpus_new 4) 1 5 1000 2000) 2 6 2000 3000)
    (add (check_int "the later" (cpus_pick c 0 3500) 2)
         (check_int "full" (cpus_pick (cpus_place (cpus_place c 2 7 0 3000) 2 8 0 3000) 0 3500) 1))))

(def test_last_run () int
  (let c (ran_on (cpus_new 3) 2 9 1000 4000)
    (add (check_int "3 µs" (cpus_last_run c 9) 3000)
         (add (check_int "active" (cpus_active_at c 2) 4000)
              (check_int "forgotten" (cpus_last_run (cpus_forget c 9) 9) -1)))))

; A thread that last ran 2 ms, on another CPU or on CPU 0, runs on CPU 0.
(def test_keeps_brief () int
  (add (check_bool "brief elsewhere" (cpus_keeps (ran_on (cpus_new 4) 2 9 0 2000000) 9) true)
       (check_bool "brief here" (cpus_keeps (cpus_ran (cpus_new 4) 9 2000000) 9) true)))

; One with no run yet, or that ran 2 ms and 1 ns, as CPU 0's timer
; ending its 4 ms turn makes it, is handed out.
(def test_keeps_not_long () int
  (add (check_bool "no run yet" (cpus_keeps (cpus_new 4) 9) false)
       (check_bool "long here" (cpus_keeps (cpus_ran (cpus_new 4) 9 2000001) 9) false)))

; Pid 9 last ran briefly, 4 for 5 ms: 4 is handed out, from the front or
; the back of the queue; 9 is not.
(def test_spreads () int
  (let c (cpus_ran (cpus_ran (cpus_new 4) 9 500) 4 5000000)
    (add (check_bool "front" (cpus_spreads c (cons 9 (cons 4 (nil int))) (nil int)) true)
         (add (check_bool "back" (cpus_spreads c (cons 9 (nil int)) (cons 4 (nil int))) true)
              (check_bool "9 alone" (cpus_spreads c (cons 9 (nil int)) (nil int)) false)))))

; Pid 7, which has not run yet, is handed out.
(def test_spreads_new () int
  (check_bool "new" (cpus_spreads (cpus_new 4) (cons 7 (nil int)) (nil int)) true))

; With one CPU there is none to hand pid 4 to.
(def test_spreads_one_cpu () int
  (check_bool "one" (cpus_spreads (cpus_ran (cpus_new 1) 4 5000000) (cons 4 (nil int)) (nil int)) false))

; Pid 4, which last ran 5 ms, is not handed out with every CPU full.
(def test_spreads_full () int
  (let c (cpus_ran (cpus_place (cpus_place (cpus_new 2) 1 5 0 0) 1 6 0 0) 4 5000000)
    (check_bool "full" (cpus_spreads c (cons 4 (nil int)) (nil int)) false)))

; Pid 9, which ran 5 ms, stays on CPU 0 with nothing else ready and no
; thread out; not with another ready, nor with a thread out on CPU 1.
(def test_here_long () int
  (let c (cpus_ran (cpus_new 4) 9 5000000)
    (add (check_bool "nothing else" (cpus_here c 9 false) true)
         (add (check_bool "another ready" (cpus_here c 9 true) false)
              (check_bool "one out" (cpus_here (cpus_place c 1 6 0 0) 9 false) false)))))

; A brief pid stays on CPU 0 whatever else is ready or out.
(def test_here_brief () int
  (let c (cpus_place (cpus_ran (cpus_new 4) 9 500) 1 6 0 0)
    (check_bool "brief" (cpus_here c 9 true) true)))

; Two CPUs besides CPU 0, each holding two threads, have no room; one
; holding one has.
(def test_room () int
  (let c (cpus_place (cpus_place (cpus_place (cpus_new 3) 1 4 0 0) 1 5 0 0) 2 6 0 0)
    (add (check_bool "room" (cpus_room c) true)
         (add (check_bool "full" (cpus_room (cpus_place c 2 7 0 0)) false)
              (check_bool "one CPU" (cpus_room (cpus_new 1)) false)))))

; A run on CPU 0 is kept as its pid's last, and changes no CPU's count.
(def test_ran () int
  (let c (cpus_ran (cpus_new 3) 9 2500)
    (add (check_int "last run" (cpus_last_run c 9) 2500)
         (add (check_bool "not out" (cpus_out c 9) false)
              (check_int "negative is 0" (cpus_last_run (cpus_ran c 9 -4) 9) 0)))))

; A first run is news; another brief one after a brief one is not; a
; long one after a brief one is.
(def test_run_news () int
  (let c (cpus_ran (cpus_new 4) 9 500)
    (add (check_bool "first" (cpus_run_news (cpus_new 4) 9 500) true)
         (add (check_bool "brief again" (cpus_run_news c 9 2000000) false)
              (check_bool "long now" (cpus_run_news c 9 2000001) true)))))

; CPU 0's timer at 1,000,000: 4 ms on, or the slice's end, or a sleeper,
; whichever is first.
(def test_own_deadline () int
  (add (check_int "4 ms" (cpus_own_deadline 1000000 9000000 -1) 5000000)
       (add (check_int "slice ends" (cpus_own_deadline 1000000 1500000 -1) 1500000)
            (check_int "a sleeper" (cpus_own_deadline 1000000 9000000 1200000) 1200000))))

(def test_never () int
  (add (check_int "never active" (cpus_active_at (cpus_new 3) 2) -1)
       (check_int "never ran" (cpus_last_run (cpus_new 3) 9) -1)))

; Two threads handed to CPU 1 and one to CPU 2 are three out; one back,
; two.
(def test_out_count () int
  (let c (cpus_place (cpus_place (cpus_place (cpus_new 3) 1 4 0 0) 1 5 0 0) 2 6 0 0)
    (add (check_int "three" (cpus_out_count c) 3)
         (check_int "two" (match (cpus_back c 5 9) ((CpuBack c2 p) (cpus_out_count c2)) ((CpuNotOut c2) -1)) 2))))

(def test_place_out () int
  (let c (cpus_place (cpus_new 3) 2 9 100 0)
    (add (check_bool "out" (cpus_out c 9) true)
         (add (check_int "held" (cpus_held c 2) 1)
              (check_bool "busy" (cpus_busy c) true)))))

(def test_back () int
  (match (cpus_back (cpus_place (cpus_new 3) 2 9 100 0) 9 50)
    ((CpuBack c p)
      (add (check_int "its CPU" (.cpu p) 2)
           (add (check_int "its deadline" (.deadline p) 100)
                (add (check_bool "not out" (cpus_out c 9) false)
                     (check_bool "idle" (cpus_busy c) false)))))
    ((CpuNotOut c) (fail_because "back" "not out"))))

(def test_back_not_out () int
  (match (cpus_back (cpus_new 3) 9 0)
    ((CpuBack c p) (fail_because "back" "out"))
    ((CpuNotOut c) (check_bool "idle" (cpus_busy c) false))))

(def test_doom () int
  (match (cpus_back (cpus_doom (cpus_place (cpus_new 3) 1 4 0 0) 4) 4 0)
    ((CpuBack c p) (check_bool "doomed" (.doomed p) true))
    ((CpuNotOut c) (fail_because "doom" "not out"))))

(def test_doom_not_out () int
  (check_bool "nothing out" (cpus_busy (cpus_doom (cpus_new 3) 4)) false))

; A context of three words, then CPU 2 and tag 7.
(def test_trapped_of () int
  (match (cpu_trapped_of (array_from (cons 10 (cons 11 (cons 12 (cons 2 (cons 7 (nil int)))))) 0))
    ((CpuTrapped ctx cpu tag)
      (add (check_int "context" (array_len ctx) 3)
           (add (check_int "cpu" cpu 2) (check_int "tag" tag 7))))))

; ------------------------------------------------------------------ usage

; Pid 9 handed to CPU 2 at 100, back at 400: 300 ns on CPU 2.
(def test_back_counts_usage () int
  (match (cpus_back (cpus_place (cpus_from 3 0) 2 9 1000 100) 9 400)
    ((CpuBack c p)
      (add (check_int "time" (usage_time (.usage c) 9) 300)
           (check_int "busy" (usage_busy (.usage c) 2) 300)))
    ((CpuNotOut c) (fail_because "back" "not out"))))

(def test_where_out_then_last () int
  (let c (cpus_place (cpus_from 3 0) 2 9 1000 100)
    (add (check_int "out on 2" (cpus_where c 9) 2)
    (add (check_int "never ran" (cpus_where c 8) -1)
         (check_int "on 0" (cpus_where (cpus_charge c 8 0 50) 8) 0)))))

(def test_tick_counts_out () int
  (let c (cpus_place (cpus_from 3 0) 2 9 1000 100)
    (check_int "two running" (usage_load (.usage (cpus_tick c 5000000000 1)) 0) (load_next 0 1884 2))))
