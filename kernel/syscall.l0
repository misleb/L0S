; syscall.l0 -- what a process asked for, read from the registers of the
; context it trapped with, wherever its CPU keeps them (spec sections 6.13
; and 10.3: the library's call_number, call_arg and call_result). Pure.

; A system call and its arguments, as decode reads them: one constructor
; for each call the kernel answers, those of spec section 10.3 first,
; then L0S's own, numbered from 256; and CUnknown for any other number.
(data Call
  (CRead int int int)          ; stream, buf, n
  (CWrite int int int)         ; stream, buf, n
  (CExit int)                  ; status
  (COpen int int int)          ; path, its length, mode
  (CClose int)                 ; stream
  (CRename int int int int)    ; from, its length, to, its length
  (CRemove int int)            ; path, its length
  (CArgCount)
  (CArg int int int)           ; i, buf, n
  (CRegion int int)            ; base, len
  (CRelease int int)           ; base, len
  (CUnregion int int)          ; addr, len
  (CYield)
  (CPid)
  (CPortNew)
  (CSend int int int)          ; port, buf, len
  (CReceive int int int bool)  ; port, buf, max, whether to wait
  (CRegister int int int)      ; port, name buf, len
  (CLookup int int)            ; name buf, len
  (CSpawn int)                 ; module index
  (CWait int)                  ; pid
  (CSleepUntil int)            ; clock_ns
  (CIrqBind int int)           ; irq, port
  (CIrqAck int)                ; irq
  (CModuleName int int int)    ; module index, buf, max
  (CKill int)                  ; pid
  (CWatch int int)             ; pid, port
  (CSpawnArgs int int int)     ; module index, args buf, len
  (CProcInfo int int int)      ; pid, buf, max
  (CDmaAlloc int)              ; pages
  (CDmaAddress int)            ; va
  (CDmaAddresses int int int)  ; va, buf, max
  (CDmaSync int int int)       ; va, n, dir
  (CShmAlloc int)              ; pages
  (CShmShare int int int)      ; va, pages, pid
  (CShmShareRead int int int)  ; va, pages, pid
  (CTtySet int)                ; port
  (CTtyGet)
  (CProcSlot int)              ; slot
  (CShmUnmap int int)          ; va, pages
  (CShmRevoke int int int)     ; va, pages, pid
  (CMount int int int)         ; port, label buf, len
  (CMountAt int int int)       ; i, buf, max
  (CUnmount int int int)       ; port, label buf, len
  (CBootArgs int int)          ; buf, max
  (CRootSwitch int int)        ; label buf, len
  (CSpawnImage int int)        ; buf, len
  (CMemInfo int int)           ; buf, max
  (CChdir int int)             ; path buf, len
  (CGetCwd int int)            ; buf, max
  (CLogWrite int int int)      ; level, buf, len
  (CLogRead int int int)       ; seq, buf, max
  (CEntrySize int)             ; module index
  (CAlarm int int)             ; port, clock_ns
  (CReboot)
  (CPortSet int int)           ; ports buf, len
  (CReceiveSet int int bool)   ; buf, max, whether to wait
  (CUnregister int int)        ; name buf, len
  (CCpuUsage int int int)      ; pid, buf, max
  (CNameList int int int)      ; from, buf, max
  (CUnknown int))              ; the number

; Argument i, 0 to 3, of the call whose registers are c.
(def reg ((c (array int)) (i int)) int (call_arg c i))

; The call a process made with number n, its registers c.
(def decode ((n int) (c (array int))) Call
  (if (lt n 256) (decode_abi n c) (decode_own n c)))

; The call numbered n below 256, spec section 10.3's: read, write, exit
; and open here, the rest in the decode_abi_ functions after.
(def decode_abi ((n int) (c (array int))) Call
  (if (eq n (sys_read)) (CRead (reg c 0) (reg c 1) (reg c 2))
      (eq n (sys_write)) (CWrite (reg c 0) (reg c 1) (reg c 2))
      (eq n (sys_exit)) (CExit (reg c 0))
      (eq n (sys_open)) (COpen (reg c 0) (reg c 1) (reg c 2))
      (decode_abi_files n c)))

; More of decode_abi: close, rename, remove and arg_count.
(def decode_abi_files ((n int) (c (array int))) Call
  (if (eq n (sys_close)) (CClose (reg c 0))
      (eq n (sys_rename)) (CRename (reg c 0) (reg c 1) (reg c 2) (reg c 3))
      (eq n (sys_remove)) (CRemove (reg c 0) (reg c 1))
      (eq n (sys_arg_count)) (CArgCount)
      (decode_abi_rest n c)))

; The last of decode_abi: arg, region, release and unregion, and
; CUnknown for any other.
(def decode_abi_rest ((n int) (c (array int))) Call
  (if (eq n (sys_arg)) (CArg (reg c 0) (reg c 1) (reg c 2))
      (eq n (sys_region)) (CRegion (reg c 0) (reg c 1))
      (eq n (sys_release)) (CRelease (reg c 0) (reg c 1))
      (eq n (sys_unregion)) (CUnregion (reg c 0) (reg c 1))
      (CUnknown n)))

; The call numbered n from 256, L0S's own (abi.l0's call_*): yield, pid,
; port_new and send here, the rest in the decode_own_ functions after,
; split to keep each one's nesting shallow.
(def decode_own ((n int) (c (array int))) Call
  (if (eq n (call_yield)) (CYield)
      (eq n (call_pid)) (CPid)
      (eq n (call_port_new)) (CPortNew)
      (eq n (call_send)) (CSend (reg c 0) (reg c 1) (reg c 2))
      (decode_own_ipc n c)))

; More of decode_own: receive, which waits, try_receive, which does not,
; register, and lookup, whose name is in arguments 1 and 2.
(def decode_own_ipc ((n int) (c (array int))) Call
  (if (eq n (call_receive)) (CReceive (reg c 0) (reg c 1) (reg c 2) true)
      (eq n (call_try_receive)) (CReceive (reg c 0) (reg c 1) (reg c 2) false)
      (eq n (call_register)) (CRegister (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_lookup)) (CLookup (reg c 1) (reg c 2))
      (decode_own_procs n c)))

; More of decode_own: spawn, wait, sleep_until, irq_bind and irq_ack.
(def decode_own_procs ((n int) (c (array int))) Call
  (if (eq n (call_spawn)) (CSpawn (reg c 0))
      (eq n (call_wait)) (CWait (reg c 0))
      (eq n (call_sleep_until)) (CSleepUntil (reg c 0))
      (eq n (call_irq_bind)) (CIrqBind (reg c 0) (reg c 1))
      (eq n (call_irq_ack)) (CIrqAck (reg c 0))
      (decode_own_jobs n c)))

; More of decode_own: module_name, kill, watch, spawn_args and proc_info.
(def decode_own_jobs ((n int) (c (array int))) Call
  (if (eq n (call_module_name)) (CModuleName (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_kill)) (CKill (reg c 0))
      (eq n (call_watch)) (CWatch (reg c 0) (reg c 1))
      (eq n (call_spawn_args)) (CSpawnArgs (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_proc_info)) (CProcInfo (reg c 0) (reg c 1) (reg c 2))
      (decode_own_dma n c)))

; More of decode_own: dma_alloc, dma_address, dma_addresses, dma_sync,
; tty_set and tty_get.
(def decode_own_dma ((n int) (c (array int))) Call
  (if (eq n (call_dma_alloc)) (CDmaAlloc (reg c 0))
      (eq n (call_dma_address)) (CDmaAddress (reg c 0))
      (eq n (call_dma_addresses)) (CDmaAddresses (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_dma_sync)) (CDmaSync (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_tty_set)) (CTtySet (reg c 0))
      (eq n (call_tty_get)) (CTtyGet)
      (decode_own_shm n c)))

; More of decode_own: shm_alloc, shm_share, shm_share_read, proc_slot,
; shm_unmap and shm_revoke.
(def decode_own_shm ((n int) (c (array int))) Call
  (if (eq n (call_shm_alloc)) (CShmAlloc (reg c 0))
      (eq n (call_shm_share)) (CShmShare (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_shm_share_read)) (CShmShareRead (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_proc_slot)) (CProcSlot (reg c 0))
      (eq n (call_shm_unmap)) (CShmUnmap (reg c 0) (reg c 1))
      (eq n (call_shm_revoke)) (CShmRevoke (reg c 0) (reg c 1) (reg c 2))
      (decode_own_fs n c)))

; More of decode_own: fs_mount, mount_at and fs_unmount.
(def decode_own_fs ((n int) (c (array int))) Call
  (if (eq n (call_fs_mount)) (CMount (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_mount_at)) (CMountAt (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_fs_unmount)) (CUnmount (reg c 0) (reg c 1) (reg c 2))
      (decode_own_root n c)))

; More of decode_own: boot_args, root_switch, spawn_image and mem_info,
; each with its buffer in arguments 1 and 2.
(def decode_own_root ((n int) (c (array int))) Call
  (if (eq n (call_boot_args)) (CBootArgs (reg c 1) (reg c 2))
      (eq n (call_root_switch)) (CRootSwitch (reg c 1) (reg c 2))
      (eq n (call_spawn_image)) (CSpawnImage (reg c 1) (reg c 2))
      (eq n (call_mem_info)) (CMemInfo (reg c 1) (reg c 2))
      (decode_own_cwd n c)))

; More of decode_own: chdir and getcwd, each with its buffer in
; arguments 1 and 2.
(def decode_own_cwd ((n int) (c (array int))) Call
  (if (eq n (call_chdir)) (CChdir (reg c 1) (reg c 2))
      (eq n (call_getcwd)) (CGetCwd (reg c 1) (reg c 2))
      (decode_own_log n c)))

; The last of decode_own: log_write and log_read, each with its number
; in argument 0 and its buffer in arguments 1 and 2; entry_size, its
; module index in argument 0; alarm, its port and time; reboot, with
; none; and the rest in decode_own_sets.
(def decode_own_log ((n int) (c (array int))) Call
  (if (eq n (call_log_write)) (CLogWrite (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_log_read)) (CLogRead (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_entry_size)) (CEntrySize (reg c 0))
      (eq n (call_alarm)) (CAlarm (reg c 0) (reg c 1))
      (eq n (call_reboot)) (CReboot)
      (decode_own_sets n c)))

; The last of decode_own: port_set, receive_set, which waits,
; try_receive_set, which does not, and unregister, each with its buffer
; in arguments 1 and 2; cpu_usage and name_list, a pid or an index in
; argument 0 and a buffer in 1 and 2; and CUnknown for any other number.
(def decode_own_sets ((n int) (c (array int))) Call
  (if (eq n (call_port_set)) (CPortSet (reg c 1) (reg c 2))
      (eq n (call_receive_set)) (CReceiveSet (reg c 1) (reg c 2) true)
      (eq n (call_try_receive_set)) (CReceiveSet (reg c 1) (reg c 2) false)
      (eq n (call_unregister)) (CUnregister (reg c 1) (reg c 2))
      (eq n (call_cpu_usage)) (CCpuUsage (reg c 0) (reg c 1) (reg c 2))
      (eq n (call_name_list)) (CNameList (reg c 0) (reg c 1) (reg c 2))
      (CUnknown n)))

; c answering the call it trapped with: v as its result.
(def answer ((c (array int)) (v int)) (array int)
  (call_result c v))
