; pids.l0 -- which pid a new process gets. Pure: it decides, and
; kernel.l0 keeps the table.
;
; A pid names a slot of the process table, 1 to max_procs, in its low 8
; bits, and how many times that slot was given before in the bits above.
; So slots are reused, but a pid never is: one kept after its process has
; gone names nothing, rather than whoever has its slot now. The first
; max_procs pids are 1 to max_procs, as when nothing was reused.

; The pid each slot was last given, 0 for none yet, and the slot last
; given.
(data Pids (Pids (last (array int)) (cursor int)))

; The table at boot: no slot given yet, and the last slot as the one last
; given, so that slot 1 is given first.
(def pids_new () Pids (Pids (array_new (add (max_procs) 1) 0) (max_procs)))

; The slot pid names: its low 8 bits.
(def slot_of ((pid int)) int (bit_and pid 255))

; The pid slot i was last given, 0 for none yet.
(def pid_at ((ps Pids) (i int)) int (match ps ((Pids last cur) (array_get last i))))

; Whether pid is the one its slot was last given: the process the table
; holds there, live or exited, or one that has gone without its slot
; being given again.
(def pid_current ((ps Pids) (pid int)) bool
  (if (lt pid 1) false
      (eq (slot_of pid) 0) false
      (eq (pid_at ps (slot_of pid)) pid)))

; The pid slot i gives next.
(def pid_next_in ((ps Pids) (i int)) int
  (let last (pid_at ps i)
    (if (eq last 0) i (add last 256))))

; ps with slot i given its next pid.
(def pids_give ((ps Pids) (i int)) Pids
  (let p (pid_next_in ps i)
    (match ps ((Pids last cur) (Pids (array_set last i p) i)))))

; What a slot holds, as the choice of one for a new process sees it, best
; first: nothing; an exited process whose status was given to someone, or
; whose parent has gone, so none will ask for it; any other exited
; process; or a live one, which is never given.
(def kind_free () int 0)
(def kind_spare () int 1)
(def kind_kept () int 2)
(def kind_live () int 3)

; The slot for a new process, given what each slot holds: the first of
; the best kind there is, from the one after the slot last given, round
; to it, never the slot except; or -1 if every slot is live.
(def pick_slot ((kinds (array int)) (ps Pids) (except int)) int
  (pick_kind kinds (.cursor ps) except (kind_free)))

; The rest of pick_slot, from kind on: the first slot after cur holding
; kind, else the next kind's, until only live slots are left.
(def pick_kind ((kinds (array int)) (cur int) (except int) (kind int)) int
  (if (ge kind (kind_live))
      -1
      (let s (scan_slots kinds (next_slot cur) cur except kind)
        (if (ge s 0) s (pick_kind kinds cur except (add kind 1))))))

; The first slot from i on, round to stop, holding kind, or -1.
(def scan_slots ((kinds (array int)) (i int) (stop int) (except int) (kind int)) int
  (if (and (eq (array_get kinds i) kind) (not (eq i except))) i
      (eq i stop) -1
      (scan_slots kinds (next_slot i) stop except kind)))

; The slot after i, round from max_procs to 1.
(def next_slot ((i int)) int (if (ge i (max_procs)) 1 (add i 1)))
