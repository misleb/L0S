(def msg ((from int) (s (list int))) Msg
  (Msg from (bytes_from_list s)))

(def with_port ((owner int)) NewPort
  (ipc_port_new (ipc_new) owner))

(def test_port_new () int
  (match (with_port 3)
    ((NewPort port ipc)
      (add (check_int "first port" port 1)
           (add (check_int "owner" (ipc_owner ipc port) 3)
                (check_int "no such" (ipc_owner ipc 9) -1))))))

(def test_ports_numbered_apart () int
  (match (with_port 3)
    ((NewPort a ipc)
      (match (ipc_port_new ipc 4)
        ((NewPort b ipc2) (check_int "second" b 2))))))

(def payload ((m (Option Msg))) (list int)
  (match m
    ((Some x) (match x ((Msg from b) (append (digits from) (append ":" (bytes_to_list b))))))
    ((None) "none")))

(def sent ((s Sent)) Ipc
  (match s ((Sent ipc) ipc) ((SendFailed code ipc) ipc)))

(def test_fifo_order () int
  (match (with_port 3)
    ((NewPort port ipc)
      (let i2 (sent (ipc_enqueue (sent (ipc_enqueue ipc port (msg 5 "a"))) port (msg 6 "b")))
        (add (check_str "oldest" (payload (ipc_peek i2 port)) "5:a")
             (check_str "then" (payload (ipc_peek (ipc_drop i2 port) port)) "6:b"))))))

(def test_empty_peek () int
  (match (with_port 3)
    ((NewPort port ipc) (check_str "empty" (payload (ipc_peek ipc port)) "none"))))

(def send_code ((s Sent)) int
  (match s ((Sent ipc) 0) ((SendFailed code ipc) code)))

(def test_send_no_port () int
  (check_int "no port" (send_code (ipc_enqueue (ipc_new) 4 (msg 1 "x"))) (err_no_port)))

(def fill ((ipc Ipc) (port int) (n int)) Ipc
  (if (eq n 0) ipc (fill (sent (ipc_enqueue ipc port (msg 1 "x"))) port (sub n 1))))

(def test_queue_full () int
  (match (with_port 3)
    ((NewPort port ipc)
      (check_int "full" (send_code (ipc_enqueue (fill ipc port (queue_limit)) port (msg 1 "y"))) (err_full)))))

(def reg_code ((r Registered)) int (match r ((Registered code ipc) code)))
(def reg_ipc ((r Registered)) Ipc (match r ((Registered code ipc) ipc)))

(def test_register_lookup () int
  (match (with_port 3)
    ((NewPort port ipc)
      (let r (ipc_register ipc 3 port "echo")
        (add (check_int "registered" (reg_code r) 0)
             (add (check_int "found" (ipc_lookup (reg_ipc r) "echo") port)
                  (check_int "missing" (ipc_lookup (reg_ipc r) "other") (err_no_port))))))))

(def test_register_rules () int
  (match (with_port 3)
    ((NewPort port ipc)
      (let r (ipc_register ipc 3 port "echo")
        (add (check_int "not the owner" (reg_code (ipc_register ipc 4 port "x")) (err_no_port))
             (check_int "taken" (reg_code (ipc_register (reg_ipc r) 3 port "echo")) (err_taken)))))))

(def test_forget () int
  (match (with_port 3)
    ((NewPort port ipc)
      (match (ipc_port_new (reg_ipc (ipc_register ipc 3 port "echo")) 4)
        ((NewPort other i2)
          (let i3 (ipc_forget i2 3)
            (add (check_int "port gone" (ipc_owner i3 port) -1)
                 (add (check_int "name gone" (ipc_lookup i3 "echo") (err_no_port))
                      (check_int "other kept" (ipc_owner i3 other) 4)))))))))

(def unblocked ((u Unblocked)) (list int)
  (match u ((Unblocked pids ipc) (nums pids))))

(def nums ((ns (list int))) (list int)
  (if (is_empty ns) "" (append (digits (head ns)) (append " " (nums (tail ns))))))

(def test_block_and_unblock () int
  (match (with_port 3)
    ((NewPort port ipc)
      (let i2 (ipc_block (ipc_block (ipc_block ipc port 5) port 6) port 5)
        (match (ipc_unblock_all i2 port)
          ((Unblocked pids i3)
            (add (check_str "oldest first, once each" (nums pids) "5 6 ")
                 (check_str "none left" (unblocked (ipc_unblock_all i3 port)) ""))))))))

(def test_block_no_port () int
  (check_str "nothing" (unblocked (ipc_unblock_all (ipc_block (ipc_new) 9 5) 9)) ""))

(def test_blocked_by () int
  (match (with_port 3)
    ((NewPort port ipc)
      (check_str "blocked on 3's port" (nums (ipc_blocked_by (ipc_block ipc port 7) 3)) "7 "))))

; Port 1, pid 3's, mounted as data.
(def mounted () Ipc
  (match (with_port 3)
    ((NewPort port ipc) (match (ipc_mount ipc 3 port "data" "") ((Registered code i2) i2)))))

(def test_mount () int
  (check_true "after the root" (eq (ipc_mounts (mounted)) (cons (MountRoot) (cons (MountServer "data" "" 1) (nil Mount))))))

(def test_mount_not_yours () int
  (match (with_port 3)
    ((NewPort port ipc)
      (match (ipc_mount ipc 4 port "data" "")
        ((Registered code i2) (add (check_int "refused" code (err_no_port)) (check_int "unchanged" (length (ipc_mounts i2)) 1)))))))

(def test_mount_taken () int
  (match (ipc_mount (mounted) 3 1 "data" "")
    ((Registered code i2) (check_int "taken" code (err_taken)))))

; The server unmounts its volume: the root alone is left. Another pid
; may not, though it names the port.
(def test_unmount () int
  (match (ipc_unmount (mounted) 3 1 "data")
    ((Registered code i2) (add (check_int "unmounted" code 0) (check_true "the root alone" (eq (ipc_mounts i2) (mounts_new)))))))

(def test_unmount_not_yours () int
  (match (ipc_unmount (mounted) 4 1 "data")
    ((Registered code i2) (add (check_int "refused" code (err_no_port)) (check_int "unchanged" (length (ipc_mounts i2)) 2)))))

; A server's volumes go with its ports.
(def test_forget_mounts () int
  (check_true "the root alone" (eq (ipc_mounts (ipc_forget (mounted) 3)) (mounts_new))))

; data made /: it stays /, its server gone, though not in /Volumes.
(def test_root () int
  (match (ipc_root (mounted) "data")
    ((Registered code i2)
      (add (check_int "made" code 0)
           (check_true "kept" (eq (ipc_mounts (ipc_forget i2 3)) (cons (MountSystem "data" "" 1) (nil Mount))))))))

(def test_close () int
  (let ipc (mounted)
    (add (check_int "not pid 4's" (ipc_owner (ipc_close ipc 4 1) 1) 3)
         (check_int "gone" (ipc_owner (ipc_close ipc 3 1) 1) -1))))

; Pid 3 with ports 1 and 2, the first holding a message from 5 and then
; one from 7, the second one from 6 between them.
(def two_ports () Ipc
  (match (with_port 3)
    ((NewPort a ipc)
      (match (ipc_port_new ipc 3)
        ((NewPort b i2)
          (sent (ipc_enqueue (sent (ipc_enqueue (sent (ipc_enqueue i2 a (msg 5 "a"))) b (msg 6 "b"))) a (msg 7 "c"))))))))

(def opt_text ((o (Option int))) (list int)
  (match o ((Some n) (digits n)) ((None) "none")))

; The oldest across both is port 1's; once it is taken, port 2's, though
; port 1 still holds one: a busy port does not starve the other.
(def test_oldest_across () int
  (let ipc (two_ports)
    (let set (cons 1 (cons 2 (nil int)))
      (add (check_str "first" (opt_text (ipc_oldest ipc set)) "1")
           (add (check_str "then" (opt_text (ipc_oldest (ipc_drop ipc 1) set)) "2")
                (check_str "none" (opt_text (ipc_oldest (ipc_new) set)) "none"))))))

(def test_oldest_in_set_only () int
  (check_str "port 2 alone" (opt_text (ipc_oldest (two_ports) (cons 2 (nil int)))) "2"))

(def test_set_ports () int
  (let r (ipc_set_ports (two_ports) 3 (cons 2 (cons 1 (nil int))))
    (add (check_int "set" (reg_code r) 0)
         (check_str "kept" (nums (ipc_set_of (reg_ipc r) 3)) "2 1 "))))

(def test_set_refused () int
  (let ipc (two_ports)
    (add (check_int "not pid 4's" (reg_code (ipc_set_ports ipc 4 (cons 1 (nil int)))) (err_no_port))
         (add (check_int "no such port" (reg_code (ipc_set_ports ipc 3 (cons 1 (cons 9 (nil int))))) (err_no_port))
              (check_int "empty" (reg_code (ipc_set_ports ipc 3 (nil int))) (err_too_big))))))

(def ones ((n int)) (list int)
  (if (eq n 0) (nil int) (cons 1 (ones (sub n 1)))))

; port_set_limit ports may be set, one more may not.
(def test_set_limit () int
  (add (check_int "at the limit" (reg_code (ipc_set_ports (two_ports) 3 (ones (port_set_limit)))) 0)
       (check_int "past it" (reg_code (ipc_set_ports (two_ports) 3 (ones (add (port_set_limit) 1)))) (err_too_big))))

; A port closed leaves its owner's set; the last one closed, the set.
(def test_set_close () int
  (let i2 (reg_ipc (ipc_set_ports (two_ports) 3 (cons 1 (cons 2 (nil int)))))
    (add (check_str "port 2 left" (nums (ipc_set_of (ipc_close i2 3 1) 3)) "2 ")
         (check_str "none" (nums (ipc_set_of (ipc_close (ipc_close i2 3 1) 3 2) 3)) ""))))

(def test_set_forget () int
  (let i2 (reg_ipc (ipc_set_ports (two_ports) 3 (cons 1 (nil int))))
    (check_str "gone" (nums (ipc_set_of (ipc_forget i2 3) 3)) "")))

; A name let go is free at once, and found no more.
(def test_unregister () int
  (match (with_port 3)
    ((NewPort port ipc)
      (let r (ipc_unregister (reg_ipc (ipc_register ipc 3 port "echo")) 3 "echo")
        (add (check_int "let go" (reg_code r) 0)
             (add (check_int "not found" (ipc_lookup (reg_ipc r) "echo") (err_no_port))
                  (check_int "free" (reg_code (ipc_register (reg_ipc r) 3 port "echo")) 0)))))))

(def test_unregister_refused () int
  (match (with_port 3)
    ((NewPort port ipc)
      (let i2 (reg_ipc (ipc_register ipc 3 port "echo"))
        (add (check_int "another's" (reg_code (ipc_unregister i2 4 "echo")) (err_denied))
             (add (check_int "kept" (ipc_lookup (reg_ipc (ipc_unregister i2 4 "echo")) "echo") port)
                  (check_int "not registered" (reg_code (ipc_unregister i2 3 "other")) (err_no_port))))))))

; ------------------------------------------------------------ name_list

; Pid 3's port registered as "echo" and "abc", pid 4's as "zz": their
; records' names, ports and owners, as text.
(def named_three () Ipc
  (match (with_port 3)
    ((NewPort port ipc)
      (match (ipc_port_new (reg_ipc (ipc_register (reg_ipc (ipc_register ipc 3 port "echo")) 3 port "abc")) 4)
        ((NewPort other i2) (reg_ipc (ipc_register i2 4 other "zz")))))))

; The name_records in b, as "NAME PORT OWNER;" each.
(def records_text ((b bytes) (i int) (acc (list int))) (list int)
  (if (lt (bytes_len b) (add i (name_record_len)))
      (rev acc)
      (let n (le_u32 b (add i 8))
        (let e (add i (add (name_record_len) n))
          (records_text b e
            (push ";" (push (digits (le_u32 b (add i 4))) (push " " (push (digits (le_u32 b i)) (push " " (push (bytes_range b (add i 12) e) acc)))))))))))

(def names_of ((ipc Ipc) (from int) (max int)) (list int)
  (records_text (bytes_from_list (ipc_name_records ipc from max)) 0 (nil int)))

(def test_name_list_in_order () int
  (check_str "all" (names_of (named_three) 0 4096) "abc 1 3;echo 1 3;zz 2 4;"))

(def test_name_list_from () int
  (add (check_str "from the second" (names_of (named_three) 1 4096) "echo 1 3;zz 2 4;")
       (check_str "past the end" (names_of (named_three) 3 4096) "")))

; Each record of a name of 3 or 4 bytes is 15 or 16: 31 bytes hold two,
; 30 one, and 14 none.
(def test_name_list_whole_records () int
  (add (check_str "two" (names_of (named_three) 0 31) "abc 1 3;echo 1 3;")
  (add (check_str "one" (names_of (named_three) 0 30) "abc 1 3;")
       (check_str "none" (names_of (named_three) 0 14) ""))))
