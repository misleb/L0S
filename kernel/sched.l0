; sched.l0 -- when processes sleeping until a time wake, and when the
; timer must next interrupt. Pure: the kernel reads the clock and arms the
; timer.

; A process asleep until t on the clock: t, then its pid, so that compare
; orders sleepers by when they wake.
(data Sleeper (Sleeper int int))

; The pid an alarm for port sleeps under: negative, so that no process's
; is it, and one alarm for a port replaces another.
(def alarm_key ((port int)) int (sub 0 port))

; Sleepers, soonest first, with pid sleeping until t among them.
(def sleep_add ((ss (list Sleeper)) (t int) (pid int)) (list Sleeper)
  (insert_sleeper ss (Sleeper t pid) (nil Sleeper)))

; The rest of sleep_add: s put before the first of ss that wakes after it,
; the sleepers passed so far reversed in before.
(def insert_sleeper ((ss (list Sleeper)) (s Sleeper) (before (list Sleeper))) (list Sleeper)
  (if (is_empty ss)
      (rev (cons s before))
      (if (lt (compare s (head ss)) 0)
          (rev_onto (cons s before) ss)
          (insert_sleeper (tail ss) s (cons (head ss) before)))))

; The pids whose time has come by now, soonest first, and the sleepers left.
(data Woken (Woken (list int) (list Sleeper)))

; The sleepers of ss due by now woken.
(def wake_due ((ss (list Sleeper)) (now int)) Woken
  (wake_due_onto ss now (nil int)))

; The rest of wake_due, the pids woken so far reversed in acc.
(def wake_due_onto ((ss (list Sleeper)) (now int) (acc (list int))) Woken
  (if (is_empty ss)
      (Woken (rev acc) ss)
      (match (head ss)
        ((Sleeper t pid)
          (if (le t now)
              (wake_due_onto (tail ss) now (cons pid acc))
              (Woken (rev acc) ss))))))

; Sleepers without pid's.
(def sleep_remove ((ss (list Sleeper)) (pid int)) (list Sleeper)
  (sleep_remove_onto ss pid (nil Sleeper)))

; The rest of sleep_remove, the sleepers kept so far reversed in acc.
(def sleep_remove_onto ((ss (list Sleeper)) (pid int) (acc (list Sleeper))) (list Sleeper)
  (if (is_empty ss)
      (rev acc)
      (sleep_remove_onto (tail ss) pid
                         (match (head ss) ((Sleeper t p) (if (eq p pid) acc (cons (head ss) acc)))))))

; When the soonest sleeper wakes, or -1 if none sleeps.
(def soonest ((ss (list Sleeper))) int
  (if (is_empty ss) -1 (match (head ss) ((Sleeper t pid) t))))

; The timer's deadline for a slice that starts now: the slice's end, or
; the soonest sleeper's time if that comes first.
(def slice_deadline ((ss (list Sleeper)) (now int)) int
  (let end (add now (slice_ns))
    (let s (soonest ss)
      (if (lt s 0) end (min s end)))))
