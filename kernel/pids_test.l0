; pids_test.l0 -- choosing pids and slots.

(def kinds_all ((k int)) (array int) (array_new (add (max_procs) 1) k))

; ps with slots 1 to n given once each, in order.
(def given_through ((ps Pids) (i int) (n int)) Pids
  (if (gt i n) ps (given_through (pids_give ps i) (add i 1) n)))

(def test_first_pids () int
  (let ps (given_through (pids_new) 1 3)
    (add (check_int "slot 3" (pid_at ps 3) 3)
         (add (check_int "slot 4 not yet" (pid_at ps 4) 0)
              (check_int "cursor" (pids_cursor ps) 3)))))

(def test_pid_reused_slot () int
  (let ps (pids_give (pids_give (pids_new) 5) 5)
    (add (check_int "second pid of slot 5" (pid_at ps 5) 261)
         (check_int "its slot" (slot_of 261) 5))))

(def test_pid_current () int
  (let ps (pids_give (pids_give (pids_new) 5) 5)
    (add (check_bool "the new one" (pid_current ps 261) true)
         (add (check_bool "the old one" (pid_current ps 5) false)
              (add (check_bool "never given" (pid_current ps 6) false)
                   (add (check_bool "slot 0" (pid_current ps 256) false)
                        (check_bool "negative" (pid_current ps -251) false)))))))

(def test_pick_in_order () int
  (add (check_int "first" (pick_slot (kinds_all (kind_free)) (pids_new) 0) 1)
       (check_int "after 3" (pick_slot (kinds_all (kind_free)) (given_through (pids_new) 1 3) 0) 4)))

(def test_pick_wraps () int
  (let ps (given_through (pids_new) 1 (max_procs))
    (let kinds (array_set (array_set (kinds_all (kind_live)) 0 (kind_live)) 7 (kind_free))
      (check_int "slot 7" (pick_slot kinds ps 0) 7))))

(def test_pick_except () int
  (let kinds (array_set (array_set (kinds_all (kind_live)) 2 (kind_free)) 9 (kind_free))
    (check_int "not the parent's" (pick_slot kinds (given_through (pids_new) 1 1) 2) 9)))

; A free slot before an exited process's, and one nobody will ask for
; before one somebody might.
(def test_pick_best_kind () int
  (let base (array_set (array_set (kinds_all (kind_live)) 3 (kind_kept)) 4 (kind_spare))
    (add (check_int "spare before kept" (pick_slot base (pids_new) 0) 4)
         (check_int "free before spare" (pick_slot (array_set base 200 (kind_free)) (pids_new) 0) 200))))

(def test_pick_kept_last () int
  (check_int "an exited one, at worst"
    (pick_slot (array_set (kinds_all (kind_live)) 30 (kind_kept)) (pids_new) 0)
    30))

(def test_pick_all_live () int
  (check_int "none" (pick_slot (kinds_all (kind_live)) (pids_new) 0) -1))
